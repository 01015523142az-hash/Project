// v: Candidate History Archive's own Edit -- corrects a candidate's own
// details and/or replaces their video/ID document, independent of
// Approve/Reject/HR's own status workflow. Writes straight to
// hr_candidates (same row Your Submissions/My Commission/Candidate
// Review/this archive all read), so there's nothing separate to keep in
// sync -- same fix applied to the Approve modal's own name/email/mobile
// edits.
let hrHistoryEditCandidateId = null;
function openHrHistoryEditModal(candidateId){
  const cand = hrHistoryCandidates.find(c => c.id === candidateId);
  if(!cand) return;
  hrHistoryEditCandidateId = candidateId;
  $('hrHistoryEditCandidateName').textContent = cand.full_name || '—';
  $('hrHistoryEditFullName').value = cand.full_name || '';
  $('hrHistoryEditEmail').value = cand.email || '';
  $('hrHistoryEditMobile').value = cand.mobile_number || '';
  $('hrHistoryEditContactPhone').value = cand.contact_phone || '';
  $('hrHistoryEditAddress').value = cand.address || '';
  $('hrHistoryEditEmploymentType').value = cand.employment_type || 'full_time';
  $('hrHistoryEditVideoCurrent').textContent = cand.video_path ? '(currently on file)' : '(none on file)';
  $('hrHistoryEditDocCurrent').textContent = cand.id_document_path ? '(currently on file)' : '(none on file)';
  $('hrHistoryEditVideoInput').value = '';
  $('hrHistoryEditDocInput').value = '';
  $('hrHistoryEditMsg').style.display = 'none';
  $('hrHistoryEditModalOverlay').classList.add('active');
}
function closeHrHistoryEditModal(){
