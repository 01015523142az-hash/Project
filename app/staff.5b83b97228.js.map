  } else if(kind === 'appointment'){
    // start_time can be NULL for appointment webhooks that didn't map an
    // appointmentStartTime merge tag (common before the ghl-webhook
    // received_at-fallback fix was deployed, and still possible for any
    // workflow that omits that tag). A plain .gte()/.lte() filter on
    // start_time would silently exclude those rows from every date range,
    // since SQL NULL comparisons are never true — so instead we match rows
    // where EITHER start_time falls in range, OR start_time is null and the
    // row's received_at falls in range. Sorting/display below use the same
    // "start_time, falling back to received_at" rule, and the fallback rows
    // are marked "(est.)" so it's clear the clock time isn't the true
    // appointment start.
    let q = sb.from('ghl_appointments')
      .select('id, user_id, ghl_user_id, contact_id, contact_name, contact_phone, contact_email, title, status, start_time, end_time, received_at, assigned_user_first_name, timezone, meeting_location')
      .limit(300);
    if(rangeStart && rangeEnd){
      q = q.or(`and(start_time.gte.${rangeStart},start_time.lte.${rangeEnd}),and(start_time.is.null,received_at.gte.${rangeStart},received_at.lte.${rangeEnd})`);
    } else if(rangeStart){
      q = q.or(`start_time.gte.${rangeStart},and(start_time.is.null,received_at.gte.${rangeStart})`);
    } else if(rangeEnd){
      q = q.or(`start_time.lte.${rangeEnd},and(start_time.is.null,received_at.lte.${rangeEnd})`);
    }
    if(agentId) q = q.eq('user_id', agentId);
    // Appointments have no direction field, so the Direction filter is
    // simply disabled for this kind (see activateActivityKind above).
    const { data, error } = await q;
    if(error){ body.innerHTML = `<tr><td colspan="8" class="msg error">${escapeHtml(error.message)}</td></tr>`; return; }
    if(!data || !data.length){ body.innerHTML = '<tr><td colspan="8" class="empty">No appointments in this range.</td></tr>'; return; }
    // Sorted client-side (rather than via .order() on the query) because the
    // effective sort key — start_time falling back to received_at — isn't a
    // single real column the query builder can order by directly.
    const sorted = [...data].sort((a, b) => {
      const ta = new Date(a.start_time || a.received_at).getTime();
      const tb = new Date(b.start_time || b.received_at).getTime();
      return tb - ta;
    });
    body.innerHTML = '';
    sorted.forEach(r => {
      const usedFallback = !r.start_time;
      const startLabel = fmt(r.start_time || r.received_at, r.user_id) + (usedFallback ? ' <span style="color:var(--text-dim);" title="No start time came through on the webhook — showing when it was received instead">(est.)</span>' : '');
      // The start/end times above are already rendered in whichever zone
      // the "Times shown in" toggle (top of page) currently selects — but
      // this column used to always print the ORIGINAL stored `r.timezone`
      // (e.g. "CDT", whatever GHL/the workflow sent for this appointment),
      // which never changed when the toggle was flipped. That's misleading:
      // toggling to "Egypt" converted the times shown to Cairo local, while
      // this label kept claiming "CDT" right next to them. It now shows the
      // zone the times are ACTUALLY rendered in (synced with the toggle),
      // with the original GHL-reported zone kept as a hover tooltip so that
      // information isn't lost, just deprioritized.
      const activeTz = resolveActTz(r.user_id);
      const tzLabel = tzShortLabel(activeTz) || r.timezone || '—';
      const tzTitle = r.timezone ? `Originally scheduled in ${escapeHtml(r.timezone)}` : '';
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="mono" style="color:var(--text-2);">${startLabel}</td>
        <td class="mono" style="color:var(--text-2);">${fmt(r.end_time, r.user_id)}</td>
        <td class="mono" style="color:var(--text-2);"${tzTitle ? ` title="${tzTitle}"` : ''}>${escapeHtml(tzLabel)}</td>
        <td>${whoCell(r.user_id, r.ghl_user_id, r.assigned_user_first_name)}</td>
        <td>${contactCell(r.contact_name, r.contact_phone, r.contact_email, r.contact_id)}</td>
        <td>${escapeHtml(r.status || '—')}</td>
        <td>${escapeHtml(r.title || '—')}</td>
        <td>${escapeHtml(r.meeting_location || '—')}</td>
      `;
      body.appendChild(tr);
    });
  } else if(kind === 'rm_call'){
    let q = sb.from('readymode_calls')
      .select('id, user_id, agent_username, campaign, contact_name, contact_phone, direction, disposition, duration_seconds, call_at')
      .order('call_at', { ascending: false }).limit(300);
    if(rangeStart) q = q.gte('call_at', rangeStart);
    if(rangeEnd) q = q.lte('call_at', rangeEnd);
    if(agentId) q = q.eq('user_id', agentId);
    if(dirVal) q = q.eq('direction', dirVal);
    const { data, error } = await q;
    if(error){ body.innerHTML = `<tr><td colspan="8" class="msg error">${escapeHtml(error.message)}</td></tr>`; return; }
    if(!data || !data.length){ body.innerHTML = '<tr><td colspan="8" class="empty">No ReadyMode calls in this range. Import a Call Logs CSV or connect the API from User Management &rarr; Integrations.</td></tr>'; return; }
    body.innerHTML = '';
    data.forEach(r => {
      const dur = r.duration_seconds != null ? `${Math.floor(r.duration_seconds/60)}m ${r.duration_seconds%60}s` : '—';
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="mono" style="color:var(--text-2);">${fmt(r.call_at, r.user_id)}</td>
        <td>${whoCell(r.user_id, r.agent_username)}</td>
        <td>${escapeHtml(r.contact_name || '—')}</td>
        <td>${escapeHtml(r.campaign || '—')}</td>
        <td>${escapeHtml(r.direction || '—')}</td>
        <td>${escapeHtml(r.disposition || '—')}</td>
        <td class="mono">${dur}</td>
        <td class="mono" style="color:var(--text-2);">${escapeHtml(r.contact_phone || '—')}</td>
      `;
      body.appendChild(tr);
    });
  } else if(kind === 'agent_report'){
    // Raw per-agent-per-day figures straight off ReadyMode's Agent Report
    // export (the report that actually has a "Download CSV" button — see
    // READYMODE-INTEGRATION.md). Shift Start/End are real timestamps, so —
    // same as every other timestamp column on this tab — they render
    // through the shared "Times shown in" toggle via fmt()/resolveActTz();
    // work_date is a plain calendar date with no time component, so it's
    // shown as-is regardless of the toggle, same as Timesheets' date column.
    let q = sb.from('readymode_productivity_daily')
      .select('id, user_id, agent_username, login_id, work_date, shift_start, shift_end, logged_in_seconds, ready_seconds, break_plus_lunch_seconds, meeting_seconds, talk_seconds, calls_made')
      .order('work_date', { ascending: false }).limit(300);
    if(rangeStart) q = q.gte('work_date', rangeStart.slice(0,10));
    if(rangeEnd) q = q.lte('work_date', rangeEnd.slice(0,10));
    if(agentId) q = q.eq('user_id', agentId);
    const { data, error } = await q;
    if(error){ body.innerHTML = `<tr><td colspan="11" class="msg error">${escapeHtml(error.message)}</td></tr>`; return; }
    if(!data || !data.length){ body.innerHTML = '<tr><td colspan="11" class="empty">No Agent Report data in this range. Import an Agent Report CSV from User Management &rarr; Integrations.</td></tr>'; return; }
    body.innerHTML = '';
    const hms = secs => {
      if(secs == null) return '—';
      const h = Math.floor(secs/3600), m = Math.floor((secs%3600)/60);
      return `${h}h ${m}m`;
    };
    data.forEach(r => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="mono" style="color:var(--text-2);">${escapeHtml(r.work_date || '—')}</td>
        <td>${whoCell(r.user_id, r.agent_username)}</td>
        <td class="mono" style="color:var(--text-2);">${escapeHtml(r.login_id || '—')}</td>
        <td class="mono" style="color:var(--text-2);">${fmt(r.shift_start, r.user_id)}</td>
        <td class="mono" style="color:var(--text-2);">${fmt(r.shift_end, r.user_id)}</td>
        <td class="mono">${hms(r.logged_in_seconds)}</td>
        <td class="mono">${hms(r.ready_seconds)}</td>
        <td class="mono">${hms(r.break_plus_lunch_seconds)}</td>
        <td class="mono">${hms(r.meeting_seconds)}</td>
        <td class="mono">${hms(r.talk_seconds)}</td>
        <td class="mono">${r.calls_made ?? '—'}</td>
      `;
      body.appendChild(tr);
    });
  } else if(kind === 'productivity'){
    // Same underlying table as Agent Report (ReadyMode's Productivity Report
    // itself has no CSV export — see READYMODE-INTEGRATION.md), but this
    // view surfaces the computed rate/percentage columns Agent Report
    // doesn't (Ready %, Talk % of Ready, calls per ready/logged hour)
    // instead of duplicating the raw shift/break/talk times shown there.
    let q = sb.from('readymode_productivity_daily')
      .select('id, user_id, agent_username, work_date, ready_pct, talk_pct_of_ready, calls_per_ready_hr, calls_per_logged_hr, calls_made, calls_connected')
      .order('work_date', { ascending: false }).limit(300);
    if(rangeStart) q = q.gte('work_date', rangeStart.slice(0,10));
    if(rangeEnd) q = q.lte('work_date', rangeEnd.slice(0,10));
    if(agentId) q = q.eq('user_id', agentId);
    const { data, error } = await q;
    if(error){ body.innerHTML = `<tr><td colspan="8" class="msg error">${escapeHtml(error.message)}</td></tr>`; return; }
    if(!data || !data.length){ body.innerHTML = '<tr><td colspan="8" class="empty">No productivity data in this range. Import an Agent Report CSV from User Management &rarr; Integrations.</td></tr>'; return; }
    body.innerHTML = '';
    const pct = v => v == null ? '—' : `${v}%`;
    const perHr = v => v == null ? '—' : `${v}/hr`;
    data.forEach(r => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="mono" style="color:var(--text-2);">${escapeHtml(r.work_date || '—')}</td>
        <td>${whoCell(r.user_id, r.agent_username)}</td>
        <td class="mono">${pct(r.ready_pct)}</td>
        <td class="mono">${pct(r.talk_pct_of_ready)}</td>
        <td class="mono">${perHr(r.calls_per_ready_hr)}</td>
        <td class="mono">${perHr(r.calls_per_logged_hr)}</td>
        <td class="mono">${r.calls_made ?? '—'}</td>
        <td class="mono">${r.calls_connected ?? '—'}</td>
      `;
      body.appendChild(tr);
    });
  } else if(kind === 'staff_work' || kind.startsWith('task_')){
    // v128: the custom fields a task's category defines (task_category_fields),
    // as filled in through the extension's own lead-submission form —
    // deliberately NOT seller_investor_name/seller_phone/count, which
    // already have dedicated columns/homes on the Leads tab; this is
    // scoped to the same activity_sections('staff_work') permission every
    // other row on this tab already goes through (see ACTIVITY_SECTIONS
    // above), and further narrowed by leads' own RLS ("self or admin
    // select") — a non-admin/non-lead-viewer role only ever gets their
    // own rows back here regardless of the agent filter above, same as
    // it already behaves on the Leads tab itself.
    // v144: kind === 'task_<id>' narrows this to just that one task's own
    // submissions, filtered server-side (not just in the table render) so
    // the stat cards above the table match what's actually being shown.
    const filterTaskId = kind.startsWith('task_') ? kind.slice('task_'.length) : null;
    let q = sb.from('leads')
      .select('id, user_id, task_id, submitted_at, extra_fields, status, count, review_note')
      .order('submitted_at', { ascending: false }).limit(300);
    if(filterTaskId) q = q.eq('task_id', filterTaskId);
    if(agentId) q = q.eq('user_id', agentId);
    if(rangeStart) q = q.gte('submitted_at', rangeStart);
    if(rangeEnd) q = q.lte('submitted_at', rangeEnd);
    const { data, error } = await q;
    if(error){ body.innerHTML = `<tr><td colspan="6" class="msg error">${escapeHtml(error.message)}</td></tr>`; return; }
    // v: this used to also require a non-empty extra_fields object, which
    // silently dropped EVERY submission for a task whose category has no
    // custom fields defined (e.g. "Virtual Assistant - Ops" — its
    // "Virtual Assistant" category has zero task_category_fields rows).
    // The lead still exists, is still real work submitted against this
    // task, and its own Total/Pending/Accepted/Rejected stat cards should
    // count it — there's just nothing extra to show in the Fields column,
    // same as any other lead with nothing entered there.
    const rowsData = data || [];
    if($('actStatExtensionTotal')){
      $('actStatExtensionTotal').textContent = rowsData.length;
      $('actStatExtensionPending').textContent = rowsData.filter(r => r.status === 'pending').length;
      $('actStatExtensionAccepted').textContent = rowsData.filter(r => r.status === 'accepted').length;
      $('actStatExtensionRejected').textContent = rowsData.filter(r => r.status === 'rejected').length;
    }
    // v: "Logged hours" — total time_entries duration logged against this
    // SAME task (time_entries.task_id), narrowed by the same agent/date
    // filters as the leads query above, so this card and the leads table
    // always describe the same slice: how much time went into this task
    // vs. how much came out of it as submitted leads. Only meaningful for
    // one specific task pill, not the (effectively unreachable today)
    // all-tasks 'staff_work' fallback — cleared to '—' there.
    if($('actStatExtensionHours')){
      if(filterTaskId){
        let hoursQuery = sb.from('time_entries')
          .select('start_time, end_time, idle_seconds, break_seconds')
          .eq('task_id', filterTaskId);
        if(agentId) hoursQuery = hoursQuery.eq('user_id', agentId);
        if(rangeStart) hoursQuery = hoursQuery.or(`end_time.is.null,end_time.gte.${rangeStart}`);
        if(rangeEnd) hoursQuery = hoursQuery.lte('start_time', rangeEnd);
        const { data: hourRows, error: hoursErr } = await hoursQuery;
        if(hoursErr){
          console.error('Failed to load logged hours for task', filterTaskId, hoursErr);
          $('actStatExtensionHours').textContent = '—';
        } else {
          const rangeStartMs = rangeStart ? new Date(rangeStart).getTime() : -Infinity;
          const rangeEndMs = rangeEnd ? new Date(rangeEnd).getTime() : Infinity;
          const totalSec = (hourRows || []).reduce((sum, e) => {
            const startMs = Math.max(new Date(e.start_time).getTime(), rangeStartMs);
            const endMs = Math.min(e.end_time ? new Date(e.end_time).getTime() : Date.now(), rangeEndMs);
            const rawSec = Math.max(0, (endMs - startMs) / 1000 - (e.idle_seconds || 0) - (e.break_seconds || 0));
            return sum + rawSec;
          }, 0);
          $('actStatExtensionHours').textContent = fmtShort(totalSec);
        }
      } else {
        $('actStatExtensionHours').textContent = '—';
      }
    }
    if(!rowsData.length){ body.innerHTML = '<tr><td colspan="6" class="empty">No submissions in this range.</td></tr>'; return; }

    const { data: taskRows } = await sb.from('tasks').select('id, name, category_id');
    const taskNameById = {}; const categoryIdByTaskId = {};
    (taskRows || []).forEach(t => { taskNameById[t.id] = t.name; categoryIdByTaskId[t.id] = t.category_id; });
    const { data: catFieldRows } = await sb.from('task_category_fields').select('category_id, field_key, label');
    const labelByKeyPerCategory = {};
    (catFieldRows || []).forEach(f => { (labelByKeyPerCategory[f.category_id] ||= {})[f.field_key] = f.label; });
    // Same "first match wins" global fallback the Leads tab's own
    // extraFieldsLabel() uses — covers a field whose category changed or
    // was removed after the fact, so a row doesn't just show raw keys.
    const globalLabelByKey = {};
    (catFieldRows || []).forEach(f => { if(!(f.field_key in globalLabelByKey)) globalLabelByKey[f.field_key] = f.label; });

    body.innerHTML = '';
    // v141: Accept/Reject/Delete added here directly on the same `leads`
    // rows Leads Queue Review already reviews — this is just a second
    // surface onto them, scoped to whatever custom fields the extension
    // collected for that task category. Gated the same way the RLS policy
    // actually enforces it server-side -- Delete additionally Owner/Admin
    // only, same convention as every other Delete lead control on the
    // Leads tab.
    // v491 FIX: this used to read canEditTab('leads') -- a whole-tab
    // checkbox no role has EVER set (tab_edit is {} for every real role),
    // so it silently evaluated true unconditionally and this comment's own
    // claim ("gated the same way the RLS policy enforces it") went stale
    // the moment v489 fixed the `leads` table's own UPDATE policy to drop
    // that exact always-true role_can_edit_tab('leads') OR-branch in favor
    // of the three granular leads_sections edit flags. Left unfixed here,
    // Accept/Reject buttons rendered fully clickable for EVERY role that
    // could merely see this Extension sub-tab (canViewActivitySection
    // defaults every section open) regardless of their real
    // queue_review/tickets_review/queue_review_ispeedtolead edit grants --
    // live-confirmed with the real 'sales' role (all three edit flags
    // false): the buttons showed, and only a raw 42501 from RLS actually
    // stopped the write. Now mirrors the exact 3-way OR the `leads` UPDATE
    // policy checks, same as queue_review/queue_review_ispeedtolead's own
    // Accept/Reject already do on the Leads tab itself.
    const canEditLeadsHere = canEditLeadsSection('queue_review') || canEditLeadsSection('tickets_review') || canEditLeadsSection('queue_review_ispeedtolead');
    const canDeleteLeadsHere = myIsOwner || myRole === 'admin';
    rowsData.forEach(r => {
      const catId = categoryIdByTaskId[r.task_id];
      const defs = (catId && labelByKeyPerCategory[catId]) || {};
      // v: extra_fields can now be null/empty here — the rowsData filter
      // that used to guarantee otherwise was removed (see the comment
      // above rowsData) so a task with no custom fields defined still
      // shows its submissions, just with nothing in this column.
      const rowExtraFields = (r.extra_fields && typeof r.extra_fields === 'object') ? r.extra_fields : {};
      const fieldsText = Object.keys(rowExtraFields)
        .filter(k => k !== 'recording_url' && rowExtraFields[k] !== null && rowExtraFields[k] !== '')
        .map(k => `${defs[k] || globalLabelByKey[k] || k}: ${rowExtraFields[k]}`)
        .join(', ') || '—';
      const meta = LEAD_STATUS_META[r.status] || LEAD_STATUS_META.pending;
      const rejectedLocked = r.status === 'rejected' && !!r.review_note;
      const agentLabel = nameById[r.user_id] || 'Agent';
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="mono" style="color:var(--text-2);">${fmt(r.submitted_at, r.user_id)}</td>
        <td>${escapeHtml(agentLabel)}</td>
        <td>${escapeHtml(taskNameById[r.task_id] || '—')}</td>
        <td>${escapeHtml(fieldsText)}</td>
        <td><span class="dot ${meta.dot}"></span><span class="${meta.text}">${meta.label}</span></td>
        <td><div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
          ${r.status !== 'accepted' && !rejectedLocked && canEditLeadsHere ? `<button class="staff-work-accept-btn" style="background:transparent; border:1px solid var(--good); border-radius:6px; color:var(--good); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px;">Accept</button>` : ''}
          ${r.status !== 'rejected' && canEditLeadsHere ? `<button class="staff-work-reject-btn" style="background:transparent; border:1px solid var(--border-light); border-radius:6px; color:var(--danger); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px;">Reject</button>` : ''}
          ${canDeleteLeadsHere ? `<button class="staff-work-del-btn" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px; font-family:var(--mono);">Delete</button>` : ''}
        </div></td>
      `;
      const acceptBtn = tr.querySelector('.staff-work-accept-btn');
      const rejectBtn = tr.querySelector('.staff-work-reject-btn');
      const delBtn = tr.querySelector('.staff-work-del-btn');
      // setLeadStatus()/deleteLead() both already refresh Leads (loadLeads())
      // and, for deleteLead(), the leads.count that feeds the extension's
      // own "Total leads this month" figure lives on this same row — a
      // deleted row simply stops being counted next time the extension
      // polls GET_STATUS (its 15s usage cache — see background.js
      // getMonthlyLeadsTotal()). Re-running loadCallActivity() after each
      // action just refreshes this table's own view of the same data.
      // v584: guarded — setLeadStatus() notifies the client on accept, and
      // this button sat unguarded through the same slow await the modal
      // buttons did, so a second click sent a second SMS + email.
      if(acceptBtn) guardedClick(acceptBtn, async () => { await setLeadStatus(r, 'accepted', agentLabel); loadCallActivity(); });
      if(rejectBtn) guardedClick(rejectBtn, async () => { await setLeadStatus(r, 'rejected', agentLabel); loadCallActivity(); });
      if(delBtn) delBtn.addEventListener('click', async () => {
        if(!confirm(`Permanently delete this submission — ${agentLabel}, ${taskNameById[r.task_id] || 'task'}? This cannot be undone.`)) return;
        await deleteLead(r, `${agentLabel} — ${taskNameById[r.task_id] || 'Staff Work'}`);
        loadCallActivity();
      });
      body.appendChild(tr);
    });
  } else if(kind === 'staff_activity'){
    // v: cross-cutting per-agent report — one row per agent, aggregating
    // across leads (submitted + reviewed), ispeedtolead_submissions
    // (PrimeHome Buyers/gyhomes sends) and time_entries (logged hours),
    // narrowed by the same From/To + the new Role filter (Agent filter
    // above still applies too, when set to someone who happens to be in
    // it). Built from the recommendation: Extension's per-task pills only
    // ever show what an agent SUBMITTED into one task; this is the
    // review/dispatch/hours side, for any role, in one place — e.g.
    // "Quality Specialist" (leads reviewed + PrimeHome/gyhomes sends) or
    // "Virtual Assistant - Ops" (submitted + hours) both read off the
    // same table, just filtered differently.
    const roleSel = $('callActRoleFilter');
    const prevRole = roleSel.value;
    // agents (fetched above) only carries ghl_user_id/readymode_username-
    // linked staff — too narrow for this report (most reviewers/QA/VAs
    // have neither). Fetch the real full roster separately, same
    // PROTECTED_ROLES exclusion Timesheets' own agent picker uses.
    const { data: allProfiles } = await sb.from('profiles').select('id, full_name, email, role');
    const staffProfiles = (allProfiles || []).filter(p => !PROTECTED_ROLES.has(p.role));
    const allDistinctRoles = [...new Set(staffProfiles.map(p => p.role).filter(Boolean))].sort();
    roleSel.innerHTML = '<option value="">All roles</option>' + allDistinctRoles.map(r => `<option value="${escapeHtml(r)}">${escapeHtml(r)}</option>`).join('');
    roleSel.value = prevRole;
    const roleFilterVal = roleSel.value;

    const relevantAgents = staffProfiles.filter(p => (!roleFilterVal || p.role === roleFilterVal) && (!agentId || p.id === agentId));
    const relevantIds = relevantAgents.map(p => p.id);
    [$('actStatCardSaPrimehome'), $('actStatCardSaGyhomes'), $('actThSaPrimehome'), $('actThSaGyhomes')].forEach(el => { if(el) el.style.display = myRole === 'agent' ? 'none' : ''; });
    if(!relevantIds.length){
      body.innerHTML = `<tr><td colspan="${myRole === 'agent' ? 6 : 8}" class="empty">No agents match this role/agent filter.</td></tr>`;
      ['actStatSaAgents','actStatSaSubmitted','actStatSaAccepted','actStatSaRejected','actStatSaPrimehome','actStatSaGyhomes','actStatSaHours'].forEach(id => { if($(id)) $(id).textContent = '—'; });
      return;
    }

    // Chunked .in() — relevantIds can be the whole org when no role/agent
    // filter is set, same "don't risk an oversized IN() list" reasoning
    // as loadLeads()'s own fetchInChunks().
    const IDS_CHUNK = 200;
    async function fetchByIds(table, selectCols, idCol, dateCol, isOpenEndedRange){
      const rows = [];
      for(let i = 0; i < relevantIds.length; i += IDS_CHUNK){
        const chunk = relevantIds.slice(i, i + IDS_CHUNK);
        let q = sb.from(table).select(selectCols).in(idCol, chunk);
        if(dateCol){
          if(isOpenEndedRange){
            // time_entries: an entry can still be open (end_time null) --
            // match anything that overlaps the range, not just ones that
            // started in it, same logic loadCallActivity's other range
            // filters use for open-ended rows.
            if(rangeEnd) q = q.lte('start_time', rangeEnd);
            if(rangeStart) q = q.or(`end_time.is.null,end_time.gte.${rangeStart}`);
          } else {
            if(rangeStart) q = q.gte(dateCol, rangeStart);
            if(rangeEnd) q = q.lte(dateCol, rangeEnd);
          }
        }
        const { data: chunkData, error: chunkErr } = await q;
        if(chunkErr){ console.error(`Failed to load a chunk of ${table} for Staff Activity`, chunkErr); continue; }
        rows.push(...(chunkData || []));
      }
      return rows;
    }

    const [submittedRows, reviewedRows, ispdRows, hourRows] = await Promise.all([
      // v: addr/addr_alt pull ONLY the address string out of extra_fields
      // rather than the whole jsonb blob -- these rows carry ~25 keys each
      // including long free-text notes, and this report can fetch the entire
      // org's leads at once, so selecting extra_fields wholesale here would
      // be a large payload for one string. PostgREST's JSON-key select is
      // verified against the live API. form_address is the real field (it is
      // populated on 100% of leads); property_address exists on a handful of
      // older rows only, hence the fallback.
      fetchByIds('leads', 'id, user_id, reviewed_by, status, seller_phone_norm, seller_investor_name, review_note, reject_reason_category, reviewed_at, addr:extra_fields->>form_address, addr_alt:extra_fields->>property_address', 'user_id', 'submitted_at'),
      fetchByIds('leads', 'id, reviewed_by, status, seller_phone_norm, seller_investor_name, review_note, reject_reason_category, reviewed_at, addr:extra_fields->>form_address, addr_alt:extra_fields->>property_address', 'reviewed_by', 'reviewed_at'),
      fetchByIds('ispeedtolead_submissions', 'submitted_by, channel, success', 'submitted_by', 'created_at'),
      fetchByIds('time_entries', 'user_id, start_time, end_time, idle_seconds, break_seconds', 'user_id', 'start_time', true),
    ]);

    const perAgent = {};
    relevantAgents.forEach(p => { perAgent[p.id] = { submitted: 0, accepted: 0, rejected: 0, primehome: 0, gyhomes: 0, hoursSec: 0, acceptedPropertyKeys: new Set(), creditedLeadIds: new Set(), rejectedLeads: [] }; });
    // v: totals dedupe. One lead can now legitimately credit TWO rows of
    // this table -- the agent who SUBMITTED it and the reviewer who
    // ACCEPTED it (see both creditOutcome call sites below) -- so plainly
    // summing the columns would count that lead twice in the stat cards
    // above. These sets hold the distinct lead ids that actually earned a
    // credit, and the Accepted/Rejected cards are sized off them instead,
    // so a lead counts exactly once no matter how many rows show it.
    // Stated plainly because it otherwise reads as a bug: when a lead
    // credits both its submitter and its reviewer, the Accepted card is
    // DELIBERATELY lower than the sum of the Accepted column.
    const creditedAcceptedIds = new Set();
    const creditedRejectedIds = new Set();
    // BUG FIX (user report, 2026-09): a lead resubmitted 2-3x for the same
    // property (a true duplicate — see the 2026-09 iSpeedToLead backfill)
    // used to count as multiple separate "accepted" leads here, one per row,
    // just because each got its own Accept click. Dedupe per agent so a group
    // of duplicate rows only credits the agent once — one property, one
    // credit — matching what the sales bonus formula (which reads this same
    // 'accepted' status) actually assumes.
    //
    // BUG FIX (user request, 2026-09-11): that dedupe was keyed on PHONE,
    // which is the wrong identity. A lead is a PROPERTY, and one owner
    // routinely has several — a landlord selling three houses is three real
    // leads that share one phone number, and keying on the phone silently
    // collapsed them into a single credit, docking the agent for the other
    // two. Now keyed on the property address, via the same rmDedupeKey()
    // the ReadyMode/iSpeedToLead dedupe already uses (normalized street +
    // zip, with street-type and state abbreviation maps, so "123 North Main
    // Street, Cranston, Rhode Island" and "123 N Main St, Cranston, RI"
    // collapse correctly). Measured against production: this returns 4
    // accepted leads to one team leader and changes nobody else.
    //
    // Phone remains a LAST-RESORT key for a row with no address at all,
    // rather than "count everything separately" — without an address there
    // is no property identity to compare, so the old signal is the only one
    // left. Verified to be a theoretical path today: form_address is
    // populated on 100% of leads (2327/2327 over 180 days).
    // v: the property key and the "counts as accepted" rule both live at the
    // top of this file now (leadPropertyKey / leadCountsAsAccepted), shared
    // with the payroll figure in Reports so the two reports can no longer
    // disagree about one agent's number. See those helpers for the reasoning
    // behind the property key and the street-type collapse.
    function propertyKeyFor(r){
      return leadPropertyKey(r.addr || r.addr_alt, r.seller_phone_norm);
    }
    function creditOutcome(agent, r){
      // BUG FIX (user request, 2026-09): a rejection whose reason is
      // literally "Duplicate address/phone number" isn't a bad lead —
      // iSpeedToLead's own Lead Summary on these routinely says things like
      // "Good Lead" or "Normal Lead, but no database number match" (see the
      // 2026-09 export) — it's just already in their system, often because
      // another agent (or an earlier resubmission) got there first. Counting
      // it as a real rejection would unfairly dock the submitting agent for
      // having found a genuinely valid lead. Scoped ONLY to this Staff
      // Activity per-agent tally, per explicit request — leads.status stays
      // 'rejected' everywhere else (Leads Queue Review — PrimeHome Buyers,
      // ispeedtolead_postbacks, Reports) exactly as iSpeedToLead reported it.
      // v: checks reject_reason_category (the short category iSpeedToLead
      // actually returned), not review_note — review_note now carries the
      // ELABORATED Lead Summary text when one's available (see the 2026-09
      // Lead Summary fix) and would silently stop matching "Duplicate
      // address/phone number" verbatim the moment that text diverges.
      const effectiveStatus = leadCountsAsAccepted(r) ? 'accepted' : r.status;
      // v: one lead must never credit the SAME agent twice. Newly reachable
      // now that a lead credits its submitter AND its reviewer: an agent who
      // reviews their own submission (allowed since v140 removed the
      // self-accept restriction) matches BOTH fetches below and would
      // otherwise score the same lead once as submitter and again as
      // reviewer.
      if(agent.creditedLeadIds.has(r.id)) return;
      if(effectiveStatus === 'accepted'){
        const propertyKey = propertyKeyFor(r);
        if(propertyKey){
          if(agent.acceptedPropertyKeys.has(propertyKey)) return;
          agent.acceptedPropertyKeys.add(propertyKey);
        }
        agent.creditedLeadIds.add(r.id);
        creditedAcceptedIds.add(r.id);
        agent.accepted++;
      } else if(effectiveStatus === 'rejected'){
        agent.creditedLeadIds.add(r.id);
        creditedRejectedIds.add(r.id);
        agent.rejected++;
        agent.rejectedLeads.push(r);
      }
    }
    submittedRows.forEach(r => {
      const agent = perAgent[r.user_id];
      if(!agent) return;
      agent.submitted++;
      // BUG FIX (user report, 2026-09): Accepted/Rejected here used to come
      // ONLY from leads a human reviewed in Leads Queue Review
      // (reviewed_by set). But a lead's status routinely changes with NO
      // human involved at all — iSpeedToLead's own live postback (and the
      // 2026-09 backfill covering the ~7 weeks it never actually fired)
      // both update leads.status directly and deliberately leave
      // reviewed_by null ("this wasn't reviewed by a person" —
      // ispeedtolead-postback/index.ts). Those leads were invisible here
      // entirely, which is exactly why an agent's Accepted/Rejected totals
      // looked stuck even after real iSpeedToLead outcomes came in. Credit
      // the SUBMITTING agent for exactly the reviewed_by-null rows; anything
      // a human actually reviewed still credits the reviewer below, via
      // reviewedRows, so nothing here double-counts.
      //
      // BUG FIX (user report, 2026-09-11: "staff activity doesn't show
      // accepted manual leads on lead queue review"): that reviewed_by-null
      // condition was itself the next bug. It made submitter credit and
      // reviewer credit MUTUALLY EXCLUSIVE, so the moment a human accepted a
      // lead in Leads Queue Review the submitting agent lost the credit for
      // it -- permanently, and precisely for the leads a person vouched for.
      // Live-confirmed against production: of the 8 leads accepted by a real
      // reviewer, ALL 8 were submitted by role 'agent' and every one of those
      // agents showed Accepted = 0. Worse, 5 of the 8 were credited to NOBODY
      // AT ALL, because their reviewer was an owner/admin and PROTECTED_ROLES
      // strips those two from staffProfiles above -- so reviewedRows never
      // fetched them either and the accepted lead simply vanished from this
      // report.
      // Credit the submitter for their lead's outcome ALWAYS. This also makes
      // this table finally agree with how PAY has always counted the very
      // same thing: computeSalesPay()'s leadsCount query credits user_id for
      // status='accepted' with no reviewed_by condition whatsoever, so an
      // agent could be paid a lead bonus for an accepted lead this report
      // insisted they never got. Reviewers keep their own credit below;
      // double counting is handled by creditedLeadIds (per agent) and the
      // creditedAccepted/RejectedIds sets (totals).
      creditOutcome(agent, r);
    });
    reviewedRows.forEach(r => {
      const agent = perAgent[r.reviewed_by];
      if(!agent) return;
      creditOutcome(agent, r);
    });
    ispdRows.forEach(r => {
      if(!perAgent[r.submitted_by] || !r.success) return;
      if(r.channel === 'gyhomes') perAgent[r.submitted_by].gyhomes++;
      else perAgent[r.submitted_by].primehome++;
    });
    const rangeStartMs = rangeStart ? new Date(rangeStart).getTime() : -Infinity;
    const rangeEndMs = rangeEnd ? new Date(rangeEnd).getTime() : Infinity;
    hourRows.forEach(e => {
      if(!perAgent[e.user_id]) return;
      const startMs = Math.max(new Date(e.start_time).getTime(), rangeStartMs);
      const endMs = Math.min(e.end_time ? new Date(e.end_time).getTime() : Date.now(), rangeEndMs);
      const rawSec = Math.max(0, (endMs - startMs) / 1000 - (e.idle_seconds || 0) - (e.break_seconds || 0));
      perAgent[e.user_id].hoursSec += rawSec;
    });

    let totals = { submitted: 0, accepted: 0, rejected: 0, primehome: 0, gyhomes: 0, hoursSec: 0 };
    const rows = relevantAgents.map(p => {
      const s = perAgent[p.id];
      totals.submitted += s.submitted;
      totals.primehome += s.primehome; totals.gyhomes += s.gyhomes; totals.hoursSec += s.hoursSec;
      return { agent: p, stats: s };
    }).sort((a, b) => (a.agent.full_name || a.agent.email || '').localeCompare(b.agent.full_name || b.agent.email || ''));

    // v: Accepted/Rejected come from the distinct-lead sets, NOT from summing
    // the per-agent columns, so a lead credited to both its submitter and its
    // reviewer still counts once here. Submitted/PrimeHome/gyhomes/hours stay
    // plain sums -- those are per-person facts that cannot describe one shared
    // lead, so they have nothing to dedupe.
    totals.accepted = creditedAcceptedIds.size;
    totals.rejected = creditedRejectedIds.size;

    if($('actStatSaAgents')){
      $('actStatSaAgents').textContent = rows.length;
      $('actStatSaSubmitted').textContent = totals.submitted;
      $('actStatSaAccepted').textContent = totals.accepted;
      $('actStatSaRejected').textContent = totals.rejected;
      $('actStatSaPrimehome').textContent = totals.primehome;
      $('actStatSaGyhomes').textContent = totals.gyhomes;
      $('actStatSaHours').textContent = fmtShort(totals.hoursSec);
    }

    // BUG FIX (user request, 2026-09): the "Sent PrimeHome Buyers"/"Sent
    // gyhomes" columns are dispatch-side numbers (who SENT leads onward to
    // those channels) — meaningless, and explicitly not wanted, for staff
    // whose role is literally "agent". Everyone else (QA/VA/sales/team
    // leader/admin/owner) keeps seeing them. Cards/header cells already
    // toggled above, before the early-return — this just needs the same
    // flag to size the row markup and the "why rejected" colspan below.
    const hidePrimehomeGyhomes = myRole === 'agent';
    const colCount = hidePrimehomeGyhomes ? 6 : 8;

    body.innerHTML = '';
    rows.forEach(({ agent: p, stats: s }) => {
      const hasRejections = s.rejectedLeads.length > 0;
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${escapeHtml(p.full_name || p.email || '—')}</td>
        <td style="color:var(--text-2);">${escapeHtml(p.role || '—')}</td>
        <td class="mono">${s.submitted}</td>
        <td class="mono good">${s.accepted}</td>
        <td class="mono bad">${hasRejections ? `<button class="staff-activity-rejected-btn" style="background:none; border:none; color:inherit; font:inherit; cursor:pointer; text-decoration:underline dotted; padding:0;" title="Click to see why each lead was rejected">${s.rejected}</button>` : s.rejected}</td>
        ${hidePrimehomeGyhomes ? '' : `<td class="mono">${s.primehome}</td><td class="mono">${s.gyhomes}</td>`}
        <td class="mono">${fmtShort(s.hoursSec)}</td>
      `;
      body.appendChild(tr);
      // v: lead summary drill-down — an agent/manager clicking the Rejected
      // count sees WHY each one was rejected, via a Rejected Reason column
      // (reject_reason_category — the short category iSpeedToLead itself
      // returned, e.g. "Rejected by AI") AND a Lead Summary column
      // (review_note — the elaborated explanation, when there is one),
      // instead of a bare count with no way to see the reason short of
      // opening Leads Queue Review. Split into two columns because
      // review_note now carries the elaborated text INSTEAD OF the short
      // category for AI-driven rejections (see the 2026-09 Lead Summary
      // fix) — showing only one or the other would lose information either
      // way.
      if(hasRejections){
        const detailTr = document.createElement('tr');
        detailTr.style.display = 'none';
        const items = s.rejectedLeads.slice().sort((a, b) => new Date(b.reviewed_at || 0) - new Date(a.reviewed_at || 0));
        detailTr.innerHTML = `<td colspan="${colCount}" style="background:rgba(127,127,127,0.08); padding:10px 16px;">
          <table style="width:100%; font-size:12px; border-collapse:collapse;">
            <thead>
              <tr style="text-align:left; color:var(--text-dim); text-transform:uppercase; letter-spacing:.04em; font-size:10px;">
                <th style="font-weight:600; padding:0 10px 6px 0;">Date</th>
                <th style="font-weight:600; padding:0 10px 6px 0;">Lead</th>
                <th style="font-weight:600; padding:0 10px 6px 0;">Rejected Reason</th>
                <th style="font-weight:600; padding:0 0 6px 0;">Lead Summary</th>
              </tr>
            </thead>
            <tbody>
            ${items.map(l => `
              <tr>
                <td style="white-space:nowrap; color:var(--text-2); padding:2px 10px 2px 0; vertical-align:top;">${l.reviewed_at ? new Date(l.reviewed_at).toLocaleDateString() : '—'}</td>
                <td style="white-space:nowrap; padding:2px 10px 2px 0; vertical-align:top;">${escapeHtml(l.seller_investor_name || '—')}</td>
                <td style="white-space:nowrap; padding:2px 10px 2px 0; vertical-align:top;">${escapeHtml(l.reject_reason_category || '—')}</td>
                <td style="padding:2px 0;">${escapeHtml(l.review_note || 'No reason recorded')}</td>
              </tr>
            `).join('')}
            </tbody>
          </table>
        </td>`;
        body.appendChild(detailTr);
        const toggleBtn = tr.querySelector('.staff-activity-rejected-btn');
        if(toggleBtn) toggleBtn.addEventListener('click', () => { detailTr.style.display = detailTr.style.display === 'none' ? '' : 'none'; });
      }
    });
  }
}

// Fetches row counts (not full rows) from ghl_calls / ghl_messages /
// ghl_appointments / readymode_calls / readymode_productivity_daily for
// the same agent + date-range filters as the table above, and fills in
// the stat cards for BOTH group-specific rows (only one of which is
// visible at a time — see activateActivityGroup()) so switching groups
// never has to wait on a fresh fetch. head:true + count:'exact' asks
// Postgres for just the count, so this stays cheap even with a lot of
// activity. Each table's own timestamp/date column is used for the range
// filter (call_at / message_at / start_time / work_date) since they don't
// share one.
async function loadActivityTotals(agentId, dirVal, rangeStart, rangeEnd){
  const setStat = (id, n, isError) => {
    $(id).textContent = isError ? '—' : String(n ?? 0);
  };

  const withFilters = (query, col, { direction, hasAgent } = {}) => {
    if(rangeStart) query = query.gte(col, rangeStart);
    if(rangeEnd) query = query.lte(col, rangeEnd);
    if(agentId && hasAgent) query = query.eq('user_id', agentId);
    if(direction && dirVal) query = query.eq('direction', dirVal);
    return query;
  };
  // readymode_productivity_daily's work_date is a plain date column (no
  // time component), so range filtering needs the date-only slice, same
  // convention as the 'agent_report'/'productivity' branches in
  // loadCallActivity() above.
  const withDateFilters = (query, col, { hasAgent } = {}) => {
    if(rangeStart) query = query.gte(col, rangeStart.slice(0,10));
    if(rangeEnd) query = query.lte(col, rangeEnd.slice(0,10));
    if(agentId && hasAgent) query = query.eq('user_id', agentId);
    return query;
  };

  // Appointments need the same start_time-or-received_at fallback used by
  // the table query above (see loadCallActivity's 'appointment' branch) —
  // otherwise appointments with no start_time from the webhook would be
  // silently excluded here too, undercounting this stat card.
  let apptsQuery = sb.from('ghl_appointments').select('id', { count: 'exact', head: true });
  if(rangeStart && rangeEnd){
    apptsQuery = apptsQuery.or(`and(start_time.gte.${rangeStart},start_time.lte.${rangeEnd}),and(start_time.is.null,received_at.gte.${rangeStart},received_at.lte.${rangeEnd})`);
  } else if(rangeStart){
    apptsQuery = apptsQuery.or(`start_time.gte.${rangeStart},and(start_time.is.null,received_at.gte.${rangeStart})`);
  } else if(rangeEnd){
    apptsQuery = apptsQuery.or(`start_time.lte.${rangeEnd},and(start_time.is.null,received_at.lte.${rangeEnd})`);
  }
  if(agentId) apptsQuery = apptsQuery.eq('user_id', agentId);

  // v395: same -5h shift as loadCallActivity's own 'call' branch (see
  // ghlCallAtRangeISO's comment) -- without it this stat card and the
  // Call log table it sits above could disagree on how many calls fall
  // in the selected range near a day boundary.
  const { start: callsRangeStart, end: callsRangeEnd } = ghlCallAtRangeISO(rangeStart, rangeEnd);
  let callsQuery = sb.from('ghl_calls').select('id', { count: 'exact', head: true });
  if(callsRangeStart) callsQuery = callsQuery.gte('call_at', callsRangeStart);
  if(callsRangeEnd) callsQuery = callsQuery.lte('call_at', callsRangeEnd);
  if(agentId) callsQuery = callsQuery.eq('user_id', agentId);
  if(dirVal) callsQuery = callsQuery.eq('direction', dirVal);

  // v477: counts client_sms_log (send-client-sms's own audit trail) —
  // kind != 'manual' only, same automated/one-way scope as the Texts
  // subtab's own table — instead of the old ghl_messages pipeline this
  // used to count (see loadCallActivity's 'sms' branch for the full
  // reasoning). No 'direction' column on this table (every row here IS
  // an outbound send by definition), and the agent filter is by
  // sent_by, not user_id.
  let textsQuery = sb.from('client_sms_log').select('id', { count: 'exact', head: true }).neq('kind', 'manual');
  if(rangeStart) textsQuery = textsQuery.gte('created_at', rangeStart);
  if(rangeEnd) textsQuery = textsQuery.lte('created_at', rangeEnd);
  if(agentId) textsQuery = textsQuery.eq('sent_by', agentId);

  const [calls, texts, appts, rmCalls, agentReportRows] = await Promise.all([
    callsQuery,
    textsQuery,
    apptsQuery,
    withFilters(sb.from('readymode_calls').select('id', { count: 'exact', head: true }), 'call_at', { direction: true, hasAgent: true }),
    withDateFilters(sb.from('readymode_productivity_daily').select('id', { count: 'exact', head: true }), 'work_date', { hasAgent: true }),
  ]);

  setStat('actStatCalls', calls.count, calls.error);
  setStat('actStatTexts', texts.count, texts.error);
  setStat('actStatAppointments', appts.count, appts.error);
  setStat('actStatRmCalls', rmCalls.count, rmCalls.error);
  // Agent Report and Productivity are two views over the exact same
  // readymode_productivity_daily rows (see mapAgentDailyRow in
  // readymode-api), so they share the same count — not a bug, just the
  // same underlying data shown two different ways.
  setStat('actStatAgentReport', agentReportRows.count, agentReportRows.error);
  setStat('actStatProductivity', agentReportRows.count, agentReportRows.error);
  // v360: the iSpeedToLead postbacks stat block that used to live here
  // moved to loadFinanceIspeedtoleadPostbacks() below, alongside the rest
  // of the relocated Postbacks feature (Finance -> iSpeedToLead Postbacks).
}

function toDatetimeLocal(iso){
  if(!iso) return '';
  const d = new Date(iso);
  const pad = n => String(n).padStart(2,'0');
  return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

function updateTsModalDuration(){
  const startVal = $('tsModalStart').value;
  const endVal = $('tsModalEnd').value;
  const idleMin = parseInt($('tsModalIdle').value, 10) || 0;
  const breakMin = parseInt($('tsModalBreak').value, 10) || 0;
  const durEl = $('tsModalDuration');
  if(!startVal){ durEl.textContent = '00:00'; return; }
  const startMs = new Date(startVal).getTime();
  const endMs = endVal ? new Date(endVal).getTime() : Date.now();
  const netSec = Math.max(0, (endMs - startMs) / 1000 - idleMin*60 - breakMin*60);
  const h = Math.floor(netSec / 3600), m = Math.floor((netSec % 3600) / 60);
  durEl.textContent = `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;
}
['tsModalStart','tsModalEnd','tsModalIdle','tsModalBreak'].forEach(id => {
  $(id).addEventListener('input', updateTsModalDuration);
});

function openTsModal(entry){
  $('tsModalMsg').textContent = '';
  $('tsModalEntryId').value = entry ? entry.id : '';
  $('tsModalTitle').textContent = entry ? 'Edit entry' : 'Add manual entry';
  // v: a non-admin role can no longer add or edit their OWN manual time
  // entry at the DB layer (see can_manage_timesheet_for() in the RLS
  // migration) -- the one exception is editing an entry that's already
  // theirs while it's still live/open (the self-update branch, unrelated
  // to is_manual). Excluding their own name from this picker means that
  // DB rule shows up as "you're just not in the list" instead of a raw
  // RLS error after Save.
  const excludeSelf = !myPermissions.isProtected && !(entry && entry.user_id === myUserId);
  const agentOptions = excludeSelf ? tsAllAgents.filter(a => a.id !== myUserId) : tsAllAgents;
  $('tsModalAgent').innerHTML = agentOptions.map(a => `<option value="${a.id}">${escapeHtml(a.full_name || a.email)}</option>`).join('');
  if(excludeSelf && !agentOptions.length){
    $('tsModalMsg').textContent = "You don't have any assigned team members to add time for.";
  }
  const wantedAgentId = entry ? entry.user_id : ($('tsAgentFilter').value || '');
  $('tsModalAgent').value = agentOptions.some(a => a.id === wantedAgentId) ? wantedAgentId : ((agentOptions[0]||{}).id || '');
  $('tsModalTask').value = entry ? (entry.task_id || '') : '';
  $('tsModalStart').value = entry ? toDatetimeLocal(entry.start_time) : toDatetimeLocal(new Date().toISOString());
  $('tsModalEnd').value = entry ? toDatetimeLocal(entry.end_time) : toDatetimeLocal(new Date().toISOString());
  $('tsModalIdle').value = entry ? Math.round((entry.idle_seconds||0)/60) : 0;
  $('tsModalBreak').value = entry ? Math.round((entry.break_seconds||0)/60) : 0;
  updateTsModalDuration();
  $('tsModalOverlay').classList.add('active');
}
function closeTsModal(){
  $('tsModalOverlay').classList.remove('active');
}
$('tsAddEntryBtn').addEventListener('click', () => openTsModal(null));
$('tsModalCancelBtn').addEventListener('click', closeTsModal);
$('tsModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'tsModalOverlay') closeTsModal(); });

$('tsModalSaveBtn').addEventListener('click', async () => {
  const id = $('tsModalEntryId').value;
  const userId = $('tsModalAgent').value;
  const taskId = $('tsModalTask').value;
  const startVal = $('tsModalStart').value;
  const endVal = $('tsModalEnd').value;
  const msg = $('tsModalMsg');

  if(!userId || !startVal){
    msg.textContent = 'User and start time are required.';
    return;
  }
  const newStartMs = new Date(startVal).getTime();
  const newEndMs = endVal ? new Date(endVal).getTime() : Date.now();
  if(endVal && newEndMs <= newStartMs){
    msg.textContent = 'End time must be after start time.';
    return;
  }

  // Overlap pre-check: give a clear, friendly error in the UI. The
  // database's exclusion constraint (schema.sql) is the final backstop,
  // but its error message is a raw Postgres error — this catches the
  // common case up front instead.
  // This is an existence check (only overlapping[0] is ever read), so it
  // doesn't need fetchAllRows()'s full pagination — just capped to 1 row
  // instead of letting an open-ended new entry's unbounded upper window
  // pull back (and discard) every one of this agent's entries that hasn't
  // ended yet.
  let overlapQuery = sb.from('time_entries')
    .select('id, start_time, end_time')
    .eq('user_id', userId)
    .or(`end_time.is.null,end_time.gt.${new Date(newStartMs).toISOString()}`)
    .lt('start_time', endVal ? new Date(newEndMs).toISOString() : new Date(8640000000000000).toISOString())
    .limit(1);
  if(id) overlapQuery = overlapQuery.neq('id', id);
  const { data: overlapping } = await overlapQuery;
  if(overlapping && overlapping.length > 0){
    const other = overlapping[0];
    const fmt = d => tsFmtDateTime(d, userId);
    msg.textContent = `Overlaps an existing entry for this agent (${fmt(other.start_time)} \u2013 ${other.end_time ? fmt(other.end_time) : 'live'}). Adjust the time range.`;
    return;
  }

  const payload = {
    user_id: userId,
    task_id: taskId || null,
    start_time: new Date(startVal).toISOString(),
    end_time: endVal ? new Date(endVal).toISOString() : null,
    idle_seconds: (parseInt($('tsModalIdle').value, 10) || 0) * 60,
    break_seconds: (parseInt($('tsModalBreak').value, 10) || 0) * 60,
  };
  if(!id) payload.is_manual = true; // only brand-new entries count as "manual" — editing a real tracked entry doesn't retroactively make it one
  // v144: "Actions -> Edit" on a real tracked entry marks it manually
  // adjusted (see the editedTag render above) — a plain audit trail via
  // logActivity() already existed, but this makes the correction visible
  // right on the entry itself without opening the Audit Log. Brand-new
  // manual entries (is_manual, set above) don't also get this — the
  // "manual" tag alone already says everything about that row's origin.
  if(id) payload.is_edited = true;

  const { error } = id
    ? await sb.from('time_entries').update(payload).eq('id', id)
    : await sb.from('time_entries').insert(payload);

  if(error){
    // Friendlier text for the DB exclusion-constraint violation (belt-and-
    // braces backstop for the pre-check above, e.g. a race with another
    // admin edit or the extension starting a session at the same moment).
    msg.textContent = /exclude|overlap/i.test(error.message)
      ? 'This overlaps another time entry for this agent. Adjust the time range and try again.'
      : error.message;
    return;
  }
  const agentLabel = (tsAllAgents.find(a=>a.id===userId)||{}).full_name
    || (tsAllAgents.find(a=>a.id===userId)||{}).email || userId;
  const taskLabel = (tsAllTasks.find(t=>t.id===taskId)||{}).name || 'no task';
  closeTsModal();
  loadTimesheets();
  loadTeam();
  refreshDetailIfViewing(userId);
  logActivity(id ? 'time_entry.update' : 'time_entry.create', 'time_entry', id || null,
    `${id ? 'Edited' : 'Added manual'} entry for ${agentLabel} — ${taskLabel}, ${new Date(payload.start_time).toLocaleString()} to ${payload.end_time ? new Date(payload.end_time).toLocaleString() : 'live'}`);
});

async function endTimesheetEntryNow(entry, label){
  const nowISO = new Date().toISOString();
  const { error } = await sb.from('time_entries')
    .update({ end_time: nowISO })
    .eq('id', entry.id)
    .is('end_time', null); // guard against a race — only close it if it's still actually open
  if(error){
    alert(`Couldn't end this entry: ${error.message}`);
    return;
  }
  loadTimesheets();
  loadTeam();
  await refreshDetailIfViewing(entry.user_id);
  logActivity('time_entry.end_now', 'time_entry', entry.id, `Ended live entry now for ${label || entry.id}`);
}

async function deleteTimesheetEntry(entry, label){
  const id = typeof entry === 'object' ? entry.id : entry; // accept either the full row or just an id
  const userId = typeof entry === 'object' ? entry.user_id : null;
  await sb.from('time_entries').delete().eq('id', id);
  loadTimesheets();
  loadTeam();
  if(userId) await refreshDetailIfViewing(userId);
  logActivity('time_entry.delete', 'time_entry', id, `Deleted time entry — ${label || id}`);
}

// ---------- leads tab ----------
