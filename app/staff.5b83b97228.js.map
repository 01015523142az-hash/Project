let financeCategories = [];    // finance_expense_categories rows
let financeVendorMap = [];     // finance_vendor_category_map rows
let financeTransactions = [];  // fetched finance_bank_transactions rows (date-range scoped)
let financeParsedRows = [];    // pending CSV import preview rows
let financeCategoriesLoaded = false;

async function loadFinanceCategoriesAndVendorMap(){
  const [{ data: cats }, { data: vmap }] = await Promise.all([
    sb.from('finance_expense_categories').select('id, name, is_transfer, sort_order').order('sort_order'),
    sb.from('finance_vendor_category_map').select('id, pattern, match_type, category_id'),
  ]);
  financeCategories = cats || [];
  financeVendorMap = vmap || [];
  financeCategoriesLoaded = true;
  const invCatSel = $('financeInvoiceCategory');
  if(invCatSel) invCatSel.innerHTML = '<option value="">Uncategorized</option>' + financeCategories.map(c => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join('');
}
function financeCategoryLabel(categoryId){
  const c = financeCategories.find(c => c.id === categoryId);
  return c ? c.name : 'Uncategorized';
}
function financeNormalizeVendor(s){ return String(s || '').trim().toUpperCase(); }
function lookupVendorCategory(payee){
  const norm = financeNormalizeVendor(payee);
  if(!norm) return null;
  const exact = financeVendorMap.find(v => v.match_type === 'exact' && v.pattern === norm);
  if(exact) return exact.category_id;
  const contains = financeVendorMap.find(v => v.match_type === 'contains' && norm.includes(v.pattern));
  return contains ? contains.category_id : null;
}

// v219: dedup key for a bank-statement row — see v219-finance-tab.sql's
// own comment on finance_bank_transactions.dedup_key for why `balance`
// (Relay's own running balance after this line) has to be part of the
// hash: two real, DIFFERENT same-day/same-amount/same-description
// transactions exist in practice (e.g. two separate $10 SaaS charges the
// same day), and balance is the only field that reliably tells them apart
// while staying identical across a genuine re-export of the same
// historical (already-settled, immutable) row.
async function financeDedupKey(row){
  const norm = s => String(s || '').trim().toUpperCase().replace(/\s+/g, ' ');
  const raw = [
    row.account_number, row.txn_date, row.amount.toFixed(2),
    row.balance != null ? row.balance.toFixed(2) : '',
    norm(row.payee), norm(row.description), norm(row.reference),
  ].join('|');
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(raw));
  return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
}

// Relay's header is fixed/known (unlike the flexible-header PrimeHome
// Buyers CSV importer), so this is just column-presence validation, not
// fuzzy header matching.
const RELAY_CSV_COLUMNS = ['Date', 'Payee', 'Account #', 'Transaction Type', 'Description', 'Reference', 'Status', 'Amount', 'Currency', 'Balance'];
function parseRelayCsv(headerRow, dataRows){
  const norm = s => String(s || '').trim().toLowerCase();
  const idx = {};
  RELAY_CSV_COLUMNS.forEach(h => { idx[h] = headerRow.findIndex(c => norm(c) === norm(h)); });
  if(idx['Date'] < 0 || idx['Amount'] < 0 || idx['Transaction Type'] < 0 || idx['Status'] < 0){
    throw new Error("This doesn't look like a Relay statement export — missing required columns.");
  }
  return dataRows.map(r => {
    const dateRaw = String(r[idx['Date']] || '').trim();
    const [m, d, yRaw] = dateRaw.split('/').map(Number);
    // Relay exports have been seen with both 4-digit ("6/24/2026") and
    // 2-digit ("6/24/26") years — a bare 2-digit year built a "26-06-24"
    // txn_date string that Postgres rejects as out-of-range, so expand it
    // to a 4-digit year the same way native Date parsing would (0-68 =>
    // 2000-2068, matching this company's operating date range).
    const y = (yRaw && yRaw < 100) ? (yRaw <= 68 ? 2000 + yRaw : 1900 + yRaw) : yRaw;
    const amountRaw = String(r[idx['Amount']] ?? '').replace(/[$,]/g, '').trim();
    const balanceRaw = idx['Balance'] >= 0 ? String(r[idx['Balance']] ?? '').replace(/[$,]/g, '').trim() : '';
    return {
      txn_date: (y && m && d) ? `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}` : null,
      payee: (r[idx['Payee']] || '').trim() || null,
      payee_account_ref: idx['Account #'] >= 0 ? ((r[idx['Account #']] || '').trim() || null) : null,
      transaction_type: (r[idx['Transaction Type']] || '').trim(),
      description: (r[idx['Description']] || '').trim() || null,
      reference: (r[idx['Reference']] || '').trim() || null,
      status: (r[idx['Status']] || '').trim(),
      amount: amountRaw ? parseFloat(amountRaw) : NaN,
      currency: (idx['Currency'] >= 0 ? (r[idx['Currency']] || '').trim() : '') || 'USD',
      balance: balanceRaw !== '' ? parseFloat(balanceRaw) : null,
    };
  }).filter(row => row.txn_date && !Number.isNaN(row.amount));
}

$('financeUploadInput').addEventListener('change', async (e) => {
  const file = e.target.files[0];
  const msg = $('financeUploadMsg');
  msg.style.display = 'none';
  $('financeUploadPreviewWrap').style.display = 'none';
  if(!file) return;
  try{
    if(!financeCategoriesLoaded) await loadFinanceCategoriesAndVendorMap();
    // Relay's own account number lives only in the filename (e.g. "Relay
    // 2026-05-01 #0996.csv"), never a CSV column — infer it, but leave the
    // dropdown user-editable in case the naming convention ever changes.
    const fnameMatch = file.name.match(/#(\d{3,6})/);
    if(fnameMatch) $('financeAccountSelect').value = fnameMatch[1];
    const accountNumber = $('financeAccountSelect').value;

    const buf = await file.arrayBuffer();
    await ensureXlsx();
    const wb = XLSX.read(buf, { type: 'array' });
    const sheet = wb.Sheets[wb.SheetNames[0]];
    const rows = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '', raw: false });
    if(!rows.length){ msg.textContent = 'That file has no rows.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }
    const headerRow = rows[0].map(h => String(h || '').trim());
    const dataRows = rows.slice(1).filter(r => r.some(c => String(c || '').trim() !== ''));
    // 2 of the real Relay sample exports have zero transaction rows for a
    // given month — a clean message here, not an error.
    if(!dataRows.length){ msg.textContent = 'No transaction rows found in this file.'; msg.className = 'msg'; msg.style.display = 'block'; return; }

    const parsed = parseRelayCsv(headerRow, dataRows).map(row => ({ ...row, account_number: accountNumber }));
    if(!parsed.length){ msg.textContent = 'No usable transaction rows found in this file.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }

    const transfersCat = financeCategories.find(c => c.is_transfer);
    for(const row of parsed){
      row.dedup_key = await financeDedupKey(row);
      row.is_internal_transfer = ['Receive-transfer', 'Spend-transfer'].includes(row.transaction_type);
      row.category_id = row.is_internal_transfer ? (transfersCat ? transfersCat.id : null) : lookupVendorCategory(row.payee);
    }

    const allKeys = parsed.map(r => r.dedup_key);
    const { data: existing, error: existErr } = await sb.from('finance_bank_transactions').select('dedup_key').in('dedup_key', allKeys);
    if(existErr){ msg.textContent = existErr.message; msg.className = 'msg error'; msg.style.display = 'block'; return; }
    const existingKeys = new Set((existing || []).map(r => r.dedup_key));
    parsed.forEach(row => { row.isNew = !existingKeys.has(row.dedup_key); });

    financeParsedRows = parsed;
    financeParsedRows.sourceFilename = file.name;
    renderFinancePreview();
  }catch(err){
    msg.textContent = `Couldn't read that file: ${err.message}`;
    msg.className = 'msg error';
    msg.style.display = 'block';
  }
});

function renderFinancePreview(){
  const newCount = financeParsedRows.filter(r => r.isNew).length;
  const skipCount = financeParsedRows.length - newCount;
  $('financePreviewHead').innerHTML = `<tr><th>Status</th><th>Date</th><th>Payee</th><th>Description</th><th>Amount</th><th>Category</th></tr>`;
  $('financePreviewBody').innerHTML = financeParsedRows.map(r => `
    <tr style="${r.isNew ? '' : 'opacity:0.5;'}">
      <td class="mono" style="white-space:nowrap; color:${r.isNew ? 'var(--focus)' : 'var(--text-dim)'};">${r.isNew ? 'New' : 'Already imported'}</td>
      <td class="mono">${escapeHtml(r.txn_date)}</td>
      <td>${escapeHtml(r.payee || '—')}</td>
      <td style="max-width:220px;" title="${escapeHtml(r.description || '')}">${escapeHtml((r.description || '').slice(0, 40))}</td>
      <td class="mono" style="color:${r.amount < 0 ? 'var(--danger)' : 'var(--good)'};">${r.amount < 0 ? '-' : '+'}$${Math.abs(r.amount).toFixed(2)}</td>
      <td>${escapeHtml(financeCategoryLabel(r.category_id))}</td>
    </tr>
  `).join('');
  $('financeImportCount').textContent = `${newCount} new, ${skipCount} already imported (skipped)`;
  $('financeConfirmImportBtn').disabled = newCount === 0;
  $('financeUploadPreviewWrap').style.display = '';
}

$('financeCancelImportBtn').addEventListener('click', () => {
  financeParsedRows = [];
  $('financeUploadPreviewWrap').style.display = 'none';
  $('financeUploadInput').value = '';
});

$('financeConfirmImportBtn').addEventListener('click', async () => {
  const msg = $('financeUploadMsg');
  const btn = $('financeConfirmImportBtn');
  const { data: { user } } = await sb.auth.getUser();
  const newRows = financeParsedRows.filter(r => r.isNew);
  if(!newRows.length) return;
  btn.disabled = true;
  btn.textContent = 'Importing…';
  const sourceFilename = financeParsedRows.sourceFilename || 'unknown.csv';
  const payload = newRows.map(r => ({
    account_number: r.account_number,
    txn_date: r.txn_date, payee: r.payee, payee_account_ref: r.payee_account_ref,
    transaction_type: r.transaction_type, description: r.description, reference: r.reference,
    status: r.status, amount: r.amount, currency: r.currency, balance: r.balance,
    category_id: r.category_id, is_internal_transfer: r.is_internal_transfer,
    source_filename: sourceFilename, imported_by: user ? user.id : null, dedup_key: r.dedup_key,
  }));
  // ignoreDuplicates (ON CONFLICT DO NOTHING on dedup_key) is the safety
  // net for a race — e.g. the same file uploaded from two tabs — on top
  // of the client-side New/Already-imported filtering above.
  const { error } = await sb.from('finance_bank_transactions')
    .upsert(payload, { onConflict: 'dedup_key', ignoreDuplicates: true });
  btn.disabled = false;
  btn.textContent = 'Import';
  if(error){ msg.textContent = error.message; msg.className = 'msg error'; msg.style.display = 'block'; return; }
  msg.textContent = `Imported ${newRows.length} transaction(s) from ${sourceFilename}.`;
  msg.className = 'msg';
  msg.style.display = 'block';
  logActivity('finance.import_transactions', null, null, `Imported ${newRows.length} bank transaction(s) from ${sourceFilename}`);
  financeParsedRows = [];
  $('financeUploadPreviewWrap').style.display = 'none';
  $('financeUploadInput').value = '';
  await loadFinanceData();
});

// v516: picks up a RelayFi "Email statement" send from the invoices Gmail
// inbox and imports it through gmail-api's sync_relayfi_statements action
// (same dedup_key path as the manual CSV upload right above — see that
// action's own header comment for why the two can never double-import
// each other's rows). No preview step (unlike the manual path) since this
// is meant to be a single "sync and see the result" click, not a review
// step — the dedup itself is what makes it safe to just click.
if($('financeRelayfiSyncBtn')) $('financeRelayfiSyncBtn').addEventListener('click', async () => {
  const msg = $('financeRelayfiSyncMsg');
  const btn = $('financeRelayfiSyncBtn');
  msg.style.display = 'none';
  btn.disabled = true;
  btn.textContent = 'Syncing…';
  try{
    const result = await callGmailApi({ action: 'sync_relayfi_statements' });
    if(!result.ok) throw new Error(result.error || 'Sync failed.');
    if(!result.emailsFound){
      msg.textContent = 'No RelayFi statement email found. Send one from RelayFi (Accounts → Statements → Export → Email statements) to the connected invoices inbox, then sync again.';
      msg.className = 'msg';
    } else {
      const parts = [`Found ${result.emailsFound} statement email${result.emailsFound === 1 ? '' : 's'}`];
      parts.push(`imported ${result.transactionsImported} new transaction${result.transactionsImported === 1 ? '' : 's'}`);
      if(result.transactionsSkipped) parts.push(`${result.transactionsSkipped} already imported`);
      if(result.errors && result.errors.length) parts.push(`${result.errors.length} issue${result.errors.length === 1 ? '' : 's'} — see below`);
      msg.textContent = parts.join(', ') + '.' + (result.errors && result.errors.length ? '\n' + result.errors.join('\n') : '');
      msg.className = (result.errors && result.errors.length && !result.transactionsImported) ? 'msg error' : 'msg';
    }
    msg.style.display = 'block';
    if(result.transactionsImported){
      logActivity('finance.relayfi_statement_sync', null, null, `Synced RelayFi statement email — ${result.transactionsImported} transaction(s) imported`);
      await loadFinanceData();
    }
  }catch(err){
    msg.textContent = err.message || String(err);
    msg.className = 'msg error';
    msg.style.display = 'block';
  }finally{
    btn.disabled = false;
    btn.textContent = 'Sync bank statement email';
  }
});

// ---------- Date range: blank = full history (v217 convention, not the
// old "default to today" pattern — see leadsRangeBounds()'s own comment
// for the full reasoning). Simplified vs. Leads: txn_date is a plain SQL
// date with no time-of-day component, so no timezone-bucketing is needed
// at all, just direct 'YYYY-MM-DD' string comparison. ----------
const FINANCE_DATE_RANGE_STORAGE_KEY = 'ptai_finance_date_range';
function restoreFinanceDateRange(){
  try{
    const saved = JSON.parse(localStorage.getItem(FINANCE_DATE_RANGE_STORAGE_KEY) || 'null');
    if(saved && saved.from) $('financeDateFromFilter').value = saved.from;
    if(saved && saved.to) $('financeDateToFilter').value = saved.to;
  }catch(e){ /* corrupt/inaccessible storage — fall through to blank (full history) */ }
}
function saveFinanceDateRange(){
  try{
    localStorage.setItem(FINANCE_DATE_RANGE_STORAGE_KEY, JSON.stringify({
      from: $('financeDateFromFilter').value, to: $('financeDateToFilter').value,
    }));
  }catch(e){ /* private browsing / storage quota — not worth failing over */ }
}
$('financeDateFromFilter').addEventListener('change', () => { saveFinanceDateRange(); loadFinanceData(); });
$('financeDateToFilter').addEventListener('change', () => { saveFinanceDateRange(); loadFinanceData(); });
$('financeRefreshBtn').addEventListener('click', () => loadFinanceData());
$('financeExcludeTransfersToggle').addEventListener('change', renderFinanceReport);
$('financeExcludeReturnedToggle').addEventListener('change', renderFinanceReport);
$('financeDeductibleOnlyToggle').addEventListener('change', renderFinanceReport);

async function loadFinanceData(){
  if(!$('financeDateFromFilter').value && !$('financeDateToFilter').value) restoreFinanceDateRange();
  if(!financeCategoriesLoaded) await loadFinanceCategoriesAndVendorMap();
  const from = $('financeDateFromFilter').value;
  const to = $('financeDateToFilter').value;
  let query = sb.from('finance_bank_transactions').select('*').order('txn_date', { ascending: false });
  if(from) query = query.gte('txn_date', from);
  if(to) query = query.lte('txn_date', to);
  const { data, error } = await query;
  if(error){ console.error('Failed to load finance transactions:', error); financeTransactions = []; }
  else financeTransactions = data || [];
  renderFinanceReport();
}

function renderFinanceReport(){
  const excludeTransfers = $('financeExcludeTransfersToggle').checked;
  const excludeReturned = $('financeExcludeReturnedToggle').checked;
  const deductibleOnly = $('financeDeductibleOnlyToggle').checked;
  const filtered = financeTransactions.filter(t =>
    (!excludeTransfers || !t.is_internal_transfer) &&
    (!excludeReturned || t.status === 'SETTLED') &&
    (!deductibleOnly || t.is_tax_deductible === true)
  );

  let spend = 0, deposits = 0, deductible = 0;
  const byCategory = {};
  const byMonth = {};
  filtered.forEach(t => {
    const amt = Number(t.amount) || 0;
    if(amt < 0) spend += -amt; else deposits += amt;
    // v395: deductibility only makes sense for spend (an expense being
    // written off), not deposits — matches how the category breakdown
    // above already only totals spend, not deposits, per category.
    if(amt < 0 && t.is_tax_deductible === true) deductible += -amt;
    const catName = financeCategoryLabel(t.category_id);
    const catBucket = (byCategory[catName] ||= { spend: 0, deposits: 0 });
    if(amt < 0) catBucket.spend += -amt; else catBucket.deposits += amt;
    const monthKey = (t.txn_date || '').slice(0, 7);
    const monthBucket = (byMonth[monthKey] ||= { spend: 0, deposits: 0 });
    if(amt < 0) monthBucket.spend += -amt; else monthBucket.deposits += amt;
  });

  $('financeStatSpend').textContent = `$${spend.toFixed(2)}`;
  $('financeStatDeposits').textContent = `$${deposits.toFixed(2)}`;
  $('financeStatNet').textContent = `$${(deposits - spend).toFixed(2)}`;
  $('financeStatDeductible').textContent = `$${deductible.toFixed(2)}`;
  $('financeStatCount').textContent = filtered.length;

  const catRows = Object.entries(byCategory).filter(([, v]) => v.spend > 0).sort((a, b) => b[1].spend - a[1].spend);
  $('financeCategoryBody').innerHTML = catRows.length
    ? catRows.map(([name, v]) => `<tr><td>${escapeHtml(name)}</td><td class="mono">$${v.spend.toFixed(2)}</td><td class="mono">${spend > 0 ? ((v.spend / spend) * 100).toFixed(1) : '0.0'}%</td></tr>`).join('')
    : `<tr><td colspan="3" class="empty">No spend in this range.</td></tr>`;

  const monthRows = Object.entries(byMonth).sort((a, b) => a[0].localeCompare(b[0]));
  $('financeMonthlyBody').innerHTML = monthRows.length
    ? monthRows.map(([month, v]) => `<tr><td class="mono">${escapeHtml(month)}</td><td class="mono" style="color:var(--danger);">$${v.spend.toFixed(2)}</td><td class="mono" style="color:var(--good);">$${v.deposits.toFixed(2)}</td><td class="mono">$${(v.deposits - v.spend).toFixed(2)}</td></tr>`).join('')
    : `<tr><td colspan="4" class="empty">No transactions in this range.</td></tr>`;

  const catOptionsHtml = '<option value="">Uncategorized</option>' + financeCategories.map(c => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join('');
  $('financeTxnBody').innerHTML = filtered.length ? filtered.map(t => `
    <tr data-id="${t.id}">
      <td class="mono">${escapeHtml(t.txn_date)}</td>
      <td class="mono">${escapeHtml(t.account_number)}</td>
      <td>${escapeHtml(t.payee || '—')}</td>
      <td style="max-width:200px;" title="${escapeHtml(t.description || '')}">${escapeHtml((t.description || '').slice(0, 40))}</td>
      <td class="mono" style="color:${Number(t.amount) < 0 ? 'var(--danger)' : 'var(--good)'};">${Number(t.amount) < 0 ? '-' : '+'}$${Math.abs(Number(t.amount)).toFixed(2)}</td>
      <td><select class="finance-txn-category-select" data-id="${t.id}">${catOptionsHtml}</select></td>
      <td style="text-align:center;"><input type="checkbox" class="finance-txn-transfer-toggle" data-id="${t.id}" ${t.is_internal_transfer ? 'checked' : ''}></td>
      <td>
        <select class="finance-txn-deductible-select" data-id="${t.id}">
          <option value="">?</option>
          <option value="true" ${t.is_tax_deductible === true ? 'selected' : ''}>Yes</option>
          <option value="false" ${t.is_tax_deductible === false ? 'selected' : ''}>No</option>
        </select>
      </td>
    </tr>
  `).join('') : `<tr><td colspan="8" class="empty">No transactions in this range.</td></tr>`;
  filtered.forEach(t => {
    const sel = document.querySelector(`.finance-txn-category-select[data-id="${t.id}"]`);
    if(sel) sel.value = t.category_id || '';
  });

  // "Remember this category for <payee>" — this is what makes month 2+
  // imports need near-zero manual categorization, since the same handful
  // of vendors recur almost every month in practice.
  document.querySelectorAll('.finance-txn-category-select').forEach(sel => {
    sel.addEventListener('change', async () => {
      const id = sel.dataset.id;
      const categoryId = sel.value || null;
      const txn = financeTransactions.find(t => t.id === id);
      const remember = categoryId && txn && txn.payee && confirm(`Remember "${txn.payee}" as ${financeCategoryLabel(categoryId)} for future imports?`);
      const { error } = await sb.from('finance_bank_transactions').update({ category_id: categoryId, updated_at: new Date().toISOString() }).eq('id', id);
      if(error){ alert(error.message); return; }
      if(txn) txn.category_id = categoryId;
      // v395: these per-transaction edits directly shape what counts as
      // deductible spend for tax filing, but unlike every other Finance/
      // Taxes action, none of the 3 handlers here (category, transfer,
      // deductible) logged anything — a mistaken or malicious
      // recategorization was untraceable.
      logActivity('finance.txn_recategorize', 'finance_bank_transaction', id, `Set category to "${financeCategoryLabel(categoryId)}" for ${txn ? (txn.payee || txn.txn_date) : id}`);
      if(remember){
        const { data: { user } } = await sb.auth.getUser();
        await sb.from('finance_vendor_category_map').upsert({
          pattern: financeNormalizeVendor(txn.payee), match_type: 'exact', category_id: categoryId, created_by: user ? user.id : null,
        }, { onConflict: 'pattern,match_type' });
        await loadFinanceCategoriesAndVendorMap();
      }
      renderFinanceReport();
    });
  });
  document.querySelectorAll('.finance-txn-transfer-toggle').forEach(cb => {
    cb.addEventListener('change', async () => {
      const id = cb.dataset.id;
      const { error } = await sb.from('finance_bank_transactions').update({ is_internal_transfer: cb.checked, updated_at: new Date().toISOString() }).eq('id', id);
      if(error){ alert(error.message); cb.checked = !cb.checked; return; }
      const txn = financeTransactions.find(t => t.id === id);
      if(txn) txn.is_internal_transfer = cb.checked;
      logActivity('finance.txn_recategorize', 'finance_bank_transaction', id, `${cb.checked ? 'Marked' : 'Unmarked'} ${txn ? (txn.payee || txn.txn_date) : id} as an internal transfer`);
      renderFinanceReport();
    });
  });
  document.querySelectorAll('.finance-txn-deductible-select').forEach(sel => {
    sel.addEventListener('change', async () => {
      const id = sel.dataset.id;
      const val = sel.value === '' ? null : sel.value === 'true';
      const { error } = await sb.from('finance_bank_transactions').update({ is_tax_deductible: val, updated_at: new Date().toISOString() }).eq('id', id);
      if(error){ alert(error.message); return; }
      const txn = financeTransactions.find(t => t.id === id);
      if(txn) txn.is_tax_deductible = val;
      // v395: previously neither logged nor re-rendered — Total
      // Deductible (and "Deductible only") would show stale until the
      // next unrelated re-render.
      logActivity('finance.txn_deductible_set', 'finance_bank_transaction', id, `Set tax-deductible to "${val === null ? '?' : (val ? 'Yes' : 'No')}" for ${txn ? (txn.payee || txn.txn_date) : id}`);
      renderFinanceReport();
    });
  });
}

$('financeExportCsvBtn').addEventListener('click', () => {
  const excludeTransfers = $('financeExcludeTransfersToggle').checked;
  const excludeReturned = $('financeExcludeReturnedToggle').checked;
  const filtered = financeTransactions.filter(t => (!excludeTransfers || !t.is_internal_transfer) && (!excludeReturned || t.status === 'SETTLED'));
  const headers = ['Date', 'Account', 'Payee', 'Description', 'Amount', 'Category', 'Transfer', 'Status', 'Tax Deductible'];
  const rows = filtered.map(t => [t.txn_date, t.account_number, t.payee || '', t.description || '', Number(t.amount).toFixed(2), financeCategoryLabel(t.category_id), t.is_internal_transfer ? 'Yes' : 'No', t.status, t.is_tax_deductible === true ? 'Yes' : (t.is_tax_deductible === false ? 'No' : '')]);
  exportCSV(`finance-transactions-${todayDateInputValue()}.csv`, headers, rows);
  logActivity('finance.export_csv', null, null, `Exported ${rows.length} finance transaction(s) to CSV`);
});
$('financeExportPdfBtn').addEventListener('click', () => {
  const excludeTransfers = $('financeExcludeTransfersToggle').checked;
  const excludeReturned = $('financeExcludeReturnedToggle').checked;
  const filtered = financeTransactions.filter(t => (!excludeTransfers || !t.is_internal_transfer) && (!excludeReturned || t.status === 'SETTLED'));
  const headers = ['Date', 'Account', 'Payee', 'Description', 'Amount', 'Category'];
  const rows = filtered.map(t => [t.txn_date, t.account_number, t.payee || '', (t.description || '').slice(0, 40), Number(t.amount).toFixed(2), financeCategoryLabel(t.category_id)]);
  exportPDF('Finance — Transactions', headers, rows);
});

// ---------- Invoice Archive ----------
let financeInvoices = [];
async function loadFinanceInvoices(){
  if(!financeCategoriesLoaded) await loadFinanceCategoriesAndVendorMap();
  const search = ($('financeInvoiceSearchFilter').value || '').trim().toLowerCase();
  const from = $('financeInvoiceDateFromFilter').value;
  const to = $('financeInvoiceDateToFilter').value;
  // IMPROVEMENT (user request, 2026-09): embeds the matched transaction's
  // own payee/date/amount via the FK, so a linked invoice shows WHAT it's
  // linked to (and staff can visually sanity-check it's actually the right
  // one) instead of just a bare checkmark that gives no way to verify or
  // catch a wrong match.
  let query = sb.from('finance_invoices').select('*, matched_transaction:finance_bank_transactions(id, payee, txn_date, amount)').order('invoice_date', { ascending: false });
  if(from) query = query.gte('invoice_date', from);
  if(to) query = query.lte('invoice_date', to);
  const { data, error } = await query;
  if(error){ console.error('Failed to load finance invoices:', error); financeInvoices = []; }
  else financeInvoices = (data || []).filter(inv => !search || (inv.vendor || '').toLowerCase().includes(search));
  renderFinanceInvoices();
}
$('financeInvoiceRefreshBtn').addEventListener('click', () => loadFinanceInvoices());
$('financeInvoiceSearchFilter').addEventListener('input', debounce(() => loadFinanceInvoices(), 250));
$('financeInvoiceDateFromFilter').addEventListener('change', () => loadFinanceInvoices());
$('financeInvoiceDateToFilter').addEventListener('change', () => loadFinanceInvoices());

// Best-effort document-type label from the filename convention every
// known vendor here actually uses ("Invoice-...", "Receipt-...",
// "CreditNote-...-CN-01.pdf", "Refund-...pdf", plus HighLevel's synthetic
// "Receipt - Your HighLevel Inc. receipt ....txt"). Falls back to null
// (caller shows the raw filename instead) for anything that doesn't match
// one of these — never invents a label it isn't confident about.
function financeInvoiceDocTypeLabel(filename){
  const f = String(filename || '').trim();
  if(/^credit[\s-]?note/i.test(f)) return 'Credit Note';
  if(/^refund/i.test(f)) return 'Refund';
  if(/^invoice/i.test(f)) return 'Invoice';
  if(/^receipt/i.test(f)) return 'Receipt';
  return null;
}

// GAP FIX (user request, 2026-09): a real charge from Anthropic/HighLevel/
// Supabase/smrtStudio routinely shows up here as TWO+ separate archived
// documents (an "Invoice" email and a separate "Receipt" email, sometimes
// also a credit note/refund) -- see the 2026-09 audit that found 55 of 95
// archived invoices in exactly this shape. Each is a genuinely different
// Gmail message, so email_message_id-based dedup correctly keeps both, but
// showing them as two unrelated cards made it look like two separate
// purchases needing two separate "Link transaction" passes (only one can
// ever actually link -- see finance_invoices_matched_transaction_id_key).
// Groups by vendor+amount+invoice_date (same key the earlier duplicate
// audit used) so they render as ONE card with one download button per
// document type instead. Rows with no amount/date can't be grouped at all
// (nothing reliable to group ON) and are always their own solo group.
function groupFinanceInvoicesForDisplay(invoices){
  const groupsByKey = new Map();
  const order = [];
  invoices.forEach(inv => {
    const key = (inv.amount != null && inv.invoice_date) ? `${inv.vendor || ''}|${Number(inv.amount).toFixed(2)}|${inv.invoice_date}` : `__solo_${inv.id}`;
    if(!groupsByKey.has(key)){ groupsByKey.set(key, []); order.push(key); }
    groupsByKey.get(key).push(inv);
  });
  return order.map(key => {
    const docs = groupsByKey.get(key);
    // Prefer the "Invoice" document as the representative row for shared
    // fields (category/notes) and as the default target for a NEW link --
    // it's the one with the most complete billing detail of the bunch.
    const primary = docs.find(d => financeInvoiceDocTypeLabel(d.original_filename) === 'Invoice') || docs[0];
    // If ANY document in the group already carries the link (from before
    // this grouping existed, or a future direct-SQL edit), that's the one
    // Unlink/Change-link has to act on -- not necessarily `primary`.
    const linked = docs.find(d => d.matched_transaction_id) || null;
    return {
      key, docs, primary,
      actionDoc: linked || primary,
      matchedTransaction: linked ? linked.matched_transaction : null,
      matchedTransactionId: linked ? linked.matched_transaction_id : null,
      categoryId: (docs.find(d => d.category_id) || {}).category_id || null,
    };
  });
}

function renderFinanceInvoices(){
  const grid = $('financeInvoiceGrid');
  const empty = $('financeInvoiceEmpty');
  // IMPROVEMENT (user request, 2026-09): surfaces the reconciliation
  // backlog at a glance instead of leaving staff to click into every card
  // to find out which ones still need a "Link transaction" pass — this is
  // exactly the number that was silently stuck at 0/95 before the reconcile
  // modal bug above was fixed.
  const groups = groupFinanceInvoicesForDisplay(financeInvoices);
  const linkSummaryEl = $('financeInvoiceLinkSummary');
  if(linkSummaryEl){
    const linkedGroups = groups.filter(g => g.matchedTransactionId).length;
    linkSummaryEl.textContent = financeInvoices.length ? `${linkedGroups} of ${groups.length} linked to a bank transaction` : '';
  }
  if(!financeInvoices.length){ grid.innerHTML = ''; empty.style.display = 'block'; return; }
  empty.style.display = 'none';
  grid.innerHTML = groups.map(g => {
    const inv = g.primary;
    const docsHtml = g.docs.map(d => {
      const label = financeInvoiceDocTypeLabel(d.original_filename) || d.original_filename;
      return `
        <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; font-size:11px; padding:3px 0;">
          <span style="color:var(--text-2); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${escapeHtml(d.original_filename)}">${escapeHtml(label)}</span>
          <span style="display:flex; gap:4px; flex-shrink:0;">
            <button class="btn-secondary finance-invoice-download-btn" data-doc-id="${d.id}" style="width:auto; padding:3px 8px; font-size:10px;">Download</button>
            <button class="finance-invoice-delete-btn" data-doc-id="${d.id}" style="background:transparent; border:none; color:var(--danger); cursor:pointer; font-size:10px; padding:3px 4px;">Delete</button>
          </span>
        </div>`;
    }).join('');
    return `
    <div class="card" style="padding:14px;" data-group-key="${escapeHtml(g.key)}">
      <div style="font-weight:700; font-size:13px; margin-bottom:4px;">${escapeHtml(inv.vendor || 'Unknown vendor')}</div>
      <div style="font-size:11px; color:var(--text-dim); margin-bottom:8px;">${inv.invoice_date ? escapeHtml(inv.invoice_date) : '—'}${inv.amount != null ? ` · $${Number(inv.amount).toFixed(2)}` : ''}</div>
      <div style="font-size:11px; color:var(--text-2); margin-bottom:4px;">${escapeHtml(financeCategoryLabel(g.categoryId))}</div>
      ${g.matchedTransaction ? `<div style="font-size:10px; color:var(--good); margin-bottom:4px;" title="Matched by amount (±2¢) and date (±10 days) — verify this is really the same purchase.">&#10003; Linked to ${escapeHtml(g.matchedTransaction.payee || 'a bank transaction')} — ${escapeHtml(g.matchedTransaction.txn_date)} · $${Math.abs(Number(g.matchedTransaction.amount)).toFixed(2)}</div>` : (g.matchedTransactionId ? '<div style="font-size:10px; color:var(--danger); margin-bottom:4px;">&#9888; Linked to a bank transaction that no longer exists</div>' : '')}
      ${inv.notes ? `<div style="font-size:11px; color:var(--text-2); margin-bottom:4px;">${escapeHtml(inv.notes)}</div>` : ''}
      <div style="border-top:1px solid var(--border); margin-top:8px; padding-top:6px;">${docsHtml}</div>
      <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;">
        <button class="btn-secondary finance-invoice-reconcile-btn" data-action-id="${g.actionDoc.id}" style="width:auto; padding:5px 10px; font-size:11px;">${g.matchedTransactionId ? 'Change link' : 'Link transaction'}</button>
        ${g.matchedTransactionId ? `<button class="btn-secondary finance-invoice-unlink-btn" data-action-id="${g.actionDoc.id}" style="width:auto; padding:5px 10px; font-size:11px;">Unlink</button>` : ''}
      </div>
    </div>
  `;
  }).join('');
  grid.querySelectorAll('.finance-invoice-download-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.docId;
      const inv = financeInvoices.find(i => i.id === id);
      if(!inv) return;
      // Private bucket — always a signed URL, never getPublicUrl().
      const { data, error } = await sb.storage.from('finance-invoices').createSignedUrl(inv.storage_path, 3600);
      if(error){ alert(error.message); return; }
      downloadFileToDisk(data.signedUrl, inv.original_filename);
    });
  });
  grid.querySelectorAll('.finance-invoice-delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.docId;
      const inv = financeInvoices.find(i => i.id === id);
      if(!inv || !confirm(`Delete this archived document (${inv.vendor || inv.original_filename})? This can't be undone.`)) return;
      await sb.storage.from('finance-invoices').remove([inv.storage_path]);
      const { error } = await sb.from('finance_invoices').delete().eq('id', id);
      if(error){ alert(error.message); return; }
      logActivity('finance.invoice_delete', 'finance_invoice', id, `Deleted archived invoice — ${inv.vendor || inv.original_filename}`);
      await loadFinanceInvoices();
    });
  });
  grid.querySelectorAll('.finance-invoice-reconcile-btn').forEach(btn => {
    btn.addEventListener('click', () => openFinanceReconcileModal(btn.dataset.actionId));
  });
  // GAP FIX (user request, 2026-09): there was no way to undo a wrong match
  // short of picking a different transaction via "Link transaction" (which
  // only ever REPLACES the link, never clears it) — a genuine mis-click had
  // no path back to unmatched.
  grid.querySelectorAll('.finance-invoice-unlink-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.actionId;
      const inv = financeInvoices.find(i => i.id === id);
      if(!inv || !confirm(`Unlink this invoice (${inv.vendor || inv.original_filename}) from its matched bank transaction?`)) return;
      const { error } = await sb.from('finance_invoices').update({ matched_transaction_id: null, updated_at: new Date().toISOString() }).eq('id', id);
      if(error){ alert(error.message); return; }
      logActivity('finance.invoice_unlink', 'finance_invoice', id, `Unlinked invoice (${inv.vendor || inv.original_filename}) from its matched bank transaction`);
      await loadFinanceInvoices();
    });
  });
}

// Chunked to avoid a call-stack blowup from String.fromCharCode(...bytes)
// on a large file (a multi-MB PDF would otherwise exceed the argument
// limit in one call).
async function fileToBase64(file){
  const bytes = new Uint8Array(await file.arrayBuffer());
  let binary = '';
  const CHUNK = 0x8000;
  for(let i = 0; i < bytes.length; i += CHUNK) binary += String.fromCharCode.apply(null, bytes.subarray(i, i + CHUNK));
  return btoa(binary);
}
$('financeInvoiceUploadBtn').addEventListener('click', async () => {
  const msg = $('financeInvoiceMsg');
  msg.style.display = 'none';
  const fileInput = $('financeInvoiceFileInput');
  const file = fileInput.files && fileInput.files[0];
  if(!file){ msg.textContent = 'Choose a file first.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }
  const btn = $('financeInvoiceUploadBtn');
  btn.disabled = true;
  btn.textContent = 'Archiving…';
  try{
    // BUG FIX (found during 2026-09 Taxes-tab audit): this used to insert
    // finance_invoices directly from the client — no content-hash dedup, no
    // RelayFi forward, unlike every Gmail-synced invoice. The dedup/forward
    // logic already existed server-side (handleManualImportInvoice, v521)
    // but had no reachable path for a real dashboard user to call it — see
    // that function's header comment in gmail-api/index.ts. Routes through
    // it now so a manually archived invoice gets the same duplicate-file
    // protection and RelayFi forwarding a Gmail-synced one already gets.
    const contentBase64 = await fileToBase64(file);
    const result = await callGmailApi({
      action: 'manual_import_invoice',
      filename: file.name,
      contentBase64,
      vendor: $('financeInvoiceVendor').value.trim() || null,
      amount: $('financeInvoiceAmount').value ? parseFloat($('financeInvoiceAmount').value) : null,
      currency: 'USD',
      invoiceDate: $('financeInvoiceDate').value || null,
      categoryId: $('financeInvoiceCategory').value || null,
      notes: $('financeInvoiceNotes').value.trim() || null,
    });
    if(!result.ok) throw new Error(result.error || 'Failed to archive the invoice.');
    logActivity('finance.invoice_upload', 'finance_invoice', result.id, `Archived invoice — ${$('financeInvoiceVendor').value.trim() || file.name}`);
    ['financeInvoiceVendor', 'financeInvoiceAmount', 'financeInvoiceDate', 'financeInvoiceNotes'].forEach(id => { $(id).value = ''; });
    $('financeInvoiceCategory').value = '';
    fileInput.value = '';
    msg.textContent = result.duplicate
      ? 'This exact file is already archived — nothing new was added.'
      : `Invoice archived.${result.relayfiForwarded ? ' Forwarded to RelayFi.' : ''}`;
    msg.className = 'msg';
    msg.style.display = 'block';
    await loadFinanceInvoices();
  }catch(err){
    msg.textContent = err.message || String(err);
    msg.className = 'msg error';
    msg.style.display = 'block';
  }finally{
    btn.disabled = false;
    btn.textContent = 'Archive invoice';
  }
});

// v514: Gmail invoice import -- connect/sync/disconnect for the 'invoices'
// purpose Gmail connection(s) -- v519: MULTIPLE now allowed (a separate
// account from the Integrations -> Gmail one; see gmail-api's
// resolveGmailConnection/listGmailConnections purpose param). list_connections
// returns BOTH purposes' rows -- filtered to 'invoices' here since the
// general one is managed from Integrations.
let taxesGmailInvoiceConnections = [];
async function loadTaxesGmailInvoiceConnection(){
  const statusEl = $('taxesGmailInvoiceStatus');
  const connectBtn = $('taxesGmailInvoiceConnectBtn');
  const syncBtn = $('taxesGmailInvoiceSyncBtn');
  statusEl.textContent = 'Loading…';
  const result = await callGmailApi({ action: 'list_connections' });
  if(!result.ok){
    // Non-Owner/Admin gets a 403 here (list_connections is Owner/Admin-only
    // server-side) -- that's expected for them since the buttons are
    // hidden anyway (owner-admin-export-only), so just show a quiet status
    // line rather than an alarming error.
    statusEl.textContent = 'Only Owner/Admin can view or manage this connection.';
    connectBtn.style.display = 'none';
    syncBtn.style.display = 'none';
    return;
  }
  taxesGmailInvoiceConnections = (result.connections || []).filter(c => c.purpose === 'invoices');
  // Connect stays visible even when already connected -- "add another
  // inbox" is the whole point of allowing multiple.
  connectBtn.style.display = '';
  if(taxesGmailInvoiceConnections.length){
    statusEl.innerHTML = 'Connected: ' + taxesGmailInvoiceConnections.map(c => `<b>${escapeHtml(c.email_address)}</b> <button class="taxes-gmail-invoice-disconnect-btn" data-email="${escapeHtml(c.email_address)}" style="background:transparent; border:none; color:var(--danger); cursor:pointer; font-size:11px; text-decoration:underline; padding:0;">disconnect</button>`).join(' &nbsp;·&nbsp; ');
    syncBtn.style.display = '';
    statusEl.querySelectorAll('.taxes-gmail-invoice-disconnect-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const email = btn.dataset.email;
        if(!confirm(`Disconnect ${email}? Its invoices will stop syncing until it's reconnected.`)) return;
        const r = await callGmailApi({ action: 'disconnect', emailAddress: email });
        if(!r.ok){ alert(r.error || 'Failed to disconnect.'); return; }
        logActivity('finance.gmail_invoice_disconnect', null, null, `Disconnected Gmail invoice inbox ${email}`);
        await loadTaxesGmailInvoiceConnection();
      });
    });
  } else {
    statusEl.textContent = 'Not connected yet.';
    syncBtn.style.display = 'none';
  }
}
if($('taxesGmailInvoiceConnectBtn')) $('taxesGmailInvoiceConnectBtn').addEventListener('click', async () => {
  const msg = $('taxesGmailInvoiceMsg');
  const btn = $('taxesGmailInvoiceConnectBtn');
  msg.style.display = 'none';
  btn.disabled = true;
  const originalLabel = btn.textContent;
  btn.textContent = 'Starting…';
  const result = await callGmailApi({ action: 'create_oauth_state', purpose: 'invoices' });
  btn.disabled = false;
  btn.textContent = originalLabel;
  if(!result.ok){
    msg.textContent = result.error || 'Failed to start the connect flow.';
    msg.className = 'msg error';
    msg.style.display = 'block';
    return;
  }
  window.open(gmailConnectUrl(result.state, GMAIL_INVOICE_SCOPES), '_blank', 'noopener');
  msg.textContent = 'Finish signing in with the invoice inbox account in the tab that just opened (pick a different account there if you\'re adding another one), then click Refresh here (or reopen Invoice Archive) once it says Connected.';
  msg.className = 'msg';
  msg.style.display = 'block';
});
if($('taxesGmailInvoiceSyncBtn')) $('taxesGmailInvoiceSyncBtn').addEventListener('click', async () => {
  const msg = $('taxesGmailInvoiceMsg');
  const btn = $('taxesGmailInvoiceSyncBtn');
  msg.style.display = 'none';
  btn.disabled = true;
  let totalImported = 0, totalSkipped = 0, totalScanned = 0, totalForwarded = 0, totalForwardFailed = 0, pageToken = null, pages = 0;
  const allErrors = [];
  const MAX_PAGES = 8; // one click covers up to ~400 messages; click again for a deeper backfill
  try{
    do {
      btn.textContent = pages === 0 ? 'Syncing…' : `Syncing… (${totalImported} found so far)`;
      const result = await callGmailApi({ action: 'sync_invoice_emails', pageToken: pageToken || undefined });
      if(!result.ok) throw new Error(result.error || 'Sync failed.');
      totalImported += result.imported || 0;
      totalSkipped += result.skipped || 0;
      totalScanned += result.scanned || 0;
      totalForwarded += result.relayfiForwarded || 0;
      totalForwardFailed += result.relayfiForwardFailed || 0;
      if(result.errors && result.errors.length) allErrors.push(...result.errors);
      pageToken = result.nextPageToken;
      pages++;
    } while(pageToken && pages < MAX_PAGES);
    const summary = totalImported
      ? `Archived ${totalImported} new invoice${totalImported === 1 ? '' : 's'} (scanned ${totalScanned} email${totalScanned === 1 ? '' : 's'}, skipped ${totalSkipped} already-imported/unreadable attachment${totalSkipped === 1 ? '' : 's'}) — forwarded ${totalForwarded} to RelayFi${totalForwardFailed ? ` (${totalForwardFailed} forward${totalForwardFailed === 1 ? '' : 's'} failed, still archived here though)` : ''}${pageToken ? '. More may be available, click Sync now again to continue.' : '.'}`
      : `No new invoices found (scanned ${totalScanned} email${totalScanned === 1 ? '' : 's'}).`;
    // Per-inbox errors (e.g. one connected account's token expired) don't
    // stop the other connected inboxes from syncing -- surfaced here, not
    // thrown, so a problem with one account never hides success on another.
    msg.textContent = summary + (allErrors.length ? `\n${allErrors.join('\n')}` : '');
    msg.className = 'msg';
    msg.style.display = 'block';
    logActivity('finance.gmail_invoice_sync', null, null, `Synced Gmail invoices — ${totalImported} archived, ${totalScanned} scanned`);
    await loadFinanceInvoices();
  }catch(err){
    msg.textContent = err.message || String(err);
    msg.className = 'msg error';
    msg.style.display = 'block';
  }finally{
    btn.disabled = false;
    btn.textContent = 'Sync now';
  }
});

// v518/v517: shared loop shape for both one-off maintenance backfills
// below -- each server action processes one batch and reports how many
// are still `remaining`, so the button just keeps calling until that
// hits 0 (or a safety cap, in case something's badly wrong and it would
// otherwise loop indefinitely against a huge/broken backlog).
async function runTaxesInvoiceBackfill(opts){
  const msg = $('taxesInvoiceBackfillMsg');
  const btn = $(opts.btnId);
  msg.style.display = 'none';
  btn.disabled = true;
  const originalLabel = btn.textContent;
  const totals = {};
  opts.totalFields.forEach(f => { totals[f] = 0; });
  let remaining = null, calls = 0;
  const MAX_CALLS = 20;
  try{
    do {
      btn.textContent = calls === 0 ? 'Working…' : `Working… (${totals[opts.totalFields[0]]} so far)`;
      const result = await callGmailApi({ action: opts.action });
      if(!result.ok) throw new Error(result.error || 'Failed.');
      opts.totalFields.forEach(f => { totals[f] += result[f] || 0; });
      remaining = result.remaining ?? 0;
      calls++;
    } while(remaining > 0 && calls < MAX_CALLS);
    msg.textContent = opts.formatMsg(totals, remaining);
    msg.className = 'msg';
    msg.style.display = 'block';
    if(totals[opts.totalFields[0]]) await loadFinanceInvoices();
  }catch(err){
    msg.textContent = err.message || String(err);
    msg.className = 'msg error';
    msg.style.display = 'block';
  }finally{
    btn.disabled = false;
    btn.textContent = originalLabel;
  }
}
if($('taxesExtractAmountsBtn')) $('taxesExtractAmountsBtn').addEventListener('click', () => runTaxesInvoiceBackfill({
  action: 'backfill_extract_amounts',
  btnId: 'taxesExtractAmountsBtn',
  totalFields: ['updated', 'notFound', 'failed'],
  formatMsg: (t, remaining) => `Extracted an amount for ${t.updated} invoice${t.updated === 1 ? '' : 's'}${t.notFound ? `, ${t.notFound} had no detectable total` : ''}${t.failed ? `, ${t.failed} failed to read` : ''}.${remaining ? ` ${remaining} more to go — click again to continue.` : ''}`,
}));
if($('taxesBackfillRelayfiBtn')) $('taxesBackfillRelayfiBtn').addEventListener('click', () => runTaxesInvoiceBackfill({
  action: 'backfill_relayfi_forward',
  btnId: 'taxesBackfillRelayfiBtn',
  totalFields: ['forwarded', 'failed'],
  formatMsg: (t, remaining) => `Forwarded ${t.forwarded} invoice${t.forwarded === 1 ? '' : 's'} to RelayFi${t.failed ? `, ${t.failed} failed` : ''}.${remaining ? ` ${remaining} more to go — click again to continue.` : ''}`,
}));

// v219: link an archived invoice to a matching bank transaction, for tax
// reconciliation — a plain filtered candidate list (amount within 2
// cents, date within 10 days of the invoice), not fuzzy matching.
//
// BUG FIX (user request, 2026-09 — "ensure invoices/receipts are valid and
// linked to the transaction"): this used to filter financeTransactions,
// the Spending subtab's own cached array — populated ONLY by visiting
// Spending first, and even then scoped to whatever date range Spending
// last had loaded (restored from localStorage — see
// restoreFinanceDateRange()). Opening Invoice Archive directly (the
// obvious way to reconcile invoices) left financeTransactions empty, so
// this modal always reported "no candidates" regardless of what actually
// existed. Confirmed live: 0 of 95 archived invoices had EVER been linked,
// despite 80 of them having a real matching bank transaction available
// right now by this exact criteria. Now queries finance_bank_transactions
// directly, scoped to this invoice's own ±10-day window, so the result no
// longer depends on any other subtab having been visited first.
let financeReconcileInvoiceId = null;
async function openFinanceReconcileModal(invoiceId){
  financeReconcileInvoiceId = invoiceId;
  const inv = financeInvoices.find(i => i.id === invoiceId);
  const listEl = $('financeReconcileList');
  $('financeReconcileModalMsg').style.display = 'none';
  $('financeReconcileModalOverlay').classList.add('active');
  if(!inv || inv.amount == null || !inv.invoice_date){
    listEl.innerHTML = '<div style="font-size:12px; color:var(--text-dim); padding:10px 0;">This invoice needs an amount and date before it can be matched.</div>';
    return;
  }
  listEl.innerHTML = '<div style="font-size:12px; color:var(--text-dim); padding:10px 0;">Searching…</div>';
  const invDateMs = new Date(inv.invoice_date).getTime();
  const rangeStart = new Date(invDateMs - 10 * 86400000).toISOString().slice(0, 10);
  const rangeEnd = new Date(invDateMs + 10 * 86400000).toISOString().slice(0, 10);
  const { data: windowTxns, error } = await sb.from('finance_bank_transactions')
    .select('id, payee, txn_date, amount, is_internal_transfer')
    .gte('txn_date', rangeStart).lte('txn_date', rangeEnd);
  if(error){
    listEl.innerHTML = `<div style="font-size:12px; color:var(--danger); padding:10px 0;">Failed to search for matches: ${escapeHtml(error.message)}</div>`;
    return;
  }
  // A transaction can only ever be linked from ONE invoice (enforced by
  // finance_invoices_matched_transaction_id_key, a unique partial index) --
  // exclude transactions already claimed by a DIFFERENT invoice so staff
  // never even see them as a candidate, rather than letting them pick one
  // and hit a DB error.
  const takenTransactionIds = new Set(
    financeInvoices.filter(i => i.id !== invoiceId && i.matched_transaction_id).map(i => i.matched_transaction_id)
  );
  const matches = (windowTxns || []).filter(t => {
    if(t.is_internal_transfer) return false;
    if(takenTransactionIds.has(t.id)) return false;
    const amtDiff = Math.abs(Math.abs(Number(t.amount)) - Math.abs(Number(inv.amount)));
    return amtDiff <= 0.02;
  });
  listEl.innerHTML = matches.length
    ? matches.map(t => `
      <div class="finance-reconcile-row" data-id="${t.id}" style="display:flex; justify-content:space-between; align-items:center; padding:8px 4px; border-bottom:1px solid var(--border); cursor:pointer;">
        <div>
          <div style="font-size:12px;">${escapeHtml(t.payee || '—')}</div>
          <div style="font-size:10px; color:var(--text-dim);">${escapeHtml(t.txn_date)}</div>
        </div>
        <div class="mono" style="font-size:12px;">$${Math.abs(Number(t.amount)).toFixed(2)}</div>
      </div>
    `).join('')
    : '<div style="font-size:12px; color:var(--text-dim); padding:10px 0;">No bank transaction within 10 days and 2 cents of this invoice\'s amount was found. It may not have posted/synced yet — try again once it has.</div>';
  listEl.querySelectorAll('.finance-reconcile-row').forEach(row => {
    row.addEventListener('click', async () => {
      const { error: linkErr } = await sb.from('finance_invoices').update({ matched_transaction_id: row.dataset.id, updated_at: new Date().toISOString() }).eq('id', financeReconcileInvoiceId);
      if(linkErr){ $('financeReconcileModalMsg').textContent = linkErr.message; $('financeReconcileModalMsg').style.display = 'block'; return; }
      const linkedInv = financeInvoices.find(i => i.id === financeReconcileInvoiceId);
      logActivity('finance.invoice_reconcile', 'finance_invoice', financeReconcileInvoiceId, `Linked invoice (${linkedInv ? (linkedInv.vendor || linkedInv.original_filename) : financeReconcileInvoiceId}) to a bank transaction`);
      closeFinanceReconcileModal();
      await loadFinanceInvoices();
    });
  });
}
function closeFinanceReconcileModal(){
  $('financeReconcileModalOverlay').classList.remove('active');
  financeReconcileInvoiceId = null;
}
$('financeReconcileCancelBtn').addEventListener('click', closeFinanceReconcileModal);
$('financeReconcileModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'financeReconcileModalOverlay') closeFinanceReconcileModal(); });

// ---------- v220: Billing AK — weekly import of the agency_transactions
// payments export. Product is free text ("1 Caller + 1 Dialer + 10k Data",
// "3 callers + 3 dialers", "20k records", etc.), classified client-side into
// caller/dialer/data unit counts + revenue.
//
// v227: switched from "trust whatever number the product text happens to
// spell out" to standardized rates, after the team's own wording drift kept
// causing misclassification (e.g. "part time caller + dialer + data" has no
// number anywhere near "data", so it was landing at 0 data/0 profit for that
// category every time). The rates themselves are still anchored to the
// product text (cadence word, dialer/acquisition counts, an EXPLICIT record
// count when one is actually spelled out) — only the *data* quantity now
// falls back to a standard bundled allotment when the text doesn't name one,
// instead of falling back to zero:
//   - Dialer: $200/unit, a MONTHLY rate — simple quartering for shorter
//     cadences (biweekly = $100, weekly = $50), not the previous
//     52-week/26-period annualized proration.
//   - Data: $0.05/record. If the text spells out an explicit quantity
//     ("10k data", "20k records", "25 leads", ...), that's used as-is — it's
//     what was actually delivered in that transaction, not prorated further.
//     Otherwise, every caller unit comes with a standard bundled monthly
//     allotment (10,000 records/month full-time, 7,500/month part-time),
//     prorated by the same cadence divisor as the dialer rate.
//   - Caller/Acquisition: still split whatever's left, proportional to unit
//     count (unchanged).
const BILLING_AK_DATA_RATE = 0.05;   // $ per record
const BILLING_AK_DIALER_RATE_BY_CADENCE = { monthly: 200, biweekly: 100, weekly: 50 };
const BILLING_AK_CADENCE_DIVISOR = { monthly: 1, biweekly: 2, weekly: 4 };
const BILLING_AK_FULL_TIME_CALLER_MONTHLY_RECORDS = 10000;
const BILLING_AK_PART_TIME_CALLER_MONTHLY_RECORDS = 7500;
// "weekly"/"bi-weekly"/"biweekly" mentioned anywhere in the product text;
// anything else (including "monthly" or no cadence word at all) is treated
// as the full monthly-equivalent rate.
function billingAkDetectCadence(text){
  if(/bi-?\s*weekly/.test(text)) return 'biweekly';
  if(/\bweekly\b/.test(text)) return 'weekly';
  return 'monthly';
}

// Sums numbered occurrences ("3 callers" -> 3) plus one unit for every bare
// occurrence of the word not already consumed by a numbered match ("caller"
// alone, "pt caller", "...for 2nd caller" -> 1 each). `pattern` is a full
// regex alternation source (e.g. "callers?", "acquisitions?|acq"), not a
// bare word — callers pass the plural/abbreviation forms themselves.
function billingAkExtractUnits(text, pattern){
  let total = 0;
  const consumed = [];
  const numbered = new RegExp(`(\\d+(?:\\.\\d+)?)\\s*(?:${pattern})\\b`, 'gi');
  let m;
  while((m = numbered.exec(text))){
    total += parseFloat(m[1]);
    consumed.push([m.index, m.index + m[0].length]);
  }
  const bare = new RegExp(`(?:${pattern})\\b`, 'gi');
  while((m = bare.exec(text))){
    if(!consumed.some(([s, e]) => m.index >= s && m.index < e)) total += 1;
  }
  return total;
}

// Extracts a record count from phrasing like "10k data", "20k records",
// "7500 records", "1900 record", "25 leads", "6.4k records @0.04$" — "k"
// multiplies by 1000. Deliberately does NOT match a bare "Nk" with no
// data/records/leads word attached (e.g. "5k package" is a price-tier name,
// not 5,000 records — confirmed against this file's real amounts: "5k
// package" bills ~$5,146, nowhere near 5000 * $0.05).
function billingAkExtractDataRecords(text){
  let total = 0;
  const consumed = [];
  const patterns = [
    [/(\d+(?:\.\d+)?)\s*k\s*data\s*records?\b/gi, 1000],
    [/(\d+(?:\.\d+)?)\s*k\s*records?\b/gi, 1000],
    [/(\d+(?:\.\d+)?)\s*k\s*data\b/gi, 1000],
    [/(\d+(?:\.\d+)?)\s*k\s*leads?\b/gi, 1000],
    [/(\d+(?:\.\d+)?)\s*data\s*records?\b/gi, 1],
    [/(\d+(?:\.\d+)?)\s*records?\b/gi, 1],
    [/(\d+(?:\.\d+)?)\s*leads?\b/gi, 1],
    [/(\d+(?:\.\d+)?)\s*data\b/gi, 1],
  ];
  for(const [re, mult] of patterns){
    let m;
    while((m = re.exec(text))){
      if(consumed.some(([s, e]) => m.index >= s && m.index < e)) continue;
      total += parseFloat(m[1]) * mult;
      consumed.push([m.index, m.index + m[0].length]);
    }
  }
  return total;
}

// Splits a caller count into part-time vs full-time — "2 pt callers",
// "part time caller", "1 part-time caller" all count toward partTimeUnits.
// A dedicated pattern (not billingAkExtractUnits) because the leading
// number can sit before the part-time marker rather than directly against
// "caller" ("2 pt callers" — the "2" isn't adjacent to "callers"), which
// billingAkExtractUnits's plain numbered pattern would miss entirely and
// undercount as a single bare "caller" match.
function billingAkExtractCallerBreakdown(text){
  let total = 0;
  let partTime = 0;
  const consumed = [];
  const numbered = /(\d+(?:\.\d+)?)\s*(?:(pt|part[-\s]?time)\s*)?callers?\b/gi;
  let m;
  while((m = numbered.exec(text))){
    const n = parseFloat(m[1]);
    total += n;
    if(m[2]) partTime += n;
    consumed.push([m.index, m.index + m[0].length]);
  }
  const bare = /(?:(pt|part[-\s]?time)\s*)?callers?\b/gi;
  while((m = bare.exec(text))){
    if(consumed.some(([s, e]) => m.index >= s && m.index < e)) continue;
    total += 1;
    if(m[1]) partTime += 1;
  }
  const partTimeUnits = Math.min(partTime, total); // guard against a malformed match exceeding the overall count
  return { totalUnits: total, fullTimeUnits: Math.max(0, total - partTimeUnits), partTimeUnits };
}

// The standard bundled monthly data allotment for the given caller mix,
// prorated by cadence the same way the dialer rate is (biweekly = /2,
// weekly = /4) — used only when the product text doesn't spell out an
// explicit record count of its own (billingAkExtractDataRecords > 0 always
// wins, since that's what was actually delivered in that transaction).
function billingAkImplicitDataRecords(fullTimeUnits, partTimeUnits, cadence){
  const monthlyRecords = fullTimeUnits * BILLING_AK_FULL_TIME_CALLER_MONTHLY_RECORDS + partTimeUnits * BILLING_AK_PART_TIME_CALLER_MONTHLY_RECORDS;
  return monthlyRecords / BILLING_AK_CADENCE_DIVISOR[cadence];
}

// v221: named SKUs whose own text carries no caller/dialer/data/acquisition
// keyword at all, so the generic extraction below can't see their real
// composition — hardcoded per the business owner's confirmation. Keyed on a
// hyphen/space-normalized form so "part-time package" / "part  time package"
// all resolve to the same entry. No dataRecords here — it's always computed
// from callerUnits/partTimeCallerUnits via billingAkImplicitDataRecords
// below, same as any other row with no explicit record count in its text.
const BILLING_AK_KNOWN_PACKAGES = {
  '5k package': { callerUnits: 2, partTimeCallerUnits: 0, dialerUnits: 2, acquisitionUnits: 1 },
  'part time package': { callerUnits: 1, partTimeCallerUnits: 1, dialerUnits: 1, acquisitionUnits: 0 },
  // Same bundle as 'part time package' above — "1 pt caller package" is
  // priced identically ($1,029.20) across all 6 occurrences, confirmed by
  // the business owner to be the same part-time caller + dialer + standard
  // 7.5k/mo allotment, not a literal read of its own (keyword-less) text.
  '1 pt caller package': { callerUnits: 1, partTimeCallerUnits: 1, dialerUnits: 1, acquisitionUnits: 0 },
  // Same $1,029.20 bundle as '1 pt caller package' above — the "25"/"30
  // leads" wording is NOT a literal record count here (confirmed by the
  // business owner); it's the same part-time caller + dialer + standard
  // 7.5k/mo allotment, just phrased differently. Parens are kept literally
  // in the key (normalization only touches hyphens/underscores/whitespace).
  '1 caller package 25 leads': { callerUnits: 1, partTimeCallerUnits: 1, dialerUnits: 1, acquisitionUnits: 0 },
  '1 caller package (25 leads)': { callerUnits: 1, partTimeCallerUnits: 1, dialerUnits: 1, acquisitionUnits: 0 },
  '1 caller package (30 leads)': { callerUnits: 1, partTimeCallerUnits: 1, dialerUnits: 1, acquisitionUnits: 0 },
  'package biweekly': { callerUnits: 1, partTimeCallerUnits: 0, dialerUnits: 1, acquisitionUnits: 0 },
  // "Roofing"/"Flipping" are campaign niches, not literal caller/dialer/data
  // keywords — "1 Roofing and 1 Flipping" means 1 caller working roofing
  // leads + 1 caller working flipping leads (2 callers total) + 1 dialer
  // each, but NO data allotment — confirmed by the business owner.
  '1 roofing and 1 flipping': { callerUnits: 2, partTimeCallerUnits: 0, dialerUnits: 2, acquisitionUnits: 0, impliesData: false },
};

// v229: the implicit allotment (billingAkImplicitDataRecords) only fires
// for a row that actually says something about data — "data"/"record(s)"/
// "lead(s)" present but with no parseable quantity (e.g. "part time caller +
// dialer + data"). It must NOT fire just because a caller is present: "1
// caller + 1 dialer" ($1,317.38 typical) and "1 caller + 1 dialer + 10k
// data" ($1,831.98 typical) are genuinely different, separately-priced
// products in this file — the ~$514.60 gap between them is real data
// revenue that only the second one actually sold. Known packages (below)
// are the one exception: they're bundled SKUs confirmed to include data by
// the business owner, even though their own text has no data/record/lead
// word to detect at all.
const BILLING_AK_DATA_MENTION_RE = /\b(?:data|records?|leads?)\b/i;

// v228: "8 callers" is a confirmed exception to the "1 dialer per caller"
// default just below — unlike "4 Callers"/"5 Callers biweekly", this one
// genuinely doesn't include a dialer. Keyed the same normalized way as
// BILLING_AK_KNOWN_PACKAGES; kept as a separate exclusion set rather than
// folded into that table because a known-package entry would also turn on
// the implicit-data allotment (impliesData = true unconditionally there),
// which "8 callers" shouldn't get either — this exclusion only touches the
// dialer default, nothing else about its generic classification.
const BILLING_AK_NO_IMPLICIT_DIALER = new Set(['8 callers']);

function classifyBillingAkProduct(productText){
  const text = String(productText || '').trim().toLowerCase();
  const cadence = billingAkDetectCadence(text);
  const knownKey = text.replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();
  const known = BILLING_AK_KNOWN_PACKAGES[knownKey];
  let callerUnits, partTimeCallerUnits, dialerUnits, acquisitionUnits, explicitDataRecords, impliesData;
  if(known){
    ({ callerUnits, partTimeCallerUnits, dialerUnits, acquisitionUnits } = known);
    explicitDataRecords = 0;
    // Known packages imply data by default (they're confirmed bundles) —
    // 'impliesData: false' on an individual entry overrides that (e.g.
    // "1 Roofing and 1 Flipping" has callers + dialers but no data).
    impliesData = known.impliesData !== false;
  } else {
    const breakdown = billingAkExtractCallerBreakdown(text);
    callerUnits = breakdown.totalUnits;
    partTimeCallerUnits = breakdown.partTimeUnits;
    dialerUnits = billingAkExtractUnits(text, 'dialers?');
    acquisitionUnits = billingAkExtractUnits(text, 'acquisitions?|acq');
    explicitDataRecords = billingAkExtractDataRecords(text);
    impliesData = BILLING_AK_DATA_MENTION_RE.test(text);
    // v227: a row that names ONLY callers — no dialer, data, or acquisition
    // word anywhere, e.g. "4 Callers", "5 Callers biweekly" — comes with
    // one dialer per caller by default, confirmed by the business owner.
    // Excludes "remaining amount for..." rows: those are partial/leftover
    // balance payments on an existing caller, not a fresh unit sale, so
    // imputing a full dialer rate onto them would misattribute revenue.
    if(dialerUnits === 0 && acquisitionUnits === 0 && !impliesData && callerUnits > 0 && !/\bremaining\b/.test(text) && !BILLING_AK_NO_IMPLICIT_DIALER.has(knownKey)){
      dialerUnits = callerUnits;
    }
  }
  const fullTimeCallerUnits = Math.max(0, callerUnits - partTimeCallerUnits);
  const dataRecords = explicitDataRecords > 0
    ? explicitDataRecords
    : (impliesData ? billingAkImplicitDataRecords(fullTimeCallerUnits, partTimeCallerUnits, cadence) : 0);
  return { callerUnits, dialerUnits, dataRecords, acquisitionUnits, cadence };
}

// "07/18/2026 2:20 PM" -> "2026-07-18". Same 2-digit-year expansion as
// parseRelayCsv, in case a future weekly export ever shortens the year.
function parseBillingAkDate(raw){
  const datePart = String(raw || '').trim().split(' ')[0];
  const [mo, d, yRaw] = datePart.split('/').map(Number);
  if(!mo || !d || !yRaw) return null;
  const y = yRaw < 100 ? (yRaw <= 68 ? 2000 + yRaw : 1900 + yRaw) : yRaw;
  return `${y}-${String(mo).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
}

// Named-header lookup (like parseRelayCsv) rather than fixed-position
// columns, since this export's column order isn't guaranteed week to week.
const BILLING_AK_COLUMNS = ['Amount', 'Status', 'Name', 'Email', 'Date', 'Product', 'Payment ID'];
function parseBillingAkXlsx(headerRow, dataRows){
  const norm = s => String(s || '').trim().toLowerCase();
  const idx = {};
  BILLING_AK_COLUMNS.forEach(h => { idx[h] = headerRow.findIndex(c => norm(c) === norm(h)); });
  if(idx['Amount'] < 0 || idx['Date'] < 0 || idx['Product'] < 0 || idx['Payment ID'] < 0){
    throw new Error("This doesn't look like an agency_transactions export — missing required columns (Amount, Date, Product, Payment ID).");
  }
  return dataRows.map(r => {
    const amountRaw = String(r[idx['Amount']] ?? '').replace(/[$,]/g, '').trim();
    const amount = amountRaw ? parseFloat(amountRaw) : NaN;
    const productText = String(r[idx['Product']] || '').trim();
    const { callerUnits, dialerUnits, dataRecords, acquisitionUnits, cadence } = classifyBillingAkProduct(productText);
    const dataRevenue = dataRecords * BILLING_AK_DATA_RATE;
    const dialerRevenue = dialerUnits * BILLING_AK_DIALER_RATE_BY_CADENCE[cadence];
    const remainder = amount - dataRevenue - dialerRevenue;
    // Caller and Acquisition split whatever's left, proportional to unit
    // count — e.g. "3 callers + 1 acq" splits 3:1, "5k package" (2 callers +
    // 1 acquisition) splits 2:1. A row naming neither keeps the original
    // all-to-Caller fallback (shareUnits === 0).
    const shareUnits = callerUnits + acquisitionUnits;
    const callerRevenue = shareUnits > 0 ? remainder * (callerUnits / shareUnits) : remainder;
    const acquisitionRevenue = shareUnits > 0 ? remainder * (acquisitionUnits / shareUnits) : 0;
    return {
      payment_id: String(r[idx['Payment ID']] || '').trim(),
      txn_date: parseBillingAkDate(r[idx['Date']]),
      customer_name: idx['Name'] >= 0 ? ((r[idx['Name']] || '').trim() || null) : null,
      customer_email: idx['Email'] >= 0 ? ((r[idx['Email']] || '').trim() || null) : null,
      product_text: productText,
      status: idx['Status'] >= 0 ? (String(r[idx['Status']] || '').trim() || 'Unknown') : 'Unknown',
      amount,
      cadence,
      caller_units: callerUnits, dialer_units: dialerUnits, data_records: dataRecords, acquisition_units: acquisitionUnits,
      caller_revenue: callerRevenue, dialer_revenue: dialerRevenue, data_revenue: dataRevenue, acquisition_revenue: acquisitionRevenue,
    };
  }).filter(row => row.payment_id && row.txn_date && !Number.isNaN(row.amount));
}

let billingAkParsedRows = [];
let billingAkTransactions = [];

$('billingAkUploadInput').addEventListener('change', async (e) => {
  const file = e.target.files[0];
  const msg = $('billingAkUploadMsg');
  msg.style.display = 'none';
  $('billingAkUploadPreviewWrap').style.display = 'none';
  if(!file) return;
  try{
    const buf = await file.arrayBuffer();
    await ensureXlsx();
    const wb = XLSX.read(buf, { type: 'array' });
    const sheet = wb.Sheets[wb.SheetNames[0]];
    const rows = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '', raw: false });
    if(!rows.length){ msg.textContent = 'That file has no rows.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }
    const headerRow = rows[0].map(h => String(h || '').trim());
    const dataRows = rows.slice(1).filter(r => r.some(c => String(c || '').trim() !== ''));
    if(!dataRows.length){ msg.textContent = 'No transaction rows found in this file.'; msg.className = 'msg'; msg.style.display = 'block'; return; }

    const parsed = parseBillingAkXlsx(headerRow, dataRows);
    if(!parsed.length){ msg.textContent = 'No usable transaction rows found in this file.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }

    const allIds = parsed.map(r => r.payment_id);
    const { data: existing, error: existErr } = await sb.from('billing_ak_transactions').select('payment_id').in('payment_id', allIds);
    if(existErr){ msg.textContent = existErr.message; msg.className = 'msg error'; msg.style.display = 'block'; return; }
    const existingIds = new Set((existing || []).map(r => r.payment_id));
    parsed.forEach(row => { row.isNew = !existingIds.has(row.payment_id); });

    billingAkParsedRows = parsed;
    billingAkParsedRows.sourceFilename = file.name;
    renderBillingAkPreview();
  }catch(err){
    msg.textContent = `Couldn't read that file: ${err.message}`;
    msg.className = 'msg error';
    msg.style.display = 'block';
  }
});

function renderBillingAkPreview(){
  const newCount = billingAkParsedRows.filter(r => r.isNew).length;
  const skipCount = billingAkParsedRows.length - newCount;
  $('billingAkPreviewHead').innerHTML = `<tr><th>Status</th><th>Date</th><th>Customer</th><th>Product</th><th>Cadence</th><th>Amount</th><th>Callers</th><th>Dialers</th><th>Data</th><th>Acq</th></tr>`;
  $('billingAkPreviewBody').innerHTML = billingAkParsedRows.map(r => `
    <tr style="${r.isNew ? '' : 'opacity:0.5;'}">
      <td class="mono" style="white-space:nowrap; color:${r.isNew ? 'var(--focus)' : 'var(--text-dim)'};">${r.isNew ? 'New' : 'Already imported'}</td>
      <td class="mono">${escapeHtml(r.txn_date)}</td>
      <td>${escapeHtml(r.customer_name || '—')}</td>
      <td style="max-width:200px;" title="${escapeHtml(r.product_text)}">${escapeHtml(r.product_text.slice(0, 40))}</td>
      <td class="mono">${escapeHtml(r.cadence)}</td>
      <td class="mono">$${r.amount.toFixed(2)}</td>
      <td class="mono">${r.caller_units}</td>
      <td class="mono">${r.dialer_units}</td>
      <td class="mono">${r.data_records.toLocaleString()}</td>
      <td class="mono">${r.acquisition_units}</td>
    </tr>
  `).join('');
  $('billingAkImportCount').textContent = `${newCount} new, ${skipCount} already imported (skipped)`;
  $('billingAkConfirmImportBtn').disabled = newCount === 0;
  $('billingAkUploadPreviewWrap').style.display = '';
}

$('billingAkCancelImportBtn').addEventListener('click', () => {
  billingAkParsedRows = [];
  $('billingAkUploadPreviewWrap').style.display = 'none';
  $('billingAkUploadInput').value = '';
});

$('billingAkConfirmImportBtn').addEventListener('click', async () => {
  const msg = $('billingAkUploadMsg');
  const btn = $('billingAkConfirmImportBtn');
  const { data: { user } } = await sb.auth.getUser();
  const newRows = billingAkParsedRows.filter(r => r.isNew);
  if(!newRows.length) return;
  btn.disabled = true;
  btn.textContent = 'Importing…';
  const sourceFilename = billingAkParsedRows.sourceFilename || 'unknown.xlsx';
  const payload = newRows.map(r => ({
    payment_id: r.payment_id, txn_date: r.txn_date,
    customer_name: r.customer_name, customer_email: r.customer_email,
    product_text: r.product_text, status: r.status, amount: r.amount, cadence: r.cadence,
    caller_units: r.caller_units, dialer_units: r.dialer_units, data_records: r.data_records, acquisition_units: r.acquisition_units,
    caller_revenue: r.caller_revenue, dialer_revenue: r.dialer_revenue, data_revenue: r.data_revenue, acquisition_revenue: r.acquisition_revenue,
    source_filename: sourceFilename, imported_by: user ? user.id : null,
  }));
  // ignoreDuplicates (ON CONFLICT DO NOTHING on payment_id) is the safety net
  // for a race — e.g. the same file uploaded from two tabs — on top of the
  // client-side New/Already-imported filtering above.
  const { error } = await sb.from('billing_ak_transactions')
    .upsert(payload, { onConflict: 'payment_id', ignoreDuplicates: true });
  btn.disabled = false;
  btn.textContent = 'Import';
  if(error){ msg.textContent = error.message; msg.className = 'msg error'; msg.style.display = 'block'; return; }
  msg.textContent = `Imported ${newRows.length} transaction(s) from ${sourceFilename}.`;
  msg.className = 'msg';
  msg.style.display = 'block';
  logActivity('finance.billing_ak_import', null, null, `Imported ${newRows.length} Billing AK transaction(s) from ${sourceFilename}`);
  billingAkParsedRows = [];
  $('billingAkUploadPreviewWrap').style.display = 'none';
  $('billingAkUploadInput').value = '';
  await loadBillingAk();
});

// ---------- Date range: blank = full history (same convention as
// FINANCE_DATE_RANGE_STORAGE_KEY above). ----------
const BILLING_AK_DATE_RANGE_STORAGE_KEY = 'ptai_billing_ak_date_range';
function restoreBillingAkDateRange(){
  try{
    const saved = JSON.parse(localStorage.getItem(BILLING_AK_DATE_RANGE_STORAGE_KEY) || 'null');
    if(saved && saved.from) $('billingAkDateFromFilter').value = saved.from;
    if(saved && saved.to) $('billingAkDateToFilter').value = saved.to;
  }catch(e){ /* corrupt/inaccessible storage — fall through to blank (full history) */ }
}
function saveBillingAkDateRange(){
  try{
    localStorage.setItem(BILLING_AK_DATE_RANGE_STORAGE_KEY, JSON.stringify({
      from: $('billingAkDateFromFilter').value, to: $('billingAkDateToFilter').value,
    }));
  }catch(e){ /* private browsing / storage quota — not worth failing over */ }
}
$('billingAkDateFromFilter').addEventListener('change', () => { saveBillingAkDateRange(); loadBillingAk(); });
$('billingAkDateToFilter').addEventListener('change', () => { saveBillingAkDateRange(); loadBillingAk(); });
$('billingAkRefreshBtn').addEventListener('click', () => loadBillingAk());
$('billingAkExcludeNonSucceededToggle').addEventListener('change', renderBillingAkReport);
// Re-render only — the product filter narrows rows already in memory, so
// unlike the date filters it never needs another round trip.
$('billingAkProductFilter').addEventListener('change', renderBillingAkReport);

async function loadBillingAk(){
  if(!$('billingAkDateFromFilter').value && !$('billingAkDateToFilter').value) restoreBillingAkDateRange();
  const from = $('billingAkDateFromFilter').value;
  const to = $('billingAkDateToFilter').value;
  let query = sb.from('billing_ak_transactions').select('*').order('txn_date', { ascending: false });
  if(from) query = query.gte('txn_date', from);
  if(to) query = query.lte('txn_date', to);
  const { data, error } = await query;
  if(error){ console.error('Failed to load Billing AK transactions:', error); billingAkTransactions = []; }
  else billingAkTransactions = data || [];
  renderBillingAkReport();
}

// Monday-start ISO week key ("2026-07-13") for the "Weekly trend" table —
// grouped by the transaction date itself, not by which file it was imported
// in, so it stays correct even if two weeks' worth get imported together.
function billingAkWeekStart(dateStr){
  const d = new Date(dateStr + 'T00:00:00Z');
  const day = d.getUTCDay(); // 0=Sun..6=Sat
  const diff = (day === 0 ? -6 : 1) - day; // shift back to Monday
  d.setUTCDate(d.getUTCDate() + diff);
  return d.toISOString().slice(0, 10);
}
function fmtBillingAkMoney(n){ return `$${Number(n).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`; }

// The status + product filters, in ONE place. renderBillingAkReport() and
// the Export CSV button each used to rebuild the status filter inline; the
// moment a second filter existed that duplication would have let the file
// disagree with what's on screen — an export quietly containing rows the
// user had filtered out is exactly the kind of wrong answer nobody checks.
//
// Product filter semantics: "included this product", i.e. units > 0. Note
// this catches BUNDLED data as well as explicitly-purchased data — a
// "5k package" row implies data records via BILLING_AK_KNOWN_PACKAGES even
// though the product text never says "data" (see classifyBillingAkProduct's
// impliesData). That is intended for "who paid for data?": the customer did
// pay for data, it just arrived inside a package.
function billingAkFilteredRows(){
  const excludeNonSucceeded = $('billingAkExcludeNonSucceededToggle').checked;
  const product = $('billingAkProductFilter') ? $('billingAkProductFilter').value : '';
  const unitsField = {
    data: 'data_records',
    caller: 'caller_units',
    dialer: 'dialer_units',
    acquisition: 'acquisition_units',
  }[product];
  return billingAkTransactions.filter(t => {
    if(excludeNonSucceeded && String(t.status).toLowerCase() !== 'succeeded') return false;
    if(unitsField && !(Number(t[unitsField]) > 0)) return false;
    return true;
  });
}

function renderBillingAkReport(){
  const filtered = billingAkFilteredRows();
  // "No transactions in this range" is wrong (and sends people hunting
  // through dates) when it's the product filter that emptied the table.
  const productSel = $('billingAkProductFilter');
  const productLabel = productSel && productSel.value
    ? productSel.options[productSel.selectedIndex].text.toLowerCase()
    : '';
  const billingAkEmptyMsg = productLabel
    ? `No transactions including ${escapeHtml(productLabel)} in this range.`
    : 'No transactions in this range.';

  const totalCallers = filtered.reduce((s, t) => s + Number(t.caller_units), 0);
  const totalDialers = filtered.reduce((s, t) => s + Number(t.dialer_units), 0);
  const totalDataRecords = filtered.reduce((s, t) => s + Number(t.data_records), 0);
  const totalAcquisitions = filtered.reduce((s, t) => s + Number(t.acquisition_units), 0);
  const totalCallerRevenue = filtered.reduce((s, t) => s + Number(t.caller_revenue), 0);
  const totalDialerRevenue = filtered.reduce((s, t) => s + Number(t.dialer_revenue), 0);
  const totalDataRevenue = filtered.reduce((s, t) => s + Number(t.data_revenue), 0);
  const totalAcquisitionRevenue = filtered.reduce((s, t) => s + Number(t.acquisition_revenue), 0);
  const totalProfit = totalCallerRevenue + totalDialerRevenue + totalDataRevenue + totalAcquisitionRevenue;

  $('billingAkStatCallers').textContent = totalCallers.toLocaleString();
  $('billingAkStatDialers').textContent = totalDialers.toLocaleString();
  $('billingAkStatDataRecords').textContent = totalDataRecords.toLocaleString();
  $('billingAkStatAcquisitions').textContent = totalAcquisitions.toLocaleString();
  $('billingAkStatTotalProfit').textContent = fmtBillingAkMoney(totalProfit);

  const catRows = [
    ['Caller', totalCallers, totalCallerRevenue],
    ['Dialer', totalDialers, totalDialerRevenue],
    ['Data', totalDataRecords, totalDataRevenue],
    ['Acquisition', totalAcquisitions, totalAcquisitionRevenue],
  ];
  $('billingAkCategoryBody').innerHTML = filtered.length
    ? catRows.map(([name, units, revenue]) => `<tr><td>${name}</td><td class="mono">${units.toLocaleString()}</td><td class="mono" style="color:${revenue < 0 ? 'var(--danger)' : 'var(--good)'};">${fmtBillingAkMoney(revenue)}</td><td class="mono">${totalProfit ? ((revenue / totalProfit) * 100).toFixed(1) : '0.0'}%</td></tr>`).join('')
      + `<tr style="font-weight:700; border-top:2px solid var(--border);"><td>Total</td><td class="mono">—</td><td class="mono">${fmtBillingAkMoney(totalProfit)}</td><td class="mono">100.0%</td></tr>`
    : `<tr><td colspan="4" class="empty">${billingAkEmptyMsg}</td></tr>`;

  const byWeek = {};
  filtered.forEach(t => {
    const wk = billingAkWeekStart(t.txn_date);
    if(!byWeek[wk]) byWeek[wk] = { callers: 0, dialers: 0, dataRecords: 0, acquisitions: 0, profit: 0 };
    byWeek[wk].callers += Number(t.caller_units);
    byWeek[wk].dialers += Number(t.dialer_units);
    byWeek[wk].dataRecords += Number(t.data_records);
    byWeek[wk].acquisitions += Number(t.acquisition_units);
    byWeek[wk].profit += Number(t.caller_revenue) + Number(t.dialer_revenue) + Number(t.data_revenue) + Number(t.acquisition_revenue);
  });
  const weekRows = Object.entries(byWeek).sort((a, b) => b[0].localeCompare(a[0]));
  $('billingAkWeeklyBody').innerHTML = weekRows.length
    ? weekRows.map(([wk, v]) => `<tr><td class="mono">${escapeHtml(wk)}</td><td class="mono">${v.callers.toLocaleString()}</td><td class="mono">${v.dialers.toLocaleString()}</td><td class="mono">${v.dataRecords.toLocaleString()}</td><td class="mono">${v.acquisitions.toLocaleString()}</td><td class="mono">${fmtBillingAkMoney(v.profit)}</td></tr>`).join('')
    : `<tr><td colspan="6" class="empty">${billingAkEmptyMsg}</td></tr>`;

  $('billingAkTxnBody').innerHTML = filtered.length ? filtered.map(t => `
    <tr style="${Number(t.caller_revenue) < 0 ? 'background:rgba(220,60,60,0.12);' : ''}">
      <td class="mono">${escapeHtml(t.txn_date)}</td>
      <td>${escapeHtml(t.customer_name || '—')}</td>
      <td style="max-width:200px;" title="${escapeHtml(t.product_text)}">${escapeHtml((t.product_text || '').slice(0, 40))}</td>
      <td class="mono">${escapeHtml(t.cadence)}</td>
      <td class="mono">$${Number(t.amount).toFixed(2)}</td>
      <td class="mono">${Number(t.caller_units)}</td>
      <td class="mono">${Number(t.dialer_units)}</td>
      <td class="mono">${Number(t.data_records).toLocaleString()}</td>
      <td class="mono">${Number(t.acquisition_units)}</td>
      <td class="mono" style="color:${Number(t.caller_revenue) < 0 ? 'var(--danger)' : 'inherit'};">$${Number(t.caller_revenue).toFixed(2)}</td>
      <td class="mono">$${Number(t.dialer_revenue).toFixed(2)}</td>
      <td class="mono">$${Number(t.data_revenue).toFixed(2)}</td>
      <td class="mono">$${Number(t.acquisition_revenue).toFixed(2)}</td>
    </tr>
  `).join('') : `<tr><td colspan="13" class="empty">${billingAkEmptyMsg}</td></tr>`;
}

// v223: rows imported before a pricing rule/known-package existed (e.g. the
// Acquisition category, or the "5k package"/"part time package"/"package
// biweekly" overrides) got their classification computed and stored
// permanently at import time — the table never re-classifies on its own
// when the rules change later. This re-runs classifyBillingAkProduct on
// every stored row's own product_text (source of truth never changes,
// only how it's interpreted) and rewrites the derived columns wherever
// today's rules disagree with what's stored, without touching amount,
// dates, or anything else.
$('billingAkRecalcBtn').addEventListener('click', async () => {
  const btn = $('billingAkRecalcBtn');
  const msg = $('billingAkUploadMsg');
  if(!confirm('Re-run classification on every imported Billing AK transaction using today\'s rules? This rewrites caller/dialer/data/acquisition units and profit for any row where the rules have changed since it was imported.')) return;
  btn.disabled = true;
  btn.textContent = 'Recalculating…';
  try{
    const { data: rows, error: selErr } = await sb.from('billing_ak_transactions').select('id, product_text, amount');
    if(selErr) throw selErr;
    let changedCount = 0;
    for(const row of (rows || [])){
      const { callerUnits, dialerUnits, dataRecords, acquisitionUnits, cadence } = classifyBillingAkProduct(row.product_text);
      const dataRevenue = dataRecords * BILLING_AK_DATA_RATE;
      const dialerRevenue = dialerUnits * BILLING_AK_DIALER_RATE_BY_CADENCE[cadence];
      const remainder = Number(row.amount) - dataRevenue - dialerRevenue;
      const shareUnits = callerUnits + acquisitionUnits;
      const callerRevenue = shareUnits > 0 ? remainder * (callerUnits / shareUnits) : remainder;
      const acquisitionRevenue = shareUnits > 0 ? remainder * (acquisitionUnits / shareUnits) : 0;
      const { error: updErr } = await sb.from('billing_ak_transactions').update({
        cadence, caller_units: callerUnits, dialer_units: dialerUnits, data_records: dataRecords, acquisition_units: acquisitionUnits,
        caller_revenue: callerRevenue, dialer_revenue: dialerRevenue, data_revenue: dataRevenue, acquisition_revenue: acquisitionRevenue,
      }).eq('id', row.id);
      if(updErr){ console.error('Recalculate failed for row', row.id, updErr.message); continue; }
      changedCount++;
    }
    msg.textContent = `Recalculated ${changedCount} of ${(rows || []).length} transaction(s).`;
    msg.className = 'msg';
    msg.style.display = 'block';
    logActivity('finance.billing_ak_recalculate', null, null, `Recalculated classification for ${changedCount} Billing AK transaction(s)`);
    await loadBillingAk();
  }catch(err){
    msg.textContent = `Couldn't recalculate: ${err.message}`;
    msg.className = 'msg error';
    msg.style.display = 'block';
  }finally{
    btn.disabled = false;
    btn.textContent = 'Recalculate all';
  }
});

$('billingAkExportCsvBtn').addEventListener('click', () => {
  // Same rows the table is showing — see billingAkFilteredRows().
  const filtered = billingAkFilteredRows();
  const headers = ['Date', 'Customer', 'Product', 'Cadence', 'Amount', 'Callers', 'Dialers', 'Data records', 'Acquisitions', 'Caller $', 'Dialer $', 'Data $', 'Acquisition $'];
  const rows = filtered.map(t => [t.txn_date, t.customer_name || '', t.product_text, t.cadence, Number(t.amount).toFixed(2), Number(t.caller_units), Number(t.dialer_units), Number(t.data_records), Number(t.acquisition_units), Number(t.caller_revenue).toFixed(2), Number(t.dialer_revenue).toFixed(2), Number(t.data_revenue).toFixed(2), Number(t.acquisition_revenue).toFixed(2)]);
  exportCSV(`billing-ak-transactions-${todayDateInputValue()}.csv`, headers, rows);
  logActivity('finance.billing_ak_export_csv', null, null, `Exported ${rows.length} Billing AK transaction(s) to CSV`);
});

// ---------- session persistence + 1-hour idle timeout ----------
// The Supabase client above now persists its session in sessionStorage
// (per-tab, cleared on tab/browser close) instead of never persisting at
// all -- see that client's own comment for why. On its own that would let
// a merely-open tab stay signed in indefinitely (Supabase's
// autoRefreshToken doesn't care whether anyone's actually using it), so
// this enforces a genuine 4-hour INACTIVITY timeout independent of the
// token's own expiry: real user input (click/keydown/mousemove/scroll/
// touch) stamps a last-activity time in sessionStorage, checked once a
// minute -- go a full 4 hours with none of that and performSignOut() runs
// the same as clicking "Sign out" manually.
const IDLE_TIMEOUT_MS = 4 * 60 * 60 * 1000;
const IDLE_LAST_ACTIVITY_KEY = 'dashboardLastActivityAt';
const IDLE_SIGNOUT_MESSAGE_KEY = 'dashboardIdleSignOutMessage';
let lastActivityRecordedAt = 0;
function recordActivity(){
  const now = Date.now();
  if(now - lastActivityRecordedAt < 5000) return; // throttled -- mousemove/scroll fire constantly
  lastActivityRecordedAt = now;
  try{ sessionStorage.setItem(IDLE_LAST_ACTIVITY_KEY, String(now)); }catch(e){}
}
function idleMsElapsed(){
  try{
    const last = Number(sessionStorage.getItem(IDLE_LAST_ACTIVITY_KEY));
    return last ? Date.now() - last : 0;
  }catch(e){ return 0; }
}
['click', 'keydown', 'mousemove', 'scroll', 'touchstart'].forEach(evt => {
  document.addEventListener(evt, recordActivity, { passive: true });
});
// Only actually signs anyone out while myUserId is set (i.e. the app,
// not just the login screen, is showing) -- sitting idle ON the login
// form itself is never mistaken for a stale authenticated session.
setInterval(() => {
  if(myUserId && idleMsElapsed() >= IDLE_TIMEOUT_MS) performSignOut({ idleTimeout: true });
}, 60000);

// ---------- boot: resume an existing session, if any and not stale ----------
(async () => {
  let staleMsg = null;
  try{ staleMsg = sessionStorage.getItem(IDLE_SIGNOUT_MESSAGE_KEY); sessionStorage.removeItem(IDLE_SIGNOUT_MESSAGE_KEY); }catch(e){}
  if(staleMsg) $('loginMsg').textContent = staleMsg;

  if(!sb){
    $('loginScreen').style.display = 'block';
    prefillAndFocusLogin();
    return;
  }

  // v657: "Log in as user" hand-off. User Management mints a single-use
  // magic-link token server-side (manage-user's `impersonate` action) and
  // opens this page with it, exactly as the client portal already does for
  // "Log in as client".
  //
  // Handled BEFORE the idle check and the getSession() restore below: this
  // tab is brand new (opened with noopener, so it has no sessionStorage of
  // its own), and running the stale-session logic first would only ever
  // bounce a legitimate hand-off to the login form.
  //
  // The URL is scrubbed immediately, before the exchange -- the token is
  // single-use, and neither a refresh nor a bookmark of this URL should be
  // able to replay it or leave it sitting in history.
  try{
    const impParams = new URLSearchParams(location.search);
    const impToken = impParams.get('staff_token');
    if(impToken){
      history.replaceState(null, '', location.pathname);
      const { error: otpErr } = await sb.auth.verifyOtp({ token_hash: impToken, type: 'magiclink' });
      if(!otpErr){
        const { data: { session: impSession } } = await sb.auth.getSession();
        if(impSession && impSession.user){
          staffImpersonating = true;
          // v815 (W3): bind this session to the "Log in as" pass manage-user just
          // recorded, so the database lets it through when the account has
          // two-step on (a code this tab cannot enter). Harmless otherwise.
          try{ await sb.rpc('claim_impersonation_grant'); }catch(e){}
          recordActivity();
          try{
            await establishSession(impSession.user, { isNewLogin: false });
            showImpersonationBanner();
            return;
          }catch(e){
            $('loginScreen').style.display = 'block';
            $('loginMsg').textContent = e.message || 'Could not open the portal as that user.';
            prefillAndFocusLogin();
            return;
          }
        }
      }
      // Expired or already used. Say so rather than dropping the admin on a
      // bare login form with no explanation of what just failed.
      console.error('Impersonation sign-in failed:', otpErr && otpErr.message);
      $('loginScreen').style.display = 'block';
      $('loginMsg').textContent = 'That "log in as user" link has expired or was already used. Try it again from User Management.';
      prefillAndFocusLogin();
      return;
    }
  }catch(e){
    console.error('Impersonation hand-off failed:', e);
    // falls through to the normal restore below
  }

  if(idleMsElapsed() >= IDLE_TIMEOUT_MS){
    // A stored session exists but this tab has been idle past the
    // timeout since its last check-in (e.g. the computer slept through
    // the once-a-minute interval above) -- clear it rather than silently
    // restoring a session that should already be considered expired.
    try{ await sb.auth.signOut(); }catch(e){}
    try{ sessionStorage.removeItem(IDLE_LAST_ACTIVITY_KEY); }catch(e){}
    if(!staleMsg) $('loginMsg').textContent = 'You were signed out after 4 hours of inactivity — please sign in again.';
    $('loginScreen').style.display = 'block';
    prefillAndFocusLogin();
    return;
  }
  const { data: { session } } = await sb.auth.getSession();
  if(session && session.user){
    recordActivity(); // resuming the tab counts as activity
    try{
      await establishSession(session.user, { isNewLogin: false });
    }catch(e){
      $('loginScreen').style.display = 'block';
      $('loginMsg').textContent = e.message || 'Could not resume your session — please sign in again.';
      prefillAndFocusLogin();
    }
  } else {
    $('loginScreen').style.display = 'block';
    prefillAndFocusLogin();
  }
})();
