function renderRoleViewUsersPicker(selectedIds, filterType){
  selectedIds = selectedIds || [];
  const picker = $('roleViewUsersPicker');
  // v1.2.5: optional filter-by-type. Build the type filter control once from
  // the distinct roles present, then the checklist (each row now shows the
  // user's type next to their name for better tracking).
  const types = Array.from(new Set(allViewableUsers.map(u => u.role || 'user'))).sort();
  const shown = filterType ? allViewableUsers.filter(u => (u.role || 'user') === filterType) : allViewableUsers;
  const filterBar = `
    <div style="width:100%; margin-bottom:8px; display:flex; align-items:center; gap:8px;">
      <span style="font-size:10px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.5px;">Filter by type</span>
      <select id="roleViewUsersTypeFilter" style="width:auto; padding:4px 8px; margin-top:0; font-size:12px;">
        <option value="">All types</option>
        ${types.map(t => `<option value="${t}" ${filterType===t?'selected':''}>${roleDisplayLabel(t)}</option>`).join('')}
      </select>
    </div>`;
  picker.innerHTML = filterBar + (shown.length
    ? shown.map(u => `
        <label style="display:flex; align-items:center; gap:6px; cursor:pointer; text-transform:none; font-family:var(--sans); font-size:12px; color:var(--text); letter-spacing:0;">
          <input type="checkbox" class="role-view-user-cb" value="${u.id}" ${selectedIds.includes(u.id) ? 'checked' : ''} style="width:14px; height:14px; accent-color:var(--focus);"> ${escapeHtml(u.full_name || u.email)} <span class="type-badge" style="opacity:0.75;">${roleDisplayLabel(u.role || 'user')}</span>
        </label>
      `).join('')
    : '<div class="empty" style="padding:4px 0;">No users of this type.</div>');
  // re-render (preserving current selections) when the filter changes
  const filterEl = $('roleViewUsersTypeFilter');
  if(filterEl){
    filterEl.addEventListener('change', () => {
      const keep = Array.from(document.querySelectorAll('.role-view-user-cb:checked')).map(cb => cb.value);
      renderRoleViewUsersPicker(keep, filterEl.value || null);
    });
  }
}

// Populate the "specific user type" dropdown from the distinct roles present.
