  { key: 'created_at', label: 'First Synced', group: 'Metadata', default: false, sortable: true, get: r => r.created_at ? new Date(r.created_at).toLocaleDateString() : '' },
  // v442: "exclude from future exports" -- see set_excluded action's own
  // comment server-side. Off by default (matches every other niche column
  // here) -- most searches never touch excluded rows at all (search
  // defaults to hiding them), so this column is mainly useful in the
  // "Show excluded only" review view.
  { key: 'is_excluded', label: 'Excluded', group: 'Metadata', default: false, get: r => r.is_excluded ? 'Yes' : 'No' },
];
const LB_COLUMNS_STORAGE_KEY = 'lbVisibleColumns';
function lbDefaultColumnKeys(){ return LB_COLUMN_DEFS.filter(c => c.default).map(c => c.key); }
let lbVisibleColumns = new Set(lbDefaultColumnKeys());
(function loadLbVisibleColumns(){
  try{
    const raw = localStorage.getItem(LB_COLUMNS_STORAGE_KEY);
    if(!raw) return;
    const keys = JSON.parse(raw);
    if(!Array.isArray(keys)) return;
    const validKeys = new Set(LB_COLUMN_DEFS.map(c => c.key));
    lbVisibleColumns = new Set(keys.filter(k => validKeys.has(k)));
  }catch(e){ /* keep defaults */ }
})();
function saveLbVisibleColumns(){
  try{ localStorage.setItem(LB_COLUMNS_STORAGE_KEY, JSON.stringify(Array.from(lbVisibleColumns))); }catch(e){}
}
// v443: column reordering -- a separate ordered array (not a Set, order
// matters), holding every column's key including hidden ones so a column's
// position is remembered even while it's unchecked. lbOrderedActiveCols()
// is what rendering actually reads from -- lbColumnOrder filtered down to
// what's currently visible, in that order.
const LB_COLUMN_ORDER_STORAGE_KEY = 'lbColumnOrder';
let lbColumnOrder = LB_COLUMN_DEFS.map(c => c.key);
(function loadLbColumnOrder(){
  try{
    const raw = localStorage.getItem(LB_COLUMN_ORDER_STORAGE_KEY);
    if(!raw) return;
    const keys = JSON.parse(raw);
    if(!Array.isArray(keys)) return;
    const validKeys = new Set(LB_COLUMN_DEFS.map(c => c.key));
    const known = keys.filter(k => validKeys.has(k));
    // Any column added to LB_COLUMN_DEFS after this was last saved (a
    // future release adding a new field) needs a slot too -- appended at
    // the end, not silently dropped from the order entirely.
    const missing = LB_COLUMN_DEFS.map(c => c.key).filter(k => !known.includes(k));
    lbColumnOrder = [...known, ...missing];
  }catch(e){ /* keep default order */ }
})();
function saveLbColumnOrder(){
  try{ localStorage.setItem(LB_COLUMN_ORDER_STORAGE_KEY, JSON.stringify(lbColumnOrder)); }catch(e){}
}
function lbOrderedActiveCols(){
  return lbColumnOrder.map(k => LB_COLUMN_DEFS.find(c => c.key === k)).filter(c => c && lbVisibleColumns.has(c.key));
}
// Swaps `key` with its neighbor (delta -1 = up/earlier, +1 = down/later)
// WITHIN the visible order, then splices that new visible sequence back
// into lbColumnOrder in place -- hidden columns keep whatever relative
// position they already had, only the visible ones' order actually moves.
function lbMoveColumn(key, delta){
  const visible = lbOrderedActiveCols().map(c => c.key);
  const idx = visible.indexOf(key);
  if(idx < 0) return;
  const newIdx = idx + delta;
  if(newIdx < 0 || newIdx >= visible.length) return;
  [visible[idx], visible[newIdx]] = [visible[newIdx], visible[idx]];
  let vi = 0;
  lbColumnOrder = lbColumnOrder.map(k => lbVisibleColumns.has(k) ? visible[vi++] : k);
  saveLbColumnOrder();
  lbOnVisibleColumnsChanged();
}
// v439: generalized to a shared target-element param -- the Match modal
// (openMatchModal/renderMatchResults, further down this file) gets its own
// "Columns" button + panel now too, since its table had the exact same
// "only 7 of 46 fields" gap List Builder's own table had before v438, even
// after v437's Task 7 unified its CSV export to the full 39-column shape --
// the on-screen preview never got the same treatment. Both panels read/
// write the SAME lbVisibleColumns set (one localStorage key) rather than
// tracking two independent selections, since they're both just different
// views onto the same properties data -- picking columns once should apply
// everywhere. Same "grid of labeled checkboxes" pattern as the Custom
// Report tab's own reportColumnsPicker either way, grouped since 43 options
// is too many to scan as one flat list.
function renderColumnPickerBody(el){
  if(!el) return;
  const groups = [];
  LB_COLUMN_DEFS.forEach(c => { if(!groups.includes(c.group)) groups.push(c.group); });
  // v443: order section -- only ever lists currently-VISIBLE columns (the
  // ones that actually appear in the table), since hidden columns have
  // nothing to reorder. Address isn't in this list -- it's the locked,
  // always-first column, never part of LB_COLUMN_DEFS/lbColumnOrder.
  const orderedVisible = lbOrderedActiveCols();
  const orderHtml = `
    <div style="margin-bottom:14px; padding-bottom:14px; border-bottom:1px solid var(--border);">
      <div style="font-size:10px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;">Column order (Address is always first)</div>
      ${orderedVisible.length ? `<div style="display:flex; flex-direction:column; gap:4px; max-width:360px;">
        ${orderedVisible.map((c, i) => `
          <div style="display:flex; align-items:center; justify-content:space-between; gap:8px; padding:4px 8px; background:var(--card); border-radius:6px; font-size:12px; color:var(--text);">
            <span>${escapeHtml(c.label)}</span>
            <span style="display:flex; gap:4px;">
              <button type="button" class="btn-secondary lb-col-order-up" data-key="${c.key}" ${i === 0 ? 'disabled' : ''} title="Move up" style="width:auto; padding:1px 8px; font-size:11px;">&uarr;</button>
              <button type="button" class="btn-secondary lb-col-order-down" data-key="${c.key}" ${i === orderedVisible.length - 1 ? 'disabled' : ''} title="Move down" style="width:auto; padding:1px 8px; font-size:11px;">&darr;</button>
            </span>
          </div>
        `).join('')}
      </div>` : `<div style="font-size:11px; color:var(--text-dim);">No optional columns visible yet — check some below.</div>`}
    </div>`;
  el.innerHTML = orderHtml + groups.map(group => `
    <div style="margin-bottom:12px;">
      <div style="font-size:10px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;">${escapeHtml(group)}</div>
      <div style="display:flex; flex-wrap:wrap; gap:12px;">
        ${LB_COLUMN_DEFS.filter(c => c.group === group).map(c => `
          <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-size:12px; color:var(--text);">
            <input type="checkbox" class="lb-col-cb" value="${c.key}" ${lbVisibleColumns.has(c.key) ? 'checked' : ''} style="width:13px; height:13px; accent-color:var(--focus);"> ${escapeHtml(c.label)}
          </label>
        `).join('')}
      </div>
    </div>
  `).join('');
  el.querySelectorAll('.lb-col-cb').forEach(cb => {
    cb.addEventListener('change', () => {
      if(cb.checked) lbVisibleColumns.add(cb.value); else lbVisibleColumns.delete(cb.value);
      lbOnVisibleColumnsChanged();
    });
  });
  el.querySelectorAll('.lb-col-order-up').forEach(btn => btn.addEventListener('click', () => lbMoveColumn(btn.dataset.key, -1)));
  el.querySelectorAll('.lb-col-order-down').forEach(btn => btn.addEventListener('click', () => lbMoveColumn(btn.dataset.key, 1)));
}
// Fired on every selection change, from either panel -- keeps both picker
// panels' checkboxes and both results tables in sync with the one shared
// set, and persists it. $(id) is always truthy here (these elements exist
// in static HTML, just hidden when their panel/modal is closed) -- cheap
// enough to re-render both unconditionally rather than tracking which one
// is currently visible.
function lbOnVisibleColumnsChanged(){
  saveLbVisibleColumns();
  renderColumnPickerBody($('lbColumnPickerBody'));
  renderColumnPickerBody($('lbmColumnPickerBody'));
  if($('lbResultsHead')) renderListBuilderResults(lbLastTotal);
  if($('lbmResultsHead')) renderMatchResults();
}
function lbWireColumnPickerButtons(btnId, panelId, bodyId, selectAllId, defaultsId, noneId){
  $(btnId)?.addEventListener('click', () => {
    const panel = $(panelId);
    if(!panel) return;
    const showing = panel.style.display !== 'none';
    panel.style.display = showing ? 'none' : 'block';
    if(!showing) renderColumnPickerBody($(bodyId));
  });
  $(selectAllId)?.addEventListener('click', () => { lbVisibleColumns = new Set(LB_COLUMN_DEFS.map(c => c.key)); lbOnVisibleColumnsChanged(); });
  // v443: Defaults resets order too, not just visibility -- "back to how
  // it started" should mean both, not leave a stale custom order behind.
  $(defaultsId)?.addEventListener('click', () => { lbVisibleColumns = new Set(lbDefaultColumnKeys()); lbColumnOrder = LB_COLUMN_DEFS.map(c => c.key); saveLbColumnOrder(); lbOnVisibleColumnsChanged(); });
  $(noneId)?.addEventListener('click', () => { lbVisibleColumns = new Set(); lbOnVisibleColumnsChanged(); });
}
lbWireColumnPickerButtons('lbColumnsBtn', 'lbColumnPickerPanel', 'lbColumnPickerBody', 'lbColumnsSelectAllBtn', 'lbColumnsDefaultsBtn', 'lbColumnsNoneBtn');
lbWireColumnPickerButtons('lbmColumnsBtn', 'lbmColumnPickerPanel', 'lbmColumnPickerBody', 'lbmColumnsSelectAllBtn', 'lbmColumnsDefaultsBtn', 'lbmColumnsNoneBtn');

function renderListBuilderResults(total){
  $('lbResultCount').textContent = String(total);
  const body = $('lbResultsBody');
  $('lbResultsEmpty').style.display = lbResultRows.length ? 'none' : 'block';
  // v438: thead is built here now, not static HTML -- Address is always
  // first (locked, per the column picker's own copy), followed by whatever
  // the picker currently has checked, in LB_COLUMN_DEFS' fixed order.
  // v442: sortable headers (LB_SORTABLE_KEYS) get a data-sort-key + pointer
  // cursor + ▲/▼ indicator on whichever one is currently active -- click
  // handling is a single delegated listener on lbResultsHead, below.
  const activeCols = lbOrderedActiveCols(); // v443: reflects the column picker's own reorder controls, not just LB_COLUMN_DEFS' fixed order
  const head = $('lbResultsHead');
  if(head){
    const addressTh = `<th class="lb-sort-th" data-sort-key="address_line1" style="cursor:pointer;">Address${lbSortIndicator('address_line1')}</th>`;
    const colTh = activeCols.map(c => c.sortable
      ? `<th class="lb-sort-th" data-sort-key="${c.key}" style="cursor:pointer;">${escapeHtml(c.label)}${lbSortIndicator(c.key)}</th>`
      : `<th>${escapeHtml(c.label)}</th>`
    ).join('');
    head.innerHTML = `<tr><th style="width:30px;"><input type="checkbox" id="lbSelectAllCb" style="width:13px; height:13px; accent-color:var(--focus);"></th>${addressTh}${colTh}</tr>`;
  }
  body.innerHTML = lbResultRows.map(r => `
    <tr>
      <td><input type="checkbox" class="lb-row-cb" data-id="${r.id}" style="width:13px; height:13px; accent-color:var(--focus);"></td>
      <td>${escapeHtml(r.address_line1 || '—')}</td>
      ${activeCols.map(c => {
        const raw = c.get(r);
        const val = (raw === null || raw === undefined || raw === '') ? '—' : String(raw);
        return `<td${c.mono ? ' class="mono"' : ''}>${escapeHtml(val)}</td>`;
      }).join('')}
    </tr>
  `).join('');
  const selectAllCb = $('lbSelectAllCb');
  if(selectAllCb) selectAllCb.checked = false;
  // v435: total can exceed what's actually loaded/rendered here -- tell
  // staff "select all" + Export still covers everything, not just this page.
  const noteEl = $('lbMoreResultsNote');
  if(noteEl){
    noteEl.textContent = total > lbResultRows.length
      ? `Showing ${lbResultRows.length.toLocaleString()} of ${total.toLocaleString()} matching properties — check "select all" and Export to include all ${total.toLocaleString()}.`
      : '';
  }
  // v436: Task 6 -- Prev/Next page controls, separate from the note above.
  const pagerEl = $('lbPagerControls');
  if(pagerEl){
    const pageCount = Math.max(1, Math.ceil(total / LB_PAGE_SIZE));
    const pageNum = Math.floor(lbPageOffset / LB_PAGE_SIZE) + 1;
    pagerEl.style.display = total > LB_PAGE_SIZE ? 'flex' : 'none';
    $('lbPageIndicator').textContent = `Page ${pageNum} of ${pageCount}`;
    $('lbPrevPageBtn').disabled = lbPageOffset <= 0;
    $('lbNextPageBtn').disabled = lbPageOffset + LB_PAGE_SIZE >= total;
  }
}
renderListBuilderResults(0); // pre-populate the header (incl. Select-all checkbox) before any search runs
// v438: lbSelectAllCb is now built dynamically inside lbResultsHead (it no
// longer exists in static HTML at page-load time), so this listens on the
// stable thead container instead of the checkbox itself -- event
// delegation, same reasoning as any other "element gets rebuilt on every
// render" listener in this file.
$('lbResultsHead')?.addEventListener('change', (e) => {
  if(e.target && e.target.id === 'lbSelectAllCb'){
    document.querySelectorAll('.lb-row-cb').forEach(cb => { cb.checked = e.target.checked; });
  }
});
// v442: click-to-sort -- same delegation reasoning as the change listener
// above (the header row is rebuilt on every render).
$('lbResultsHead')?.addEventListener('click', (e) => {
  const th = e.target.closest('.lb-sort-th');
  if(th) lbHandleSortClick(th.dataset.sortKey);
});
$('lbSearchBtn').addEventListener('click', runListBuilderSearch);
$('lbPrevPageBtn')?.addEventListener('click', () => lbFetchPage(Math.max(0, lbPageOffset - LB_PAGE_SIZE)));
$('lbNextPageBtn')?.addEventListener('click', () => lbFetchPage(lbPageOffset + LB_PAGE_SIZE));

// v436: Task 6 -- Save current filters / Load saved filter. `filters` is
// stored server-side as opaque JSON (list_builder_saved_filters.filters),
// so lbCollectFilterParams()'s shape is passed straight through with no
// server-side schema to keep in sync.
let lbSavedFilters = [];
async function loadListBuilderSavedFilters(){
  const result = await listBuilderCall({ action: 'list_saved_filters' });
  const sel = $('lbSavedFilterSelect');
  if(!sel) return;
  if(!result.ok){ console.error('Failed to load saved filters', result.error); return; }
  lbSavedFilters = result.savedFilters || [];
  const prev = sel.value;
  sel.innerHTML = '<option value="">Load a saved filter…</option>' + lbSavedFilters.map(f => `<option value="${escapeHtml(f.id)}">${escapeHtml(f.name)}</option>`).join('');
  if(lbSavedFilters.some(f => f.id === prev)) sel.value = prev;
}
$('lbSavedFilterSelect')?.addEventListener('change', () => {
  const id = $('lbSavedFilterSelect').value;
  if(!id) return;
  const found = lbSavedFilters.find(f => f.id === id);
  if(found) lbApplyFilterParams(found.filters);
});
$('lbSaveFilterBtn')?.addEventListener('click', async () => {
  const name = prompt('Name this filter (e.g. "Cook absentee tired landlords"):');
  if(!name || !name.trim()) return;
  const btn = $('lbSaveFilterBtn');
  btn.disabled = true;
  const result = await listBuilderCall({ action: 'save_filter', name: name.trim(), filters: lbCollectFilterParams() });
  btn.disabled = false;
  if(!result.ok){ alert(result.error || 'Failed to save filter'); return; }
  await loadListBuilderSavedFilters();
});
$('lbDeleteFilterBtn')?.addEventListener('click', async () => {
  const id = $('lbSavedFilterSelect')?.value;
  if(!id) { alert('Select a saved filter to delete first.'); return; }
  const found = lbSavedFilters.find(f => f.id === id);
  if(!confirm(`Delete saved filter "${found ? found.name : id}"? This can't be undone.`)) return;
  const result = await listBuilderCall({ action: 'delete_saved_filter', id });
  if(!result.ok){ alert(result.error || 'Failed to delete filter'); return; }
  await loadListBuilderSavedFilters();
});
// v448: rename in place -- keeps the same id/created_at/filters, only the
// label changes. Re-selects the renamed filter afterward (loadListBuilder
// SavedFilters rebuilds the <option> list from scratch, which would
// otherwise silently drop back to "Load a saved filter…").
$('lbRenameFilterBtn')?.addEventListener('click', async () => {
  const id = $('lbSavedFilterSelect')?.value;
  if(!id) { alert('Select a saved filter to rename first.'); return; }
  const found = lbSavedFilters.find(f => f.id === id);
  const name = prompt('New name for this saved filter:', found ? found.name : '');
  if(!name || !name.trim()) return;
  const btn = $('lbRenameFilterBtn');
  btn.disabled = true;
  const result = await listBuilderCall({ action: 'rename_saved_filter', id, name: name.trim() });
  btn.disabled = false;
  if(!result.ok){ alert(result.error || 'Failed to rename filter'); return; }
  await loadListBuilderSavedFilters();
  $('lbSavedFilterSelect').value = id;
});

// v442: bulk "exclude from future exports" -- a reversible flag
// (properties.is_excluded/excluded_at), not a delete, so bad/duplicate/test
// rows can be hidden from search/match_order/CSV exports without
// destroying county-sourced data that would just get re-synced anyway.
// Deliberately scoped to whatever's checked on the CURRENT loaded page
// (unlike lbExportBtn's own "select all -> page through every matching
// row" loop below) -- excluding is more consequential to do by accident at
// scale than exporting is, so this doesn't offer a "select all N,000
// matching" shortcut.
async function lbBulkSetExcluded(excluded){
  const ids = Array.from(document.querySelectorAll('.lb-row-cb:checked')).map(cb => cb.dataset.id);
  if(!ids.length){ alert('Select at least one row first.'); return; }
  const verb = excluded ? 'Exclude' : 'Un-exclude';
  if(!confirm(`${verb} ${ids.length} propert${ids.length === 1 ? 'y' : 'ies'} ${excluded ? 'from' : 'back into'} future exports?`)) return;
  const btn = excluded ? $('lbExcludeBtn') : $('lbUnexcludeBtn');
  btn.disabled = true;
  const result = await listBuilderCall({ action: 'set_excluded', propertyIds: ids, excluded });
  btn.disabled = false;
  if(!result.ok){ alert(result.error || `Failed to ${verb.toLowerCase()} selected properties`); return; }
  logActivity(`list_builder.${excluded ? 'exclude' : 'unexclude'}_properties`, 'properties', null, `${verb}d ${ids.length} propert${ids.length === 1 ? 'y' : 'ies'} ${excluded ? 'from' : 'back into'} future exports`);
  // Re-run the current page so the table reflects the change right away --
  // e.g. excluding a row while not in "Show excluded only" mode should
  // make it disappear from view immediately, not just on the next
  // unrelated refresh.
  await lbFetchPage(lbPageOffset);
}
$('lbExcludeBtn')?.addEventListener('click', () => lbBulkSetExcluded(true));
$('lbUnexcludeBtn')?.addEventListener('click', () => lbBulkSetExcluded(false));

// v435: export used to be silently capped at whatever fit in one page (500,
// then 1000) because it only ever exported rows already loaded into
// lbResultRows. Now, when "select all" is checked and more rows match than
// are loaded, it pages through the REST of the result set with the same
// filters runListBuilderSearch just used, so Export genuinely means "every
// matching property," not "every property that happened to fit on screen."
// A partial manual selection (some rows checked, "select all" off) still
// exports exactly what's checked on the loaded page, unchanged.
$('lbExportBtn').addEventListener('click', async () => {
  const allChecked = $('lbSelectAllCb').checked;
  const selectedIds = new Set(Array.from(document.querySelectorAll('.lb-row-cb:checked')).map(cb => cb.dataset.id));
  let rows;
  if(allChecked && lbLastTotal > lbResultRows.length){
    const btn = $('lbExportBtn');
    btn.disabled = true;
    const original = btn.textContent;
    const PAGE = 2000; // staff-list-builder's own per-call cap (v435)
    const allRows = lbResultRows.slice();
    let offset = allRows.length;
    try {
      while(offset < lbLastTotal){
        btn.textContent = `Fetching ${Math.min(offset + PAGE, lbLastTotal).toLocaleString()} / ${lbLastTotal.toLocaleString()}…`;
        // BUG FIX: this used to omit sortBy/sortDir entirely -- lbResultRows
        // (the first page, already in memory) was sorted however the table
        // was currently sorted, but every subsequent page fetched here fell
        // back to the backend's default order (created_at desc) instead.
        // Offset pagination is only stable under ONE fixed order, so mixing
        // two orders across the same offset range silently duplicated some
        // rows and dropped others in the stitched CSV. Matches lbFetchPage's
        // own call exactly so every page of a "select all" export agrees on
        // the same order the table itself is sorted by.
        const page = await listBuilderCall({ action: 'search', ...lbLastSearchParams, limit: PAGE, offset, sortBy: lbSortBy || undefined, sortDir: lbSortBy ? lbSortDir : undefined });
        if(!page.ok){ alert(page.error || 'Export failed while fetching the rest of the matching properties.'); btn.disabled = false; btn.textContent = original; return; }
        if(!page.rows || !page.rows.length) break; // safety: stop rather than loop forever if a page comes back empty
        allRows.push(...page.rows);
        offset += page.rows.length;
      }
    } finally {
      btn.disabled = false;
      btn.textContent = original;
    }
    rows = allRows;
  } else {
    rows = lbResultRows.filter(r => selectedIds.has(String(r.id)));
  }
  if(!rows.length){ alert('Select at least one row to export.'); return; }
  // v436: Task 7 -- now the same full column list buildAndUploadListOrderCsv
  // uses server-side (LB_FULL_CSV_HEADERS/lbFullCsvRow above), not a smaller
  // hand-written subset.
  exportCSV(
    `property-list-${new Date().toISOString().slice(0,10)}.csv`,
    LB_FULL_CSV_HEADERS,
    rows.map(lbFullCsvRow)
  );
  logActivity('list_builder.export_csv', 'properties', null, `Exported ${rows.length} propert${rows.length === 1 ? 'y' : 'ies'} as CSV`);
});

// v328: County dropdown now offers Cook and DuPage -- each maps to its own
// bridge action/param name (Cook takes "township", DuPage takes
// "municipality", same idea different label) rather than a one-size input.
const LB_SYNC_COUNTY_META = {
  cook: { action: 'sync_cook_county', param: 'township', label: 'Township (optional)', placeholder: 'e.g. Evanston — blank = county-wide', countyName: 'Cook County' },
  dupage: { action: 'sync_dupage_county', param: 'municipality', label: 'Municipality (optional)', placeholder: 'e.g. Wheaton — blank = county-wide', countyName: 'DuPage County' },
};
$('lbSyncCounty').addEventListener('change', () => {
  const meta = LB_SYNC_COUNTY_META[$('lbSyncCounty').value] || LB_SYNC_COUNTY_META.cook;
  $('lbSyncTownshipLabel').textContent = meta.label;
  $('lbSyncTownship').placeholder = meta.placeholder;
});

$('lbSyncBtn').addEventListener('click', async () => {
  const btn = $('lbSyncBtn');
  const msg = $('lbSyncMsg');
  const meta = LB_SYNC_COUNTY_META[$('lbSyncCounty').value] || LB_SYNC_COUNTY_META.cook;
  btn.disabled = true;
  msg.textContent = 'Syncing… this can take a few seconds.';
  msg.className = 'msg';
  const result = await listBuilderCall({
    action: meta.action,
    [meta.param]: $('lbSyncTownship').value.trim() || undefined,
    limit: Number($('lbSyncLimit').value) || 500,
    residentialOnly: $('lbSyncResidentialOnly').checked,
  });
  btn.disabled = false;
  if(!result.ok){
    msg.textContent = result.error || 'Sync failed';
    msg.className = 'msg error';
    return;
  }
  msg.textContent = `Fetched ${result.fetched}, upserted ${result.upserted}${result.dedupedAsSharedAddress ? ` (${result.dedupedAsSharedAddress} shared a building address with another parcel)` : ''} — ${result.absenteeCount} flagged absentee.`;
  msg.className = 'msg ok';
  logActivity(`list_builder.${meta.action}`, 'properties', null, `Synced ${meta.countyName} data: ${result.upserted} upserted, ${result.absenteeCount} absentee`);
  lbFacetsLoadPromise = null; // invalidate the cache -- this sync may have added new townships/counties
  await loadListBuilderFacets();
});

// ---------- v329: "Match in List Builder" -- shared between Data Orders
// and Buy-a-List. Opened via any .lbm-open-btn (data-order-type,
// data-order-id); runs staff-list-builder's match_order action and shows
// the same checkbox/export shape List Builder's own results table uses.
// Export both downloads the CSV locally AND calls record_delivery so the
// order is marked fulfilled and these properties never get re-suggested
// to the same client -- see that action's own header comment for why
// export IS the delivery/fulfillment step here, not a separate click. ----
let lbmOrderType = null;
let lbmOrderId = null;
let lbmResultRows = [];
// v448: sort/pagination -- match_order already returns its full, capped
// (<=2000-row) set in one shot, so this is client-side over the already-
// loaded lbmResultRows, not a server round trip (unlike List Builder's own
// sort/page, which re-queries because it's paging through millions of
// rows it hasn't all loaded). lbmDeselectedIds tracks ids the user has
// explicitly unchecked -- rows start selected by default (export = mark
// delivered, so "everything unless you opt out" is the existing, preserved
// default), and this set is what survives a page change, not the DOM
// checkboxes (which only exist for the current page once pagination is in
// play).
let lbmSortKey = null;
let lbmSortDir = 'asc';
let lbmPageOffset = 0;
const LBM_PAGE_SIZE = 200;
let lbmDeselectedIds = new Set();
// Same sortable column set as List Builder's own LB_SORTABLE_KEYS
// (server-side allowlist) -- kept as raw accessors here rather than
// reusing LB_COLUMN_DEFS' own `.get()` because a few of those (e.g.
// created_at) return an already-formatted display string, which would
// sort lexicographically wrong (dates in particular). is_absentee_owner
// coerced to 0/1 for the same reason -- LB_COLUMN_DEFS' get() returns
// "Yes"/"No" for display.
const LBM_SORT_ACCESSORS = {
  address_line1: r => r.address_line1,
  city: r => r.city,
  state: r => r.state,
  zip: r => r.zip,
  county: r => r.county,
  owner_name: r => r.owner_name,
  owner_last_name: r => r.owner_last_name,
  is_absentee_owner: r => r.is_absentee_owner ? 1 : 0,
  owner_portfolio_size: r => r.owner_portfolio_size,
  assessed_value: r => r.assessed_value,
  last_sale_date: r => r.last_sale_date,
  year_built: r => r.year_built,
};
function lbmSortIndicator(key){
  if(lbmSortKey !== key) return '';
  return lbmSortDir === 'asc' ? ' &#9650;' : ' &#9660;';
}
function lbmHandleSortClick(key){
  if(!LBM_SORT_ACCESSORS[key]) return;
  if(lbmSortKey === key) lbmSortDir = (lbmSortDir === 'asc') ? 'desc' : 'asc';
  else { lbmSortKey = key; lbmSortDir = 'asc'; }
  lbmPageOffset = 0;
  renderMatchResults();
}
function lbmSortedRows(){
  if(!lbmSortKey) return lbmResultRows;
  const get = LBM_SORT_ACCESSORS[lbmSortKey];
  const dir = lbmSortDir === 'asc' ? 1 : -1;
  // Copy -- don't mutate lbmResultRows itself (Export/CSV logic elsewhere
  // may assume its original match_order order).
  return [...lbmResultRows].sort((a, b) => {
    const av = get(a), bv = get(b);
    const aNull = av === null || av === undefined || av === '';
    const bNull = bv === null || bv === undefined || bv === '';
    // Nulls sink to the bottom regardless of direction -- same convention
    // List Builder's own server-side sort (nullsFirst:false) uses.
    if(aNull && bNull) return 0;
    if(aNull) return 1;
    if(bNull) return -1;
    if(av < bv) return -1 * dir;
    if(av > bv) return 1 * dir;
    return 0;
  });
}

function openMatchModal(orderType, orderId){
  lbmOrderType = orderType;
  lbmOrderId = orderId;
  lbmResultRows = [];
  lbmSortKey = null;
  lbmSortDir = 'asc';
  lbmPageOffset = 0;
  lbmDeselectedIds = new Set();
  $('lbmSummary').textContent = 'Searching…';
  $('lbmWarnings').innerHTML = '';
  $('lbmMsg').textContent = '';
  $('lbmMsg').className = 'msg';
  $('lbmResultsBody').innerHTML = '';
  $('lbmResultCount').textContent = '0';
  $('lbmResultsEmpty').style.display = 'none';
  // v457: reset to "let the backend decide" (blank input, box unchecked) on
  // every fresh open -- runMatchOrder() fills the input in with whatever
  // quantity actually got used once the first search comes back, so staff
  // sees a real starting number to adjust from rather than a guess.
  if($('lbmDesiredCount')) $('lbmDesiredCount').value = '';
  if($('lbmIncludeExportedCb')) $('lbmIncludeExportedCb').checked = false;
  $('lbMatchModalOverlay').classList.add('active');
  runMatchOrder();
}
// v457: desiredCount/includePreviouslyExported read fresh from the modal's
// own inputs each call -- lets "Re-match" (and the very first automatic
// search from openMatchModal, where both are still at their reset default)
// share one code path instead of needing a separate "first search" variant.
//
// v464: "extract as many records as I need, same as List Builder" -- when
// staff type a Number of records bigger than one match_order call safely
// returns (2000, same cap List Builder's own search already used), this
// now pages through match_order via its `afterId` keyset cursor (see that
// action's own comment for why a cursor, not `offset`) until either the
// requested total is assembled or the server says there's nothing left to
// fetch -- the same "assemble more than one page's worth automatically"
// idea as lbExportBtn's own offset-paging loop, just keyed differently.
// Leaving the input blank keeps the exact original single-call behavior
// (match_order picks its own default, capped at 2000, no pagination).
// BUG FIX: same class of race lbFetchPage's own lbFetchSeq fixes -- Re-match
// fires this again while a previous (possibly multi-page) run is still in
// flight, and with no guard, whichever run's LAST page happened to resolve
// last won, regardless of which button click was more recent. `lbmMatchSeq`
// lets only the most recently STARTED run finish updating lbmResultRows/the
// summary; an older run notices it's been superseded and stops paging.
let lbmMatchSeq = 0;
async function runMatchOrder(){
  const seq = ++lbmMatchSeq;
  const desiredCountRaw = $('lbmDesiredCount') ? $('lbmDesiredCount').value : '';
  const desiredCountInput = desiredCountRaw ? Number(desiredCountRaw) : null;
  const includePreviouslyExported = $('lbmIncludeExportedCb') ? $('lbmIncludeExportedCb').checked : false;
  const MATCH_PAGE_CAP = 2000; // staff-list-builder's own per-call safety cap
  $('lbmSummary').textContent = 'Searching…';
  $('lbmWarnings').innerHTML = '';

  let allRows = [];
  let afterId = null;
  let firstResult = null;
  let pageNum = 0;
  while(true){
    pageNum++;
    const remaining = desiredCountInput ? (desiredCountInput - allRows.length) : MATCH_PAGE_CAP;
    if(remaining <= 0) break;
    const pageSize = Math.min(MATCH_PAGE_CAP, remaining);
    if(pageNum > 1){
      const soFar = Math.min(allRows.length + pageSize, desiredCountInput);
      $('lbmSummary').textContent = `Fetching ${soFar.toLocaleString()} / ${desiredCountInput.toLocaleString()}…`;
    }
    const result = await listBuilderCall({ action: 'match_order', orderType: lbmOrderType, orderId: lbmOrderId, desiredCount: pageSize, includePreviouslyExported, afterId });
    if(seq !== lbmMatchSeq) return; // a newer Re-match superseded this run mid-page
    if(!result.ok){
      $('lbmSummary').textContent = 'Search failed.';
      $('lbmWarnings').innerHTML = `<div class="msg error">${escapeHtml(result.error || 'Unknown error')}</div>`;
      return;
    }
    if(pageNum === 1) firstResult = result;
    allRows.push(...(result.rows || []));
    afterId = result.nextAfterId;
    // Stop once: no explicit total was requested (single-page default,
    // unchanged from before this round), the requested total is reached,
    // or the server has nothing left to fetch.
    if(!desiredCountInput || allRows.length >= desiredCountInput || !result.hasMore || !afterId) break;
  }

  lbmResultRows = allRows;
  const c = firstResult.criteria || {};
  // Reflects what was actually requested this round -- the explicit total
  // if staff typed one, otherwise match_order's own auto-derived default
  // (same fallback as before pagination existed).
  if($('lbmDesiredCount')) $('lbmDesiredCount').value = desiredCountInput || c.quantity || '';
  const criteriaParts = [];
  if(c.states && c.states.length) criteriaParts.push(`State: ${c.states.join(', ')}`);
  if(c.counties && c.counties.length) criteriaParts.push(`County: ${c.counties.join(', ')}`);
  if(c.cities && c.cities.length) criteriaParts.push(`City: ${c.cities.join(', ')}`);
  if(c.absenteeOnly) criteriaParts.push('Absentee owners only');
  // v436: these six were silently dropped even though parseOrderFilters()
  // (server-side) actually applies them -- a client order that auto-matched
  // on e.g. "tired landlord" or "probate" showed staff a summary that never
  // mentioned it. See DATASCIENCETABBUILDBRIEF.md Task 2.
  if(c.tiredLandlordOnly) criteriaParts.push('Tired landlord (3+ properties)');
  if(c.corporateOwnerOnly) criteriaParts.push('Corporate/entity owner');
  if(c.longTermOwnerOnly) criteriaParts.push('Long-term owner (10+ years)');
  if(c.isProbateEstateOnly) criteriaParts.push('Probate/estate-held');
  if(c.hasBuildingCodeLawsuitOnly) criteriaParts.push('Building code lawsuit');
  if(c.isVacantBuildingOnly) criteriaParts.push('Vacant building');
  if(c.isPreforeclosureOnly) criteriaParts.push('Pre-foreclosure');
  criteriaParts.push(`Target: ${desiredCountInput || c.quantity || lbmResultRows.length}`);
  $('lbmSummary').textContent = criteriaParts.length ? `Searched by — ${criteriaParts.join(' · ')}` : 'No filters could be parsed from this request — showing recent properties.';
  // v464: structural warnings (state parsing, unsupported lead types,
  // dropped location tokens, "requested X capped at Y") describe the ORDER
  // itself, not any one page's fetch -- taken from the first page only, so
  // paging doesn't repeat them once per page. The "no matching"/"only X of
  // Y" messages, though, DID depend on a single page's own quantity --
  // replaced with one summary reflecting what was actually assembled
  // across every page fetched this round. The delivered/previously-
  // exported note is re-surfaced once from the first page rather than once
  // per page (the underlying delivered-properties set doesn't meaningfully
  // change mid-session).
  const structuralWarnings = (firstResult.warnings || []).filter(w =>
    !w.startsWith('Only ') && !w.startsWith('No matching properties') && !/already (delivered|exported)/.test(w)
  );
  const finalWarnings = structuralWarnings.slice();
  const deliveredNote = (firstResult.warnings || []).find(w => /already (delivered|exported)/.test(w));
  if(deliveredNote) finalWarnings.push(deliveredNote);
  if(!allRows.length){
    finalWarnings.push('No matching properties in List Builder\'s current data. Try syncing more data for this area, or search manually.');
  } else if(desiredCountInput && allRows.length < desiredCountInput){
    finalWarnings.push(`Only ${allRows.length.toLocaleString()} of the ${desiredCountInput.toLocaleString()} requested properties matched the current filters — that's all the matching data List Builder has for this area right now. Try syncing more data, or widening the location/criteria.`);
  }
  $('lbmWarnings').innerHTML = finalWarnings.map(w => `<div class="msg" style="color:var(--away);">${escapeHtml(w)}</div>`).join('');
  renderMatchResults();
}
if($('lbmRematchBtn')) $('lbmRematchBtn').addEventListener('click', runMatchOrder);
// v439: thead built here now (not static HTML), same "Address locked +
// whatever's checked in lbVisibleColumns, in LB_COLUMN_DEFS order" shape
// List Builder's own renderListBuilderResults uses -- shares the exact
// same column set/definitions rather than a separate, narrower fixed list.
// v448: now sorts + paginates -- see lbmSortedRows()/the state block above
// for why this is all client-side. Renders one LBM_PAGE_SIZE-row slice at
// a time; "Selected" state (lbmDeselectedIds) is tracked independently of
// what's currently in the DOM so Export still covers every page, not just
// the one on screen.
// v457: "day-month-year" (e.g. "20-8-2026", no leading zeros) -- matches how
// this project's own staff write dates elsewhere, not ISO/US order.
function lbmFormatExportDate(iso){
  if(!iso) return '';
  const d = new Date(iso);
  if(isNaN(d.getTime())) return '';
  return `${d.getDate()}-${d.getMonth() + 1}-${d.getFullYear()}`;
}
function renderMatchResults(){
  const sorted = lbmSortedRows();
  const total = sorted.length;
  $('lbmResultCount').textContent = String(total);
  const body = $('lbmResultsBody');
  $('lbmResultsEmpty').style.display = total ? 'none' : 'block';
  const activeCols = lbOrderedActiveCols(); // v443: reflects the column picker's own reorder controls, not just LB_COLUMN_DEFS' fixed order
  const pageRows = sorted.slice(lbmPageOffset, lbmPageOffset + LBM_PAGE_SIZE);
  // v457: only shown when "Include previously exported" actually surfaced
  // reused rows this search -- match_order tags each one with
  // previouslyExportedAt (the date it was first delivered to this client);
  // absent entirely, same as today, when the toggle is off.
  const hasExportedTags = sorted.some(r => r.previouslyExportedAt);
  const head = $('lbmResultsHead');
  if(head){
    const addressTh = `<th class="lbm-sort-th" data-sort-key="address_line1" style="cursor:pointer;">Address${lbmSortIndicator('address_line1')}</th>`;
    const exportedTh = hasExportedTags ? '<th>Exported</th>' : '';
    const colTh = activeCols.map(c => LBM_SORT_ACCESSORS[c.key]
      ? `<th class="lbm-sort-th" data-sort-key="${c.key}" style="cursor:pointer;">${escapeHtml(c.label)}${lbmSortIndicator(c.key)}</th>`
      : `<th>${escapeHtml(c.label)}</th>`
    ).join('');
    head.innerHTML = `<tr><th style="width:30px;"><input type="checkbox" id="lbmSelectAllCb" style="width:13px; height:13px; accent-color:var(--focus);"></th>${addressTh}${exportedTh}${colTh}</tr>`;
  }
  body.innerHTML = pageRows.map(r => `
    <tr>
      <td><input type="checkbox" class="lbm-row-cb" data-id="${r.id}" ${lbmDeselectedIds.has(String(r.id)) ? '' : 'checked'} style="width:13px; height:13px; accent-color:var(--focus);"></td>
      <td>${escapeHtml(r.address_line1 || '—')}</td>
      ${hasExportedTags ? `<td>${r.previouslyExportedAt ? `<span style="color:var(--away); font-size:10px; font-weight:600; white-space:nowrap;">Exported: ${escapeHtml(lbmFormatExportDate(r.previouslyExportedAt))}</span>` : '—'}</td>` : ''}
      ${activeCols.map(c => {
        const raw = c.get(r);
        const val = (raw === null || raw === undefined || raw === '') ? '—' : String(raw);
        return `<td${c.mono ? ' class="mono"' : ''}>${escapeHtml(val)}</td>`;
      }).join('')}
    </tr>
  `).join('');
  // Match modal rows start pre-selected since exporting here also marks
  // them delivered/fulfilled -- unlike List Builder's own table, where rows
  // start unchecked. Preserved unchanged; select-all now reflects only the
  // current page's own selection state (whether every row on THIS page is
  // selected), while toggling it applies to every row in the full result
  // set -- see the change listener below.
  const selectAllCb = $('lbmSelectAllCb');
  if(selectAllCb) selectAllCb.checked = pageRows.length > 0 && pageRows.every(r => !lbmDeselectedIds.has(String(r.id)));
  const pager = $('lbmPagerControls');
  if(pager){
    pager.style.display = total > LBM_PAGE_SIZE ? 'flex' : 'none';
    const indicator = $('lbmPageIndicator');
    if(indicator) indicator.textContent = total ? `${(lbmPageOffset + 1).toLocaleString()}–${Math.min(lbmPageOffset + LBM_PAGE_SIZE, total).toLocaleString()} of ${total.toLocaleString()}` : '';
    const prevBtn = $('lbmPrevPageBtn'); if(prevBtn) prevBtn.disabled = lbmPageOffset <= 0;
    const nextBtn = $('lbmNextPageBtn'); if(nextBtn) nextBtn.disabled = lbmPageOffset + LBM_PAGE_SIZE >= total;
  }
}
// v439: lbmSelectAllCb is now built dynamically inside lbmResultsHead, same
// reasoning as lbResultsHead's own delegation switch in v438.
// v448: toggling it now applies to the FULL result set (every page), not
// just what's currently rendered -- matches the existing "everything
// selected by default, opt out individual rows" model rather than
// introducing a separate page-scoped selection concept.
$('lbmResultsHead')?.addEventListener('change', (e) => {
  if(e.target && e.target.id === 'lbmSelectAllCb'){
    if(e.target.checked) lbmDeselectedIds.clear();
    else lbmResultRows.forEach(r => lbmDeselectedIds.add(String(r.id)));
    renderMatchResults();
  }
});
// v448: click-to-sort -- delegated on the (rebuilt-every-render) thead,
// same pattern List Builder's own lbResultsHead click listener uses.
$('lbmResultsHead')?.addEventListener('click', (e) => {
  const th = e.target.closest('.lbm-sort-th');
  if(th) lbmHandleSortClick(th.dataset.sortKey);
});
// v448: per-row checkbox toggles update lbmDeselectedIds directly (not a
// full renderMatchResults() call, to avoid losing scroll position on every
// single click) -- keeps Export's source of truth correct even without a
// page change, and keeps the select-all checkbox's own state in sync with
// just the current page's rows.
$('lbmResultsBody')?.addEventListener('change', (e) => {
  const cb = e.target.closest('.lbm-row-cb');
  if(!cb) return;
  const id = cb.dataset.id;
  if(cb.checked) lbmDeselectedIds.delete(id); else lbmDeselectedIds.add(id);
  const selectAllCb = $('lbmSelectAllCb');
  if(selectAllCb){
    const pageIds = Array.from(document.querySelectorAll('.lbm-row-cb')).map(el => el.dataset.id);
    selectAllCb.checked = pageIds.every(pid => !lbmDeselectedIds.has(pid));
  }
});
$('lbmPrevPageBtn')?.addEventListener('click', () => { lbmPageOffset = Math.max(0, lbmPageOffset - LBM_PAGE_SIZE); renderMatchResults(); });
$('lbmNextPageBtn')?.addEventListener('click', () => { lbmPageOffset += LBM_PAGE_SIZE; renderMatchResults(); });
$('lbmCloseBtn').addEventListener('click', () => { $('lbMatchModalOverlay').classList.remove('active'); });
$('lbMatchModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'lbMatchModalOverlay') $('lbMatchModalOverlay').classList.remove('active'); });
document.addEventListener('click', (e) => {
  const btn = e.target.closest('.lbm-open-btn');
  if(!btn) return;
  openMatchModal(btn.dataset.orderType, btn.dataset.orderId);
});

$('lbmExportBtn').addEventListener('click', async () => {
  // v448: reads lbmDeselectedIds (covers every page), not just the
  // checkboxes currently in the DOM -- now that results paginate, only the
  // active page's checkboxes exist at all, so scanning the DOM here would
  // have silently dropped every selected row not on the current page.
  const rows = lbmResultRows.filter(r => !lbmDeselectedIds.has(String(r.id)));
  if(!rows.length){ alert('Select at least one row.'); return; }
  const btn = $('lbmExportBtn');
  btn.disabled = true;
  const msg = $('lbmMsg');
  msg.textContent = 'Recording delivery…';
  msg.className = 'msg';
  // v436: Task 7 -- same full column list as List Builder's own export and
  // buildAndUploadListOrderCsv's server-side export, not this modal's own
  // smaller hand-written subset.
  exportCSV(
    `${lbmOrderType}-match-${new Date().toISOString().slice(0,10)}.csv`,
    LB_FULL_CSV_HEADERS,
    rows.map(lbFullCsvRow)
  );
  const result = await listBuilderCall({ action: 'record_delivery', orderType: lbmOrderType, orderId: lbmOrderId, propertyIds: rows.map(r => r.id) });
  btn.disabled = false;
  if(!result.ok){
    msg.textContent = 'CSV downloaded, but recording delivery failed: ' + (result.error || 'unknown error');
    msg.className = 'msg error';
    return;
  }
  msg.textContent = result.warning || `Marked ${rows.length} propert${rows.length === 1 ? 'y' : 'ies'} delivered and the order fulfilled.`;
  msg.className = result.warning ? 'msg error' : 'msg ok';
  logActivity(`${lbmOrderType}.list_builder_match_delivered`, lbmOrderType, lbmOrderId, `Delivered ${rows.length} propert${rows.length === 1 ? 'y' : 'ies'} via List Builder match`);
  if(lbmOrderType === 'data_order') await loadDataOrders();
  else await loadCsubListOrders();
});

// ---------- Data Orders (v327) ----------
// Client data-order requests, ingested in real time by client-data-order-
// webhook from the Google Form (see the delivered .gs Apps Script trigger)
// -- replaces manually checking Data_Order_Responses.xlsx.
let dataOrdersCache = [];
const DATA_ORDER_STATUSES = ['pending', 'in_progress', 'fulfilled', 'cancelled'];
// v444: search/filter/sort -- entirely client-side over dataOrdersCache.
// loadDataOrders already pulls up to 1000 rows in one shot via a direct
// RLS read (no Edge Function, no server-side pagination involved) -- since
// the full set is already in memory, filtering/sorting it in JS is enough;
// no backend change needed for this round.
let doSearchQuery = '';
let doStatusFilterValue = '';
let doSortKey = 'submitted_at';
let doSortDir = 'desc';
(function initDataOrdersFilterUI(){
  const sel = $('doStatusFilter');
  if(sel) sel.innerHTML = '<option value="">Any</option>' + DATA_ORDER_STATUSES.map(s => `<option value="${s}">${s.replace('_', ' ')}</option>`).join('');
})();
async function loadDataOrders(){
  const body = $('doOrdersBody');
  if(body && !dataOrdersCache.length) body.innerHTML = '<tr><td colspan="15" class="empty">Loading…</td></tr>';
  const { data, error } = await sb.from('client_data_orders')
    .select('id, submitted_at, full_name, email, phone, quantity_requested, targeted_states, targeted_counties, targeted_cities, lead_type, property_type, price_restrictions, preferred_equity_pct, more_details, amount, order_status')
    .order('submitted_at', { ascending: false })
    .limit(1000);
  if(error){ if(body) body.innerHTML = `<tr><td colspan="15" class="empty">${escapeHtml(error.message)}</td></tr>`; return; }
  dataOrdersCache = data || [];
  renderDataOrdersTable();
}
// Free-text search matches across every field staff would actually search
// by -- name/email/phone plus every location/lead-type/notes field, not
// just the columns visually up front. Case-insensitive substring match,
// same as every other simple text filter in this file.
function doMatchesSearch(o, q){
  if(!q) return true;
  const haystack = [o.full_name, o.email, o.phone, o.targeted_states, o.targeted_counties, o.targeted_cities, o.lead_type, o.property_type, o.price_restrictions, o.more_details]
    .map(v => (v || '').toString().toLowerCase()).join(' ');
  return haystack.includes(q);
}
function doSortCompare(a, b){
  let av = a[doSortKey], bv = b[doSortKey];
  if(doSortKey === 'amount'){ av = Number(av) || 0; bv = Number(bv) || 0; }
  else { av = av == null ? '' : String(av); bv = bv == null ? '' : String(bv); }
  if(av < bv) return doSortDir === 'asc' ? -1 : 1;
  if(av > bv) return doSortDir === 'asc' ? 1 : -1;
  return 0;
}
function renderDataOrdersHead(){
  const head = $('doOrdersHead');
  if(!head) return;
  const sortTh = (key, label) => {
    const indicator = doSortKey === key ? (doSortDir === 'asc' ? ' &#9650;' : ' &#9660;') : '';
    return `<th class="do-sort-th" data-sort-key="${key}" style="cursor:pointer;">${label}${indicator}</th>`;
  };
  head.innerHTML = `<tr>
    ${sortTh('submitted_at', 'Submitted')}${sortTh('full_name', 'Name')}<th>Contact</th><th>Quantity</th><th>States</th><th>Counties</th><th>Cities</th>
    ${sortTh('lead_type', 'Lead Type')}${sortTh('property_type', 'Property Type')}<th>Price Restrictions</th><th>Equity %</th><th>Notes</th>
    ${sortTh('amount', 'Amount')}${sortTh('order_status', 'Status')}<th>Match</th>
  </tr>`;
}
function renderDataOrdersTable(){
  const body = $('doOrdersBody');
  const emptyEl = $('doOrdersEmpty');
  if(!body) return;
  renderDataOrdersHead();
  const q = doSearchQuery.trim().toLowerCase();
  const filtered = dataOrdersCache
    .filter(o => doMatchesSearch(o, q) && (!doStatusFilterValue || o.order_status === doStatusFilterValue))
    .sort(doSortCompare);
  const countEl = $('doResultCount');
  if(countEl){
    countEl.textContent = (q || doStatusFilterValue)
      ? `Showing ${filtered.length.toLocaleString()} of ${dataOrdersCache.length.toLocaleString()} orders`
      : `${dataOrdersCache.length.toLocaleString()} order${dataOrdersCache.length === 1 ? '' : 's'}`;
  }
  if(!dataOrdersCache.length){
    body.innerHTML = '';
    if(emptyEl){ emptyEl.style.display = ''; emptyEl.textContent = 'No data order requests yet.'; }
    return;
  }
  if(!filtered.length){
    body.innerHTML = '';
    if(emptyEl){ emptyEl.style.display = ''; emptyEl.textContent = 'No orders match this search.'; }
    return;
  }
  if(emptyEl) emptyEl.style.display = 'none';
  const dataOrdersTz = nonAgentDisplayTz();
  body.innerHTML = filtered.map(o => `
    <tr>
      <td class="mono" style="font-size:11px; white-space:nowrap;">${o.submitted_at ? new Date(o.submitted_at).toLocaleString([], { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', ...(dataOrdersTz ? { timeZone: dataOrdersTz } : {}) }) : '—'}</td>
      <td>${escapeHtml(o.full_name || '—')}</td>
      <td style="font-size:11px;">${escapeHtml(o.email || '')}${o.email && o.phone ? '<br>' : ''}${escapeHtml(o.phone || '')}</td>
      <td>${escapeHtml(o.quantity_requested || '—')}</td>
      <td>${escapeHtml(o.targeted_states || '—')}</td>
      <td>${escapeHtml(o.targeted_counties || '—')}</td>
      <td>${escapeHtml(o.targeted_cities || '—')}</td>
      <td>${escapeHtml(o.lead_type || '—')}</td>
      <td>${escapeHtml(o.property_type || '—')}</td>
      <td style="max-width:200px; white-space:pre-wrap;">${escapeHtml(o.price_restrictions || '—')}</td>
      <td>${escapeHtml(o.preferred_equity_pct || '—')}</td>
      <td style="max-width:220px; white-space:pre-wrap;">${escapeHtml(o.more_details || '—')}</td>
      <td>${o.amount != null ? '$' + Number(o.amount).toLocaleString() : '—'}</td>
      <td><select class="do-status-select" data-order-id="${o.id}" style="font-size:11px;">
        ${DATA_ORDER_STATUSES.map(s => `<option value="${s}" ${o.order_status === s ? 'selected' : ''}>${s.replace('_', ' ')}</option>`).join('')}
      </select></td>
      <td><button class="btn-secondary lbm-open-btn owner-admin-export-only" data-order-type="data_order" data-order-id="${o.id}" style="width:auto; padding:5px 10px; font-size:10px;">Match</button></td>
    </tr>
  `).join('');
  body.querySelectorAll('.do-status-select').forEach(sel => {
    sel.addEventListener('change', () => updateDataOrderStatus(sel.dataset.orderId, sel.value));
  });
  // Match is a List Builder action -- staff-list-builder hardcodes
  // Owner/Admin regardless of tab permissions (same reason List Builder's
  // own subtab is gated that way), so hide it here the same way Export/
  // Download buttons elsewhere are hidden for other roles.
  applyOwnerAdminExportGating(body);
}
async function updateDataOrderStatus(id, status){
  const { error } = await sb.from('client_data_orders').update({ order_status: status }).eq('id', id);
  if(error){ alert('Failed to update status: ' + error.message); return; }
  const row = dataOrdersCache.find(o => o.id === id);
  if(row) row.order_status = status;
  logActivity('client_data_order.status_changed', 'client_data_order', id, `Status set to ${status}`);
  // v444: re-render so an active status filter reflects the change right
  // away -- e.g. filtering to "pending" and marking one fulfilled should
  // make it disappear from view immediately, not just on the next refresh.
  renderDataOrdersTable();
  loadOrderReadiness(true);   // v682: a closed order leaves Order readiness at once
}
$('doSearchInput')?.addEventListener('input', () => { doSearchQuery = $('doSearchInput').value; renderDataOrdersTable(); });
$('doStatusFilter')?.addEventListener('change', () => { doStatusFilterValue = $('doStatusFilter').value; renderDataOrdersTable(); });
$('doOrdersHead')?.addEventListener('click', (e) => {
  const th = e.target.closest('.do-sort-th');
  if(!th) return;
  const key = th.dataset.sortKey;
  if(doSortKey === key) doSortDir = (doSortDir === 'asc') ? 'desc' : 'asc';
  else { doSortKey = key; doSortDir = 'asc'; }
  renderDataOrdersTable();
});

// ---------- account management: create / edit / delete user, set password ----------
// All of these go through the manage-user Edge Function — the anon key
// this dashboard runs on can't create a user with a set password, change
// another user's password, or delete their auth account; that needs the
// service role key, which only lives server-side inside the function.
// See supabase/functions/manage-user/.
// v234: pulls a human-readable string out of whatever an Edge Function's
// error body actually contains — our own functions always send { error:
// "..." }, but a failure that never reaches our own code (a platform-level
// crash, or an underlying GoTrue/Postgres error surfaced with a different
// key like message/msg) can come back shaped differently. Without this,
// a body like {} (no "error" key at all) rendered as a bare, useless "{}"
// in an alert — this always falls back to something readable instead.
function extractFunctionErrorMessage(body, fallback){
  const candidate = (body && (body.error || body.message || body.msg)) || fallback;
  return (typeof candidate === 'string' && candidate) ? candidate : 'Unknown error';
}
async function invokeManageUser(payload){
  const { data, error } = await sb.functions.invoke('manage-user', { body: payload });
  if(error){
    // Edge Function returned a non-2xx — the JSON error message it sent
    // back is usually more useful than the generic FunctionsHttpError text.
    try{
      const body = await error.context.json();
      return { ok: false, error: extractFunctionErrorMessage(body, error.message) };
    }catch{
      return { ok: false, error: error.message || 'Unknown error' };
    }
  }
  return data;
}
// Convenience wrapper for the agent detail panel, where every action
// targets currentDetailAgent.
async function callManageUser(action, extra){
  return invokeManageUser({ action, userId: currentDetailAgent.id, ...extra });
}

// ---------- add user (Staff tab) ----------
function generatePassword(){
  // Readable-ish random password: mixed case + digits, no ambiguous-looking
  // chars (0/O, 1/l/I) since an admin may be reading it aloud or retyping
  // it to share with the agent.
  const chars = 'ABCDEFGHJKMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789';
  let out = '';
  const bytes = new Uint8Array(14);
  crypto.getRandomValues(bytes);
  for(let i = 0; i < bytes.length; i++) out += chars[bytes[i] % chars.length];
  return out;
}

// ---------- v643: department / title / grade ----------
// Departments come from the staff_departments table rather than a list in
// this file, and profiles.department has a FOREIGN KEY to it. That is not
// bureaucracy: the v639 chat rules compare department strings for EXACT
// EQUALITY and name 'Sales', 'Quality', 'Human Resources' and 'Operations'
// literally, so a free-text field would let a typo ("operations", "Ops")
// silently cut somebody off from their own department with no error
// anywhere. A dropdown fed by the table cannot produce a value the rules
// do not recognise, and adding a department is an INSERT, not a deploy.
var staffDepartments = null;
async function loadStaffDepartments(){
  if(staffDepartments) return staffDepartments;
  const { data, error } = await sb.from('staff_departments').select('name, sort_order').order('sort_order').order('name');
  if(error){ console.error('loadStaffDepartments failed', error); return []; }
  staffDepartments = data || [];
  return staffDepartments;
}
async function fillDepartmentSelect(selectId, current){
  const sel = $(selectId);
  if(!sel) return;
  const rows = await loadStaffDepartments();
  // The blank option is real and must stay: the two bot accounts (AI
  // Assistant, Desouky) legitimately have no department, and an
  // uncategorised account is a supported state that fails OPEN in the chat
  // rules rather than isolating somebody nobody has got to yet.
  sel.innerHTML = '<option value="">&mdash; not set &mdash;</option>'
    + rows.map(r => `<option value="${escapeHtml(r.name)}">${escapeHtml(r.name)}</option>`).join('');
  sel.value = current || '';
}

// Writes department/title/grade. Deliberately NOT part of manage-user's
// update_profile: profiles' only UPDATE policy is "self update", so the
// browser cannot write another person's row at all, and a blanket admin
// UPDATE policy would also expose profiles.role — which manage-user guards
// server-side (Owner is never mintable, Admin is Owner-only). This RPC
// touches exactly three columns and can never escalate a role.
async function saveStaffOrgInfo(userId, department, title, grade){
  const { error } = await sb.rpc('set_staff_org_info', {
    target: userId,
    p_department: department || null,
    p_title: title || null,
    p_grade: grade || null
  });
  return error ? { ok: false, error: error.message } : { ok: true };
}

// v240: selectId defaults to the Add User modal's own select, but Candidate
// Review's approve-and-create-account modal reuses this exact same
// role-listing logic against its own select (hrApproveRole) rather than
// duplicating it.
async function refreshAddUserRoleOptions(selectId = 'newUserRole'){
  const { data } = await sb.from('roles').select('name').order('name');
  // Owner is never offered here, for anyone, including the Owner
  // themselves — there's exactly one Owner account, created outside this
  // flow, and this tool doesn't mint new ones. Admin is Owner-only.
  // Both are hardcoded by name rather than roles.is_protected, since that
  // flag no longer implies "security-sensitive" for Admin specifically —
  // its dashboard permissions are editable, but who can be handed the
  // Admin role itself is still locked down independent of that (matches
  // the same hardcoded check the manage-user Edge Function enforces
  // server-side, so this dropdown never offers something that would just
  // get rejected anyway).
  const roles = (data || []).filter(r => r.name !== 'owner' && (myIsOwner || r.name !== 'admin'));
  const sel = $(selectId);
  const prev = sel.value;
  sel.innerHTML = roles.map(r => `<option value="${escapeHtml(r.name)}">${escapeHtml(roleDisplayLabel(r.name))}</option>`).join('');
  sel.value = roles.some(r => r.name === prev) ? prev : (roles.some(r => r.name === 'agent') ? 'agent' : ((roles[0] || {}).name || ''));
}

async function openAddUserModal(){
  $('newUserFullName').value = '';
  $('newUserEmail').value = '';
  await refreshAddUserRoleOptions();
  $('newUserTitle').value = '';
  $('newUserGrade').value = 'staff';
  await fillDepartmentSelect('newUserDepartment', '');
  $('newUserPassword').value = generatePassword();
  $('addUserMsg').textContent = '';
  $('addUserFormView').style.display = 'block';
  $('addUserSuccessView').style.display = 'none';
  $('addUserModalOverlay').classList.add('active');
}
function closeAddUserModal(){
  $('addUserModalOverlay').classList.remove('active');
}
const _addUserBtn = document.getElementById('addUserBtn');
if(_addUserBtn) _addUserBtn.addEventListener('click', openAddUserModal);
$('addUserCancelBtn').addEventListener('click', closeAddUserModal);
$('addUserModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'addUserModalOverlay') closeAddUserModal(); });
$('newUserGenPasswordBtn').addEventListener('click', () => { $('newUserPassword').value = generatePassword(); });

$('addUserCreateBtn').addEventListener('click', async () => {
  const msg = $('addUserMsg');
  msg.textContent = '';
  const full_name = $('newUserFullName').value.trim();
  const email = $('newUserEmail').value.trim();
  const role = $('newUserRole').value;
  const password = $('newUserPassword').value;
  const department = $('newUserDepartment').value;
  const title = $('newUserTitle').value.trim();
  const grade = $('newUserGrade').value;

  if(!email){ msg.textContent = 'Email is required.'; return; }
  if(!password || password.length < 8){ msg.textContent = 'Password must be at least 8 characters.'; return; }

  const btn = $('addUserCreateBtn');
  btn.disabled = true;
  const result = await invokeManageUser({ action: 'create_user', email, password, full_name, role });
  btn.disabled = false;
  if(!result.ok){
    msg.textContent = result.error || 'Failed to create user.';
    return;
  }

  // The account EXISTS from here on. If categorising it fails, that is a
  // partial success, not a failure -- saying "Failed to create user" would
  // send the admin round to create a duplicate. Say what actually happened
  // and where to finish it.
  let orgWarning = '';
  if(department || title || grade){
    const org = await saveStaffOrgInfo(result.userId, department, title, grade);
    if(!org.ok){
      orgWarning = ` Account created, but the department/title could not be saved (${org.error}). Set them from User Management > Users.`;
      console.error('set_staff_org_info failed after create_user', org.error);
    }
  }

  logActivity('user.create', 'agent', result.userId, `Created ${role} account for ${email}${full_name ? ' ('+full_name+')' : ''}${department || title ? ` — ${[title, department].filter(Boolean).join(' · ')}` : ''}`);
  loadTeam();
  // Also refresh the User Management > Users list if that's the panel the
  // button was opened from, so the new account shows up there right away
  // without needing to flip away to Dashboard and back.
  if(umActiveSection === 'users') loadUmUsersList();

  $('addUserSuccessEmail').textContent = email;
  $('addUserSuccessPassword').textContent = password;
  $('addUserOrgWarning').textContent = orgWarning;
  $('addUserOrgWarning').style.display = orgWarning ? 'block' : 'none';
  $('addUserFormView').style.display = 'none';
  $('addUserSuccessView').style.display = 'block';
});
$('addUserCopyBtn').addEventListener('click', async () => {
  const text = `Email: ${$('addUserSuccessEmail').textContent}\nPassword: ${$('addUserSuccessPassword').textContent}`;
  try{
    await navigator.clipboard.writeText(text);
    const btn = $('addUserCopyBtn');
    const original = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(() => { btn.textContent = original; }, 1500);
  }catch{
    alert(text); // clipboard API blocked (e.g. insecure context) — fall back to a visible copyable alert
  }
});
$('addUserDoneBtn').addEventListener('click', closeAddUserModal);

// ---------- v88: Client Portal accounts (User Management -> Clients) ----------
// Goes through manage-client (same reasoning as manage-user: creating an
// auth user with a set password, resetting another account's password,
// and deleting an auth user all need the service role key). Listing
// doesn't need the function — client_accounts/client_campaign_access are
// queried directly, same as the Users list queries profiles directly;
// RLS already restricts full-table select on client_accounts to
// Owner/Admin (see "client_accounts: owner/admin full access" policy).
async function invokeManageClient(payload){
  const { data, error } = await sb.functions.invoke('manage-client', { body: payload });
  if(error){
    try{
      const body = await error.context.json();
      return { ok: false, error: extractFunctionErrorMessage(body, error.message) };
    }catch{
      return { ok: false, error: error.message || 'Unknown error' };
    }
  }
  return data;
}

async function loadUmClientsList(){
  clientPushInit();   // v782: the send-a-notification card lives under this table
  const tbody = $('umClientsTbody');
  // NOTE (User Management deep-scan pass): client_accounts/client_campaign_
  // access are both single-digit-row-count tables today, nowhere near
  // PostgREST's row cap — left as plain queries (rather than fetchAllRows)
  // specifically to keep this function's real error-surfacing to the admin
  // (clientsErr.message below) intact; fetchAllRows only logs failures to
  // the console, it doesn't propagate them, which would have silently
  // downgraded a real query error into a blank list here. Worth revisiting
  // with a proper error-preserving pagination helper if this table ever
  // grows large enough to matter.
  const [{ data: clients, error: clientsErr }, { data: access }] = await Promise.all([
    sb.from('client_accounts').select('id, email, full_name, company_name, phone, must_change_password, is_active, created_at, last_login_at').order('created_at', { ascending: false }),
    sb.from('client_campaign_access').select('client_id, form_id, lead_submission_forms(name)'),
  ]);
  if(clientsErr){
    tbody.innerHTML = `<tr><td colspan="7" style="color:var(--danger);">${escapeHtml(clientsErr.message)}</td></tr>`;
    return;
  }
  const accessByClient = {};
  (access || []).forEach(a => { (accessByClient[a.client_id] ||= []).push((a.lead_submission_forms && a.lead_submission_forms.name) || '—'); });

  if(!clients || !clients.length){
    tbody.innerHTML = `<tr><td colspan="7" style="color:var(--text-dim);">No client accounts yet.</td></tr>`;
    return;
  }
  // v313: Clients is now a delegable View/Edit section (see UM_SECTIONS) —
  // a View-only role sees this table but can't touch it: the phone cell
  // isn't contenteditable, and every action button below carries
  // .edit-only (disabled by applyUmSectionEditGating, called again at the
  // end of this function since these rows didn't exist yet the last time
  // it ran from activateUmSection). Delete stays out of that scheme
  // entirely — still gated on myIsOwner alone, matching manage-client's
  // own Owner-only check for delete_client.
  const clientsEditable = canEditUmSection('clients');
  tbody.innerHTML = clients.map(c => `
    <tr>
      <td>
        <div style="color:var(--text);">${escapeHtml(c.full_name)}</div>
        <div style="font-size:11px; color:var(--text-dim);">${escapeHtml(c.email)}</div>
      </td>
      <td>${escapeHtml(c.company_name || '—')}</td>
      <td>
        <!-- v153: destination for the client-facing SMS notifications
             (new ticket / new lead / dispute-feedback reply) — see
             supabase/functions/send-client-sms. Blank = that client never
             gets texted, no error anywhere, just silently skipped. -->
        <span class="client-phone-cell" contenteditable="${clientsEditable}" data-id="${c.id}" data-original="${escapeHtml(c.phone || '')}" style="display:inline-block; min-width:110px;">${escapeHtml(c.phone || '')}</span>
      </td>
      <td style="max-width:260px;">${escapeHtml((accessByClient[c.id] || []).join(', ') || 'None')}</td>
      <td>
        ${c.is_active ? '<span style="color:var(--good);">Active</span>' : '<span style="color:var(--danger);">Deactivated</span>'}
        ${c.must_change_password ? '<div style="font-size:10px; color:var(--text-dim);">pending first login</div>' : ''}
      </td>
      <td style="font-size:11px; color:var(--text-dim);">${c.last_login_at ? new Date(c.last_login_at).toLocaleString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {}) : 'Never'}</td>
      <td style="white-space:nowrap;">
        <button class="btn-secondary edit-only client-access-btn" data-client-id="${c.id}" data-client-name="${escapeHtml(c.full_name)}" style="width:auto; padding:5px 10px; font-size:11px; margin-top:0;">Edit client</button>
        <button class="btn-secondary edit-only client-reset-btn" data-client-id="${c.id}" data-client-email="${escapeHtml(c.email)}" data-client-phone="${escapeHtml(c.phone || '')}" style="width:auto; padding:5px 10px; font-size:11px; margin-top:0;">Reset password</button>
        <button class="btn-secondary edit-only client-toggle-btn" data-client-id="${c.id}" data-active="${c.is_active}" style="width:auto; padding:5px 10px; font-size:11px; margin-top:0;">${c.is_active ? 'Deactivate' : 'Reactivate'}</button>
        ${c.is_active
          ? `<button class="btn-secondary edit-only client-impersonate-btn" data-client-id="${c.id}" data-client-name="${escapeHtml(c.full_name)}" title="Open the client portal, signed in as this client, in a new tab" style="width:auto; padding:5px 10px; font-size:11px; margin-top:0;">Log in as client</button>`
          : ''}
        ${myIsOwner
          ? `<button class="btn-secondary client-delete-btn" data-client-id="${c.id}" data-client-email="${escapeHtml(c.email)}" title="Permanently delete this client account — Owner only" style="width:auto; padding:5px 10px; font-size:11px; margin-top:0; color:var(--danger); border-color:var(--danger);">Delete</button>`
          : ''}
      </td>
    </tr>`).join('');
  applyUmSectionEditGating('clients');
}
// ---------------------------------------------------------------------------
// v782: "Send app notification" -- a promotion or update pushed to the client
// app. The Edge Function re-checks this same permission, so this is only about
// not showing staff a form they cannot use.
// ---------------------------------------------------------------------------
let clientPushSelected = new Set();

function clientPushCanSend(){ return canEditUmSection('clients'); }

async function clientPushCall(payload){
  const { data, error } = await sb.functions.invoke('client-push-broadcast', { body: payload });
  if(error || !data || data.ok === false){
    throw new Error((data && data.error) || (error && error.message) || 'Something went wrong.');
  }
  return data;
}

function clientPushRenderPickList(clients){
  const box = $('clientPushPickList');
  if(!box) return;
  box.innerHTML = (clients || []).map(c => `
    <label class="perm-side-item" style="display:flex; align-items:center; gap:8px; cursor:pointer;">
      <input type="checkbox" class="perm-cb client-push-pick" value="${c.id}" ${clientPushSelected.has(c.id) ? 'checked' : ''} style="width:auto;">
      <span class="perm-side-item-main">
        <span class="perm-side-item-name">${escapeHtml(c.name)}</span>
        <span class="perm-side-item-sub">${c.hasApp ? 'has the app' : 'no app yet'}</span>
      </span>
    </label>`).join('') || '<div class="perm-side-empty">No active clients.</div>';
  box.querySelectorAll('.client-push-pick').forEach(cb => {
    cb.addEventListener('change', () => {
      if(cb.checked) clientPushSelected.add(cb.value); else clientPushSelected.delete(cb.value);
    });
  });
}

async function clientPushPreview(showMessage){
  const msg = $('clientPushMsg');
  const audience = $('clientPushAudience').value;
  try {
    const data = await clientPushCall({
      action: 'preview',
      audience,
      clientIds: [...clientPushSelected],
    });
    if(audience === 'selected' || !$('clientPushPickList').innerHTML.trim()) clientPushRenderPickList(data.clients);
    if(showMessage){
      msg.style.color = 'var(--text-2)';
      msg.textContent = `${data.clientsTargeted} client${data.clientsTargeted === 1 ? '' : 's'} match — ${data.clientsWithApp} ${data.clientsWithApp === 1 ? 'has' : 'have'} the app installed.`;
    }
    return data;
  } catch(e){
    if(showMessage){ msg.style.color = 'var(--danger)'; msg.textContent = e.message; }
    return null;
  }
}

async function clientPushLoadHistory(){
  const box = $('clientPushHistory');
  if(!box) return;
  try {
    const data = await clientPushCall({ action: 'history', limit: 10 });
    const rows = data.broadcasts || [];
    if(!rows.length){ box.textContent = 'Nothing sent yet.'; return; }
    box.innerHTML = rows.map(b => `
      <div style="padding:8px 0; border-top:1px solid var(--border);">
        <div style="color:var(--text); font-weight:600;">${escapeHtml(b.title)}</div>
        <div style="margin-top:2px;">${escapeHtml(b.body)}</div>
        <div class="mono" style="margin-top:4px; font-size:11px;">
          ${new Date(b.created_at).toLocaleString()} · ${escapeHtml(b.sent_by_name || 'staff')} ·
          ${b.clients_reached} of ${b.clients_targeted} clients · ${b.devices_sent} phone${b.devices_sent === 1 ? '' : 's'}
        </div>
      </div>`).join('');
  } catch(e){
    box.textContent = e.message;
  }
}

function clientPushInit(){
  const card = $('clientPushCard');
  if(!card) return;
  card.style.display = clientPushCanSend() ? '' : 'none';
  if(!clientPushCanSend() || card.dataset.wired === '1') return;
  card.dataset.wired = '1';

  $('clientPushAudience').addEventListener('change', () => {
    const picking = $('clientPushAudience').value === 'selected';
    $('clientPushPickWrap').style.display = picking ? '' : 'none';
    if(picking) clientPushPreview(false);
  });
  $('clientPushPreviewBtn').addEventListener('click', () => clientPushPreview(true));
  $('clientPushSendBtn').addEventListener('click', async () => {
    const msg = $('clientPushMsg');
    const btn = $('clientPushSendBtn');
    const title = $('clientPushTitle').value.trim();
    const body = $('clientPushBody').value.trim();
    const url = $('clientPushUrl').value.trim();
    if(!title || !body){
      msg.style.color = 'var(--danger)';
      msg.textContent = 'A title and a message are both needed.';
      return;
    }
    const preview = await clientPushPreview(false);
    if(!preview) return;
    // A push cannot be unsent -- say exactly how many phones it is going to.
    if(!confirm(`Send "${title}" to ${preview.clientsWithApp} client${preview.clientsWithApp === 1 ? '' : 's'} with the app installed?\n\nThis reaches their phones straight away and cannot be undone.`)) return;
    btn.disabled = true;
    msg.style.color = 'var(--text-2)';
    msg.textContent = 'Sending…';
    try {
      const data = await clientPushCall({
        action: 'send',
        audience: $('clientPushAudience').value,
        clientIds: [...clientPushSelected],
        title, body, url: url || undefined,
      });
      msg.style.color = 'var(--good, var(--focus))';
      msg.textContent = data.warning
        ? `Sent to ${data.devicesSent} phone(s). ${data.warning}`
        : `Sent to ${data.devicesSent} phone${data.devicesSent === 1 ? '' : 's'} across ${data.clientsReached} client${data.clientsReached === 1 ? '' : 's'}.`;
      $('clientPushTitle').value = '';
      $('clientPushBody').value = '';
      $('clientPushUrl').value = '';
      clientPushLoadHistory();
    } catch(e){
      msg.style.color = 'var(--danger)';
      msg.textContent = e.message;
    }
    btn.disabled = false;
  });

  clientPushLoadHistory();
}

if($('umClientsTbody')) $('umClientsTbody').addEventListener('focusout', async (e) => {
  const el = e.target.closest('.client-phone-cell');
  if(!el) return;
  const newVal = el.textContent.trim();
  const original = el.dataset.original || '';
  if(newVal === original) return;
  const { error } = await sb.from('client_accounts').update({ phone: newVal || null }).eq('id', el.dataset.id);
  if(error){ alert(error.message); el.textContent = original; return; }
  el.dataset.original = newVal;
  logActivity('client.update', 'client', el.dataset.id, `Set phone to "${newVal}"`);
});

// ---------- v91: Client Chat Routing (Clients subtab) ----------
// Lets Owner/Admin assign a specific staff member to each "team" a client
// can ask the portal's AI assistant to connect them to. editingRouteKey
// tracks whether the form below the table is in add- or edit-mode; null
// means "add a new team".
let clientChatRoutesCache = [];
let clientChatRoutesStaffCache = [];
let clientChatRouteStaffByQueueKey = {}; // queue_key -> [staff_id, ...]
let editingClientChatRouteKey = null;

async function loadClientChatRoutes(){
  const tbody = $('clientChatRoutesTbody');
  const [{ data: routes, error }, { data: staff }, { data: allRoles }, { data: routeStaff }] = await Promise.all([
    sb.from('client_chat_routes').select('queue_key, label, description').order('label'),
    sb.from('profiles').select('id, full_name, email, is_active, role, chat_status, last_seen_at').order('full_name'),
    sb.from('roles').select('name, allowed_tabs'),
    sb.from('client_chat_route_staff').select('queue_key, staff_id'),
  ]);
  if(error){
    tbody.innerHTML = `<tr><td colspan="4" style="color:var(--danger);">${escapeHtml(error.message)}</td></tr>`;
    return;
  }
  clientChatRoutesCache = routes || [];
  clientChatRoutesStaffCache = staff || [];
  clientChatRouteStaffByQueueKey = {};
  (routeStaff || []).forEach(rs => {
    (clientChatRouteStaffByQueueKey[rs.queue_key] = clientChatRouteStaffByQueueKey[rs.queue_key] || []).push(rs.staff_id);
  });

  // v109: only Owner/Admin/Sales, or a custom role explicitly granted the
  // "Client Chat" permission, can ever be picked here — mirrors
  // staff_can_handle_client_chat() in schema.sql, which enforces the same
  // rule at the database level regardless of what this list offers.
  const allowedTabsByRole = {};
  (allRoles || []).forEach(r => { allowedTabsByRole[r.name] = Array.isArray(r.allowed_tabs) ? r.allowed_tabs : []; });
  const canHandleClientChat = p => {
    const role = (p.role || '').toLowerCase();
    if(role === 'owner' || role === 'admin') return true;
    if(role.replace(/[\s_-]+/g, '') === 'sales') return true;
    return (allowedTabsByRole[p.role] || []).includes('client_chat');
  };

  const eligibleStaff = clientChatRoutesStaffCache.filter(p => p.is_active && canHandleClientChat(p));
  const staffHint = $('clientChatRouteStaffHint');
  if(staffHint && !eligibleStaff.length) staffHint.textContent = 'No one is eligible yet — grant a role the "Client Chat" permission under User Management → User Types, or assign someone the Sales role.';

  const staffName = id => { const p = clientChatRoutesStaffCache.find(x => x.id === id); return p ? (p.full_name || p.email) : '—'; };
  // v113: same "stale heartbeat counts as away" rule as
  // pick_client_chat_route_staff() in schema.sql, just rendered as a label
  // here instead of driving the actual pick.
  const staffPresenceLabel = p => {
    const stale = !p.last_seen_at || (Date.now() - new Date(p.last_seen_at).getTime()) >= 90000;
    if(p.chat_status === 'active' && !stale) return { label: 'Active', color: 'var(--good)' };
    if(p.chat_status === 'away' || stale) return { label: 'Away', color: 'var(--away)' };
    return { label: 'Offline', color: 'var(--text-dim)' };
  };

  if(!clientChatRoutesCache.length){
    tbody.innerHTML = `<tr><td colspan="4" style="color:var(--text-dim);">No teams configured yet — clients won't be offered a "Connect me to..." option (the AI will just tell them someone will follow up) until at least one exists.</td></tr>`;
    return;
  }
  tbody.innerHTML = clientChatRoutesCache.map(r => {
    const staffIds = clientChatRouteStaffByQueueKey[r.queue_key] || [];
    const assignedHtml = staffIds.length
      ? staffIds.map(id => {
          const p = clientChatRoutesStaffCache.find(x => x.id === id);
          const presence = p ? staffPresenceLabel(p) : { label: '', color: 'var(--text-dim)' };
          return `${escapeHtml(staffName(id))} <span style="color:${presence.color}; font-size:10px;">(${presence.label})</span>`;
        }).join('<br>')
      : '<span style="color:var(--text-dim);">Nobody assigned</span>';
    return `
    <tr>
      <td><div style="color:var(--text);">${escapeHtml(r.label)}</div><div style="font-size:10px; color:var(--text-dim);" class="mono">${escapeHtml(r.queue_key)}</div></td>
      <td style="max-width:320px; font-size:12px; color:var(--text-2);">${escapeHtml(r.description)}</td>
      <td style="font-size:12px;">${assignedHtml}</td>
      <td style="white-space:nowrap;">
        <button class="btn-secondary client-chat-route-edit-btn" data-key="${escapeHtml(r.queue_key)}" style="width:auto; padding:5px 10px; font-size:11px; margin-top:0;">Edit</button>
        <button class="btn-secondary client-chat-route-delete-btn" data-key="${escapeHtml(r.queue_key)}" style="width:auto; padding:5px 10px; font-size:11px; margin-top:0; color:var(--danger);">Delete</button>
      </td>
    </tr>`;
  }).join('');

  renderClientChatRouteStaffList(eligibleStaff, clientChatRouteStaffByQueueKey[editingClientChatRouteKey] || []);
}

// v113: multi-select checkbox list of eligible staff for the Add/Edit
// team form — replaces the old single <select>, since a route can now
// have several people assigned.
function renderClientChatRouteStaffList(eligibleStaff, checkedIds){
  const container = $('clientChatRouteStaffList');
  if(!container) return;
  const checked = new Set(checkedIds || []);
  container.innerHTML = eligibleStaff.map(p => `
    <label style="display:flex; align-items:center; gap:8px; font-weight:400; margin:4px 0; cursor:pointer;">
      <input type="checkbox" class="client-chat-route-staff-cb" value="${p.id}" ${checked.has(p.id) ? 'checked' : ''} style="width:14px; height:14px; accent-color:var(--focus);">
      ${escapeHtml(p.full_name || p.email)}
    </label>`).join('') || '<div style="color:var(--text-dim);">No one is eligible yet.</div>';
}

function resetClientChatRouteForm(){
  editingClientChatRouteKey = null;
  $('clientChatRouteFormTitle').textContent = 'Add a team';
  $('clientChatRouteKeyInput').value = '';
  $('clientChatRouteKeyInput').disabled = false;
  $('clientChatRouteLabelInput').value = '';
  $('clientChatRouteDescInput').value = '';
  document.querySelectorAll('#clientChatRouteStaffList .client-chat-route-staff-cb').forEach(cb => { cb.checked = false; });
  $('saveClientChatRouteBtn').textContent = 'Save team';
  $('cancelClientChatRouteEditBtn').style.display = 'none';
  $('clientChatRouteMsg').textContent = '';
}

$('clientChatRoutesTbody').addEventListener('click', (e) => {
  const editBtn = e.target.closest('.client-chat-route-edit-btn');
  if(editBtn){
    const route = clientChatRoutesCache.find(r => r.queue_key === editBtn.dataset.key);
    if(!route) return;
    editingClientChatRouteKey = route.queue_key;
    $('clientChatRouteFormTitle').textContent = `Edit "${route.label}"`;
    $('clientChatRouteKeyInput').value = route.queue_key;
    $('clientChatRouteKeyInput').disabled = true; // primary key — don't let an edit silently fork into a new row
    $('clientChatRouteLabelInput').value = route.label;
    $('clientChatRouteDescInput').value = route.description;
    document.querySelectorAll('#clientChatRouteStaffList .client-chat-route-staff-cb').forEach(cb => {
      cb.checked = (clientChatRouteStaffByQueueKey[route.queue_key] || []).includes(cb.value);
    });
    $('saveClientChatRouteBtn').textContent = 'Save changes';
    $('cancelClientChatRouteEditBtn').style.display = 'inline-block';
    $('clientChatRouteMsg').textContent = '';
    return;
  }
  const delBtn = e.target.closest('.client-chat-route-delete-btn');
  if(delBtn){
    const route = clientChatRoutesCache.find(r => r.queue_key === delBtn.dataset.key);
    if(!route) return;
    if(!confirm(`Delete the "${route.label}" team? Any client currently routed there stays assigned (existing conversations aren't affected), but it won't be offered as an option going forward.`)) return;
    sb.from('client_chat_routes').delete().eq('queue_key', route.queue_key).then(({ error }) => {
      if(error) alert('Failed to delete: ' + error.message);
      if(editingClientChatRouteKey === route.queue_key) resetClientChatRouteForm();
      loadClientChatRoutes();
    });
  }
});

$('cancelClientChatRouteEditBtn').addEventListener('click', resetClientChatRouteForm);

$('saveClientChatRouteBtn').addEventListener('click', async () => {
  const msg = $('clientChatRouteMsg');
  msg.textContent = '';
  const queueKey = $('clientChatRouteKeyInput').value.trim().toLowerCase().replace(/[^a-z0-9_]/g, '_');
  const label = $('clientChatRouteLabelInput').value.trim();
  const description = $('clientChatRouteDescInput').value.trim();
  const staffIds = Array.from(document.querySelectorAll('#clientChatRouteStaffList .client-chat-route-staff-cb:checked')).map(cb => cb.value);
  if(!queueKey || !label || !description || !staffIds.length){
    msg.textContent = 'Key, label, description, and at least one assigned staff member are all required.';
    msg.className = 'msg error';
    return;
  }
  const btn = $('saveClientChatRouteBtn');
  btn.disabled = true;
  // v113: staff_id kept null on client_chat_routes now — client_chat_route_staff
  // (replace-all: delete then insert the checked set) is the source of
  // truth for who's assigned. Route upsert first (its own row must exist
  // before the staff rows can reference it via FK).
  const { error } = await sb.from('client_chat_routes')
    .upsert({ queue_key: queueKey, label, description }, { onConflict: 'queue_key' });
  if(error){
    btn.disabled = false;
    msg.textContent = error.message;
    msg.className = 'msg error';
    return;
  }
  // audit fix (audit_chunk5.md #4, Medium): this used to delete every
  // existing assignment THEN insert the new set — if the insert failed
  // (network blip, RLS hiccup, a bad staff_id), the delete had already
  // committed, leaving the route with NO staff assigned at all (worse than
  // its state before the save). Diffed against the current assignment
  // instead: only the staff actually being ADDED are inserted, and only
  // the staff actually being REMOVED are deleted, each checked separately.
  // A failure on either half now leaves the route either fully staffed
  // (add failed, remove never ran) or over-staffed with a stale extra
  // (remove failed after add succeeded) — never zero.
  const { data: currentStaffRows, error: currentStaffErr } = await sb.from('client_chat_route_staff').select('staff_id').eq('queue_key', queueKey);
  if(currentStaffErr){
    btn.disabled = false;
    msg.textContent = `Team saved, but couldn't read the current staff list to update it: ${currentStaffErr.message}`;
    msg.className = 'msg error';
    return;
  }
  const currentStaffIds = new Set((currentStaffRows || []).map(r => r.staff_id));
  const newStaffIds = new Set(staffIds);
  const staffIdsToAdd = staffIds.filter(id => !currentStaffIds.has(id));
  const staffIdsToRemove = [...currentStaffIds].filter(id => !newStaffIds.has(id));
  if(staffIdsToAdd.length){
    const { error: addErr } = await sb.from('client_chat_route_staff')
      .insert(staffIdsToAdd.map(staff_id => ({ queue_key: queueKey, staff_id })));
    if(addErr){
      btn.disabled = false;
      msg.textContent = `Team saved, but assigning staff failed: ${addErr.message}`;
      msg.className = 'msg error';
      return;
    }
  }
  if(staffIdsToRemove.length){
    const { error: removeErr } = await sb.from('client_chat_route_staff')
      .delete().eq('queue_key', queueKey).in('staff_id', staffIdsToRemove);
    btn.disabled = false;
    if(removeErr){
      msg.textContent = `Team saved and new staff added, but removing unchecked staff failed: ${removeErr.message}`;
      msg.className = 'msg error';
      return;
    }
  } else {
    btn.disabled = false;
  }
  const staffLabels = staffIds.map(id => { const p = clientChatRoutesStaffCache.find(x => x.id === id); return p ? (p.full_name || p.email) : id; }).join(', ');
  resetClientChatRouteForm();
  loadClientChatRoutes();
  logActivity('client_chat_route.upsert', null, null, `Set "${label}" -> ${staffLabels}`);
});


// tasks is purely a time-tracking concept for the extension and is never
// linked to leads at all anymore — a `tasks` row (Break, Sales Manager,
// Backoffice Specialist, etc.) was never a lead campaign, and showing it
// here only confused a client-access picker. This queries the same table
// the Submission Forms Creator itself manages, excluding the PrimeHome
// Buyers form — that one is Adel's own resale pipeline to iSpeedToLead,
// never a client-visible campaign.
//
// v373: this used to list EVERY active lead_submission_forms row —
// including purely internal, non-campaign forms (e.g. "Ticket") and
// one-off forms created outside the actual Create Campaign flow (e.g.
// "Tori 001", manually granted, never requested/paid as a campaign — see
// the v309/v310 note on loadCsubActiveCampaignForms/csubActiveCampaignForms
// above, which already draws this exact distinction for the Campaigns tab
// table). That made it easy to grant "Campaign access" to something that
// isn't a campaign at all. Now scoped to real Campaigns only: a form with
// at least one client_campaign_subscriptions row (paid or complimentary,
// same definition used everywhere else "a real campaign" is checked in
// this file). Any form NOT in that set but already checked for this
// client (a pre-existing legacy grant) is still shown — greyed, labeled
// "(legacy — not a campaign)" — so saving the modal can never silently
// revoke access nobody consciously chose to remove; unchecking it here is
// how staff now deliberately clean one up.
async function getRealCampaignFormIds(){
  const { data } = await sb.from('client_campaign_subscriptions').select('form_id');
  return new Set((data || []).map(s => s.form_id).filter(Boolean));
}
async function renderClientCampaignCheckboxes(container, checkedIds){
  const [{ data }, realCampaignFormIds] = await Promise.all([
    sb.from('lead_submission_forms').select('id, name').eq('is_active', true).order('sort_order').order('name'),
    getRealCampaignFormIds(),
  ]);
  const checked = new Set(checkedIds || []);
  const forms = (data || [])
    .filter(f => f.name !== ISPD_DEFAULT_CAMPAIGN_NAME)
    .filter(f => realCampaignFormIds.has(f.id) || checked.has(f.id));
  container.innerHTML = forms.map(f => {
    const isRealCampaign = realCampaignFormIds.has(f.id);
    return `
    <label style="display:flex; align-items:center; gap:8px; font-weight:400; text-transform:none; letter-spacing:0; margin:4px 0; font-family:var(--sans); ${isRealCampaign ? '' : 'color:var(--text-dim);'}">
      <input type="checkbox" class="client-campaign-cb" value="${f.id}" ${checked.has(f.id) ? 'checked' : ''} style="width:14px; height:14px; accent-color:var(--focus);">
      ${escapeHtml(f.name)}${isRealCampaign ? '' : ' <span style="font-size:10px;">(legacy — not a campaign)</span>'}
    </label>`;
  }).join('') || '<div style="color:var(--text-dim);">No campaigns exist yet — create one under Campaigns → Campaign Management first.</div>';
}

// v112: candidate Campaign Guides to assign — same real-Campaign list as
// campaign lead-access above (a campaign's guide is keyed by its form
// name, normalized), so anything that can be a real campaign can also
// have its guide shared with a client, whether or not it has guide
// content saved yet.
// v373: same fix as renderClientCampaignCheckboxes above — scoped to real
// Campaigns (client_campaign_subscriptions), with already-granted legacy
// guide access still shown (greyed, labeled) so nothing is silently lost.
async function renderClientGuideCheckboxes(container, checkedNormNames){
  const [{ data }, realCampaignFormIds] = await Promise.all([
    sb.from('lead_submission_forms').select('id, name').eq('is_active', true).order('sort_order').order('name'),
    getRealCampaignFormIds(),
  ]);
  const checked = new Set(checkedNormNames || []);
  const forms = (data || [])
    .filter(f => f.name !== ISPD_DEFAULT_CAMPAIGN_NAME)
    .filter(f => realCampaignFormIds.has(f.id) || checked.has(csubNormalizeLabel(f.name)));
  container.innerHTML = forms.map(f => {
    const normName = csubNormalizeLabel(f.name);
    const isRealCampaign = realCampaignFormIds.has(f.id);
    return `
    <label style="display:flex; align-items:center; gap:8px; font-weight:400; text-transform:none; letter-spacing:0; margin:4px 0; font-family:var(--sans); ${isRealCampaign ? '' : 'color:var(--text-dim);'}">
      <input type="checkbox" class="client-guide-cb" value="${escapeHtml(normName)}" data-display-name="${escapeHtml(f.name)}" ${checked.has(normName) ? 'checked' : ''} style="width:14px; height:14px; accent-color:var(--focus);">
      ${escapeHtml(f.name)}${isRealCampaign ? '' : ' <span style="font-size:10px;">(legacy — not a campaign)</span>'}
    </label>`;
  }).join('') || '<div style="color:var(--text-dim);">No campaigns exist yet — create one under Campaigns → Campaign Management first.</div>';
}

// v (user request, 2026-09-05): channels already linked to another client
// render as plain read-only text (no checkbox, no value) so the save
// handler below has nothing to pick up for them -- this modal must never
// be able to reassign a channel away from a different client without staff
// explicitly going to that channel and choosing "Unassigned" first.
async function renderClientReadyModeChannelCheckboxes(container, clientId){
  const result = await callRmApi({ action: 'list_lead_posting_channels' });
  if(!result.ok){
    container.innerHTML = `<div class="msg error">${escapeHtml(result.error || 'Failed to load channels.')}</div>`;
    return;
  }
  const channels = result.channels || [];
  if(!channels.length){
    container.innerHTML = '<div style="color:var(--text-dim);">No ReadyMode channels saved yet — add one under User Management → Integrations → ReadyMode first.</div>';
    return;
  }
  container.innerHTML = channels.map(c => {
    const mine = c.client_id === clientId;
    const takenByOther = c.client_id && !mine;
    if(takenByOther){
      return `
      <label style="display:flex; align-items:center; gap:8px; font-weight:400; text-transform:none; letter-spacing:0; margin:4px 0; font-family:var(--sans); color:var(--text-dim);">
        <input type="checkbox" disabled style="width:14px; height:14px;">
        ${escapeHtml(c.channel_name)} <span style="font-size:10px;">(assigned to ${escapeHtml(c.client_name || 'another client')})</span>
      </label>`;
    }
    return `
    <label style="display:flex; align-items:center; gap:8px; font-weight:400; text-transform:none; letter-spacing:0; margin:4px 0; font-family:var(--sans);">
      <input type="checkbox" class="client-channel-cb" value="${c.id}" ${mine ? 'checked' : ''} style="width:14px; height:14px; accent-color:var(--focus);">
      ${escapeHtml(c.channel_name)} <span style="font-size:10px; color:var(--text-dim);">(${escapeHtml(c.account_domain)})</span>
    </label>`;
  }).join('');
}

// ---- add client ----
async function openAddClientModal(){
  $('newClientFullName').value = '';
  $('newClientEmail').value = '';
  $('newClientCompany').value = '';
  $('newClientPhone').value = '';
  $('newClientTextPassword').checked = false;
  $('newClientPassword').value = generatePassword();
  $('addClientMsg').textContent = '';
  $('addClientSmsStatus').style.display = 'none';
  await renderClientCampaignCheckboxes($('newClientCampaignList'), []);
  await renderClientGuideCheckboxes($('newClientGuideList'), []);
  $('addClientFormView').style.display = 'block';
  $('addClientSuccessView').style.display = 'none';
  $('addClientModalOverlay').classList.add('active');
}
function closeAddClientModal(){ $('addClientModalOverlay').classList.remove('active'); }
$('addClientBtn').addEventListener('click', openAddClientModal);
$('addClientCancelBtn').addEventListener('click', closeAddClientModal);
$('addClientModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'addClientModalOverlay') closeAddClientModal(); });
$('newClientGenPasswordBtn').addEventListener('click', () => { $('newClientPassword').value = generatePassword(); });

$('addClientCreateBtn').addEventListener('click', async () => {
  const msg = $('addClientMsg');
  msg.textContent = '';
  const full_name = $('newClientFullName').value.trim();
  const email = $('newClientEmail').value.trim();
  const company_name = $('newClientCompany').value.trim();
  const phone = $('newClientPhone').value.trim();
  const password = $('newClientPassword').value;
  const form_ids = Array.from(document.querySelectorAll('#newClientCampaignList .client-campaign-cb:checked')).map(cb => cb.value);
  const guides = Array.from(document.querySelectorAll('#newClientGuideList .client-guide-cb:checked')).map(cb => ({ norm_name: cb.value, display_name: cb.dataset.displayName }));

  if(!full_name){ msg.textContent = 'Full name is required.'; return; }
  if(!email){ msg.textContent = 'Email is required.'; return; }
  if(!password || password.length < 8){ msg.textContent = 'Password must be at least 8 characters.'; return; }

  const btn = $('addClientCreateBtn');
  btn.disabled = true;
  btn.textContent = 'Creating…';
  const result = await invokeManageClient({ action: 'create_client', email, password, full_name, company_name, form_ids });
  btn.disabled = false;
  btn.textContent = 'Create client';
  if(!result.ok){ msg.textContent = result.error || 'Failed to create client.'; return; }
  // v153: manage-client's create_client doesn't take phone (a plain
  // column, not a privileged auth op) — set it directly, same RLS
  // ("client_accounts: owner/admin full access") every other direct
  // client_accounts write from this tab already relies on.
  if(phone) await sb.from('client_accounts').update({ phone }).eq('id', result.clientId);
  // v201: Campaign Guide access is a separate grant from campaign
  // (lead-feed) access above — form_ids went in with create_client
  // itself, but guide access always goes through its own
  // update_guide_access call (same as Edit client), so it's set here
  // right after the account exists. Non-fatal if it fails — the account
  // itself is already created at this point; Edit client remains the
  // fallback to grant it after the fact.
  let guideError = null;
  if(guides.length){
    const guideResult = await invokeManageClient({ action: 'update_guide_access', clientId: result.clientId, guides });
    if(!guideResult.ok) guideError = guideResult.error || 'Failed to grant Campaign Guide access.';
  }
  // v160: opt-in only — never sent unless the checkbox was checked AND a
  // phone was actually given (send-client-sms also independently no-ops
  // with no phone on file, this just avoids firing a call that's
  // guaranteed to be a no-op).
  // v200: now AWAITED and the outcome shown in the success view below —
  // this used to fire-and-forget, so a failed send (most commonly: no
  // GoHighLevel connection yet under Integrations) looked exactly like a
  // successful one, and the client silently never got the password.
  let smsResult = null;
  if(phone && $('newClientTextPassword').checked){
    smsResult = await callSendClientSms(result.clientId, 'account_password', password);
  }

  logActivity('client.create', 'client', result.clientId, `Created client account for ${email}${full_name ? ' ('+full_name+')' : ''}${guides.length ? `, granted ${guides.length} Campaign Guide(s)` : ''}`);
  loadUmClientsList();

  $('addClientSuccessEmail').textContent = email;
  $('addClientSuccessPassword').textContent = password;
  const smsStatusEl = $('addClientSmsStatus');
  const statusLines = [];
  if(smsResult){
    statusLines.push(smsResult.ok
      ? 'Texted to the client.'
      : `Couldn't text the client (${smsResult.error || 'unknown error'}) — share the credentials below with them directly.`);
  }
  if(guideError) statusLines.push(`Campaign Guide access failed to save (${guideError}) — set it from Edit client.`);
  if(statusLines.length){
    smsStatusEl.style.display = '';
    smsStatusEl.className = (smsResult && !smsResult.ok) || guideError ? 'msg error' : 'msg ok';
    smsStatusEl.textContent = statusLines.join(' ');
  } else {
    smsStatusEl.style.display = 'none';
  }
  $('addClientFormView').style.display = 'none';
  $('addClientSuccessView').style.display = 'block';
});
$('addClientCopyBtn').addEventListener('click', async () => {
  const text = `Email: ${$('addClientSuccessEmail').textContent}\nPassword: ${$('addClientSuccessPassword').textContent}`;
  try{
    await navigator.clipboard.writeText(text);
    const btn = $('addClientCopyBtn');
    const original = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(() => { btn.textContent = original; }, 1500);
  }catch{
    alert(text);
  }
});
$('addClientDoneBtn').addEventListener('click', closeAddClientModal);

// ---- edit client (contact info + campaign access) ----
// ===========================================================================
// v776: which tabs and subtabs a CLIENT sees in their own portal. Until now
// this was decided by a handful of unrelated rules scattered across the
// client portal itself — account_type === 'skiptrace' hid Opportunities,
// Tickets and Dashboard; reports_enabled showed Reports; an Email Marketing
// seat showed Email Marketing; everything else was always on and could not be
// turned off for one client at all. Those rules still apply and still come
// first (this never GRANTS anything a client has not paid for), but staff can
// now also close a tab or a single subtab per client, here, in the same Edit
// client modal where the rest of their access already lives.
//
// Stored in client_accounts.portal_sections as
//   { "<tab>": { "view": bool, "subtabs": { "<sub>": bool } } }
// A missing key means the portal's own default, so a client whose column is
// still {} behaves exactly as they did before this existed.
// ===========================================================================
const CLIENT_PORTAL_SECTIONS = [
  { key: 'dashboard', label: 'Dashboard', note: 'Hidden automatically for skip-trace-only accounts.' },
  { key: 'leads', label: 'Opportunities', note: 'Hidden automatically for skip-trace-only accounts.', subs: [
      { key: 'my-leads', label: 'My Opportunities' },
      { key: 'campaign-guide', label: 'Campaign Guide' },
      { key: 'leads-comments', label: 'Opportunity Comments' },
    ] },
  { key: 'tickets', label: 'Tickets', note: 'Hidden automatically for skip-trace-only accounts.' },
  { key: 'reports', label: 'Reports', note: 'Also needs "Reports tab enabled" above and a ReadyMode campaign feeding it.' },
  { key: 'buylist', label: 'Buy a list', subs: [
      { key: 'request', label: 'Request a list' },
      { key: 'your-requests', label: 'Your list requests' },
    ] },
  { key: 'skiptrace', label: 'Skip Tracing', subs: [
      { key: 'place-order', label: 'Place Order' },
      { key: 'order-history', label: 'Order History' },
    ] },
  { key: 'marketing', label: 'Email Marketing', note: 'Also needs an Email Marketing seat — unticking here cannot grant one, and ticking it cannot either.', subs: [
      { key: 'setup', label: 'Setup' },
      { key: 'lists', label: 'Lists' },
      { key: 'campaigns', label: 'Campaigns' },
      { key: 'inbox', label: 'Email Inbox' },
    ] },
  { key: 'billing', label: 'Billing', warn: 'With Billing off this client cannot pay an invoice or see what they owe — leave it on unless you are handling their payments for them.', subs: [
      { key: 'subscriptions', label: 'Subscriptions' },
      { key: 'invoices', label: 'Invoices' },
      { key: 'pending-payment', label: 'Pending payment' },
      { key: 'buy-credits', label: 'Buy Skip Tracing Credits' },
      { key: 'transactions', label: 'Transaction History' },
      { key: 'payment-method', label: 'Payment Method' },
    ] },
  { key: 'profile', label: 'Profile Details', warn: 'With this off they cannot update their own contact details or password from the portal.' },
];

function clientPortalTabOn(sections, tabKey){
  const cur = (sections || {})[tabKey];
  return cur && typeof cur.view === 'boolean' ? cur.view : true;
}
function clientPortalSubOn(sections, tabKey, subKey){
  const cur = ((sections || {})[tabKey] || {}).subtabs || {};
  return typeof cur[subKey] === 'boolean' ? cur[subKey] : true;
}

function renderClientPortalSections(sections){
  const root = $('clientAccessPortalSections');
  if(!root) return;
  root.innerHTML = CLIENT_PORTAL_SECTIONS.map(t => {
    const on = clientPortalTabOn(sections, t.key);
    const subs = t.subs || [];
    return `
      <div class="perm-tab-card${on ? '' : ' is-off'}" data-cp-card="${t.key}">
        <div class="perm-tab-head perm-head-2">
          <div class="perm-tab-title">
            ${subs.length ? `<button type="button" class="perm-disclose" data-cp-disclose="${t.key}" aria-label="Show or hide subtabs">${on ? '&#9662;' : '&#9656;'}</button>` : '<span class="perm-disclose"></span>'}
            <label style="display:flex; align-items:center; gap:8px; cursor:pointer; text-transform:none; font-family:var(--sans); letter-spacing:0; margin:0; min-width:0;">
              <input type="checkbox" class="perm-cb cp-tab-cb" data-cp-tab="${t.key}" ${on ? 'checked' : ''}>
              <span class="perm-tab-name">${escapeHtml(t.label)}</span>
            </label>
          </div>
          <div class="perm-col-label">Show</div>
        </div>
        ${(t.note || t.warn || subs.length) ? `
          <div class="perm-body" data-cp-body="${t.key}"${on ? '' : ' style="display:none;"'}>
            ${t.note ? `<div class="perm-note">${t.note}</div>` : ''}
            ${t.warn ? `<div class="perm-note" style="color:var(--danger);">${t.warn}</div>` : ''}
            ${subs.map(sub => `
              <div class="perm-row perm-row-2">
                <div class="perm-row-label">${escapeHtml(sub.label)}</div>
                <div class="perm-cell"><input type="checkbox" class="perm-cb cp-sub-cb" data-cp-tab="${t.key}" data-cp-sub="${sub.key}" ${clientPortalSubOn(sections, t.key, sub.key) ? 'checked' : ''}></div>
              </div>`).join('')}
          </div>` : ''}
      </div>`;
  }).join('');

  root.querySelectorAll('[data-cp-disclose]').forEach(btn => {
    btn.addEventListener('click', () => {
      const body = root.querySelector(`[data-cp-body="${btn.dataset.cpDisclose}"]`);
      if(!body) return;
      const open = body.style.display !== 'none';
      body.style.display = open ? 'none' : '';
      btn.innerHTML = open ? '&#9656;' : '&#9662;';
    });
  });
  root.querySelectorAll('.cp-tab-cb').forEach(box => {
    box.addEventListener('change', () => {
      const key = box.dataset.cpTab;
      const card = root.querySelector(`[data-cp-card="${key}"]`);
      const body = root.querySelector(`[data-cp-body="${key}"]`);
      const arrow = root.querySelector(`[data-cp-disclose="${key}"]`);
      if(card) card.classList.toggle('is-off', !box.checked);
      if(body) body.style.display = box.checked ? '' : 'none';
      if(arrow) arrow.innerHTML = box.checked ? '&#9662;' : '&#9656;';
    });
  });
}

// Only writes down what actually differs from the default, so the stored map
// stays small and a tab added to the portal later is visible by default
// rather than silently closed for every existing client.
function readClientPortalSections(){
  const root = $('clientAccessPortalSections');
  const out = {};
  if(!root) return out;
  CLIENT_PORTAL_SECTIONS.forEach(t => {
    const tabBox = root.querySelector(`.cp-tab-cb[data-cp-tab="${t.key}"]`);
    const entry = {};
    if(tabBox && !tabBox.checked) entry.view = false;
    const subs = {};
    (t.subs || []).forEach(sub => {
      const b = root.querySelector(`.cp-sub-cb[data-cp-tab="${t.key}"][data-cp-sub="${sub.key}"]`);
      if(b && !b.checked) subs[sub.key] = false;
    });
    if(Object.keys(subs).length) entry.subtabs = subs;
    if(Object.keys(entry).length) out[t.key] = entry;
  });
  return out;
}

let clientAccessTargetId = null;
async function openClientAccessModal(clientId, clientName){
  clientAccessTargetId = clientId;
  $('clientAccessName').textContent = clientName;
  $('clientAccessMsg').textContent = '';
  const [{ data: account, error: accountErr }, { data: current }, { data: currentGuides }] = await Promise.all([
    sb.from('client_accounts').select('email, phone, company_name, reports_enabled, reports_show_hours, portal_sections').eq('id', clientId).maybeSingle(),
    sb.from('client_campaign_access').select('form_id').eq('client_id', clientId),
    sb.from('client_campaign_guide_access').select('campaign_norm_name').eq('client_id', clientId),
  ]);
  // A failed fetch here (e.g. a column this query expects hasn't been
  // migrated in yet) must never look like "this client just has no email/
  // phone saved" -- that silently blanked every field below and made Save
  // fail with a confusing "Email is required", with no clue why.
  if(accountErr){
    $('clientAccessMsg').textContent = 'Failed to load this client\'s info: ' + accountErr.message;
    $('clientAccessModalOverlay').classList.add('active');
    return;
  }
  $('clientAccessEmail').value = (account && account.email) || '';
  $('clientAccessPhone').value = (account && account.phone) || '';
  $('clientAccessCompany').value = (account && account.company_name) || '';
  $('clientAccessReportsEnabled').checked = !!(account && account.reports_enabled);
  $('clientAccessReportsShowHours').checked = !(account && account.reports_show_hours === false);
  // v776: portal_sections may be missing on a database that has not had the
  // v776 migration yet — an empty map renders every tab ticked, which is
  // exactly how the portal behaves without the column.
  renderClientPortalSections((account && account.portal_sections) || {});
  await renderClientCampaignCheckboxes($('clientAccessCampaignList'), (current || []).map(r => r.form_id));
  await renderClientGuideCheckboxes($('clientAccessGuideList'), (currentGuides || []).map(r => r.campaign_norm_name));
  await renderClientReadyModeChannelCheckboxes($('clientAccessChannelList'), clientId);
  $('clientAccessModalOverlay').classList.add('active');
}
$('clientAccessCancelBtn').addEventListener('click', () => $('clientAccessModalOverlay').classList.remove('active'));
$('clientAccessModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'clientAccessModalOverlay') $('clientAccessModalOverlay').classList.remove('active'); });
$('clientAccessSaveBtn').addEventListener('click', async () => {
  const msg = $('clientAccessMsg');
  msg.textContent = '';
  const email = $('clientAccessEmail').value.trim();
  const phone = $('clientAccessPhone').value.trim();
  const company_name = $('clientAccessCompany').value.trim();
  if(!email){ msg.textContent = 'Email is required.'; return; }
  const form_ids = Array.from(document.querySelectorAll('#clientAccessCampaignList .client-campaign-cb:checked')).map(cb => cb.value);
  const guides = Array.from(document.querySelectorAll('#clientAccessGuideList .client-guide-cb:checked')).map(cb => ({ norm_name: cb.value, display_name: cb.dataset.displayName }));
  const btn = $('clientAccessSaveBtn');
  btn.disabled = true;
  // v154/v233: email/phone/company_name go through manage-client's own
  // update_contact action — email is a real auth-level change (the
  // client's actual login), not just a display field, so it can't be a
  // plain client_accounts update the way phone/company_name alone could be.
  const contactResult = await invokeManageClient({ action: 'update_contact', clientId: clientAccessTargetId, email, phone, company_name });
  if(!contactResult.ok){ btn.disabled = false; msg.textContent = contactResult.error || 'Failed to update email/phone.'; return; }
  const result = await invokeManageClient({ action: 'update_access', clientId: clientAccessTargetId, form_ids });
  if(!result.ok){ btn.disabled = false; msg.textContent = result.error || 'Failed to update access.'; return; }
  const guideResult = await invokeManageClient({ action: 'update_guide_access', clientId: clientAccessTargetId, guides });
  if(!guideResult.ok){ btn.disabled = false; msg.textContent = guideResult.error || 'Saved, but Campaign Guide access failed to update.'; return; }
  // reports_enabled isn't auth-sensitive (unlike email above), so it's a
  // plain direct client_accounts update under the existing owner/admin RLS
  // policy rather than a new manage-client action -- same precedent this
  // table's `phone` field already uses elsewhere.
  const reportsEnabled = $('clientAccessReportsEnabled').checked;
  const reportsShowHours = $('clientAccessReportsShowHours').checked;
  const portalSections = readClientPortalSections();
  const { error: reportsErr } = await sb.from('client_accounts').update({ reports_enabled: reportsEnabled, reports_show_hours: reportsShowHours, portal_sections: portalSections }).eq('id', clientAccessTargetId);
  if(reportsErr){ btn.disabled = false; msg.textContent = 'Saved, but the Reports toggle failed to update: ' + reportsErr.message; return; }
  // Channels taken by another client never get this checkbox class (see
  // renderClientReadyModeChannelCheckboxes), so every box here is safely
  // either already this client's or unassigned -- checked assigns it,
  // unchecked clears it, one id-keyed call per row (set_channel_client,
  // not the accountDomain/channelName upsert save_lead_posting_channel
  // needs, since this modal never loaded those fields).
  const channelBoxes = Array.from(document.querySelectorAll('#clientAccessChannelList .client-channel-cb'));
  for(const cb of channelBoxes){
    const channelResult = await callRmApi({ action: 'set_channel_client', channelId: cb.value, clientId: cb.checked ? clientAccessTargetId : null });
    if(!channelResult.ok){ btn.disabled = false; msg.textContent = 'Saved, but a campaign assignment failed to update: ' + (channelResult.error || 'unknown error'); return; }
  }
  btn.disabled = false;
  logActivity('client.update_access', 'client', clientAccessTargetId, `Updated contact info, campaign access (${form_ids.length} campaign${form_ids.length === 1 ? '' : 's'}), Campaign Guide access (${guides.length}), Reports tab (${reportsEnabled ? 'enabled' : 'disabled'}) and portal access (${Object.keys(portalSections).length} tab${Object.keys(portalSections).length === 1 ? '' : 's'} restricted)`);
  $('clientAccessModalOverlay').classList.remove('active');
  loadUmClientsList();
  // v502/v504/v505: confirms exactly what update_contact actually did --
  // previously the only feedback here was a Stripe-failure alert, so a
  // plain email/phone/company change (the vast majority of saves) closed
  // the modal with zero confirmation either way. `changed` reports each
  // field against what was actually stored before this save (not just
  // "was it in the request"), so re-saving unchanged values doesn't
  // falsely claim something updated. Stripe sync status (email and/or
  // phone, whichever were present, and only when this client has a Stripe
  // customer to sync to) is appended to the same message rather than a
  // separate alert.
  const changed = contactResult.changed || {};
  const changedLabels = [];
  if(changed.email) changedLabels.push('email');
  if(changed.phone) changedLabels.push('phone number');
  if(changed.companyName) changedLabels.push('company name');
  let contactMsg = changedLabels.length ? `Updated ${changedLabels.join(', ')}.` : '';
  if(contactResult.stripeWarning) contactMsg = contactMsg ? `${contactMsg} ${contactResult.stripeWarning}` : contactResult.stripeWarning;
  else if(contactResult.stripeSynced) contactMsg = contactMsg ? `${contactMsg} Synced to Stripe.` : 'Synced to Stripe.';
  if(contactMsg) alert(contactMsg);
});

// ---- row actions: reset password / deactivate / reactivate ----
$('umClientsTbody').addEventListener('click', async (e) => {
  const accessBtn = e.target.closest('.client-access-btn');
  if(accessBtn){ openClientAccessModal(accessBtn.dataset.clientId, accessBtn.dataset.clientName); return; }

  const resetBtn = e.target.closest('.client-reset-btn');
  if(resetBtn){
    const newPassword = generatePassword();
    if(!confirm(`Reset the password for ${resetBtn.dataset.clientEmail}? They'll be required to set a new one on next login.`)) return;
    resetBtn.disabled = true;
    const result = await invokeManageClient({ action: 'set_password', clientId: resetBtn.dataset.clientId, password: newPassword });
    resetBtn.disabled = false;
    if(!result.ok){ alert(result.error || 'Failed to reset password.'); return; }
    logActivity('client.reset_password', 'client', resetBtn.dataset.clientId, `Reset password for ${resetBtn.dataset.clientEmail}`);
    // v160: opt-in, second explicit prompt — only offered at all if this
    // client actually has a phone number on file, since otherwise the
    // send would just silently no-op anyway.
    // v200: awaited now, and the final alert says exactly what happened
    // rather than assuming success — same fix as the Add Client flow.
    let smsNote = '';
    if(resetBtn.dataset.clientPhone && confirm('Also text this new password to the client via SMS?')){
      const smsResult = await callSendClientSms(resetBtn.dataset.clientId, 'account_password', newPassword);
      smsNote = smsResult.ok ? '\n\n(Also sent via SMS.)' : `\n\n(SMS could not be sent: ${smsResult.error || 'unknown error'} — share the password below directly.)`;
    }
    alert(`New temporary password: ${newPassword}\n\nShare this with the client — it won't be shown again.${smsNote}`);
    loadUmClientsList();
    return;
  }

  const toggleBtn = e.target.closest('.client-toggle-btn');
  if(toggleBtn){
    const isActive = toggleBtn.dataset.active === 'true';
    const nextActive = !isActive;
    if(!confirm(nextActive ? 'Reactivate this client account?' : 'Deactivate this client account? They will no longer be able to sign in.')) return;
    toggleBtn.disabled = true;
    const result = await invokeManageClient({ action: 'set_active', clientId: toggleBtn.dataset.clientId, isActive: nextActive });
    toggleBtn.disabled = false;
    if(!result.ok){ alert(result.error || 'Failed to update status.'); return; }
    logActivity(nextActive ? 'client.reactivate' : 'client.deactivate', 'client', toggleBtn.dataset.clientId, nextActive ? 'Reactivated client account' : 'Deactivated client account');
    loadUmClientsList();
    return;
  }

  // v199: "Log in as client" — mints a one-time sign-in token
  // server-side (never a plaintext password) and opens the client
  // portal in a new tab already signed in as this client, so an
  // Owner/Admin can see exactly what they see. Logged like every other
  // sensitive client-account action here, since it's real account access.
  const impersonateBtn = e.target.closest('.client-impersonate-btn');
  if(impersonateBtn){
    impersonateBtn.disabled = true;
    const origText = impersonateBtn.textContent;
    impersonateBtn.textContent = 'Opening…';
    const result = await invokeManageClient({ action: 'impersonate', clientId: impersonateBtn.dataset.clientId });
    impersonateBtn.disabled = false;
    impersonateBtn.textContent = origText;
    if(!result.ok || !result.tokenHash){ alert(result.error || 'Failed to open the client portal as this client.'); return; }
    logActivity('client.impersonate', 'client', impersonateBtn.dataset.clientId, `Logged in as client "${impersonateBtn.dataset.clientName}" to view their portal`);
    window.open(`${CLIENT_PORTAL_URL.replace(/\/$/, '')}?staff_token=${encodeURIComponent(result.tokenHash)}`, '_blank', 'noopener');
    return;
  }

  // v200: permanent delete — Owner-only (see manage-client's
  // delete_client action, which enforces this again server-side; this
  // button also only ever renders for myIsOwner in the first place, see
  // loadUmClientsList()). Deactivate is the reversible option everyone
  // with Owner/Admin already has via the button next to this one — this
  // is only for actually removing an account for good.
  const deleteBtn = e.target.closest('.client-delete-btn');
  if(deleteBtn){
    const email = deleteBtn.dataset.clientEmail;
    if(!confirm(`Permanently delete the client account for ${email}?\n\nThis can't be undone — their login, campaign access, and portal chat history are all removed. If you just need to revoke access, use Deactivate instead.`)) return;
    deleteBtn.disabled = true;
    const result = await invokeManageClient({ action: 'delete_client', clientId: deleteBtn.dataset.clientId });
    deleteBtn.disabled = false;
    if(!result.ok){ alert(result.error || 'Failed to delete client.'); return; }
    logActivity('client.delete', 'client', deleteBtn.dataset.clientId, `Permanently deleted client account for ${email}`);
    loadUmClientsList();
  }
});

$('acctSaveBtn').addEventListener('click', async () => {
  const msg = $('acctMsg');
  msg.textContent = ''; msg.className = 'msg';
  const full_name = $('acctFullName').value.trim();
  const role = $('acctRole').value;
  const email = $('acctEmailInput').value.trim();
  if(!email){
    msg.textContent = 'Email is required.';
    msg.className = 'msg error';
    return;
  }
  const result = await callManageUser('update_profile', { full_name, role, email });
  if(!result.ok){
    msg.textContent = result.error || 'Failed to save.';
    msg.className = 'msg error';
    return;
  }

  // v643: department/title/grade go through their own RPC, because profiles
  // UPDATE is self-only and manage-user does not own these columns. Reported
  // separately and honestly -- name/role/email are already saved by now, so
  // a failure here is "some of it saved", not "nothing saved".
  const department = $('acctDepartment').value;
  const title = $('acctTitle').value.trim();
  const grade = $('acctGrade').value;
  const org = await saveStaffOrgInfo(currentDetailAgent.id, department, title, grade);
  if(!org.ok){
    msg.textContent = `Name, user type and email were saved, but the department/title was not: ${org.error}`;
    msg.className = 'msg error';
  }else{
    msg.textContent = 'Saved.';
    msg.className = 'msg ok';
    currentDetailAgent.department = department || null;
    currentDetailAgent.title = title || null;
    currentDetailAgent.grade = grade || null;
    detailSetTitleDept(currentDetailAgent); // refresh the line under the name
  }

  // v727: the American name, through its own Owner/Admin RPC for the same
  // reason as the org info above. Only sent when it changed.
  const americanName = $('acctAmericanName').value.trim();
  if(!$('acctAmericanName').disabled && americanName !== (currentDetailAgent.american_name || '')){
    const { error: anErr } = await sb.rpc('set_staff_american_name', { target: currentDetailAgent.id, p_name: americanName || null });
    if(anErr){
      msg.textContent = `Everything else was saved, but the American name was not: ${anErr.message}`;
      msg.className = 'msg error';
    }else{
      currentDetailAgent.american_name = americanName || null;
      logActivity('user.american_name', 'agent', currentDetailAgent.id, americanName ? `American name set to "${americanName}"` : 'American name cleared');
    }
  }

  const wasRole = currentDetailAgent.role;
  currentDetailAgent.full_name = full_name;
  currentDetailAgent.role = role;
  currentDetailAgent.email = email;
  $('detailName').textContent = full_name || currentDetailAgent.email;
  logActivity('user.update', 'agent', currentDetailAgent.id, `Updated ${email} — name: "${full_name}", role: ${role}, ${[title, department, grade].filter(Boolean).join(' · ') || 'uncategorised'}`);
  if(role !== wasRole && PROTECTED_ROLES.has(role)){
    // promoted out of the agent list — nothing left here to manage
    $('backLink').click();
  }
  loadTeam();
  // v643: the Users list has Title and Department columns, so it is stale
  // the moment either changes here.
  if(typeof umActiveSection !== 'undefined' && umActiveSection === 'users') loadUmUsersList();
});

$('acctSetPasswordBtn').addEventListener('click', async () => {
  const msg = $('acctPasswordMsg');
  msg.textContent = ''; msg.className = 'msg';
  const password = $('acctNewPassword').value;
  if(!password || password.length < 8){
    msg.textContent = 'Password must be at least 8 characters.';
    msg.className = 'msg error';
    return;
  }
  const result = await callManageUser('set_password', { password });
  if(!result.ok){
    msg.textContent = result.error || 'Failed to set password.';
    msg.className = 'msg error';
    return;
  }
  $('acctNewPassword').value = '';
  msg.textContent = 'Password updated.';
  msg.className = 'msg ok';
  logActivity('user.set_password', 'agent', currentDetailAgent.id, `Set a new password for ${currentDetailAgent.email}`);
});

// ---------- account status: activate / deactivate ----------
// Deactivating goes through manage-user's set_active action, which bans the
// account at the Supabase Auth level (blocking sign-in and token refresh —
// the real enforcement) and mirrors the state onto profiles.is_active
// (what this badge and the Users list read). Reversible at any time,
// unlike Delete — tracking history, screenshots, and leads are untouched.
function renderAcctStatus(agent){
  const isActive = agent.is_active !== false; // treat missing/null (pre-migration rows) as active
  const badge = $('acctStatusBadge');
  badge.textContent = isActive ? 'Active' : 'Deactivated';
  badge.style.color = isActive ? 'var(--good)' : 'var(--danger)';
  $('acctToggleActiveBtn').textContent = isActive ? 'Deactivate…' : 'Reactivate';
  $('acctToggleActiveBtn').className = isActive ? 'btn-secondary' : 'btn-primary';
}

$('acctToggleActiveBtn').addEventListener('click', async () => {
  const agent = currentDetailAgent;
  const isActive = agent.is_active !== false;
  const msg = $('acctStatusMsg');
  msg.textContent = ''; msg.className = 'msg';
  if(isActive){
    const ok = confirm(`Deactivate ${agent.full_name || agent.email}? They won't be able to sign in to the dashboard or extension until reactivated. Their tracked time, screenshots, and leads are all kept.`);
    if(!ok) return;
  }
  const btn = $('acctToggleActiveBtn');
  btn.disabled = true;
  const result = await callManageUser('set_active', { isActive: !isActive });
  btn.disabled = false;
  if(!result.ok){
    msg.textContent = result.error || 'Failed to update account status.';
    msg.className = 'msg error';
    return;
  }
  currentDetailAgent.is_active = !isActive;
  renderAcctStatus(currentDetailAgent);
  msg.textContent = !isActive ? 'Account deactivated.' : 'Account reactivated.';
  msg.className = 'msg ok';
  logActivity(!isActive ? 'user.deactivate' : 'user.reactivate', 'agent', agent.id, `${!isActive ? 'Deactivated' : 'Reactivated'} ${agent.email}`);
  loadTeam();
  if(umActiveSection === 'users') loadUmUsersList();
});

$('acctDeleteBtn').addEventListener('click', () => {
  $('acctDeleteName').textContent = currentDetailAgent.full_name || currentDetailAgent.email;
  $('acctDeleteEmailHint').textContent = currentDetailAgent.email || '';
  $('acctDeleteStatusSelect').value = '';
  $('acctDeleteReasonInput').value = '';
  $('acctDeleteConfirmInput').value = '';
  $('acctDeleteMsg').textContent = '';
  $('acctDeleteConfirmBtn').disabled = true;
  $('acctDeleteModalOverlay').classList.add('active');
});
$('acctDeleteCancelBtn').addEventListener('click', () => $('acctDeleteModalOverlay').classList.remove('active'));
$('acctDeleteModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'acctDeleteModalOverlay') $('acctDeleteModalOverlay').classList.remove('active'); });
// v371: Delete now also requires a reason (Terminated / Found another
// offer, plus free text) -- the email-confirm match alone no longer
// enables the button.
function updateAcctDeleteConfirmEnabled(){
  const emailMatch = $('acctDeleteConfirmInput').value.trim().toLowerCase() === (currentDetailAgent.email || '').toLowerCase();
  const hasStatus = !!$('acctDeleteStatusSelect').value;
  const hasReason = !!$('acctDeleteReasonInput').value.trim();
  $('acctDeleteConfirmBtn').disabled = !(emailMatch && hasStatus && hasReason);
}
$('acctDeleteConfirmInput').addEventListener('input', updateAcctDeleteConfirmEnabled);
$('acctDeleteStatusSelect').addEventListener('change', updateAcctDeleteConfirmEnabled);
$('acctDeleteReasonInput').addEventListener('input', updateAcctDeleteConfirmEnabled);
$('acctDeleteConfirmBtn').addEventListener('click', async () => {
  const msg = $('acctDeleteMsg');
  const btn = $('acctDeleteConfirmBtn');
  btn.disabled = true;
  const agent = currentDetailAgent;
  const terminationStatus = $('acctDeleteStatusSelect').value;
  const terminationReason = $('acctDeleteReasonInput').value.trim();
  const result = await callManageUser('delete_user', { terminationStatus, terminationReason });
  if(!result.ok){
    msg.textContent = result.error || 'Failed to delete user.';
    btn.disabled = false;
    return;
  }
  $('acctDeleteModalOverlay').classList.remove('active');
  const statusLabel = terminationStatus === 'found_other_offer' ? 'Found another offer' : 'Terminated';
  logActivity('user.delete', 'agent', agent.id, `Deleted user ${agent.email} — ${statusLabel}: ${terminationReason}`);
  $('backLink').click();
  loadTeam();
});

function populateTimezoneSelect(){
  const sel = $('timezoneInput');
  if(sel.dataset.populated) return;
  let zones;
  try{
    zones = Intl.supportedValuesOf('timeZone');
  }catch(e){
    // fallback for older browsers without Intl.supportedValuesOf
    zones = ['UTC','Africa/Cairo','Europe/London','Europe/Berlin','America/New_York','America/Chicago','America/Los_Angeles','Asia/Dubai','Asia/Karachi','Asia/Kolkata','Asia/Dhaka','Asia/Singapore','Asia/Tokyo','Australia/Sydney'];
  }
  sel.innerHTML = zones.map(z => `<option value="${z}">${z}</option>`).join('');
  sel.dataset.populated = '1';
}

function updateLeadBonusRateLabel(){
  $('leadBonusRateLabel').textContent = $('leadBonusTypeInput').value === 'bulk'
    ? 'Bonus rate ($ flat, once)'
    : 'Bonus rate ($ per lead)';
}
$('leadBonusTypeInput').addEventListener('change', updateLeadBonusRateLabel);

// ---------- extra target tiers (Schedule card) ----------
// Each row: how many leads past the base target unlocks this tier, the
// bonus amount, and which currency it was entered in. Rendered as plain
// DOM rows (not a template string re-render) so an admin's in-progress
// typing in one row isn't lost when another row is added/removed.
function addExtraTierRow(tier){
  tier = tier || { extra_leads: '', bonus: '', currency: 'USD' };
  const row = document.createElement('div');
  row.className = 'extra-tier-row';
  row.style.cssText = 'display:flex; gap:8px; align-items:center;';
  row.innerHTML = `
    <input type="number" class="extra-tier-leads edit-only comp-edit-only" min="1" step="1" placeholder="Extra leads (e.g. 10)" value="${tier.extra_leads != null ? tier.extra_leads : ''}" style="flex:1;">
    <input type="number" class="extra-tier-bonus edit-only comp-edit-only" min="0" step="0.01" placeholder="Bonus (e.g. 50)" value="${tier.bonus != null ? tier.bonus : ''}" style="flex:1;">
    <select class="extra-tier-currency edit-only comp-edit-only" style="width:90px; flex:0 0 90px;">
      <option value="USD" ${tier.currency === 'EGP' ? '' : 'selected'}>USD</option>
      <option value="EGP" ${tier.currency === 'EGP' ? 'selected' : ''}>EGP</option>
    </select>
    <button type="button" class="btn-secondary extra-tier-remove edit-only comp-edit-only" style="width:auto; padding:8px 12px; color:var(--danger);">✕</button>
  `;
  row.querySelector('.extra-tier-remove').addEventListener('click', () => row.remove());
  $('extraTiersList').appendChild(row);
  applyTimeManagementSectionEditGating('staff'); // this row was just added dynamically — pick up the same lock state as everything else
  applyCompensationEditGating();
}
$('addExtraTierBtn').addEventListener('click', () => addExtraTierRow());

function readExtraTiers(){
  return Array.from(document.querySelectorAll('#extraTiersList .extra-tier-row')).map(row => ({
    extra_leads: parseInt(row.querySelector('.extra-tier-leads').value, 10) || 0,
    bonus: parseFloat(row.querySelector('.extra-tier-bonus').value) || 0,
    currency: row.querySelector('.extra-tier-currency').value || 'USD',
  })).filter(t => t.extra_leads > 0); // a tier with no threshold set can never qualify — drop it rather than save junk
}

// ---------- lead-tier flat salary (Schedule card, v498) ----------
// Same plain-DOM-rows pattern as addExtraTierRow above (in-progress typing
// in one row survives another row being added/removed). Unlike extra
// tiers (which stack ON TOP of a base hourly+bonus pay), min_leads: 0 is
// meaningful and expected here — it's the base/floor salary tier, not a
// "no threshold set" junk row, so 0 is explicitly allowed (only a blank
// min_leads field is dropped on save, see readSalaryTiers below).
function addSalaryTierRow(tier){
  tier = tier || { min_leads: '', amount: '', currency: 'USD' };
  const row = document.createElement('div');
  row.className = 'salary-tier-row';
  row.style.cssText = 'display:flex; gap:8px; align-items:center;';
  row.innerHTML = `
    <input type="number" class="salary-tier-min-leads edit-only comp-edit-only" min="0" step="1" placeholder="Min accepted leads (e.g. 0, 40, 50, 60)" value="${tier.min_leads != null ? tier.min_leads : ''}" style="flex:1;">
    <input type="number" class="salary-tier-amount edit-only comp-edit-only" min="0" step="0.01" placeholder="Monthly salary (e.g. 300)" value="${tier.amount != null ? tier.amount : ''}" style="flex:1;">
    <select class="salary-tier-currency edit-only comp-edit-only" style="width:90px; flex:0 0 90px;">
      <option value="USD" ${tier.currency === 'EGP' ? '' : 'selected'}>USD</option>
      <option value="EGP" ${tier.currency === 'EGP' ? 'selected' : ''}>EGP</option>
    </select>
    <button type="button" class="btn-secondary salary-tier-remove edit-only comp-edit-only" style="width:auto; padding:8px 12px; color:var(--danger);">✕</button>
  `;
  row.querySelector('.salary-tier-remove').addEventListener('click', () => row.remove());
  $('salaryTiersList').appendChild(row);
  applyTimeManagementSectionEditGating('staff');
  applyCompensationEditGating();
}
$('addSalaryTierBtn').addEventListener('click', () => addSalaryTierRow());

function readSalaryTiers(){
  return Array.from(document.querySelectorAll('#salaryTiersList .salary-tier-row'))
    .filter(row => row.querySelector('.salary-tier-min-leads').value.trim() !== '') // blank threshold -> can never be distinguished from the 0 tier, drop rather than save junk
    .map(row => ({
      min_leads: parseInt(row.querySelector('.salary-tier-min-leads').value, 10) || 0,
      amount: parseFloat(row.querySelector('.salary-tier-amount').value) || 0,
      currency: row.querySelector('.salary-tier-currency').value || 'USD',
    }));
}

// v499: narrower than applyTimeManagementSectionEditGating('staff') --
// that one already disables every .edit-only field in the Schedule panel
// for a role without can_manage_users at all. This runs AFTER it and
// additionally locks just the .comp-edit-only subset (pay-related fields)
// for a role that CAN manage users/schedules but was not separately
// granted can_edit_compensation. Owner/Admin (isProtected) always pass.
function canEditCompensationFields(){
  if(myPermissions.isProtected) return true;
  return !!myPermissions.canEditCompensation;
}
function applyCompensationEditGating(){
  const panel = document.getElementById('tmSection-staff');
  if(!panel) return;
  // Only tightens further -- never re-enables a field
  // applyTimeManagementSectionEditGating('staff') already disabled for a
  // broader reason (no can_manage_users at all).
  if(canEditCompensationFields()) return;
  panel.querySelectorAll('.comp-edit-only').forEach(el => {
    el.disabled = true;
    el.style.opacity = '0.4';
    el.style.cursor = 'not-allowed';
    el.title = "Your role doesn't have permission to edit compensation.";
  });
}

function applyPayModelVisibility(){
  const isTierSalary = $('payModelInput').value === 'lead_tier_salary';
  $('hourlyRateFieldWrap').style.display = isTierSalary ? 'none' : '';
  $('hourlyBonusExtrasWrap').style.display = isTierSalary ? 'none' : '';
  $('leadTierSalaryWrap').style.display = isTierSalary ? '' : 'none';
}
$('payModelInput').addEventListener('change', applyPayModelVisibility);

async function loadSchedule(agentId){
  populateTimezoneSelect();
  const { data } = await sb.from('schedules').select('*').eq('user_id', agentId).maybeSingle();
  $('employmentType').value = data ? data.employment_type : 'full_time';
  $('dailyLimitInput').value = data ? data.daily_limit_minutes : 480;
  $('weeklyLimitInput').value = data ? data.weekly_limit_minutes : 2400;
  $('breakAllowanceInput').value = data ? data.daily_break_allowance_minutes : 60;
  $('idleLimitInput').value = (data && data.daily_idle_limit_minutes != null) ? data.daily_idle_limit_minutes : '';
  $('tabSwitchGraceInput').value = (data && data.tab_switch_grace_seconds != null) ? data.tab_switch_grace_seconds : '';
  $('hourlyRateInput').value = (data && data.hourly_rate != null) ? data.hourly_rate : '';
  $('hourlyRateCurrencyInput').value = (data && data.hourly_rate_currency) ? data.hourly_rate_currency : 'USD';
  $('targetLeadsInput').value = (data && data.target_leads != null) ? data.target_leads : '';
  $('leadBonusTypeInput').value = (data && data.lead_bonus_type) ? data.lead_bonus_type : 'per_lead';
  $('leadBonusRateInput').value = (data && data.lead_bonus_rate != null) ? data.lead_bonus_rate : '';
  $('leadBonusCurrencyInput').value = (data && data.lead_bonus_currency) ? data.lead_bonus_currency : 'USD';
  updateLeadBonusRateLabel();
  $('extraTiersList').innerHTML = '';
  const tiers = (data && Array.isArray(data.extra_target_tiers)) ? data.extra_target_tiers : [];
  tiers.forEach(t => addExtraTierRow(t));
  $('payModelInput').value = (data && data.pay_model) ? data.pay_model : 'hourly_bonus';
  $('salaryTiersList').innerHTML = '';
  const salaryTiers = (data && Array.isArray(data.salary_tiers)) ? data.salary_tiers : [];
  salaryTiers.forEach(t => addSalaryTierRow(t));
  applyPayModelVisibility();
  // no schedule row yet, or an old row saved before this column existed —
  // default to every day checked so behavior matches "no restriction"
  const workingDays = (data && Array.isArray(data.working_days) && data.working_days.length)
    ? data.working_days.map(Number)
    : [0,1,2,3,4,5,6];
  document.querySelectorAll('.working-day-cb').forEach(cb => {
    cb.checked = workingDays.includes(parseInt(cb.value, 10));
  });
  $('enforceShiftInput').checked = data ? !!data.enforce_shift : false;
  $('shiftStartInput').value = data && data.shift_start ? data.shift_start.slice(0,5) : '';
  $('shiftEndInput').value = data && data.shift_end ? data.shift_end.slice(0,5) : '';
  $('timezoneInput').value = data && data.timezone ? data.timezone : Intl.DateTimeFormat().resolvedOptions().timeZone;
  // v1.2.9: populate + load the day cutover hour (0-23), default 6.
  const cutSel = $('dayCutoverInput');
  if(cutSel){
    if(!cutSel.options.length){
      cutSel.innerHTML = Array.from({length:24}, (_,h) => {
        const label = `${String(h).padStart(2,'0')}:00 (${h===0?'12 AM':h<12?h+' AM':h===12?'12 PM':(h-12)+' PM'})`;
        return `<option value="${h}">${label}</option>`;
      }).join('');
    }
    cutSel.value = (data && Number.isInteger(data.day_cutover_hour)) ? data.day_cutover_hour : 6;
  }
  $('scheduleMsg').textContent = '';
  applyTimeManagementSectionEditGating('staff');
  applyCompensationEditGating();
}

$('saveScheduleBtn').addEventListener('click', async () => {
  if(!currentDetailAgent) return;
  const enforceShift = $('enforceShiftInput').checked;
  const shiftStart = $('shiftStartInput').value;
  const shiftEnd = $('shiftEndInput').value;
  const msg = $('scheduleMsg');

  if(enforceShift && (!shiftStart || !shiftEnd)){
    msg.textContent = 'Set both a shift start and end time, or turn off shift enforcement.';
    msg.className = 'msg error';
    return;
  }
  // audit fix (Time Management deep-scan pass): shift_start === shift_end
  // used to save silently — the extension's own checkShiftWindow() treats
  // that as bad config and fails OPEN (enforcement silently does nothing),
  // so an admin could save what looks like a valid shift window and get a
  // clean "Saved." with zero indication that enforcement is actually a
  // no-op. Caught here with a clear message; a DB CHECK constraint
  // (schedules_shift_window_valid, v484 migration) is the backstop for any
  // other write path.
  if(enforceShift && shiftStart === shiftEnd){
    msg.textContent = 'Shift start and end can’t be the same time — that would disable enforcement entirely.';
    msg.className = 'msg error';
    return;
  }

  const idleLimitRaw = $('idleLimitInput').value.trim();
  const dailyIdleLimitMinutes = idleLimitRaw === '' ? null : (parseInt(idleLimitRaw, 10) || 0);
  // v: was create-only-via-SQL -- schedules.tab_switch_grace_seconds has
  // existed since v1.2.1 (how long an agent can be off their tracked tab
  // before the extension counts it as idle) but had no dashboard UI at
  // all, only settable by hand in the database. Same "blank = fall back to
  // the extension's own default" contract as daily_idle_limit_minutes
  // above -- null here means the extension uses its built-in 20s default.
  const tabSwitchGraceRaw = $('tabSwitchGraceInput').value.trim();
  const tabSwitchGraceSeconds = tabSwitchGraceRaw === '' ? null : (parseInt(tabSwitchGraceRaw, 10) || 0);
  const hourlyRateRaw = $('hourlyRateInput').value.trim();
  const hourlyRate = hourlyRateRaw === '' ? null : (parseFloat(hourlyRateRaw) || 0);
  const targetLeadsRaw = $('targetLeadsInput').value.trim();
  const targetLeads = targetLeadsRaw === '' ? null : (parseInt(targetLeadsRaw, 10) || 0);
  const leadBonusRateRaw = $('leadBonusRateInput').value.trim();
  const leadBonusRate = leadBonusRateRaw === '' ? null : (parseFloat(leadBonusRateRaw) || 0);

  const workingDays = Array.from(document.querySelectorAll('.working-day-cb'))
    .filter(cb => cb.checked)
    .map(cb => parseInt(cb.value, 10))
    .sort((a,b) => a-b);
  if (workingDays.length === 0) {
    msg.textContent = 'Select at least one working day, or check all 7 for no restriction.';
    msg.className = 'msg error';
    return;
  }

  const payload = {
    user_id: currentDetailAgent.id,
    employment_type: $('employmentType').value,
    daily_limit_minutes: parseInt($('dailyLimitInput').value, 10) || 0,
    weekly_limit_minutes: parseInt($('weeklyLimitInput').value, 10) || 0,
    daily_break_allowance_minutes: parseInt($('breakAllowanceInput').value, 10) || 0,
    daily_idle_limit_minutes: dailyIdleLimitMinutes,
    tab_switch_grace_seconds: tabSwitchGraceSeconds,
    hourly_rate: hourlyRate,
    hourly_rate_currency: $('hourlyRateCurrencyInput').value || 'USD',
    target_leads: targetLeads,
    lead_bonus_type: $('leadBonusTypeInput').value || 'per_lead',
    lead_bonus_rate: leadBonusRate,
    lead_bonus_currency: $('leadBonusCurrencyInput').value || 'USD',
    extra_target_tiers: readExtraTiers(),
    pay_model: $('payModelInput').value || 'hourly_bonus',
    salary_tiers: readSalaryTiers(),
    timezone: $('timezoneInput').value || 'UTC',
    day_cutover_hour: (function(){ const v = parseInt($('dayCutoverInput') && $('dayCutoverInput').value, 10); return (Number.isInteger(v) && v>=0 && v<=23) ? v : 6; })(),
    shift_start: shiftStart || null,
    shift_end: shiftEnd || null,
    enforce_shift: enforceShift,
    working_days: workingDays,
    updated_at: new Date().toISOString(),
  };
  const { error } = await sb.from('schedules').upsert(payload, { onConflict: 'user_id' });
  if(error){
    msg.textContent = error.message;
    msg.className = 'msg error';
  } else {
    msg.textContent = 'Saved.';
    msg.className = 'msg';
    msg.style.color = 'var(--focus)';
    const agentLabel = currentDetailAgent.full_name || currentDetailAgent.email;
    const shiftNote = enforceShift ? `, shift ${shiftStart}\u2013${shiftEnd} ${payload.timezone}` : '';
    const idleNote = dailyIdleLimitMinutes != null ? `, idle limit ${dailyIdleLimitMinutes}m/day` : '';
    const graceNote = tabSwitchGraceSeconds != null ? `, tab-switch grace ${tabSwitchGraceSeconds}s` : '';
    const DAY_NAMES = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    const daysNote = workingDays.length < 7 ? `, working days ${workingDays.map(d=>DAY_NAMES[d]).join('/')}` : '';
    logActivity('schedule.update', 'agent', currentDetailAgent.id,
      `Updated schedule for ${agentLabel} (${payload.daily_limit_minutes}m/day, ${payload.weekly_limit_minutes}m/week${idleNote}${graceNote}${shiftNote}${daysNote})`);
  }
});

async function renderDetail(agent){
  // v1.2.9: fetch this agent's schedule so "Today's limit" / "This week's
  // limit" use their work-day cutover (default 6 AM in their timezone),
  // matching the extension's enforcement, so an overnight shift stays whole
  // and doesn't split at midnight.
  // Gap-#1 fix: previously fell back to todayRangeISO() (midnight cutover)
  // for the day boundary but weekStartCairoISO() (8 AM cutover) for the week
  // boundary — two different cutover hours for the SAME unscheduled agent in
  // the same render. Both now use the single FALLBACK_SCHEDULE (Africa/Cairo,
  // 8 AM cutover), matching the extension's enforcement fallback exactly.
  const { data: schedRow } = await sb.from('schedules').select('timezone, day_cutover_hour').eq('user_id', agent.id).maybeSingle();
  const effectiveSched = schedRow || { timezone: FALLBACK_TIMEZONE, day_cutover_hour: FALLBACK_CUTOVER_HOUR };
  const wdStartMs = workDayStartMsDash(effectiveSched);
  const wwStartMs = workWeekStartMsDash(effectiveSched);
  const wdStartISO = new Date(wdStartMs).toISOString();
  const wwStartISO = new Date(wwStartMs).toISOString();

  const { entries, idlePeriodsByEntry, breaksByEntry } = await fetchAgentEntries(agent.id, wdStartISO);
  const usedTodaySec = sumTrackedSecondsClipped(entries, idlePeriodsByEntry, breaksByEntry, wdStartMs);
  $('usedToday').textContent = fmtShort(usedTodaySec);

  const { data: breaksToday } = await sb.from('breaks')
    .select('start_time, end_time')
    .eq('user_id', agent.id).gte('start_time', wdStartISO);
  const tableBreakSec = (breaksToday || []).reduce((t,b) => {
    const bEnd = b.end_time ? new Date(b.end_time).getTime() : Date.now();
    return t + (bEnd - new Date(b.start_time).getTime())/1000;
  }, 0);
  // BUG FIX (live report: "adding break manually it doesn't reflect on
  // break"): this stat only ever queried the `breaks` table — a manual
  // entry's break_seconds (typed into the "+ Add time" modal) never has a
  // corresponding breaks row, so it silently never showed up here. `entries`
  // (fetched just above via fetchAgentEntries) already has every of today's
  // entries including manual ones — same reasoning/pattern
  // renderDayTimeline()'s own manualBreakSec uses.
  const manualBreakSec = (entries || []).filter(e => e.is_manual).reduce((t,e) => t + (e.break_seconds || 0), 0);
  const breakSec = tableBreakSec + manualBreakSec;
  $('breaksToday').textContent = fmtShort(breakSec);

  // v395: filtered to accepted — this stat sits directly under copy
  // saying only accepted leads count toward the target/bonus, and that's
  // exactly what computeAgentStats' own leadsCount (the real bonus input)
  // filters to. Previously this counted every submission regardless of
  // status, so it could read higher than what the agent's bonus was
  // actually computed from.
  //
  // v: and that alignment broke again the moment the bonus figure changed.
  // This still counted status='accepted' with no dedupe while payroll had
  // moved on, so the readout sitting under "only accepted leads count toward
  // the target" disagreed with the number the target is actually measured by.
  // Both now go through creditedLeadCount(), so they cannot drift apart again
  // without someone editing that one function.
  const leadsToday = await fetchAllRows((from, to) => sb.from('leads')
    .select(CREDITED_LEAD_COLS)
    .eq('user_id', agent.id)
    .in('status', CREDITED_LEAD_STATUSES)
    .gte('submitted_at', wdStartISO)
    .order('id', { ascending: true }).range(from, to));
  $('leadsToday').textContent = creditedLeadCount(leadsToday);

  // "This week's limit" — Monday-cutover work-week, active-only, matching the
  // extension's weekly enforcement.
  const { entries: weekEntries, idlePeriodsByEntry: weekIdlePeriodsByEntry, breaksByEntry: weekBreaksByEntry } = await fetchAgentEntries(agent.id, wwStartISO);
  const weekUsedSec = sumTrackedSecondsClipped(weekEntries, weekIdlePeriodsByEntry, weekBreaksByEntry, wwStartMs);
  $('weekUsedDetail').textContent = fmtShort(weekUsedSec);

  // v395: same accepted-only fix as leadsToday above.
  // v: and the same shared-rule fix — see leadsToday's comment.
  //
  // PAGED, and not as a formality. Counting the rejected rows too roughly
  // quadruples what this fetch returns: the busiest real month measured 600
  // rows against PostgREST's silent 1000-row default cap. Unpaged, this would
  // have kept working right up until a heavier month quietly truncated a
  // number an agent is measured by -- the same failure the activity_samples
  // audit found feeding the payroll report.
  const leadsMonth = await fetchAllRows((from, to) => sb.from('leads')
    .select(CREDITED_LEAD_COLS)
    .eq('user_id', agent.id)
    .in('status', CREDITED_LEAD_STATUSES)
    .gte('submitted_at', startOfMonthISO())
    .order('id', { ascending: true }).range(from, to));
  $('leadsMonthDetail').textContent = creditedLeadCount(leadsMonth);

  const dayMs = 24*3600*1000;
  const track = $('detailTimeline');
  track.innerHTML = '';
  const tasks = [...new Set(entries.map(e=>e.task_id))].map(id=>({id}));
  entries.forEach(e => {
    const end = e.end_time ? new Date(e.end_time).getTime() : Date.now();
    const startPct = Math.max(0, (new Date(e.start_time).getTime() - wdStartMs)/dayMs*100);
    const endPct = Math.min(100, (end - wdStartMs)/dayMs*100);
    const div = document.createElement('div');
    div.className = 'segment';
    div.style.left = startPct+'%';
    div.style.width = Math.max(0.15, endPct-startPct)+'%';
    div.style.background = colorFor(e.task_id, tasks);
    track.appendChild(div);
  });

  const nowISO = new Date().toISOString();
  const { data: visits } = await sb.from('url_visits')
    .select('domain, start_time, end_time')
    .eq('user_id', agent.id).gte('start_time', wdStartISO).lte('start_time', nowISO);
  renderSites(visits || []);

  const { data: shots } = await sb.from('screenshots')
    .select('id, storage_path, taken_at, activity_pct_at_capture')
    .eq('user_id', agent.id).gte('taken_at', wdStartISO).lte('taken_at', nowISO)
    .order('taken_at', { ascending: false });

  const grid = $('shotsGrid');
  grid.innerHTML = '';
  if(!shots || shots.length === 0){
    grid.innerHTML = '<div class="empty">No screenshots yet today.</div>';
    return;
  }
  const resolvedShots = [];
  for(const shot of shots){
    const { data: signed } = await sb.storage.from('screenshots').createSignedUrl(shot.storage_path, 3600);
    resolvedShots.push({
      url: signed ? signed.signedUrl : '',
      taken_at: shot.taken_at,
      activity_pct_at_capture: shot.activity_pct_at_capture,
    });
  }
  resolvedShots.forEach((shot, idx) => {
    const div = document.createElement('div');
    div.className = 'shot-card';
    div.innerHTML = `
      <img src="${shot.url}" loading="lazy">
      <div class="shot-meta">${new Date(shot.taken_at).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})} · ${shot.activity_pct_at_capture ?? '—'}%</div>
    `;
    div.addEventListener('click', () => openLightbox(resolvedShots, idx));
    grid.appendChild(div);
  });
}

// ===========================================================================
// v219: Finance tab — Spending (import Relay bank-statement CSVs,
// categorize, report), Invoice Archive (upload + archive invoice/receipt
// files for tax reconciliation), and Billing AK (v220, weekly agency_
// transactions import). Mirrors the Leads tab's 2-level tab/subtab pattern
// (initLeadsTab/activateLeadsSection), simplified since there's no
// per-section permission gating between these 3 subtabs — a role either
// has the whole Finance tab or none of it (see DASHBOARD_TAB_KEYS's own
// comment). v225: Finance is now grantable per role, not just the Owner —
// the real enforcement layer is RLS on every finance_*/billing_ak_*
// table/bucket, which checks `is_owner() OR role_has_any_tab('finance')`.
// ===========================================================================
// v358: Spending and Invoice Archive moved out to Taxes — see
// TAXES_SECTIONS below.
// v360: Billing AK moved out to Audit Log — Owner-only there, no longer
// grantable per role at all (see the migration note in CHANGELOG-v360).
const FINANCE_SECTIONS = [
  // v368: editable:true — Manage callers/Pause/Cancel/Convert to paid/Set
  // billing date are all real edit actions here (Delete stays Owner-only,
  // unrelated to this toggle, same as every other Finance subtab's Delete).
  // Previously hardcoded to myIsOwner/myRole==='admin' client-side with no
  // way to extend to a custom role at all -- see canManageStripe in
  // loadCampaignSubscriptionsStaffList and checkFinanceEditAccess() in
  // staff-manage-campaign-subscription for the matching server-side change.
  { key: 'campaign_subscriptions', label: 'Stripe Subscription', editable: true },
  // v359: moved out of Stripe Subscription into its own subtab.
  // v368: editable:true — Get link is a real edit action (generates a
  // Stripe Checkout link / attaches a campaign onto an existing
  // subscription and charges it). Same hardcoded-to-Owner/Admin history and
  // fix as campaign_subscriptions above — see checkFinanceEditAccess() in
  // staff-campaign-payment-link.
  { key: 'stripe_pending_payment', label: 'Stripe Pending Payment', editable: true },
  // v365: editable:true — has an actual edit action (Create code/charge,
  // Save pricing, Add/Remove credits), so gets an Edit column in the Roles
  // editor.
  { key: 'stripe_discount_codes', label: 'Stripe Discount Codes', editable: true },
  { key: 'stripe_payments', label: 'Stripe Payments', editable: true },
  { key: 'stripe_pricing', label: 'Stripe Pricing', editable: true },
  // v364: now grantable per role like the other subtabs above, instead of
  // hardcoded Owner/Admin — see checkFinanceEditAccess() in
  // public-skiptrace's staffAdjustCredits for the matching server-side change.
  { key: 'skiptrace_credits', label: 'Skiptrace Credits', editable: true },
];
// v308: the 3 Stripe subtabs below default closed, same "real money"
// reasoning Billing AK used to have here before it moved to Audit Log.
// v364: Skiptrace Credits defaults closed too, same reasoning.
function financeSectionDefault(key){ return key !== 'stripe_discount_codes' && key !== 'stripe_payments' && key !== 'stripe_pricing' && key !== 'skiptrace_credits'; }
// v365: per-subtab Edit, same shape as UM_SECTIONS/canEditUmSection — a
// role can now be granted View without Edit on a Finance subtab (e.g. see
// Stripe Pricing without being able to change it), instead of the old
// all-or-nothing whole-tab canEditTab('finance') flag. v368: extended to
// campaign_subscriptions/stripe_pending_payment too, once it turned out
// those two do have real edit actions after all (see FINANCE_SECTIONS
// above) — every editable Finance subtab defaults closed for the same
// "real money" reasoning.
function financeEditSectionDefault(key){ return false; }
// v287/v308/v365: Stripe discount codes / Stripe payment / Stripe pricing /
// Skiptrace Credits create real Stripe objects/charges, write live pricing,
// or move real skiptrace balance — View here (like every other Finance
// subtab) only controls whether the subtab is visible; whether its
// Save/Create/Add/Remove buttons actually WORK is now gated per-subtab by
// canEditFinanceSection() instead of the old whole-tab
// canEditTab('finance'). The corresponding server-side checks
// (create-promo-code, staff-manage-one-off-charge, staff-save-stripe-pricing,
// public-skiptrace's staffAdjustCredits) still only check tab-level access —
// see the matching CHANGELOG entry for the server-side per-subtab follow-up.
function canViewFinanceSection(key){
  // v360: iSpeedToLead Postbacks moved here from Activity — hardcoded
  // Owner-only per direct request, deliberately NOT part of
  // myPermissions.financeSections / the Roles editor at all (unlike every
  // other Finance subtab, which any role can be granted).
  if(key === 'ispeedtolead_postback' || key === 'commission_liability') return myIsOwner;
  if(myPermissions.isProtected) return true;
  const s = (myPermissions.financeSections || {})[key];
  return s && typeof s.view === 'boolean' ? s.view : financeSectionDefault(key);
}
function canEditFinanceSection(key){
  if(key === 'ispeedtolead_postback' || key === 'commission_liability') return myIsOwner;
  if(myPermissions.isProtected) return true;
  const s = (myPermissions.financeSections || {})[key];
  return s && typeof s.edit === 'boolean' ? s.edit : financeEditSectionDefault(key);
}
function financeSubtabBtns(){
  return Array.from(document.querySelectorAll('.finance-subtab-btn')).filter(b => canViewFinanceSection(b.dataset.financeSection));
}
let financeActiveSection = null;
function initFinanceTab(){
  document.querySelectorAll('.finance-subtab-btn').forEach(b => { b.style.display = canViewFinanceSection(b.dataset.financeSection) ? '' : 'none'; });
  const usable = financeSubtabBtns();
  const stillValid = usable.find(b => b.dataset.financeSection === financeActiveSection);
  const target = stillValid ? financeActiveSection : (usable[0] ? usable[0].dataset.financeSection : null);
  if(target) activateFinanceSection(target);
}
function applyFinanceSectionEditGating(key){
  const panel = document.getElementById('financeSection-' + key);
  if(!panel) return;
  const editable = canEditFinanceSection(key);
  panel.querySelectorAll('.edit-only').forEach(el => {
    el.disabled = !editable;
    el.style.opacity = editable ? '' : '0.4';
    el.style.cursor = editable ? '' : 'not-allowed';
    el.title = editable ? '' : 'Your role has view-only access to this subtab';
  });
}
function activateFinanceSection(key){
  financeActiveSection = key;
  document.querySelectorAll('.finance-subtab-btn').forEach(b => b.classList.toggle('active', b.dataset.financeSection === key));
  document.querySelectorAll('.finance-section').forEach(s => { s.style.display = (s.id === 'financeSection-' + key) ? 'block' : 'none'; });
  if(key === 'campaign_subscriptions') loadCampaignSubscriptionsStaffList();
  else if(key === 'stripe_pending_payment') loadPendingCampaignPayments();
  else if(key === 'stripe_payments'){ loadOneOffChargeClientOptions(); loadOneOffChargesList(); }
  else if(key === 'stripe_discount_codes') loadPromoCodesList();
  else if(key === 'stripe_pricing') loadStripePricing();
  else if(key === 'ispeedtolead_postback') loadFinanceIspeedtoleadPostbacks();
  else if(key === 'skiptrace_credits'){ loadSkiptraceCreditsClientOptions(); loadSkiptraceCreditsHistory(); }
  else if(key === 'commission_liability') loadFinanceCommissionLiability();
  applyFinanceSectionEditGating(key);
}
document.querySelectorAll('.finance-subtab-btn').forEach(btn => {
  btn.addEventListener('click', () => { if(canViewFinanceSection(btn.dataset.financeSection)) activateFinanceSection(btn.dataset.financeSection); });
});

// v360: independent port of Activity -> iSpeedToLead -> Postbacks, moved
// here as Finance -> iSpeedToLead Postbacks (Owner only — see
// canViewFinanceSection's special case above). Deliberately self-contained
// with its own date-range/agent/search inputs (finPostback* ids) rather
// than reusing the Activity tab's shared callAct* filter state, which no
// longer makes sense once this is reachable from a different top-level tab.
function defaultFinPostbackRange(){
  return { from: todayDateInputValue(), to: endOfLoginMonthDateInputValue() };
}
function finPostbackRangeISO(){
  const fromVal = $('finPostbackFromInput').value;
  const toVal = $('finPostbackToInput').value;
  if(!fromVal && !toVal) return { start: null, end: null };
  const [fy, fm, fd] = (fromVal || toVal).split('-').map(Number);
  const [ty, tm, td] = (toVal || fromVal).split('-').map(Number);
  const { startMs } = dayBoundsMsInZone(globalDisplayTzMode, null, fy, fm, fd);
  const { endMs } = dayBoundsMsInZone(globalDisplayTzMode, null, ty, tm, td);
  return { start: new Date(startMs).toISOString(), end: new Date(endMs).toISOString() };
}
async function loadFinanceIspeedtoleadPostbacks(){
  const body = $('finPostbackBody');
  body.innerHTML = '<tr><td colspan="10" class="empty">Loading…</td></tr>';

  if(!$('finPostbackFromInput').value || !$('finPostbackToInput').value){
    const { from, to } = defaultFinPostbackRange();
    $('finPostbackFromInput').value = from;
    $('finPostbackToInput').value = to;
  }

  const { data: agents } = await sb.from('profiles').select('id, full_name, email, ghl_user_id, readymode_username').order('full_name');
  const agentSel = $('finPostbackAgentFilter');
  const prevAgent = agentSel.value;
  agentSel.innerHTML = '<option value="">All agents</option>' +
    (agents||[]).filter(a => a.ghl_user_id || a.readymode_username).map(a => `<option value="${a.id}">${escapeHtml(a.full_name||a.email||'—')}</option>`).join('');
  agentSel.value = prevAgent;

  const agentId = agentSel.value;
  const { start: rangeStart, end: rangeEnd } = finPostbackRangeISO();
  const nameById = {}; (agents||[]).forEach(a => { nameById[a.id] = a.full_name || a.email; });

  const { data: scheduleRows } = await sb.from('schedules').select('user_id, timezone');
  const agentTz = {};
  (scheduleRows || []).forEach(s => { if(s.timezone) agentTz[s.user_id] = s.timezone; });
  const resolveTz = userId => globalDisplayTzMode === 'agent' ? agentTz[userId] : globalDisplayTzMode;
  const fmt = (iso, userId) => {
    if(!iso) return '—';
    const tz = resolveTz(userId);
    return new Date(iso).toLocaleString([], {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(tz ? { timeZone: tz } : {})});
  };

  // Stat cards — same query/logic loadActivityTotals() used to run for
  // this group before the move (see its own comments there, pre-v360).
  const setStat = (id, n, isError) => { $(id).textContent = isError ? '—' : String(n ?? 0); };
  let statsQuery = sb.from('ispeedtolead_postbacks').select('mapped_status, status_raw, amount, applied, matched_lead_id, needs_reconciliation');
  if(rangeStart) statsQuery = statsQuery.gte('received_at', rangeStart);
  if(rangeEnd) statsQuery = statsQuery.lte('received_at', rangeEnd);
  const { data: statsRows, error: statsError } = await statsQuery;
  if(statsError){
    ['finPostbackStatTotal','finPostbackStatApplied','finPostbackStatAccepted','finPostbackStatRejected','finPostbackStatUnmatched',
     'finPostbackStatNeedsReconciliation','finPostbackStatPurchasedAmount','finPostbackStatAcceptedAmount','finPostbackStatRefundedAmount']
      .forEach(id => setStat(id, 0, true));
  } else {
    let statsFiltered = statsRows || [];
    if(agentId){
      const matchedLeadIds = [...new Set(statsFiltered.map(r => r.matched_lead_id).filter(Boolean))];
      const leadUserById = {};
      if(matchedLeadIds.length){
        const { data: matchedLeads } = await sb.from('leads').select('id, user_id').in('id', matchedLeadIds);
        (matchedLeads || []).forEach(l => { leadUserById[l.id] = l.user_id; });
      }
      statsFiltered = statsFiltered.filter(r => leadUserById[r.matched_lead_id] === agentId);
    }
    setStat('finPostbackStatTotal', statsFiltered.length);
    setStat('finPostbackStatApplied', statsFiltered.filter(r => r.applied).length);
    setStat('finPostbackStatAccepted', statsFiltered.filter(r => r.mapped_status === 'accepted').length);
    setStat('finPostbackStatRejected', statsFiltered.filter(r => r.mapped_status === 'rejected').length);
    setStat('finPostbackStatUnmatched', statsFiltered.filter(r => !r.applied).length);
    setStat('finPostbackStatNeedsReconciliation', statsFiltered.filter(r => r.needs_reconciliation).length);
    const isRefundRow = r => r.mapped_status === 'rejected' && String(r.status_raw || '').toLowerCase().includes('refund');
    const sumAmount = rows => rows.reduce((s, r) => s + (typeof r.amount === 'number' ? r.amount : 0), 0);
    const acceptedRows = statsFiltered.filter(r => r.mapped_status === 'accepted');
    const refundedRows = statsFiltered.filter(isRefundRow);
    const acceptedAmount = sumAmount(acceptedRows);
    const refundedAmount = sumAmount(refundedRows);
    const fmtMoney = n => `$${n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    setStat('finPostbackStatPurchasedAmount', fmtMoney(acceptedAmount + refundedAmount));
    setStat('finPostbackStatAcceptedAmount', fmtMoney(acceptedAmount));
    setStat('finPostbackStatRefundedAmount', fmtMoney(refundedAmount));
  }

  // No user_id lives directly on this table (iSpeedToLead has no idea this
  // platform's agent ids exist) — the agent is only known via whichever
  // internal lead the postback matched by phone number. Resolved with a
  // second query + a lookup map, same convention this loader always used.
  let q = sb.from('ispeedtolead_postbacks')
    .select('id, phone_raw, status_raw, mapped_status, amount, reason, applied, received_at, matched_lead_id, matched_via, needs_reconciliation')
    .order('received_at', { ascending: false }).limit(300);
  if(rangeStart) q = q.gte('received_at', rangeStart);
  if(rangeEnd) q = q.lte('received_at', rangeEnd);
  const { data, error } = await q;
  if(error){ body.innerHTML = `<tr><td colspan="10" class="msg error">${escapeHtml(error.message)}</td></tr>`; return; }
  const rowsData = data || [];
  const matchedLeadIds = [...new Set(rowsData.map(r => r.matched_lead_id).filter(Boolean))];
  const leadUserById = {};
  if(matchedLeadIds.length){
    const { data: matchedLeads } = await sb.from('leads').select('id, user_id').in('id', matchedLeadIds);
    (matchedLeads || []).forEach(l => { leadUserById[l.id] = l.user_id; });
  }
  let filtered = rowsData;
  if(agentId) filtered = filtered.filter(r => leadUserById[r.matched_lead_id] === agentId);
  const searchTerm = ($('finPostbackSearchInput') ? $('finPostbackSearchInput').value : '').trim().toLowerCase();
  if(searchTerm){
    filtered = filtered.filter(r => {
      const who = leadUserById[r.matched_lead_id] ? (nameById[leadUserById[r.matched_lead_id]] || '') : '';
      const haystack = [
        r.received_at, r.phone_raw, who, r.status_raw, r.mapped_status,
        r.amount, r.reason, r.matched_via, r.applied ? 'yes' : 'no'
      ].filter(v => v !== null && v !== undefined).join(' ').toLowerCase();
      return haystack.includes(searchTerm);
    });
  }
  if(!filtered.length){ body.innerHTML = '<tr><td colspan="10" class="empty">No iSpeedToLead postbacks in this range.</td></tr>'; return; }
  body.innerHTML = '';
  filtered.forEach(r => {
    const rowUserId = leadUserById[r.matched_lead_id] || null;
    const who = rowUserId
      ? escapeHtml(nameById[rowUserId] || 'Agent')
      : `<span style="color:var(--text-dim);">unmatched</span>`;
    const mappedLabel = r.mapped_status
      ? `<span class="${r.mapped_status === 'accepted' ? 'pct-focus' : 'text-idle'}">${escapeHtml(r.mapped_status)}</span>`
      : `<span style="color:var(--text-dim);">unrecognized</span>`;
    const viaLabel = r.matched_via === 'provider_lead_id'
      ? '<span style="color:var(--focus);">provider_lead_id</span>'
      : r.matched_via === 'phone'
        ? '<span style="color:var(--text-2);">phone</span>'
        : r.matched_via === 'phone_ineligible'
          ? '<span style="color:var(--text-dim);" title="Matched by phone to a lead that was already accepted/rejected — most likely iSpeedToLead resold the same lead a second time. No status change was applied.">phone (already decided)</span>'
          : '<span style="color:var(--text-dim);">—</span>';
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td class="mono" style="color:var(--text-2);">${fmt(r.received_at, rowUserId)}</td>
      <td class="mono">${escapeHtml(r.phone_raw || '—')}</td>
      <td>${who}</td>
      <td class="mono">${escapeHtml(r.status_raw || '—')}</td>
      <td>${mappedLabel}</td>
      <td class="mono">${r.amount != null ? r.amount : '—'}</td>
      <td style="max-width:220px; white-space:normal;">${r.reason ? escapeHtml(r.reason) : '<span style="color:var(--text-dim);">—</span>'}</td>
      <td class="mono">${viaLabel}</td>
      <td>${r.applied ? '<span style="color:var(--focus);">yes</span>' : '<span style="color:var(--text-dim);">no</span>'}</td>
      <td>${r.needs_reconciliation
        ? `<button type="button" class="btn-secondary fin-postback-reconcile-btn" data-id="${escapeHtml(r.id)}" style="width:auto; padding:4px 10px; font-size:10px; color:var(--danger);">⚠ Needs reconciliation — Mark done</button>`
        : '<span style="color:var(--text-dim);">—</span>'}</td>
    `;
    body.appendChild(tr);
  });
  body.querySelectorAll('.fin-postback-reconcile-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if(!confirm('Mark this postback as reconciled? Only do this once the $ mismatch with Leads has actually been resolved/verified.')) return;
      const { error: reconcileErr } = await sb.from('ispeedtolead_postbacks').update({ needs_reconciliation: false }).eq('id', btn.dataset.id);
      if(reconcileErr){ alert(reconcileErr.message); return; }
      logActivity('finance.postback_reconciled', 'ispeedtolead_postback', btn.dataset.id, 'Marked an iSpeedToLead postback as reconciled');
      loadFinanceIspeedtoleadPostbacks();
    });
  });
}
$('finPostbackFromInput').addEventListener('change', loadFinanceIspeedtoleadPostbacks);
$('finPostbackToInput').addEventListener('change', loadFinanceIspeedtoleadPostbacks);
$('finPostbackAgentFilter').addEventListener('change', loadFinanceIspeedtoleadPostbacks);
$('finPostbackSearchInput').addEventListener('input', debounce(loadFinanceIspeedtoleadPostbacks, 250));
$('finPostbackRefreshBtn').addEventListener('click', loadFinanceIspeedtoleadPostbacks);

// v395: Finance -> Commission Liability -- what's owed to agents for a
// period, reusing the exact same computeAgentStats (leadsCount, payableSec)
// + computeSalesPay (basic/lead/extra bonus) math Reports -> Payroll uses,
// so this can never disagree with what Payroll would actually pay out for
// the same range. Independent of Reports' own reportAgents/reportCurrency
// state (always shown in USD, always every non-protected agent) since this
// is meant as a quick liability check, not a payroll run.
function defaultFinCommissionRange(){
  const [y, m] = todayDateInputValue().split('-').map(Number);
  return { from: `${String(y).padStart(4,'0')}-${String(m).padStart(2,'0')}-01`, to: todayDateInputValue() };
}
async function loadFinanceCommissionLiability(){
  const body = $('finCommissionBody');
  body.innerHTML = '<tr><td colspan="7" class="empty">Loading…</td></tr>';

  if(!$('finCommissionFromInput').value || !$('finCommissionToInput').value){
    const { from, to } = defaultFinCommissionRange();
    $('finCommissionFromInput').value = from;
    $('finCommissionToInput').value = to;
  }
  const [fy, fm, fd] = $('finCommissionFromInput').value.split('-').map(Number);
  const [ty, tm, td] = $('finCommissionToInput').value.split('-').map(Number);
  loadFinanceRecruiterLiability($('finCommissionFromInput').value, $('finCommissionToInput').value);   // v717
  const { startMs: rangeStartMs } = dayBoundsMsInZone(globalDisplayTzMode, null, fy, fm, fd);
  const { endMs: rangeEndMs } = dayBoundsMsInZone(globalDisplayTzMode, null, ty, tm, td);

  const { data: agents } = await sb.from('profiles').select('id, full_name, email, role').order('full_name');
  const { data: scheduleRows } = await sb.from('schedules').select('user_id, hourly_rate, hourly_rate_currency, target_leads, lead_bonus_type, lead_bonus_rate, lead_bonus_currency, extra_target_tiers, pay_model, salary_tiers');
  const scheduleByUser = {};
  (scheduleRows || []).forEach(s => { scheduleByUser[s.user_id] = s; });
  const liabilityAgents = (agents || []).filter(a => !PROTECTED_ROLES.has(a.role)).map(a => {
    const s = scheduleByUser[a.id] || {};
    return {
      id: a.id,
      name: a.full_name || a.email,
      hourlyRate: s.hourly_rate != null ? Number(s.hourly_rate) : null,
      hourlyRateCurrency: s.hourly_rate_currency || 'USD',
      targetLeads: s.target_leads != null ? Number(s.target_leads) : null,
      leadBonusType: s.lead_bonus_type || 'per_lead',
      leadBonusRate: s.lead_bonus_rate != null ? Number(s.lead_bonus_rate) : null,
      leadBonusCurrency: s.lead_bonus_currency || 'USD',
      extraTiers: Array.isArray(s.extra_target_tiers) ? s.extra_target_tiers : [],
      payModel: s.pay_model || 'hourly_bonus',
      salaryTiers: Array.isArray(s.salary_tiers) ? s.salary_tiers : [],
    };
  });

  if(!liabilityAgents.length){ body.innerHTML = '<tr><td colspan="7" class="empty">No agents.</td></tr>'; return; }

  const rows = await Promise.all(liabilityAgents.map(async agent => {
    const stats = await computeAgentStats(agent.id, rangeStartMs, rangeEndMs);
    const payCalc = computeSalesPay(agent, stats);
    return { agent, stats, payCalc };
  }));

  const fmtMoney = n => n == null ? '—' : `$${n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  const totalLeads = rows.reduce((t, r) => t + r.stats.leadsCount, 0);
  const totalBonus = rows.reduce((t, r) => t + r.payCalc.leadBonus + r.payCalc.extraBonus, 0);
  const totalBasic = rows.reduce((t, r) => t + (r.payCalc.basicPay || 0), 0);
  $('finCommissionStatLeads').textContent = String(totalLeads);
  $('finCommissionStatBonus').textContent = fmtMoney(totalBonus);
  $('finCommissionStatBasic').textContent = fmtMoney(totalBasic);
  $('finCommissionStatTotal').textContent = fmtMoney(totalBonus + totalBasic);

  const withLiability = rows.filter(r => r.stats.leadsCount > 0 || (r.payCalc.pay || 0) > 0);
  if(!withLiability.length){ body.innerHTML = '<tr><td colspan="7" class="empty">No pay or accepted leads for any agent in this range.</td></tr>'; return; }
  body.innerHTML = '';
  withLiability
    .sort((a, b) => ((b.payCalc.pay || 0)) - ((a.payCalc.pay || 0)))
    .forEach(({ agent, stats, payCalc }) => {
      const tr = document.createElement('tr');
      const totalOwed = (payCalc.basicPay || 0) + payCalc.leadBonus + payCalc.extraBonus;
      tr.innerHTML = `
        <td>${escapeHtml(agent.name)}</td>
        <td class="mono">${stats.leadsCount}</td>
        <td class="mono">${agent.targetLeads != null ? agent.targetLeads : '—'}</td>
        <td class="mono">${fmtMoney(payCalc.leadBonus)}</td>
        <td class="mono">${fmtMoney(payCalc.extraBonus)}</td>
        <td class="mono">${fmtMoney(payCalc.basicPay)}</td>
        <td class="mono" style="font-weight:700;">${fmtMoney(totalOwed)}</td>
      `;
      body.appendChild(tr);
    });
}
$('finCommissionFromInput').addEventListener('change', loadFinanceCommissionLiability);
$('finCommissionToInput').addEventListener('change', loadFinanceCommissionLiability);
$('finCommissionRefreshBtn').addEventListener('click', loadFinanceCommissionLiability);

// v717 (the owner: "Commission Liability doesn't report the recruiter
// commission"). Recruiter commission that became due inside the period: a
// candidate who reached 14 days employed (qualifies_on) between From and To
// and still qualifies -- hr_recruiter_commissions(), the rule HR -> Recruiter
// Commission shows. In EGP, so it is totalled on its own rather than mixed into
// the USD payroll figures. Owner/admin only (anyone else gets no rows).
async function loadFinanceRecruiterLiability(from, to){
  const body = $('finRecruiterBody');
  if(!body) return;
  body.innerHTML = '<tr><td colspan="5" class="empty">Loading\u2026</td></tr>';
  const { data, error } = await sb.rpc('hr_recruiter_commissions');
  if(error){ body.innerHTML = `<tr><td colspan="5" class="empty">${escapeHtml(error.message)}</td></tr>`; $('finRecruiterTotal').textContent = '\u2014'; return; }
  const due = (data || []).filter(r => r.qualifies && r.qualifies_on && r.qualifies_on >= from && r.qualifies_on <= to);
  const total = due.reduce((t, r) => t + (Number(r.commission_amount) || 0), 0);
  $('finRecruiterTotal').textContent = `EGP ${total.toLocaleString()} owed to recruiters in this period`;
  body.innerHTML = due.length ? due.map(r => `<tr>
      <td>${escapeHtml(r.recruiter_name)}</td>
      <td>${escapeHtml(r.candidate_name)}</td>
      <td class="mono">${hrFmtDate(r.employment_start_date)}</td>
      <td class="mono">${hrFmtDate(r.qualifies_on)}</td>
      <td class="mono" style="font-weight:700;">EGP ${Number(r.commission_amount).toLocaleString()}</td>
    </tr>`).join('') : '<tr><td colspan="5" class="empty">No recruiter commission became due in this period.</td></tr>';
}

// v358: Data Science tab — Data Form + Skip Trace (from Client
// Submissions), List Builder + Data Orders (from Leads). Same 2-level
// pattern as Leads/Client Submissions/Finance (initXTab/activateXSection).
// v366: Data Form moved back to Campaigns; List Orders (the "Buy a list"
// card, previously embedded at the top of Data Form) took its place here.
function dataSciSubtabBtns(){
  return Array.from(document.querySelectorAll('.datasci-subtab-btn')).filter(b => canViewDataSciSection(b.dataset.datasciSection));
}
let dataSciActiveSection = null;
function initDataSciTab(){
  document.querySelectorAll('.datasci-subtab-btn').forEach(b => { b.style.display = canViewDataSciSection(b.dataset.datasciSection) ? '' : 'none'; });
  const usable = dataSciSubtabBtns();
  const stillValid = usable.find(b => b.dataset.datasciSection === dataSciActiveSection);
  const target = stillValid ? dataSciActiveSection : (usable[0] ? usable[0].dataset.datasciSection : null);
  if(target) activateDataSciSection(target);
}
function activateDataSciSection(key){
  dataSciActiveSection = key;
  document.querySelectorAll('.datasci-subtab-btn').forEach(b => b.classList.toggle('active', b.dataset.datasciSection === key));
  document.querySelectorAll('.datasci-section').forEach(s => { s.style.display = (s.id === 'dataSciSection-' + key) ? 'block' : 'none'; });
  // Order readiness renders into both order subtabs off one fetch --
  // cached after the first load (the underlying geography rollup only
  // refreshes every 6h), so switching between the two subtabs doesn't
  // re-hit the function.
  if(key === 'list_orders' || key === 'data_orders') loadOrderReadiness();
  if(key === 'list_orders') loadCsubListOrders();
  else if(key === 'list_builder') initListBuilderSection();
  else if(key === 'overview') loadDataSciOverview();
  else if(key === 'data_orders') loadDataOrders();
  else if(key === 'skiptrace') loadCsubSkipTrace(); // also (re)starts its own poll timer below
  else applyDataSciSectionEditGating(key);
  // v358: Skip Trace's own 10s auto-refresh poll (see startCsubSkiptracePolling/
  // stopCsubSkiptracePolling further down) is keyed off csubActiveSection,
  // which no longer changes now that Skip Trace lives here -- drive it off
  // dataSciActiveSection instead so it still starts/stops correctly.
  if(key === 'skiptrace') startCsubSkiptracePolling(); else stopCsubSkiptracePolling();
}
function applyDataSciSectionEditGating(key){
  const panel = document.getElementById('dataSciSection-' + key);
  if(!panel) return;
  const editable = canEditDataSciSection(key);
  panel.querySelectorAll('.edit-only').forEach(el => {
    el.disabled = !editable;
    el.style.opacity = editable ? '' : '0.4';
    el.title = editable ? '' : 'Your role has view-only access to this section';
  });
}
function refreshDataSciSectionByKey(key){
  // An explicit Refresh click should re-fetch readiness too, not serve the
  // cached copy loadOrderReadiness() keeps for subtab switching.
  if(key === 'list_orders' || key === 'data_orders') loadOrderReadiness(true);
  if(key === 'list_orders') loadCsubListOrders();
  else if(key === 'data_orders') loadDataOrders();
  else if(key === 'skiptrace') loadCsubSkipTrace();
  else if(key === 'list_builder') initListBuilderSection();
  else if(key === 'overview') loadDataSciOverview();
}
// v436: Overview subtab -- calls staff-list-builder's overview_stats action
// (count-only queries server-side) and renders each number into its
// .act-stat-card. Deliberately excludes equity/mortgage/tax-delinquency --
// see the card above and CHANGELOG-v422-v425 for why no free source exists
// for any of those. v478: pre-foreclosure no longer belongs on that list --
// see dsOverviewPreforeclosure below.
async function loadDataSciOverview(){
  const btn = document.getElementById('dsOverviewRefreshBtn');
  if(btn){ btn.disabled = true; }
  const emptyEl = document.getElementById('dsOverviewEmpty');
  if(emptyEl) emptyEl.style.display = 'none';
  // Fired in parallel and deliberately NOT awaited: the supplementary
  // panels (operational health, coverage, overlap) come from a different
  // Edge Function, and neither half should be able to block or fail the
  // other. Each renders its own errors into its own panel.
  loadDataSciExtraStats();
  try{
    const data = await listBuilderCall({ action: 'overview_stats' });
    if(!data || data.ok === false) throw new Error((data && data.error) || 'overview_stats failed');
    const fmt = n => (typeof n === 'number' ? n.toLocaleString() : '—');
    const set = (id, val) => { const el = document.getElementById(id); if(el) el.textContent = fmt(val); };
    set('dsOverviewTotal', data.total);
    set('dsOverviewCook', data.cookTotal);
    set('dsOverviewDupage', data.dupageTotal);
    set('dsOverviewAbsentee', data.absentee);
    set('dsOverviewCorporate', data.corporateOwner);
    set('dsOverviewInherited', data.inherited);
    set('dsOverviewProbate', data.probateEstate);
    set('dsOverviewLawsuit', data.buildingCodeLawsuit);
    set('dsOverviewVacant', data.vacantBuilding);
    set('dsOverviewPreforeclosure', data.preforeclosure);
    set('dsOverviewTired', data.tiredLandlord);
    set('dsOverviewLongTerm', data.longTermOwner);
    set('dsOverviewMfh24', data.mfh2to4);
    set('dsOverviewMfh5p', data.mfh5plus);
    set('dsOverviewExcluded', data.excluded);
    renderDsOverviewCountyBreakdown(data.byCounty);
    renderDsOverviewTrend(data.trend);
    const computedEl = document.getElementById('dsOverviewComputedAt');
    if(computedEl) computedEl.textContent = data.computedAt ? `Computed ${new Date(data.computedAt).toLocaleString()}` : '';
  }catch(err){
    console.error('loadDataSciOverview', err);
    if(emptyEl){ emptyEl.style.display = ''; emptyEl.textContent = 'Couldn\'t load overview stats: ' + (err.message || err); }
  }finally{
    if(btn){ btn.disabled = false; }
  }
}
document.getElementById('dsOverviewRefreshBtn')?.addEventListener('click', loadDataSciOverview);

// Supplementary Overview panels (operational health, field coverage,
// signal overlap) -- served by staff-datascience-stats, NOT
// staff-list-builder. Deliberately its own fetch, fired alongside the
// counts rather than awaited by them: if this fails, the property counts/
// county breakdown/sync trend above still render exactly as before. See
// that function's own header comment for the full rationale.
async function dataSciStatsCall(payload){
  const { data, error } = await sb.functions.invoke('staff-datascience-stats', { body: payload });
  if(error) return { ok: false, error: error.message || String(error) };
  return data;
}
// Shared by every panel below -- the same "—" for a genuinely absent
// number that the existing cards use, never a misleading 0.
function dsFmtNum(n){ return (typeof n === 'number' && isFinite(n)) ? n.toLocaleString() : '—'; }
function dsFmtAge(hours){
  if(typeof hours !== 'number' || !isFinite(hours)) return '—';
  if(hours < 1) return Math.max(1, Math.round(hours * 60)) + 'm';
  if(hours < 48) return Math.round(hours) + 'h';
  return Math.round(hours / 24) + 'd';
}
let dsOverlapSignals = [];
async function loadDataSciExtraStats(){
  const setText = (id, val) => { const el = document.getElementById(id); if(el) el.textContent = val; };
  try{
    const data = await dataSciStatsCall({ action: 'stats' });
    if(!data || data.ok === false) throw new Error((data && data.error) || 'stats failed');

    // ---- Data freshness. Colour-coded because "synced 3 weeks ago" and
    // "synced this morning" look identical as a bare timestamp, and the
    // whole tab's credibility rests on which one it is.
    const fresh = data.freshness || {};
    const ageH = typeof fresh.dataAgeHours === 'number' ? fresh.dataAgeHours : null;
    setText('dsOpsFreshness', ageH == null ? '—' : dsFmtAge(ageH) + ' old');
    setText('dsOpsFreshnessSub', fresh.newest_source_updated_at
      ? 'Newest county data ' + new Date(fresh.newest_source_updated_at).toLocaleDateString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {})
      : 'No sync recorded yet');
    const freshValEl = document.getElementById('dsOpsFreshness');
    if(freshValEl) freshValEl.style.color = ageH == null ? '' : (ageH >= 168 ? 'var(--danger)' : ageH >= 48 ? 'var(--away)' : 'var(--good)');

    // ---- Order aging
    const aging = data.orderAging || {};
    setText('dsOpsAging', dsFmtNum(aging.total));
    setText('dsOpsAgingSub', aging.total
      ? `oldest ${dsFmtAge(aging.oldestHours)} · ${aging.over168h || 0} over a week`
      : 'nothing waiting');
    const agingValEl = document.getElementById('dsOpsAging');
    if(agingValEl) agingValEl.style.color = (aging.over168h > 0) ? 'var(--danger)' : (aging.h72to168 > 0) ? 'var(--away)' : '';
    const agingCard = document.getElementById('dsAgingDetailCard');
    const agingBody = document.getElementById('dsAgingDetailBody');
    const agingRows = Array.isArray(aging.rows) ? aging.rows.filter(r => r.ageHours >= 24) : [];
    if(agingCard && agingBody){
      agingCard.style.display = agingRows.length ? '' : 'none';
      agingBody.innerHTML = agingRows.map(r => {
        const colour = r.ageHours >= 168 ? 'var(--danger)' : r.ageHours >= 72 ? 'var(--away)' : 'var(--text-2)';
        return `<tr>
          <td class="mono" style="color:${colour}; white-space:nowrap;">${dsFmtAge(r.ageHours)}</td>
          <td>${r.kind === 'data_order' ? 'Data Order' : 'Buy-a-List'}</td>
          <td>${escapeHtml(r.status || '')}</td>
          <td style="color:var(--text-2);">${escapeHtml(r.label || '—')}</td>
          <td style="color:var(--text-dim); white-space:nowrap;">${new Date(r.createdAt).toLocaleDateString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {})}</td>
        </tr>`;
      }).join('');
    }

    // ---- Skip-trace hit rate
    const st = data.skiptrace || {};
    setText('dsOpsHitRate', typeof st.hitRatePct === 'number' ? st.hitRatePct + '%' : '—');
    setText('dsOpsHitRateSub', st.completedOrders
      ? `${dsFmtNum(st.recordsOut)} matched of ${dsFmtNum(st.recordsIn)} · ${st.completedOrders} order${st.completedOrders === 1 ? '' : 's'}`
      : 'no completed orders yet');

    // ---- Delivery burn-down
    const del = data.deliveries || {};
    setText('dsOpsDelivered', dsFmtNum(del.distinctProperties));
    setText('dsOpsDeliveredSub', del.distinctProperties
      ? `${typeof del.pctOfInventory === 'number' ? del.pctOfInventory + '% of inventory · ' : ''}${dsFmtNum(del.remaining)} never sent`
      : 'nothing delivered yet');

    renderDsCoverage(data.coverage, data.snapshotComputedAt);
    renderDsSignalOverlap(data.signalOverlap);
  }catch(err){
    console.error('loadDataSciExtraStats', err);
    // Panel-local failure only -- the counts above are a separate fetch
    // and stay valid, so this must not touch dsOverviewEmpty.
    const covBody = document.getElementById('dsCoverageBody');
    if(covBody) covBody.innerHTML = `<tr><td colspan="5" style="color:var(--danger);">Couldn't load coverage: ${escapeHtml(err.message || String(err))}</td></tr>`;
    const ovBody = document.getElementById('dsOverlapBody');
    if(ovBody) ovBody.innerHTML = '<tr><td style="color:var(--text-dim);">Couldn\'t load signal overlap.</td></tr>';
  }
}
function renderDsCoverage(coverage, snapshotComputedAt){
  const body = document.getElementById('dsCoverageBody');
  const stamp = document.getElementById('dsCoverageComputedAt');
  if(!body) return;
  if(stamp){
    stamp.textContent = snapshotComputedAt
      ? ` Measured ${new Date(snapshotComputedAt).toLocaleString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {})}.`
      : '';
  }
  if(!coverage || !Array.isArray(coverage.fields) || !coverage.fields.length){
    body.innerHTML = '<tr><td colspan="5" style="color:var(--text-dim);">Not measured yet — click Recompute to build the first snapshot.</td></tr>';
    return;
  }
  body.innerHTML = coverage.fields.map(f => {
    const pct = typeof f.pct === 'number' ? f.pct : null;
    // Thresholds are about how badly a filter is handicapped, not data
    // "quality" in the abstract: under half the table means most searches
    // on that field can't see most properties.
    const colour = pct == null ? 'var(--text-dim)' : pct < 50 ? 'var(--danger)' : pct < 90 ? 'var(--away)' : 'var(--good)';
    const barPct = pct == null ? 0 : Math.max(0, Math.min(100, pct));
    return `<tr>
      <td>${escapeHtml(f.label)}</td>
      <td class="mono" style="white-space:nowrap;">${dsFmtNum(f.present)}</td>
      <td style="min-width:120px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <div style="flex:1; height:6px; background:var(--inset); border-radius:3px; overflow:hidden; min-width:60px;">
            <div style="width:${barPct}%; height:100%; background:${colour};"></div>
          </div>
          <span class="mono" style="color:${colour}; font-size:11px; white-space:nowrap;">${pct == null ? '—' : pct + '%'}</span>
        </div>
      </td>
      <td class="mono" style="color:var(--text-dim); white-space:nowrap;">${dsFmtNum(f.missing)}</td>
      <td style="color:var(--text-2); font-size:11px;">${escapeHtml(f.affects)}</td>
    </tr>`;
  }).join('');
}
// ---------- Order readiness (Stage 1) ----------
// Per open order: what geography the client asked for, how much property
// data we hold there, and how much of it is genuinely motivated. Exists
// because "we can't fill this" was previously invisible until someone
// hand-ran a match -- and most open orders turn out to be blocked on
// coverage, not on anyone's speed. Served by staff-datascience-stats'
// order_readiness action (deliberately gated to the same roles that can
// see these subtabs at all, not Owner/Admin).
let dsReadinessCache = null;
async function loadOrderReadiness(force){
  if(dsReadinessCache && !force) { renderOrderReadiness(); return; }
  try{
    const data = await dataSciStatsCall({ action: 'order_readiness' });
    if(!data || data.ok === false) throw new Error((data && data.error) || 'order_readiness failed');
    // v683: the function labels a list order by its client_id; show the
    // client's name instead (same client_accounts read List Orders uses).
    const clientIds = Array.from(new Set((data.orders || []).filter(o => o.kind === 'list_order' && o.label).map(o => o.label)));
    if(clientIds.length){
      const { data: cl } = await sb.from('client_accounts').select('id, full_name, company_name, email').in('id', clientIds);
      const nameById = {};
      (cl || []).forEach(c => { nameById[c.id] = c.full_name || c.company_name || c.email; });
      data.orders.forEach(o => { if(o.kind === 'list_order' && nameById[o.label]) o.label = nameById[o.label]; });
    }
    dsReadinessCache = data;
    renderOrderReadiness();
  }catch(err){
    console.error('loadOrderReadiness', err);
    ['data_orders','list_orders'].forEach(kind => {
      const body = document.getElementById(`dsReadinessBody_${kind}`);
      if(body) body.innerHTML = `<tr><td colspan="7" style="color:var(--danger);">Couldn't load readiness: ${escapeHtml(err.message || String(err))}</td></tr>`;
    });
  }
}
const DS_READINESS_VERDICT = {
  ready:       { label: 'Ready',        color: 'var(--good)' },
  partial:     { label: 'Partial',      color: 'var(--away)' },
  no_coverage: { label: 'No coverage',  color: 'var(--danger)' },
};
function renderOrderReadiness(){
  const data = dsReadinessCache;
  if(!data) return;
  [['data_orders','data_order'], ['list_orders','list_order']].forEach(([sectionKey, kind]) => {
    const body = document.getElementById(`dsReadinessBody_${sectionKey}`);
    const stamp = document.getElementById(`dsReadinessStamp_${sectionKey}`);
    if(!body) return;
    if(stamp){
      stamp.textContent = data.geoComputedAt
        ? `Coverage measured ${new Date(data.geoComputedAt).toLocaleString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {})}`
        : '';
    }
    // v682: an unpaid list order (abandoned checkout) is not shown in List
    // Orders, so it cannot be worked or deleted there -- and is left out here.
    const rows = (data.orders || []).filter(o => o.kind === kind && o.status !== 'pending_payment');
    if(!rows.length){
      body.innerHTML = '<tr><td colspan="7" style="color:var(--text-dim);">No open orders.</td></tr>';
      return;
    }
    body.innerHTML = rows.map(o => {
      const v = DS_READINESS_VERDICT[o.verdict] || DS_READINESS_VERDICT.partial;
      // Geography cell has to distinguish three genuinely different
      // failures: nothing to parse, parsed-but-uncovered, and
      // parsed-only-by-fallback. Staff act differently on each.
      const p = o.parsed || {};
      const bits = [];
      if(p.states && p.states.length) bits.push(escapeHtml(p.states.join('/')));
      const places = [...(p.counties||[]), ...(p.cities||[])];
      if(places.length) bits.push(escapeHtml(places.slice(0,4).join(', ')) + (places.length > 4 ? ` +${places.length-4}` : ''));
      let geoCell = bits.length ? bits.join(' · ') : '<span style="color:var(--danger);">nothing parsed</span>';
      if(p.recovered && p.recovered.length){
        geoCell += `<div style="font-size:10px; color:var(--away);" title="Recovered by splitting a space-separated list — the order's own field is malformed">↳ recovered: ${escapeHtml(p.recovered.slice(0,4).join(', '))}</div>`;
      }
      if(p.unmatched && p.unmatched.length){
        geoCell += `<div style="font-size:10px; color:var(--text-dim);" title="Requested, but we hold no data there (or it couldn't be read)">↳ no data: ${escapeHtml(p.unmatched.slice(0,4).join(', '))}${p.unmatched.length>4?` +${p.unmatched.length-4}`:''}</div>`;
      }
      if(p.unresolvedStates && p.unresolvedStates.length){
        geoCell += `<div style="font-size:10px; color:var(--text-dim);">↳ unreadable state: ${escapeHtml(p.unresolvedStates.slice(0,3).join(', '))}</div>`;
      }
      const cov = o.coverage || {};
      const ageColour = o.ageHours >= 168 ? 'var(--danger)' : o.ageHours >= 72 ? 'var(--away)' : 'var(--text-2)';
      return `<tr>
        <td class="mono" style="color:${ageColour}; white-space:nowrap;">${dsFmtAge(o.ageHours)}</td>
        <td style="color:var(--text-2); max-width:180px; overflow:hidden; text-overflow:ellipsis;" title="${escapeHtml(o.label || '')}">${escapeHtml(o.label || '—')}</td>
        <td style="font-size:11px;">${geoCell}</td>
        <td class="mono" style="white-space:nowrap;">${dsFmtNum(cov.total)}</td>
        <td class="mono" style="white-space:nowrap;" title="Excludes plain absentee owners. Strong distress signals only: ${dsFmtNum(cov.motivatedStrong)}">${dsFmtNum(cov.motivatedAny)}<span style="color:var(--text-dim); font-size:10px;"> (${dsFmtNum(cov.motivatedStrong)} strong)</span></td>
        <td class="mono" style="white-space:nowrap; color:var(--text-2);">${o.requested != null ? dsFmtNum(o.requested) : escapeHtml((o.requestedRaw || '—').slice(0,18))}</td>
        <td><span class="mono" style="font-size:10px; padding:2px 7px; border-radius:10px; border:1px solid ${v.color}; color:${v.color};">${v.label}</span></td>
      </tr>`;
    }).join('');
  });
}

function renderDsSignalOverlap(overlap){
  const head = document.getElementById('dsOverlapHead');
  const body = document.getElementById('dsOverlapBody');
  const note = document.getElementById('dsOverlapNoSignal');
  if(!head || !body) return;
  if(!overlap || !Array.isArray(overlap.signals) || !overlap.signals.length){
    head.innerHTML = '';
    body.innerHTML = '<tr><td style="color:var(--text-dim);">Not measured yet — click Recompute above to build the first snapshot.</td></tr>';
    if(note) note.textContent = '';
    return;
  }
  dsOverlapSignals = overlap.signals;
  const byKey = {};
  overlap.signals.forEach(s => { byKey[s.key] = s; });
  head.innerHTML = `<tr><th></th>${overlap.signals.map(s => `<th title="${escapeHtml(s.label)}" style="font-size:10px;">${escapeHtml(s.label)}</th>`).join('')}</tr>`;
  body.innerHTML = (overlap.matrix || []).map(row => {
    const rowSig = byKey[row.key];
    const cells = (row.cells || []).map(cell => {
      const isDiagonal = cell.key === row.key;
      // A zero cell is the actionable one -- that combination returns
      // nothing, which is precisely what used to fail silently.
      const colour = cell.count === 0 ? 'var(--danger)' : isDiagonal ? 'var(--text)' : 'var(--text-2)';
      const patch = JSON.stringify({ ...(rowSig ? rowSig.lbFilter : {}), ...((byKey[cell.key] || {}).lbFilter || {}) });
      return `<td class="dsOverlap-drill mono" data-lb-filter='${escapeHtml(patch)}' title="Click to view this combination in List Builder" style="cursor:pointer; color:${colour}; ${isDiagonal ? 'font-weight:600; background:var(--inset);' : ''}">${dsFmtNum(cell.count)}</td>`;
    }).join('');
    return `<tr><th style="text-align:left; font-size:10px; white-space:nowrap;">${escapeHtml(rowSig ? rowSig.label : row.key)}</th>${cells}</tr>`;
  }).join('');
  if(note){
    note.textContent = typeof overlap.noSignal === 'number'
      ? `${overlap.noSignal.toLocaleString()} properties carry none of these signals — every criteria-based search necessarily skips them.`
      : '';
  }
}
document.getElementById('dsOverlapBody')?.addEventListener('click', (e) => {
  const cell = e.target.closest('.dsOverlap-drill');
  if(!cell) return;
  let patch = {};
  try { patch = JSON.parse(cell.dataset.lbFilter || '{}'); } catch(err) { console.error('Bad data-lb-filter on overlap cell', cell, err); }
  lbDrillDownFromOverview(patch);
});
document.getElementById('dsCoverageRefreshBtn')?.addEventListener('click', async () => {
  const btn = document.getElementById('dsCoverageRefreshBtn');
  if(!btn) return;
  btn.disabled = true;
  const original = btn.textContent;
  // Full scan of ~1.8M rows -- genuinely slow (~15s), so say so rather
  // than leaving a dead-looking button.
  btn.textContent = 'Recomputing… (~15s)';
  try{
    const res = await dataSciStatsCall({ action: 'refresh_snapshot' });
    if(!res || res.ok === false) throw new Error((res && res.error) || 'refresh failed');
    await loadDataSciExtraStats();
    logActivity('datascience.snapshot_refresh', null, null, `Recomputed List Builder stats snapshot${res.durationMs ? ` (${Math.round(res.durationMs/1000)}s)` : ''}`);
  }catch(err){
    alert('Couldn\'t recompute: ' + (err.message || err));
  }finally{
    btn.disabled = false;
    btn.textContent = original;
  }
});
// v446: per-county breakdown table -- see the markup's own comment above
// for what this is and why it's built dynamically (delegation) rather than
// the static .dsOverview-drill wiring the cards above use. Each non-County
// cell's filter patch mirrors exactly what its equivalent combined-total
// card above drills into, plus {county: row.county}.
const DS_OVERVIEW_COUNTY_COLS = [
  { key: 'total', filter: () => ({}) },
  { key: 'absentee', filter: () => ({ absenteeOnly: true }) },
  { key: 'corporateOwner', filter: () => ({ corporateOwnerOnly: true }) },
  { key: 'inherited', filter: () => ({ isInherited: true }) },
  { key: 'probateEstate', filter: () => ({ isProbateEstateOnly: true }) },
  { key: 'buildingCodeLawsuit', filter: () => ({ hasBuildingCodeLawsuitOnly: true }) },
  { key: 'vacantBuilding', filter: () => ({ isVacantBuildingOnly: true }) },
  { key: 'tiredLandlord', filter: () => ({ tiredLandlordOnly: true }) },
  { key: 'longTermOwner', filter: () => ({ longTermOwnerOnly: true }) },
  { key: 'mfh2to4', filter: () => ({ isMfh2to4: true }) },
  { key: 'mfh5plus', filter: () => ({ isMfh5Plus: true }) },
];
function renderDsOverviewCountyBreakdown(byCounty){
  const body = document.getElementById('dsOverviewCountyBody');
  if(!body) return;
  const rows = Array.isArray(byCounty) ? byCounty : [];
  if(!rows.length){
    body.innerHTML = '<tr><td colspan="12" style="color:var(--text-dim);">No county data yet.</td></tr>';
    return;
  }
  const fmt = n => (typeof n === 'number' ? n.toLocaleString() : '—');
  body.innerHTML = rows.map(row => {
    const cells = DS_OVERVIEW_COUNTY_COLS.map(col => {
      const patch = { county: row.county, ...col.filter() };
      return `<td class="dsOverviewCounty-drill" data-lb-filter='${JSON.stringify(patch)}' title="Click to view in List Builder" style="cursor:pointer;">${fmt(row[col.key])}</td>`;
    }).join('');
    return `<tr><td>${row.county}</td>${cells}</tr>`;
  }).join('');
}
// Event delegation -- rows are rebuilt on every load, so this listens on
// the stable <tbody> parent rather than binding per-cell (same pattern
// List Builder's own dynamically-rebuilt <thead> sort clicks use).
document.getElementById('dsOverviewCountyBody')?.addEventListener('click', (e) => {
  const cell = e.target.closest('.dsOverviewCounty-drill');
  if(!cell) return;
  let patch = {};
  try { patch = JSON.parse(cell.dataset.lbFilter || '{}'); } catch(e) { console.error('Bad data-lb-filter on county breakdown cell', cell, e); }
  lbDrillDownFromOverview(patch);
});
// v448: trend-over-time -- see the markup's own comment above for what
// this is (and isn't). `trend` arrives as flat {date, county, newCount}
// rows (one per day+county combination that had any activity); this pivots
// that into one row per date with one column per county actually present
// in the data, plus a same-day total and a running (cumulative) total.
// Dates are plain ISO strings ("YYYY-MM-DD"), which already sort correctly
// as plain strings -- no date parsing needed to order them.
function renderDsOverviewTrend(trend){
  const head = document.getElementById('dsOverviewTrendHead');
  const body = document.getElementById('dsOverviewTrendBody');
  if(!head || !body) return;
  const rows = Array.isArray(trend) ? trend : [];
  if(!rows.length){
    head.innerHTML = '<tr><th>Date</th></tr>';
    body.innerHTML = '<tr><td style="color:var(--text-dim);">No sync history yet.</td></tr>';
    return;
  }
  const counties = Array.from(new Set(rows.map(r => r.county))).sort();
  const byDate = new Map();
  rows.forEach(r => {
    if(!byDate.has(r.date)) byDate.set(r.date, {});
    byDate.get(r.date)[r.county] = r.newCount;
  });
  const dates = Array.from(byDate.keys()).sort();
  head.innerHTML = `<tr><th>Date</th>${counties.map(c => `<th>${escapeHtml(c)} (new)</th>`).join('')}<th>Total (new)</th><th>Running total</th></tr>`;
  const fmt = n => (typeof n === 'number' ? n.toLocaleString() : '—');
  let running = 0;
  body.innerHTML = dates.map(d => {
    const counts = byDate.get(d);
    const dayTotal = counties.reduce((sum, c) => sum + (counts[c] || 0), 0);
    running += dayTotal;
    const dateLabel = new Date(d + 'T00:00:00Z').toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
    return `<tr><td>${escapeHtml(dateLabel)}</td>${counties.map(c => `<td>${fmt(counts[c] || 0)}</td>`).join('')}<td>${fmt(dayTotal)}</td><td>${fmt(running)}</td></tr>`;
  }).join('');
}
// v441: Overview drill-down -- jumps to List Builder pre-filtered to match
// the clicked card's count. paramsPatch is exactly the shape
// lbCollectFilterParams()/lbApplyFilterParams() already use (Task 6's
// Save/Load Quick Filter pair), so this needed no new filter plumbing --
// every field a card can drill into (county/absenteeOnly/corporateOwnerOnly/
// isInherited/isProbateEstateOnly/hasBuildingCodeLawsuitOnly/
// isVacantBuildingOnly/tiredLandlordOnly/longTermOwnerOnly/isMfh2to4/
// isMfh5Plus) already has a control in List Builder's Filter card or its
// v437 Advanced Filters panel. '{}' (Total Properties) clears every filter,
// since it represents the unfiltered set.
async function lbDrillDownFromOverview(paramsPatch){
  activateDataSciSection('list_builder');
  // initListBuilderSection() is idempotent (guarded by lbFacetsLoadPromise,
  // a memoized PROMISE rather than a boolean -- see its declaration for the
  // silent-unfiltered-search bug that caused) -- safe to await here even
  // though activateDataSciSection also just fired it unawaited, and
  // necessary: lbApplyFilterParams touches the county dropdown, which needs
  // facets loaded first or it has nothing to select.
  await initListBuilderSection();
  lbApplyFilterParams(paramsPatch);
  await runListBuilderSearch();
}
document.querySelectorAll('.dsOverview-drill').forEach(el => {
  el.addEventListener('click', () => {
    let patch = {};
    try { patch = JSON.parse(el.dataset.lbFilter || '{}'); } catch(e) { console.error('Bad data-lb-filter on Overview card', el, e); }
    lbDrillDownFromOverview(patch);
  });
});
document.querySelectorAll('.datasci-subtab-btn').forEach(btn => {
