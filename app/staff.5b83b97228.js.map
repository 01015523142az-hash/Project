            <td>${escapeHtml(p.pushed_by_name || '—')}</td>
            <td>${escapeHtml([p.first_name, p.last_name].filter(Boolean).join(' ') || '—')}</td>
            <td class="mono">${escapeHtml(p.phone || '—')}</td>
            <td style="max-width:220px; white-space:normal; color:var(--text-2);">${escapeHtml([p.address, p.city, p.state, p.zip].filter(Boolean).join(', ') || '—')}</td>
            <td>${p.success
              ? `<span style="color:var(--focus);">Accepted${p.readymode_lead_id ? ` (${escapeHtml(p.readymode_lead_id)})` : ''}</span>`
              : `<span style="color:var(--danger);" title="${escapeHtml(p.error || '')}">Failed${p.error ? ': ' + escapeHtml(p.error.slice(0, 60)) : ''}</span>`}</td>
