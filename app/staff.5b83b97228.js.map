// ---------- voice messages ----------
// Recording reuses the exact same "pending attachment" pipeline as file
// uploads (chatPendingFile / chatAttachPreview / sendChatMessage) — a
// recorded clip is just a File object with an audio/webm mime type, same
// as any other attachment from here on.
let chatMediaRecorder = null;
let chatRecordingChunks = [];
let chatRecordingTimerHandle = null;
let chatRecordingStream = null;

function chatUpdateRecordingTimer(startedAt){
  const secs = Math.floor((Date.now() - startedAt) / 1000);
  $('chatRecordingTimer').textContent = `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`;
}

async function chatStartRecording(){
  if(!navigator.mediaDevices || !window.MediaRecorder){
    alert('Voice messages aren\u2019t supported in this browser.');
    return;
  }
  try{
    chatRecordingStream = await navigator.mediaDevices.getUserMedia({ audio: true });
  }catch(e){
    alert('Microphone access was denied or isn\u2019t available.');
    return;
  }
  chatRecordingChunks = [];
  chatMediaRecorder = new MediaRecorder(chatRecordingStream);
  chatMediaRecorder.ondataavailable = (e) => { if(e.data.size > 0) chatRecordingChunks.push(e.data); };
  chatMediaRecorder.start();
  const startedAt = Date.now();
  $('chatInputRow').style.display = 'none';
  $('chatRecordingBar').style.display = 'flex';
  chatUpdateRecordingTimer(startedAt);
  chatRecordingTimerHandle = setInterval(() => chatUpdateRecordingTimer(startedAt), 1000);
}

// discard=true throws the recording away (Cancel button, or navigating
// away mid-recording); discard=false (Stop button) keeps it as a pending
// attachment ready to send, same as picking a file would.
function chatStopRecording(discard){
  if(chatRecordingTimerHandle){ clearInterval(chatRecordingTimerHandle); chatRecordingTimerHandle = null; }
  $('chatRecordingBar').style.display = 'none';
  if(!chatMediaRecorder || chatMediaRecorder.state === 'inactive'){
    if(chatRecordingStream){ chatRecordingStream.getTracks().forEach(t => t.stop()); chatRecordingStream = null; }
    $('chatInputRow').style.display = 'flex';
    return;
  }
  chatMediaRecorder.onstop = () => {
    if(chatRecordingStream){ chatRecordingStream.getTracks().forEach(t => t.stop()); chatRecordingStream = null; }
    $('chatInputRow').style.display = 'flex';
    if(discard || chatRecordingChunks.length === 0) return;
    const blob = new Blob(chatRecordingChunks, { type: 'audio/webm' });
    const file = new File([blob], `voice-message-${Date.now()}.webm`, { type: 'audio/webm' });
    chatClearPendingFile();
    chatPendingFile = { file, previewUrl: URL.createObjectURL(blob), isVoice: true };
    const preview = $('chatAttachPreview');
    preview.style.display = 'flex';
    preview.innerHTML = `
      <audio controls src="${chatPendingFile.previewUrl}" style="height:32px;"></audio>
      <span class="chat-attach-remove" title="Remove">&times;</span>
    `;
    preview.querySelector('.chat-attach-remove').addEventListener('click', chatClearPendingFile);
  };
  chatMediaRecorder.stop();
}
$('chatMicBtn').addEventListener('click', chatStartRecording);
$('chatRecordingStopBtn').addEventListener('click', () => chatStopRecording(false));
$('chatRecordingCancelBtn').addEventListener('click', () => chatStopRecording(true));

let lastTeamRows = [];
let teamFlagsByAgent = {};
// If an agent has been continuously idle or on break for longer than this,
// the Staff tab shows "not tracking" instead of "idle"/"on break" — past
// this point it's almost always the browser having gone to sleep, the
// extension crashing, or the agent walking away and never coming back,
// rather than a genuine still-in-progress pause. This is purely a display
// override here in the dashboard: it doesn't touch idle_seconds, the
// idle_periods/breaks rows, or anything the extension relies on — the
// moment the agent actually resumes (or a fresh idle/break stretch starts
// under an hour), the normal "idle"/"on break" label is back automatically
// on the next refresh.
const STALE_PAUSE_MS = 60 * 60 * 1000; // 1 hour

// v218: an open time_entries row (end_time null) used to be treated as
// "still tracking, right up to this very second" everywhere — every
// productive-time calculation did `e.end_time ? ... : Date.now()`. That's
// correct while the extension is genuinely still running, but the moment
// it stops reporting at all (signed out, browser/computer crashed, lost
// network, force-quit, extension disabled) NOTHING further gets logged —
// no more idle_periods, no more last_heartbeat_at updates — so every
// second between then and whenever someone next looks at the dashboard
// (or the auto-close-stale-entries cron eventually catches it, up to an
// hour+ later) silently counted as 100% productive, with nothing left to
// subtract it. Same root cause auto-close-stale-entries already guards
// against server-side (see that Edge Function's own HEARTBEAT-STALE
// comment) — this applies the identical rule live, in the dashboard,
// instead of waiting for that hourly job to close the row out.
// 15 minutes matches auto-close-stale-entries' own default
// heartbeat_stale_minutes, so "stale" means the same thing in both places.
const LIVE_ENTRY_STALE_MS = 15 * 60 * 1000;
function liveEntryIsStale(e){
  if(!e || e.end_time || !e.last_heartbeat_at) return false;
  return (Date.now() - new Date(e.last_heartbeat_at).getTime()) > LIVE_ENTRY_STALE_MS;
}
// The correct "end" of an open entry's productive window: still-open and
// fresh -> now (genuinely live); still-open and stale -> the last moment
// there's real evidence of life (last_heartbeat_at), same capping
// auto-close-stale-entries itself uses; already closed -> end_time.
function liveEntryEndMs(e){
  if(e.end_time) return new Date(e.end_time).getTime();
  if(liveEntryIsStale(e)) return new Date(e.last_heartbeat_at).getTime();
  return Date.now();
}

// ---------- flag badge popover (Staff tab) ----------
let activeFlagPopover = null;
function closeFlagPopover(){
  if(activeFlagPopover){ activeFlagPopover.remove(); activeFlagPopover = null; }
  document.removeEventListener('click', closeFlagPopoverOnOutsideClick, true);
  window.removeEventListener('scroll', closeFlagPopover, true);
}
function closeFlagPopoverOnOutsideClick(e){
  if(activeFlagPopover && !activeFlagPopover.contains(e.target)) closeFlagPopover();
}
// Anchored just under the clicked badge — clicking the same badge again,
// clicking anywhere else, or scrolling closes it.
function showFlagPopover(anchorEl, agentName, flags){
  const reopeningSame = activeFlagPopover && activeFlagPopover.dataset.anchorFor === agentName;
  closeFlagPopover();
  if(reopeningSame) return; // click-to-toggle: second click on the same badge just closes it

  const rect = anchorEl.getBoundingClientRect();
  const pop = document.createElement('div');
  pop.className = 'flag-popover';
  pop.dataset.anchorFor = agentName;
  const left = Math.min(rect.left, window.innerWidth - 320 - 12);
  pop.style.cssText = `position:fixed; top:${rect.bottom + 6}px; left:${Math.max(12, left)}px; z-index:1000;`;
  pop.innerHTML = `
    <div class="flag-popover-header">
      <span>${escapeHtml(agentName)} — today's flags</span>
      <button type="button" class="flag-popover-close" aria-label="Close">&times;</button>
    </div>
    <div class="flag-popover-body">
      ${flags.map(f => `
        <div class="flag-popover-item">
          <div class="flag-popover-type">${SUSPICION_TYPE_META[f.type].label}</div>
          <div class="flag-popover-detail">${f.detail}</div>
        </div>
      `).join('') || '<div class="flag-popover-detail">No flags.</div>'}
    </div>
  `;
  document.body.appendChild(pop);
  activeFlagPopover = pop;
  pop.querySelector('.flag-popover-close').addEventListener('click', closeFlagPopover);
  pop.addEventListener('click', (e) => e.stopPropagation()); // clicks inside shouldn't count as "outside"
  // Deferred so the click that opened this popover doesn't immediately
  // bubble into the same-tick outside-click listener and close it again.
  setTimeout(() => {
    document.addEventListener('click', closeFlagPopoverOnOutsideClick, true);
    window.addEventListener('scroll', closeFlagPopover, true);
  }, 0);
}

// Global "Times shown in" toggle (in the nav, above every tab) — controls
// what timezone Dashboard/Timesheets/Activity/Flags/Audit Log render clock
// times in. 'agent' (default) keeps each row on that row's own agent's
// schedule timezone (falls back to browser local for an agent with none
// set); picking Cairo or Chicago instead pins EVERY row across all five
// tabs to that one zone, so a mixed Cairo/Chicago team can be compared on
// one common clock. Purely a display choice — it only ever changes how a
// stored timestamp is *rendered*, never the timestamp itself, and never
// which calendar day an entry's totals are counted under.
// CONVENTION — read before adding any new timestamp display anywhere in
// this file: every rendered point-in-time value (timestamptz/ISO instant
// — created_at, submitted_at, received_at, updated_at, message/call
// times, etc.) must respect this "Times shown in" toggle. Plain calendar-
// date columns with no time-of-day component (e.g. employment_start_date)
// are the one exception — nothing to localize there. Pick whichever of
// these already matches your tab, in priority order:
//   1. A per-row agent is known (a lead/time-entry/call belongs to one
//      specific staff member) -> use that tab's own tz-for-agent helper
//      if one exists (leadsTzFor, tsTzFor/tsFmtTime/tsFmtDateTime,
//      resolveDashTz above), or add one following that exact pattern if
//      the tab doesn't have one yet.
//   2. No natural per-row agent (chat, client/campaign records, Finance/
//      Taxes/HR/connection-sync rows, PDF/CSV export footers) -> call
//      nonAgentDisplayTz() below and spread it in:
//      `...(tz ? { timeZone: tz } : {})`.
// v395 fixed ~50 call sites across every tab that were still hardcoded to
// the browser's own local zone or a fixed UTC slice — don't reintroduce
// that gap in new code.
let globalDisplayTzMode = 'America/Chicago';
function resolveDashTz(agentOwnTz){
  return globalDisplayTzMode === 'agent' ? agentOwnTz : globalDisplayTzMode;
}
// v395: shared by every tab/section that renders a timestamp with no
// clean per-row agent to fall back to for "Agent local" mode (chat,
// notifications, PDF export footers, connection/sync dates, HR
// submissions, Finance/Taxes records, etc.) — same fallback convention
// renderCsubSectionTable's own csubTz already used, just hoisted so every
// other call site doesn't have to redeclare the identical ternary. Falls
// back to the browser's own local zone (by omitting timeZone entirely,
// via the same `...(tz ? { timeZone: tz } : {})` spread convention used
// throughout this file) when the toggle is set to "Agent local" and
// there's no specific agent this timestamp belongs to.
function nonAgentDisplayTz(){
  return globalDisplayTzMode === 'agent' ? undefined : globalDisplayTzMode;
}

// v696: EVERY date and time the staff portal prints follows the "Times shown
// in" toggle. About 25 call sites here (and ~36 in Dialer Management, which
// shares this page) formatted with no timeZone at all, so they showed the
// BROWSER's zone -- Egypt for most staff -- whatever the toggle said. Rather
// than threading tz through each of them, and every future one, the three
// Date formatters default to the toggle's zone when the caller names none.
// A caller that passes its own timeZone (an agent's, in "Agent local" mode)
// still wins, and "Agent local" leaves the browser's zone alone, as before.
//
// Calendar DATES are not moved. A plain date ("2026-09-14", a timesheet day,
// an employment start date) is a Date at local or UTC midnight printed with
// no time; giving it a zone would print the DAY BEFORE for anyone east of
// that zone. So a date-only format of an exact-midnight value keeps its own
// calendar day: local midnight as-is, UTC midnight in UTC. Verified in Node
// as an Egypt browser with the toggle on US Central (scratch tztest.js).
// Intl.DateTimeFormat is not wrapped: every use of it here names a zone.
(function installGlobalTzDefault(){
  const DATE_KEYS = ['year', 'month', 'day', 'weekday', 'dateStyle', 'era'];
  const TIME_KEYS = ['hour', 'minute', 'second', 'timeStyle', 'dayPeriod', 'fractionalSecondDigits'];
  function zoneFor(d, opts, kind){
    if(opts && opts.timeZone) return opts;
    let tz;
    try { tz = nonAgentDisplayTz(); } catch(e){ return opts; }
    if(!tz || !(d instanceof Date) || isNaN(d)) return opts;
    const o = opts || {};
    const dateOnly = kind === 'date'
      || (kind === 'any' && opts && TIME_KEYS.every(k => o[k] === undefined) && DATE_KEYS.some(k => o[k] !== undefined));
    if(dateOnly){
      if(d.getHours() === 0 && d.getMinutes() === 0 && d.getSeconds() === 0 && d.getMilliseconds() === 0) return opts;
      if(d.getUTCHours() === 0 && d.getUTCMinutes() === 0 && d.getUTCSeconds() === 0 && d.getUTCMilliseconds() === 0) return Object.assign({}, o, { timeZone: 'UTC' });
    }
    return Object.assign({}, o, { timeZone: tz });
  }
  [['toLocaleString', 'any'], ['toLocaleDateString', 'date'], ['toLocaleTimeString', 'time']].forEach(([m, kind]) => {
    const orig = Date.prototype[m];
    Date.prototype[m] = function(locales, opts){ return orig.call(this, locales, zoneFor(this, opts, kind)); };
  });
})();
document.querySelectorAll('.global-tz-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    // Capture "today" under the OLD zone before switching, so we can tell
    // whether the Timesheets From/To fields were sitting on the default
    // "today" (in which case they should follow the toggle to the new
    // zone's today) versus a date the admin picked deliberately (in which
    // case we leave it alone — switching zones shouldn't silently discard
    // an explicit filter).
    const oldToday = todayDateInputValue();
    globalDisplayTzMode = btn.dataset.tz;
    document.querySelectorAll('.global-tz-btn').forEach(b => b.classList.toggle('active', b === btn));
    const newToday = todayDateInputValue();
    if(newToday !== oldToday){
      // Same rule for every tab with a From/To pair: only resync fields
      // that were still sitting on the OLD zone's default "today" — a
      // deliberately-picked date or range is left untouched, so the
      // toggle never silently discards an explicit filter.
      [['tsFromDateInput', 'tsToDateInput'], ['callActFromInput', 'callActToInput'], ['leadsFromDateInput', 'leadsToDateInput']].forEach(([fromId, toId]) => {
        const fromEl = $(fromId), toEl = $(toId);
        if(fromEl && toEl && fromEl.value === oldToday && toEl.value === oldToday){
          fromEl.value = newToday;
          toEl.value = newToday;
        }
      });
    }
    // Only the currently-visible tab needs to re-render right now; any
    // other tab already re-reads this same global state (via resolveDashTz/
    // tsTzFor/resolveActTz) the next time it's activated, since every tab
    // reloads its data on every switch (see activateTab()).
    const activePanel = document.querySelector('.tab-panel.active');
    if(!activePanel) return;
    if(activePanel.id === 'tab-time_management' && tmActiveSection === 'staff') loadTeam();
    else if(activePanel.id === 'tab-time_management' && tmActiveSection === 'timesheets') loadTimesheets();
    else if(activePanel.id === 'tab-call_activity') loadCallActivity();
    else if(activePanel.id === 'tab-leads') loadLeads();
    else if(activePanel.id === 'tab-client_submissions') loadClientSubmissions();
  });
});

const TEAM_STATIC_TTL_MS = 5 * 60 * 1000;
let teamStaticCache = null;   // { at, promise }
function invalidateTeamStatic(){ teamStaticCache = null; }
function loadTeamStatic(){
  if(teamStaticCache && Date.now() - teamStaticCache.at < TEAM_STATIC_TTL_MS) return teamStaticCache.promise;
  const promise = Promise.all([
    sb.from('app_settings').select('value').eq('key', 'min_extension_version').maybeSingle(),
    fetchAllRows((from, to) => sb.from('schedules').select('user_id, timezone').order('user_id', { ascending: true }).range(from, to)),
    fetchAllRows((from, to) => sb.from('tasks').select('id').eq('is_dialer_task', true).order('id', { ascending: true }).range(from, to)),
    fetchAllRows((from, to) => sb.from('dialer_domains').select('domain').order('id', { ascending: true }).range(from, to)),
    fetchAllRows((from, to) => sb.from('tasks').select('id, category_id, task_categories(idle_policy, abuse_check_ratio, abuse_check_min_hours), task_domains(domain)').not('category_id', 'is', null).order('id', { ascending: true }).range(from, to)),
  ]).then(([{ data: minVersionRow }, scheduleRows, dialerTaskRows, dialerDomainRows, categorizedTaskRows]) =>
    ({ minVersionRow, scheduleRows, dialerTaskRows, dialerDomainRows, categorizedTaskRows }));
  teamStaticCache = { at: Date.now(), promise };
  promise.catch(() => { if(teamStaticCache && teamStaticCache.promise === promise) teamStaticCache = null; });
  return promise;
}
async function loadTeam(){
  // The DB queries below fetch a window wide enough to cover "today" in
  // ANY agent's schedule timezone (max UTC offset spread is ~26h, so 30h
  // is a safe buffer) — each agent's actual day boundary is computed
  // separately, per-agent, further down using their own timezone. Fetching
  // wide once for the whole team and clipping per-agent client-side is
  // far cheaper than a separate query per agent.
  const TEAM_QUERY_LOOKBACK_MS = 30 * 3600 * 1000;
  const start = new Date(Date.now() - TEAM_QUERY_LOOKBACK_MS).toISOString();
  // audit fix (Time Management deep-scan pass): profiles/time_entries below
  // were single unbounded fetches — for a large team, the 30h team-wide
  // window (every agent's "today" at once, not per-agent) can plausibly
  // exceed the row cap on its own. Paginated for consistency with the rest
  // of Time Management; see fetchAllRows()'s own comment.
  // v676: every query below is independent of the others, so they all go in
  // ONE parallel batch (they used to run in five sequential rounds), and the
  // slow-changing configuration (schedules, dialer tasks/domains, task
  // categories, minimum extension version) is cached for five minutes
  // instead of being re-read on every dashboard refresh.
  const teamStatic = loadTeamStatic();
  const [agents, { minVersionRow, scheduleRows, dialerTaskRows, dialerDomainRows, categorizedTaskRows }] = await Promise.all([
    fetchAllRows((from, to) => sb.from('profiles').select('id, full_name, email, role, extension_version, extension_version_at, is_active, department, title, grade, american_name').order('full_name').range(from, to)),
    teamStatic,
  ]);
  const minVersion = (minVersionRow && minVersionRow.value && minVersionRow.value !== '0.0.0') ? minVersionRow.value : null;
  const agentTz = {};
  (scheduleRows || []).forEach(s => { if(s.timezone) agentTz[s.user_id] = s.timezone; });
  // fetch entries that OVERLAP the lookback window (still open, or ended
  // after it started) rather than only ones that started inside it — a
  // session running across midnight would otherwise be silently excluded.
  const overlapEntriesP = fetchAllRows((from, to) => sb.from('time_entries')
    .select('id, user_id, start_time, end_time, task_id, idle_seconds, break_seconds, is_manual, last_heartbeat_at')
    .or(`end_time.is.null,end_time.gte.${start}`)
    .order('id', { ascending: true }).range(from, to));
  // live status needs to know not just "is a time entry open" but whether
  // the agent is currently mid-break or currently idle within that entry —
  // otherwise everyone with an open entry shows as "tracking" even while
  // on break or away. start_time on each is used for "time in status".
  // Keyed by time_entry_id (not just user_id): an open breaks/idle_periods
  // row only reflects "current status" if it belongs to the agent's
  // actual live entry. Without this check, a row left open by an old
  // session that was later closed out from the side (e.g. a manual SQL
  // fix or a deleted entry, rather than through the extension's normal
  // stop/resume flow) would permanently stick that agent on "idle" or
  // "on break" even though they're tracking fine right now.
  const openBreaksP = sb.from('breaks').select('user_id, start_time, time_entry_id').is('end_time', null);
  const openIdlesP = sb.from('idle_periods').select('user_id, start_time, time_entry_id').is('end_time', null);
  const recentClosedP = sb.from('time_entries')
    .select('user_id, end_time, start_time')
    .not('end_time', 'is', null)
    .order('end_time', { ascending: false })
    .limit(2000);

  // Today's activity samples, url visits, and full idle-period history
  // (not just the currently-open ones above), for the suspicion-flag
  // badges below — one query each for the whole team rather than
  // per-agent, same overlap-friendly pattern as overlapEntries above.
  // audit fix (Time Management deep-scan pass): same silent-truncation gap
  // as the Flags scan (this is the same suspicion-flag computation, scoped
  // to "today" for the team-overview badges instead of an admin-picked
  // range) — every one of these was an unbounded fetch. A 30h window across
  // an entire team's activity_samples in particular can realistically
  // exceed the row cap on its own. All paginated now; see fetchAllRows().
  const [
    todaySamples, todayIdlePeriods, todayUrlVisits, todayShots, todayBreaks,
    overlapEntries, { data: openBreaks }, { data: openIdles }, { data: recentClosed },
  ] = await Promise.all([
    fetchAllRows((from, to) => sb.from('activity_samples').select('time_entry_id, user_id, sampled_at, mouse_events, keyboard_events').gte('sampled_at', start).order('id', { ascending: true }).range(from, to)),
    fetchAllRows((from, to) => sb.from('idle_periods').select('time_entry_id, start_time, end_time').gte('start_time', start).order('id', { ascending: true }).range(from, to)),
    fetchAllRows((from, to) => sb.from('url_visits').select('time_entry_id, domain, start_time, end_time').gte('start_time', start).order('id', { ascending: true }).range(from, to)),
    fetchAllRows((from, to) => sb.from('screenshots').select('time_entry_id, taken_at').gte('taken_at', start).order('id', { ascending: true }).range(from, to)),
    fetchAllRows((from, to) => sb.from('breaks').select('time_entry_id, start_time, end_time').gte('start_time', start).order('id', { ascending: true }).range(from, to)),
    overlapEntriesP, openBreaksP, openIdlesP, recentClosedP,
  ]);
  const onBreakByEntry = {}; (openBreaks || []).forEach(b => { if(b.time_entry_id) onBreakByEntry[b.time_entry_id] = b.start_time; });
  const idleByEntry = {}; (openIdles || []).forEach(i => { if(i.time_entry_id) idleByEntry[i.time_entry_id] = i.start_time; });
  const shotCountByEntry = {};
  (todayShots || []).forEach(s => { if(s.time_entry_id) shotCountByEntry[s.time_entry_id] = (shotCountByEntry[s.time_entry_id] || 0) + 1; });
  // v1.2.5: "resumed at" per entry — the latest end_time across all CLOSED
  // idle/break periods for that entry. Used so the Dashboard status timer for
  // a productive agent counts from when their CURRENT productive stretch
  // began (i.e. when they last came back from idle/break), not from the whole
  // session's start. Without this, 10m productive + 5m idle + 5m productive
  // would show "productive 20m" instead of the correct 5m.
  const lastResumeByEntry = {};
  const _trackResume = (r) => {
    if(!r.time_entry_id || !r.end_time) return;
    const ms = new Date(r.end_time).getTime();
    if(!(r.time_entry_id in lastResumeByEntry) || ms > lastResumeByEntry[r.time_entry_id]) {
      lastResumeByEntry[r.time_entry_id] = ms;
    }
  };
  (todayIdlePeriods || []).forEach(_trackResume);
  (todayBreaks || []).forEach(_trackResume);
  const teamIdlePeriodsByEntry = groupByEntry(todayIdlePeriods, 'start_time');
  const teamBreaksByEntry = groupByEntry(todayBreaks, 'start_time');
  const suspicionCtx = {
    samplesByEntry: groupSamplesByEntry(todaySamples),
    idlePeriodsByEntry: teamIdlePeriodsByEntry,
    urlVisitsByEntry: groupByEntry(todayUrlVisits, 'start_time'),
    dialerTaskIds: new Set((dialerTaskRows || []).map(t => t.id)),
    dialerDomains: (dialerDomainRows || []).map(d => d.domain),
    taskCategoryMap: buildTaskCategoryMap(categorizedTaskRows),
  };

  // Most recent end_time per agent, regardless of day — this is "when did
  // they last stop tracking", which may not be today at all if they
  // haven't clocked in yet. Ordered desc so the first row per user_id is
  // their latest; capped so this stays a cheap query on a large table.
  const lastEndMap = {};
  (recentClosed || []).forEach(e => { if(!(e.user_id in lastEndMap)) lastEndMap[e.user_id] = e.end_time; });

  const body = $('teamBody');
  lastTeamRows = [];
  teamFlagsByAgent = {};
  // Everyone with a non-protected role always shows here (Owner and Admin
  // both manage the same "Users/Quality/custom role" team). Admin
  // accounts additionally show, but ONLY when the viewer is Owner — an
  // Admin looking at this same list never sees other Admins, just like
  // before. The Owner's OWN row is also shown to the Owner (and only to
  // the Owner, and only their own row — not other Owners, since there's
  // exactly one) so they have somewhere to update their own name/email/
  // password; see the Role-field lock in openDetail/refreshAcctRoleOptions,
  // which stops that from ever changing the Owner's own role. Sorted into
  // groups by role — Admin's group first (Owner's view only), then every
  // other role alphabetically by its display label, each group sorted by
  // name — and rendered with a group-header row per role below, so e.g. a
  // "Sales" role and the built-in "User" role each show as their own
  // labeled cluster instead of one flat alphabetical list.
  const visibleAgents = (agents || [])
    .filter(a => !PROTECTED_ROLES.has(a.role) || (myIsOwner && a.role === 'admin') || (myIsOwner && a.id === myUserId))
    .sort((a, b) => {
      const aAdmin = a.role === 'admin' ? 0 : 1, bAdmin = b.role === 'admin' ? 0 : 1;
      if(aAdmin !== bAdmin) return aAdmin - bAdmin;
      const aLabel = roleDisplayLabel(a.role), bLabel = roleDisplayLabel(b.role);
      if(aLabel !== bLabel) return aLabel.localeCompare(bLabel);
      const aName = a.full_name || '', bName = b.full_name || '';
      if(aName !== bName) return aName.localeCompare(bName);
      // v1.2.19: final deterministic tiebreak by id. Without this, two
      // agents tying on role+name (most commonly both with a blank/unset
      // full_name) had no guaranteed order between polls — Postgres makes
      // no promise about row order among ties on an ORDER BY column, so
      // the same two rows could come back in a different order on
      // consecutive 20s polls. Since loadTeam()'s reconciliation moves
      // rows to match this sort exactly, an unstable tie here is what
      // made rows appear to swap/shuffle under the columns on refresh
      // even though nothing about the underlying agents had changed.
      return String(a.id).localeCompare(String(b.id));
    });

  // This tab reloads on a 20s poll (see refreshAll/pollHandle) so a live
  // agent's status timer doesn't look frozen. Previously this rebuilt the
  // whole <tbody> from scratch every time (innerHTML = '' + re-append
  // everything), which visibly flashed the table, could shift page scroll,
  // and yanked an open flag popover out from under whoever had one open
  // (its anchor button no longer existed). Now existing agent rows are
  // reused by id — only their cell contents refresh in place — so an
  // unrelated row's popover, hover state, and the page's scroll position
  // are left alone. Group-header rows have no state worth preserving, so
  // those are just rebuilt fresh each time; cheap either way.
  const existingRowsById = new Map();
  body.querySelectorAll('tr.agent-row[data-agent-id]').forEach(tr => existingRowsById.set(tr.dataset.agentId, tr));
  const desiredNodes = [];

  let lastGroupLabel = null;
  visibleAgents.forEach(agent => {
    const groupLabel = roleDisplayLabel(agent.role);
    if(groupLabel !== lastGroupLabel){
      lastGroupLabel = groupLabel;
      const groupTr = document.createElement('tr');
      groupTr.className = 'team-group-header';
      groupTr.innerHTML = `<td colspan="8">${groupLabel}</td>`;
      desiredNodes.push(groupTr);
    }
    const myEntriesRaw = (overlapEntries || []).filter(e => e.user_id === agent.id);
    // "Today" for THIS agent — in their own schedule timezone by default
    // ('agent' mode), or pinned to the fixed Cairo/Chicago zone when the
    // admin has the global "Times shown in" toggle set to one of those —
    // same resolveDashTz() used just below for the rendered clock times.
    // This used to always use the agent's own tz regardless of the toggle,
    // so switching to Cairo/Chicago changed the displayed start/end times
    // but silently left Focus/Idle/Break/Total computed on the OLD
    // per-agent day boundary — the totals never matched the zone shown in
    // the header. Now both use the same resolved zone, so flipping the
    // toggle re-buckets "today" (and the totals with it) consistently.
    const { startMs: agentDayStartMs } = dayBoundsMsInZone(resolveDashTz(agentTz[agent.id]));
    const myEntries = myEntriesRaw.filter(e => {
      const rawEnd = liveEntryEndMs(e);
      return rawEnd > agentDayStartMs; // overlaps today in the agent's own timezone
    });
    const { focusSec, idleSec, breakSec } = computeClippedTotals(myEntries, teamIdlePeriodsByEntry, teamBreaksByEntry, agentDayStartMs);
    const totalSec = focusSec + idleSec + breakSec;
    // Live-entry lookup uses the full (unfiltered) entry set, not the
    // today-only one above — an overnight shift that started "yesterday"
    // in the agent's zone but is still running right now must still show
    // as live status, even though its start predates today's boundary.
    const liveEntry = myEntriesRaw.find(e => !e.end_time);

    // Flag badge uses the same "today" cutoff as the stats above (myEntries,
    // not myEntriesRaw) — it previously scanned the full ~30h lookback
    // window, so a flag from yesterday could still show up in today's
    // count instead of the badge resetting once the agent's day rolls
    // over. Both flag functions are self-contained per entry/per-day, so
    // narrowing the input here doesn't lose any needed cross-day context.
    const myFlags = computeSuspicionFlags(myEntries, suspicionCtx)
      .concat(computeChoppedSessionFlags(myEntries, agentTz))
      .concat(computeSparseScreenshotFlags(myEntries, shotCountByEntry))
      .concat(computeMergedSessionFlags(myEntries, agentTz));
    teamFlagsByAgent[agent.id] = myFlags;
    const flagBadge = myFlags.length
      ? ` <button type="button" class="flag-badge" data-agent-id="${agent.id}">&#9888; ${myFlags.length}</button>`
      : '';

    let statusLabel, dotClass, statusSince;
    const breakSince = liveEntry && onBreakByEntry[liveEntry.id];
    const idleSince = liveEntry && idleByEntry[liveEntry.id];
    const staleSince = since => since && (Date.now() - new Date(since).getTime()) > STALE_PAUSE_MS;
    if (liveEntry && breakSince && !staleSince(breakSince)) { statusLabel = 'on break'; dotClass = 'status-break'; statusSince = breakSince; }
    else if (liveEntry && idleSince && !staleSince(idleSince)) { statusLabel = 'idle'; dotClass = 'status-idle'; statusSince = idleSince; }
    else if (liveEntry && (breakSince || idleSince)) {
      // Was idle/on break, but it's been going for over an hour straight —
      // treat as effectively not tracking rather than showing a pause that
      // (in practice) is very unlikely to still be genuine.
      statusLabel = 'not tracking'; dotClass = 'off'; statusSince = null;
    }
    else if (liveEntry && liveEntryIsStale(liveEntry)) {
      // v218: no heartbeat for 15+ minutes with no Stop click — signed
      // out, crashed, lost network, laptop closed, whatever the actual
      // cause, the extension isn't reporting anymore. This used to fall
      // through to the generic "productive" branch below and show a
      // live-ticking "productive for X" timer that just kept growing
      // until the hourly auto-close-stale-entries job eventually closed
      // the row — see liveEntryEndMs()'s own comment for why this matters
      // for the actual counted hours too, not just this label.
      statusLabel = 'disconnected'; dotClass = 'off'; statusSince = liveEntry.last_heartbeat_at;
    }
    else if (liveEntry) {
      statusLabel = 'productive'; dotClass = 'on';
      // v1.2.5: count from when the CURRENT productive stretch began — the
      // later of the session start and the most recent idle/break end — so
      // time spent idle/on-break earlier in the session isn't carried over
      // into the "productive for X" timer.
      const resumeMs = lastResumeByEntry[liveEntry.id];
      const startMs = new Date(liveEntry.start_time).getTime();
      statusSince = new Date((resumeMs && resumeMs > startMs) ? resumeMs : startMs).toISOString();
    }
    else { statusLabel = 'not tracking'; dotClass = 'off'; statusSince = null; }

    const statusMinLabel = statusSince ? fmtShort(Math.max(0, (Date.now() - new Date(statusSince).getTime()) / 1000)) : '—';
    // v1.2.5: real-time status timing. statusSinceMs feeds a live per-second
    // ticker (see the tickStatusTimers interval), and statusStartLabel shows
    // the wall-clock time this status began, in the agent's own timezone.
    const statusSinceMs = statusSince ? new Date(statusSince).getTime() : null;
    // Rendered in this agent's own local/PC time (their schedules.timezone)
    // by default, or pinned to a fixed zone (Cairo/Chicago) when the admin
    // toggles "Times shown in" above the table — see resolveDashTz(). Falls
    // back to browser local if that agent has no timezone set and no fixed
    // zone is selected.
    const tz = resolveDashTz(agentTz[agent.id]);
    const statusStartLabel = statusSince
      ? new Date(statusSince).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', ...(tz ? { timeZone: tz } : {}) })
      : null;
    // Status timer color matches the status itself, not a fixed color —
    // tracking green, idle red, on break orange.
    const statusTimerClass = dotClass === 'on' ? 'pct-focus' : dotClass === 'status-idle' ? 'text-idle' : dotClass === 'status-break' ? 'text-break' : '';
    const lastEnd = lastEndMap[agent.id];
    const lastEndLabel = lastEnd
      ? new Date(lastEnd).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(tz ? { timeZone: tz } : {}) })
      : '—';

    // v1.2.5: "Login / start time" replaces the Version column — the
    // earliest start_time among TODAY's entries for this agent (myEntries,
    // the same today-in-their-own-timezone set the totals above use), i.e.
    // their first clock-in of the day. Deliberately NOT tied to liveEntry or
    // to whichever entry is most recent: stopping and restarting tracking
    // (or a break/idle stretch splitting the day's activity) must not push
    // this forward — it should only ever change once, at midnight in the
    // agent's own timezone, when a new "today" begins.
    const firstStartTodayMs = myEntries.reduce((min, e) => {
      const t = new Date(e.start_time).getTime();
      return (min === null || t < min) ? t : min;
    }, null);
    const loginStartLabel = firstStartTodayMs !== null
      ? new Date(firstStartTodayMs).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(tz ? { timeZone: tz } : {}) })
      : '—';

    // Self-reported by the extension (at login and every ~30 min in the
    // background, independent of tracking state) — never reported at all
    // (old build from before this existed, or never logged in) shows as
    // "—" rather than being treated as outdated, since we simply don't know.
    const version = agent.extension_version;
    const isOutdatedVersion = !!(version && minVersion && compareVersionStrings(version, minVersion) < 0);
    const versionLabel = version || '—';
    const versionTitle = version
      ? `Reported ${agent.extension_version_at ? new Date(agent.extension_version_at).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(tz ? { timeZone: tz } : {}) }) : 'time unknown'}`
      : 'Never reported — old build, or never logged in since this was added';
    const versionCell = isOutdatedVersion
      ? `<span class="text-idle" title="${versionTitle} — below required v${minVersion}">${versionLabel} &#9888;</span>`
      : `<span style="${version ? '' : 'color:var(--text-dim);'}" title="${versionTitle}">${versionLabel}</span>`;

    lastTeamRows.push({
      name: agent.full_name || agent.email,
      status: `${statusLabel} (${statusMinLabel})`,
      focus: fmtShort(focusSec),
      idle: fmtShort(idleSec),
      brk: fmtShort(breakSec),
      total: fmtHM(totalSec),
      loginStart: loginStartLabel,
      type: roleDisplayLabel(agent.role || 'user'),
      lastEnd: lastEndLabel,
    });

    let tr = existingRowsById.get(agent.id);
    const isNewRow = !tr;
    if(isNewRow){
      tr = document.createElement('tr');
      tr.className = 'agent-row';
      tr.dataset.agentId = agent.id;
    }
    const agentTypeLabel = roleDisplayLabel(agent.role || 'user');
    tr.innerHTML = `
      <td>${escapeHtml(agent.full_name || agent.email)}${flagBadge}<div style="font-size:10px; color:var(--text-dim); margin-top:2px;">${agentTypeLabel}</div></td>
      <td><span class="dot ${dotClass}"></span>${statusLabel}${statusSinceMs ? ` <span class="live-status-timer ${statusTimerClass}" data-since="${statusSinceMs}" style="opacity:0.85;">(${fmtDurationLive((Date.now()-statusSinceMs)/1000)})</span><span style="opacity:0.55; font-size:11px; margin-left:4px;">since ${statusStartLabel}</span>` : ''}</td>
      <td class="mono">${fmtShort(focusSec)}</td>
      <td class="mono text-idle">${fmtShort(idleSec)}</td>
      <td class="mono text-break">${fmtShort(breakSec)}</td>
      <td class="mono">${fmtHM(totalSec)}</td>
      <td class="mono">${loginStartLabel}</td>
      <td class="mono">${lastEndLabel}</td>
    `;
    // Clicking a row jumps to this agent's Timesheets, scoped to today —
    // same handoff pattern the Flags tab's "View day" button already uses
    // (set the Timesheets filters, then programmatically click its nav
    // tab). Gated on whether the viewer's role can even see the
    // Timesheets tab at all — same check that hides/shows that nav
    // button — so this can't become a back door into a tab a restricted
    // role isn't otherwise allowed to open. tr._agent is refreshed every
    // poll so the handler always uses whichever agent is currently in
    // this row, even though the <tr> node itself is reused across polls
    // rather than recreated.
    tr._agent = agent;
    const canJumpToTimesheets = () => myIsOwner || canViewTimeManagementSection('timesheets');
    const clickable = canJumpToTimesheets();
    tr.classList.toggle('clickable', clickable);
    tr.style.cursor = clickable ? 'pointer' : 'default';
    if(isNewRow){
      tr.addEventListener('click', () => {
        if(!canJumpToTimesheets()) return;
        $('tsFromDateInput').value = todayDateInputValue();
        $('tsToDateInput').value = todayDateInputValue();
        $('tsAgentFilter').value = tr._agent.id;
        document.querySelector('.tab-btn[data-tab="time_management"]').click();
        activateTimeManagementSection('timesheets');
      });
    }
    const flagBtn = tr.querySelector('.flag-badge');
    if(flagBtn){
      flagBtn.addEventListener('click', (e) => {
        e.stopPropagation(); // don't also trigger the row's openDetail
        showFlagPopover(flagBtn, agent.full_name || agent.email, teamFlagsByAgent[agent.id] || []);
      });
    }
    desiredNodes.push(tr);
  });

  // Reconcile in one pass: walk the desired order and move/insert whatever
  // isn't already in place. Reused rows that are already correctly
  // positioned are never touched, so they're never removed from the DOM —
  // that's what previously caused the whole-table flash, closed any open
  // flag popover, and could shift scroll on every 20s poll. Leftover nodes
  // (old group headers, or a row for an agent no longer in the list) get
  // pushed to the tail by this same process and trimmed off after.
  desiredNodes.forEach((node, i) => {
    const current = body.children[i];
    if(current !== node) body.insertBefore(node, current || null);
  });
  while(body.children.length > desiredNodes.length) body.lastChild.remove();

  if(visibleAgents.length === 0){
    body.innerHTML = '<tr><td colspan="8" class="empty">No user accounts yet. Add users in Supabase Auth, they will appear here.</td></tr>';
  }
}

$('staffExportCsvBtn').addEventListener('click', () => {
  const headers = ['User','Type','Status','Focus today','Idle today','Break today','Total time','Login / start time','Last end tracking'];
  const rows = lastTeamRows.map(r => [r.name, r.type, r.status, r.focus, r.idle, r.brk, r.total, r.loginStart, r.lastEnd]);
  exportCSV(`staff-${new Date().toISOString().slice(0,10)}.csv`, headers, rows);
  logActivity('export.staff_csv', null, null, `Exported staff CSV (${rows.length} agents)`);
});
$('staffExportPdfBtn').addEventListener('click', () => {
  const headers = ['User','Type','Status','Focus today','Idle today','Break today','Total time','Login / start time','Last end tracking'];
  const rows = lastTeamRows.map(r => [r.name, r.type, r.status, r.focus, r.idle, r.brk, r.total, r.loginStart, r.lastEnd]);
  exportPDF('Dashboard Report', headers, rows);
  logActivity('export.staff_pdf', null, null, `Exported staff PDF (${rows.length} agents)`);
});

async function fetchAgentEntries(agentId, sinceISO){
  const since = sinceISO || todayRangeISO().start;
  // same overlap-aware fetch as loadTeam — see comment there. Single-agent
  // scoped so far lower risk than the team-wide queries, but paginated for
  // consistency (a caller passing a wide `since` shouldn't silently lose
  // rows either) — see fetchAllRows()'s own comment.
  const entries = await fetchAllRows((from, to) => sb.from('time_entries')
    .select('id, user_id, start_time, end_time, task_id, idle_seconds, break_seconds, last_heartbeat_at')
    .eq('user_id', agentId)
    .or(`end_time.is.null,end_time.gte.${since}`)
    .order('id', { ascending: true }).range(from, to));
  // Also fetch each entry's own idle_periods/breaks rows, so callers can
  // clip idle/break time to a sub-window (e.g. "today") using the same
  // real start/end timestamps buildStatusSegments() uses for the
  // Timesheets tab — the entry's idle_seconds/break_seconds fields are
  // gross totals for the WHOLE entry and can't be clipped on their own,
  // which is what let an overnight entry's Dashboard total disagree with
  // its Timesheets segments (see computeClippedTotals below).
  const entryIds = entries.map(e => e.id);
  let idlePeriodsByEntry = {}, breaksByEntry = {};
  if(entryIds.length){
    const [{ data: idlePeriods }, { data: breaksRows }] = await Promise.all([
      sb.from('idle_periods').select('time_entry_id, start_time, end_time').in('time_entry_id', entryIds),
      sb.from('breaks').select('time_entry_id, start_time, end_time').in('time_entry_id', entryIds),
    ]);
    idlePeriodsByEntry = groupByEntry(idlePeriods, 'start_time');
    breaksByEntry = groupByEntry(breaksRows, 'start_time');
  }
  return { entries, idlePeriodsByEntry, breaksByEntry };
}

function sumFocusSeconds(entries){
  return entries.reduce((total, e) => {
    const end = e.end_time ? new Date(e.end_time).getTime() : Date.now();
    const gross = (end - new Date(e.start_time).getTime()) / 1000;
    const idle = e.idle_seconds || 0;
    const brk = e.break_seconds || 0;
    return total + Math.max(0, gross - idle - brk);
  }, 0);
}

// Clips each entry's span to [rangeStartMs, now], then sums the ENTRY'S
// OWN idle_periods/breaks rows that fall inside that same clipped span —
// the same clip-then-subtract order buildStatusSegments() uses for the
// Timesheets tab — instead of subtracting the entry's full, unclipped
// idle_seconds/break_seconds totals. Without this, an entry that crosses
// the window boundary (e.g. an overnight shift, or the window's own start)
// has idle/break time from the OTHER side of the boundary subtracted from
// THIS side's total, so the Dashboard's "Focus today" can be understated
// or overstated relative to what the Timesheets segments for that same
// day actually add up to.
function computeClippedTotals(entries, idlePeriodsByEntry, breaksByEntry, rangeStartMs){
  const now = Date.now();
  let focusSec = 0, idleSec = 0, breakSec = 0;
  (entries || []).forEach(e => {
    const rawStart = new Date(e.start_time).getTime();
    // v218: was `e.end_time ? ... : now` — an open entry whose heartbeat
    // has gone stale (extension no longer reporting at all — signed out,
    // crashed, lost network) stops here at its last real heartbeat
    // instead of counting every second up to "now" as gross/focus time.
    // See liveEntryEndMs()'s own comment for the full why.
    const rawEnd = liveEntryEndMs(e);
    const spanStart = Math.max(rawStart, rangeStartMs);
    const spanEnd = Math.min(rawEnd, now);
    if(spanEnd <= spanStart) return;
    const gross = (spanEnd - spanStart) / 1000;
    let entryIdle = 0, entryBreak = 0;
    // BUG FIX (live report: "adding break manually it doesn't reflect on
    // break"): manual entries (added via Timesheets' "+ Add time") never
    // have their own idle_periods/breaks rows — any idle/break time for
    // them only exists as the idle_seconds/break_seconds the admin typed
    // into the modal (see the Add-entry save handler). This function used
    // to only ever read idlePeriodsByEntry/breaksByEntry, so a manual
    // entry's break/idle time silently never counted anywhere this
    // function feeds — Team tab's per-agent "today" row, and the Agent
    // Detail view's "Used today"/"Used this week" totals, all understated
    // idle/break and overstated focus for any agent with a manual entry.
    // Same reasoning/pattern renderDayTimeline() already uses correctly
    // for its own manualBreakSec/manualIdleSec — not prorated to the
    // clipped span here either, matching that established precedent.
    if(e.is_manual){
      entryBreak = e.break_seconds || 0;
      entryIdle = e.idle_seconds || 0;
    } else {
      ((idlePeriodsByEntry && idlePeriodsByEntry[e.id]) || []).forEach(p => {
        const s = Math.max(new Date(p.start_time).getTime(), spanStart);
        const en = Math.min(p.end_time ? new Date(p.end_time).getTime() : now, spanEnd);
        if(en > s) entryIdle += (en - s) / 1000;
      });
      ((breaksByEntry && breaksByEntry[e.id]) || []).forEach(p => {
        const s = Math.max(new Date(p.start_time).getTime(), spanStart);
        const en = Math.min(p.end_time ? new Date(p.end_time).getTime() : now, spanEnd);
        if(en > s) entryBreak += (en - s) / 1000;
      });
    }
    idleSec += entryIdle;
    breakSec += entryBreak;
    focusSec += Math.max(0, gross - entryIdle - entryBreak);
  });
  return { focusSec, idleSec, breakSec };
}

// Thin wrapper kept for callers that only need the focus total.
function sumFocusSecondsClipped(entries, idlePeriodsByEntry, breaksByEntry, rangeStartMs){
  return computeClippedTotals(entries, idlePeriodsByEntry, breaksByEntry, rangeStartMs).focusSec;
}

// "Toward limit" now means active time only — idle_seconds and
// break_seconds are both excluded, matching the extension's
// dailyTrackedSec/weeklyTrackedSec (idle no longer eats into the
// daily/weekly work-hour limit). Functionally identical to
// sumFocusSecondsClipped now, kept as a separate name so every call site
// that means "toward the limit" stays self-documenting.
function sumTrackedSecondsClipped(entries, idlePeriodsByEntry, breaksByEntry, rangeStartMs){
  return computeClippedTotals(entries, idlePeriodsByEntry, breaksByEntry, rangeStartMs).focusSec;
}

// ---------- suspicious activity detection (shared by Team tab badges and the Flags tab) ----------
// Heuristics only, not proof of anything — thresholds are deliberately
// conservative (long/strict enough that an ordinary hard-working day
// won't trip them) since false positives here cost trust with agents
// doing nothing wrong. A flag just means "worth a quick look".
const SUSPICION_ZERO_IDLE_MIN_HOURS = 4;   // a stretch this long with ~0 idle is unusual
const SUSPICION_ZERO_IDLE_RATIO = 0.01;    // idle_seconds / duration below this counts as "zero"
const SUSPICION_NO_BREAK_MIN_HOURS = 5;    // a stretch this long with no break at all
const SUSPICION_NO_BREAK_RATIO = 0.01;
const SUSPICION_ROBOTIC_MIN_RUN = 15;      // consecutive 1-min samples w/ near-identical event counts
const SUSPICION_ROBOTIC_TOLERANCE = 1;     // mouse/keyboard events allowed to differ from the run's
                                            // first sample and still count as "the same" — a jiggler
                                            // tuned to add ±1 event of noise per minute used to slip
                                            // past an exact-match check entirely; this catches that
                                            // without catching genuinely varied human input, which
                                            // swings by much more than 1 event minute to minute.
const SUSPICION_DIALER_ABUSE_MIN_HOURS = 1;      // dialer-task entry has to be at least this long to bother checking
const SUSPICION_DIALER_ABUSE_MAX_DOMAIN_RATIO = 0.2; // ...and spend less than this fraction of it actually on a dialer domain
const SUSPICION_CHOPPED_MAX_MINUTES = 4;   // entries this short or shorter count as "chopped" (was 2 —
                                            // widened so a moderate 3-4 min chunking pattern, not just
                                            // sub-2-min, still gets caught)
const SUSPICION_CHOPPED_MIN_COUNT = 5;     // ...need at least this many in one day to flag
const SUSPICION_PINGPONG_MIN_COUNT = 5;    // idle periods within one entry to consider "ping-ponging" (was 6)
const SUSPICION_PINGPONG_MAX_AVG_SEC = 120; // ...only if they're each this short on average (was 90)
const SUSPICION_SPARSE_SHOTS_MIN_HOURS = 0.75; // entry has to be at least this long to bother checking
const SUSPICION_SPARSE_SHOTS_MAX_RATIO = 0.5;  // actual screenshots below this fraction of the expected
                                                // count (entry minutes / 10, since capture is ~1 per
                                                // 10-min window) is worth a look — could mean the
                                                // extension lost screenshot permission, was blocked, or
                                                // wasn't actually running for real stretches of the entry
const SUSPICION_MERGE_GAP_MAX_MIN = 15;    // entries this close together (or closer) get evaluated as
                                            // one continuous stretch for zero_idle/no_break, so splitting
                                            // one long session into several shorter ones with brief gaps
                                            // doesn't dodge those two duration-gated checks

const SUSPICION_TYPE_META = {
  zero_idle:          { label: 'Suspiciously perfect activity' },
  no_break:            { label: 'Marathon session (no break)' },
  robotic:             { label: 'Repetitive / robotic activity' },
  dialer_abuse:        { label: 'Dialer-task idle-exemption abuse' },
  category_abuse:      { label: 'Task-domain abuse (no evidence of expected work)' },
  chopped_sessions:    { label: 'Chopped sessions' },
  idle_pingpong:       { label: 'Idle ping-ponging' },
  sparse_screenshots:  { label: 'Few or no screenshots' },
  split_zero_idle:     { label: 'Suspiciously perfect activity (combined sessions)' },
  split_no_break:      { label: 'Marathon session (combined sessions)' },
};

function entryDurationSec(e){
  const end = e.end_time ? new Date(e.end_time).getTime() : Date.now();
  return Math.max(0, (end - new Date(e.start_time).getTime()) / 1000);
}

// Groups any rows with a time_entry_id + a chronological field by that
// entry, sorted — the shape the per-entry checks below need. sortField
// defaults to 'sampled_at' (activity_samples); pass 'start_time' for
// idle_periods/url_visits.
function groupByEntry(rows, sortField){
  sortField = sortField || 'sampled_at';
  const map = {};
  (rows || []).forEach(r => {
    if(!r.time_entry_id) return;
    (map[r.time_entry_id] || (map[r.time_entry_id] = [])).push(r);
  });
  Object.values(map).forEach(arr => arr.sort((a, b) => new Date(a[sortField]) - new Date(b[sortField])));
  return map;
}
// Back-compat name for the activity-samples case specifically.
function groupSamplesByEntry(samples){ return groupByEntry(samples, 'sampled_at'); }

function isDialerDomainMatch(domain, dialerDomains){
  if(!domain) return false;
  return (dialerDomains || []).some(d => domain === d || domain.endsWith('.' + d));
}

// v48: { [task_id]: { idlePolicy, abuseCheckRatio, abuseCheckMinHours, domains: [...] } }
// from a `tasks?select=id,category_id,task_categories(...),task_domains(domain)` query.
// Only tasks with a category assigned show up here (uncategorized tasks fall
// back to the legacy dialer_abuse check via dialerTaskIds/dialerDomains).
function buildTaskCategoryMap(rows){
  const map = {};
  (rows || []).forEach(t => {
    if(!t.category_id || !t.task_categories) return;
    map[t.id] = {
      idlePolicy: t.task_categories.idle_policy,
      abuseCheckRatio: t.task_categories.abuse_check_ratio,
      abuseCheckMinHours: t.task_categories.abuse_check_min_hours,
      domains: (t.task_domains || []).map(d => d.domain).filter(Boolean),
    };
  });
  return map;
}

// audit fix (Time Management deep-scan pass): every Supabase query in this
// file that can plausibly return more than PostgREST's default row cap
// (1000) needs to page through .range() rather than take whatever the
// default cap hands back — see fetchAllLeadStatusRows()'s own comment
// (audit_chunk4.md #3) for the same fix applied to a single call site
// earlier in this file. That fix was never generalized, so it never
// reached Time Management: the Flags scan's 5 underlying queries,
// Timesheets' per-range lookups, and (highest-stakes) computeAgentStats()'s
// activity_samples read that feeds the Reports tab's Payroll/Productivity
// figures were all still capped-and-silent — a full-time agent's month is
// easily 10,000+ activity_samples rows (~1/min while active), so a monthly
// "average activity %" was being computed from roughly the first couple of
// working days' worth of rows, presented as if it were the whole month.
// `buildQuery(from, to)` is called fresh for each page rather than reusing
// one builder instance across awaits — a supabase-js query builder is
// meant to be awaited once, same reasoning fetchAllLeadStatusRows() and
// fetchInChunks() already follow.
async function fetchAllRows(buildQuery, pageSize){
  pageSize = pageSize || 1000;
  const rows = [];
  for(let from = 0; ; from += pageSize){
    const { data, error } = await buildQuery(from, from + pageSize - 1);
    if(error){ console.error('fetchAllRows: a page failed to load — results may be incomplete', error); break; }
    rows.push(...(data || []));
    if(!data || data.length < pageSize) break;
  }
  return rows;
}

// entries: time_entries rows (id, user_id, task_id, start_time, end_time, idle_seconds, break_seconds).
// ctx: { samplesByEntry, idlePeriodsByEntry, urlVisitsByEntry, dialerTaskIds: Set, dialerDomains: string[] }
// — any piece can be omitted/empty to skip just that check (e.g. Team tab
// today-only fetches vs. a full Flags-tab range both use this the same way).
// One time_entry can trigger more than one flag type; each hit is its own entry in the result.
// Chopped-session detection is a separate function (computeChoppedSessionFlags)
// since it's a day-level pattern across entries, not a per-entry check.
function computeSuspicionFlags(entries, ctx){
  ctx = ctx || {};
  const flags = [];
  (entries || []).forEach(e => {
    // Manual entries (added/edited via the Timesheets "+ Add time" modal)
    // have no real activity_samples, idle_periods, or url_visits behind
    // them — whatever idle/break minutes an admin typed in are a manual
    // correction, not tracked behavior, so every check below (all of
    // which infer suspicious *behavior* from that real tracking data)
    // would otherwise misfire on entries that were never actually
    // monitored in the first place.
    if(e.is_manual) return;
    const durationSec = entryDurationSec(e);
    if(durationSec <= 0) return;
    const idleSec = e.idle_seconds || 0;
    const breakSec = e.break_seconds || 0;
    // Dialer tasks are designed to accumulate ~0 idle time even when the
    // agent is genuinely away from the mouse/keyboard on a call — that's
    // the whole point of the idle-detection exemption for this task type
    // (see the dialer_abuse check below, which exists specifically to
    // sanity-check THAT assumption via actual domain time instead). Left
    // unguarded, zero_idle would trip on essentially every normal dialer
    // session for the same structural reason, not because anything's
    // actually suspicious — so it's skipped here and left to dialer_abuse.
    const isDialerTask = ctx.dialerTaskIds && ctx.dialerTaskIds.has(e.task_id);
    // v48: bounded_grace tasks (e.g. Backoffice) are, by design, meant to
    // accumulate low idle even during real desktop-only work the extension
    // can't see — same structural reason dialer tasks are excluded above.
    // The category_abuse check below is what actually sanity-checks that
    // assumption for these, same relationship dialer_abuse already has to
    // dialer tasks.
    const taskCategoryInfo = ctx.taskCategoryMap && ctx.taskCategoryMap[e.task_id];
    const isBoundedGraceTask = taskCategoryInfo && taskCategoryInfo.idlePolicy === 'bounded_grace';

    if(!isDialerTask && !isBoundedGraceTask && durationSec >= SUSPICION_ZERO_IDLE_MIN_HOURS * 3600 && idleSec <= durationSec * SUSPICION_ZERO_IDLE_RATIO){
      flags.push({
        type: 'zero_idle', entryId: e.id, userId: e.user_id, startedAt: e.start_time,
        detail: `${fmtShort(durationSec)} tracked with only ${fmtShort(idleSec)} idle`,
      });
    }
    if(durationSec >= SUSPICION_NO_BREAK_MIN_HOURS * 3600 && breakSec <= durationSec * SUSPICION_NO_BREAK_RATIO){
      flags.push({
        type: 'no_break', entryId: e.id, userId: e.user_id, startedAt: e.start_time,
        detail: `${fmtShort(durationSec)} straight with no break taken`,
      });
    }

    // Looks for the longest run of consecutive 1-minute samples with
    // NEAR-identical mouse_events/keyboard_events (within
    // SUSPICION_ROBOTIC_TOLERANCE of the run's first sample) — real human
    // input varies minute to minute even during repetitive work; an
    // unbroken run of near-identical counts is what a mouse-jiggler or
    // macro looks like. Tolerance (rather than requiring an EXACT match)
    // is deliberate: a jiggler tuned to add a point of random noise per
    // minute would otherwise never repeat the same exact count twice and
    // sail straight through. Samples are only ever logged while genuinely
    // active (not idle/on break/unfocused — see the extension's
    // logActivitySample), so this isn't just detecting a quiet stretch.
    const samples = (ctx.samplesByEntry && ctx.samplesByEntry[e.id]) || [];
    let runLen = 0, runAnchorM = null, runAnchorK = null, runStart = null, worstRun = 0, worstStart = null;
    samples.forEach(s => {
      const m = s.mouse_events || 0, k = s.keyboard_events || 0;
      const events = m + k;
      const withinTolerance = runAnchorM !== null
        && Math.abs(m - runAnchorM) <= SUSPICION_ROBOTIC_TOLERANCE
        && Math.abs(k - runAnchorK) <= SUSPICION_ROBOTIC_TOLERANCE;
      if(events > 0 && withinTolerance){
        runLen++;
      } else if(events > 0){
        runAnchorM = m; runAnchorK = k; runLen = 1; runStart = s.sampled_at;
      } else {
        runAnchorM = null; runAnchorK = null; runLen = 0;
      }
      if(runLen > worstRun){ worstRun = runLen; worstStart = runStart; }
    });
    if(worstRun >= SUSPICION_ROBOTIC_MIN_RUN){
      flags.push({
        type: 'robotic', entryId: e.id, userId: e.user_id, startedAt: worstStart || e.start_time,
        detail: `${worstRun} minutes straight with identical mouse/keyboard counts every minute`,
      });
    }

    // Dialer/phone tasks are exempt from idle detection on the assumption
    // the agent is on a call, away from the mouse/keyboard, but still
    // working — this checks that assumption against url_visits instead of
    // just trusting it. Low time actually on a dialer domain, for a task
    // marked as one, is what it'd look like if someone picked a dialer
    // task specifically to avoid ever being flagged idle.
    if(ctx.dialerTaskIds && ctx.dialerTaskIds.has(e.task_id) && durationSec >= SUSPICION_DIALER_ABUSE_MIN_HOURS * 3600){
      const visits = (ctx.urlVisitsByEntry && ctx.urlVisitsByEntry[e.id]) || [];
      const entryStartMs = new Date(e.start_time).getTime();
      const entryEndMs = e.end_time ? new Date(e.end_time).getTime() : Date.now();
      let dialerSec = 0;
      visits.forEach(v => {
        if(!isDialerDomainMatch(v.domain, ctx.dialerDomains)) return;
        const vStart = Math.max(new Date(v.start_time).getTime(), entryStartMs);
        const vEnd = Math.min(v.end_time ? new Date(v.end_time).getTime() : Date.now(), entryEndMs);
        if(vEnd > vStart) dialerSec += (vEnd - vStart) / 1000;
      });
      if(dialerSec <= durationSec * SUSPICION_DIALER_ABUSE_MAX_DOMAIN_RATIO){
        flags.push({
          type: 'dialer_abuse', entryId: e.id, userId: e.user_id, startedAt: e.start_time,
          detail: `${fmtShort(durationSec)} on a dialer task, only ${fmtShort(dialerSec)} actually on a dialer domain`,
        });
      }
    }

    // v48: generalized version of the dialer_abuse check above, for ANY
    // task category with its own expected-domain list configured (Cold
    // Calling's Sheets/Forms/Zillow/Redfin, Backoffice's recording-source +
    // upload-target site, etc.) — not just dialer_exempt ones. Skipped
    // entirely for a task with no task_domains rows (an admin who leaves a
    // category's tasks domain-free, e.g. an intentionally open-ended Sales
    // task, gets no check at all rather than a false positive against an
    // empty list). This is what keeps 'bounded_grace' honest in particular:
    // low idle alone is expected and excluded above, but low idle AND zero
    // time on the domains that task is supposed to touch is what real abuse
    // of the grace allowance looks like.
    if(taskCategoryInfo && taskCategoryInfo.domains.length > 0 && durationSec >= taskCategoryInfo.abuseCheckMinHours * 3600){
      const visits = (ctx.urlVisitsByEntry && ctx.urlVisitsByEntry[e.id]) || [];
      const entryStartMs = new Date(e.start_time).getTime();
      const entryEndMs = e.end_time ? new Date(e.end_time).getTime() : Date.now();
      let onTaskSec = 0;
      visits.forEach(v => {
        const onDomain = isDialerDomainMatch(v.domain, taskCategoryInfo.domains)
          || (taskCategoryInfo.idlePolicy === 'dialer_exempt' && isDialerDomainMatch(v.domain, ctx.dialerDomains));
        if(!onDomain) return;
        const vStart = Math.max(new Date(v.start_time).getTime(), entryStartMs);
        const vEnd = Math.min(v.end_time ? new Date(v.end_time).getTime() : Date.now(), entryEndMs);
        if(vEnd > vStart) onTaskSec += (vEnd - vStart) / 1000;
      });
      if(onTaskSec <= durationSec * taskCategoryInfo.abuseCheckRatio){
        flags.push({
          type: 'category_abuse', entryId: e.id, userId: e.user_id, startedAt: e.start_time,
          detail: `${fmtShort(durationSec)} tracked, only ${fmtShort(onTaskSec)} on this task's expected sites`,
        });
      }
    }

    // Many idle periods, each individually short, packed into one session
    // — a single genuine idle stretch (lunch, a long call away from
    // Chrome) shows up as one or two idle_periods rows, not a dozen brief
    // ones. This is what constantly nudging the mouse just enough to
    // reset the idle clock, without actually working, looks like.
    const idlePeriods = (ctx.idlePeriodsByEntry && ctx.idlePeriodsByEntry[e.id]) || [];
    if(idlePeriods.length >= SUSPICION_PINGPONG_MIN_COUNT){
      const durations = idlePeriods.map(p => {
        const s = new Date(p.start_time).getTime();
        const en = p.end_time ? new Date(p.end_time).getTime() : Date.now();
        return Math.max(0, (en - s) / 1000);
      });
      const avgSec = durations.reduce((a, b) => a + b, 0) / durations.length;
      if(avgSec <= SUSPICION_PINGPONG_MAX_AVG_SEC){
        flags.push({
          type: 'idle_pingpong', entryId: e.id, userId: e.user_id, startedAt: e.start_time,
          detail: `${idlePeriods.length} idle stretches in one session, averaging ${Math.round(avgSec)}s each`,
        });
      }
    }
  });
  return flags;
}

// Day-level pattern (not per-entry): many very short Start/Stop sessions
// for the same agent on the same calendar day. Genuine task-switching
// doesn't usually chop a day into this many sub-2-minute entries — this is
// what repeatedly stopping/restarting tracking to dodge the idle/away
// timers would look like instead of just going idle honestly. Grouped by
// UTC calendar date, same simplification the rest of this file uses for
// multi-day ranges.
// tzByUser: { [user_id]: timezone } — optional; falls back to the
// browser's own local date grouping if omitted (previous behavior).
function computeChoppedSessionFlags(entries, tzByUser){
  const flags = [];
  const byAgentDay = {};
  (entries || []).forEach(e => {
    if(e.is_manual) return; // manual correction, not a real chopped/dodged session
    if(!e.end_time) return; // still open — don't count a live session as "short" yet
    const durationSec = entryDurationSec(e);
    if(durationSec > SUSPICION_CHOPPED_MAX_MINUTES * 60) return;
    const localDate = localDateKeyInZone(e.start_time, tzByUser && tzByUser[e.user_id]);
    const dayKey = `${e.user_id}|${localDate}`;
    (byAgentDay[dayKey] || (byAgentDay[dayKey] = [])).push(e);
  });
  Object.entries(byAgentDay).forEach(([key, shortEntries]) => {
    if(shortEntries.length < SUSPICION_CHOPPED_MIN_COUNT) return;
    const userId = key.split('|')[0];
    const earliest = shortEntries.reduce((a, b) => new Date(a.start_time) < new Date(b.start_time) ? a : b);
    flags.push({
      type: 'chopped_sessions', entryId: earliest.id, userId, startedAt: earliest.start_time,
      detail: `${shortEntries.length} sessions under ${SUSPICION_CHOPPED_MAX_MINUTES} min in one day`,
    });
  });
  return flags;
}

// Flags an entry with far fewer screenshots than its length would predict
// (capture is ~1 per 10-minute window while actively tracking — see
// schema.sql). A long entry with almost none could mean the extension
// lost screenshot permission, got blocked, or wasn't really running for
// real stretches of the entry — worth a look either way. shotCountByEntry:
// { [time_entry_id]: count }, built once per call site from the
// `screenshots` table.
function computeSparseScreenshotFlags(entries, shotCountByEntry){
  const flags = [];
  (entries || []).forEach(e => {
    if(e.is_manual) return; // manual entries never have screenshots — that's expected, not sparse
    const durationSec = entryDurationSec(e);
    if(durationSec < SUSPICION_SPARSE_SHOTS_MIN_HOURS * 3600) return;
    if(!e.end_time) return; // still live — expected count isn't final yet
    const expected = durationSec / 600; // ~1 per 10-minute window
    const actual = (shotCountByEntry && shotCountByEntry[e.id]) || 0;
    if(actual < expected * SUSPICION_SPARSE_SHOTS_MAX_RATIO){
      flags.push({
        type: 'sparse_screenshots', entryId: e.id, userId: e.user_id, startedAt: e.start_time,
        detail: `${fmtShort(durationSec)} tracked with only ${actual} screenshot${actual === 1 ? '' : 's'} (expected around ${Math.round(expected)})`,
      });
    }
  });
  return flags;
}

// Catches splitting what's really one long stretch into several shorter
// entries with brief gaps between them, specifically to keep each piece
// individually under the zero_idle/no_break duration minimums. Entries
// for the same agent on the same local calendar day, separated by a gap
// no longer than SUSPICION_MERGE_GAP_MAX_MIN, are merged into one virtual
// session and re-evaluated against the same two thresholds — but only
// reported if that combined stretch crosses a threshold that NO single
// entry in the chain already crossed on its own (otherwise this would
// just be a duplicate of a flag computeSuspicionFlags already raised).
function computeMergedSessionFlags(entries, tzByUser){
  const flags = [];
  const byAgentDay = {};
  (entries || []).forEach(e => {
    if(e.is_manual) return; // manual correction, not part of a real stop/start chain
    if(!e.end_time) return; // still open — don't fold a live entry into a chain yet
    const localDate = localDateKeyInZone(e.start_time, tzByUser && tzByUser[e.user_id]);
    const dayKey = `${e.user_id}|${localDate}`;
    (byAgentDay[dayKey] || (byAgentDay[dayKey] = [])).push(e);
  });
  Object.values(byAgentDay).forEach(dayEntries => {
    dayEntries.sort((a, b) => new Date(a.start_time) - new Date(b.start_time));
    let chain = [];
    const flushChain = () => {
      if(chain.length >= 2){
        const totalDurationSec = chain.reduce((t, e) => t + entryDurationSec(e), 0);
        const totalIdleSec = chain.reduce((t, e) => t + (e.idle_seconds || 0), 0);
        const totalBreakSec = chain.reduce((t, e) => t + (e.break_seconds || 0), 0);
        const anyEntryAlreadyHits = (minHours, ratioField, ratio) => chain.some(e => {
          const d = entryDurationSec(e);
          return d >= minHours * 3600 && (e[ratioField] || 0) <= d * ratio;
        });
        const first = chain[0];
        if(totalDurationSec >= SUSPICION_ZERO_IDLE_MIN_HOURS * 3600 && totalIdleSec <= totalDurationSec * SUSPICION_ZERO_IDLE_RATIO
           && !anyEntryAlreadyHits(SUSPICION_ZERO_IDLE_MIN_HOURS, 'idle_seconds', SUSPICION_ZERO_IDLE_RATIO)){
          flags.push({
            type: 'split_zero_idle', entryId: first.id, userId: first.user_id, startedAt: first.start_time,
            detail: `${fmtShort(totalDurationSec)} across ${chain.length} sessions (gaps under ${SUSPICION_MERGE_GAP_MAX_MIN}m) with only ${fmtShort(totalIdleSec)} idle combined`,
          });
        }
        if(totalDurationSec >= SUSPICION_NO_BREAK_MIN_HOURS * 3600 && totalBreakSec <= totalDurationSec * SUSPICION_NO_BREAK_RATIO
           && !anyEntryAlreadyHits(SUSPICION_NO_BREAK_MIN_HOURS, 'break_seconds', SUSPICION_NO_BREAK_RATIO)){
          flags.push({
            type: 'split_no_break', entryId: first.id, userId: first.user_id, startedAt: first.start_time,
            detail: `${fmtShort(totalDurationSec)} across ${chain.length} sessions (gaps under ${SUSPICION_MERGE_GAP_MAX_MIN}m) with no break combined`,
          });
        }
      }
      chain = [];
    };
    dayEntries.forEach(e => {
      if(chain.length === 0){ chain.push(e); return; }
      const prevEnd = new Date(chain[chain.length - 1].end_time).getTime();
      const gapMin = (new Date(e.start_time).getTime() - prevEnd) / 60000;
      if(gapMin >= 0 && gapMin <= SUSPICION_MERGE_GAP_MAX_MIN){
        chain.push(e);
      } else {
        flushChain();
        chain.push(e);
      }
    });
    flushChain();
  });
  return flags;
}

// ---------- flags tab (admin-driven scan over a date range) ----------
let flagsAllAgents = [];
let lastFlagsRows = [];

function defaultFlagsRange(){
  const from = new Date();
  from.setDate(from.getDate() - 6); // last 7 days inclusive, same spirit as a "week at a glance"
  const iso = d => d.toISOString().slice(0, 10);
  return { from: iso(from), to: endOfLoginMonthDateInputValue() };
}

async function initFlagsTab(){
  if(!$('flagsFromInput').value || !$('flagsToInput').value){
    const { from, to } = defaultFlagsRange();
    $('flagsFromInput').value = from;
    $('flagsToInput').value = to;
  }
  const { data: agents } = await sb.from('profiles').select('id, full_name, email, role').order('full_name');
  flagsAllAgents = (agents || []).filter(a => !PROTECTED_ROLES.has(a.role));
  const sel = $('flagsAgentFilter');
  const prev = sel.value;
  sel.innerHTML = '<option value="">All users</option>' +
    flagsAllAgents.map(a => `<option value="${a.id}">${escapeHtml(a.full_name || a.email)}</option>`).join('');
  sel.value = prev;
}

async function runFlagsScan(){
  const fromVal = $('flagsFromInput').value;
  const toVal = $('flagsToInput').value;
  if(!fromVal || !toVal) return;
  const agentFilter = $('flagsAgentFilter').value;
  const typeFilter = $('flagsTypeFilter').value;

  const rangeStart = new Date(fromVal + 'T00:00:00').toISOString();
  const rangeEnd = new Date(toVal + 'T23:59:59.999').toISOString();

  const summary = $('flagsSummaryLabel');
  summary.textContent = 'Scanning…';
  $('flagsBody').innerHTML = '';

  // audit fix (Time Management deep-scan pass): all 5 of these used to be
  // single unbounded fetches, silently capped at PostgREST's default row
  // limit (1000) with no indication a scan was incomplete — see
  // fetchAllRows()'s own comment above. Every entry/sample/idle-period/
  // visit/screenshot in range is now fetched via full .range() pagination,
  // so a scan across a real team or a wide date range can no longer
  // silently under-report.
  // audit fix (Time Management deep-scan smoke test): none of these five had
  // an explicit .order() — without one, Postgres doesn't guarantee row order
  // is stable across the separate requests each page makes, so a row could
  // in principle be skipped or double-counted across a page boundary
  // (concurrent inserts from an active extension session make this a real,
  // not just theoretical, risk during a live scan). Ordered by each table's
  // own primary key so every page is a deterministic, non-overlapping slice.
  const buildEntryQuery = (from, to) => {
    let q = sb.from('time_entries')
      .select('id, user_id, task_id, start_time, end_time, idle_seconds, break_seconds, is_manual')
      .or(`end_time.is.null,end_time.gte.${rangeStart}`)
      .lte('start_time', rangeEnd)
      .order('id', { ascending: true });
    if(agentFilter) q = q.eq('user_id', agentFilter);
    return q.range(from, to);
  };
  const buildSampleQuery = (from, to) => {
    let q = sb.from('activity_samples')
      .select('time_entry_id, user_id, sampled_at, mouse_events, keyboard_events')
      .gte('sampled_at', rangeStart).lte('sampled_at', rangeEnd)
      .order('id', { ascending: true });
    if(agentFilter) q = q.eq('user_id', agentFilter);
    return q.range(from, to);
  };
  const buildIdleQuery = (from, to) => {
    let q = sb.from('idle_periods')
      .select('time_entry_id, user_id, start_time, end_time')
      .or(`end_time.is.null,end_time.gte.${rangeStart}`)
      .lte('start_time', rangeEnd)
      .order('id', { ascending: true });
    if(agentFilter) q = q.eq('user_id', agentFilter);
    return q.range(from, to);
  };
  const buildVisitQuery = (from, to) => {
    let q = sb.from('url_visits')
      .select('time_entry_id, domain, start_time, end_time')
      .or(`end_time.is.null,end_time.gte.${rangeStart}`)
      .lte('start_time', rangeEnd)
      .order('id', { ascending: true });
    if(agentFilter) q = q.eq('user_id', agentFilter);
    return q.range(from, to);
  };
  const buildShotQuery = (from, to) => {
    let q = sb.from('screenshots')
      .select('time_entry_id, taken_at')
      .gte('taken_at', rangeStart).lte('taken_at', rangeEnd)
      .order('id', { ascending: true });
    if(agentFilter) q = q.eq('user_id', agentFilter);
    return q.range(from, to);
  };

  // dialer_domains/schedules realistically never approach the row cap, but
  // `tasks` can grow past it over a few years of an active org (nothing
  // archives/deletes old tasks) — every lookup here is now paginated for
  // consistency and so none of them silently drops rows if that ever
  // changes. Missing dialer tasks/domains would falsely flag normal dialer
  // sessions as zero_idle instead of correctly deferring to dialer_abuse;
  // missing categorized-task rows would do the same for bounded_grace tasks.
  const [entries, samples, idlePeriods, urlVisits, shots, dialerTaskRows, dialerDomainRows, scheduleRows, categorizedTaskRows] = await Promise.all([
    fetchAllRows(buildEntryQuery),
    fetchAllRows(buildSampleQuery),
    fetchAllRows(buildIdleQuery),
    fetchAllRows(buildVisitQuery),
    fetchAllRows(buildShotQuery),
    fetchAllRows((from, to) => sb.from('tasks').select('id').eq('is_dialer_task', true).order('id', { ascending: true }).range(from, to)),
    fetchAllRows((from, to) => sb.from('dialer_domains').select('domain').order('id', { ascending: true }).range(from, to)),
    fetchAllRows((from, to) => sb.from('schedules').select('user_id, timezone').order('user_id', { ascending: true }).range(from, to)),
    fetchAllRows((from, to) => sb.from('tasks').select('id, category_id, task_categories(idle_policy, abuse_check_ratio, abuse_check_min_hours), task_domains(domain)').not('category_id', 'is', null).order('id', { ascending: true }).range(from, to)),
  ]);
  const flagsAgentTz = {};
  (scheduleRows || []).forEach(s => { if(s.timezone) flagsAgentTz[s.user_id] = s.timezone; });
  const shotCountByEntry = {};
  (shots || []).forEach(s => { if(s.time_entry_id) shotCountByEntry[s.time_entry_id] = (shotCountByEntry[s.time_entry_id] || 0) + 1; });

  const suspicionCtx = {
    samplesByEntry: groupSamplesByEntry(samples),
    idlePeriodsByEntry: groupByEntry(idlePeriods, 'start_time'),
    urlVisitsByEntry: groupByEntry(urlVisits, 'start_time'),
    dialerTaskIds: new Set((dialerTaskRows || []).map(t => t.id)),
    dialerDomains: (dialerDomainRows || []).map(d => d.domain),
    taskCategoryMap: buildTaskCategoryMap(categorizedTaskRows),
  };

  let flags = computeSuspicionFlags(entries, suspicionCtx)
    .concat(computeChoppedSessionFlags(entries, flagsAgentTz))
    .concat(computeSparseScreenshotFlags(entries, shotCountByEntry))
    .concat(computeMergedSessionFlags(entries, flagsAgentTz));
  if(typeFilter) flags = flags.filter(f => f.type === typeFilter);
  flags.sort((a, b) => new Date(b.startedAt) - new Date(a.startedAt));

  const agentName = id => { const a = flagsAllAgents.find(x => x.id === id); return a ? (a.full_name || a.email) : '—'; };

  summary.textContent = flags.length
    ? `${flags.length} flag${flags.length === 1 ? '' : 's'} across ${new Set(flags.map(f => f.userId)).size} user(s), ${fromVal} to ${toVal}`
    : `No flags found, ${fromVal} to ${toVal}`;

  lastFlagsRows = [];
  const body = $('flagsBody');
  if(flags.length === 0){
    body.innerHTML = '<tr><td colspan="5" class="empty">Nothing flagged in this range.</td></tr>';
    return;
  }
  // Rendered in the global "Times shown in" zone (Cairo/Chicago toggle in
  // the nav), same convention as Dashboard/Timesheets/Activity — 'agent'
  // falls back to that flag's own agent's schedule timezone (or browser
  // local if unset). Previously this ignored the toggle entirely and
  // always rendered in the admin's browser-local zone, so a Chicago admin
  // reviewing Cairo agents' flags saw times that matched neither the
  // toggle nor the agent's own clock.
  const flagsDisplayTz = globalDisplayTzMode === 'agent' ? null : globalDisplayTzMode;
  flags.forEach(f => {
    const tz = flagsDisplayTz || flagsAgentTz[f.userId];
    const dateLabel = new Date(f.startedAt).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(tz ? { timeZone: tz } : {}) });
    const typeLabel = SUSPICION_TYPE_META[f.type].label;
    lastFlagsRows.push({ agent: agentName(f.userId), date: dateLabel, type: typeLabel, detail: f.detail });

    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${escapeHtml(agentName(f.userId))}</td>
      <td class="mono">${dateLabel}</td>
      <td><span class="dot status-break"></span>${typeLabel}</td>
      <td style="color:var(--text-2);">${f.detail}</td>
      <td><button class="flags-view-btn" style="background:transparent; border:1px solid var(--border-light); border-radius:999px; color:var(--focus); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px;">View day</button></td>
    `;
    tr.querySelector('.flags-view-btn').addEventListener('click', () => {
      const agent = flagsAllAgents.find(x => x.id === f.userId);
      if(!agent) return;
      const day = new Date(f.startedAt).toISOString().slice(0, 10);
      $('tsFromDateInput').value = day;
      $('tsToDateInput').value = day;
      $('tsAgentFilter').value = agent.id;
      document.querySelector('.tab-btn[data-tab="time_management"]').click();
      activateTimeManagementSection('timesheets');
    });
    body.appendChild(tr);
  });
}

$('flagsGenerateBtn').addEventListener('click', runFlagsScan);
// gap fix (Time Management deep-scan pass): see the flagsExportCsvBtn/
// flagsExportPdfBtn markup comment — matches the same export pattern every
// other Time Management subtab already uses (exportCSV/exportPDF over the
// last-rendered rows array).
$('flagsExportCsvBtn').addEventListener('click', () => {
  const headers = ['User','Date','Type','Detail'];
  const rows = lastFlagsRows.map(r => [r.agent, r.date, r.type, r.detail]);
  exportCSV(`suspicious-activity-${new Date().toISOString().slice(0,10)}.csv`, headers, rows);
  logActivity('export.flags_csv', null, null, `Exported suspicious activity CSV (${rows.length} flags)`);
});
$('flagsExportPdfBtn').addEventListener('click', () => {
  const headers = ['User','Date','Type','Detail'];
  const rows = lastFlagsRows.map(r => [r.agent, r.date, r.type, r.detail]);
  exportPDF('Suspicious Activity Report', headers, rows);
  logActivity('export.flags_pdf', null, null, `Exported suspicious activity PDF (${rows.length} flags)`);
});

// ---------- User Management: Users list ----------
// Lists every user with their assigned-task count, role/type, reported
// extension version, and account-creation date/time. Clicking a row opens
// the SAME profile editor used from the Dashboard (openDetail) — subject
// to the same click-through gating.
// v657: "Log in as user" — the staff mirror of the Clients tab's "Log in as
// client". Opens the staff portal in a new tab, signed in as that person, so
// an Owner/Admin can see exactly what they see when they report something.
//
// WHO SEES THE BUTTON. Owner and Admin only, and never on your own row.
// Mirrors the server rule in manage-user's `impersonate` action, which also
// refuses anyone whose owner/admin status is merely delegated
// can_manage_users -- this is the courtesy layer, that is the enforcement.
// An Admin additionally cannot target an Owner or another Admin, which the
// existing PROTECTED_ACCOUNT_ROLES guard already handles server-side; the
// button is hidden for those rows too so nobody clicks into a refusal.
function umCanImpersonate(p){
  if(!(myIsOwner || myRole === 'admin')) return false;
  if(p.id === myUserId) return false;
  if(!myIsOwner && (p.role === 'owner' || p.role === 'admin')) return false;
  return true;
}
// v657: true only in a tab opened by "Log in as user".
let staffImpersonating = false;
function showImpersonationBanner(){
  const banner = $('staffImpersonationBanner');
  if(!banner) return;
  const who = $('staffImpersonationName');
  if(who) who.textContent = myFullName || myEmail || 'a user';
  banner.style.display = 'flex';
  const exit = $('staffImpersonationExitBtn');
  if(exit) exit.onclick = async () => {
    // Ends only THIS tab's session. The admin's own tab was never touched --
    // it has its own sessionStorage and its own session -- so "Exit" closes
    // the impersonated session rather than signing them out everywhere.
    try{ await sb.auth.signOut(); }catch(e){}
    try{ sessionStorage.clear(); }catch(e){}
    window.close();
    // window.close() is refused for a tab the user opened themselves in some
    // browsers, so leave them somewhere unambiguous rather than on a page
    // that still looks signed in.
    location.replace(location.pathname);
  };
}

async function umImpersonate(btn){
  const name = btn.dataset.userName || 'this user';
  // Asked for explicitly. Unlike the client version, this opens a session on
  // the SAME origin the admin is using, so it is worth being sure they meant
  // it -- and worth saying plainly that anything done next is recorded as
  // that person, not as them.
  if(!confirm(`Open the staff portal signed in as ${name}?\n\n`
    + `It opens in a new tab and your own session stays signed in here. `
    + `Anything you do in that tab is recorded as ${name}.`)) return;
  btn.disabled = true;
  const original = btn.textContent;
  btn.textContent = 'Opening…';
  const result = await invokeManageUser({ action: 'impersonate', userId: btn.dataset.userId });
  btn.disabled = false;
  btn.textContent = original;
  if(!result.ok || !result.tokenHash){
    alert(result.error || 'Could not open the portal as this user.');
    return;
  }
  logActivity('user.impersonate', 'agent', btn.dataset.userId, `Logged in as "${name}" to view the portal as them`);
  // 'noopener' matters for more than the usual reason here: the new tab is
  // the SAME origin, and Chrome copies sessionStorage into a same-origin tab
  // opened without it. Since this portal keeps its session in sessionStorage,
  // that copy would hand the new tab the admin's own session and the token
  // exchange would land on top of it. With noopener the tab starts empty.
  window.open(`${location.origin}${location.pathname}?staff_token=${encodeURIComponent(result.tokenHash)}`,
    '_blank', 'noopener');
}

function umImpersonateCellHtml(p, isActive){
  if(!umCanImpersonate(p)) return '';
  // A deactivated account cannot be signed into at all (the Auth ban rejects
  // the token exchange), so the button says why rather than failing later.
  if(!isActive){
    return '<span style="color:var(--text-dim); font-size:11px;" title="Reactivate the account first">—</span>';
  }
  return `<button class="btn-secondary um-impersonate-btn" data-user-id="${p.id}" `
    + `data-user-name="${escapeHtml(p.full_name || p.email || 'this user')}" `
    + `title="Open the staff portal signed in as this user, in a new tab" `
    + `style="width:auto; padding:5px 10px; font-size:11px; margin-top:0; white-space:nowrap;">Log in as user</button>`;
}

// v822: "Reset two-step" -- for someone who lost or replaced the phone with
// their authenticator app. Same people and same rows as "Log in as user"
// (umCanImpersonate), and only on accounts that actually have two-step set
// up. The enforcement is server-side in staff_reset_two_step() (Owner/Admin
// by role, your own two-step code entered, never yourself, an Admin never on
// the Owner or another Admin), which also writes the Audit Log row -- so this
// does not call logActivity() and double it.
let umTwoStepUsers = new Set();
async function loadUmTwoStepUsers(){
  umTwoStepUsers = new Set();
  if(!(myIsOwner || myRole === 'admin')) return;
  const { data, error } = await sb.rpc('staff_two_step_users');
  if(error){ console.warn('two-step list:', error.message); return; }
  (data || []).forEach(r => umTwoStepUsers.add(typeof r === 'string' ? r : Object.values(r || {})[0]));
}
function umResetTwoStepBtnHtml(p){
  if(!umCanImpersonate(p) || !umTwoStepUsers.has(p.id)) return '';
  return `<button class="btn-secondary um-reset2fa-btn" data-user-id="${p.id}" `
    + `data-user-name="${escapeHtml(p.full_name || p.email || 'this user')}" `
    + `title="Lost or replaced phone: removes their authenticator app and signs them out, so they set up the new phone at their next sign-in" `
    + `style="width:auto; padding:5px 10px; font-size:11px; margin-top:0; white-space:nowrap;">Reset two-step</button>`;
}
async function umResetTwoStep(btn){
  const name = btn.dataset.userName || 'this user';
  if(!confirm(`Reset two-step sign-in for ${name}?

`
    + `Use this when they lost or replaced the phone with their authenticator app. `
    + `It removes the authenticator from their account and signs them out everywhere. `
    + `At their next sign-in they set up two-step again with the new phone.`)) return;
  btn.disabled = true;
  const original = btn.textContent;
  btn.textContent = 'Resetting…';
  const { data, error } = await sb.rpc('staff_reset_two_step', { p_user: btn.dataset.userId });
  btn.disabled = false;
  btn.textContent = original;
  if(error){ alert(error.message || 'Could not reset two-step sign-in.'); return; }
  alert(`Two-step sign-in reset for ${name}. `
    + `${data && data.sessions_ended ? 'They were signed out and ' : ''}`
    + `they will set up the new phone the next time they sign in.`);
  await loadUmUsersList();
}

async function loadUmUsersList(){
  const tbody = $('umUsersTbody');
  if(!tbody) return;
  tbody.innerHTML = '<tr><td colspan="9" style="color:var(--text-dim);">Loading…</td></tr>'; // v641: was 5 against a 6-column table; v657 added the actions column
  // audit fix (User Management deep-scan pass): unbounded fetches — low
  // urgency today (each table is in the single/low-double digits for a
  // typical org) but the same silent-truncation risk the Time Management
  // pass fixed elsewhere, so paginated for consistency/future-proofing;
  // see fetchAllRows()'s own comment.
  const [profiles, assignments, tasks, scheduleRows] = await Promise.all([
    fetchAllRows((from, to) => sb.from('profiles').select('id, full_name, email, role, extension_version, extension_version_at, created_at, is_active, department, title, grade, american_name').order('full_name').range(from, to)),
    fetchAllRows((from, to) => sb.from('task_assignments').select('task_id, user_id').order('user_id', { ascending: true }).range(from, to)),
    fetchAllRows((from, to) => sb.from('tasks').select('id, name').order('id', { ascending: true }).range(from, to)),
    fetchAllRows((from, to) => sb.from('schedules').select('user_id, timezone').order('user_id', { ascending: true }).range(from, to)),
  ]);
  await loadUmTwoStepUsers();   // v822
  const taskName = {}; (tasks||[]).forEach(t => { taskName[t.id] = t.name; });
  const byUser = {};
  (assignments||[]).forEach(a => { (byUser[a.user_id] = byUser[a.user_id] || []).push(taskName[a.task_id] || '—'); });
  // Created-date column below follows the same global "Times shown in"
  // (Cairo/Chicago) toggle as Dashboard/Timesheets/Activity/Flags/Audit
  // Log — 'agent' mode falls back to each user's own schedule timezone
  // (or browser local if they have none).
  const umAgentTz = {};
  (scheduleRows || []).forEach(s => { if(s.timezone) umAgentTz[s.user_id] = s.timezone; });

  // Same visibility rule as the Dashboard/Staff team list (loadTeam) —
  // Owner/Admin accounts never show here to anyone but the Owner (and the
  // Owner only sees their own row, not other Owners). Without this, a
  // non-owner Admin — who otherwise has full user-edit rights and whose
  // RLS session CAN see every profile row — would see the Owner's account
  // in this list with a live-looking "Delete this user…" button, even
  // though the manage-user Edge Function rejects that action outright.
  const list = (profiles||[])
    .filter(p => !PROTECTED_ROLES.has(p.role) || (myIsOwner && p.role === 'admin') || (myIsOwner && p.id === myUserId));
  if(!list.length){ tbody.innerHTML = '<tr><td colspan="9" style="color:var(--text-dim);">No users.</td></tr>'; return; }

  tbody.innerHTML = '';
  list.forEach(p => {
    const assigned = byUser[p.id] || [];
    const assignedLabel = assigned.length ? `${assigned.length} — ${assigned.slice(0,3).join(', ')}${assigned.length>3?'…':''}` : '—';
    const typeLabel = roleDisplayLabel(p.role || 'user');
    const version = p.extension_version || '—';
    const tz = globalDisplayTzMode === 'agent' ? umAgentTz[p.id] : globalDisplayTzMode;
    const createdLabel = p.created_at
      ? new Date(p.created_at).toLocaleString([], { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', ...(tz ? { timeZone: tz } : {}) })
      : '—';
    const isActive = p.is_active !== false; // treat missing/null (older rows before the migration ran) as active
    const statusBadge = isActive
      ? '<span class="type-badge" style="color:var(--good);">Active</span>'
      : '<span class="type-badge" style="color:var(--danger);">Deactivated</span>';
    const tr = document.createElement('tr');
    tr.style.cursor = canOpenUserProfile(p.id) ? 'pointer' : 'default';
    tr.innerHTML = `
      <td>${escapeHtml(p.full_name || p.email || '—')}</td>
      <td>${p.title ? escapeHtml(p.title) : '<span style="color:var(--text-dim);">—</span>'}</td>
      <td>${p.department ? escapeHtml(p.department) : '<span style="color:var(--text-dim);">—</span>'}</td>
      <td title="${assigned.join(', ')}">${assignedLabel}</td>
      <td><span class="type-badge">${typeLabel}</span></td>
      <td>${statusBadge}</td>
      <td class="mono">${version}</td>
      <td class="mono">${createdLabel}</td>
      <td><div style="display:flex; gap:6px; flex-wrap:wrap;">${umImpersonateCellHtml(p, isActive)}${umResetTwoStepBtnHtml(p)}</div></td>`;
    // Row click opens the shared profile editor, gated the same way as the
    // Dashboard/Roles click-through (Owner/Admin full, HR schedule-only, or a
    // custom role with explicit user-edit permission).
    if(canOpenUserProfile(p.id)){
      tr.addEventListener('click', () => {
        // The profile editor markup physically lives inside Time
        // Management's Dashboard subtab panel now (v453 — used to be its
        // own top-level Dashboard tab), so showing it means making the
        // Time Management tab-panel visible AND its Dashboard tm-section
        // specifically — but we deliberately leave the nav's "active"
        // tab-btn alone (still User Management) and remember to come back
        // here, rather than routing through activateTimeManagementSection,
        // which would reset things back to the team list.
        detailReturnTo = { tab: 'usermanagement', umSection: umActiveSection || 'users' };
        tmActiveSection = 'staff';
        document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.toggle('active', panel.id === 'tab-time_management'));
        document.querySelectorAll('.tm-section').forEach(s => { s.style.display = (s.id === 'tmSection-staff') ? 'block' : 'none'; });
        openDetail(p, { fromUsersTab: true });
      });
    }
    // v657: the button lives inside a row whose own click opens the profile
    // editor, so it stops propagation -- otherwise every impersonation would
    // also navigate the tab underneath it to somebody's profile.
    const impBtn = tr.querySelector('.um-impersonate-btn');
    if(impBtn) impBtn.addEventListener('click', (ev) => { ev.stopPropagation(); umImpersonate(impBtn); });
    const resetBtn = tr.querySelector('.um-reset2fa-btn');   // v822
    if(resetBtn) resetBtn.addEventListener('click', (ev) => { ev.stopPropagation(); umResetTwoStep(resetBtn); });
    tbody.appendChild(tr);
  });
  // Defensive: re-apply the same gating activateUmSection() already ran,
  // in case this ever gains its own dynamically-created edit-only controls.
  applyUmSectionEditGating('users');
}

async function getOrCreateDefaultProject(){
  const { data: existing } = await sb.from('projects').select('id').eq('name', 'General').limit(1).maybeSingle();
  if(existing) return existing.id;
  const { data: created, error } = await sb.from('projects').insert({ name: 'General' }).select('id').single();
  if(error) throw error;
  return created.id;
}

// ---------- v48: task categories (idle policy per job function — Cold
// Calling / Sales / Backoffice, or whatever an Owner names them) ----------
let taskCategoriesCache = [];

// ---------------------------------------------------------------------------
// v103: task_category_fields admin UI — these are what the EXTENSION's own
// lead-submission popup actually renders (see popup.js's renderLeadsFields,
// which reads this table, NOT lead_submission_form_fields). This CRUD UI
// existed pre-v83 and was removed on the assumption nothing called it
// anymore once the separate, unrelated Leads → Submission Forms Creator
// (lead_submission_form_fields / "Campaigns") was built — but the
// extension itself was never migrated to that system and still depends on
// this table, which had no way to be edited since. Restoring it here,
// built on the same field-editor component (buildSfFieldEditRow) the
// Submission Forms Creator already uses, so both places behave/look the
// same. A field row is EITHER scoped to a whole category OR to one
// specific task (never both — see the DB constraint) — a task with its
// own fields uses those INSTEAD OF its category's, letting e.g. one
// particular Cold Calling task require a different form than the rest of
// its category.
// ---------------------------------------------------------------------------
let taskFieldsExpanded = new Set(); // `cat:<id>` / `task:<id>` currently showing their editor
let taskPolicyEditing = new Set(); // category ids currently showing their idle-policy/grace editor
let taskScopeFieldsCache = {};      // same keys -> array of field rows
let taskScopeFieldEditingKey = null; // `${scopeKey}:${fieldId}` currently in its inline edit row

async function loadTaskScopeFields(scopeKey, { categoryId, taskId }){
  let q = sb.from('task_category_fields').select('id, field_key, label, field_type, options, required, sort_order');
  q = categoryId ? q.eq('category_id', categoryId) : q.eq('task_id', taskId);
  const { data } = await q.order('sort_order');
  taskScopeFieldsCache[scopeKey] = data || [];
}

function renderTaskScopeFieldsList(scopeKey, container, scope){
  const fields = (taskScopeFieldsCache[scopeKey] || []).slice().sort((a, b) => a.sort_order - b.sort_order);
  container.innerHTML = '';
  if(!fields.length){
    const empty = document.createElement('div');
    empty.className = 'empty';
    empty.style.cssText = 'padding:6px 0;';
    empty.textContent = 'No fields yet — the extension shows no lead-submission form here until you add at least one below.';
    container.appendChild(empty);
  }
  fields.forEach((f, i) => {
    const fieldKey = `${scopeKey}:${f.id}`;
    if(taskScopeFieldEditingKey === fieldKey){
      container.appendChild(buildSfFieldEditRow(f, {
        onCancel: () => { taskScopeFieldEditingKey = null; renderTaskScopeFieldsList(scopeKey, container, scope); },
        onSave: async (patch) => {
          const { error } = await sb.from('task_category_fields').update(patch).eq('id', f.id);
          if(error) return error.message;
          logActivity('task_category_field.update', null, null, `Edited field "${patch.label}" (${scopeKey.startsWith('cat:') ? 'category' : 'task'} scoped)`);
          return null;
        },
        onSaved: async () => { taskScopeFieldEditingKey = null; await loadTaskScopeFields(scopeKey, scope); renderTaskScopeFieldsList(scopeKey, container, scope); },
      }));
      return;
    }
    const optsNote = (f.field_type === 'select' || f.field_type === 'multi') && f.options && f.options.length
      ? `: ${f.options.slice(0, 3).map(escapeHtml).join(', ')}${f.options.length > 3 ? `, +${f.options.length - 3} more` : ''}` : '';
    const row = document.createElement('div');
    row.style.cssText = 'display:flex; align-items:center; gap:8px; padding:5px 0; border-top:1px solid var(--border);';
    row.innerHTML = `
      <span class="mono" style="font-size:12px; flex:1;">${escapeHtml(f.label)} <span style="color:var(--text-dim); font-size:10px;">(${fieldTypeLabel(f.field_type)}${f.required ? ', required' : ''}${RESERVED_FIELD_KEYS.has(f.field_key) ? ', maps to a fixed lead column' : ''}${optsNote})</span></span>
      <button class="edit-only" title="Edit field" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px;">Edit</button>
      <button class="edit-only" title="Move up" ${i === 0 ? 'disabled' : ''} style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px;">▲</button>
      <button class="edit-only" title="Move down" ${i === fields.length - 1 ? 'disabled' : ''} style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px;">▼</button>
      <button class="edit-only" title="Remove field" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px;">×</button>
    `;
    const [editBtn, upBtn, downBtn, delBtn] = row.querySelectorAll('button');
    editBtn.addEventListener('click', () => { taskScopeFieldEditingKey = fieldKey; renderTaskScopeFieldsList(scopeKey, container, scope); });
    delBtn.addEventListener('click', async () => {
      if(!confirm(`Remove the "${f.label}" field? Values already submitted with it stay on those existing leads — this only stops it from being asked for on new submissions.`)) return;
      await sb.from('task_category_fields').delete().eq('id', f.id);
      logActivity('task_category_field.delete', null, null, `Removed field "${f.label}" (${scopeKey.startsWith('cat:') ? 'category' : 'task'} scoped)`);
      await loadTaskScopeFields(scopeKey, scope);
      renderTaskScopeFieldsList(scopeKey, container, scope);
    });
    const swapWith = async (other) => {
      if(!other) return;
      await Promise.all([
        sb.from('task_category_fields').update({ sort_order: other.sort_order }).eq('id', f.id),
        sb.from('task_category_fields').update({ sort_order: f.sort_order }).eq('id', other.id),
      ]);
      await loadTaskScopeFields(scopeKey, scope);
      renderTaskScopeFieldsList(scopeKey, container, scope);
    };
    upBtn.addEventListener('click', () => swapWith(fields[i - 1]));
    downBtn.addEventListener('click', () => swapWith(fields[i + 1]));
    container.appendChild(row);
  });
  applyEditGating('tasks');
}

function wireTaskScopeFieldAddForm(container, scopeKey, scope, fieldsContainer){
  container.querySelectorAll('.sf-form-field-reserved-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const existing = taskScopeFieldsCache[scopeKey] || [];
      if(existing.some(f => f.field_key === btn.dataset.key)){ alert('This already has that field.'); return; }
      await addTaskScopeField(scopeKey, scope, { field_key: btn.dataset.key, label: btn.dataset.label, field_type: btn.dataset.type, required: btn.dataset.required === 'true', options: null }, fieldsContainer);
    });
  });
  const typeSelect = container.querySelector('.sf-form-field-type-select');
  const optionsRow = container.querySelector('.sf-form-field-options-row');
  typeSelect.addEventListener('change', () => {
    optionsRow.style.display = (typeSelect.value === 'select' || typeSelect.value === 'multi') ? '' : 'none';
  });
  container.querySelector('.sf-form-field-add-btn').addEventListener('click', async () => {
    const labelInput = container.querySelector('.sf-form-field-label-input');
    const requiredInput = container.querySelector('.sf-form-field-required-input');
    const optionsInput = container.querySelector('.sf-form-field-options-input');
    const msg = container.querySelector('.sf-form-field-msg');
    const label = (labelInput.value || '').trim();
    msg.textContent = ''; msg.className = 'msg sf-form-field-msg';
    if(!label){ msg.textContent = 'Enter a label for the custom field.'; msg.className = 'msg sf-form-field-msg error'; return; }
    const existing = taskScopeFieldsCache[scopeKey] || [];
    const existingKeys = new Set(existing.map(f => f.field_key));
    let key = slugifyFieldKey(label);
    if(!key || RESERVED_FIELD_KEYS.has(key)){
      msg.textContent = 'That label produces a reserved or empty field key — try a more specific label.';
      msg.className = 'msg sf-form-field-msg error';
      return;
    }
    let suffix = 1;
    while(existingKeys.has(key)) key = `${slugifyFieldKey(label)}_${++suffix}`;
    const fieldType = typeSelect.value;
    let options = null;
    if(fieldType === 'select' || fieldType === 'multi'){
      options = (optionsInput.value || '').split(',').map(s => s.trim()).filter(Boolean);
      if(!options.length){
        msg.textContent = 'Enter at least one choice, comma-separated.';
        msg.className = 'msg sf-form-field-msg error';
        return;
      }
    }
    const err = await addTaskScopeField(scopeKey, scope, { field_key: key, label, field_type: fieldType, required: requiredInput.checked, options }, fieldsContainer);
    if(err){ msg.textContent = err; msg.className = 'msg sf-form-field-msg error'; return; }
    labelInput.value = ''; optionsInput.value = ''; requiredInput.checked = false;
  });
}

async function addTaskScopeField(scopeKey, { categoryId, taskId }, { field_key, label, field_type, options, required }, fieldsContainer){
  const existing = taskScopeFieldsCache[scopeKey] || [];
  const nextOrder = existing.length ? Math.max(...existing.map(f => f.sort_order)) + 10 : 0;
  const row = { category_id: categoryId || null, task_id: taskId || null, field_key, label, field_type, required, sort_order: nextOrder, options: (options && options.length) ? options : null };
  const { error } = await sb.from('task_category_fields').insert(row);
  if(error) return /duplicate|unique/i.test(error.message) ? `This already has a "${label}" field.` : error.message;
  logActivity('task_category_field.create', null, null, `Added field "${label}" (${scopeKey.startsWith('cat:') ? 'category' : 'task'} scoped)`);
  await loadTaskScopeFields(scopeKey, { categoryId, taskId });
  renderTaskScopeFieldsList(scopeKey, fieldsContainer, { categoryId, taskId });
  return null;
}

function idlePolicyLabel(policy){
  return policy === 'dialer_exempt' ? 'Dialer-exempt' : policy === 'bounded_grace' ? 'Bounded grace' : 'Standard';
}

async function loadTaskCategoriesList(){
  invalidateTeamStatic(); // v676
  const { data: categories } = await sb.from('task_categories').select('id, name, idle_policy, grace_seconds').order('name');
  taskCategoriesCache = categories || [];
  const list = $('taskCategoriesList');
  list.innerHTML = '';
  if(!taskCategoriesCache.length){
    list.innerHTML = '<div class="empty">No task categories yet — add one above.</div>';
    return;
  }
  taskCategoriesCache.forEach(c => {
    const row = document.createElement('div');
    row.className = 'task-row';
    row.style.flexWrap = 'wrap';
    const expanded = taskFieldsExpanded.has(`cat:${c.id}`);
    const policyEditing = taskPolicyEditing.has(c.id);
    row.innerHTML = `
      <div style="flex:1;"><span class="task-row-name" contenteditable="true" data-id="${c.id}" data-original="${escapeHtml(c.name)}" title="Click to rename">${escapeHtml(c.name)}</span><span class="task-row-count">${idlePolicyLabel(c.idle_policy)}${c.idle_policy === 'bounded_grace' && c.grace_seconds ? ` · ${Math.round(c.grace_seconds/60)} min grace` : ''}</span></div>
      <button class="edit-only task-policy-toggle-btn" data-id="${c.id}" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px;">${policyEditing ? 'Cancel' : 'Edit policy'}</button>
      <button class="edit-only task-fields-toggle-btn" data-scope="cat:${c.id}" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px;">${expanded ? 'Hide fields' : 'Manage fields'}</button>
      <button class="task-del-btn edit-only" data-id="${c.id}" title="Delete category">×</button>
      <div style="flex-basis:100%;"></div>
    `;
    const catNameEl = row.querySelector('.task-row-name');
    catNameEl.addEventListener('blur', () => saveTaskCategoryRename(catNameEl));
    catNameEl.addEventListener('keydown', (e) => {
      if(e.key === 'Enter'){ e.preventDefault(); catNameEl.blur(); }
      if(e.key === 'Escape'){ catNameEl.textContent = catNameEl.dataset.original; catNameEl.blur(); }
    });
    row.querySelector('.task-del-btn').addEventListener('click', () => deleteTaskCategory(c.id, c.name));
    row.querySelector('.task-fields-toggle-btn').addEventListener('click', () => {
      const key = `cat:${c.id}`;
      if(taskFieldsExpanded.has(key)) taskFieldsExpanded.delete(key); else taskFieldsExpanded.add(key);
      loadTaskCategoriesList();
    });
    row.querySelector('.task-policy-toggle-btn').addEventListener('click', () => {
      if(taskPolicyEditing.has(c.id)) taskPolicyEditing.delete(c.id); else taskPolicyEditing.add(c.id);
      loadTaskCategoriesList();
    });
    // Was create-only (addCategoryBtn below) -- idle_policy/grace_seconds
    // had no way to change once a category existed, so "Backoffice was set
    // up as Standard by mistake, needs Bounded grace" (or an existing
    // Bounded-grace category's minutes need tuning) meant delete-and-
    // recreate, losing its task assignments and submission fields in the
    // process. Same select/grace-input pair as the "Add category" form
    // above, just pre-filled and wired to an update instead of an insert.
    if(policyEditing){
      const editWrap = document.createElement('div');
      editWrap.style.cssText = 'flex-basis:100%; margin-top:8px; padding-top:8px; border-top:1px solid var(--border); display:flex; gap:8px; flex-wrap:wrap; align-items:flex-end;';
      const graceMin = c.grace_seconds ? Math.round(c.grace_seconds / 60) : 8;
      editWrap.innerHTML = `
        <div style="min-width:150px;"><label>Idle policy</label>
          <select class="task-policy-edit-select">
            <option value="standard"${c.idle_policy === 'standard' || !c.idle_policy ? ' selected' : ''}>Standard</option>
            <option value="dialer_exempt"${c.idle_policy === 'dialer_exempt' ? ' selected' : ''}>Dialer-exempt</option>
            <option value="bounded_grace"${c.idle_policy === 'bounded_grace' ? ' selected' : ''}>Bounded grace</option>
          </select>
        </div>
        <div class="task-policy-edit-grace-wrap" style="min-width:110px; ${c.idle_policy === 'bounded_grace' ? '' : 'display:none;'}"><label>Grace (min)</label><input type="number" class="task-policy-edit-grace-input" min="1" max="60" value="${graceMin}"></div>
        <button class="btn-primary task-policy-save-btn" style="width:auto; padding:8px 16px;">Save</button>
        <div class="msg task-policy-edit-msg" style="display:none; flex-basis:100%;"></div>
      `;
      const editSelect = editWrap.querySelector('.task-policy-edit-select');
      const editGraceWrap = editWrap.querySelector('.task-policy-edit-grace-wrap');
      editSelect.addEventListener('change', () => {
        editGraceWrap.style.display = editSelect.value === 'bounded_grace' ? '' : 'none';
      });
      editWrap.querySelector('.task-policy-save-btn').addEventListener('click', async () => {
        const msg = editWrap.querySelector('.task-policy-edit-msg');
        const newPolicy = editSelect.value;
        const newGraceSeconds = newPolicy === 'bounded_grace' ? (parseInt(editWrap.querySelector('.task-policy-edit-grace-input').value, 10) || 8) * 60 : null;
        const { error } = await sb.from('task_categories').update({ idle_policy: newPolicy, grace_seconds: newGraceSeconds }).eq('id', c.id);
        if(error){
          msg.textContent = error.message;
          msg.className = 'msg error';
          msg.style.display = 'block';
          return;
        }
        logActivity('task_category.update', null, null, `Changed "${c.name}" idle policy to ${idlePolicyLabel(newPolicy)}${newPolicy === 'bounded_grace' ? ` (${Math.round(newGraceSeconds/60)} min grace)` : ''}`);
        taskPolicyEditing.delete(c.id);
        loadTaskCategoriesList();
      });
      row.appendChild(editWrap);
    }
    if(expanded){
      const wrap = document.createElement('div');
      wrap.style.cssText = 'flex-basis:100%; margin-top:8px; padding-top:8px; border-top:1px solid var(--border);';
      const hint = document.createElement('div');
      hint.className = 'mono';
      hint.style.cssText = 'font-size:10px; color:var(--text-dim); margin-bottom:8px;';
      hint.textContent = 'These are the fields the extension shows when submitting a lead for a task in this category (unless the specific task has its own fields — those replace these entirely). Applies to every task in this category with no fields of its own.';
      wrap.appendChild(hint);
      const fieldsContainer = document.createElement('div');
      wrap.appendChild(fieldsContainer);
      const addRow = document.createElement('div');
      addRow.innerHTML = sfFormFieldAddFormHtml();
      wrap.appendChild(addRow);
      row.appendChild(wrap);
      loadTaskScopeFields(`cat:${c.id}`, { categoryId: c.id }).then(() => {
        renderTaskScopeFieldsList(`cat:${c.id}`, fieldsContainer, { categoryId: c.id });
        wireTaskScopeFieldAddForm(addRow, `cat:${c.id}`, { categoryId: c.id }, fieldsContainer);
      });
    }
    list.appendChild(row);
  });
  // v71: per-category (and per-task) "Submission fields" configuration
  // moved to Leads → Submission Forms — this card is idle-policy only now.
  applyEditGating('tasks');
  // keep every task row's category <select> in sync with the current list
  populateAllTaskCategorySelects();
}

// v60: per-category custom submission fields — the extension renders
// whichever fields the current task's category has defined, instead of a
// fixed seller/phone/count form gated on is_dialer_task. See
// schema.sql (v60 section) for the 3 reserved keys and why they map to
// real leads columns instead of the generic extra_fields blob.
// v71: fields can also be scoped to a single task instead of a whole
// category (task_id set instead of category_id) — see
// schema.sql (v71 section). Still used by the extension's own per-task
// "Submit leads" popup.
// v83: RESERVED_FIELD_KEYS/slugifyFieldKey/fieldTypeLabel below are also
// reused by the new, fully independent Leads → Submission Forms Creator
// (lead_submission_form_fields — see schema.sql (v83 section)) — the
// CRUD functions that used to live here for task_category_fields
// (loadScopedFieldsForRow/addScopedField) were removed once nothing
// called them anymore; see this file's own Submission Forms section for
// their form-scoped equivalents (loadSfFormsAndFields/addSfFormField).
const RESERVED_FIELD_KEYS = new Set(['seller_investor_name', 'seller_phone', 'count']);
function slugifyFieldKey(label){
  return label.trim().toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
}
function fieldTypeLabel(type){
  return type === 'tel' ? 'Phone' : type === 'number' ? 'Number' : type === 'textarea' ? 'Long text'
    : type === 'select' ? 'Dropdown' : type === 'multi' ? 'Checkbox group' : 'Text';
}

$('newCategoryPolicySelect') && $('newCategoryPolicySelect').addEventListener('change', (e) => {
  $('newCategoryGraceWrap').style.display = e.target.value === 'bounded_grace' ? '' : 'none';
});

$('addCategoryBtn') && $('addCategoryBtn').addEventListener('click', async () => {
  const nameInput = $('newCategoryNameInput');
  const policySelect = $('newCategoryPolicySelect');
  const graceInput = $('newCategoryGraceInput');
  const msg = $('taskCategoriesMsg');
  const name = (nameInput.value || '').trim();
  if(!name){ msg.textContent = 'Enter a category name.'; msg.className = 'msg error'; return; }
  const idle_policy = policySelect.value;
  const grace_seconds = idle_policy === 'bounded_grace' ? (parseInt(graceInput.value, 10) || 8) * 60 : null;
  const { error } = await sb.from('task_categories').insert({ name, idle_policy, grace_seconds });
  if(error){
    msg.textContent = /duplicate|unique/i.test(error.message) ? 'A category with that name already exists.' : error.message;
    msg.className = 'msg error';
    return;
  }
  nameInput.value = '';
  graceInput.value = '';
  msg.textContent = '';
  loadTaskCategoriesList();
  logActivity('task_category.create', null, null, `Added task category "${name}" (${idlePolicyLabel(idle_policy)})`);
});

async function deleteTaskCategory(id, name){
  if(!confirm(`Delete the "${name}" category? Tasks assigned to it fall back to standard idle detection (or their legacy phone/dialer toggle, if set) — they aren't deleted.`)) return;
  await sb.from('task_categories').delete().eq('id', id);
  loadTaskCategoriesList();
  loadTasksList();
  logActivity('task_category.delete', null, null, `Deleted task category "${name}"`);
}

// v361: rename a task category — same inline contenteditable/blur-to-save
// convention as saveTaskRename() below, just against task_categories
// instead of tasks. No FK-cascade complications here (nothing references
// a category by name — task_categories is keyed by id, tasks.category_id
// points at that id, not the name), so a plain client-side update is fine.
async function saveTaskCategoryRename(nameEl){
  const newName = nameEl.textContent.trim();
  const categoryId = nameEl.dataset.id;
  const oldName = nameEl.dataset.original;
  if(!newName || newName === oldName){
    nameEl.textContent = oldName;
    return;
  }
  const { error } = await sb.from('task_categories').update({ name: newName }).eq('id', categoryId);
  const msg = $('taskCategoriesMsg');
  if(error){
    msg.textContent = /duplicate|unique/i.test(error.message) ? 'A category with that name already exists.' : error.message;
    msg.className = 'msg error';
    nameEl.textContent = oldName;
  } else {
    nameEl.dataset.original = newName;
    msg.textContent = 'Renamed.';
    msg.className = 'msg';
    msg.style.color = 'var(--focus)';
    logActivity('task_category.rename', null, null, `Renamed task category "${oldName}" to "${newName}"`);
    // populateAllTaskCategorySelects() reads from taskCategoriesCache, not
    // the DOM — update the cached entry directly rather than a full
    // loadTaskCategoriesList() reload, so every task's category dropdown
    // picks up the new name immediately without re-rendering this list.
    const cacheEntry = taskCategoriesCache.find(c => c.id === categoryId);
    if(cacheEntry) cacheEntry.name = newName;
    populateAllTaskCategorySelects();
  }
}

function populateAllTaskCategorySelects(){
  document.querySelectorAll('.task-category-select').forEach(sel => {
    const current = sel.value;
    sel.innerHTML = '<option value="">— No category (standard) —</option>' +
      taskCategoriesCache.map(c => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join('');
    sel.value = current;
  });
}

// ---------- per-task expected-domain list (admin-managed, same pattern as
// dialer_domains but scoped to one task) — used by the extension for the
// non-blocking off-task-domain banner, and by the Flags tab's generalized
// category_abuse check below ----------
async function loadTaskDomainsForRow(taskId, container){
  const { data: domains } = await sb.from('task_domains').select('id, domain').eq('task_id', taskId).order('domain');
  container.innerHTML = '';
  (domains || []).forEach(d => {
    const chip = document.createElement('span');
    chip.className = 'mono';
    chip.style.cssText = 'display:inline-flex; align-items:center; gap:5px; background:var(--inset); border-radius:4px; padding:3px 7px; font-size:10px; margin:2px 4px 2px 0;';
    chip.innerHTML = `${escapeHtml(d.domain)} <span class="edit-only" data-id="${d.id}" style="cursor:pointer; color:var(--text-dim);" title="Remove">×</span>`;
    const x = chip.querySelector('span[data-id]');
    if(x) x.addEventListener('click', async () => {
      await sb.from('task_domains').delete().eq('id', d.id);
      loadTaskDomainsForRow(taskId, container);
    });
    container.appendChild(chip);
  });
  if(!domains || domains.length === 0){
    const hint = document.createElement('span');
    hint.className = 'mono';
    hint.style.cssText = 'font-size:10px; color:var(--text-dim);';
    hint.textContent = 'No domains set — no off-task warning or abuse check for this task.';
    container.appendChild(hint);
  }
  applyEditGating('tasks');
}

async function loadTasksList(){
  invalidateTeamStatic(); // v676
  const { data: allTasks } = await sb.from('tasks').select('id, name, require_chrome_focus, is_dialer_task, category_id, archived_at').order('name');
  // v144: keeps Activity > Extension's per-task pills (and, through
  // ACTIVITY_SECTIONS, the User Management role picker's per-task
  // checkboxes) in sync with whatever's live in the Tasks admin panel
  // right below — a rename here relabels the pill, an archive/delete
  // removes it, a new task adds one, all without needing the Activity tab
  // to be visited first this session.
  refreshExtensionTaskSections(allTasks || []);
  const { data: assignments } = await sb.from('task_assignments').select('task_id');
  const counts = {};
  (assignments||[]).forEach(a => { counts[a.task_id] = (counts[a.task_id]||0) + 1; });

  const showArchived = $('showArchivedTasksToggle') && $('showArchivedTasksToggle').checked;
  const tasks = (allTasks || []).filter(t => showArchived || !t.archived_at);

  const list = $('tasksList');
  list.innerHTML = '';
  if(!tasks || tasks.length === 0){
    list.innerHTML = `<div class="empty">${showArchived ? 'No tasks yet — add one above.' : 'No active tasks — add one above, or check "Show archived tasks" to see retired ones.'}</div>`;
    return;
  }
  tasks.forEach(t => {
    if(t.archived_at){
      const row = document.createElement('div');
      row.className = 'task-row';
      row.style.cssText = 'flex-wrap:wrap; opacity:0.6;';
      row.innerHTML = `
        <div style="flex:1; min-width:160px;"><span class="task-row-name">${escapeHtml(t.name)}</span><span class="task-row-count">Archived · ${counts[t.id]||0} historical assignment${counts[t.id] === 1 ? '' : 's'}</span></div>
        <button class="btn-secondary edit-only task-unarchive-btn" data-id="${t.id}" style="width:auto; padding:4px 12px; font-size:11px;">Unarchive</button>
      `;
      row.querySelector('.task-unarchive-btn').addEventListener('click', () => unarchiveTask(t.id, t.name));
      list.appendChild(row);
      return;
    }
    const row = document.createElement('div');
    row.className = 'task-row';
    row.style.flexWrap = 'wrap';
    row.innerHTML = `
      <div style="flex:1; min-width:160px;"><span class="task-row-name" contenteditable="true" data-id="${t.id}" data-original="${escapeHtml(t.name)}">${escapeHtml(t.name)}</span><span class="task-row-count">${counts[t.id]||0} assigned</span></div>
      <select class="task-category-select" data-id="${t.id}" title="Task category — sets idle policy (Standard/Dialer-exempt/Bounded grace) and role restriction" style="min-width:170px; margin-right:12px;"></select>
      <label style="display:flex; align-items:center; gap:6px; cursor:pointer; text-transform:none; font-family:var(--sans); font-size:11px; color:var(--text-dim); letter-spacing:0; margin-right:12px;">
        <input type="checkbox" class="require-focus-toggle" data-id="${t.id}" ${t.require_chrome_focus ? 'checked' : ''} style="width:14px; height:14px; accent-color:var(--focus);">
        Requires Chrome focus
      </label>
      <label style="display:flex; align-items:center; gap:6px; cursor:pointer; text-transform:none; font-family:var(--sans); font-size:11px; color:var(--text-dim); letter-spacing:0; margin-right:12px;" title="Legacy toggle — superseded by a Dialer-exempt category above, but still honored for tasks with no category assigned">
        <input type="checkbox" class="dialer-toggle" data-id="${t.id}" ${t.is_dialer_task ? 'checked' : ''} style="width:14px; height:14px; accent-color:var(--focus);">
        Phone / dialer task (legacy)
      </label>
      <button class="edit-only task-fields-toggle-btn" data-scope="task:${t.id}" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px; margin-right:12px;">${taskFieldsExpanded.has(`task:${t.id}`) ? 'Hide fields' : 'Manage fields'}</button>
      <button class="task-del-btn edit-only" data-id="${t.id}" title="Delete task">×</button>
      <div style="flex-basis:100%; margin-top:8px; padding-top:8px; border-top:1px solid var(--border);">
        <div style="display:flex; gap:6px; align-items:center; margin-bottom:6px;">
          <span class="mono" style="font-size:10px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.5px;">Expected domains</span>
          <input type="text" class="task-domain-input edit-only" data-id="${t.id}" placeholder="e.g. zillow.com" style="flex:0 0 160px; padding:4px 8px; font-size:11px;">
          <button class="btn-secondary task-domain-add-btn edit-only" data-id="${t.id}" style="width:auto; padding:4px 10px; font-size:11px;">Add</button>
        </div>
        <div class="task-domains-chips" data-id="${t.id}"></div>
      </div>
      <div class="task-fields-editor-slot" style="flex-basis:100%;"></div>
    `;
    const nameEl = row.querySelector('.task-row-name');
    nameEl.addEventListener('blur', () => saveTaskRename(nameEl));
    nameEl.addEventListener('keydown', (e) => {
      if(e.key === 'Enter'){ e.preventDefault(); nameEl.blur(); }
      if(e.key === 'Escape'){ nameEl.textContent = nameEl.dataset.original; nameEl.blur(); }
    });
    const categorySelect = row.querySelector('.task-category-select');
    categorySelect.innerHTML = '<option value="">— No category (standard) —</option>' +
      taskCategoriesCache.map(c => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join('');
    categorySelect.value = t.category_id || '';
    categorySelect.addEventListener('change', async (e) => {
      const value = e.target.value || null;
      const { error } = await sb.from('tasks').update({ category_id: value }).eq('id', t.id);
      if(!error){
        const catName = value ? (taskCategoriesCache.find(c => c.id === value) || {}).name : 'no category';
        logActivity('task.update', 'task', t.id, `Set task "${t.name}" category to "${catName}"`);
      }
    });
    row.querySelector('.require-focus-toggle').addEventListener('change', async (e) => {
      const checked = e.target.checked;
      const { error } = await sb.from('tasks').update({ require_chrome_focus: checked }).eq('id', t.id);
      if(!error){
        logActivity('task.update', 'task', t.id,
          `${checked ? 'Enabled' : 'Disabled'} "requires Chrome focus" for "${t.name}"`);
      }
    });
    row.querySelector('.dialer-toggle').addEventListener('change', async (e) => {
      const checked = e.target.checked;
      const { error } = await sb.from('tasks').update({ is_dialer_task: checked }).eq('id', t.id);
      if(!error){
        logActivity('task.update', 'task', t.id,
          `${checked ? 'Enabled' : 'Disabled'} "phone/dialer task" for "${t.name}"`);
      }
    });
    row.querySelector('.task-del-btn').addEventListener('click', () => deleteTask(t.id, t.name));
    row.querySelector('.task-fields-toggle-btn').addEventListener('click', () => {
      const key = `task:${t.id}`;
      if(taskFieldsExpanded.has(key)) taskFieldsExpanded.delete(key); else taskFieldsExpanded.add(key);
      loadTasksList();
    });
    if(taskFieldsExpanded.has(`task:${t.id}`)){
      const slot = row.querySelector('.task-fields-editor-slot');
      slot.style.cssText = 'flex-basis:100%; margin-top:8px; padding-top:8px; border-top:1px solid var(--border);';
      const hint = document.createElement('div');
      hint.className = 'mono';
      hint.style.cssText = 'font-size:10px; color:var(--text-dim); margin-bottom:8px;';
      hint.textContent = 'Fields specific to THIS task — if this task has any fields here, the extension uses these INSTEAD OF its category\'s fields entirely for this one task.';
      slot.appendChild(hint);
      const fieldsContainer = document.createElement('div');
      slot.appendChild(fieldsContainer);
      const addRow = document.createElement('div');
      addRow.innerHTML = sfFormFieldAddFormHtml();
      slot.appendChild(addRow);
      loadTaskScopeFields(`task:${t.id}`, { taskId: t.id }).then(() => {
        renderTaskScopeFieldsList(`task:${t.id}`, fieldsContainer, { taskId: t.id });
        wireTaskScopeFieldAddForm(addRow, `task:${t.id}`, { taskId: t.id }, fieldsContainer);
      });
    }

    const chipsContainer = row.querySelector('.task-domains-chips');
    loadTaskDomainsForRow(t.id, chipsContainer);
    const domainInput = row.querySelector('.task-domain-input');
    const domainAddBtn = row.querySelector('.task-domain-add-btn');
    const addTaskDomain = async () => {
      const domain = normalizeDomainInput(domainInput.value || '');
      if(!domain || !domain.includes('.')) return;
      const { error } = await sb.from('task_domains').insert({ task_id: t.id, domain });
      if(!error){
        domainInput.value = '';
        loadTaskDomainsForRow(t.id, chipsContainer);
        logActivity('task_domain.create', 'task', t.id, `Added expected domain "${domain}" to "${t.name}"`);
      }
    };
    domainAddBtn.addEventListener('click', addTaskDomain);
    domainInput.addEventListener('keydown', (e) => { if(e.key === 'Enter'){ e.preventDefault(); addTaskDomain(); } });

    list.appendChild(row);
  });
  applyEditGating('tasks');
}

// ---------- dialer/CRM domain management (admin adds/removes; the
// extension reads this table directly, so nothing here ever needs a
// matching extension code change or reload) ----------
async function loadDialerDomainsList(){
  invalidateTeamStatic(); // v676
  const { data: domains } = await sb.from('dialer_domains').select('id, domain').order('domain');
  const list = $('dialerDomainsList');
  list.innerHTML = '';
  if(!domains || domains.length === 0){
    list.innerHTML = '<div class="empty">No dialer domains yet — add one above.</div>';
    return;
  }
  domains.forEach(d => {
    const row = document.createElement('div');
    row.className = 'task-row';
    row.innerHTML = `
      <div style="flex:1;"><span class="task-row-name">${escapeHtml(d.domain)}</span><span class="task-row-count">+ subdomains</span></div>
      <button class="task-del-btn edit-only" data-id="${d.id}" title="Remove domain">×</button>
    `;
    row.querySelector('.task-del-btn').addEventListener('click', () => deleteDialerDomain(d.id, d.domain));
    list.appendChild(row);
  });
  applyEditGating('tasks');
}

function normalizeDomainInput(raw){
  let v = raw.trim().toLowerCase();
  v = v.replace(/^https?:\/\//, '').replace(/\/.*$/, ''); // tolerate a pasted full URL
  return v;
}

$('addDialerDomainBtn').addEventListener('click', async () => {
  const input = $('newDialerDomainInput');
  const msg = $('dialerDomainsMsg');
  const domain = normalizeDomainInput(input.value || '');
  if(!domain || !domain.includes('.')){
    msg.textContent = 'Enter a valid domain, e.g. readymode.com';
    msg.className = 'msg error';
    return;
  }
  const { error } = await sb.from('dialer_domains').insert({ domain });
  if(error){
    msg.textContent = /duplicate|unique/i.test(error.message) ? 'That domain is already on the list.' : error.message;
    msg.className = 'msg error';
    return;
  }
  input.value = '';
  msg.textContent = '';
  loadDialerDomainsList();
  logActivity('dialer_domain.create', null, null, `Added dialer/CRM domain "${domain}"`);
});
$('newDialerDomainInput').addEventListener('keydown', (e) => {
  if(e.key === 'Enter'){ e.preventDefault(); $('addDialerDomainBtn').click(); }
});

async function deleteDialerDomain(id, domain){
  if(!confirm(`Remove "${domain}" from the dialer/CRM domain list?`)) return;
  await sb.from('dialer_domains').delete().eq('id', id);
  loadDialerDomainsList();
  logActivity('dialer_domain.delete', null, null, `Removed dialer/CRM domain "${domain}"`);
}

async function loadMinExtensionVersion(){
  invalidateTeamStatic(); // v676
  const { data } = await sb.from('app_settings').select('value').eq('key', 'min_extension_version').maybeSingle();
  $('minExtensionVersionInput').value = (data && data.value && data.value !== '0.0.0') ? data.value : '';
}

// Simple dot-separated numeric compare — same logic the extension itself
// uses (background.js's compareVersions) to decide what counts as "valid".
function isValidVersionString(v){
  return /^\d+(\.\d+){0,3}$/.test(v.trim());
}

$('saveMinExtensionVersionBtn').addEventListener('click', async () => {
  const msg = $('extensionVersionMsg');
  const raw = $('minExtensionVersionInput').value.trim();
  const value = raw || '0.0.0'; // blank = no minimum, i.e. allow any version
  if(!isValidVersionString(value)){
    msg.textContent = 'Enter a version like 1.2.0, or leave blank for no minimum.';
    msg.className = 'msg error';
    return;
  }
  const { error } = await sb.from('app_settings').upsert({ key: 'min_extension_version', value, updated_at: new Date().toISOString() });
  if(error){
    msg.textContent = error.message;
    msg.className = 'msg error';
    return;
  }
  msg.textContent = raw ? `Saved — users below v${raw} will be blocked and prompted to update.` : 'Saved — no minimum version enforced.';
  msg.className = 'msg ok';
  logActivity('app_settings.update', null, null, `Set minimum extension version to ${raw || '(none)'}`);
});

async function loadActivityCeilings(){
  const { data } = await sb.from('app_settings').select('key,value')
    .in('key', ['activity_ceiling_mouse_per_min', 'activity_ceiling_keyboard_per_min']);
  const byKey = {}; (data || []).forEach(r => { byKey[r.key] = r.value; });
  $('activityCeilingMouseInput').value = byKey.activity_ceiling_mouse_per_min || '';
  $('activityCeilingKeyboardInput').value = byKey.activity_ceiling_keyboard_per_min || '';
}

$('saveActivityCeilingsBtn').addEventListener('click', async () => {
  const msg = $('activityCeilingsMsg');
  const mouseRaw = $('activityCeilingMouseInput').value.trim();
  const kbRaw = $('activityCeilingKeyboardInput').value.trim();
  // Blank -> null (falls back to the extension's built-in default for that
  // channel); anything else must be a positive number, since a zero/negative
  // ceiling would make scoreActivity() divide by zero or invert the scale.
  for(const [label, raw] of [['Mouse', mouseRaw], ['Keyboard', kbRaw]]){
    if(raw && (!Number.isFinite(Number(raw)) || Number(raw) <= 0)){
      msg.textContent = `${label} ceiling must be a positive number, or blank to use the default.`;
      msg.className = 'msg error';
      return;
    }
  }
  const now = new Date().toISOString();
  const { error } = await sb.from('app_settings').upsert([
    { key: 'activity_ceiling_mouse_per_min', value: mouseRaw || null, updated_at: now },
    { key: 'activity_ceiling_keyboard_per_min', value: kbRaw || null, updated_at: now },
  ]);
  if(error){
    msg.textContent = error.message;
    msg.className = 'msg error';
    return;
  }
  msg.textContent = 'Saved — takes effect for agents within about 5 minutes.';
  msg.className = 'msg ok';
  logActivity('app_settings.update', null, null, `Set activity ceilings to mouse=${mouseRaw || '(default)'}, keyboard=${kbRaw || '(default)'}`);
});

async function loadWebrtcTurnSettings(){
  const { data } = await sb.from('app_settings').select('key,value')
    .in('key', ['webrtc_turn_url', 'webrtc_turn_username', 'webrtc_turn_credential']);
  const byKey = {}; (data || []).forEach(r => { byKey[r.key] = r.value; });
  $('webrtcTurnUrlInput').value = byKey.webrtc_turn_url || '';
  $('webrtcTurnUsernameInput').value = byKey.webrtc_turn_username || '';
  $('webrtcTurnCredentialInput').value = byKey.webrtc_turn_credential || '';
}

$('saveWebrtcTurnBtn').addEventListener('click', async () => {
  const msg = $('webrtcTurnMsg');
  const url = $('webrtcTurnUrlInput').value.trim();
  const username = $('webrtcTurnUsernameInput').value.trim();
  const credential = $('webrtcTurnCredentialInput').value.trim();
  if(url && !/^turns?:/.test(url)){
    msg.textContent = 'TURN URL should start with turn: or turns: (e.g. turn:your-server.example.com:3478).';
    msg.className = 'msg error';
    return;
  }
  const now = new Date().toISOString();
  const { error } = await sb.from('app_settings').upsert([
    { key: 'webrtc_turn_url', value: url || null, updated_at: now },
    { key: 'webrtc_turn_username', value: username || null, updated_at: now },
    { key: 'webrtc_turn_credential', value: credential || null, updated_at: now },
  ]);
  if(error){
    msg.textContent = error.message;
    msg.className = 'msg error';
    return;
  }
  msg.textContent = url ? 'Saved — new calls will use this TURN server.' : 'Saved — new calls will use STUN only.';
  msg.className = 'msg ok';
  logActivity('app_settings.update', null, null, `Set WebRTC TURN server to ${url || '(none — STUN only)'}`);
});

