  box.innerHTML = `
    <table>
      <thead><tr><th>Agent</th><th>ReadyMode username</th><th></th></tr></thead>
      <tbody>
        ${agents.map(a => `
          <tr>
            <td>${escapeHtml(a.full_name || a.email || '—')}</td>
            <td><input type="text" class="rm-map-input" data-agent="${a.id}" value="${escapeHtml(a.readymode_username || '')}" placeholder="ReadyMode username" style="width:100%; max-width:280px;"></td>
            <td><button class="btn-secondary rm-map-save edit-only" data-agent="${a.id}" style="width:auto; padding:5px 12px;">Save</button></td>
          </tr>
        `).join('')}
      </tbody>
    </table>
    <div class="msg" id="rmMapMsg"></div>`;
  box.querySelectorAll('.rm-map-save').forEach(btn => {
    btn.addEventListener('click', async () => {
      const agentId = btn.dataset.agent;
      const input = box.querySelector(`.rm-map-input[data-agent="${agentId}"]`);
      const val = input ? input.value.trim() : '';
      btn.disabled = true;
      const res = await callRmApi({ action: 'set_agent_readymode_username', agentId, username: val || null });
      btn.disabled = false;
      const msg = $('rmMapMsg');
      if(res.ok){ msg.textContent = 'Saved.'; msg.className = 'msg ok'; }
      else { msg.textContent = res.error || 'Failed to save.'; msg.className = 'msg error'; }
    });
  });
}

const rmSaveBtn = document.getElementById('rmSaveConnectionBtn');
if(rmSaveBtn) rmSaveBtn.addEventListener('click', async () => {
  const accountDomain = $('rmAccountDomain').value.trim();
  const apiKey = $('rmApiKey').value.trim();
  const callsEndpoint = $('rmCallsEndpoint').value.trim();
  const researchEndpoint = $('rmResearchEndpoint').value.trim();
  const productivityEndpoint = $('rmProductivityEndpoint').value.trim();
  const msg = $('rmConnectionMsg');
  // apiKey is no longer required on its own -- lead-posting auth now lives
  // per-channel (see "Lead-posting channels" card below), so an account
  // that only wants that half configured shouldn't be blocked here.
  if(!accountDomain){
    msg.textContent = 'Account domain is required.';
    msg.className = 'msg error';
    return;
  }
  rmSaveBtn.disabled = true;
  const result = await callRmApi({ action: 'save_connection', accountDomain, apiKey, callsEndpoint, researchEndpoint, productivityEndpoint });
  rmSaveBtn.disabled = false;
  if(!result.ok){ msg.textContent = result.error || 'Failed to save.'; msg.className = 'msg error'; return; }
  msg.textContent = 'Saved.';
  msg.className = 'msg ok';
  $('rmApiKey').value = '';
  logActivity('integration.connect', 'readymode_account', null, `Connected ReadyMode account ${accountDomain}`);
  await loadRmConnections();
  await loadRmLeadPostingChannels();
});

// v (user request, 2026-09-04): "this list should be uploaded on Mississippi
// Trial Number 1 campaign" -- a second real campaign needing its own
// posting URL made the old single-lead_posting_url-per-account model
// insufficient, so channels are now their own named, listable/deletable
// rows (readymode_lead_posting_channels) instead of one overloaded field.
async function loadRmLeadPostingChannels(){
  const accountDomain = $('rmAccountDomain').value.trim();
  const list = $('rmChannelsList');
  const select = $('rmListChannelSelect');
  if(list) list.innerHTML = '<div class="empty">Loading…</div>';
  if(select) select.innerHTML = '<option value="">Loading channels…</option>';
  const result = await callRmApi({ action: 'list_lead_posting_channels', accountDomain: accountDomain || undefined });
  if(!result.ok){
    if(list) list.innerHTML = `<div class="msg error">${escapeHtml(result.error || 'Failed to load channels.')}</div>`;
    if(select) select.innerHTML = '<option value="">Failed to load channels</option>';
    return;
  }
  const channels = result.channels || [];
  if(list){
    if(!channels.length){
      list.innerHTML = '<div class="empty">No channels saved yet. Add one above for each ReadyMode campaign you push into.</div>';
    } else {
      // Agent list for the inline picker below -- fetched once per render,
      // not per row. Same direct profiles read used all over this
      // dashboard (see loadRmAgentMap's near-identical query just below),
      // no need to route it through readymode-api.
      const { data: agentRows } = await sb.from('profiles').select('id, full_name, email').order('full_name');
      // v518: Agent Hours Logged is sourced from this agent's ReadyMode
      // Agent Report data (readymode_productivity_daily -- ReadyMode's own
      // login/logout clock), not the time-tracking Chrome extension.
      const agentOptionsHtml = (selectedId) => `<option value="">Whole team</option>` + (agentRows || []).map(a =>
        `<option value="${a.id}" ${a.id === selectedId ? 'selected' : ''}>${escapeHtml(a.full_name || a.email)}</option>`
      ).join('');
      list.innerHTML = `
        <table>
          <thead><tr><th>Account</th><th>Channel/campaign</th><th>Client</th><th>Agent hours from</th><th>Corrections</th><th>Posting URL</th><th></th></tr></thead>
          <tbody>
            ${channels.map(c => `
              <tr>
                <td>${escapeHtml(c.account_domain)}</td>
                <td>${escapeHtml(c.channel_name)}</td>
                <td>${c.client_name ? escapeHtml(c.client_name) : '<span style="color:var(--text-dim);">Unassigned</span>'}</td>
                <td><select class="rm-channel-agent-select" data-channel-id="${c.id}" style="width:auto; min-width:140px;">${agentOptionsHtml(c.agent_id)}</select></td>
                <td><button class="btn-outline rm-channel-adjustments-btn" data-channel-id="${c.id}" data-channel-name="${escapeHtml(c.channel_name)}" style="width:auto; padding:4px 10px; font-size:11px;">Corrections (${c.adjustment_count || 0})</button></td>
                <td class="mono" style="color:var(--text-2); word-break:break-all;">${escapeHtml(c.posting_url)}</td>
                <td><button class="task-del-btn rm-delete-channel-btn" data-domain="${escapeHtml(c.account_domain)}" data-channel="${escapeHtml(c.channel_name)}" title="Delete">&times;</button></td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
      list.querySelectorAll('.rm-delete-channel-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          if(!confirm(`Delete the "${btn.dataset.channel}" channel? This won't affect leads already pushed.`)) return;
          const res = await callRmApi({ action: 'delete_lead_posting_channel', accountDomain: btn.dataset.domain, channelName: btn.dataset.channel });
          if(!res.ok){ alert(res.error || 'Failed to delete.'); return; }
          await loadRmLeadPostingChannels();
        });
      });
      // Attributes this campaign's Agent Hours Logged (client-reports) to
      // just this agent's ReadyMode-sourced hours instead of the whole
      // team's -- set_channel_agent by the channel's own id, same pattern
      // the Client column uses from the "Edit client" modal.
      list.querySelectorAll('.rm-channel-agent-select').forEach(sel => {
        sel.addEventListener('change', async () => {
          sel.disabled = true;
          const res = await callRmApi({ action: 'set_channel_agent', channelId: sel.dataset.channelId, agentId: sel.value || null });
          sel.disabled = false;
          if(!res.ok){ alert(res.error || 'Failed to update agent.'); await loadRmLeadPostingChannels(); return; }
        });
      });
      // Opens the date-ranged corrections modal for this channel (see
      // openHoursAdjModal below) -- replaces the old flat "Manual +/-
      // (hrs)" field, which applied to every date range regardless of
      // whether it was actually relevant.
      list.querySelectorAll('.rm-channel-adjustments-btn').forEach(btn => {
        btn.addEventListener('click', () => openHoursAdjModal(btn.dataset.channelId, btn.dataset.channelName));
      });
    }
  }
  if(select){
    if(!channels.length){
      select.innerHTML = '<option value="">No channels saved — add one above first</option>';
    } else {
      select.innerHTML = '<option value="">Select a channel/campaign…</option>' + channels.map(c =>
        `<option value="${escapeHtml(c.channel_name)}" data-domain="${escapeHtml(c.account_domain)}">${escapeHtml(c.channel_name)} (${escapeHtml(c.account_domain)})</option>`
      ).join('');
    }
  }
}

// v519: per-channel Agent Hours Logged date-ranged corrections modal (see
// its markup, #hoursAdjModalOverlay, near clientAccessModalOverlay).
let hoursAdjTargetChannelId = null;
function fmtHoursAdjAmount(seconds){
  const sign = seconds < 0 ? '-' : '+';
  const abs = Math.abs(seconds);
  const h = Math.floor(abs / 3600);
  const m = Math.round((abs % 3600) / 60);
  return `${sign}${h}h ${m}m`;
}
async function loadHoursAdjList(){
  const listEl = $('hoursAdjList');
  listEl.innerHTML = '<div class="empty">Loading…</div>';
  const result = await callRmApi({ action: 'list_channel_hours_adjustments', channelId: hoursAdjTargetChannelId });
  if(!result.ok){ listEl.innerHTML = `<div class="msg error">${escapeHtml(result.error || 'Failed to load corrections.')}</div>`; return; }
  const adjustments = result.adjustments || [];
  if(!adjustments.length){
    listEl.innerHTML = '<div class="empty">No corrections logged yet for this campaign.</div>';
    return;
  }
  listEl.innerHTML = adjustments.map(a => `
    <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; padding:6px 0; border-bottom:1px solid var(--border);">
      <div>
        <div style="font-weight:700; color:${a.adjustment_seconds < 0 ? 'var(--danger, #E5484D)' : 'var(--text)'};">${fmtHoursAdjAmount(a.adjustment_seconds)}</div>
        <div style="font-size:11px; color:var(--text-2);">${escapeHtml(a.date_from)} → ${escapeHtml(a.date_to)}${a.note ? ' — ' + escapeHtml(a.note) : ''}</div>
      </div>
      <button class="task-del-btn hours-adj-delete-btn" data-id="${a.id}" title="Delete">&times;</button>
    </div>
  `).join('');
  listEl.querySelectorAll('.hours-adj-delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if(!confirm('Delete this correction?')) return;
      const res = await callRmApi({ action: 'delete_channel_hours_adjustment', id: btn.dataset.id });
      if(!res.ok){ alert(res.error || 'Failed to delete.'); return; }
      await loadHoursAdjList();
      await loadRmLeadPostingChannels(); // refreshes the "Corrections (N)" count on the row
    });
  });
}
function openHoursAdjModal(channelId, channelName){
  hoursAdjTargetChannelId = channelId;
  $('hoursAdjChannelName').textContent = channelName;
  $('hoursAdjDateFrom').value = '';
  $('hoursAdjDateTo').value = '';
  $('hoursAdjSign').value = '1';
  $('hoursAdjHours').value = '';
  $('hoursAdjMinutes').value = '';
  $('hoursAdjNote').value = '';
  $('hoursAdjMsg').textContent = '';
  $('hoursAdjModalOverlay').classList.add('active');
  loadHoursAdjList();
}
$('hoursAdjCloseBtn').addEventListener('click', () => $('hoursAdjModalOverlay').classList.remove('active'));
$('hoursAdjModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'hoursAdjModalOverlay') $('hoursAdjModalOverlay').classList.remove('active'); });
$('hoursAdjAddBtn').addEventListener('click', async () => {
  const msg = $('hoursAdjMsg');
  msg.textContent = '';
  const dateFrom = $('hoursAdjDateFrom').value;
  const dateTo = $('hoursAdjDateTo').value;
  if(!dateFrom || !dateTo){ msg.textContent = 'From date and To date are both required.'; return; }
  if(dateTo < dateFrom){ msg.textContent = 'To date must be on or after From date.'; return; }
  const sign = Number($('hoursAdjSign').value);
  const hours = Math.max(0, parseInt($('hoursAdjHours').value, 10) || 0);
  const minutes = Math.max(0, Math.min(59, parseInt($('hoursAdjMinutes').value, 10) || 0));
  const adjustmentSeconds = sign * (hours * 3600 + minutes * 60);
  if(!adjustmentSeconds){ msg.textContent = 'Enter a non-zero amount of hours and/or minutes.'; return; }
  const btn = $('hoursAdjAddBtn');
  btn.disabled = true;
  const res = await callRmApi({
    action: 'add_channel_hours_adjustment',
    channelId: hoursAdjTargetChannelId,
    dateFrom, dateTo, adjustmentSeconds,
    note: $('hoursAdjNote').value.trim() || undefined,
  });
  btn.disabled = false;
  if(!res.ok){ msg.textContent = res.error || 'Failed to add correction.'; return; }
  $('hoursAdjDateFrom').value = '';
  $('hoursAdjDateTo').value = '';
  $('hoursAdjHours').value = '';
  $('hoursAdjMinutes').value = '';
  $('hoursAdjNote').value = '';
  await loadHoursAdjList();
  await loadRmLeadPostingChannels();
});

// Client picker for "which client does this campaign belong to" -- powers
// the client-facing Reports tab's own scoping (client-reports edge
// function looks up readymode_lead_posting_channels.client_id). Mirrors
// loadOneOffChargeClientOptions()'s exact query/render shape.
async function loadRmChannelClientOptions(){
  const sel = $('rmChannelClientSelect');
  if(!sel) return;
  const { data, error } = await sb.from('client_accounts').select('id, full_name, email').eq('is_active', true).order('full_name');
  if(error){
    sel.innerHTML = `<option value="">Failed to load clients</option>`;
    return;
  }
  sel.innerHTML = `<option value="">Unassigned (no client)</option>` + (data || []).map(c =>
    `<option value="${c.id}">${escapeHtml(c.full_name || c.email || c.id)}</option>`
  ).join('');
}

const rmSaveChannelBtn = document.getElementById('rmSaveChannelBtn');
if(rmSaveChannelBtn) rmSaveChannelBtn.addEventListener('click', async () => {
