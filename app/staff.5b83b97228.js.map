// ---------- ReadyMode integration ----------
async function callRmApi(payload){
  const { data, error } = await sb.functions.invoke('readymode-api', { body: payload });
  if(error){
    try{ const body = await error.context.json(); return { ok: false, error: body.error || error.message }; }
    catch{ return { ok: false, error: error.message }; }
  }
  return data;
}

async function loadRmConnections(){
  const list = $('rmConnectionsList');
  if(!list) return;
  list.innerHTML = '<div class="empty">Loading…</div>';
  const result = await callRmApi({ action: 'list_connections' });
  if(!result.ok){ list.innerHTML = `<div class="msg error">${escapeHtml(result.error || 'Failed to load connections.')}</div>`; return; }
  const connections = result.connections || [];
  if(!connections.length){ list.innerHTML = '<div class="empty">No ReadyMode account connected yet.</div>'; return; }
  list.innerHTML = `
    <table>
      <thead><tr><th>Account</th><th>Connected</th><th>Endpoints configured</th><th>Lead posting</th><th></th></tr></thead>
      <tbody>
        ${connections.map(c => `
          <tr>
            <td>${escapeHtml(c.account_domain)}</td>
            <td style="color:var(--text-2);">${new Date(c.created_at).toLocaleDateString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {})}</td>
            <td style="color:${(c.calls_endpoint||c.research_endpoint||c.productivity_endpoint) ? 'var(--focus)' : 'var(--text-dim)'};">${[c.calls_endpoint&&'Calls', c.research_endpoint&&'Research', c.productivity_endpoint&&'Productivity'].filter(Boolean).join(', ') || 'None yet — use CSV import'}</td>
            <td style="color:${c.lead_posting_url ? 'var(--focus)' : 'var(--text-dim)'};">${c.lead_posting_url ? 'Configured' : 'Not set'}</td>
            <td><button class="task-del-btn rm-disconnect-btn" data-domain="${escapeHtml(c.account_domain)}" title="Disconnect">&times;</button></td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  `;
  list.querySelectorAll('.rm-disconnect-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if(!confirm('Disconnect this ReadyMode account?')) return;
      const res = await callRmApi({ action: 'disconnect', accountDomain: btn.dataset.domain });
      if(!res.ok){ alert(res.error || 'Failed to disconnect.'); return; }
      logActivity('integration.disconnect', 'readymode_account', null, `Disconnected ReadyMode account ${btn.dataset.domain}`);
      await loadRmConnections();
    });
  });
}

