// v561: unlike every other control in this row, Imported re-FETCHES (see
// leadsImportBatchFilter's use in the leads query). Resolve the chosen
// mode to a concrete batch id first — "my last import" means the newest
// batch this user ran, which only the database knows.
async function resolveLeadsImportBatch(mode){
  if(!mode) return '';
  let q = sb.from('leads')
    .select('last_import_batch, last_imported_at')
    .not('last_import_batch', 'is', null)
    .order('last_imported_at', { ascending: false })
    .limit(1);
  if(mode === 'mine_last') q = q.eq('last_imported_by', myUserId);
  const { data, error } = await q;
  if(error){ console.error('resolveLeadsImportBatch failed:', error); return ''; }
  return (data && data[0] && data[0].last_import_batch) || '';
}
$('leadsIspdImportedFilter').addEventListener('change', async () => {
  const sel = $('leadsIspdImportedFilter');
  const mode = sel.value;
  sel.disabled = true;
  try{
    leadsImportBatchFilter = await resolveLeadsImportBatch(mode);
    if(mode && !leadsImportBatchFilter){
      // No batch found — say so instead of silently falling back to the
      // date range, which would look like the filter did nothing.
      alert(mode === 'mine_last'
        ? "You haven't run a CSV/Excel import yet, so there's no last import to show."
        : 'No CSV/Excel import has been run yet.');
      sel.value = '';
    }
    await loadLeads();
  } finally {
    sel.disabled = false;
  }
});
$('leadsIspdSentByFilter').addEventListener('change', () => { leadsIspdFilters.sentBy = $('leadsIspdSentByFilter').value; renderIspdReviewTable(); });
$('leadsIspdSentDateFromFilter').addEventListener('change', () => { leadsIspdFilters.sentDateFrom = $('leadsIspdSentDateFromFilter').value; renderIspdReviewTable(); });
$('leadsIspdSentDateToFilter').addEventListener('change', () => { leadsIspdFilters.sentDateTo = $('leadsIspdSentDateToFilter').value; renderIspdReviewTable(); });
$('leadsIspdDateFromFilter').addEventListener('change', () => { leadsIspdFilters.dateFrom = $('leadsIspdDateFromFilter').value; loadLeads(); });
$('leadsIspdDateToFilter').addEventListener('change', () => { leadsIspdFilters.dateTo = $('leadsIspdDateToFilter').value; loadLeads(); });

