// v290: staff visibility into still-unpaid campaign requests
// (client_campaign_payment_requests, status 'pending') -- these don't
// show up anywhere else for staff (nothing is created until payment
// completes, see finalizeCampaignSubscription). Lets staff generate a
// Stripe Checkout link to share with the client directly, same idea as
// the one-off charges "Get link" button.
async function loadPendingCampaignPayments(){
  const tbody = $('pendingCampaignPaymentsTbody');
  if(!tbody) return;
  const { data, error } = await sb.from('client_campaign_payment_requests')
    .select('id, campaign_name, caller_tier, dialer_choice, data_choice, created_at, client_accounts(full_name, company_name, email)')
    .eq('status', 'pending')
    .order('created_at', { ascending: false })
    .limit(200);
  if(error){
    tbody.innerHTML = `<tr><td colspan="8" style="color:var(--danger);">${escapeHtml(error.message)}</td></tr>`;
    return;
  }
  if(!data || !data.length){
    tbody.innerHTML = '<tr><td colspan="8" style="color:var(--text-dim);">No pending campaign payments.</td></tr>';
    return;
  }
  // v368: Get link used to render for anyone who could see this subtab at
  // all, with only the server (checkFinanceEditAccess in
  // staff-campaign-payment-link) actually blocking a view-only role -- a
  // clickable button that silently 403'd. Now gated the same conditional-
  // rendering way every other editable Finance subtab's write action is.
  const canGetLink = canEditFinanceSection('stripe_pending_payment');
  const pendingPaymentTz = nonAgentDisplayTz();
  tbody.innerHTML = data.map(r => `
    <tr>
      <td>${escapeHtml(r.campaign_name)}</td>
      <td>${escapeHtml((r.client_accounts && (r.client_accounts.company_name || r.client_accounts.full_name)) || '—')}</td>
      <td>${r.caller_tier === 'full_time' ? 'Full-time' : 'Part-time'}</td>
      <td>${r.dialer_choice === 'ours' ? 'Ours' : 'Own'}</td>
      <td>${r.data_choice === 'ours' ? 'Ours' : 'Own'}</td>
      <td class="mono">${new Date(r.created_at).toLocaleDateString([], pendingPaymentTz ? { timeZone: pendingPaymentTz } : {})}</td>
      <td>${canGetLink ? `<button class="btn-outline campaign-payment-link-btn" data-id="${r.id}" style="width:auto; padding:5px 10px; font-size:11px;">Get link</button>` : ''}</td>
      <td>${myIsOwner ? `<button class="btn-outline campaign-payment-delete-btn" data-id="${r.id}" style="width:auto; padding:5px 10px; font-size:11px; color:var(--danger);">Delete</button>` : ''}</td>
    </tr>`).join('');
}

if($('pendingCampaignPaymentsTbody')) $('pendingCampaignPaymentsTbody').addEventListener('click', async (e) => {
  const linkBtn = e.target.closest('.campaign-payment-link-btn');
  if(linkBtn){
    linkBtn.disabled = true;
    const originalText = linkBtn.textContent;
    linkBtn.textContent = 'Generating…';
    const { data, error } = await sb.functions.invoke('staff-campaign-payment-link', { body: { pendingRequestId: linkBtn.dataset.id } });
    linkBtn.disabled = false;
    linkBtn.textContent = originalText;
    if(error || !data || data.ok === false || (!data.checkoutUrl && !data.attachedToExisting)){
      alert((data && data.error) || (error && error.message) || 'Failed to generate a payment link.');
      return;
    }
    // v339: this client already had an active subscription, so the
    // campaign was attached directly onto it (charged immediately) instead
    // of a Checkout link being generated at all -- nothing to copy/share.
    if(data.attachedToExisting){
      alert(data.billingWarning
        ? `Campaign attached to the client's existing subscription, but the billing charge failed: ${data.billingWarning}\n\nAdded as a pending charge the client can pay from their own Billing → Pending payment tab.`
        : "Campaign attached to the client's existing subscription and charged immediately — no payment link needed.");
      loadPendingCampaignPayments();
      return;
    }
    try { await navigator.clipboard.writeText(data.checkoutUrl); } catch {}
    prompt('Payment link (copied to clipboard if your browser allowed it) — share this with the client:', data.checkoutUrl);
    return;
  }

  // v290: Owner-only -- deletes the pending request record itself
  // (client_campaign_payment_requests), e.g. to clean up an abandoned
  // request. Does not touch Stripe.
  const deleteBtn = e.target.closest('.campaign-payment-delete-btn');
  if(deleteBtn){
    if(!confirm('Delete this pending campaign request permanently? This only removes the request record — it does not affect Stripe.')) return;
    deleteBtn.disabled = true;
    const { error } = await sb.from('client_campaign_payment_requests').delete().eq('id', deleteBtn.dataset.id);
    if(error){
      alert('Failed to delete: ' + error.message);
      deleteBtn.disabled = false;
      return;
    }
    loadPendingCampaignPayments();
  }
});

async function initCampaignResourcesSection(){
  $('campaignResourcesAddWrap').style.display = campaignResourcesCanManage() ? '' : 'none';
  if(!campaignResourcesInitialized){
    campaignResourcesInitialized = true;
    // Staff-only picker — deliberately does NOT filter on is_active or
    // exclude ISPD_DEFAULT_CAMPAIGN_NAME ('PrimeHome Buyers') the way
    // client-facing pickers do (see renderClientGuideCheckboxes()).
    // PrimeHome Buyers itself has is_active = false (it's the internal
    // purchased-list pipeline, not a normal client-facing form) — this is
    // exactly the motivating case for this feature, so an is_active filter
    // would silently hide it, same bug either way.
    // BUG FIX (2026-08-14, user request): DOES exclude the "Ticket" form
    // itself though, same convention as openTicketAcceptModal's own
    // campaign list and wireCampaignNameAutocompletes -- Ticket is just a
    // routing form that redirects to a real campaign, not a campaign staff
    // would ever attach resources (call scripts, QA standards) to
    // directly.
    const { data } = await sb.from('lead_submission_forms').select('id, name').order('sort_order').order('name');
    const sel = $('campaignResourcesSelect');
    sel.innerHTML = '<option value="">Select a campaign…</option>' + (data || [])
      .filter(f => f.name !== TICKET_FORM_NAME)
      .map(f => `<option value="${escapeHtml(csubNormalizeLabel(f.name))}" data-display="${escapeHtml(f.name)}">${escapeHtml(f.name)}</option>`).join('');
    sel.addEventListener('change', () => {
      campaignResourcesSelectedNorm = sel.value;
      loadCampaignResourcesList();
    });
  }
  loadCampaignResourcesList();
}

let campaignResourcesCache = [];
async function loadCampaignResourcesList(){
  const listEl = $('campaignResourcesList');
  if(!campaignResourcesSelectedNorm){ listEl.innerHTML = ''; return; }
  listEl.innerHTML = '<div class="empty">Loading…</div>';
  const { data, error } = await sb.from('campaign_resources').select('*').eq('campaign_norm_name', campaignResourcesSelectedNorm).order('title');
  if(error){ listEl.innerHTML = '<div class="empty">Couldn’t load resources.</div>'; return; }
  campaignResourcesCache = data || [];
  renderCampaignResourcesList();
}
function renderCampaignResourcesList(){
  const listEl = $('campaignResourcesList');
  if(!campaignResourcesCache.length){ listEl.innerHTML = '<div class="empty">No resources yet for this campaign.</div>'; return; }
  const canManage = campaignResourcesCanManage();
  listEl.innerHTML = campaignResourcesCache.map(r => `
    <div class="card" style="margin-bottom:10px;" data-resource-id="${r.id}">
      <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:10px;">
        <h4 style="margin:0 0 8px;">${escapeHtml(r.title)}</h4>
        ${canManage ? `<button class="btn-secondary campaign-resource-edit-btn" style="width:auto; padding:6px 12px; flex-shrink:0;" data-id="${r.id}">Edit</button>` : ''}
      </div>
      <div style="white-space:pre-wrap; font-size:12px; color:var(--text-dim); line-height:1.6;">${escapeHtml(r.body)}</div>
    </div>
  `).join('');
  listEl.querySelectorAll('.campaign-resource-edit-btn').forEach(btn => {
    btn.addEventListener('click', () => openCampaignResourceForm(btn.dataset.id));
  });
}

function openCampaignResourceForm(id){
  campaignResourcesEditingId = id || null;
  const r = id ? campaignResourcesCache.find(x => x.id === id) : null;
  $('campaignResourceFormTitle').textContent = r ? 'Edit resource' : 'Add resource';
  $('campaignResourceTitleInput').value = r ? r.title : '';
  $('campaignResourceBodyInput').value = r ? r.body : '';
  $('campaignResourceDeleteBtn').style.display = r ? '' : 'none';
  $('campaignResourceFormMsg').style.display = 'none';
  $('campaignResourceFormOverlay').style.display = 'flex';
}
function closeCampaignResourceForm(){
  $('campaignResourceFormOverlay').style.display = 'none';
  campaignResourcesEditingId = null;
}
$('campaignResourcesAddBtn').addEventListener('click', () => openCampaignResourceForm(null));
$('campaignResourceCancelBtn').addEventListener('click', closeCampaignResourceForm);
$('campaignResourceFormOverlay').addEventListener('click', (e) => { if(e.target === $('campaignResourceFormOverlay')) closeCampaignResourceForm(); });

$('campaignResourceSaveBtn').addEventListener('click', async () => {
  const msg = $('campaignResourceFormMsg');
  const title = $('campaignResourceTitleInput').value.trim();
  const body = $('campaignResourceBodyInput').value.trim();
  if(!title || !body){ msg.textContent = 'Title and body are both required.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }
  const sel = $('campaignResourcesSelect');
  const displayName = sel.selectedOptions[0] ? sel.selectedOptions[0].dataset.display : campaignResourcesSelectedNorm;
  const { data: { user } } = await sb.auth.getUser();
  const payload = {
    campaign_norm_name: campaignResourcesSelectedNorm,
    campaign_display_name: displayName,
    title, body,
    updated_by: user ? user.id : null,
  };
  let error;
  if(campaignResourcesEditingId){
    ({ error } = await sb.from('campaign_resources').update(payload).eq('id', campaignResourcesEditingId));
  } else {
    ({ error } = await sb.from('campaign_resources').insert({ ...payload, created_by: user ? user.id : null }));
  }
  if(error){ msg.textContent = error.message; msg.className = 'msg error'; msg.style.display = 'block'; return; }
  closeCampaignResourceForm();
  loadCampaignResourcesList();
});
$('campaignResourceDeleteBtn').addEventListener('click', async () => {
  if(!campaignResourcesEditingId) return;
  if(!confirm('Delete this resource? This cannot be undone.')) return;
  const { error } = await sb.from('campaign_resources').delete().eq('id', campaignResourcesEditingId);
  if(error){ const msg = $('campaignResourceFormMsg'); msg.textContent = error.message; msg.className = 'msg error'; msg.style.display = 'block'; return; }
  closeCampaignResourceForm();
  loadCampaignResourcesList();
});

// v97: turns a Campaign Guide field's label into a usable field_key for a
// brand-new lead_submission_form_fields row — lowercased, punctuation
// stripped (reusing csubNormalizeLabel's word-only normalization), spaces
// to underscores, capped to a sane length.
function csubSlugifyFieldKey(label){
  return (csubNormalizeLabel(label).replace(/\s+/g, '_').slice(0, 60)) || 'field';
}

// ---------------------------------------------------------------------------
// v112: pending Campaign Guide edits proposed from the Client Portal
// (client_campaign_guide_access + campaign_guide_edit_requests) — an
// Owner/Admin/Custom Role with Leads-tab edit access approves (applied
// onto campaign_guide_overrides, same shape/upsert Campaign Guide's own
// Save already uses) or rejects (left as a record, guide unchanged).
// ---------------------------------------------------------------------------
let cgPendingEditRequests = [];
async function loadCampaignGuideEditRequests(){
  const { data, error } = await sb.from('campaign_guide_edit_requests')
    .select('id, campaign_norm_name, campaign_display_name, client_id, proposed_fields, note, created_at, client_accounts(full_name, company_name)')
    .eq('status', 'pending').order('created_at', { ascending: false });
  if(error){ console.error('Failed to load Campaign Guide edit requests', error); return; }
  cgPendingEditRequests = data || [];
  const card = $('cgEditRequestsCard');
  if(card) card.style.display = cgPendingEditRequests.length ? '' : 'none';
  renderCampaignGuideEditRequests();
}

// v217: diffs a pending edit request's proposed_fields against the
// campaign's CURRENT guide (campaignGuides, already loaded alongside this
// list — see loadCampaignGuide()) so staff can see at a glance which
// fields the client actually touched instead of having to compare every
// chip by eye against whatever the guide currently says. Matched by
// normLabel, same key both proposed_fields and campaignGuides[...].fields
// already use everywhere else in this file.
function campaignGuideEditRequestDiff(r){
  const existing = campaignGuides[r.campaign_norm_name];
  const existingByNorm = new Map((existing ? existing.fields : []).map(f => [f.normLabel, f.value]));
  const proposedNormLabels = new Set((r.proposed_fields || []).map(f => f.normLabel));
  const proposed = (r.proposed_fields || []).map(f => {
    if(!existingByNorm.has(f.normLabel)) return { ...f, change: 'added' };
    if(String(existingByNorm.get(f.normLabel)) !== String(f.value)) return { ...f, change: 'changed', oldValue: existingByNorm.get(f.normLabel) };
    return { ...f, change: 'unchanged' };
  });
  const removed = (existing ? existing.fields : []).filter(f => !proposedNormLabels.has(f.normLabel));
  return { proposed, removed };
}
function renderCampaignGuideEditRequests(){
  const listEl = $('cgEditRequestsList');
  if(!listEl) return;
  if(!cgPendingEditRequests.length){ listEl.innerHTML = ''; return; }
  listEl.innerHTML = '';
  const CHANGE_META = {
    added: { border: 'var(--good)', bg: 'var(--good)', label: 'New' },
    changed: { border: 'var(--focus)', bg: 'var(--focus)', label: 'Edited' },
    unchanged: null,
  };
  cgPendingEditRequests.forEach(r => {
    const client = r.client_accounts || {};
    const { proposed, removed } = campaignGuideEditRequestDiff(r);
    const row = document.createElement('div');
    row.style.cssText = 'padding:10px 0; border-bottom:1px solid var(--border);';
    row.innerHTML = `
      <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
        <div style="flex:1; min-width:200px;">
          <span class="mono" style="font-size:13px; font-weight:700;">${escapeHtml(r.campaign_display_name)}</span>
          <span style="font-size:11px; color:var(--text-dim); margin-left:8px;">${escapeHtml(client.company_name || client.full_name || 'Client')} · ${new Date(r.created_at).toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric', ...(nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {}) })}</span>
        </div>
        <button class="btn-secondary edit-only cg-req-reject-btn" style="width:auto; padding:6px 14px; font-size:11px;">Reject</button>
        <button class="btn-primary edit-only cg-req-approve-btn" style="width:auto; padding:6px 14px; font-size:11px; margin-top:0;">Approve</button>
      </div>
      <div style="margin-top:6px; display:flex; flex-wrap:wrap; gap:6px;">
        ${proposed.map(f => {
          const meta = CHANGE_META[f.change];
          const title = f.change === 'changed' ? ` title="Was: ${escapeHtml(String(f.oldValue))}"` : '';
          return meta
            ? `<span class="mono"${title} style="background:color-mix(in srgb, ${meta.bg} 14%, var(--inset)); border:1px solid ${meta.border}; border-radius:4px; padding:3px 8px; font-size:11px;"><span style="color:${meta.border}; font-weight:700; margin-right:4px;">${meta.label}</span>${escapeHtml(f.label)}: ${escapeHtml(String(f.value))}</span>`
            : `<span class="mono" style="background:var(--inset); border-radius:4px; padding:3px 8px; font-size:11px;">${escapeHtml(f.label)}: ${escapeHtml(String(f.value))}</span>`;
        }).join('') || '<span style="font-size:11px; color:var(--text-dim);">(no criteria left — this proposal clears the guide)</span>'}
        ${removed.map(f => `<span class="mono" style="background:color-mix(in srgb, var(--danger) 14%, var(--inset)); border:1px solid var(--danger); border-radius:4px; padding:3px 8px; font-size:11px; text-decoration:line-through; opacity:0.8;"><span style="color:var(--danger); font-weight:700; margin-right:4px; text-decoration:none;">Removed</span>${escapeHtml(f.label)}: ${escapeHtml(String(f.value))}</span>`).join('')}
      </div>
    `;
    row.querySelector('.cg-req-approve-btn').addEventListener('click', () => resolveCampaignGuideEditRequest(r, 'approved', row));
    row.querySelector('.cg-req-reject-btn').addEventListener('click', () => resolveCampaignGuideEditRequest(r, 'rejected', row));
    listEl.appendChild(row);
  });
  applyCsubSectionEditGating('campaign_guide');
}

async function resolveCampaignGuideEditRequest(request, outcome, row){
  const approveBtn = row ? row.querySelector('.cg-req-approve-btn') : null;
  const rejectBtn = row ? row.querySelector('.cg-req-reject-btn') : null;
  if(approveBtn && approveBtn.disabled) return;
  if(rejectBtn && rejectBtn.disabled) return;
  if(!confirm(outcome === 'approved'
    ? `Approve this edit? "${request.campaign_display_name}"'s guide will be updated to exactly what the client proposed.`
    : 'Reject this proposed edit? The guide stays unchanged.')) return;
  // LOW FIX (audit_chunk4.md #7): neither button disabled itself before the
  // network calls -- idempotent DB-wise, but a double-click (or clicking
  // Approve then Reject before the first resolves) could double-process
  // and produce duplicate logActivity entries.
  if(approveBtn) approveBtn.disabled = true;
  if(rejectBtn) rejectBtn.disabled = true;
  if(outcome === 'approved'){
    const { error: upsertErr } = await sb.from('campaign_guide_overrides').upsert({
      campaign_norm_name: request.campaign_norm_name,
      campaign_display_name: request.campaign_display_name,
      fields: request.proposed_fields || [],
      updated_by: myUserId,
      updated_at: new Date().toISOString(),
    }, { onConflict: 'campaign_norm_name' });
    if(upsertErr){ alert(upsertErr.message); if(approveBtn) approveBtn.disabled = false; if(rejectBtn) rejectBtn.disabled = false; return; }
  }
  const { error } = await sb.from('campaign_guide_edit_requests')
    .update({ status: outcome, reviewed_by: myUserId, reviewed_at: new Date().toISOString() })
    .eq('id', request.id);
  if(error){ alert(error.message); if(approveBtn) approveBtn.disabled = false; if(rejectBtn) rejectBtn.disabled = false; return; }
  logActivity('campaign_guide.edit_request_resolve', 'campaign_guide_edit_request', request.id, `${outcome === 'approved' ? 'Approved' : 'Rejected'} a client-proposed Campaign Guide edit — ${request.campaign_display_name}`);
  await loadCampaignGuide();
}

// v97: "Load from Campaign Guide" — the fix for a lead's own submission
// form having nothing in common with its campaign's Client Qualification
// Form criteria (which is why Campaign Match showed "—" for every lead on
// a form that only asked unrelated questions like ZIP code/City). Adds
// every one of that campaign's guide fields onto the target form, each
// marked required (these ARE the campaign's own criteria, so the cold
// caller should always ask them) — same skip-duplicates idea as
// sfLoadDefaultTemplateFinal, matched by normalized LABEL (not field_key,
// since these are freshly generated keys with no natural key to match
// against yet).
async function sfLoadFromCampaignGuide(formId, campaignNormName, fieldsContainer, msgEl){
  const guide = campaignGuides[campaignNormName];
  if(!guide){ msgEl.textContent = 'Pick a campaign first.'; msgEl.className = 'msg sf-form-guide-msg error'; return; }
  if(!confirm(`Add every criteria field from "${guide.displayName}"\u2019s Campaign Guide to this form, marked required? Fields already on this form (matched by label) are left as-is; duplicates are skipped.`)) return;
  const existing = sfFormFieldsCache[formId] || [];
  const existingNormLabels = new Set(existing.map(f => csubNormalizeLabel(f.label)));
  const existingKeys = new Set(existing.map(f => f.field_key));
  let sortOrder = existing.reduce((m, f) => Math.max(m, f.sort_order), -10) + 10;
  let added = 0, skipped = 0;
  for(const gf of guide.fields){
    if(existingNormLabels.has(gf.normLabel)){ skipped++; continue; }
    let key = csubSlugifyFieldKey(gf.label);
    let suffix = 1;
    while(existingKeys.has(key)) key = `${csubSlugifyFieldKey(gf.label)}_${++suffix}`;
    const { error } = await sb.from('lead_submission_form_fields').insert({
      form_id: formId, field_key: key, label: gf.label, field_type: 'text', required: true, sort_order: sortOrder,
    });
    sortOrder += 10;
    if(!error){ added++; existingKeys.add(key); existingNormLabels.add(gf.normLabel); } else skipped++;
  }
  logActivity('lead_submission_form_field.bulk_load_campaign_guide', null, null, `Loaded the "${guide.displayName}" Campaign Guide field set onto a submission form (${added} added, ${skipped} skipped)`);
  msgEl.textContent = `Added ${added} field(s)${skipped ? `, skipped ${skipped} (already present or failed)` : ''}.`;
  msgEl.className = 'msg';
  await loadSfFormsAndFields();
  renderSfFormFieldsList(formId, fieldsContainer);
  renderFillFormOptions(); renderFillFields();
}

let campaignGuideFilterText = '';

// v100: Campaign Guide editing. Was previously a pure read-only reflection
// of whatever the client answered on their Client Qualification Form —
// now a reviewer can correct/extend it directly (e.g. the client's wording
// was ambiguous, or a criterion needs adding that the client never asked
// about). Edits are per-campaign drafts held here while a card is in edit
// mode; Save persists them to campaign_guide_overrides (see loadCampaignGuide's
// merge step), Cancel discards the draft, Reset to auto deletes the
// override and reverts to the live-derived guide.
let campaignGuideEditDrafts = {}; // normName -> { displayName, fields: [{ label, value }] }

function renderCampaignGuideList(){
  const listEl = $('campaignGuideList');
  if(!listEl) return;
  let entries = Object.entries(campaignGuides).map(([normName, g]) => ({ normName, ...g }))
    .sort((a, b) => a.displayName.localeCompare(b.displayName));
  if(campaignGuideFilterText){
    entries = entries.filter(g => g.displayName.toLowerCase().includes(campaignGuideFilterText.toLowerCase()));
  }
  if(!entries.length){
    listEl.innerHTML = campaignGuideFilterText
      ? '<div class="empty">No campaigns match that search.</div>'
      : '<div class="empty">No Client Qualification Form submissions with a Campaign Name yet — once a client submits one, its campaign shows up here automatically.</div>';
    return;
  }
  listEl.innerHTML = '';
  entries.forEach(g => listEl.appendChild(buildCampaignGuideCard(g)));
  applyCsubSectionEditGating('campaign_guide');
  // v196: deleting a Campaign Guide override is a step further than
  // ordinary edit access (which any role can be granted per-section) —
  // restricted to Owner/Admin only, same marker class already used for
  // Export/Download everywhere else in Leads.
  applyOwnerAdminExportGating(listEl);
}

// v763: an "Other industry" campaign is one whose submission carried the
// industry / data-criteria / market-coverage answers instead of the fixed
// real-estate questionnaire. Those three are also the only input the AI
// drafter has, so their presence is exactly the condition for offering it.
function cgOtherIndustrySource(g){
  const pick = (needle) => {
    const f = (g.fields || []).find(x =>
      csubNormalizeLabel(x.label).indexOf(csubNormalizeLabel(needle)) === 0);
    return f ? String(f.value == null ? '' : f.value).trim() : '';
  };
  const industry = pick('Industry');
  const dataCriteria = pick('Data Criteria');
  const marketCoverage = pick('Market Coverage');
  if(!industry && !dataCriteria && !marketCoverage) return null;
  return { industry, dataCriteria, marketCoverage };
}
function buildCampaignGuideCard(g){
  const card = document.createElement('div');
  card.className = 'card';
  card.style.marginBottom = '12px';
  const editing = !!campaignGuideEditDrafts[g.normName];

  if(editing){
    const draft = campaignGuideEditDrafts[g.normName];
    const header = document.createElement('div');
    header.style.cssText = 'display:flex; align-items:center; gap:10px; margin-bottom:10px; flex-wrap:wrap;';
    header.innerHTML = `
      <span class="mono" style="font-size:13px; font-weight:700; flex:1;">${escapeHtml(g.displayName)}</span>
      <span style="font-size:10px; color:var(--text-dim);">Editing</span>
    `;
    card.appendChild(header);

    const fieldsWrap = document.createElement('div');
    draft.fields.forEach((f, i) => {
      const row = document.createElement('div');
      row.style.cssText = 'display:flex; gap:8px; padding:5px 0; border-top:1px solid var(--border); align-items:center; flex-wrap:wrap;';
      row.innerHTML = `
        <input type="text" class="cg-field-label" value="${escapeHtml(f.label)}" placeholder="Criterion label" style="flex:1; min-width:180px; padding:5px 8px; font-size:11px;">
        <input type="text" class="cg-field-value" value="${escapeHtml(String(f.value == null ? '' : f.value))}" placeholder="Expected value" style="flex:1; min-width:180px; padding:5px 8px; font-size:11px;">
        <button class="cg-field-del-btn" title="Remove criterion" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:14px;">×</button>
      `;
      row.querySelector('.cg-field-label').addEventListener('input', (e) => { draft.fields[i].label = e.target.value; });
      row.querySelector('.cg-field-value').addEventListener('input', (e) => { draft.fields[i].value = e.target.value; });
      row.querySelector('.cg-field-del-btn').addEventListener('click', () => {
        draft.fields.splice(i, 1);
        renderCampaignGuideList();
      });
      fieldsWrap.appendChild(row);
    });
    if(!draft.fields.length){
      const empty = document.createElement('div');
      empty.className = 'empty';
      empty.style.padding = '8px 0';
      empty.textContent = 'No criteria yet — add one below.';
      fieldsWrap.appendChild(empty);
    }
    card.appendChild(fieldsWrap);

    const addRow = document.createElement('div');
    addRow.style.cssText = 'margin-top:10px;';
    addRow.innerHTML = `<button class="btn-secondary cg-add-field-btn" style="width:auto; padding:6px 14px; font-size:11px;">+ Add criterion</button>`;
    addRow.querySelector('.cg-add-field-btn').addEventListener('click', () => {
      draft.fields.push({ label: '', value: '' });
      renderCampaignGuideList();
    });
    card.appendChild(addRow);

    const msg = document.createElement('div');
    msg.className = 'msg';
    card.appendChild(msg);

    const actions = document.createElement('div');
    actions.style.cssText = 'display:flex; gap:8px; margin-top:10px; justify-content:flex-end;';
    actions.innerHTML = `
      <button class="btn-secondary cg-cancel-btn" style="width:auto; padding:8px 16px;">Cancel</button>
      <button class="btn-primary cg-save-btn" style="width:auto; padding:8px 16px; margin-top:0;">Save</button>
    `;
    actions.querySelector('.cg-cancel-btn').addEventListener('click', () => {
      delete campaignGuideEditDrafts[g.normName];
      renderCampaignGuideList();
    });
    actions.querySelector('.cg-save-btn').addEventListener('click', async () => {
      const cleanFields = draft.fields
        .map(f => ({ label: (f.label || '').trim(), value: (f.value == null ? '' : String(f.value)).trim() }))
        .filter(f => f.label);
      if(!cleanFields.length){
        msg.textContent = 'Add at least one criterion with a label before saving.';
        msg.className = 'msg error';
        return;
      }
      const payload = {
        campaign_norm_name: g.normName,
        campaign_display_name: g.displayName,
        fields: cleanFields.map(f => ({ normLabel: csubNormalizeLabel(f.label), label: f.label, value: f.value })),
        updated_by: myUserId,
        updated_at: new Date().toISOString(),
      };
      const { error } = await sb.from('campaign_guide_overrides').upsert(payload, { onConflict: 'campaign_norm_name' });
      if(error){ msg.textContent = error.message; msg.className = 'msg error'; return; }
      logActivity('campaign_guide_override.save', null, null, `Edited the Campaign Guide for "${g.displayName}"`);
      delete campaignGuideEditDrafts[g.normName];
      await loadCampaignGuide();
    });
    card.appendChild(actions);
    return card;
  }

  const header = document.createElement('div');
  header.style.cssText = 'display:flex; align-items:center; gap:10px; margin-bottom:10px; flex-wrap:wrap;';
  header.innerHTML = `
    <span class="mono" style="font-size:13px; font-weight:700; flex:1;">${escapeHtml(g.displayName)}</span>
    ${g.overridden ? '<span style="font-size:10px; color:var(--focus);">Manually edited</span>' : ''}
    ${g.aiDraft ? '<span style="font-size:10px; color:var(--away); font-weight:700;">&#9888; AI draft &mdash; not yet reviewed</span>' : ''}
    <span style="font-size:10px; color:var(--text-dim);">${g.overridden ? 'Last edited' : 'From submission'}: ${new Date(g.overridden ? g.overrideUpdatedAt : g.submittedAt).toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric', ...(nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {}) })}</span>
    <button class="edit-only btn-secondary cg-edit-btn" style="width:auto; padding:6px 14px; font-size:11px;">Edit</button>
    ${cgOtherIndustrySource(g) ? '<button class="edit-only btn-secondary cg-ai-btn" style="width:auto; padding:6px 14px; font-size:11px;">' + (g.aiDraft ? 'Regenerate with AI' : 'Generate with AI') + '</button>' : ''}
    ${g.aiDraft ? '<button class="edit-only btn-secondary cg-approve-btn" style="width:auto; padding:6px 14px; font-size:11px; color:var(--good); border-color:var(--good);">Approve</button>' : ''}
    ${g.overridden ? '<button class="edit-only owner-admin-export-only btn-secondary cg-reset-btn" style="width:auto; padding:6px 14px; font-size:11px;">Delete (reset to auto)</button>' : ''}
    ${myIsOwner ? '<button class="btn-secondary cg-delete-campaign-btn" style="width:auto; padding:6px 14px; font-size:11px; color:var(--danger); border-color:var(--danger);">Delete campaign</button>' : ''}
  `;
  // v763: approving clears the draft flag only -- the guide text itself is
  // whatever is in the table, edited or not. Reviewing IS the approval, so
  // there is no separate "publish" step to forget.
  // v763: writes a fresh AI draft over this campaign's guide. It always lands
  // as ai_draft = true, so regenerating an already-approved guide puts it back
  // into review rather than quietly changing what the floor works from.
  const aiBtn = header.querySelector('.cg-ai-btn');
  if(aiBtn) aiBtn.addEventListener('click', async () => {
    const src = cgOtherIndustrySource(g);
    if(!src) return;
    if(g.overridden && !g.aiDraft && !confirm(`"${g.displayName}" already has an approved guide. Replacing it with an AI draft puts it back into review until somebody approves it again. Continue?`)) return;
    const label = aiBtn.textContent;
    aiBtn.disabled = true; aiBtn.textContent = 'Writing…';
    const { data, error } = await sb.functions.invoke('campaign-guide-ai-draft', {
      body: { campaignNormName: g.normName, campaignDisplayName: g.displayName, ...src },
    });
    aiBtn.disabled = false; aiBtn.textContent = label;
    if(error || !data || data.ok === false){
      alert('Could not write the draft: ' + ((data && data.error) || (error && error.message) || 'unknown error'));
      return;
    }
    await loadCampaignGuide();
  });
  const approveBtn = header.querySelector('.cg-approve-btn');
  if(approveBtn) approveBtn.addEventListener('click', async () => {
    approveBtn.disabled = true;
    const { error } = await sb.from('campaign_guide_overrides')
      .update({ ai_draft: false, reviewed_by: myUserId, reviewed_at: new Date().toISOString() })
      .eq('campaign_norm_name', g.normName);
    approveBtn.disabled = false;
    if(error){ alert('Could not approve it: ' + error.message); return; }
    logActivity('campaign_guide_override.approve', null, null, `Approved the AI-drafted Campaign Guide for "${g.displayName}"`);
    await loadCampaignGuide();
  });
  header.querySelector('.cg-edit-btn').addEventListener('click', () => {
    campaignGuideEditDrafts[g.normName] = {
      displayName: g.displayName,
      fields: g.fields.map(f => ({ label: f.label, value: f.value })),
    };
    renderCampaignGuideList();
  });
  const resetBtn = header.querySelector('.cg-reset-btn');
  if(resetBtn){
    resetBtn.addEventListener('click', async () => {
      if(!confirm(`Reset "${g.displayName}" back to auto-derived from its Client Qualification Form submission? This discards your manual edits.`)) return;
      await sb.from('campaign_guide_overrides').delete().eq('campaign_norm_name', g.normName);
      logActivity('campaign_guide_override.delete', null, null, `Reset the Campaign Guide for "${g.displayName}" to auto-derived`);
      await loadCampaignGuide();
    });
  }
  // v282: Owner-only, permanently deletes the ENTIRE campaign record --
  // the underlying Client Qualification Form submission and (if this
  // campaign also has one) its Data Form submission, plus any manual
  // override -- not just this override/edit like "Delete (reset to
  // auto)" above. Same is_owner()-gated ghl_form_submissions delete
  // policy as All Queue's own Owner-only delete (v276), just reachable
  // right from the guide itself instead of having to go find the row
  // there.
  const deleteCampaignBtn = header.querySelector('.cg-delete-campaign-btn');
  if(deleteCampaignBtn){
    deleteCampaignBtn.addEventListener('click', async () => {
      // CRITICAL FIX (audit finding, dashboard pass): this delete never
      // checked for a live Stripe subscription behind the campaign it's
      // about to remove — unlike the Stripe
      // Subscription tab's own delete button (campaign-sub-delete-btn,
      // above), which explicitly warns "This does NOT cancel the live
      // Stripe subscription". Deleting the campaign record here (its form
      // submissions/guide override/access rows) leaves an active/past_due
      // client_campaign_subscriptions row completely orphaned — the
      // client keeps being billed for a campaign whose guide and form no
      // longer exist anywhere in the dashboard. Surfacing the same warning
      // here before the destructive delete, rather than after.
      const { data: liveSubs } = await sb.from('client_campaign_subscriptions')
        .select('status, is_complimentary').eq('campaign_display_name', g.displayName);
      const hasLiveStripeSub = (liveSubs || []).some(s => !s.is_complimentary && ['active', 'past_due'].includes(s.status));
      const stripeWarning = hasLiveStripeSub
        ? '\n\n⚠ This campaign still has a LIVE Stripe subscription. Deleting this record does NOT cancel it — the client will keep being billed for a campaign with no guide/form left behind it. Cancel the subscription first (client\'s Billing tab, or Finance → Stripe Subscription) unless you mean to leave it running.'
        : '';
      if(!confirm(`Permanently delete the entire "${g.displayName}" campaign record? This removes its Client Qualification Form / Data Form submission(s) and any manual edits. This can't be undone.${stripeWarning}`)) return;
      const ids = [g.submissionId, g.dataSubmissionId].filter(Boolean);
      if(ids.length){
        const { error } = await sb.from('ghl_form_submissions').delete().in('id', ids);
        if(error){ alert(error.message); return; }
      }
      await sb.from('campaign_guide_overrides').delete().eq('campaign_norm_name', g.normName);
      // v320: this used to leave client_campaign_guide_access rows
      // dangling forever -- any client previously granted this campaign's
      // guide kept seeing it in their own portal permanently, showing "No
      // criteria recorded yet." since the submission backing it was just
      // deleted above. Also sweeps client_campaign_access in case a
      // lead_submission_forms row with the same name still exists (a
      // separate table from the ghl_form_submissions rows deleted above —
      // see the "+ New Campaign" flow, which creates both).
      await sb.from('client_campaign_guide_access').delete().eq('campaign_norm_name', g.normName);
      const { data: matchingForms } = await sb.from('lead_submission_forms').select('id').eq('name', g.displayName);
      if(matchingForms && matchingForms.length){
        await sb.from('client_campaign_access').delete().in('form_id', matchingForms.map(f => f.id));
      }
      logActivity('campaign_guide.delete', null, null, `Deleted the entire "${g.displayName}" campaign record`);
      await loadCampaignGuide();
    });
  }
  card.appendChild(header);

  card.appendChild(buildCampaignGuideDocument(g));
  return card;
}

// v101: short, human phrasing for the Caller Talking Points / Quick-
// Reference Checklist below — keyed by `kind` where a field's evaluation
// rule already gives us something specific to say; anything without a kind
// (a client's own custom question) falls back to a plain "label: value"
// line so it's never silently dropped from the synthesized sections.
function campaignGuideTalkingPoint(f, meta){
  const v = String(f.value == null ? '' : f.value).trim();
  switch(meta.kind){
    case 'geo': return `Confirm the property is located in the target area: ${v}.`;
    case 'listing_status': return /^\s*yes\b/i.test(v)
      ? 'Listed properties are accepted here too — no off-market requirement.'
      : 'Confirm the property is off-market (not currently listed with a realtor/on the MLS).';
    case 'valid_reason': return (/valid\s*reason/i.test(v) && !/accept\s*(any|leads)/i.test(v))
      ? "Ask why they're considering selling — a valid reason/motivation is the priority; if none is given, keep going as long as they're cooperative and forthcoming with property details."
      : 'Any motivated seller is acceptable here, even with no stated reason for selling.';
    case 'must_capture': return `Ask for their ${meta.checklistText ? meta.checklistText.replace(/ has been captured$/i, '') : f.label}.`;
    case 'max_days': return `Let the seller know closing can happen within ${v || 'the agreed timeframe'}.`;
    case 'price_restriction': return /^none/i.test(v) || !v ? null : `Note the price restriction: ${v}.`;
    case 'mv_pricing': return `Ask about pricing expectations relative to market value: ${v}.`;
    case 'referral': return /^\s*yes\b/i.test(v) ? `Referrals from outside the primary target area are accepted (${v}).` : null;
    default: return meta.informational ? null : `Confirm: ${f.label} — expected: ${v}.`;
  }
}
function campaignGuideChecklistLine(f, meta){
  const v = String(f.value == null ? '' : f.value).trim();
  switch(meta.kind){
    case 'geo': return `Property is in the target area (${v})`;
    case 'listing_status': return /^\s*yes\b/i.test(v) ? 'Listed or off-market properties both acceptable' : 'Property is off-market (not listed at all)';
    case 'valid_reason': return (/valid\s*reason/i.test(v) && !/accept\s*(any|leads)/i.test(v))
      ? 'Seller has a valid reason to sell OR is cooperative with no reason stated'
      : 'Any motivated seller is acceptable';
    case 'max_days': return `Closing timeframe is within ${v || 'the agreed limit'}`;
    case 'must_capture': return meta.checklistText || `${f.label} has been captured`;
    case 'price_restriction': return (/^none/i.test(v) || !v) ? null : `Meets stated price restriction: ${v}`;
    default: return meta.informational ? null : `${f.label}: ${v}`;
  }
}

// v101: builds the structured, document-style read view of a campaign's
// guide — grouped into the same sections a manually-written guide uses
// (Target Market / Seller Qualification / Property Criteria / Pricing &
// Deal Terms / Referral Policy), plus synthesized Caller Talking Points and
// a Quick-Reference Lead Checklist derived from the parsed criteria. A
// field whose guide answer looks ambiguous for how it's evaluated (e.g. a
// max-days question answered "Yes" instead of a number) gets a warning
// callout instead of being silently guessed at.
function buildCampaignGuideDocument(g){
  const wrap = document.createElement('div');
  if(!g.fields.length){
    wrap.innerHTML = '<div class="empty">No criteria fields yet — click Edit to add some.</div>';
    return wrap;
  }
  const bySection = {};
  const ambiguous = [];
  g.fields.forEach(f => {
    const meta = campaignGuideFieldMeta(f.normLabel);
    (bySection[meta.section] ||= []).push({ f, meta });
    if(campaignGuideFieldIsAmbiguous(meta, f.value)) ambiguous.push(f);
  });

  const sectionOrder = ['target_market', 'seller_qualification', 'property_criteria', 'pricing_terms', 'referral_policy', 'other'];
  const sectionsHtml = sectionOrder.filter(s => bySection[s] && bySection[s].length).map(s => `
    <div style="margin-top:14px;">
      <h4 class="mono" style="font-size:10px; color:var(--text-2); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;">${CAMPAIGN_GUIDE_SECTION_LABELS[s]}</h4>
      ${bySection[s].map(({ f, meta }) => `
        <div style="display:flex; gap:16px; padding:5px 0; border-top:1px solid var(--border); flex-wrap:wrap;">
          <span style="min-width:280px; font-size:11px; color:var(--text-dim);">${escapeHtml(f.label)}${meta.informational ? ' <span style="opacity:0.7;">(reference)</span>' : ''}</span>
          <span style="font-size:12px; color:var(--text);">${escapeHtml(String(f.value))}</span>
        </div>
      `).join('')}
    </div>
  `).join('');
  wrap.innerHTML = sectionsHtml;

  if(ambiguous.length){
    const warn = document.createElement('div');
    warn.className = 'msg error';
    warn.style.cssText = 'margin-top:12px;';
    warn.textContent = `⚠ Needs confirmation with the client: ${ambiguous.map(f => `"${f.label}" answered "${f.value}" (expected a number)`).join('; ')}. Auto-evaluation for these falls back to manual review / learned keywords until this is clarified.`;
    wrap.appendChild(warn);
  }

  const talkingPoints = g.fields.map(f => campaignGuideTalkingPoint(f, campaignGuideFieldMeta(f.normLabel))).filter(Boolean);
  if(talkingPoints.length){
    const tp = document.createElement('div');
    tp.style.cssText = 'margin-top:14px;';
    tp.innerHTML = `
      <h4 class="mono" style="font-size:10px; color:var(--text-2); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;">Caller Talking Points</h4>
      <ul style="margin:0; padding-left:18px; font-size:12px; color:var(--text); line-height:1.7;">
        ${talkingPoints.map(t => `<li>${escapeHtml(t)}</li>`).join('')}
      </ul>
    `;
    wrap.appendChild(tp);
  }

  const checklist = g.fields.map(f => campaignGuideChecklistLine(f, campaignGuideFieldMeta(f.normLabel))).filter(Boolean);
  if(checklist.length){
    const cl = document.createElement('div');
    cl.style.cssText = 'margin-top:14px;';
    cl.innerHTML = `
      <h4 class="mono" style="font-size:10px; color:var(--text-2); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;">Quick-Reference Lead Checklist</h4>
      <ul style="margin:0; padding-left:18px; font-size:12px; color:var(--text); line-height:1.7;">
        ${checklist.map(c => `<li>${escapeHtml(c)}</li>`).join('')}
      </ul>
    `;
    wrap.appendChild(cl);
  }
  return wrap;
}

// ---------------------------------------------------------------------------
// v104: Leads Dispute — a client disputing specific fields on one of their
// accepted leads (raised from the Client Portal), with a two-way comment
// thread here. Accept -> the underlying lead is marked rejected (which
// removes it from the client's portal view entirely, via the existing
// status='accepted'-only RLS policy on leads). Reject -> the dispute is
// closed and the lead's own status is left completely untouched.
// ---------------------------------------------------------------------------
let disputesCache = [];
let disputeFormNameById = {};
let disputeMessagesCache = {}; // dispute_id -> messages array, loaded on demand
let disputeExpandedId = null;

// v717: Client Communications -> Dispute/Feedback (moved out of Leads; see
// the tab-client_disputes markup). Same loader and edit gating as before,
// plus its own quick replies.
function initClientDisputesTab(){
  loadDisputesList();
  applyLeadsSectionEditGating('leads_dispute');
  disputeLoadQuickReplies();
}
// v717 (the owner: "quick replies like client chat, for dispute and feedback
// scenarios"). The same client_chat_quick_replies table, kind = 'dispute';
// owner/admin manage them through the same editor (ciOpenQrModal('dispute')).
let disputeQuickReplies = [];
async function disputeLoadQuickReplies(){
  const { data, error } = await sb.from('client_chat_quick_replies').select('id, title, body, sort').eq('kind', 'dispute').order('sort').order('title');
  if(error){ console.error('dispute quick replies load failed', error); return; }
  disputeQuickReplies = data || [];
}
function disputeFillPlaceholders(text, dispute){
  const client = dispute.client_accounts || {};
  const lead = dispute.leads || {};
  const first = String(client.full_name || '').trim().split(/\s+/)[0] || 'there';
  return String(text)
    .replaceAll('{client_name}', first)
    .replaceAll('{company}', client.company_name || 'your company')
    .replaceAll('{seller}', lead.seller_investor_name || 'this seller')
    .replaceAll('{my_name}', String(myFullName || '').trim().split(/\s+/)[0] || 'our team');
}
function disputeRenderQrMenu(menu, input, dispute){
  const items = disputeQuickReplies.map(q => `<button type="button" class="ci-qr-item" data-id="${escapeHtml(q.id)}"><span class="ci-qr-title">${escapeHtml(q.title)}</span><span class="ci-qr-body">${escapeHtml(q.body)}</span></button>`).join('');
  menu.innerHTML = (items || `<div class="ci-list-empty">No dispute replies yet.${ciIsAdmin() ? '' : ' An owner or admin can add them.'}</div>`)
    + (ciIsAdmin() ? '<button type="button" class="ci-qr-manage">Manage dispute replies\u2026</button>' : '');
  menu.querySelectorAll('.ci-qr-item').forEach(b => {
    b.onclick = (e) => {
      e.stopPropagation();
      const q = disputeQuickReplies.find(x => x.id === b.dataset.id);
      if(!q) return;
      const text = disputeFillPlaceholders(q.body, dispute);
      const st = input.selectionStart ?? input.value.length;
      const en = input.selectionEnd ?? input.value.length;
      input.value = input.value.slice(0, st) + text + input.value.slice(en);
      menu.classList.add('ci-hide');
      input.focus();
      input.selectionStart = input.selectionEnd = st + text.length;
    };
  });
  const mb = menu.querySelector('.ci-qr-manage');
  if(mb) mb.onclick = (e) => { e.stopPropagation(); menu.classList.add('ci-hide'); ciOpenQrModal('dispute'); };
}
document.addEventListener('click', (e) => {
  document.querySelectorAll('.dispute-qr-menu:not(.ci-hide)').forEach(m => { if(!m.parentElement.contains(e.target)) m.classList.add('ci-hide'); });
});

async function loadDisputesList(){
  const container = $('disputesList');
  if(container && !disputesCache.length) container.innerHTML = '<div class="empty">Loading…</div>';
  const statusFilter = $('disputeStatusFilter') ? $('disputeStatusFilter').value : 'open';
  const typeFilter = $('disputeTypeFilter') ? $('disputeTypeFilter').value : '';
  const dateFrom = $('disputeDateFromFilter') ? $('disputeDateFromFilter').value : '';
  const dateTo = $('disputeDateToFilter') ? $('disputeDateToFilter').value : '';
  let q = sb.from('lead_disputes')
    .select('id, lead_id, client_id, disputed_fields, status, type, created_at, updated_at, resolved_at, leads(seller_investor_name, seller_phone, submission_form_id), client_accounts(full_name, company_name)')
    .order('created_at', { ascending: false });
  if(statusFilter) q = q.eq('status', statusFilter);
  if(typeFilter) q = q.eq('type', typeFilter);
  // v113: From/To date range, matched against created_at (local calendar
  // day, inclusive both ends) — same idea as the date-range filters
  // elsewhere in Leads (Queue Review, Tickets Review).
  if(dateFrom){ const from = new Date(dateFrom); from.setHours(0,0,0,0); q = q.gte('created_at', from.toISOString()); }
  if(dateTo){ const to = new Date(dateTo); to.setHours(23,59,59,999); q = q.lte('created_at', to.toISOString()); }
  const { data, error } = await q;
  if(error){ if(container) container.innerHTML = `<div class="empty">${escapeHtml(error.message)}</div>`; return; }
  disputesCache = data || [];
  // v104: resolve campaign names independently of leadsFormNameFn, which
  // only gets populated once loadLeads() has actually run at least once
  // (Dashboard/Queue Review/PrimeHome Buyers) — an admin opening Leads
  // Dispute directly, without visiting one of those first, would
  // otherwise see every campaign name as "No campaign".
  const formIds = Array.from(new Set(disputesCache.map(d => d.leads && d.leads.submission_form_id).filter(Boolean)));
  if(formIds.length){
    const { data: forms } = await sb.from('lead_submission_forms').select('id, name').in('id', formIds);
    disputeFormNameById = {};
    (forms || []).forEach(f => { disputeFormNameById[f.id] = f.name; });
  }
  renderDisputesList();
}

function renderDisputesList(){
  const container = $('disputesList');
  if(!container) return;

  if($('disputesStatTotal')){
    $('disputesStatTotal').textContent = disputesCache.length;
    $('disputesStatDisputes').textContent = disputesCache.filter(d => d.type !== 'feedback').length;
    $('disputesStatFeedback').textContent = disputesCache.filter(d => d.type === 'feedback').length;
    $('disputesStatOpen').textContent = disputesCache.filter(d => d.status === 'open').length;
    $('disputesStatAccepted').textContent = disputesCache.filter(d => d.status === 'accepted').length;
    $('disputesStatRejected').textContent = disputesCache.filter(d => d.status === 'rejected').length;
  }

  if(!disputesCache.length){
    container.innerHTML = '<div class="empty">No disputes here.</div>';
    return;
  }
  container.innerHTML = '';
  disputesCache.forEach(d => container.appendChild(buildDisputeCard(d)));
}

function buildDisputeCard(d){
  const card = document.createElement('div');
  card.className = 'card';
  card.style.marginBottom = '14px';
  const lead = d.leads || {};
  const client = d.client_accounts || {};
  const isFeedback = d.type === 'feedback';
  const statusMeta = isFeedback
    ? {
        open: { label: 'Open', color: 'var(--away)' },
        accepted: { label: 'Closed', color: 'var(--text-dim)' },
        rejected: { label: 'Closed', color: 'var(--text-dim)' },
      }[d.status] || { label: d.status, color: 'var(--text-dim)' }
    : {
        open: { label: 'Open', color: 'var(--away)' },
        accepted: { label: 'Accepted — lead rejected', color: 'var(--danger)' },
        rejected: { label: 'Rejected — lead unchanged', color: 'var(--text-dim)' },
      }[d.status] || { label: d.status, color: 'var(--text-dim)' };
  const expanded = disputeExpandedId === d.id;
  const typeBadge = isFeedback
    ? `<span class="mono" style="font-size:10px; color:var(--focus); background:var(--focus-dim); border-radius:999px; padding:2px 9px; text-transform:uppercase; letter-spacing:.4px;">Feedback</span>`
    : `<span class="mono" style="font-size:10px; color:var(--danger); background:var(--danger-dim); border-radius:999px; padding:2px 9px; text-transform:uppercase; letter-spacing:.4px;">Dispute</span>`;

  const header = document.createElement('div');
  header.style.cssText = 'display:flex; align-items:center; gap:12px; flex-wrap:wrap;';
  header.innerHTML = `
    <div style="flex:1; min-width:200px;">
      <div class="mono" style="font-size:13px; font-weight:700;">${escapeHtml(lead.seller_investor_name || '—')} <span style="color:var(--text-dim); font-size:11px; font-weight:400;">${escapeHtml(lead.seller_phone || '')}</span> ${typeBadge}</div>
      <div style="font-size:11px; color:var(--text-dim); margin-top:2px;">${escapeHtml(disputeFormNameById[lead.submission_form_id] || 'No campaign')} · ${escapeHtml(client.company_name || client.full_name || 'Client')} · Opened ${new Date(d.created_at).toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric', ...(nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {}) })}</div>
    </div>
    <span class="mono" style="font-size:10px; color:${statusMeta.color}; text-transform:uppercase; letter-spacing:0.5px;">${statusMeta.label}</span>
    <button class="btn-secondary dispute-toggle-btn" style="width:auto; padding:6px 14px; font-size:11px;">${expanded ? 'Hide' : 'Open conversation'}</button>
  `;
  header.querySelector('.dispute-toggle-btn').addEventListener('click', () => {
    disputeExpandedId = expanded ? null : d.id;
    renderDisputesList();
  });
  card.appendChild(header);

  // v112: only a real 'dispute' names specific disputed fields — 'feedback'
  // is a free-text comment with no fields attached, so nothing to list
  // here (the comment itself is the first message in the thread below).
  if(!isFeedback){
    const fields = d.disputed_fields || [];
    const fieldsWrap = document.createElement('div');
    fieldsWrap.style.cssText = 'margin-top:8px; padding-top:8px; border-top:1px solid var(--border);';
    fieldsWrap.innerHTML = `<div style="font-size:11px; color:var(--text-dim); margin-bottom:4px;">Dispute reason:</div>` +
      fields.map(f => `<span class="mono" style="display:inline-block; background:var(--inset); border-radius:4px; padding:3px 8px; font-size:11px; margin:2px 4px 2px 0;">${escapeHtml(f.label || f.key)}</span>`).join('');
    card.appendChild(fieldsWrap);
  }

  if(expanded){
    const threadWrap = document.createElement('div');
    threadWrap.style.cssText = 'margin-top:12px; padding-top:12px; border-top:1px solid var(--border);';
    threadWrap.innerHTML = '<div class="empty">Loading conversation…</div>';
    card.appendChild(threadWrap);
    loadDisputeMessages(d.id).then(msgs => renderDisputeThread(threadWrap, d, msgs));
  }
  return card;
}

async function loadDisputeMessages(disputeId){
  const { data } = await sb.from('lead_dispute_messages')
    .select('id, sender_type, sender_client_id, sender_staff_id, message, created_at')
    .eq('dispute_id', disputeId).order('created_at');
  disputeMessagesCache[disputeId] = data || [];
  return disputeMessagesCache[disputeId];
}

function renderDisputeThread(container, dispute, messages){
  container.innerHTML = '';
  const list = document.createElement('div');
  list.style.cssText = 'display:flex; flex-direction:column; gap:8px; max-height:280px; overflow-y:auto; margin-bottom:10px;';
  if(!messages.length){
    list.innerHTML = '<div class="empty">No messages yet — the client\'s comment when they filed this is the first one, once they\'ve sent it.</div>';
  } else {
    messages.forEach(m => {
      const mine = m.sender_type === 'staff';
      const bubble = document.createElement('div');
      bubble.style.cssText = `max-width:80%; align-self:${mine ? 'flex-end' : 'flex-start'}; background:${mine ? 'var(--focus-dim)' : 'var(--inset)'}; border-radius:10px; padding:8px 12px; font-size:13px;`;
      bubble.innerHTML = `<div style="font-size:10px; color:var(--text-dim); margin-bottom:3px;">${mine ? 'Staff' : 'Client'} · ${new Date(m.created_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {}) })}</div>${escapeHtml(m.message)}`;
      list.appendChild(bubble);
    });
  }
  container.appendChild(list);

  if(dispute.status === 'open'){
    const replyRow = document.createElement('div');
    replyRow.className = 'edit-only';
    replyRow.style.cssText = 'display:flex; gap:8px; margin-bottom:10px;';
    replyRow.innerHTML = `
      <div class="ci-qr-wrap" style="align-self:flex-end;">
        <button type="button" class="ci-btn dispute-qr-btn" title="Insert a saved reply">Quick replies &#9662;</button>
        <div class="ci-qr-menu ci-hide dispute-qr-menu"></div>
      </div>
      <textarea class="dispute-reply-input" placeholder="Reply to the client…" style="flex:1; min-height:50px; padding:8px; font-size:12px;"></textarea>
      <button class="btn-secondary dispute-reply-btn" style="width:auto; align-self:flex-end; padding:8px 14px;">Send</button>
    `;
    // v717: quick replies for dispute / feedback threads.
    const qrMenu = replyRow.querySelector('.dispute-qr-menu');
    replyRow.querySelector('.dispute-qr-btn').addEventListener('click', async (e) => {
      e.stopPropagation();
      if(!qrMenu.classList.contains('ci-hide')){ qrMenu.classList.add('ci-hide'); return; }
      if(!disputeQuickReplies.length) await disputeLoadQuickReplies();
      disputeRenderQrMenu(qrMenu, replyRow.querySelector('.dispute-reply-input'), dispute);
      qrMenu.classList.remove('ci-hide');
    });
    replyRow.querySelector('.dispute-reply-btn').addEventListener('click', async () => {
      const btn = replyRow.querySelector('.dispute-reply-btn');
      if(btn.disabled) return;
      // v489: same gap as resolveDispute()/reopenDispute() above -- the
      // .edit-only class lives on replyRow (a <div>), never on this
      // <button> itself, so applyLeadsSectionEditGating()'s
      // `el.disabled = !editable` never actually reaches it (the button's
      // own `if(btn.disabled) return;` guard above was always false
      // regardless of permission). Direct check, same fix as its two
      // siblings.
      if(!canEditLeadsSection('leads_dispute')){ alert('Your role has view-only access to this section.'); return; }
      const textarea = replyRow.querySelector('.dispute-reply-input');
      const message = textarea.value.trim();
      if(!message) return;
      // LOW FIX (audit_chunk4.md #7): unlike nearly every other async write
      // button in this range, this one didn't disable itself before the
      // network call -- a double-click could insert a duplicate reply and
      // fire callSendClientSms (SMS/email to the client) twice.
      btn.disabled = true;
      btn.textContent = 'Sending…';
      const { error } = await sb.from('lead_dispute_messages').insert({ dispute_id: dispute.id, sender_type: 'staff', sender_staff_id: myUserId, message });
      if(error){ alert(error.message); btn.disabled = false; btn.textContent = 'Send'; return; }
      textarea.value = '';
      // v153: text the client that staff replied — same event either way,
      // just a different template for a dispute vs. a feedback thread
      // (see send-client-sms's buildMessage()).
      callSendClientSms(dispute.client_id, dispute.type === 'feedback' ? 'feedback_response' : 'dispute_response', null);
      logActivity('lead_dispute.reply', 'lead', dispute.lead_id, 'Replied to a lead dispute');
      const msgs = await loadDisputeMessages(dispute.id);
      renderDisputeThread(container, dispute, msgs);
    });
    container.appendChild(replyRow);

    const actionsRow = document.createElement('div');
    actionsRow.className = 'edit-only';
    actionsRow.style.cssText = 'display:flex; gap:8px; justify-content:flex-end; flex-wrap:wrap;';
    if(dispute.type === 'feedback'){
      // v112: feedback has no lead-status side effect — just closes the
      // conversation. Closing is staff-only (there's no client-facing
      // close action anywhere in the portal).
      actionsRow.innerHTML = `<button class="btn-primary dispute-accept-btn" style="width:auto; padding:8px 16px; margin-top:0;">Close feedback</button>`;
      actionsRow.querySelector('.dispute-accept-btn').addEventListener('click', () => resolveDispute(dispute, 'rejected'));
    } else {
      actionsRow.innerHTML = `
        <button class="btn-secondary dispute-reject-btn" style="width:auto; padding:8px 16px;">Reject dispute (keep lead accepted)</button>
        <button class="btn-primary dispute-accept-btn" style="width:auto; padding:8px 16px; margin-top:0;">Accept dispute (reject lead)</button>
      `;
      actionsRow.querySelector('.dispute-reject-btn').addEventListener('click', () => resolveDispute(dispute, 'rejected'));
      actionsRow.querySelector('.dispute-accept-btn').addEventListener('click', () => resolveDispute(dispute, 'accepted'));
    }
    container.appendChild(actionsRow);
  } else {
    const resolvedNote = document.createElement('div');
    resolvedNote.className = 'mono';
    resolvedNote.style.cssText = 'font-size:11px; color:var(--text-dim); margin-bottom:8px;';
    resolvedNote.textContent = dispute.type === 'feedback'
      ? 'This feedback thread is closed.'
      : (dispute.status === 'accepted'
        ? 'This dispute was accepted — the lead was marked rejected.'
        : 'This dispute was rejected — the lead remains accepted, unchanged.');
    container.appendChild(resolvedNote);
    // LOW FIX (audit_chunk4.md #6): every other one-way status flip in this
    // file has a matching undo (lead Accept -> "Recall", ticket
    // client-review push -> "Recall to Queue") -- Disputes/Feedback had
    // none, so a fat-fingered "Reject dispute"/"Close feedback" (one
    // generic confirm(), no per-action confirmation) was a workflow dead
    // end short of a direct DB edit. Reopens only the conversation itself
    // -- deliberately does NOT touch the lead's accept/reject status even
    // for an accepted dispute, since that's separately governed by the
    // leads_prevent_reaccept_rejected DB trigger and its own dedicated
    // recall flow, not something this should silently reach into.
    const reopenRow = document.createElement('div');
    reopenRow.className = 'edit-only';
    reopenRow.style.cssText = 'display:flex; justify-content:flex-end;';
    reopenRow.innerHTML = `<button class="btn-secondary dispute-reopen-btn" style="width:auto; padding:6px 14px; font-size:12px;">Reopen ${dispute.type === 'feedback' ? 'feedback' : 'dispute'}</button>`;
    reopenRow.querySelector('.dispute-reopen-btn').addEventListener('click', () => reopenDispute(dispute, container));
    container.appendChild(reopenRow);
  }
  applyLeadsSectionEditGating('leads_dispute');
}

async function reopenDispute(dispute, container){
  // v489: the actions row this button lives in only ever gets .edit-only
  // applied to its wrapping <div> (applyLeadsSectionEditGating('leads_dispute')
  // at the top of loadDisputesList()) -- setting .disabled on a <div> is a
  // no-op, so the row LOOKED dimmed for a view-only role but the button
  // inside it stayed fully clickable. Same class of gap this file's own
  // ispeedtolead attachment Delete button had (see the "audit_chunk5.md #3"
  // comment above) and was fixed the same way there: check
  // canEditLeadsSection() directly here as the real enforcement point,
  // rather than relying on a DOM property that silently does nothing on a
  // non-form-control element.
  if(!canEditLeadsSection('leads_dispute')){ alert('Your role has view-only access to this section.'); return; }
  const isFeedback = dispute.type === 'feedback';
  const note = !isFeedback && dispute.status === 'accepted'
    ? '\n\nNote: this does NOT change the lead’s status back to accepted — that lead was already marked rejected and stays that way unless recalled separately.'
    : '';
  if(!confirm(`Reopen this ${isFeedback ? 'feedback' : 'dispute'} thread so you can keep replying?${note}`)) return;
  const { error } = await sb.from('lead_disputes')
    .update({ status: 'open', resolved_at: null, resolved_by: null })
    .eq('id', dispute.id);
  if(error){ alert(error.message); return; }
  logActivity('lead_dispute.reopen', 'lead', dispute.lead_id, isFeedback ? 'Reopened a lead feedback thread' : 'Reopened a lead dispute');
  dispute.status = 'open';
  dispute.resolved_at = null;
  dispute.resolved_by = null;
  const msgs = await loadDisputeMessages(dispute.id);
  if(container) renderDisputeThread(container, dispute, msgs);
  await loadDisputesList();
}

async function resolveDispute(dispute, outcome){
  // v489: same gap/fix as reopenDispute() above -- the Close feedback/
  // Accept dispute/Reject dispute buttons sit inside a wrapping <div
  // class="edit-only">, which applyLeadsSectionEditGating() dims via
  // opacity but can't actually disable (.disabled has no effect on a
  // <div>), so a view-only role saw a raw RLS error instead of a clear
  // blocked message. Direct check, same as reopenDispute().
  if(!canEditLeadsSection('leads_dispute')){ alert('Your role has view-only access to this section.'); return; }
  const isFeedback = dispute.type === 'feedback';
  const verb = isFeedback
    ? 'close this feedback thread'
    : (outcome === 'accepted'
      ? 'accept this dispute and mark the lead REJECTED (it will disappear from the client\'s portal)'
      : 'reject this dispute and keep the lead accepted, unchanged');
  if(!confirm(`Are you sure you want to ${verb}? This closes the conversation.`)) return;
  const { error: disputeErr } = await sb.from('lead_disputes')
    .update({ status: outcome, resolved_at: new Date().toISOString(), resolved_by: myUserId })
    .eq('id', dispute.id);
  if(disputeErr){ alert(disputeErr.message); return; }
  if(!isFeedback && outcome === 'accepted'){
    const { error: leadErr } = await sb.from('leads')
      .update({ status: 'rejected', review_note: 'Rejected via client dispute' })
      .eq('id', dispute.lead_id);
    if(leadErr) alert(`Dispute marked accepted, but updating the lead failed: ${leadErr.message}`);
  }
  logActivity('lead_dispute.resolve', 'lead', dispute.lead_id, isFeedback ? 'Closed a lead feedback thread' : `${outcome === 'accepted' ? 'Accepted' : 'Rejected'} a lead dispute`);
  disputeExpandedId = null;
  await loadDisputesList();
  if(leadsFullData.length) loadLeads();
}

if($('disputeStatusFilter')) $('disputeStatusFilter').addEventListener('change', loadDisputesList);
if($('disputeTypeFilter')) $('disputeTypeFilter').addEventListener('change', loadDisputesList);
if($('disputeDateFromFilter')) $('disputeDateFromFilter').addEventListener('change', loadDisputesList);
if($('disputeDateToFilter')) $('disputeDateToFilter').addEventListener('change', loadDisputesList);

// Which campaign a lead belongs to, for guide matching — prefers a
// "Campaign Name" field the lead's OWN submission form actually asked for
// (the exact same concept Client Qualification Form uses); falls back to
// the lead's own campaign/form display name, for a setup where a form is
// named after the campaign directly (e.g. PrimeHome Buyers) instead of
// asking a dedicated Campaign Name question.
function leadsCampaignNameFor(lead){
  const entries = leadsExtraFieldsEntriesFn(lead.task_id, lead.submission_form_id, lead.extra_fields) || [];
  const campaignEntry = entries.find(e => csubNormalizeLabel(e.label) === csubNormalizeLabel('Campaign Name'));
  if(campaignEntry && String(campaignEntry.value || '').trim()) return String(campaignEntry.value).trim();
  const formName = leadsFormNameFn(lead.submission_form_id);
  return (formName && formName !== 'No campaign') ? formName : '';
}

// Exact match (case/whitespace-insensitive) for most fields. A lightweight
// numeric-range heuristic kicks in for price/timeline-ish fields (label
// mentions price/timeline/closing/cap/budget) — extracts the first number
// in each value and passes if the lead's number doesn't exceed the
// campaign's; falls back to exact match if either side has no extractable
// number.
function campaignGuideFieldPasses(expectedValue, actualValue, normLabel){
  const norm = v => String(v == null ? '' : v).trim().toLowerCase();
  const exp = norm(expectedValue), act = norm(actualValue);
  if(!exp) return true; // guide doesn't specify anything here — nothing to fail
  if(!act) return false; // campaign requires an answer the lead didn't give
  if(exp === act) return true;
  if(/price|timeline|closing|cap|budget/.test(normLabel)){
    const expNum = parseFloat(((exp.match(/[\d,.]+/) || [])[0] || '').replace(/,/g, ''));
    const actNum = parseFloat(((act.match(/[\d,.]+/) || [])[0] || '').replace(/,/g, ''));
    if(!isNaN(expNum) && !isNaN(actNum)) return actNum <= expNum;
  }
  return false;
}

// ---------------------------------------------------------------------------
// v98: Campaign Fit evaluation tool
// ---------------------------------------------------------------------------
// Replaces pure field-label matching with a real evaluator: it still uses a
// direct field match as the strongest signal when the lead's own form
// happens to ask the exact same question, but when it doesn't, it falls
// back to a keyword-association memory that was "learned" from past manual
// reviews, searched against everything the lead actually submitted — not
// just fields with matching labels. v389: the manual review UI that used
// to feed this learned-keyword memory was removed (the AI Second Opinion
// is now the trusted analysis) — this heuristic remains only as the
// fallback leadsCampaignFitFor() uses when no AI opinion has been run yet
// for a lead (see leadsCampaignFitForBadge()), and the keyword memory it
// reads from is now static (frozen at whatever was learned before v389).
const CAMPAIGN_FIT_STOPWORDS = new Set(['the','and','for','are','but','not','you','your','with','have','has','was','were','this','that','from','they','them','their','will','can','all','any','out','into','than','then','also','been','being','who','what','when','where','why','how','get','got','just','like','one','two','per','via','off','yes','no']);
function campaignFitKeywords(text){
  return Array.from(new Set(
    String(text || '').toLowerCase().replace(/[^a-z0-9\s]+/g, ' ').split(/\s+/)
      .filter(w => w.length >= 3 && !CAMPAIGN_FIT_STOPWORDS.has(w))
  )).slice(0, 40); // capped — a long free-text field shouldn't blow up the learning write below
}
// All searchable text a lead actually submitted — every extra field's
// value (regardless of label) plus Seller Name — concatenated into one
// blob. This is what lets the evaluator find signal in a lead form that
// doesn't ask the campaign's exact questions.
function leadsFullTextBlob(lead){
  const entries = leadsExtraFieldsEntriesFn(lead.task_id, lead.submission_form_id, lead.extra_fields) || [];
  const parts = [lead.seller_investor_name, ...entries.map(e => e.value)];
  return parts.filter(v => v != null && v !== '').map(v => String(v)).join(' \n ');
}

let campaignCriteriaKeywords = {}; // campaignNormName -> criterionNormLabel -> [{keyword, meets_count, not_meets_count}]
let campaignCriteriaKeywordsLoaded = false;
async function loadCampaignCriteriaKeywords(){
  const { data, error } = await sb.from('campaign_criteria_keywords').select('campaign_norm_name, criterion_norm_label, keyword, meets_count, not_meets_count');
  if(error){ console.error('Failed to load campaign criteria keywords', error); return; }
  const map = {};
  (data || []).forEach(r => { ((map[r.campaign_norm_name] ||= {})[r.criterion_norm_label] ||= []).push(r); });
  campaignCriteriaKeywords = map;
  campaignCriteriaKeywordsLoaded = true;
}

let leadCriteriaEvaluationsByLeadId = {}; // lead_id -> criterionNormLabel -> row
// v715: .in(column, ids) for a long id list, split into 200-id requests that
// all go out at once. A single .in() with every lead id (~2,300 ids -> an
// ~86 KB URL) is past what the API gateway accepts: those requests never
// reached the server (none in the API logs), so the maps they fill -- saved
// Campaign Fit ratings and AI verdicts -- were silently empty in the queue.
// Rows come back in chunk order (each chunk newest-first by orderCol when
// given), with the first error, if any.
async function selectInChunks(table, cols, column, ids, orderCol){
  const chunks = [];
  for(let i = 0; i < ids.length; i += 200) chunks.push(ids.slice(i, i + 200));
  const results = await Promise.all(chunks.map(c => {
    let q = sb.from(table).select(cols).in(column, c);
    if(orderCol) q = q.order(orderCol, { ascending: false });
    return q.then(r => r);
  }));
  const failed = results.find(r => r.error);
  return { data: results.flatMap(r => r.data || []), error: failed ? failed.error : null };
}

async function loadLeadCriteriaEvaluations(leadIds){
  if(!leadIds || !leadIds.length){ leadCriteriaEvaluationsByLeadId = {}; return; }
  const { data, error } = await selectInChunks('lead_criteria_evaluations',
    'lead_id, campaign_norm_name, criterion_norm_label, criterion_label, expected_value, rating, source', 'lead_id', leadIds);   // v715: chunked
  if(error){ console.error('Failed to load lead criteria evaluations', error); return; }
  const map = {};
  (data || []).forEach(r => { (map[r.lead_id] ||= {})[r.criterion_norm_label] = r; });
  leadCriteriaEvaluationsByLeadId = map;
}

// v381: bulk cache of AI Second Opinion results, keyed by lead+campaign, so
// the main queue's Fit badge can prefer a real AI verdict over the keyword
// heuristic wherever staff already ran "Get AI Second Opinion" on a lead.
let leadAiFitEvaluationsByLeadId = {}; // lead_id -> campaignNormName -> row
async function loadLeadAiFitEvaluations(leadIds){
  if(!leadIds || !leadIds.length){ leadAiFitEvaluationsByLeadId = {}; return; }
  const { data, error } = await selectInChunks('lead_ai_fit_evaluations',
    'lead_id, campaign_norm_name, overall, summary, criteria, model, created_at', 'lead_id', leadIds);   // v715: chunked
  if(error){ console.error('Failed to load lead AI fit evaluations', error); return; }
  const map = {};
  (data || []).forEach(r => {
    const existing = (map[r.lead_id] ||= {})[r.campaign_norm_name];
    if(!existing || new Date(r.created_at) > new Date(existing.created_at)){
      map[r.lead_id][r.campaign_norm_name] = r;
    }
  });
  leadAiFitEvaluationsByLeadId = map;
}

// Direct field-match verdict — null if the lead's own form doesn't ask
// this exact question at all (nothing to go on directly). v101: now
// consults the field's `kind`-specific evaluator first (geography,
// listing-status, max-days, etc. — see CAMPAIGN_GUIDE_KIND_EVALUATORS)
// when the field is one of the standardized questions; falls through to
// the original generic string/number check for anything a kind rule
// can't conclusively answer, exactly as before this change.
function campaignFieldDirectVerdict(criterion, leadByNorm, guideByNorm){
  if(!(criterion.normLabel in leadByNorm)) return null;
  const actual = leadByNorm[criterion.normLabel];
  const meta = campaignGuideFieldMeta(criterion.normLabel);
  if(meta.kind && CAMPAIGN_GUIDE_KIND_EVALUATORS[meta.kind]){
    const ctx = {};
    if(meta.kind === 'geo'){
      const referralVal = guideByNorm && guideByNorm[csubNormalizeLabel('Do you accept referrals outside of your targeted market? (Criteria)')];
      ctx.referralOpen = /^\s*yes\b/i.test(String(referralVal || ''));
    }
    const kindResult = CAMPAIGN_GUIDE_KIND_EVALUATORS[meta.kind](criterion.value, actual, ctx);
    if(kindResult != null) return kindResult;
  }
  if(!String(actual == null ? '' : actual).trim()) return 'unclear'; // field exists on the form but wasn't answered
  return campaignGuideFieldPasses(criterion.value, actual, criterion.normLabel) ? 'meets' : 'does_not_meet';
}
// Keyword-bank guess — the "not a field matcher" path. Weighted by
// whatever's been LEARNED from past manual reviews for this exact
// campaign+criterion; falls back to a weak seed (the guide's own expected
// wording appearing in the lead's text) only when nothing's been learned
// yet at all.
function campaignFieldKeywordVerdict(campaignNormName, criterion, blobKeywords){
  const learned = (campaignCriteriaKeywords[campaignNormName] && campaignCriteriaKeywords[campaignNormName][criterion.normLabel]) || [];
  let meetsScore = 0, notMeetsScore = 0;
  const blobSet = new Set(blobKeywords);
  learned.forEach(k => { if(blobSet.has(k.keyword)){ meetsScore += k.meets_count; notMeetsScore += k.not_meets_count; } });
  if(meetsScore === 0 && notMeetsScore === 0){
    const expectedKeywords = new Set(campaignFitKeywords(criterion.value));
    const overlap = blobKeywords.filter(w => expectedKeywords.has(w)).length;
    return overlap >= 2 ? 'meets' : 'unclear';
  }
  if(meetsScore === notMeetsScore) return 'unclear';
  return meetsScore > notMeetsScore ? 'meets' : 'does_not_meet';
}
// A stored MANUAL rating always wins (a reviewer's judgment overrides any
// guess); a purely informational/reference field (e.g. "Realtor Commission
// Covered?") is never scored at all — v101, previously these were guessed
// at like any other field even though they're reference notes, not
// pass/fail criteria; otherwise a direct field match wins over the keyword
// guess (an actual matching question beats an inference); otherwise the
// keyword-bank guess; if nothing at all is available, 'unclear'.
function leadsCriterionVerdict(lead, campaignNormName, criterion, leadByNorm, blobKeywords, guideByNorm){
  const stored = leadCriteriaEvaluationsByLeadId[lead.id] && leadCriteriaEvaluationsByLeadId[lead.id][criterion.normLabel];
  if(stored && stored.source === 'manual') return { rating: stored.rating, source: 'manual' };
  const meta = campaignGuideFieldMeta(criterion.normLabel);
  if(meta.informational) return { rating: 'unclear', source: 'informational' };
  const direct = campaignFieldDirectVerdict(criterion, leadByNorm, guideByNorm);
  if(direct != null) return { rating: direct, source: 'auto-field' };
  return { rating: campaignFieldKeywordVerdict(campaignNormName, criterion, blobKeywords), source: 'auto-keyword' };
}

// Aggregates every criterion's verdict for one lead into an overall Fit
// category. `fit: null` = nothing evaluable at all (no campaign match, no
// guide, or a guide with zero criteria) — shown as "—", never as Not a
// Fit. `fit` is also null (with verdicts still returned) when a guide
// exists but every criterion came back 'unclear' — same "nothing to
// conclude" reasoning.
function leadsCampaignFitFor(lead){
  const campaignName = leadsCampaignNameFor(lead);
  if(!campaignName) return null;
  const normName = csubNormalizeLabel(campaignName);
  const guide = campaignGuides[normName];
  if(!guide || !guide.fields.length) return null;
  const entries = leadsExtraFieldsEntriesFn(lead.task_id, lead.submission_form_id, lead.extra_fields) || [];
  const leadByNorm = {};
  entries.forEach(e => { leadByNorm[csubNormalizeLabel(e.label)] = e.value; });
  const guideByNorm = {};
  guide.fields.forEach(f => { guideByNorm[f.normLabel] = f.value; });
  const blobKeywords = campaignFitKeywords(leadsFullTextBlob(lead));
  const verdicts = guide.fields.map(f => ({
    ...leadsCriterionVerdict(lead, normName, f, leadByNorm, blobKeywords, guideByNorm),
    label: f.label, normLabel: f.normLabel, expected: f.value,
  }));
  const evaluated = verdicts.filter(v => v.rating !== 'unclear');
  if(!evaluated.length) return { fit: null, verdicts, campaignName: guide.displayName, normName };
  const meetsCount = evaluated.filter(v => v.rating === 'meets').length;
  const pct = meetsCount / evaluated.length;
  const fit = pct >= 0.8 ? 'strong' : pct >= 0.4 ? 'partial' : 'not_fit';
  return { fit, verdicts, campaignName: guide.displayName, normName, meetsCount, evaluatedCount: evaluated.length };
}

// v381: badge-facing wrapper around leadsCampaignFitFor() — used ONLY for
// the main queue table's Fit badge (never the reviewer's editable Campaign
// Fit Evaluation panel, which must keep showing the raw heuristic so
// reviewers can override it and feed the learned-keyword memory). When an
// AI Second Opinion has already been run for this lead+campaign, that real
// verdict replaces the keyword/field guess entirely; otherwise this is
// identical to leadsCampaignFitFor().
function leadsCampaignFitForBadge(lead){
  const heuristic = leadsCampaignFitFor(lead);
  if(!heuristic) return heuristic;
  const aiEval = leadAiFitEvaluationsByLeadId[lead.id] && leadAiFitEvaluationsByLeadId[lead.id][heuristic.normName];
  if(!aiEval) return heuristic;
  const guideByNorm = {};
  heuristic.verdicts.forEach(v => { guideByNorm[v.normLabel] = v.expected; });
  const aiVerdicts = (aiEval.criteria || []).map(c => {
    const normLabel = csubNormalizeLabel(c.label);
    const rating = c.verdict === 'does_not_meet' ? 'does_not_meet' : c.verdict === 'meets' ? 'meets' : 'unclear';
    return { label: c.label, normLabel, expected: guideByNorm[normLabel] != null ? guideByNorm[normLabel] : null, rating, source: 'ai', reasoning: c.reasoning };
  });
  const aiEvaluated = aiVerdicts.filter(v => v.rating !== 'unclear');
  const meetsCount = aiEvaluated.filter(v => v.rating === 'meets').length;
  return {
    fit: aiEval.overall, verdicts: aiVerdicts, campaignName: heuristic.campaignName, normName: heuristic.normName,
    meetsCount, evaluatedCount: aiEvaluated.length, aiSummary: aiEval.summary, aiModel: aiEval.model,
  };
}

function initClientSubmissionsTab(){
  if(!$('csubFromDateInput').value){
    const from = new Date(); from.setDate(from.getDate() - 30);
    $('csubFromDateInput').value = from.toISOString().slice(0, 10);
    $('csubToDateInput').value = endOfLoginMonthDateInputValue();
  }
  // v96: per-sub-tab view gating (User Types → Client Submissions) — hide
  // any sub-tab button this role isn't granted, same pattern Leads already
  // uses for its own sub-tabs.
  document.querySelectorAll('.csub-subtab-btn').forEach(btn => {
    btn.style.display = canViewCsubSection(btn.dataset.csubSection) ? '' : 'none';
  });
  const firstVisible = Array.from(document.querySelectorAll('.csub-subtab-btn')).find(b => b.style.display !== 'none');
  const target = (csubActiveSection && canViewCsubSection(csubActiveSection)) ? csubActiveSection : (firstVisible ? firstVisible.dataset.csubSection : null);
  if(target) activateCsubSection(target);
}
function activateCsubSection(key){
  csubActiveSection = key;
  document.querySelectorAll('.csub-subtab-btn').forEach(b => b.classList.toggle('active', b.dataset.csubSection === key));
  document.querySelectorAll('.csub-section').forEach(s => { s.style.display = (s.id === 'csubSection-' + key) ? 'block' : 'none'; });
  const filterCard = $('csubFormFilterCard');
  if(filterCard) filterCard.style.display = (key === 'dashboard' || key === 'campaign_guide' || key === 'campaign_progress' || key === 'readymode_upload_list' || key === 'marketing') ? 'none' : '';
  // v366: Form/Export CSV only mean anything on Data Form/Qualification
  // (Export CSV was never wired for Campaign Management -- see its own
  // click handler comment); Status/Package only mean anything on Campaign
  // Management, since only campaigns have a linked subscription to filter
  // by. Swap which half of the shared row shows instead of stacking a
  // second filter row underneath it.
  const onCampaign = key === 'campaign';
  // Campaign Progress has no use for any of the shared filter row (it's its
  // own self-contained card with its own Refresh button) -- force-hide all
  // four wraps for it rather than letting it fall into the "else" half of
  // onCampaign's ternaries below, which would show the Data Form/
  // Qualification filter UI above a section that ignores it entirely.
  const hideAllFilters = key === 'campaign_progress' || key === 'readymode_upload_list' || key === 'marketing';
  if($('csubFormFilterWrap')) $('csubFormFilterWrap').style.display = (onCampaign || hideAllFilters) ? 'none' : '';
  if($('csubExportCsvWrap')) $('csubExportCsvWrap').style.display = (onCampaign || hideAllFilters) ? 'none' : '';
  if($('csubCampaignStatusFilterWrap')) $('csubCampaignStatusFilterWrap').style.display = (onCampaign && !hideAllFilters) ? '' : 'none';
  if($('csubCampaignPackageFilterWrap')) $('csubCampaignPackageFilterWrap').style.display = (onCampaign && !hideAllFilters) ? '' : 'none';
  if($('csubFormFilterHint')) $('csubFormFilterHint').textContent = onCampaign
    ? 'Campaign Name filters this list the same way it does Data Form/Client Qualification Form — kept in sync across all three.'
    : 'Campaign Name filters both Data Form and Client Qualification Form together — a Cold Caller package submission appears on both, so this keeps them in sync.';
  if(key !== 'marketing') loadClientSubmissions();   // v775: Email Marketing has its own data
  // v292: fetched separately from loadClientSubmissions (different
  // table) and re-renders on its own once it resolves -- whichever of
  // the two finishes first, renderCsubCampaignTable() ends up called
  // again by the other, so the final render always reflects both.
  if(key === 'campaign'){
    loadCsubCampaignSubsForCampaignTab().then(() => { if(csubActiveSection === 'campaign') renderCsubCampaignTable(); });
    loadCsubActiveCampaignForms().then(() => { if(csubActiveSection === 'campaign') renderCsubCampaignTable(); });
    loadCsubCampaignLeadStats().then(() => { if(csubActiveSection === 'campaign') renderCsubCampaignTable(); });
  } else if(key === 'campaign_guide'){
    loadCampaignGuide();
    initCampaignResourcesSection();
  } else if(key === 'campaign_progress'){
    loadRmCampaignProgress();
    // This pane now carries an .edit-only control (the progress-file import),
    // and that class does nothing unless the gating is applied for the
    // section -- the same gap that left the ReadyMode push button live for
    // view-only roles until v576. Owner/Admin are never section-gated.
    if(!(myIsOwner || myRole === 'admin')) applyCsubSectionEditGating('campaign_progress');
  } else if(key === 'marketing'){
    initMarketingStats();   // v775
  } else if(key === 'readymode_upload_list'){
    // The channel dropdown on the dedupe card and the push-history list
    // were previously filled by the Integrations tab's own bulk load, which
    // never runs if staff go straight to Campaigns. Load both here.
    loadRmLeadPostingChannels();
    loadRmLeadPushes();
    // v576: "Push clean list to ReadyMode" is marked .edit-only, but that
    // class does nothing unless someone applies the gating -- and this was
    // the only csub section that never called it, so every view-only role
    // saw a live Push button that just 403'd from readymode-api. The
    // backend refuses it either way (readymode-api's own v575 gate); this
    // makes the UI say so up front instead of after the click.
    // Owner/Admin are never section-gated: readymode-api allows them
    // unconditionally (isOwnerAdmin), and `admin` is NOT is_protected, so
    // canEditCsubSection() returns false for any section the admin role has
    // no explicit grant on -- which would grey the button out for real
    // admins and make the UI disagree with the backend, the exact fault
    // v575 fixed on the other side. Same escape hatch csubNewCampaignBtn
    // already uses.
    if(!(myIsOwner || myRole === 'admin')) applyCsubSectionEditGating('readymode_upload_list');
  }
}
document.querySelectorAll('.csub-subtab-btn').forEach(btn => {
  btn.addEventListener('click', () => activateCsubSection(btn.dataset.csubSection));
});
if($('csubRefreshBtn')) $('csubRefreshBtn').addEventListener('click', async () => {
  const btn = $('csubRefreshBtn');
  if(btn.disabled) return;
  btn.disabled = true;
  const original = btn.innerHTML;
  btn.innerHTML = '&#8635; Refreshing…';
  await loadClientSubmissions();
  btn.innerHTML = original;
  btn.disabled = false;
});
// v370: per-row "reload just this subtab" pattern, same as .leads-refresh-btn
// / .datasci-refresh-btn -- Campaign Guide is the first Csub section to need
// its own standalone refresh button (everything else here shares the top
// csubRefreshBtn / loadClientSubmissions()).
function refreshCsubSectionByKey(key){
  if(key === 'campaign_guide'){ loadCampaignGuide(); initCampaignResourcesSection(); }
  else loadClientSubmissions();
}
document.querySelectorAll('.csub-refresh-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    if(btn.disabled) return;
    btn.disabled = true;
    const original = btn.innerHTML;
    btn.innerHTML = '&#8635; Refreshing…';
    await refreshCsubSectionByKey(btn.dataset.refreshKey);
    btn.innerHTML = original;
    btn.disabled = false;
  });
});
// v370: same pattern as applyLeadsSectionEditGating -- see its own comment.
function applyCsubSectionEditGating(key, scopeEl){
  const panel = scopeEl || document.getElementById('csubSection-' + key);
  if(!panel) return;
  const editable = canEditCsubSection(key);
  panel.querySelectorAll('.edit-only').forEach(el => {
    el.disabled = !editable;
    el.style.opacity = editable ? '' : '0.4';
    el.title = editable ? '' : 'Your role has view-only access to this section';
  });
}

async function loadClientSubmissions(){
  const from = $('csubFromDateInput').value;
  const to = $('csubToDateInput').value;
  // v500: 'exact' count -- costs one extra count(*) on Postgres' side but
  // is the only way to tell "there were exactly 1000 rows" apart from
  // "there were 4000 rows and 3000 got silently dropped by the cap below".
  let q = sb.from('ghl_form_submissions')
    .select('id, form_id, form_name, contact_name, contact_phone, contact_email, submitted_at, fields', { count: 'exact' })
    .order('submitted_at', { ascending: false })
    .limit(1000);
  if(from) q = q.gte('submitted_at', new Date(from + 'T00:00:00').toISOString());
  if(to) q = q.lte('submitted_at', new Date(to + 'T23:59:59.999').toISOString());
  const { data, error, count } = await q;
  const warnEl = $('csubTruncatedWarning');
  if(error){
    console.error('Failed to load client submissions', error);
    csubAllRows = [];
    warnEl.style.display = 'none';
  } else {
    csubAllRows = data || [];
    if(typeof count === 'number' && count > csubAllRows.length){
      warnEl.textContent = `Showing the most recent ${csubAllRows.length.toLocaleString()} of ${count.toLocaleString()} submissions in this range — narrow the date range to see the rest.`;
      warnEl.style.display = '';
    } else {
      warnEl.style.display = 'none';
    }
  }
  populateCsubFormFilterOptions();
  populateCsubCampaignFilterOptions();
  if(csubActiveSection === 'dashboard') renderCsubDashboard();
  else if(csubActiveSection === 'campaign') renderCsubCampaignTable();
  else renderCsubSectionTable(csubActiveSection);
}

// ---------------------------------------------------------------------------
// v291: Campaign subtab — Dialer (Criteria)/Data Source (Criteria)/Caller
// Staffing (Criteria) moved here from Campaign Guide (see
// CAMPAIGN_GUIDE_EXCLUDED_LABELS / loadCampaignGuide()'s excludedNorms and
// client-campaign-guide/index.ts's matching exclusion — clients no longer
// see these 3 fields on their own Campaign Guide, staff see them here
// instead). Reuses csubFilteredRowsForSection('qualification') so the
// existing Form/Campaign filter dropdowns and date range still apply, then
// narrows to rows that actually carry at least one of the 3 fields (i.e.
// campaigns created via the paid self-serve Create Campaign flow).
// ---------------------------------------------------------------------------
const CAMPAIGN_SUBTAB_FIELD_LABELS = ['Dialer (Criteria)', 'Data Source (Criteria)', 'Caller Staffing (Criteria)'];
function csubFieldValueByLabel(row, label){
  const fields = row.fields || {};
  const key = Object.keys(fields).find(k => csubNormalizeLabel(k) === csubNormalizeLabel(label));
  return key ? String(fields[key] || '').trim() : '';
}

// v292: a client can now switch dialer_choice/data_choice on an ACTIVE
// client_campaign_subscriptions row after the fact (client-manage-
// subscription's update_addons action) -- the Dialer (Criteria)/Data
// Source (Criteria) text baked into this ghl_form_submissions row at
// creation time is only ever a point-in-time snapshot and goes stale the
// moment that happens. Prefer a live client_campaign_subscriptions match
// (by normalized campaign name) when one exists; fall back to the static
// submission field text otherwise (older campaigns predating the
// subscription system, or ones whose subscription row was since deleted).
let csubCampaignSubsByNorm = {};
let csubCampaignClientById = {};   // v680: client_accounts by id, for Client Details
// v762: Email Marketing standing per client, for the Campaign Details
// column. marketing_access() is the one source of truth for seats and the
// monthly allowance (never re-derive it here), and staff may call it.
// Cached by client id because one client can own several campaigns -- the
// table would otherwise ask the same question once per row.
let csubMarketingByClient = {};    // client_id -> marketing_access() jsonb
let csubMarketingLoading = false;
async function csubLoadMarketingAccess(ids){
  // Only ever fetch what is missing, and never re-enter while in flight --
  // this is called from the renderer, which the load itself re-triggers.
  const want = [...new Set(ids.filter(Boolean))].filter(id => !(id in csubMarketingByClient));
  if(!want.length || csubMarketingLoading) return;
  csubMarketingLoading = true;
  try{
    await Promise.all(want.map(async (id) => {
      const { data, error } = await sb.rpc('marketing_access', { p_client: id });
      // null marks it as asked-and-unavailable, so a failure does not make
      // every later render retry it forever.
      csubMarketingByClient[id] = (error || !data) ? null : data;
    }));
  } finally { csubMarketingLoading = false; }
  if(csubActiveSection === 'campaign') renderCsubCampaignTable();
}
// What one client's standing reads as in the table.
function csubMarketingCell(clientId){
  if(!clientId) return '<span style="color:var(--text-dim);">&mdash;</span>';
  if(!(clientId in csubMarketingByClient)) return '<span style="color:var(--text-dim);">Loading&hellip;</span>';
  const a = csubMarketingByClient[clientId];
  if(!a) return '<span style="color:var(--text-dim);">&mdash;</span>';
  const seats = Number(a.seats || 0);
  if(!seats) return '<span style="color:var(--text-dim);">No seat</span>';
  const paid = Number(a.paid_seats || 0), extra = Number(a.extra_seats || 0);
  // Where the seats came from: earned by a paid Full-time caller on our
  // data, granted by staff, or a mix of both.
  const origin = paid && extra ? `${paid} with campaign + ${extra} free`
    : paid ? 'with campaign' : 'free (added by staff)';
  // Setup is what actually decides whether they can send yet, so a seat
  // that cannot send should not read as if it can.
  const ready = !!a.setup_complete;
  return `<span class="mono" style="color:var(--good); font-size:11px;">${seats} seat${seats === 1 ? '' : 's'} &middot; ${Number(a.monthly_limit || 0).toLocaleString()}/mo</span>`
    + `<div style="font-size:10px; color:var(--text-2);">${escapeHtml(origin)}</div>`
    + (ready ? '' : '<div style="font-size:10px; color:var(--away);">setup incomplete</div>');
}
let csubCampaignRequestByNorm = {}; // v681: each campaign's first request, whatever the date filter
// v395: normName -> { accepted, rejected, pending, total } lead outcome
// counts, keyed the same way csubCampaignSubsByNorm is (csubNormalizeLabel
// on the campaign's display name) so the Campaign Management table can
// show real lead yield/conversion next to what a campaign is costing —
// previously this tab only ever showed raw form *submissions*
// (csubStatTotal), with no link at all to what Leads actually accepted or
// rejected out of them. leads.submission_form_id -> lead_submission_forms.id
// is the same join Leads' own campaign-name resolution
// (leadsFormNameFn/leadsAllForms) uses.
let csubCampaignLeadStatsByNorm = {};
// audit fix (audit_chunk4.md #3, Medium): loadCsubCampaignLeadStats used to
// fetch the whole `leads` table with no .limit()/pagination at all -- every
// other bulk fetch in this range is explicitly bounded (client_campaign_
// subscriptions .limit(200), ghl_form_submissions/lead_disputes .limit(1000)
// in loadAllQueue), and this file elsewhere (the v261 fetchInChunks comment)
// documents that an unbounded `leads` query has already silently truncated
// in production against Supabase/PostgREST's default row cap. Rather than
// add another arbitrary .limit() that just moves the same silent-truncation
// bug further out, this pages through the full table with .range() so the
// Accept Rate/Accepted/Rejected columns it drives always reflect every row.
async function fetchAllLeadStatusRows(){
  const PAGE_SIZE = 1000;
  const rows = [];
  for(let from = 0; ; from += PAGE_SIZE){
    const { data, error } = await sb.from('leads').select('submission_form_id, status').range(from, from + PAGE_SIZE - 1);
    if(error) throw error;
    rows.push(...(data || []));
    if(!data || data.length < PAGE_SIZE) break;
  }
  return rows;
}
async function loadCsubCampaignLeadStats(){
  let forms, formsErr, leadRows, leadsErr;
  try {
    [{ data: forms, error: formsErr }, leadRows] = await Promise.all([
      sb.from('lead_submission_forms').select('id, name'),
      fetchAllLeadStatusRows(),
    ]);
  } catch (e) {
    leadsErr = e;
  }
  if(formsErr || leadsErr){
    console.error('Failed to load campaign lead stats', formsErr || leadsErr);
    csubCampaignLeadStatsByNorm = {};
    return;
  }
  const normByFormId = {};
  (forms || []).forEach(f => { if(f.name) normByFormId[f.id] = csubNormalizeLabel(f.name); });
  const stats = {};
  (leadRows || []).forEach(r => {
    const norm = normByFormId[r.submission_form_id];
    if(!norm) return;
    const bucket = (stats[norm] ||= { accepted: 0, rejected: 0, pending: 0, total: 0 });
    bucket.total++;
    if(r.status === 'accepted') bucket.accepted++;
    else if(r.status === 'rejected') bucket.rejected++;
    else if(r.status === 'pending' || r.status === 'call_back') bucket.pending++;
  });
  csubCampaignLeadStatsByNorm = stats;
}
// Accepted / (Accepted + Rejected) — pending/call-back leads are still
// awaiting a decision, so they're excluded from the rate itself (same
// reasoning leadsCampaignFitFor-style badges use elsewhere: only a
// reviewed outcome counts as a real signal). Returns null (not 0) when
// there's nothing decided yet, so the render layer can show '—' instead
// of a misleading 0%.
function csubCampaignAcceptRate(norm){
  const s = csubCampaignLeadStatsByNorm[norm];
  if(!s) return null;
  const decided = s.accepted + s.rejected;
  return decided > 0 ? s.accepted / decided : null;
}

async function loadCsubCampaignSubsForCampaignTab(){
  // v366: widened to also pull status/current_period_end/is_complimentary/
  // complimentary_expires_at -- see csubCampaignPackageLabel/
  // csubCampaignActiveUntilLabel/csubCampaignStatusInfo below, which read
  // these off the same cached match used for Dialer/Data Source/Caller
  // Staffing above.
  const { data, error } = await sb.from('client_campaign_subscriptions')
    .select('campaign_display_name, client_id, caller_tier, part_time_callers, full_time_callers, dialer_choice, data_choice, created_at, status, current_period_end, is_complimentary, complimentary_expires_at, ' + CAMPAIGN_SUB_BUCKET_KEYS.join(', '))
    .order('created_at', { ascending: false });
  if(error){
    console.error('Failed to load campaign subscriptions for Campaign tab', error);
    csubCampaignSubsByNorm = {};
    return;
  }
  csubCampaignSubsByNorm = {};
  (data || []).forEach(s => {
    const norm = csubNormalizeLabel(s.campaign_display_name || '');
    if(norm && !(norm in csubCampaignSubsByNorm)) csubCampaignSubsByNorm[norm] = s; // sorted desc -- first seen is the latest
  });
  // v680: the campaign's own client, for Client Details on a campaign with no
  // client-portal request row to read contact details from.
  csubCampaignClientById = {};
  const clientIds = Array.from(new Set((data || []).map(s => s.client_id).filter(Boolean)));
  if(clientIds.length){
    const { data: cl } = await sb.from('client_accounts').select('id, full_name, company_name, email, phone').in('id', clientIds);
    (cl || []).forEach(c => { csubCampaignClientById[c.id] = c; });
  }
  // v681: the Campaigns section only loads requests inside its From/To
  // window, so a campaign requested before that window showed "No request
  // submitted". Its first request is looked up here regardless of dates.
  csubCampaignRequestByNorm = {};
  const { data: reqs } = await sb.from('ghl_form_submissions')
    .select('submitted_at, contact_name, contact_phone, contact_email, fields')
    .order('submitted_at', { ascending: false })
    .limit(1000);
  (reqs || []).forEach(r => {   // newest first, so the last one kept is the earliest
    const norm = csubNormalizeLabel(csubCampaignNameValue(r));
    if(norm && norm in csubCampaignSubsByNorm) csubCampaignRequestByNorm[norm] = r;
  });
}
// v296: dialer is now per-caller, so a subscription can mix "our dialer"
// and "own dialer" callers -- a single dialer_choice label would be
// misleading. Builds a per-group breakdown the same way the Campaign
// Subscriptions staff table does (campaignSubCallerGroups), falling back
// to the legacy single-choice label for subscriptions with no bucket
// data (shouldn't happen post-v296-backfill, but a defensive fallback).
function csubCampaignDialerLabel(r){
  const sub = csubCampaignSubsByNorm[csubNormalizeLabel(csubCampaignNameValue(r))];
  if(sub){
    // v338: campaignSubCallerGroups() now splits by data choice too --
    // aggregate back down to (tier, dialer) here since this label is
    // dialer-only, otherwise a mixed-data subscription would show the
    // same tier/dialer combo twice.
    const byTierDialer = {};
    campaignSubCallerGroups(sub).forEach(g => {
      const key = `${g.tier}|${g.dialerChoice}`;
      byTierDialer[key] = (byTierDialer[key] || 0) + g.count;
    });
    const keys = Object.keys(byTierDialer);
    if(keys.length){
      return keys.map(key => {
        const [tier, dialerChoice] = key.split('|');
        return `${byTierDialer[key]} × ${tier === 'full_time' ? 'Full-time' : 'Part-time'} on ${dialerChoice === 'ours' ? 'our dialer' : 'own dialer'}`;
      }).join(', ');
    }
    return sub.dialer_choice === 'ours' ? 'Our dialer (ReadyMode / IQ)' : "Client's own dialer";
  }
  return csubFieldValueByLabel(r, 'Dialer (Criteria)') || '—';
}
function csubCampaignDataLabel(r){
  const sub = csubCampaignSubsByNorm[csubNormalizeLabel(csubCampaignNameValue(r))];
  if(sub){
    // audit fix (audit_chunk4.md #2, Medium): this used to read the single
    // legacy top-level sub.data_choice field, unlike the sibling
    // csubCampaignDialerLabel just above (already fixed in v338 to
    // aggregate per-caller-group counts). For any subscription with a mix
    // of "our data" and "own data" callers -- exactly the scenario v338
    // introduced -- this showed one flat, potentially wrong value while
    // the Dialer column correctly showed the mixed breakdown. Same
    // aggregate-by-(tier, dataChoice) treatment as the dialer label.
    const byTierData = {};
    campaignSubCallerGroups(sub).forEach(g => {
      const key = `${g.tier}|${g.dataChoice}`;
      byTierData[key] = (byTierData[key] || 0) + g.count;
    });
    const keys = Object.keys(byTierData);
    if(keys.length){
      return keys.map(key => {
        const [tier, dataChoice] = key.split('|');
        return `${byTierData[key]} × ${tier === 'full_time' ? 'Full-time' : 'Part-time'} on ${dataChoice === 'ours' ? 'our data' : "client's own data"}`;
      }).join(', ');
    }
    return sub.data_choice === 'ours' ? 'Our data' : "Client's own data";
  }
  return csubFieldValueByLabel(r, 'Data Source (Criteria)') || '—';
}
function csubCampaignStaffingLabel(r){
  const sub = csubCampaignSubsByNorm[csubNormalizeLabel(csubCampaignNameValue(r))];
  if(sub) return campaignSubTierBreakdown(sub);
  return csubFieldValueByLabel(r, 'Caller Staffing (Criteria)') || '—';
}
// v366: Package/Active Until/Status -- all three only exist for rows with
// a live client_campaign_subscriptions match (same csubCampaignSubsByNorm
// lookup the 3 functions above use); a plain granted-form row with no
// self-serve request behind it shows '—' for all three, same fallback
// pattern already used elsewhere in this table.
function csubCampaignPackageLabel(r){
  const sub = csubCampaignSubsByNorm[csubNormalizeLabel(csubCampaignNameValue(r))];
  if(!sub) return '—';
  return `${campaignSubTierBreakdown(sub)} · ${sub.is_complimentary ? 'Complimentary' : 'Paid'}`;
}
function csubCampaignActiveUntilLabel(r){
  const sub = csubCampaignSubsByNorm[csubNormalizeLabel(csubCampaignNameValue(r))];
  if(!sub) return '—';
  const dateStr = sub.is_complimentary ? sub.complimentary_expires_at : sub.current_period_end;
  const activeUntilTz = nonAgentDisplayTz();
  return dateStr ? new Date(dateStr).toLocaleDateString([], activeUntilTz ? { timeZone: activeUntilTz } : {}) : '—';
}
// Mirrors CAMPAIGN_SUB_STAFF_STATUS_LABEL (Finance -> Stripe Subscription)
// so a status reads identically in both places -- this is a read-only
// reflection of that same subscription row, not a second source of truth.
function csubCampaignStatusInfo(r){
  const sub = csubCampaignSubsByNorm[csubNormalizeLabel(csubCampaignNameValue(r))];
  if(!sub) return { key: 'none', label: '—', color: 'var(--text-dim)' };
  const label = CAMPAIGN_SUB_STAFF_STATUS_LABEL[sub.status] || sub.status;
  const color = sub.status === 'active' ? 'var(--good)'
    : (sub.status === 'past_due' || sub.status === 'canceled') ? 'var(--danger)'
    : 'var(--text-2)';
  return { key: sub.status, label, color };
}

// v298: this table used to ONLY show campaigns that came through the paid
// self-serve Create Campaign flow (rows carrying at least one of
// CAMPAIGN_SUBTAB_FIELD_LABELS) — any campaign granted to a client via
// User Management -> Clients -> Campaign access (a plain lead_submission_
// forms row, no self-serve request behind it) never showed up here at
// all, even though it's a real, active campaign clients see. Per your
// call: widen this to also list every active campaign form a client can
// actually see, with '—' for the columns that only a self-serve request
// would have filled in.
// v309/v310: a "campaign" here means specifically "went through the New
// Campaign flow" (client's own self-serve flow, or staff's own "+ New
// Campaign" button — see staff-create-campaign) -- NOT any active
// lead_submission_forms row (v298's bug: caught plain internal forms like
// "Ticket"), and NOT a form merely granted to a client via User
// Management -> Clients -> Campaign access either (that's a separate,
// non-campaign access mechanism -- e.g. Tori 001, which was only ever
// manually granted, never actually requested/paid as a campaign).
// client_campaign_subscriptions.form_id is the one clean, unambiguous
// signal: it's ONLY ever written by finalizeCampaignSubscription
// (public-skiptrace/index.ts), once Stripe confirms payment for either
// entry point -- so a form showing up here always has a real campaign
// request behind it.
// loadCsubActiveCampaignForms() below supplies that list; synthetic rows
// are plain objects shaped just enough like a real submission row
// (fields.{Campaign Name}, no submitted_at/contact_*) for
// csubCampaignNameValue/csubCampaignDialerLabel/etc. to handle them the
// same way they already handle a real row with no criteria answered.
let csubActiveCampaignForms = [];
async function loadCsubActiveCampaignForms(){
  const { data: subs, error: subsErr } = await sb.from('client_campaign_subscriptions').select('form_id');
  if(subsErr){ console.error('Failed to load campaign subscriptions for Campaign tab', subsErr); csubActiveCampaignForms = []; return; }
  const campaignFormIds = Array.from(new Set((subs || []).map(s => s.form_id).filter(Boolean)));
  if(!campaignFormIds.length){ csubActiveCampaignForms = []; return; }
  const { data, error } = await sb.from('lead_submission_forms').select('id, name').eq('is_active', true).in('id', campaignFormIds).order('name');
  if(error){ console.error('Failed to load active campaign forms for Campaign tab', error); csubActiveCampaignForms = []; return; }
  csubActiveCampaignForms = data || [];
}

function renderCsubCampaignTable(){
  const headEl = $('csubCampaignTableHead');
  const bodyEl = $('csubCampaignTableBody');
  if(!bodyEl) return;
  const requestRows = csubFilteredRowsForSection('qualification')
    .filter(r => csubCampaignNameValue(r) && CAMPAIGN_SUBTAB_FIELD_LABELS.some(l => csubFieldValueByLabel(r, l)))
    .sort((a, b) => new Date(b.submitted_at) - new Date(a.submitted_at));
  const namesWithRequests = new Set(requestRows.map(csubCampaignNameValue));
  const placeholderRows = csubActiveCampaignForms
    .filter(f => f.name && !namesWithRequests.has(f.name))
    .map(f => ({ id: `form-${f.id}`, formId: f.id, submitted_at: null, contact_name: null, contact_phone: null, contact_email: null, fields: { 'Campaign Name': f.name }, isPlaceholder: true }));
  // v366: Status/Package filters -- client-side only, same rows already
  // fetched for the table itself, just narrowed before rendering.
  const statusFilterVal = $('csubCampaignStatusFilter') ? $('csubCampaignStatusFilter').value : '';
  const packageFilterVal = $('csubCampaignPackageFilter') ? $('csubCampaignPackageFilter').value : '';
  let rows = [...requestRows, ...placeholderRows];
  if(statusFilterVal) rows = rows.filter(r => csubCampaignStatusInfo(r).key === statusFilterVal);
  if(packageFilterVal){
    rows = rows.filter(r => {
      const sub = csubCampaignSubsByNorm[csubNormalizeLabel(csubCampaignNameValue(r))];
      if(!sub) return false;
      return packageFilterVal === 'complimentary' ? !!sub.is_complimentary : !sub.is_complimentary;
    });
  }
  if(headEl) headEl.innerHTML = '<th>Submitted</th><th>Campaign Name</th><th>Client Details</th><th>Dialer</th><th>Data Source</th><th>Caller Staffing</th><th>Package</th><th>Active Until</th><th>Status</th><th>Accepted / Rejected</th><th>Accept Rate</th><th>Email Marketing</th>' + (myIsOwner ? '<th>Delete</th>' : '');
  if(!rows.length){
    bodyEl.innerHTML = `<tr><td colspan="${myIsOwner ? 13 : 12}" style="color:var(--text-dim);">No campaigns match this filter.</td></tr>`;
    return;
  }
  const csubCampaignTz = nonAgentDisplayTz();
  // v762: ask for any client standing this table does not have yet; the
  // loader re-renders once the answers are in.
  csubLoadMarketingAccess(rows.map(r => (csubCampaignSubsByNorm[csubNormalizeLabel(csubCampaignNameValue(r))] || {}).client_id));
  bodyEl.innerHTML = rows.map(r => {
    // v681: a placeholder falls back to the campaign's first request when that
    // request sits outside the date window.
    const firstReq = r.isPlaceholder ? csubCampaignRequestByNorm[csubNormalizeLabel(csubCampaignNameValue(r))] : null;
    const submittedAt = r.submitted_at || firstReq?.submitted_at;
    const submitted = submittedAt ? new Date(submittedAt).toLocaleString([], { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', ...(csubCampaignTz ? { timeZone: csubCampaignTz } : {}) }) : (r.isPlaceholder ? 'No request submitted' : '—');
    const linkedClient = csubCampaignClientById[(csubCampaignSubsByNorm[csubNormalizeLabel(csubCampaignNameValue(r))] || {}).client_id];
    const clientDetails = [r.contact_name, r.contact_phone, r.contact_email].filter(Boolean).join(' · ')
      || (firstReq ? [firstReq.contact_name, firstReq.contact_phone, firstReq.contact_email].filter(Boolean).join(' · ') : '')
      || (linkedClient ? [linkedClient.full_name || linkedClient.company_name, linkedClient.phone, linkedClient.email].filter(Boolean).join(' · ') : '—');
    const statusInfo = csubCampaignStatusInfo(r);
    const leadNorm = csubNormalizeLabel(csubCampaignNameValue(r));
    const leadStats = csubCampaignLeadStatsByNorm[leadNorm];
    const acceptedRejectedLabel = leadStats ? `${leadStats.accepted} / ${leadStats.rejected}` : '—';
    const acceptRate = csubCampaignAcceptRate(leadNorm);
    const acceptRateLabel = acceptRate == null ? '—' : `${Math.round(acceptRate * 100)}%`;
    const acceptRateColor = acceptRate == null ? 'var(--text-dim)' : acceptRate >= 0.5 ? 'var(--good)' : 'var(--danger)';
    // A placeholder has no ghl_form_submissions row for csub-delete-btn to
    // target -- it IS a lead_submission_forms row though, so Delete here
    // removes the form itself instead (same action, same confirm wording,
    // as the "Submission Forms Creator" panel's own delete button).
    const deleteCell = myIsOwner
      ? (r.isPlaceholder
          ? `<td><button class="btn-secondary csub-delete-form-btn" data-form-id="${r.formId}" data-name="${escapeHtml(csubCampaignNameValue(r))}" style="width:auto; padding:4px 10px; font-size:10px; color:var(--danger); border-color:var(--danger);">Delete</button></td>`
          : `<td><button class="btn-secondary csub-delete-btn" data-id="${r.id}" style="width:auto; padding:4px 10px; font-size:10px; color:var(--danger); border-color:var(--danger);">Delete</button></td>`)
      : '';
    return `<tr${r.isPlaceholder ? ' style="color:var(--text-dim);"' : ''}>
      <td class="mono" style="color:var(--text-2);">${submitted}</td>
      <td>${escapeHtml(csubCampaignNameValue(r))}</td>
      <td>${escapeHtml(clientDetails)}</td>
      <td>${escapeHtml(csubCampaignDialerLabel(r))}</td>
      <td>${escapeHtml(csubCampaignDataLabel(r))}</td>
      <td>${escapeHtml(csubCampaignStaffingLabel(r))}</td>
      <td>${escapeHtml(csubCampaignPackageLabel(r))}</td>
      <td class="mono" style="color:var(--text-2);">${escapeHtml(csubCampaignActiveUntilLabel(r))}</td>
      <td><span class="mono" style="color:${statusInfo.color}; font-size:11px;">${escapeHtml(statusInfo.label)}</span></td>
      <td class="mono">${acceptedRejectedLabel}</td>
      <td class="mono" style="color:${acceptRateColor};">${acceptRateLabel}</td>
      <td>${csubMarketingCell((csubCampaignSubsByNorm[csubNormalizeLabel(csubCampaignNameValue(r))] || {}).client_id)}</td>
      ${deleteCell}
    </tr>`;
  }).join('');
}
if($('csubCampaignStatusFilter')) $('csubCampaignStatusFilter').addEventListener('change', () => { if(csubActiveSection === 'campaign') renderCsubCampaignTable(); });
if($('csubCampaignPackageFilter')) $('csubCampaignPackageFilter').addEventListener('change', () => { if(csubActiveSection === 'campaign') renderCsubCampaignTable(); });

// ---------------------------------------------------------------------------
// v274: "Buy a list" fulfillment — client_list_orders (own table, not the
// generic ghl_form_submissions jsonb) so this has fixed columns + a real
// status/file_url instead of trying to bolt an upload action onto the
// dynamic-columns Data Form table above. Direct table access via this
// staff member's own session — see v274-client-list-orders.sql's RLS
// (is_admin() / role_has_any_tab('client_submissions'), edit gated by
// role_can_edit_tab('client_submissions')).
// ---------------------------------------------------------------------------
let csubListOrders = [];
// v445: search/filter/sort -- all client-side, same reasoning as v444's
// Data Orders search (the full row set is already pulled in one shot).
let csubListOrdersSearchQuery = '';
let csubListOrdersStatusFilterValue = '';
let csubListOrdersSortKey = 'created_at';
let csubListOrdersSortDir = 'desc';

async function loadCsubListOrders(){
  const bodyEl = $('csubListOrdersTableBody');
  // v289: 'pending_payment' rows (client hasn't paid, or abandoned
  // checkout) are deliberately excluded -- there's no linked
  // ghl_form_submissions row for them yet either, so there's nothing here
  // for staff to act on. See client-list-orders/index.ts's create_order
  // and public-skiptrace's finalizeListOrder for the paid-request flow.
  const { data, error } = await sb.from('client_list_orders')
    .select('id, client_id, type_of_leads, property_type, target_market, other_details, record_count, price_cents, status, file_name, file_url, file_path, created_at, client_accounts(full_name, email)')
    .in('status', ['pending', 'fulfilled'])
    .order('created_at', { ascending: false })
    .limit(200);
  if(error){
    console.error('Failed to load list orders', error);
    if(bodyEl) bodyEl.innerHTML = `<tr><td colspan="8" style="color:var(--danger);">Failed to load: ${escapeHtml(error.message)}</td></tr>`;
    return;
  }
  csubListOrders = data || [];
  renderCsubListOrders();
}

// Free-text search matches lead type/property type/target market/details
// plus the client's own name/email -- case-insensitive substring, same
// convention v444's Data Orders search and every other simple text filter
// in this file already use.
function csubListOrdersMatchesSearch(o, q){
  if(!q) return true;
  const haystack = [
    o.type_of_leads, o.property_type, o.target_market, o.other_details,
    o.client_accounts?.full_name, o.client_accounts?.email,
  ].map(v => (v || '').toString().toLowerCase()).join(' ');
  return haystack.includes(q);
}
function csubListOrdersSortCompare(a, b){
  let av = a[csubListOrdersSortKey], bv = b[csubListOrdersSortKey];
  if(csubListOrdersSortKey === 'record_count'){ av = Number(av) || 0; bv = Number(bv) || 0; }
  else { av = av == null ? '' : String(av); bv = bv == null ? '' : String(bv); }
  if(av < bv) return csubListOrdersSortDir === 'asc' ? -1 : 1;
  if(av > bv) return csubListOrdersSortDir === 'asc' ? 1 : -1;
  return 0;
}
function renderCsubListOrdersHead(){
  const head = $('csubListOrdersHead');
  if(!head) return;
  const sortTh = (key, label) => {
    const indicator = csubListOrdersSortKey === key ? (csubListOrdersSortDir === 'asc' ? ' &#9650;' : ' &#9660;') : '';
    return `<th class="csub-lo-sort-th" data-sort-key="${key}" style="cursor:pointer;">${label}${indicator}</th>`;
  };
  head.innerHTML = `<tr>
    ${sortTh('created_at', 'Submitted')}${sortTh('type_of_leads', 'Type of Leads')}${sortTh('property_type', 'Property Type')}
    <th>Target Market</th><th>Details</th>${sortTh('record_count', 'Records')}${sortTh('status', 'Status')}<th></th>
  </tr>`;
}
function renderCsubListOrders(){
  const bodyEl = $('csubListOrdersTableBody');
  if(!bodyEl) return;
  renderCsubListOrdersHead();
  const q = csubListOrdersSearchQuery.trim().toLowerCase();
  const filtered = csubListOrders
    .filter(o => csubListOrdersMatchesSearch(o, q) && (!csubListOrdersStatusFilterValue || o.status === csubListOrdersStatusFilterValue))
    .sort(csubListOrdersSortCompare);
  const countEl = $('csubListOrdersResultCount');
  if(countEl){
    countEl.textContent = (q || csubListOrdersStatusFilterValue)
      ? `Showing ${filtered.length.toLocaleString()} of ${csubListOrders.length.toLocaleString()} requests`
      : '';
  }
  if(!csubListOrders.length){
    bodyEl.innerHTML = '<tr><td colspan="8" style="color:var(--text-dim);">No list requests yet.</td></tr>';
    return;
  }
  if(!filtered.length){
    bodyEl.innerHTML = '<tr><td colspan="8" style="color:var(--text-dim);">No requests match this search.</td></tr>';
    return;
  }
  // v366: was canEditTab('client_submissions') from when this card lived
  // under Data Form there -- now uses this subtab's own granular Edit
  // grant instead (DATA_SCIENCE_SECTIONS' list_orders), same pattern
  // Skip Trace's Import/Export/Email already use just above.
  const canFulfill = canEditDataSciSection('list_orders');
  const listOrdersTz = nonAgentDisplayTz();
  bodyEl.innerHTML = filtered.map(o => {
    const submitted = o.created_at ? new Date(o.created_at).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(listOrdersTz ? { timeZone: listOrdersTz } : {}) }) : '—';
    const clientLabel = o.client_accounts ? (o.client_accounts.full_name || o.client_accounts.email || '') : '';
    const recordsLabel = o.record_count ? `${Number(o.record_count).toLocaleString()}${o.price_cents != null ? ` ($${(o.price_cents / 100).toFixed(2)})` : ''}` : '—';
    const statusHtml = o.status === 'fulfilled'
      ? `<span class="mono" style="color:var(--good); text-transform:uppercase; font-size:10px;">Ready</span>`
      : `<span class="mono" style="color:var(--away); text-transform:uppercase; font-size:10px;">Pending</span>`;
    let actionHtml = '';
    if(o.status === 'fulfilled' && (o.file_path || o.file_url)){
      actionHtml += `<button class="btn-secondary csub-list-order-view-btn" data-order-id="${o.id}" style="width:auto; padding:4px 8px; font-size:10px; margin-right:6px;">View</button>`;
    }
    if(canFulfill){
      actionHtml += `<button class="btn-secondary csub-list-order-upload-btn" data-order-id="${o.id}" style="width:auto; padding:4px 8px; font-size:10px;">${o.status === 'fulfilled' ? 'Replace list' : 'Upload list'}</button>`;
    }
    if(o.status !== 'fulfilled'){
      actionHtml += ` <button class="btn-secondary lbm-open-btn owner-admin-export-only" data-order-type="list_order" data-order-id="${o.id}" style="width:auto; padding:4px 8px; font-size:10px;">Match</button>`;
    }
    if(myIsOwner){
      actionHtml += ` <button class="btn-secondary csub-list-order-delete-btn" data-order-id="${o.id}" style="width:auto; padding:4px 8px; font-size:10px; color:var(--danger); border-color:var(--danger);">Delete</button>`;
    }
    return `<tr>
      <td class="mono" style="color:var(--text-2); font-size:11px;">${submitted}${clientLabel ? `<br><span style="color:var(--text-dim);">${escapeHtml(clientLabel)}</span>` : ''}</td>
      <td>${escapeHtml(o.type_of_leads || '—')}</td>
      <td>${escapeHtml(o.property_type || '—')}</td>
      <td>${escapeHtml(o.target_market || '—')}</td>
      <td style="max-width:220px;">${escapeHtml(o.other_details || '—')}</td>
      <td class="mono" style="font-size:11px;">${escapeHtml(recordsLabel)}</td>
      <td>${statusHtml}</td>
      <td>${actionHtml}</td>
    </tr>`;
  }).join('');
  applyOwnerAdminExportGating(bodyEl);
}
$('csubListOrdersSearchInput')?.addEventListener('input', () => { csubListOrdersSearchQuery = $('csubListOrdersSearchInput').value; renderCsubListOrders(); });
$('csubListOrdersStatusFilter')?.addEventListener('change', () => { csubListOrdersStatusFilterValue = $('csubListOrdersStatusFilter').value; renderCsubListOrders(); });
$('csubListOrdersHead')?.addEventListener('click', (e) => {
  const th = e.target.closest('.csub-lo-sort-th');
  if(!th) return;
  const key = th.dataset.sortKey;
  if(csubListOrdersSortKey === key) csubListOrdersSortDir = (csubListOrdersSortDir === 'asc') ? 'desc' : 'asc';
  else { csubListOrdersSortKey = key; csubListOrdersSortDir = 'asc'; }
  renderCsubListOrders();
});

let csubListOrderUploadTargetId = null;
document.addEventListener('click', (e) => {
  const btn = e.target.closest('.csub-list-order-upload-btn');
  if(!btn) return;
  csubListOrderUploadTargetId = btn.dataset.orderId;
  $('csubListOrderUploadInput').click();
});

// v682: owner-only delete. Order Readiness reads open orders live but keeps a
// per-session copy, so it is re-fetched right after -- a deleted order must
// not linger there.
document.addEventListener('click', async (e) => {
  const btn = e.target.closest('.csub-list-order-delete-btn');
  if(!btn || !myIsOwner) return;
  const order = csubListOrders.find(o => o.id === btn.dataset.orderId);
  if(!order) return;
  const who = order.client_accounts ? (order.client_accounts.full_name || order.client_accounts.email || 'this client') : 'this client';
  const what = `${order.target_market || 'no market given'}${order.record_count ? `, ${Number(order.record_count).toLocaleString()} records` : ''}`;
  if(!confirm(`Delete the list request from ${who} (${what})?${order.status === 'fulfilled' ? ' The client loses access to the delivered list.' : ''} This can't be undone.`)) return;
  btn.disabled = true;
  const { data: gone, error } = await sb.from('client_list_orders').delete().eq('id', order.id).select('id');
  if(error || !gone || !gone.length){
    alert(error ? `Couldn't delete: ${error.message}` : 'Nothing was deleted — your role may not be allowed to delete list requests.');
    btn.disabled = false;
    return;
  }
  if(order.file_path) sb.storage.from('client-list-orders').remove([order.file_path]);
  logActivity('client_list_order.delete', 'client_list_order', order.id, `Deleted list request (${what})`);
  loadCsubListOrders();
  loadOrderReadiness(true);
});

// SECURITY FIX (audit finding edge_audit_skiptrace.md M4, prep): was a
// plain <a href="${o.file_url}"> straight to the client-list-orders
// bucket's public CDN URL -- same PII exposure (owner names/addresses in
// the delivered CSV) as finance-invoices had before it went private/
// signed-URL-only (see financeInvoiceDownloadBtn's own "Private bucket --
// always a signed URL, never getPublicUrl()" comment). Mirrors that same
// pattern here: file_path is the bare storage path (added alongside the
// legacy file_url by v408-client-list-orders-signed-url-prep.sql /
// staff-list-builder's buildAndUploadListOrderCsv + the manual-upload
// handler right below), createSignedUrl() needs a bare path, not a public
// URL. NOTE: the client-list-orders bucket itself is still public today
// (see that migration's comment for why the flip is deliberately
// deferred) -- this still works fine against a public bucket (Storage
// serves a real signed URL either way), it just isn't the ONLY way to
// reach the file yet the way it already is for finance-invoices. Falls
// back to the legacy public file_url if file_path is missing (older rows
// created before this fix), so nothing here regresses in the meantime.
document.addEventListener('click', async (e) => {
  const btn = e.target.closest('.csub-list-order-view-btn');
  if(!btn) return;
  const order = csubListOrders.find(o => o.id === btn.dataset.orderId);
  if(!order) return;
  if(!order.file_path){
    if(order.file_url) window.open(order.file_url, '_blank', 'noopener');
    return;
  }
  const { data, error } = await sb.storage.from('client-list-orders').createSignedUrl(order.file_path, 3600);
  if(error){
    // Fall back to the legacy public URL rather than a dead end -- the
    // bucket is still public today, so this should never actually trigger
    // in practice, but a signed-URL API hiccup shouldn't block a working
    // link that's still valid while it stays that way.
    if(order.file_url) window.open(order.file_url, '_blank', 'noopener');
    else alert('Could not open the file: ' + error.message);
    return;
  }
  window.open(data.signedUrl, '_blank', 'noopener');
});
if($('csubListOrderUploadInput')) $('csubListOrderUploadInput').addEventListener('change', async (e) => {
  const file = e.target.files[0];
  e.target.value = '';
  if(!file || !csubListOrderUploadTargetId) return;
  const orderId = csubListOrderUploadTargetId;
  csubListOrderUploadTargetId = null;

  const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
  const path = `${orderId}/${Date.now()}-${safeName}`;
  const { error: uploadErr } = await sb.storage.from('client-list-orders').upload(path, file, {
    contentType: file.type || 'application/octet-stream',
  });
  if(uploadErr){
    alert('Upload failed: ' + uploadErr.message);
    return;
  }
  const { data: pub } = sb.storage.from('client-list-orders').getPublicUrl(path);

  const { data: updatedOrder, error: updateErr } = await sb.from('client_list_orders').update({
    status: 'fulfilled',
    file_name: file.name,
    file_url: pub.publicUrl,
    file_path: path, // see csub-list-order-view-btn's handler above for why
    fulfilled_by: myUserId,
    fulfilled_at: new Date().toISOString(),
  }).eq('id', orderId).select('client_id').maybeSingle();
  if(updateErr){
    alert('File uploaded, but marking the order ready failed: ' + updateErr.message);
    return;
  }
  // v365: "Your list request" notification (User Management -> Notifications
  // Setting) -- fire-and-forget, same as every other client SMS/email in this
  // file; callSendClientSms also fires the email leg, and both honor the
  // on/off + SMS/Email/Notification Center channel picker server-side.
  // Orders placed by a portal account have client_id; ones taken over
  // phone/manually may not, and there's nothing to notify in that case.
  if(updatedOrder && updatedOrder.client_id) callSendClientSms(updatedOrder.client_id, 'list_request', null);
  loadCsubListOrders();
});

function populateCsubFormFilterOptions(){
  const sel = $('csubFormFilter');
  const prev = sel.value;
  const forms = Array.from(new Set(csubAllRows.map(r => r.form_name || '(untitled form)'))).sort();
  sel.innerHTML = '<option value="">All forms</option>' + forms.map(f => `<option value="${escapeHtml(f)}">${escapeHtml(f)}</option>`).join('');
  sel.value = prev;
}

// v96 item 3: "Campaign Name" is one of the form's own custom fields (read
// the same dynamic way csubServiceValue() reads the service question),
// not a fixed schema column — pulled out here so both the filter dropdown
// and the row-matching below use the exact same extraction.
function csubCampaignNameValue(row){
  const fields = row.fields || {};
  const key = Object.keys(fields).find(k => csubNormalizeLabel(k) === csubNormalizeLabel('Campaign Name'));
  return key ? String(fields[key] || '').trim() : '';
}
function populateCsubCampaignFilterOptions(){
  const sel = $('csubCampaignFilter');
  if(!sel) return;
  const prev = sel.value;
  const campaigns = Array.from(new Set(csubAllRows.map(csubCampaignNameValue).filter(Boolean))).sort();
  sel.innerHTML = '<option value="">All campaigns</option>' + campaigns.map(c => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
  sel.value = prev;
}

function csubFilteredRows(){
  const formVal = $('csubFormFilter') ? $('csubFormFilter').value : '';
  const campaignVal = $('csubCampaignFilter') ? $('csubCampaignFilter').value : '';
  let rows = csubAllRows;
  if(formVal) rows = rows.filter(r => (r.form_name || '(untitled form)') === formVal);
  if(campaignVal) rows = rows.filter(r => csubCampaignNameValue(r) === campaignVal);
  return rows;
}

// v94: date/form-filtered rows, further narrowed to whichever of the two
// subtabs is asking (a Cold Caller package submission legitimately passes
// both, by design — see csubRoutesFor()).
function csubFilteredRowsForSection(section){
  return csubFilteredRows().filter(r => csubRoutesFor(r).includes(section));
}

function renderCsubDashboard(){
  const now = new Date();
  const weekAgo = new Date(now); weekAgo.setDate(weekAgo.getDate() - 7);
  const monthAgo = new Date(now); monthAgo.setDate(monthAgo.getDate() - 30);

  const total = csubAllRows.length;
  const thisWeek = csubAllRows.filter(r => new Date(r.submitted_at) >= weekAgo).length;
  const thisMonth = csubAllRows.filter(r => new Date(r.submitted_at) >= monthAgo).length;
  const formSet = new Set(csubAllRows.map(r => r.form_name || '(untitled form)'));

  $('csubStatTotal').textContent = total;
  $('csubStatWeek').textContent = thisWeek;
  $('csubStatMonth').textContent = thisMonth;
  $('csubStatForms').textContent = formSet.size;

  // by form — reuses the "sites visited" bar-row styling, same as Leads'
  // by-agent breakdown above.
  const byForm = {};
  csubAllRows.forEach(r => { const name = r.form_name || '(untitled form)'; byForm[name] = (byForm[name] || 0) + 1; });
  const formRows = Object.entries(byForm).sort((a, b) => b[1] - a[1]);
  const byFormDiv = $('csubByForm');
  if(!formRows.length){
    byFormDiv.innerHTML = '<div class="empty">No submissions in this range.</div>';
  } else {
    const maxCount = formRows[0][1];
    byFormDiv.innerHTML = formRows.map(([name, count]) => `
      <div class="site-row">
        <div class="site-domain" title="${escapeHtml(name)}">${escapeHtml(name)}</div>
        <div class="site-bar-track"><div class="site-bar-fill" style="width:${Math.max(2, count / maxCount * 100)}%"></div></div>
        <div class="site-time">${count}</div>
      </div>`).join('');
  }

  // last 14 days trend
  // v395: bucketed by raw `.toISOString().slice(0,10)`/`.slice(0,10)` --
  // both a fixed UTC calendar day, regardless of the "Times shown in"
  // toggle. A submission near a day boundary could land in the "wrong"
  // day bucket relative to what the toggle says "today" is (same bug
  // class as the Leads-by-day chart below). localDateKeyInZone gives the
  // calendar day in the SAME zone the toggle displays everything else in.
  const csubDashboardTz = nonAgentDisplayTz() || FALLBACK_TIMEZONE;
  const days = [];
  for(let i = 13; i >= 0; i--){ const d = new Date(); d.setDate(d.getDate() - i); days.push(localDateKeyInZone(d, csubDashboardTz)); }
  const byDay = {}; days.forEach(d => byDay[d] = 0);
  csubAllRows.forEach(r => { const d = r.submitted_at ? localDateKeyInZone(r.submitted_at, csubDashboardTz) : ''; if(d in byDay) byDay[d]++; });
  const maxDay = Math.max(1, ...Object.values(byDay));
  $('csubByDay').innerHTML = days.map(d => {
    const count = byDay[d];
    const label = new Date(d + 'T00:00:00').toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
    return `
      <div class="site-row">
        <div class="site-domain">${label}</div>
        <div class="site-bar-track"><div class="site-bar-fill" style="width:${count / maxDay * 100}%"></div></div>
        <div class="site-time">${count}</div>
      </div>`;
  }).join('');

  // "Most common answers" — a lightweight, generic stand-in for "market/
  // criteria insights" without knowing any specific client's form field
  // names ahead of time: pick whichever custom fields are actually filled
  // in most consistently across the loaded submissions (a reasonable
  // proxy for "the questions this form actually collects real signal
  // on"), then show each one's most common values. Skips any field with
  // too many distinct values to be a meaningful "criteria" breakdown
  // (e.g. a free-text name/comment field) — more than half as many
  // distinct values as rows suggests it's closer to free text than a
  // multiple-choice/criteria-style answer.
  const fieldFillCounts = {};
  const fieldValueCounts = {};
  csubAllRows.forEach(r => {
    Object.entries(r.fields || {}).forEach(([k, v]) => {
      if(v === null || v === undefined || v === '') return;
      fieldFillCounts[k] = (fieldFillCounts[k] || 0) + 1;
      const valStr = String(v);
      (fieldValueCounts[k] ||= {});
      fieldValueCounts[k][valStr] = (fieldValueCounts[k][valStr] || 0) + 1;
    });
  });
  const topFieldsDiv = $('csubTopFields');
  const candidateFields = Object.entries(fieldFillCounts)
    .filter(([k, fillCount]) => {
      const distinctCount = Object.keys(fieldValueCounts[k]).length;
      return fillCount >= 3 && distinctCount <= Math.max(5, fillCount * 0.5);
    })
    .sort((a, b) => b[1] - a[1])
    .slice(0, 4);
  if(!candidateFields.length){
    topFieldsDiv.innerHTML = '<div class="empty">Not enough repeated-answer fields yet to show a breakdown — check the Data Form / Client Qualification Form tabs for the raw data.</div>';
  } else {
    topFieldsDiv.innerHTML = candidateFields.map(([field, fillCount]) => {
      const values = Object.entries(fieldValueCounts[field]).sort((a, b) => b[1] - a[1]).slice(0, 6);
      const maxVal = values[0][1];
      return `
        <div style="margin-bottom:16px;">
          <div class="mono" style="font-size:11px; color:var(--text-2); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;">${escapeHtml(field)} <span style="color:var(--text-dim); text-transform:none;">(${fillCount} answered)</span></div>
          ${values.map(([val, count]) => `
            <div class="site-row">
              <div class="site-domain" title="${escapeHtml(val)}">${escapeHtml(val)}</div>
              <div class="site-bar-track"><div class="site-bar-fill" style="width:${Math.max(2, count / maxVal * 100)}%"></div></div>
              <div class="site-time">${count}</div>
            </div>`).join('')}
        </div>`;
    }).join('');
  }
}

// v94: one generic renderer for both subtabs — 'data' or 'qualification' —
// each narrowed to its own routed rows (csubFilteredRowsForSection) and its
// own field subset (csubFieldBelongsToSection), replacing the old single
// flat renderCsubFormTable().
// v96: item 1/2 — the Form column shows a computed label based on which
// service was actually selected, instead of the raw GHL form_name (which
// is typically just the workflow's own name, e.g. "onboarding Form
// Submitted" — not meaningful to an admin scanning this table). Client
// Qualification Form always shows the same fixed label regardless of
// which service was picked (item 2); Data Form varies by service (item 1).
const CSUB_DATA_ORDER_DISPLAY_NAME = 'Data Order Request';
const CSUB_SKIPTRACING_DISPLAY_NAME = 'Skiptracing Request';
const CSUB_QUALIFICATION_DISPLAY_NAME = 'Client Qualification Form';
function csubDisplayFormName(row, section){
  if(section === 'qualification') return CSUB_QUALIFICATION_DISPLAY_NAME;
  return csubServiceValue(row).toLowerCase() === 'skiptracing' ? CSUB_SKIPTRACING_DISPLAY_NAME : CSUB_DATA_ORDER_DISPLAY_NAME;
}

// v96: item 4 — Export CSV / Download are Owner/Admin only, on every
// sub-tab of Leads and Client Submissions. Applied by hiding any element
// carrying this marker class; called once after sign-in for the static
// buttons and again after any dynamic content (e.g. per-row Download
// buttons) is rendered.
function applyOwnerAdminExportGating(scopeEl){
  const scope = scopeEl || document;
  const allowed = myIsOwner || myRole === 'admin';
  scope.querySelectorAll('.owner-admin-export-only').forEach(el => { el.style.display = allowed ? '' : 'none'; });
}

function renderCsubSectionTable(section){
  const rows = csubFilteredRowsForSection(section);
  const dynamicKeys = Array.from(new Set(rows.flatMap(r => Object.keys(r.fields || {}))))
    .filter(k => csubFieldBelongsToSection(k, section))
    // v96 item 6: the service-selector question is now fully redundant
    // with the computed Form column above (csubDisplayFormName) — drop
    // BOTH label variants ("Please select…" / "Check one of…") rather
    // than showing either as its own duplicate-looking column.
    .filter(k => !CSUB_SERVICE_KEY_PATTERN.test(k))
    // v283: drop Full Name/Phone/Email from the dynamic columns -- they
    // already have their own fixed Name/Phone/Email columns above.
    .filter(k => !CSUB_TABLE_DUPLICATE_FIELDS.has(csubNormalizeLabel(k)))
    .sort();
  const headEl = section === 'data' ? $('csubDataFormTableHead') : $('csubQualFormTableHead');
  const bodyEl = section === 'data' ? $('csubDataFormTableBody') : $('csubQualFormTableBody');
  // v96 item 7: Phone/Email are dropped from Client Qualification Form
  // only — Data Form keeps all 3 fixed contact columns.
  const showPhoneEmail = section !== 'qualification';
  // v282: Owner-only "delete the entire record" column — same is_owner()
  // policy as All Queue's ghl_form_submissions delete (v276), just
  // reachable right from this table instead of All Queue.
  headEl.innerHTML = '<th>Submitted</th><th>Form</th><th>Name</th>' + (showPhoneEmail ? '<th>Phone</th><th>Email</th>' : '') +
    dynamicKeys.map(k => `<th>${escapeHtml(k)}</th>`).join('') + (myIsOwner ? '<th>Delete</th>' : '');

  const fixedColCount = (showPhoneEmail ? 5 : 3) + (myIsOwner ? 1 : 0);
  if(!rows.length){
    bodyEl.innerHTML = `<tr><td colspan="${fixedColCount + dynamicKeys.length}" style="color:var(--text-dim);">No submissions in this range.</td></tr>`;
    return;
  }
  // v152: Owner/Admin can now correct a submitted row directly (typo'd
  // name/phone/email, a wrong answer, etc.) instead of the table being
  // pure read-only — every other role still sees plain text. See
  // saveCsubField() and the delegated focusout listener below for the
  // actual save; RLS backs this with an admin-only UPDATE policy on
  // ghl_form_submissions (see supabase/v152-incremental-schema.sql).
  const canEditCsub = myIsOwner || myRole === 'admin';
  bodyEl.innerHTML = rows.map(r => {
    // v92: no per-row agent here (a form submission isn't tied to a
    // staff member), so "agent local" in the global toggle has nothing
    // to resolve to — falls back to browser local same as it would for
    // an agent with no schedule/timezone set anywhere else in the app.
    const csubTz = globalDisplayTzMode === 'agent' ? undefined : globalDisplayTzMode;
    const submitted = r.submitted_at ? new Date(r.submitted_at).toLocaleString([], { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', ...(csubTz ? { timeZone: csubTz } : {}) }) : '—';
    const editableCell = (field, value) => canEditCsub
      ? `<span class="csub-editable-cell" contenteditable="true" data-id="${r.id}" data-field="${field}" data-original="${escapeHtml(value || '')}">${escapeHtml(value || '')}</span>`
      : escapeHtml(value || '—');
    const fixedCells = `
      <td class="mono" style="color:var(--text-2);">${submitted}</td>
      <td>${escapeHtml(csubDisplayFormName(r, section))}</td>
      <td>${editableCell('contact_name', r.contact_name)}</td>` + (showPhoneEmail ? `
      <td class="mono">${editableCell('contact_phone', r.contact_phone)}</td>
      <td>${editableCell('contact_email', r.contact_email)}</td>` : '');
    const dynamicCells = dynamicKeys.map(k => `<td>${csubFieldValueHtml(k, r.fields ? r.fields[k] : null, canEditCsub, r.id)}</td>`).join('');
    const deleteCell = myIsOwner ? `<td><button class="btn-secondary csub-delete-btn" data-id="${r.id}" style="width:auto; padding:4px 10px; font-size:10px; color:var(--danger); border-color:var(--danger);">Delete</button></td>` : '';
    return `<tr>${fixedCells}${dynamicCells}${deleteCell}</tr>`;
  }).join('');
  // Download buttons (Skiptracing attachments) were just (re)rendered
  // above — re-apply Owner/Admin-only gating to them (item 4).
  applyOwnerAdminExportGating(bodyEl);
}

// v282: Owner-only, permanently deletes the entire ghl_form_submissions
// row — the same record behind Data Form, Client Qualification Form, and
// (if it's the qualification row) Campaign Guide, so this is the same
// "delete entirely" action as All Queue's own Owner-only delete (v276)
// and Campaign Guide's own "Delete campaign" button, just reachable
// directly from these two tables too. One delegated listener on both
// table bodies, since renderCsubSectionTable renders both from the same
// function.
// v358: which table to re-render after a delete is now determined by
// WHICH tbody the click came from (the loop's own `id`), not
// csubActiveSection -- csubDataFormTableBody lives under the Data Science
// tab now, so a delete from there no longer reliably lines up with
// whatever csubActiveSection happens to still be set to on the Client
// Submissions side.
['csubDataFormTableBody', 'csubQualFormTableBody', 'csubCampaignTableBody'].forEach(id => {
  const el = $(id);
  if(!el) return;
  el.addEventListener('click', async (e) => {
    const btn = e.target.closest('.csub-delete-btn');
    if(!btn || !myIsOwner) return;
    if(!confirm('Permanently delete this submission? This removes it from Data Form, Client Qualification Form, and Campaign Guide alike. This can’t be undone.')) return;
    btn.disabled = true;
    const { error } = await sb.from('ghl_form_submissions').delete().eq('id', btn.dataset.id);
    if(error){ alert(error.message); btn.disabled = false; return; }
    logActivity('client_submission.delete', 'ghl_form_submission', btn.dataset.id, 'Deleted a client submission record');
    csubAllRows = csubAllRows.filter(r => r.id !== btn.dataset.id);
    if(id === 'csubCampaignTableBody') renderCsubCampaignTable();
    else if(id === 'csubQualFormTableBody') renderCsubSectionTable('qualification');
    else renderCsubSectionTable('data'); // csubDataFormTableBody -- lives under Data Science now
    if(campaignGuidesLoaded) loadCampaignGuide();
  });
});

// v306: "No request submitted" campaign rows (a lead_submission_forms row
// with no self-serve request or GHL submission behind it -- e.g. one
// created directly via Submission Forms Creator, or manually granted to a
// client) previously had no Delete at all here. Same underlying action as
// Submission Forms Creator's own delete button (sb.from('lead_submission_
// forms').delete()), just reachable from this table too, with the same
// "leads keep their data" wording since that's still true here.
if($('csubCampaignTableBody')) $('csubCampaignTableBody').addEventListener('click', async (e) => {
  const btn = e.target.closest('.csub-delete-form-btn');
  if(!btn || !myIsOwner) return;
  const formId = btn.dataset.formId;
  const name = btn.dataset.name || 'this campaign';
  if(!confirm(`Delete the "${name}" form? Its fields go with it. Leads already submitted through it keep their data — this only removes it from the picker going forward.`)) return;
  btn.disabled = true;
  const { error } = await sb.from('lead_submission_forms').delete().eq('id', formId);
  if(error){ alert(`Couldn't delete "${name}": ${error.message}`); btn.disabled = false; return; }
  // v320: same client-grant cleanup as Campaign Guide's "Delete campaign"
  // button — client_campaign_access references this form_id directly
  // (now gone), and client_campaign_guide_access is keyed by name; neither
  // was ever revoked here, leaving any granted client staring at a
  // permanently-empty campaign/guide entry for a form that no longer
  // exists anywhere else.
  await sb.from('client_campaign_access').delete().eq('form_id', formId);
  await sb.from('client_campaign_guide_access').delete().eq('campaign_norm_name', csubNormalizeLabel(name));
  logActivity('lead_submission_form.delete', null, null, `Deleted submission form "${name}" from Campaigns`);
  csubActiveCampaignForms = csubActiveCampaignForms.filter(f => f.id !== formId);
  renderCsubCampaignTable();
});

// v310: staff-side "+ New Campaign" — mirrors the client portal's own
// Create Campaign form field-for-field (same qa keys staff-create-campaign
// expects), plus a client picker and a "Complimentary" checkbox that
// bypasses payment entirely. See staff-create-campaign/index.ts.
// v313: field TYPES now mirror the client portal's own "+ Create Campaign"
// modal (checkboxGroupHtml/radioGroupHtml over there) instead of every
// answer being a generic single-line text input -- same option lists,
// ported from portal/client-portal.html's openCreateCampaignModal(). Every
// field stays required here too, same as the client's own version (the
// asterisk in each label below is real -- see REQUIRED_CAMP_FIELDS-style
// check in the submit handler).
const CSUB_YES_NO = ['Yes', 'No'];
// v764: mirrors the client portal, where the data option has always shown its
// record count and now also shows the free Email Marketing seat. Record counts
// match DATA_RECORDS_BY_TIER in client-create-campaign.
const CSUB_DATA_RECORDS_BY_TIER = { part_time: 7500, full_time: 10000 };
function csubUpdateCampaignDataHint(){
  const el = $('csubNewCampaignDataHint');
  if(!el) return;
  const tier = ($('csubNewCampaignTier') || {}).value || 'full_time';
  const data = ($('csubNewCampaignData') || {}).value || 'own';
  const records = CSUB_DATA_RECORDS_BY_TIER[tier] || CSUB_DATA_RECORDS_BY_TIER.full_time;
  if(data !== 'ours'){
    el.innerHTML = `The client supplies roughly <b>${records.toLocaleString()}</b> records a month for the caller to work.`;
    return;
  }
  const seat = tier === 'full_time'
    ? ' &middot; includes <b>Email Marketing</b>: 1 seat, 10,000 emails a month, free'
    : ' &middot; no Email Marketing seat (Full-time on our data only)';
  el.innerHTML = `We supply <b>${records.toLocaleString()}</b> records a month${seat}.`;
}
// v764: the script feeds the AI draft as well as the guide, so it has to reach
// storage before drafting -- not at Create time. Uploaded once and remembered,
// so drafting then creating does not store two copies.
let csubScriptUpload = null;   // { file, path, name }
async function csubEnsureScriptUploaded(clientId){
  const input = $('csubNewCampaignScript');
  const file = input && input.files && input.files[0];
  if(!file) return { path: null, name: null };
  if(csubScriptUpload && csubScriptUpload.file === file && csubScriptUpload.clientId === clientId){
    return { path: csubScriptUpload.path, name: csubScriptUpload.name };
  }
  if(file.size > 10 * 1024 * 1024) return { error: "That caller script is over 10 MB." };
  const safeName = file.name.replace(/[^\w.\- ]+/g, '_').slice(-120);
  const path = `${clientId}/${Date.now()}-${safeName}`;
  const { error } = await sb.storage.from('campaign-attachments')
    .upload(path, file, { upsert: false, contentType: file.type || 'application/octet-stream' });
  if(error) return { error: 'Could not upload the caller script: ' + error.message };
  csubScriptUpload = { file, path, name: file.name, clientId };
  return { path, name: file.name };
}
function csubSelectedCampaignKind(){
  const c = document.querySelector('input[name="csubNewCampaignQaRadio-campaignKind"]:checked');
  return (c && c.value === 'Other industry') ? 'other' : 'real_estate';
}
function csubApplyCampaignKind(){
  const kind = csubSelectedCampaignKind();
  const aiWrap = document.getElementById('csubNewCampaignAiWrap');
  if(aiWrap) aiWrap.style.display = kind === 'other' ? '' : 'none';
  document.querySelectorAll('#csubNewCampaignQaFields .csub-qa-field').forEach(el => {
    const k = el.dataset.qaKind || 'real_estate';
    el.style.display = (k === 'both' || k === kind) ? '' : 'none';
  });
}
const CSUB_NEW_CAMPAIGN_QA_FIELDS = [
  // v763: mirrors the client portal. 'both' shows on either kind; everything
  // without a kind is real-estate-only, which is every pre-existing field.
  { key: 'campaignKind', label: 'Campaign type *', type: 'radio', options: ['Real estate', 'Other industry'], kind: 'both' },
  { key: 'typeOfLeads', label: 'Type of Leads *', type: 'checkbox', options: ['Absentee Owner', 'High Equity', 'Tired Landlord', 'Pre-Probate (Senior Owners)', 'Pre-foreclosure', 'Tax Delinquent', 'Divorce'] },
  { key: 'propertyType', label: 'Property Type *', type: 'checkbox', options: ['Single Family Home', 'Multi- Family Home 2-4', 'Townhouse', 'Condo', 'Vacant lots', 'Mobile Homes', 'Land', 'Multi- Family Home 5+ (commercial)', 'Commercial', 'Agriculture'] },
  { key: 'targetMarket', label: 'Target Market *', type: 'textarea' },
  { key: 'validReasonForSelling', label: 'Valid reason for selling required? *', type: 'radio', options: ['Valid Reason and Right Offer', 'Valid Reason Only'] },
  { key: 'acceptListedProperties', label: 'Accept listed properties? *', type: 'checkbox', options: ['Listed by a Realtor/Owner', 'Only listed by owner', 'Listed but the seller promised to remove it', 'NO LISTED AT ALL'] },
  { key: 'coverRealtorCommission', label: 'Cover Realtor commission/fees? *', type: 'radio', options: CSUB_YES_NO },
  { key: 'coverClosingFees', label: 'Cover closing fees? *', type: 'radio', options: CSUB_YES_NO },
  { key: 'askAskingPrice', label: 'Ask for "Asking Price"? *', type: 'radio', options: CSUB_YES_NO },
  { key: 'aboveOrBelowMarket', label: 'Above/below market price accepted? *', type: 'radio', options: ['Above and below', 'below only'] },
  { key: 'marketValueSource', label: 'Market value source *', type: 'checkbox', options: ['zillow', 'redfin', 'realtor', 'batch'] },
  { key: 'priceRestrictions', label: 'Property price restrictions *', type: 'textarea' },
  { key: 'maxClosingTimeline', label: 'Max closing timeline *', type: 'radio', options: ['3 months or less', 'up to 6 months', 'up to 1 year'] },
  { key: 'acceptOutsideReferrals', label: 'Accept referrals outside target market? *', type: 'radio', options: CSUB_YES_NO },
  { key: 'askSellerEmail', label: "Ask for seller's email? *", type: 'radio', options: CSUB_YES_NO },
  { key: 'otherDetails', label: 'Other details *', type: 'textarea' },
  { key: 'industry', label: 'Industry *', type: 'textarea', kind: 'other' },
  { key: 'dataCriteria', label: 'Data criteria *', type: 'textarea', kind: 'other' },
  { key: 'marketCoverage', label: 'Market coverage *', type: 'textarea', kind: 'other' },
];
// Same visual convention Submission Forms Creator's own "Visible to"
// checklists use (sf-form-role-cb etc.) -- inline flex label + accent-color
// checkbox/radio, not client-portal.html's .dispute-field-row class, which
// doesn't exist in this stylesheet.
function csubNewCampaignOptionRowHtml(inputHtml, text){
  return `<label style="display:flex; align-items:center; gap:5px; cursor:pointer; text-transform:none; font-family:var(--sans); font-size:12px; color:var(--text-2); font-weight:400;">${inputHtml} ${escapeHtml(text)}</label>`;
}
function csubNewCampaignFieldHtml(f){
  if(f.type === 'checkbox'){
    return `<div class="csub-qa-field" data-qa-kind="${f.kind || 'real_estate'}" style="margin-bottom:10px;">
      <label style="font-size:11px; display:block; margin-bottom:4px;">${escapeHtml(f.label)}</label>
      <div style="display:flex; gap:12px; flex-wrap:wrap;">${f.options.map(o => csubNewCampaignOptionRowHtml(`<input type="checkbox" class="csub-new-campaign-qa-cb" data-key="${f.key}" value="${escapeHtml(o)}" style="width:13px; height:13px; accent-color:var(--focus);">`, o)).join('')}</div>
    </div>`;
  }
  if(f.type === 'radio'){
    return `<div class="csub-qa-field" data-qa-kind="${f.kind || 'real_estate'}" style="margin-bottom:10px;">
      <label style="font-size:11px; display:block; margin-bottom:4px;">${escapeHtml(f.label)}</label>
      <div style="display:flex; gap:12px; flex-wrap:wrap;">${f.options.map(o => csubNewCampaignOptionRowHtml(`<input type="radio" name="csubNewCampaignQaRadio-${f.key}" value="${escapeHtml(o)}" style="width:13px; height:13px; accent-color:var(--focus);">`, o)).join('')}</div>
    </div>`;
  }
  return `<div class="csub-qa-field" data-qa-kind="${f.kind || 'real_estate'}" style="margin-bottom:10px;">
    <label style="font-size:11px;">${escapeHtml(f.label)}</label>
    <textarea class="csub-new-campaign-qa-text" data-key="${f.key}" rows="2" style="width:100%;"></textarea>
  </div>`;
}
async function openCsubNewCampaignModal(){
  const msg = $('csubNewCampaignMsg');
  msg.style.display = 'none';
  $('csubNewCampaignName').value = '';
  $('csubNewCampaignTier').value = 'part_time';
  $('csubNewCampaignDialer').value = 'ours';
  $('csubNewCampaignData').value = 'own';
  $('csubNewCampaignComp').checked = false;
  $('csubNewCampaignCompExpiry').value = '';
  $('csubNewCampaignCompExpiryRow').style.display = 'none';
  $('csubNewCampaignQaFields').innerHTML = CSUB_NEW_CAMPAIGN_QA_FIELDS.map(f => csubNewCampaignFieldHtml(f)).join('');
  // v763: only the half that applies is shown, and csubSelectedCampaignKind()
  // is what the submit handler validates against -- a hidden field is never
  // required, or staff would be blocked by questions they cannot see.
  const kindRadios = document.querySelectorAll('input[name="csubNewCampaignQaRadio-campaignKind"]');
  const firstKind = document.querySelector('input[name="csubNewCampaignQaRadio-campaignKind"][value="Real estate"]');
  if(firstKind) firstKind.checked = true;
  kindRadios.forEach(r => r.addEventListener('change', csubApplyCampaignKind));
  // v764: two drafts per campaign, same as the client portal. Only a successful
  // draft consumes one -- a refused or failed call cost nothing. The real spend
  // backstop is the per-hour limit inside campaign-guide-ai-draft.
  const CSUB_AI_DRAFT_MAX = 2;
  let csubAiDraftsUsed = 0;
  function csubAiSyncLeft(){
    const left = CSUB_AI_DRAFT_MAX - csubAiDraftsUsed;
    const el = $('csubNewCampaignAiLeft');
    if(el) el.textContent = left > 0
      ? `${left} of ${CSUB_AI_DRAFT_MAX} drafts left.`
      : 'No drafts left — edit it under Leads → Campaign Guide instead.';
    const b = $('csubNewCampaignAiBtn');
    if(b && left <= 0) b.disabled = true;
  }
  const aiBtn = $('csubNewCampaignAiBtn');
  if(aiBtn) aiBtn.onclick = async () => {
    if(csubAiDraftsUsed >= CSUB_AI_DRAFT_MAX) return;
    const aiMsg = $('csubNewCampaignAiMsg');
    const clientId = $('csubNewCampaignClient').value;
    const name = $('csubNewCampaignName').value.trim();
    const q = (k) => { const el = document.querySelector(`.csub-new-campaign-qa-text[data-key="${k}"]`); return el ? el.value.trim() : ''; };
    const industry = q('industry'), dataCriteria = q('dataCriteria'), marketCoverage = q('marketCoverage');
    if(!clientId || !name || !industry || !dataCriteria || !marketCoverage){
      aiMsg.style.color = 'var(--danger)';
      aiMsg.textContent = 'Pick a client and fill in the campaign name, industry, data criteria and market coverage first.';
      return;
    }
    // The script is the sharpest input the AI gets -- it shows how this client
    // already qualifies people. Worth one interruption before drafting without it.
    const scriptPicked = (() => { const i = $('csubNewCampaignScript'); return !!(i && i.files && i.files[0]); })();
    if(!scriptPicked && !confirm(
      'If a caller script is attached, our AI reads it and writes a much sharper guide — '
      + 'it can see how this client already qualifies people.\n\nDraft without a script anyway?'
    )) return;
    aiBtn.disabled = true;
    aiMsg.style.color = 'var(--text-2)';
    aiMsg.textContent = 'Uploading the script…';
    const up = await csubEnsureScriptUploaded(clientId);
    if(up.error){ aiBtn.disabled = false; aiMsg.style.color = 'var(--danger)'; aiMsg.textContent = up.error; return; }
    aiMsg.textContent = 'Writing the guide…';
    const { data, error } = await sb.functions.invoke('campaign-guide-ai-draft', {
      body: { campaignDisplayName: name, industry, dataCriteria, marketCoverage,
              callerScriptPath: up.path, callerScriptName: up.name },
    });
    aiBtn.disabled = false;
    if(error || !data || data.ok === false){
      aiMsg.style.color = 'var(--danger)';
      aiMsg.textContent = (data && data.error) || (error && error.message) || 'Could not write the guide.';
      return;
    }
    aiMsg.style.color = 'var(--good)';
    aiMsg.textContent = `Drafted ${data.criteria} criteria — review and approve it under Leads → Campaign Guide.`;
    aiBtn.textContent = 'Redraft with AI';
    csubAiDraftsUsed += 1;
    csubAiSyncLeft();
  };
  csubApplyCampaignKind();
  csubUpdateCampaignDataHint();
  ['csubNewCampaignTier', 'csubNewCampaignData'].forEach(id => {
    const el = $(id); if(el) el.addEventListener('change', csubUpdateCampaignDataHint);
  });
  const sel = $('csubNewCampaignClient');
  sel.innerHTML = '<option value="">Loading…</option>';
  const { data, error } = await sb.from('client_accounts').select('id, full_name, email').eq('is_active', true).order('full_name');
  if(error){ sel.innerHTML = '<option value="">Failed to load clients</option>'; }
  else{
    sel.innerHTML = '<option value="">Select a client…</option>' + (data || []).map(c => `<option value="${c.id}">${escapeHtml(c.full_name)} (${escapeHtml(c.email)})</option>`).join('');
  }
  $('csubNewCampaignModalOverlay').classList.add('active');
}
function closeCsubNewCampaignModal(){ $('csubNewCampaignModalOverlay').classList.remove('active'); }
if($('csubNewCampaignBtn')) $('csubNewCampaignBtn').addEventListener('click', openCsubNewCampaignModal);
if($('csubNewCampaignCancelBtn')) $('csubNewCampaignCancelBtn').addEventListener('click', closeCsubNewCampaignModal);
if($('csubNewCampaignComp')) $('csubNewCampaignComp').addEventListener('change', () => {
  $('csubNewCampaignCompExpiryRow').style.display = $('csubNewCampaignComp').checked ? 'block' : 'none';
});
if($('csubNewCampaignModalOverlay')) $('csubNewCampaignModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'csubNewCampaignModalOverlay') closeCsubNewCampaignModal(); });

if($('csubNewCampaignSubmitBtn')) $('csubNewCampaignSubmitBtn').addEventListener('click', async () => {
  const msg = $('csubNewCampaignMsg');
  msg.style.display = 'none';
  const clientId = $('csubNewCampaignClient').value;
  const campaignName = $('csubNewCampaignName').value.trim();
  const callerTier = $('csubNewCampaignTier').value;
  const dialerChoice = $('csubNewCampaignDialer').value;
  const dataChoice = $('csubNewCampaignData').value;
  const complimentary = $('csubNewCampaignComp').checked;
  const complimentaryExpiresAt = $('csubNewCampaignCompExpiry').value;
  if(!clientId){ msg.textContent = 'Choose a client.'; msg.style.display = 'block'; return; }
  if(!campaignName){ msg.textContent = 'Campaign name is required.'; msg.style.display = 'block'; return; }
  // v343: complimentary campaigns must have a staff-picked active-until
  // date -- see staff-create-campaign's own validation of this same field.
  if(complimentary){
    if(!complimentaryExpiresAt){ msg.textContent = 'Choose the date this complimentary campaign should stay active until.'; msg.style.display = 'block'; return; }
    if(new Date(`${complimentaryExpiresAt}T23:59:59.999Z`).getTime() <= Date.now()){ msg.textContent = 'The active-until date must be in the future.'; msg.style.display = 'block'; return; }
  }
  // v313: every criteria field is required, same as the client portal's
  // own "+ Create Campaign" modal (REQUIRED_CAMP_FIELDS there) -- reads
  // the right control type per field (checkbox group / radio group /
  // textarea) instead of assuming everything is a text input, and
  // collects the missing ones' labels into one message rather than
  // stopping at the first empty field.
  const qaBody = {};
  const missingQaLabels = [];
  const campaignKind = csubSelectedCampaignKind();   // v763
  CSUB_NEW_CAMPAIGN_QA_FIELDS.forEach(f => {
    const fk = f.kind || 'real_estate';
    if(fk !== 'both' && fk !== campaignKind) return;   // v763: not asked, not required
    const cleanLabel = f.label.replace(/\s*\*$/, '');
    if(f.type === 'checkbox'){
      const vals = Array.from(document.querySelectorAll(`.csub-new-campaign-qa-cb[data-key="${f.key}"]:checked`)).map(cb => cb.value);
      if(vals.length) qaBody[f.key] = vals.join(', '); else missingQaLabels.push(cleanLabel);
    } else if(f.type === 'radio'){
      const checked = document.querySelector(`input[name="csubNewCampaignQaRadio-${f.key}"]:checked`);
      if(checked) qaBody[f.key] = checked.value; else missingQaLabels.push(cleanLabel);
    } else {
      const el = document.querySelector(`.csub-new-campaign-qa-text[data-key="${f.key}"]`);
      if(el && el.value.trim()) qaBody[f.key] = el.value.trim(); else missingQaLabels.push(cleanLabel);
    }
  });
  if(missingQaLabels.length){
    msg.textContent = `Please fill in: ${missingQaLabels.join(', ')}.`;
    msg.style.display = 'block';
    return;
  }
  if(complimentary && !confirm(`Create "${campaignName}" as a COMPLIMENTARY campaign? It goes active immediately for this client — no charge, no Stripe checkout ever — and auto-cancels after ${complimentaryExpiresAt} unless extended.`)) return;
  const btn = $('csubNewCampaignSubmitBtn');
  btn.disabled = true;
  btn.textContent = 'Creating…';
  // v763: normalise the radio's label into the value the edge function and
  // the client portal both use.
  qaBody.campaignKind = campaignKind;
  // v764: may already be uploaded by the AI-draft button above; that helper
  // returns the same path rather than storing a second copy.
  const up = await csubEnsureScriptUploaded(clientId);
  if(up.error){
    msg.textContent = up.error; msg.style.display = 'block';
    btn.disabled = false; btn.textContent = 'Create'; return;
  }
  if(up.path){ qaBody.callerScriptPath = up.path; qaBody.callerScriptName = up.name; }
  const { data, error } = await sb.functions.invoke('staff-create-campaign', {
    body: { clientId, campaignName, callerTier, dialerChoice, dataChoice, complimentary, complimentaryExpiresAt: complimentary ? complimentaryExpiresAt : undefined, ...qaBody },
  });
  btn.disabled = false;
  btn.textContent = 'Create';
  if(error || !data || data.ok === false){
    let apiMsg = data && data.error;
    if(!apiMsg && error && error.context && typeof error.context.json === 'function'){
      try{ const b = await error.context.json(); apiMsg = b.error; }catch(e){}
    }
    msg.textContent = apiMsg || (error && error.message) || 'Failed to create campaign.';
    msg.style.display = 'block';
    return;
  }
  closeCsubNewCampaignModal();
  logActivity('campaign.staff_create', 'client', clientId, `Created ${data.complimentary ? 'a complimentary' : 'a pending'} campaign request: ${campaignName}`);
  if(data.complimentary){
    // LOW-MEDIUM FIX (edge_audit_staff_billing.md L3): staff-create-campaign
    // now returns `warnings` for any non-fatal side-effect insert that
    // failed (guide access, lead-submission access, account_type upgrade)
    // instead of only logging them server-side -- surface them here so a
    // partial failure doesn't silently look like a fully successful create.
    const warningText = (data.warnings && data.warnings.length) ? `\n\n⚠ ${data.warnings.join('\n⚠ ')}` : '';
    alert(`"${campaignName}" created as a complimentary campaign — active immediately, auto-cancels after ${complimentaryExpiresAt}.${warningText}`);
    // v366 fix: this used to only refresh csubActiveCampaignForms, which
    // made a brand-new complimentary campaign appear as a placeholder row
    // ("No request submitted", every column blank) even though staff-
    // create-campaign DID write a real ghl_form_submissions row with all
    // the criteria fields filled in, plus a real client_campaign_
    // subscriptions row -- csubAllRows (the submissions themselves) and
    // csubCampaignSubsByNorm (Package/Active Until/Status/live Dialer-
    // Data-Staffing) were both still the stale pre-creation snapshot, so
    // the new row's real details never showed until the next full reload.
    await Promise.all([
      loadClientSubmissions(),
      loadCsubCampaignSubsForCampaignTab(),
      loadCsubActiveCampaignForms(),
      loadCsubCampaignLeadStats(),
    ]);
    renderCsubCampaignTable();
  } else {
    alert(`Pending campaign request created for "${campaignName}". Generate a payment link from Finance → Stripe Pending Payment to send to the client.`);
  }
});

// v152: saves one corrected field back to ghl_form_submissions — either a
// fixed contact column (contact_name/contact_phone/contact_email) or one
// key inside the fields jsonb blob, depending on which contenteditable
// cell fired. Shared by both Data Form and Client Qualification Form
// tables via the delegated focusout listener below.
async function saveCsubField(el){
  const id = el.dataset.id;
  const field = el.dataset.field; // set for fixed columns
  const key = el.dataset.key;     // set for dynamic `fields` entries
  const newVal = el.textContent.trim();
  const original = el.dataset.original || '';
  if(newVal === original) return;
  let update;
  if(field){
    update = { [field]: newVal || null };
  } else if(key){
    const row = csubAllRows.find(r => r.id === id);
    const fields = { ...(row && row.fields ? row.fields : {}) };
    if(newVal) fields[key] = newVal; else delete fields[key];
    update = { fields };
  } else {
    return;
  }
  const { error } = await sb.from('ghl_form_submissions').update(update).eq('id', id);
  if(error){
    alert(error.message);
    el.textContent = original;
    return;
  }
  el.dataset.original = newVal;
  // Keep the in-memory cache in sync so re-filtering/re-rendering (or
  // switching subtabs and back) doesn't show the stale value.
  const row = csubAllRows.find(r => r.id === id);
  if(row){
    if(field) row[field] = newVal || null;
    else if(key){ row.fields = { ...(row.fields || {}) }; if(newVal) row.fields[key] = newVal; else delete row.fields[key]; }
  }
  logActivity('client_submission.update', 'ghl_form_submission', id, `Corrected ${field || key} on a client submission`);
}
['csubDataFormTableBody', 'csubQualFormTableBody'].forEach(id => {
  const el = $(id);
  if(el) el.addEventListener('focusout', (e) => {
    const target = e.target.closest('.csub-editable-cell');
    if(target) saveCsubField(target);
  });
});

// CSV export mirrors whatever's currently on screen (same Form/Campaign
// filter, same date range, same active subtab) — not a fixed "export
// everything" — so what a person downloads always matches what they were
// just looking at. Clickable from Data Form or Client Qualification Form
// (the shared filter card, which holds this button, is hidden on
// Dashboard, and Campaign Management has its own separate Status/Package
// filters instead — see activateCsubSection()). The fallback below is only
// ever reached from Campaign Management, which doesn't use this export at
// all — v358 moved Data Form out to Data Science and this comment used to
// say 'data' could no longer be csubActiveSection here; v366 moved it back,
// so it can again, and the ternary already covers it correctly either way.
// The button itself is Owner/Admin only (item 4 — see
// applyOwnerAdminExportGating() and the "owner-admin-export-only" class
// on it in the HTML), but the click handler below is left alone rather
// than relying purely on CSS visibility to prevent the action.
$('csubExportCsvBtn').addEventListener('click', () => {
  if(!(myIsOwner || myRole === 'admin')) return;
  const section = (csubActiveSection === 'data' || csubActiveSection === 'qualification') ? csubActiveSection : 'data';
  const rows = csubFilteredRowsForSection(section);
  const dynamicKeys = Array.from(new Set(rows.flatMap(r => Object.keys(r.fields || {}))))
    .filter(k => csubFieldBelongsToSection(k, section))
    .filter(k => !CSUB_SERVICE_KEY_PATTERN.test(k))
    // v283: drop Full Name/Phone/Email from the dynamic columns -- they
    // already have their own fixed Name/Phone/Email columns above.
    .filter(k => !CSUB_TABLE_DUPLICATE_FIELDS.has(csubNormalizeLabel(k)))
    .sort();
  const showPhoneEmail = section !== 'qualification';
  const headers = ['Submitted', 'Form', 'Name', ...(showPhoneEmail ? ['Phone', 'Email'] : []), ...dynamicKeys];
  const csvEscape = v => {
    const s = v == null ? '' : String(v);
    return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
  };
  const lines = [headers.map(csvEscape).join(',')];
  rows.forEach(r => {
    const line = [
      r.submitted_at ? new Date(r.submitted_at).toISOString() : '',
      csubDisplayFormName(r, section),
      r.contact_name || '',
      ...(showPhoneEmail ? [r.contact_phone || '', r.contact_email || ''] : []),
      ...dynamicKeys.map(k => (r.fields && r.fields[k] != null) ? String(r.fields[k]) : ''),
    ];
    lines.push(line.map(csvEscape).join(','));
  });
  const blob = new Blob([lines.join('\n')], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `client-submissions-${section}-${$('csubFromDateInput').value || 'all'}-to-${$('csubToDateInput').value || 'all'}.csv`;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 30000);
});
$('csubFromDateInput').addEventListener('change', loadClientSubmissions);
$('csubToDateInput').addEventListener('change', loadClientSubmissions);
$('csubFormFilter').addEventListener('change', () => {
  if(csubActiveSection === 'dashboard') renderCsubDashboard();
  else renderCsubSectionTable(csubActiveSection);
});
// v96 item 3: Campaign Name filter, shared by Data Form and Client
// Qualification Form (same "one filter row drives both" reasoning as the
// existing Form filter — a Cold Caller package submission is duplicated
// onto both subtabs, so filtering by campaign should narrow both the same
// way).
if($('csubCampaignFilter')) $('csubCampaignFilter').addEventListener('change', () => {
  if(csubActiveSection === 'dashboard') renderCsubDashboard();
  else renderCsubSectionTable(csubActiveSection);
});

// ===== Skip Trace sub-tab (Client Submissions > Skip Trace) =====
// Own data source -- public_skiptrace_orders via the public-skiptrace Edge
// Function's list_orders/export_paid_csv/import_ninja_results/
// send_result_email/delete_order actions, authenticated with the logged-in
// staff member's own session rather than any secret embedded here (see
// checkStaffAccess()/checkOwnerAdminAccess() in that function).
let csubSkiptraceOrders = [];
let csubSkiptracePollTimer = null;
// v440: pagination -- was hard-capped at one `limit: 100` call with no way
// to see anything past it. csubSkiptracePageOffset is read by
// loadCsubSkipTrace() (default, no arg) so the 10s auto-refresh poll and
// the plain Refresh button both reload the CURRENT page, not silently
// bounce staff back to page 1 -- only Prev/Next explicitly change it.
const CSUB_SKIPTRACE_PAGE_SIZE = 100;
let csubSkiptracePageOffset = 0;
let csubSkiptraceLastTotal = 0;
// v449: search/filter/sort -- server-side (see the markup's own comment
// for why, unlike Data Orders/List Orders' client-side approach). Same
// sortable column set as list_orders' own SORTABLE_COLUMNS allowlist
// (public-skiptrace) -- keep the two in sync if either changes.
let csubSkiptraceSearchQuery = '';
let csubSkiptraceStatusFilterValue = '';
let csubSkiptraceSortBy = 'created_at';
let csubSkiptraceSortDir = 'desc';
const CSUB_SKIPTRACE_SORTABLE_KEYS = new Set(['created_at', 'updated_at', 'email', 'record_count', 'price_cents', 'status']);

// v273: supabase-js's functions.invoke() does NOT parse the response body
// on a non-2xx status -- `data` comes back null and `error.message` is
// always the same unhelpful "Edge Function returned a non-2xx status
// code", no matter what the function actually said (confirmed live: a
// send_result_email call with RESEND_API_KEY unset returns a normal
// `{ok:false, error:'RESEND_API_KEY is not set...'}` JSON body on its 400,
// but every one of the alerts below was only ever showing the generic
// SDK message). error.context is the raw, still-unread Response object in
// this case -- read it ourselves to get the actual message.
async function skiptraceInvokeErrorMessage(error, data){
  if(data && data.error) return data.error;
  if(error && error.context && typeof error.context.json === 'function'){
    try {
      const body = await error.context.json();
      if(body && body.error) return body.error;
    } catch(e) { /* not JSON, or body already consumed -- fall through */ }
  }
  return (error && error.message) || 'unknown error';
}

async function loadCsubSkipTrace(offset){
  // v440: defaults to the CURRENT page (not always 0) -- see
  // csubSkiptracePageOffset's own comment for why: the 10s poll and the
  // plain Refresh button both call this with no arg and should reload
  // whatever page staff is currently looking at, not reset it.
  if(typeof offset === 'number') csubSkiptracePageOffset = Math.max(0, offset);
  const bodyEl = $('csubSkiptraceTableBody');
  const { data, error } = await sb.functions.invoke('public-skiptrace', { body: {
    action: 'list_orders', limit: CSUB_SKIPTRACE_PAGE_SIZE, offset: csubSkiptracePageOffset,
    q: csubSkiptraceSearchQuery || undefined,
    status: csubSkiptraceStatusFilterValue || undefined,
    sortBy: csubSkiptraceSortBy, sortDir: csubSkiptraceSortDir,
  } });
  if(error || !data || data.ok === false){
    const msg = await skiptraceInvokeErrorMessage(error, data);
    console.error('Failed to load skip-trace orders', msg);
    if(bodyEl) bodyEl.innerHTML = `<tr><td colspan="8" style="color:var(--danger);">Failed to load: ${escapeHtml(msg)}</td></tr>`;
    return;
  }
  csubSkiptraceOrders = data.orders || [];
  csubSkiptraceLastTotal = typeof data.total === 'number' ? data.total : csubSkiptraceOrders.length;
  renderCsubSkiptraceTable();
  // v440: Prev/Next controls, separate from the table render itself.
  const pagerEl = $('csubSkiptracePagerControls');
  if(pagerEl){
    const pageCount = Math.max(1, Math.ceil(csubSkiptraceLastTotal / CSUB_SKIPTRACE_PAGE_SIZE));
    const pageNum = Math.floor(csubSkiptracePageOffset / CSUB_SKIPTRACE_PAGE_SIZE) + 1;
    pagerEl.style.display = csubSkiptraceLastTotal > CSUB_SKIPTRACE_PAGE_SIZE ? 'flex' : 'none';
    $('csubSkiptracePageIndicator').textContent = `Page ${pageNum} of ${pageCount} (${csubSkiptraceLastTotal.toLocaleString()} total)`;
    $('csubSkiptracePrevPageBtn').disabled = csubSkiptracePageOffset <= 0;
    $('csubSkiptraceNextPageBtn').disabled = csubSkiptracePageOffset + CSUB_SKIPTRACE_PAGE_SIZE >= csubSkiptraceLastTotal;
  }
  // v436: stat cards now come from their own account-wide count-only query
  // (see loadCsubSkiptraceStats below) instead of being derived from this
  // same page -- see DATASCIENCETABBUILDBRIEF.md Task 3. Fired
  // alongside the table load, not awaited by it, so a stats hiccup never
  // blocks the table from rendering.
  loadCsubSkiptraceStats();
}
$('csubSkiptracePrevPageBtn')?.addEventListener('click', () => loadCsubSkipTrace(Math.max(0, csubSkiptracePageOffset - CSUB_SKIPTRACE_PAGE_SIZE)));
$('csubSkiptraceNextPageBtn')?.addEventListener('click', () => loadCsubSkipTrace(csubSkiptracePageOffset + CSUB_SKIPTRACE_PAGE_SIZE));
// v449: search/filter/sort -- server-side, so search debounces (same 250ms
// convention callActSearchInput's own server-driven search already uses)
// rather than firing a request per keystroke. Search/status changes always
// jump back to page 0 -- a filtered result set re-using the previous
// offset would likely just show an empty page.
$('csubSkiptraceSearchInput')?.addEventListener('input', debounce(() => {
  csubSkiptraceSearchQuery = $('csubSkiptraceSearchInput').value.trim();
  loadCsubSkipTrace(0);
}, 250));
$('csubSkiptraceStatusFilter')?.addEventListener('change', () => {
  csubSkiptraceStatusFilterValue = $('csubSkiptraceStatusFilter').value;
  loadCsubSkipTrace(0);
});
// Delegated -- thead is rebuilt on every render (renderCsubSkiptraceTableHead).
$('csubSkiptraceTableHead')?.addEventListener('click', (e) => {
  const th = e.target.closest('.csub-skiptrace-sort-th');
  if(!th) return;
  const key = th.dataset.sortKey;
  if(!CSUB_SKIPTRACE_SORTABLE_KEYS.has(key)) return;
  if(csubSkiptraceSortBy === key) csubSkiptraceSortDir = (csubSkiptraceSortDir === 'asc') ? 'desc' : 'asc';
  else { csubSkiptraceSortBy = key; csubSkiptraceSortDir = 'asc'; }
  loadCsubSkipTrace(0);
});

// v436: was renderCsubSkiptraceStats(), computed client-side from just
// csubSkiptraceOrders' own limit:100 page -- correct only under 100 total
// orders, silently under-reported past that (Revenue worst of all, since
// it's a sum). Now calls public-skiptrace's own 'stats' action for true
// account-wide totals (count-only queries server-side, same pattern
// overview_stats uses on staff-list-builder).
async function loadCsubSkiptraceStats(){
  const { data, error } = await sb.functions.invoke('public-skiptrace', { body: { action: 'stats' } });
  if(error || !data || data.ok === false){
    console.error('Failed to load skip-trace stats', error, data);
    return;
  }
  $('csubSkiptraceStatTotal').textContent = data.total.toLocaleString();
  $('csubSkiptraceStatProcessing').textContent = data.inProgress.toLocaleString();
  $('csubSkiptraceStatCompleted').textContent = data.completed.toLocaleString();
  $('csubSkiptraceStatFailed').textContent = data.needsAttention.toLocaleString();
  $('csubSkiptraceStatRevenue').textContent = '$' + (data.revenueCents / 100).toFixed(2);
}

// v356: manual skip-trace credit adjustments panel -- separate data source
// from csubSkiptraceOrders above (client_accounts/client_skiptrace_credits/
// client_skiptrace_credit_ledger, read directly via RLS rather than through
// an Edge Function action). v364: this section became a normal grantable
// Finance subtab, so the two credit tables' SELECT policies were extended
// from is_admin()-only to also allow role_has_any_tab('finance') -- see the
// skiptrace_credits_finance_tab_select_access migration. Only the actual
// balance-changing call goes through public-skiptrace's staff_adjust_credits
// action, which is service-role and audited via the ledger's `note` column.
let skiptraceCreditsClientsCache = [];

async function loadSkiptraceCreditsClientOptions(){
  const sel = $('skiptraceCreditsClientSelect');
  if(!sel) return;
  const { data, error } = await sb.from('client_accounts').select('id, full_name, email').eq('is_active', true).order('full_name');
  if(error){
    sel.innerHTML = `<option value="">Failed to load clients</option>`;
    return;
  }
  skiptraceCreditsClientsCache = data || [];
  sel.innerHTML = `<option value="">Select a client…</option>` + skiptraceCreditsClientsCache.map(c =>
    `<option value="${c.id}">${escapeHtml(c.full_name)} (${escapeHtml(c.email)})</option>`
  ).join('');
}

// LOW FIX (audit_chunk4.md #8): the /3 conversion below used to be a bare
// literal duplicated in two places, kept in sync with the server's real
// public-skiptrace PRICE_CENTS_PER_RECORD only by a comment. Named here so
// both call sites derive from one place; still display-only (the actual
// balance-changing writes go through staff_adjust_credits server-side).
const STAFF_SKIPTRACE_CENTS_PER_CREDIT = 3; // must match public-skiptrace's PRICE_CENTS_PER_RECORD
// v453: hoisted out of loadSkiptraceCreditsForSelectedClient so
// loadSkiptraceCreditsHistory's account-wide table uses the exact same
// labels instead of a second, driftable copy.
const SKIPTRACE_CREDIT_KIND_LABEL = { topup: 'Stripe top-up', order_charge: 'Order charge', refund: 'Refund', adjustment: 'Manual adjustment' };
async function loadSkiptraceCreditsForSelectedClient(){
  const clientId = $('skiptraceCreditsClientSelect').value;
  const balanceEl = $('skiptraceCreditsBalance');
  const ledgerEl = $('skiptraceCreditsLedger');
  if(!clientId){
    balanceEl.textContent = '—';
    ledgerEl.innerHTML = '';
    return;
  }
  balanceEl.textContent = '…';
  const [{ data: credits }, { data: ledger }] = await Promise.all([
    sb.from('client_skiptrace_credits').select('balance_cents').eq('client_id', clientId).maybeSingle(),
    sb.from('client_skiptrace_credit_ledger').select('amount_cents, kind, note, created_at').eq('client_id', clientId).order('created_at', { ascending: false }).limit(8),
  ]);
  const balanceCents = credits?.balance_cents || 0;
  const balanceCredits = Math.round(balanceCents / STAFF_SKIPTRACE_CENTS_PER_CREDIT);
  balanceEl.textContent = balanceCredits.toLocaleString() + ' credits';
  ledgerEl.innerHTML = (ledger && ledger.length)
    ? '<table style="width:100%; border-collapse:collapse;">' + ledger.map(l => {
        const creditsDelta = Math.round(l.amount_cents / STAFF_SKIPTRACE_CENTS_PER_CREDIT);
        const ledgerTz = nonAgentDisplayTz();
        return `<tr>
          <td style="padding:3px 6px 3px 0; white-space:nowrap;">${new Date(l.created_at).toLocaleDateString([], ledgerTz ? { timeZone: ledgerTz } : {})}</td>
          <td style="padding:3px 6px;">${escapeHtml(SKIPTRACE_CREDIT_KIND_LABEL[l.kind] || l.kind)}</td>
          <td style="padding:3px 6px; font-weight:600; color:${creditsDelta >= 0 ? 'var(--good)' : 'var(--danger)'};">${creditsDelta >= 0 ? '+' : ''}${creditsDelta}</td>
          <td style="padding:3px 0; color:var(--text-dim);">${escapeHtml(l.note || '')}</td>
        </tr>`;
      }).join('') + '</table>'
    : '<span style="color:var(--text-dim);">No credit history yet.</span>';
}
if($('skiptraceCreditsClientSelect')) $('skiptraceCreditsClientSelect').addEventListener('change', loadSkiptraceCreditsForSelectedClient);

// v453: account-wide history -- every client, most recent first, not
// limited to whichever one client happens to be selected above. 200 is
// generous headroom over this table's real volume (manual adjustments plus
// one row per paid skiptrace order and top-up) without needing pagination.
let skiptraceCreditsHistoryRows = [];
async function loadSkiptraceCreditsHistory(){
  const tbody = $('skiptraceCreditsHistoryTbody');
  if(tbody && !skiptraceCreditsHistoryRows.length) tbody.innerHTML = '<tr><td colspan="5" style="color:var(--text-dim);">Loading…</td></tr>';
  const { data, error } = await sb.from('client_skiptrace_credit_ledger')
    .select('amount_cents, kind, note, created_at, client_accounts(full_name, email)')
    .order('created_at', { ascending: false })
    .limit(200);
  if(error){
    if(tbody) tbody.innerHTML = `<tr><td colspan="5" style="color:var(--danger);">Failed to load: ${escapeHtml(error.message)}</td></tr>`;
    return;
  }
  skiptraceCreditsHistoryRows = data || [];
  renderSkiptraceCreditsHistory();
}
function renderSkiptraceCreditsHistory(){
  const tbody = $('skiptraceCreditsHistoryTbody');
  if(!tbody) return;
  if(!skiptraceCreditsHistoryRows.length){
    tbody.innerHTML = '<tr><td colspan="5" style="color:var(--text-dim);">No credit history yet.</td></tr>';
    return;
  }
  const historyTz = nonAgentDisplayTz();
  tbody.innerHTML = skiptraceCreditsHistoryRows.map(l => {
    const creditsDelta = Math.round(l.amount_cents / STAFF_SKIPTRACE_CENTS_PER_CREDIT);
    const clientLabel = l.client_accounts ? (l.client_accounts.full_name || l.client_accounts.email || '—') : '—';
    return `<tr>
      <td class="mono" style="font-size:11px; white-space:nowrap;">${new Date(l.created_at).toLocaleString([], { month:'short', day:'numeric', year:'numeric', hour:'2-digit', minute:'2-digit', ...(historyTz ? { timeZone: historyTz } : {}) })}</td>
      <td>${escapeHtml(clientLabel)}</td>
      <td>${escapeHtml(SKIPTRACE_CREDIT_KIND_LABEL[l.kind] || l.kind)}</td>
      <td class="mono" style="font-weight:600; color:${creditsDelta >= 0 ? 'var(--good)' : 'var(--danger)'};">${creditsDelta >= 0 ? '+' : ''}${creditsDelta}</td>
      <td style="color:var(--text-dim);">${escapeHtml(l.note || '')}</td>
    </tr>`;
  }).join('');
}
if($('skiptraceCreditsHistoryRefreshBtn')) $('skiptraceCreditsHistoryRefreshBtn').addEventListener('click', loadSkiptraceCreditsHistory);

async function applySkiptraceCreditsAdjustment(sign){
  const clientId = $('skiptraceCreditsClientSelect').value;
  const amount = Math.round(Number($('skiptraceCreditsAmount').value));
  const reason = $('skiptraceCreditsReason').value.trim();
  const msgEl = $('skiptraceCreditsMsg');
  msgEl.classList.add('hidden');
  if(!clientId){ msgEl.textContent = 'Select a client first.'; msgEl.className = 'msg error'; msgEl.classList.remove('hidden'); return; }
  if(!Number.isFinite(amount) || amount <= 0){ msgEl.textContent = 'Enter a positive number of credits.'; msgEl.className = 'msg error'; msgEl.classList.remove('hidden'); return; }
  if(!reason){ msgEl.textContent = 'A reason is required.'; msgEl.className = 'msg error'; msgEl.classList.remove('hidden'); return; }

  const deltaCredits = sign * amount;
  const client = skiptraceCreditsClientsCache.find(c => c.id === clientId);
  if(sign < 0 && !confirm(`Remove ${amount} credits from ${client ? client.full_name : 'this client'}? This can't be undone.`)) return;

  const addBtn = $('skiptraceCreditsAddBtn'), removeBtn = $('skiptraceCreditsRemoveBtn');
  addBtn.disabled = true; removeBtn.disabled = true;
  const { data, error } = await sb.functions.invoke('public-skiptrace', { body: { action: 'staff_adjust_credits', clientId, deltaCredits, reason } });
  addBtn.disabled = false; removeBtn.disabled = false;
  if(error || !data || data.ok === false){
    msgEl.textContent = await skiptraceInvokeErrorMessage(error, data);
    msgEl.className = 'msg error';
    msgEl.classList.remove('hidden');
    return;
  }
  msgEl.textContent = data.warning
    ? `Done — ${client ? client.full_name : 'client'} now has ${data.newBalanceCredits.toLocaleString()} credits. ${data.warning}`
    : `Done — ${client ? client.full_name : 'client'} now has ${data.newBalanceCredits.toLocaleString()} credits.`;
  msgEl.className = data.warning ? 'msg error' : 'msg success';
  msgEl.classList.remove('hidden');
  logActivity(sign > 0 ? 'skiptrace_credits.manual_add' : 'skiptrace_credits.manual_remove', 'client_account', clientId, `${sign > 0 ? 'Added' : 'Removed'} ${amount} skip-trace credits ${sign > 0 ? 'to' : 'from'} ${client ? client.full_name : clientId} — reason: ${reason}`);
  $('skiptraceCreditsAmount').value = '';
  $('skiptraceCreditsReason').value = '';
  loadSkiptraceCreditsForSelectedClient();
  loadSkiptraceCreditsHistory();
}
if($('skiptraceCreditsAddBtn')) $('skiptraceCreditsAddBtn').addEventListener('click', () => applySkiptraceCreditsAdjustment(1));
if($('skiptraceCreditsRemoveBtn')) $('skiptraceCreditsRemoveBtn').addEventListener('click', () => applySkiptraceCreditsAdjustment(-1));

function csubSkiptraceStatusColor(status){
  switch(status){
    case 'completed': return 'var(--good)';
    case 'processing': return 'var(--focus)';
    case 'paid': return 'var(--away)';
    case 'failed': return 'var(--danger)';
    default: return 'var(--text-dim)'; // pending_payment
  }
}

// v449: sortable thead -- same ▲/▼-indicator + data-sort-key + delegated-
// click pattern List Builder's own renderListBuilderResults uses, just
// server-driving the actual sort (see loadCsubSkipTrace's own params)
// instead of sorting an in-memory array.
function csubSkiptraceSortIndicator(key){
  if(csubSkiptraceSortBy !== key) return '';
  return csubSkiptraceSortDir === 'asc' ? ' &#9650;' : ' &#9660;';
}
function renderCsubSkiptraceTableHead(){
  const head = $('csubSkiptraceTableHead');
  if(!head) return;
  const sortTh = (key, label) => `<th class="csub-skiptrace-sort-th" data-sort-key="${key}" style="cursor:pointer;">${label}${csubSkiptraceSortIndicator(key)}</th>`;
  head.innerHTML = `<tr>
    ${sortTh('created_at', 'Submitted')}${sortTh('email', 'Email')}${sortTh('record_count', 'Records')}${sortTh('price_cents', 'Price')}${sortTh('status', 'Status')}${sortTh('updated_at', 'Updated')}
    <th>Results</th><th>Actions</th>
  </tr>`;
}
function renderCsubSkiptraceTable(){
  renderCsubSkiptraceTableHead();
  const bodyEl = $('csubSkiptraceTableBody');
  if(!csubSkiptraceOrders.length){
    // v449: distinguishes "nothing has ever been ordered" from "a search/
    // status filter matched nothing" -- same wording convention v444/v445's
    // Data Orders/List Orders search already use.
    const filtered = !!(csubSkiptraceSearchQuery || csubSkiptraceStatusFilterValue);
    bodyEl.innerHTML = `<tr><td colspan="8" style="color:var(--text-dim);">${filtered ? 'No orders match this search.' : 'No orders yet.'}</td></tr>`;
    return;
  }
  // v308: Import/Export/Email were hardcoded owner/admin-only here even
  // though the backend already allowed any staff (export_paid_csv/
  // import_ninja_results use checkStaffAccess, not checkOwnerAdminAccess)
  // and send_result_email was relaxed the same way (see that action's own
  // comment in public-skiptrace/index.ts) — now gated on the new Client
  // Submissions -> Skip Trace "Edit" grant instead, so an Owner can
  // actually delegate this. Delete stays owner/admin only, unchanged —
  // narrower/more destructive than the other three, and not part of what
  // was asked for here. (v358: moved to Data Science -> Skip Trace's own
  // Edit grant.)
  const canEditSkiptrace = canEditDataSciSection('skiptrace');
  const canDelete = myIsOwner || myRole === 'admin';
  const skiptraceTz = nonAgentDisplayTz();
  bodyEl.innerHTML = csubSkiptraceOrders.map(r => {
    const submitted = r.created_at ? new Date(r.created_at).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(skiptraceTz ? { timeZone: skiptraceTz } : {}) }) : '—';
    const updated = r.updated_at ? new Date(r.updated_at).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(skiptraceTz ? { timeZone: skiptraceTz } : {}) }) : '—';
    const price = '$' + ((r.price_cents || 0) / 100).toFixed(2);
    const statusHtml = `<span class="mono" style="color:${csubSkiptraceStatusColor(r.status)}; text-transform:uppercase; font-size:10px;">${escapeHtml(r.status)}</span>`;
    // BUG FIX (found live 2026-08-14): listOrders() never sent `results`
    // (deliberately -- a completed order's results can hold thousands of
    // rows), so this always computed against undefined and showed 0 for
    // every completed order regardless of how many results actually
    // existed -- confirmed live against a real order with 1,726 stored
    // results displaying "0". `results_count` (v452 migration) is a plain
    // int the backend now maintains and sends instead.
    const resultsHtml = r.status === 'completed' ? `<span class="mono">${r.results_count ?? 0}</span>` : '—';
    // Export/Import/Email always show once granted, regardless of status --
    // the backend rejects with a clear message (e.g. "no results yet to
    // email") if a row's current status doesn't support that action yet,
    // rather than the UI trying to predict and hide it in advance.
    let actionHtml = '';
    if(canEditSkiptrace){
      actionHtml += `<button class="btn-secondary csub-skiptrace-export-btn" data-order-id="${r.id}" style="width:auto; padding:4px 8px; font-size:10px;" title="Download this order's records to upload to Ninja">&#8681; Export</button> `;
      actionHtml += `<button class="btn-secondary csub-skiptrace-import-btn" data-order-id="${r.id}" style="width:auto; padding:4px 8px; font-size:10px;" title="Upload the results Ninja sends back for this order">&#8682; Import</button> `;
      actionHtml += `<button class="btn-secondary csub-skiptrace-email-btn" data-order-id="${r.id}" style="width:auto; padding:4px 8px; font-size:10px;" title="Resend these results to ${escapeHtml(r.email || 'the customer')} (sent automatically once already, on Import)">&#9993; Email</button> `;
    }
    if(canDelete){
      actionHtml += `<button class="btn-secondary csub-skiptrace-delete-btn" data-order-id="${r.id}" style="width:auto; padding:4px 8px; font-size:10px; color:var(--danger);" title="Permanently delete this order">&#128465; Delete</button>`;
    }
    return `<tr>
      <td class="mono" style="color:var(--text-2); font-size:11px;">${submitted}</td>
      <td style="font-size:11px;">${escapeHtml(r.email || '')}</td>
      <td class="mono">${r.record_count}</td>
      <td class="mono">${price}</td>
      <td>${statusHtml}</td>
      <td class="mono" style="color:var(--text-2); font-size:11px;">${updated}</td>
      <td>${resultsHtml}</td>
      <td style="white-space:nowrap;">${actionHtml}</td>
    </tr>`;
  }).join('');
}

// v266: per-row Export/Import/Email/Delete replaced the old single Retry
// button + top-of-page bulk Export/Import buttons -- see the dashboard
// header comment above dataSciSection-skiptrace. csubSkiptracePendingImportOrderId
// carries the order id from an Import button click to the shared hidden
// file input's change handler below, since there's one file input for the
// whole table rather than one per row.
let csubSkiptracePendingImportOrderId = null;

document.addEventListener('click', async (e) => {
  const exportBtn = e.target.closest('.csub-skiptrace-export-btn');
  if(exportBtn){
    if(exportBtn.disabled) return;
    const orderId = exportBtn.dataset.orderId;
    exportBtn.disabled = true;
    const original = exportBtn.innerHTML;
    exportBtn.innerHTML = '&#8681; Exporting…';
    const { data, error } = await sb.functions.invoke('public-skiptrace', { body: { action: 'export_paid_csv', orderId } });
    exportBtn.innerHTML = original;
    exportBtn.disabled = false;
    if(error || !data || data.ok === false){
      alert('Export failed: ' + await skiptraceInvokeErrorMessage(error, data));
      return;
    }
    if(!data.recordCount){
      alert('This order has no records to export.');
      return;
    }
    const blob = new Blob([data.csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `skiptrace-for-ninja-${orderId}.csv`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 30000);
    return;
  }

  const importBtn = e.target.closest('.csub-skiptrace-import-btn');
  if(importBtn){
    csubSkiptracePendingImportOrderId = importBtn.dataset.orderId;
    $('csubSkiptraceImportFile').click();
    return;
  }

  const emailBtn = e.target.closest('.csub-skiptrace-email-btn');
  if(emailBtn){
    if(emailBtn.disabled) return;
    const orderId = emailBtn.dataset.orderId;
    if(!confirm('Email these skip trace results to the customer now?')) return;
    emailBtn.disabled = true;
    const original = emailBtn.innerHTML;
    emailBtn.innerHTML = '&#9993; Sending…';
    const { data, error } = await sb.functions.invoke('public-skiptrace', { body: { action: 'send_result_email', orderId } });
    emailBtn.innerHTML = original;
    emailBtn.disabled = false;
    if(error || !data || data.ok === false){
      alert('Email failed: ' + await skiptraceInvokeErrorMessage(error, data));
      return;
    }
    logActivity('skiptrace.email_results', 'public_skiptrace_order', orderId, 'Emailed skip-trace results to the customer');
    alert('Results emailed.');
    return;
  }

  const deleteBtn = e.target.closest('.csub-skiptrace-delete-btn');
  if(deleteBtn){
    if(deleteBtn.disabled) return;
    const orderId = deleteBtn.dataset.orderId;
    if(!confirm('Permanently delete this skip trace order? This cannot be undone.')) return;
    deleteBtn.disabled = true;
    const original = deleteBtn.innerHTML;
    deleteBtn.innerHTML = 'Deleting…';
    const { data, error } = await sb.functions.invoke('public-skiptrace', { body: { action: 'delete_order', orderId } });
    if(error || !data || data.ok === false){
      alert('Delete failed: ' + await skiptraceInvokeErrorMessage(error, data));
      deleteBtn.disabled = false;
      deleteBtn.innerHTML = original;
      return;
    }
    logActivity('skiptrace.delete', 'public_skiptrace_order', orderId, 'Deleted a skip-trace order from the staff dashboard');
    await loadCsubSkipTrace();
    return;
  }
});

if($('csubSkiptraceImportFile')) $('csubSkiptraceImportFile').addEventListener('change', async (e) => {
  const file = e.target.files[0];
  const orderId = csubSkiptracePendingImportOrderId;
  csubSkiptracePendingImportOrderId = null;
  if(!file || !orderId){ e.target.value = ''; return; }
  e.target.value = '';

  const importBtn = document.querySelector(`.csub-skiptrace-import-btn[data-order-id="${orderId}"]`);
  const importBtnOriginal = importBtn ? importBtn.innerHTML : null;
  if(importBtn){ importBtn.disabled = true; importBtn.innerHTML = 'Uploading…'; }

  // v311: uploads straight to Storage instead of inlining the file as JSON
  // in the Edge Function request body -- a real Ninja results export can
  // be many MB (hundreds of columns per record), and that inline path hit
  // Supabase's request-body size cap on a real customer file (confirmed:
  // 14MB CSV -> ~14.9MB JSON body came back as an unparseable HTTP 546).
  // Storage has no comparable cap, so this works regardless of file size.
  const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
  const storagePath = `${orderId}/${Date.now()}-${safeName}`;
  const { error: uploadErr } = await sb.storage.from('skiptrace-imports').upload(storagePath, file, {
    contentType: file.type || 'text/csv',
  });
  if(uploadErr){
    alert('Import failed to upload: ' + uploadErr.message);
    if(importBtn){ importBtn.disabled = false; importBtn.innerHTML = importBtnOriginal; }
    return;
  }

  if(importBtn) importBtn.innerHTML = 'Importing…';
  const { data, error } = await sb.functions.invoke('public-skiptrace', { body: { action: 'import_ninja_results', storagePath, orderId } });
  if(importBtn){ importBtn.disabled = false; importBtn.innerHTML = importBtnOriginal; }
  if(error || !data || data.ok === false){
    alert('Import failed: ' + await skiptraceInvokeErrorMessage(error, data));
    return;
  }
  logActivity('skiptrace.import_ninja_results', 'public_skiptrace_order', orderId, `Imported Ninja results for one order: ${data.ordersCompleted} completed, ${data.ordersEmailed || 0} emailed, ${data.ordersNoMatch} unmatched`);
  alert(data.ordersCompleted
    ? (data.ordersEmailed ? 'Order marked completed and results emailed to the customer.' : 'Order marked completed, but the auto-email failed to send — use the Email button to retry.')
    : "No rows in that file matched this order's addresses — check you uploaded the right file.");
  // v365: "Your skiptrace request" notification (User Management ->
  // Notifications Setting) -- the email leg already goes out server-side
  // (sendResultEmailForOrder, called automatically by import_ninja_results
  // above, and now settings-aware). This adds the matching SMS leg only --
  // deliberately calling send-client-sms directly instead of the
  // callSendClientSms wrapper, since that wrapper also fires
  // callSendClientEmail, which would send a SECOND, duplicate email on top
  // of the one import_ninja_results already sent. The Import button always
  // scopes to a single order (orderId above), so this order's own
  // client_account_id is enough -- no need to fan out like a bulk import would.
  if(data.ordersCompleted){
    const { data: stOrder } = await sb.from('public_skiptrace_orders').select('client_account_id').eq('id', orderId).maybeSingle();
    if(stOrder && stOrder.client_account_id){
      sb.functions.invoke('send-client-sms', { body: { clientId: stOrder.client_account_id, kind: 'skiptrace_request', details: null } })
        .catch(e => console.warn('send-client-sms (skiptrace_request) error:', e));
    }
  }
  await loadCsubSkipTrace();
});

if($('csubSkiptraceRefreshBtn')) $('csubSkiptraceRefreshBtn').addEventListener('click', async () => {
  const btn = $('csubSkiptraceRefreshBtn');
  if(btn.disabled) return;
  btn.disabled = true;
  const original = btn.innerHTML;
  btn.innerHTML = '&#8635; Refreshing…';
  await loadCsubSkipTrace();
  btn.innerHTML = original;
  btn.disabled = false;
});

function startCsubSkiptracePolling(){
  stopCsubSkiptracePolling();
  csubSkiptracePollTimer = setInterval(() => {
    // v358: Skip Trace moved from Client Submissions to Data Science —
    // this checks dataSciActiveSection now, not csubActiveSection (which
    // can never be 'skiptrace' anymore).
    if(dataSciActiveSection === 'skiptrace' && !document.hidden) loadCsubSkipTrace();
  }, 10000);
}
function stopCsubSkiptracePolling(){
  if(csubSkiptracePollTimer){ clearInterval(csubSkiptracePollTimer); csubSkiptracePollTimer = null; }
}

// 3rd level, inside Queue Review — iSpeedToLead: Lead Reviewing / Upload.
// No separate permission layer of its own — both live under the single
// queue_review_ispeedtolead leads-section gate above.
function activateIspdSection(key){
  document.querySelectorAll('.ispd-subtab-btn').forEach(b => b.classList.toggle('active', b.dataset.ispdSection === key));
  document.querySelectorAll('.ispd-section').forEach(s => { s.style.display = (s.id === 'ispdSection-' + key) ? 'block' : 'none'; });
  applyLeadsSectionEditGating('queue_review_ispeedtolead');
}
document.querySelectorAll('.ispd-subtab-btn').forEach(btn => {
  btn.addEventListener('click', () => activateIspdSection(btn.dataset.ispdSection));
});

// v83: Submission Forms' own 2 sub-subtabs (Lead Submission / Submission
// Forms Creator) — same pattern as activateIspdSection above, except each
// side has its OWN leads_sections permission (submission_forms /
// submission_forms_creator) rather than sharing one, so both get gated
// here rather than a single shared call.
function activateSfSection(key){
  document.querySelectorAll('.sf-subtab-btn').forEach(b => b.classList.toggle('active', b.dataset.sfSection === key));
  document.querySelectorAll('.sf-section').forEach(s => { s.style.display = (s.id === 'sfSection-' + key) ? 'block' : 'none'; });
  applyLeadsSectionEditGating('submission_forms', $('sfSection-submit'));
  applyLeadsSectionEditGating('submission_forms_creator', $('sfSection-creator'));
}
document.querySelectorAll('.sf-subtab-btn').forEach(btn => {
  btn.addEventListener('click', () => activateSfSection(btn.dataset.sfSection));
});

// v715: the leads in the loaded window, 1,000-row pages. The first page also
// asks for the row count, so every other page is requested at the same time;
// the old one-page-at-a-time rule (stop at the first short page) still
// finishes the job if the count is missing or rows arrived after it was
// taken. Same order and tiebreaker as before (v489: submitted_at, then id).
// v561: the "Imported" filter REPLACES the date bounds (a re-import never
// moves submitted_at). v133: an error goes back to the caller, who shows it.
const LEADS_SELECT_COLS = 'id, user_id, task_id, submission_form_id, count, submitted_at, status, seller_investor_name, seller_phone, extra_fields, review_note, imported, ticket_stage, desouky_chat_message_id, istl_export_status, istl_export_status_at, manual_delivery_at, manual_delivery_note';
const LEADS_PAGE_SIZE = 1000;
function leadsPageQuery(from, start, end, withCount){
  let query = sb.from('leads')
    .select(LEADS_SELECT_COLS, withCount ? { count: 'exact' } : undefined)
    .order('submitted_at', { ascending: false })
    .order('id', { ascending: true })
    .range(from, from + LEADS_PAGE_SIZE - 1);
  if(leadsImportBatchFilter){
    query = query.eq('last_import_batch', leadsImportBatchFilter);
  } else {
    if(start) query = query.gte('submitted_at', start);
    if(end) query = query.lte('submitted_at', end);
  }
  return query.then(r => r);
}
async function fetchAllLeadsRows(start, end){
  const first = await leadsPageQuery(0, start, end, true);
  if(first.error) return { rows: [], error: first.error };
  const rows = (first.data || []).slice();
  let lastLen = rows.length;
  let next = LEADS_PAGE_SIZE;
  if(lastLen === LEADS_PAGE_SIZE && typeof first.count === 'number' && first.count > next){
    const froms = [];
    for(let f = next; f < first.count; f += LEADS_PAGE_SIZE) froms.push(f);
    const pages = await Promise.all(froms.map(f => leadsPageQuery(f, start, end, false)));
    for(const p of pages){
      if(p.error) return { rows, error: p.error };
      rows.push(...(p.data || []));
      lastLen = (p.data || []).length;
    }
    next += froms.length * LEADS_PAGE_SIZE;
  }
  while(lastLen === LEADS_PAGE_SIZE){
    const p = await leadsPageQuery(next, start, end, false);
    if(p.error) return { rows, error: p.error };
    rows.push(...(p.data || []));
    lastLen = (p.data || []).length;
    next += LEADS_PAGE_SIZE;
  }
  return { rows, error: null };
}
// v715: latest outbound send per lead, split by channel (was inline below;
// the live queue update uses it too).
function leadsNoteSendRow(s){
  if(!leadsIspeedtoleadSendByLeadId[s.lead_id]) leadsIspeedtoleadSendByLeadId[s.lead_id] = s;
  if(s.channel === 'gyhomes'){ if(!leadsGyhomesSendByLeadId[s.lead_id]) leadsGyhomesSendByLeadId[s.lead_id] = s; }
  else { if(!leadsPrimehomeSendByLeadId[s.lead_id]) leadsPrimehomeSendByLeadId[s.lead_id] = s; }
}

// v715: one Leads load at a time. A call that arrives while one is running
// gets ONE follow-up load after it (the running one may predate the change
// that caller just made), shared by everyone who arrives meanwhile -- rather
// than full reloads stacking on top of each other.
let leadsLoadInFlight = null;
let leadsLoadQueued = null;
let leadsLoadedOnce = false;
function loadLeads(){
  if(leadsLoadInFlight){
    if(!leadsLoadQueued){
      leadsLoadQueued = leadsLoadInFlight.catch(() => {}).then(() => { leadsLoadQueued = null; return loadLeads(); });
    }
    return leadsLoadQueued;
  }
  const p = loadLeadsNow();
  leadsLoadInFlight = p;
  const clear = () => { if(leadsLoadInFlight === p) leadsLoadInFlight = null; };
  p.then(clear, clear);
  return p;
}
async function loadLeadsNow(){
  // v134/v217: restore whatever range was last set (see
  // restoreLeadsDateRange() above).
  if(!$('leadsFromDateInput').value && !$('leadsToDateInput').value) restoreLeadsDateRange();
  // v257: still empty after trying to restore a saved range (fresh
  // browser, or explicitly cleared) — default to the fixed date range
  // rather than true "no bound", so a first-time/cleared view lands on
  // an explicit, predictable window instead of an unlabeled "All time".
  if(!$('leadsFromDateInput').value && !$('leadsToDateInput').value){
    $('leadsFromDateInput').value = DEFAULT_DATE_RANGE_FROM;
    $('leadsToDateInput').value = DEFAULT_DATE_RANGE_TO;
  }

  // v715 (the owner: "any subtab under Leads takes 20 seconds after a
  // refresh -- it should be near instant"). This made ~35 requests one after
  // another: six lookups, the leads in 1,000-row pages, then postbacks and
  // send history in 200-id chunks, each waiting for the last (API logs:
  // ~0.2 s apart, ~8 s of pure waiting before any download or drawing). Every
  // request now leaves as soon as what it needs is known: the lookups and the
  // first leads page together, the other pages together once the count is
  // back, the four id-keyed reads together (below). Same queries, same data,
  // nothing cached. A query builder only sends when awaited; .then() sends now.
  const pAgents = sb.from('profiles').select('id, full_name, email, role').order('full_name').then(r => r);
  const pTasks = sb.from('tasks').select('id, name, category_id').order('name').then(r => r);
  const pForms = sb.from('lead_submission_forms').select('id, name').then(r => r);
  const pSchedules = sb.from('schedules').select('user_id, timezone').then(r => r);
  const pCatFields = sb.from('task_category_fields').select('category_id, field_key, label, field_type, options, required, sort_order').then(r => r);
  const pFormFields = sb.from('lead_submission_form_fields').select('form_id, field_key, label, field_type, options, required, sort_order').then(r => r);
  const { start, end } = leadsFetchRangeBounds();
  const pLeads = fetchAllLeadsRows(start, end);

  const { data: agents } = await pAgents;
  leadsAllAgents = (agents || []).filter(a => !PROTECTED_ROLES.has(a.role));
  // v85: unfiltered — agentName() below needs to resolve EVERY submitter,
  // including an Owner/Admin who submitted a lead via the dashboard's own
  // Lead Submission subtab (v83) — leadsAllAgents deliberately excludes
  // them (it's what populates the User filter dropdown + "By agent"
  // breakdown, which are fine staying agent-only), but that meant an
  // Owner/Admin's own name silently came up blank everywhere a lead they
  // personally submitted was displayed.
  leadsAllProfiles = agents || [];
  const { data: tasks } = await pTasks;
  leadsAllTasks = tasks || [];
  // v88: campaigns = Submission Forms (see leadsAllForms/leadsFormNameFn
  // comments above) — fetched the same way, right alongside tasks.
  const { data: forms } = await pForms;
  leadsAllForms = forms || [];
  const { data: leadsScheduleRows } = await pSchedules;
  leadsAgentTz = {};
  (leadsScheduleRows || []).forEach(s => { if(s.timezone) leadsAgentTz[s.user_id] = s.timezone; });

  // v60: extra_fields is a generic jsonb blob keyed by field_key — this is
  // what turns those keys back into the human labels an admin gave them
  // per category (RESERVED_FIELD_KEYS' 3 keys never appear here since
  // they're shown via their own dedicated columns instead, same as
  // before). A key with no match (e.g. the field was later removed from
  // the category) just falls back to showing the raw key.
  // v97 fix: also select `required`/`sort_order` — see extraFieldsEntries()
  // below for why. Previously only `label` was read, which meant "is this
  // field required" had no path back to the Review popup at all.
  // v392: field_type/options now also selected — see extraFieldsEntries()
  // below, this is what lets the Review popup render a real <select>
  // matching the form's own dropdown options instead of a free-text input
  // for select/multi fields.
  const { data: catFieldRows } = await pCatFields;
  const fieldDefsByCategory = {};
  (catFieldRows || []).forEach(f => {
    (fieldDefsByCategory[f.category_id] ||= {})[f.field_key] = { label: f.label, type: f.field_type || 'text', options: f.options || [], required: !!f.required, sort_order: f.sort_order || 0 };
  });
  const categoryIdByTaskId = {};
  leadsAllTasks.forEach(t => { categoryIdByTaskId[t.id] = t.category_id; });
  // v83: same idea, for a lead submitted through the new (task-independent)
  // Submission Forms Creator instead — those rows have task_id null and
  // submission_form_id set, so this is a second, separate lookup rather
  // than folding into fieldDefsByCategory above (there's no category to
  // key it by).
  const { data: formFieldRows } = await pFormFields;
  const fieldDefsByForm = {};
  (formFieldRows || []).forEach(f => {
    (fieldDefsByForm[f.form_id] ||= {})[f.field_key] = { label: f.label, type: f.field_type || 'text', options: f.options || [], required: !!f.required, sort_order: f.sort_order || 0 };
  });
  function fieldDefsFor(taskId, formId){
    const catId = categoryIdByTaskId[taskId];
    return (formId && fieldDefsByForm[formId]) || (catId && fieldDefsByCategory[catId]) || {};
  }
  // v107: global fallback label lookup, keyed by field_key across EVERY
  // form/category (not just the lead's CURRENT submission_form_id) — first
  // match wins. Needed because the Ticket workflow reassigns a ticket's
  // submission_form_id to the real target campaign on Accept, so its data
  // was collected under the Ticket form's fields (email, property_type,
  // etc.) but now lives on a lead whose own submission_form_id points at a
  // completely different form with none of those field_keys defined. Without
  // this, extraFieldsEntries()'s "show only defKeys" branch below silently
  // DROPPED every one of those answers from view entirely — not just
  // mislabeled, genuinely invisible in both the Queue Review table's
  // Submitted Details summary and the Review popup. This fixes that for any
  // lead whose form was ever reassigned/changed after submission, not just
  // tickets.
  const globalLabelByKey = {};
  (catFieldRows || []).forEach(f => { if(!(f.field_key in globalLabelByKey)) globalLabelByKey[f.field_key] = f.label; });
  (formFieldRows || []).forEach(f => { if(!(f.field_key in globalLabelByKey)) globalLabelByKey[f.field_key] = f.label; });
  // v392: same first-match-wins fallback as globalLabelByKey, but carrying
  // type/options too — needed so a leftover field reached only via this
  // fallback path (e.g. a reassigned Ticket's original fields) can still
  // render as a real dropdown instead of always falling back to text.
  const globalFieldDefByKey = {};
  (catFieldRows || []).forEach(f => { if(!(f.field_key in globalFieldDefByKey)) globalFieldDefByKey[f.field_key] = { type: f.field_type || 'text', options: f.options || [] }; });
  (formFieldRows || []).forEach(f => { if(!(f.field_key in globalFieldDefByKey)) globalFieldDefByKey[f.field_key] = { type: f.field_type || 'text', options: f.options || [] }; });
  const extraFieldsLabel = (taskId, formId, extraFields) => {
    if(!extraFields || typeof extraFields !== 'object') return '';
    // recording_url is surfaced by its own "Attach Recording(s)" field in
    // the Leads Queue Review popup — don't also dump it into this generic
    // summary column as a raw, unlabeled link.
    const keys = Object.keys(extraFields).filter(k => k !== 'recording_url' && extraFields[k] !== null && extraFields[k] !== '');
    if(!keys.length) return '';
    const defs = fieldDefsFor(taskId, formId);
    return keys.map(k => `${(defs[k] && defs[k].label) || globalLabelByKey[k] || k}: ${extraFields[k]}`).join(', ');
  };
  // v87: same lookup as extraFieldsLabel() above, but returns structured
  // { key, label, value, required } entries instead of one flattened
  // string — what the Leads Queue Review popup's editable "Submitted
  // Details" block renders inputs from (see renderLeadsQueueReviewExtraFields()).
  //
  // v97 fix: this used to only return keys actually PRESENT (and non-empty)
  // in extra_fields — which meant a required field the agent left blank
  // never showed up as an input at all, so the reviewer had no way to see
  // it was missing and nothing stopped Accept. It now returns EVERY field
  // defined on the lead's own source form/category, blank ones included
  // (value defaults to ''), each carrying its real `required` flag —
  // that's what lets the Review popup show a blank-but-required field as
  // an empty input the reviewer must fill in, and what makes "required"
  // mean "whatever the form itself marked required," not "every field."
  // Falls back to whatever raw keys are actually present in extra_fields
  // (none treated as required) only if the field definitions themselves
  // can't be found at all (e.g. a deleted form/category, or a legacy row).
  //
  // v107 fix: ALSO appends any key actually present in extra_fields that
  // isn't one of the current form's defKeys (using globalLabelByKey for a
  // real label where possible) — see globalLabelByKey's own comment above
  // for why this matters for a reassigned Ticket specifically. These
  // appended entries are always optional (required: false): the CURRENT
  // form never asked for them, so Accept can't sensibly demand them.
  const extraFieldsEntries = (taskId, formId, extraFields) => {
    const ef = (extraFields && typeof extraFields === 'object') ? extraFields : {};
    const defs = fieldDefsFor(taskId, formId);
    const defKeys = Object.keys(defs);
    const leftoverKeys = Object.keys(ef).filter(k => k !== 'recording_url' && !defKeys.includes(k) && ef[k] !== null && ef[k] !== '');
    const leftoverEntries = leftoverKeys.map(k => {
      const fallbackDef = globalFieldDefByKey[k];
      return { key: k, label: globalLabelByKey[k] || k, value: ef[k], required: false, type: (fallbackDef && fallbackDef.type) || 'text', options: (fallbackDef && fallbackDef.options) || [] };
    });
    if(defKeys.length){
      return defKeys
        .filter(k => k !== 'recording_url')
        .sort((a, b) => (defs[a].sort_order || 0) - (defs[b].sort_order || 0))
        .map(k => ({ key: k, label: defs[k].label, value: (ef[k] != null && String(ef[k]).trim() !== '' ? ef[k] : leadSemanticFallback(ef, k, defs[k].label)), required: !!defs[k].required, type: defs[k].type || 'text', options: defs[k].options || [] }))   // v711: carry the address / email across forms
        .concat(leftoverEntries);
    }
    const keys = Object.keys(ef).filter(k => k !== 'recording_url' && ef[k] !== null && ef[k] !== '');
    return keys.map(k => {
      const fallbackDef = globalFieldDefByKey[k];
      return { key: k, label: globalLabelByKey[k] || k, value: ef[k], required: false, type: (fallbackDef && fallbackDef.type) || 'text', options: (fallbackDef && fallbackDef.options) || [] };
    });
  };

  // v100: the shared fetch below is no longer scoped by a User/Status
  // filter — those dropdowns used to live on the Leads Dashboard subtab
  // and constrained what every OTHER subtab saw too (and defaulted to
  // "Pending" only, so "By agent" silently only ever showed accepted
  // leads if that default was left as-is). Now it always pulls every
  // status for every user within the date range; User/Status narrowing
  // happens locally on Queue Review / PrimeHome Buyers via their own
  // filter rows (populated here into the two new selects).
  const userFilterOptionsHtml = '<option value="">All users</option>' +
    leadsAllAgents.map(a => `<option value="${a.id}">${escapeHtml(a.full_name || a.email)}</option>`).join('');
  [$('leadsQueueUserFilter'), $('leadsIspdUserFilter'), $('allQueueUserFilter')].forEach(sel => {
    if(!sel) return;
    const prev = sel.value;
    sel.innerHTML = userFilterOptionsHtml;
    sel.value = prev;
  });

  const label = leadsRangeLabel();

  // v217: start/end are only null when no range was picked at all (see
  // leadsRangeBounds()) — skip the bound entirely in that case rather than
  // filtering by it, so "no range selected" fetches full history instead
  // of silently matching zero rows against a null date.
  // v489: the fixed 2026-07-01..2050-12-31 default (see v261 comment above)
  // now covers every lead in the org (1,187+ and growing) — this single
  // query feeds leadsFullData, which is in turn the ONLY data source for
  // Leads Dashboard's stat cards, Queue Review, Tickets Review, PrimeHome
  // Buyers Queue Review, and All Queue (see leadsFullData's own comment).
  // It never had `.range()`/`.limit()`, so it silently truncated at
  // PostgREST's 1000-row cap the moment the org crossed that count — every
  // one of those subtabs was quietly missing the oldest ~187 rows with
  // zero indication anything was cut off. Paginated the same way
  // fetchAllLeadStatusRows() already does for this exact table, with an
  // explicit `.order('id')` tiebreaker so a same-`submitted_at` tie can't
  // cause a row to be skipped or double-counted at a page boundary (see
  // v484's own fix for this exact class of bug in Time Management). Error
  // handling/surfacing (console + the visible banner) is unchanged.
  // v568: manual_delivery_at carries a staff "this is closed, never send"
  // decision — see ispdManuallyDelivered().
  // v715: started at the top of this function (fetchAllLeadsRows).
  let { rows, error: leadsFetchError } = await pLeads;
  // v805: a failed reload (Maya, 2026-09-21: statement timeout right after a
  // PrimeHome send) used to replace the whole list with the empty result, so
  // the queue read "zero leads" until a manual refresh. Try once more; if it
  // still fails and a list is already on screen, keep that list and say so.
  if(leadsFetchError){
    console.error('Failed to load leads (retrying once):', leadsFetchError);
    ({ rows, error: leadsFetchError } = await fetchAllLeadsRows(start, end));
  }
  if(leadsFetchError && leadsLoadedOnce){
    console.error('Failed to load leads:', leadsFetchError);
    const keepBanner = $('leadsFetchErrorBanner');
    if(keepBanner){
      keepBanner.style.display = 'block';
      keepBanner.textContent = `Couldn't reload leads just now (${leadsFetchError.message || 'unknown error'}) — still showing the last list. Press Refresh to try again.`;
    }
    return;
  }
  if(leadsFetchError) console.error('Failed to load leads:', leadsFetchError);
  const leadsErrorBanner = $('leadsFetchErrorBanner');
  if(leadsErrorBanner){
    leadsErrorBanner.style.display = leadsFetchError ? 'block' : 'none';
    leadsErrorBanner.textContent = leadsFetchError ? `Couldn't load leads: ${leadsFetchError.message || 'unknown error'}. Try refreshing — if this keeps happening, check the browser console (F12) and Network tab for the /rest/v1/leads request.` : '';
  }
  const leads = rows;

  // v59: which of these leads had their status set automatically by an
  // iSpeedToLead postback (see ispeedtolead-postback Edge Function) —
  // shown as a small badge next to Status below. RLS-gated same as the
  // rest of this data (admin or a role granted the Activity tab); for
  // anyone else this just comes back empty and the badge never shows,
  // rather than erroring.
  const leadIds = leads.map(r => r.id);

  // v261: leadIds now covers the FULL date range (which, since the fixed
  // 2026-07-01..2050-12-31 default, is effectively "every lead" - 600+
  // rows) instead of the small handful a narrower default used to fetch.
  // A single .in('col', leadIds) with that many UUIDs risks exceeding a
  // request URL/size limit and failing outright - and neither query
  // below checked its `error`, so that failure was silent: the map just
  // ended up empty and every "Sent Jul X" badge quietly disappeared with
  // nothing in the console to explain why. Chunking keeps each request a
  // safe size regardless of how wide the date range gets, and logging
  // any chunk's error means a future failure is visible instead of
  // silently wiping the whole map again.
  // v715: the chunks go out together (they were awaited one by one).
  async function fetchInChunks(table, selectCols, column, ids, orderCol){
    const { data, error } = await selectInChunks(table, selectCols, column, ids, orderCol);
    if(error) console.error(`Failed to load a chunk of ${table}:`, error);
    return data;
  }

  // v715: these four were awaited one after another (the first two chunk by
  // chunk); they only need the lead ids, so they now run together.
  //   postbacks   -- v564: matched_via tells a REAL match from a
  //                  correlation-only one (see ispdHasPostbackDelivery()).
  //   submissions -- v69: OUTBOUND send status, latest row per lead, kept on
  //                  module-level maps so the modal needs no second round trip.
  //   v98 / v381  -- saved per-criterion ratings and AI Second Opinion verdicts.
  const [postbacks, submissions] = await Promise.all([
    leadIds.length ? fetchInChunks('ispeedtolead_postbacks', 'matched_lead_id, mapped_status, status_raw, reason, amount, received_at, matched_via', 'matched_lead_id', leadIds, 'received_at') : [],
    leadIds.length ? fetchInChunks('ispeedtolead_submissions', 'lead_id, success, created_at, error, submitted_by, channel', 'lead_id', leadIds, 'created_at') : [],
    loadLeadCriteriaEvaluations(leadIds),
    loadLeadAiFitEvaluations(leadIds),
  ]);
  const ispeedtoleadByLeadId = {};
  postbacks.forEach(p => { if(!ispeedtoleadByLeadId[p.matched_lead_id]) ispeedtoleadByLeadId[p.matched_lead_id] = p; });
  leadsIspeedtoleadSendByLeadId = {};
  leadsGyhomesSendByLeadId = {};
  leadsPrimehomeSendByLeadId = {};
  submissions.forEach(leadsNoteSendRow);

  const agentName = id => { const a = leadsAllProfiles.find(x => x.id === id); return a ? (a.full_name || a.email) : '—'; };
  const taskName = id => { const t = leadsAllTasks.find(x => x.id === id); return t ? t.name : 'No campaign'; };
  // v88: THIS is "Campaign Name" now — resolves submission_form_id, not
  // task_id. ISPD_DEFAULT_CAMPAIGN_NAME is declared further down in this
  // file (CSV/Excel import section) but already initialized by the time
  // this function actually runs (it's a plain top-level const, executed
  // once when the script first loads — well before any user action can
  // trigger loadLeads()).
  const formName = id => { const f = leadsAllForms.find(x => x.id === id); return f ? f.name : 'No campaign'; };

  // Totals only count accepted leads — this is what the Reports tab's
  // sales bonus formula also uses, so the number shown here always
  // matches what actually gets paid out. Pending/rejected are shown
  // separately so a backlog of unreviewed submissions is still visible.
  const accepted = leads.filter(r => r.status === 'accepted');
  const pendingCount = leads.filter(r => r.status === 'pending').reduce((t, r) => t + (r.count || 0), 0);
  const rejectedCount = leads.filter(r => r.status === 'rejected').reduce((t, r) => t + (r.count || 0), 0);
  const monthTotal = accepted.reduce((t, r) => t + (r.count || 0), 0);
  let totalLabel = `${label}: ${monthTotal} accepted lead${monthTotal === 1 ? '' : 's'}`;
  if(pendingCount) totalLabel += `  ·  ${pendingCount} pending review`;
  if(rejectedCount) totalLabel += `  ·  ${rejectedCount} rejected`;
  $('leadsMonthTotalLabel').textContent = totalLabel;

  // breakdown by agent — reuses the "sites visited" bar-row styling, accepted leads only
  const byAgent = {};
  accepted.forEach(r => { byAgent[r.user_id] = (byAgent[r.user_id] || 0) + (r.count || 0); });
  const agentRows = Object.entries(byAgent).sort((a, b) => b[1] - a[1]);
  const byAgentDiv = $('leadsByAgent');
  byAgentDiv.innerHTML = '';
  if(agentRows.length === 0){
    byAgentDiv.innerHTML = '<div class="empty">No accepted leads this month.</div>';
  } else {
    const maxCount = agentRows[0][1];
    agentRows.forEach(([userId, count]) => {
      const row = document.createElement('div');
      row.className = 'site-row';
      row.innerHTML = `
        <div class="site-domain" title="${escapeHtml(agentName(userId))}">${escapeHtml(agentName(userId))}</div>
        <div class="site-bar-track"><div class="site-bar-fill" style="width:${Math.max(2, count / maxCount * 100)}%"></div></div>
        <div class="site-time">${count}</div>
      `;
      byAgentDiv.appendChild(row);
    });
  }

  // v100: Leads Dashboard insight cards — plain counts (leads submitted
  // in range, not just accepted-lead `count` totals like monthTotal above,
  // since these are meant to answer "how much came in and what happened
  // to it", not "how much gets paid out").
  $('leadsInsightTotal').textContent = leads.length;
  $('leadsInsightAccepted').textContent = accepted.length;
  $('leadsInsightPending').textContent = leads.filter(r => r.status === 'pending').length;
  $('leadsInsightRejected').textContent = leads.filter(r => r.status === 'rejected').length;

  // v100: status breakdown — a proportional bar per status so the
  // accepted/pending/rejected split is visible at a glance instead of
  // just as separate numbers.
  const statusBreakdownDiv = $('leadsStatusBreakdown');
  if(statusBreakdownDiv){
    const statusCounts = [
      { key: 'accepted', label: 'Accepted', count: leads.filter(r => r.status === 'accepted').length, color: 'var(--good)' },
      { key: 'pending', label: 'Pending', count: leads.filter(r => r.status === 'pending').length, color: 'var(--away)' },
      { key: 'rejected', label: 'Rejected', count: leads.filter(r => r.status === 'rejected').length, color: 'var(--danger)' },
    ];
    const maxStatusCount = Math.max(1, ...statusCounts.map(s => s.count));
    if(!leads.length){
      statusBreakdownDiv.innerHTML = '<div class="empty">No leads submitted in this range.</div>';
    } else {
      statusBreakdownDiv.innerHTML = statusCounts.map(s => `
        <div class="site-row">
          <div class="site-domain">${s.label}</div>
          <div class="site-bar-track"><div class="site-bar-fill" style="width:${Math.max(2, s.count / maxStatusCount * 100)}%; background:${s.color};"></div></div>
          <div class="site-time">${s.count}</div>
        </div>
      `).join('');
    }
  }

  // v100: leads by day — a simple daily-volume bar chart over the selected
  // range, built client-side from whatever submitted_at dates are already
  // in `leads` (no extra fetch). Local calendar date, matching how every
  // other date-range control in this app already reads submitted_at.
  const byDayDiv = $('leadsByDay');
  if(byDayDiv){
    // v395: was bucketing by the BROWSER's own local date parts
    // (getFullYear/getMonth/getDate), completely ignoring the "Times
    // shown in" toggle — a lead near a day boundary could land in a
    // different day's bar than the one its own row shows elsewhere in
    // this same tab. localDateKeyInZone + leadsTzFor matches every other
    // date-range control in Leads.
    const byDay = {};
    leads.forEach(r => {
      const key = localDateKeyInZone(r.submitted_at, leadsTzFor(r.user_id) || FALLBACK_TIMEZONE);
      byDay[key] = (byDay[key] || 0) + 1;
    });
    const dayEntries = Object.entries(byDay).sort((a, b) => a[0].localeCompare(b[0]));
    if(!dayEntries.length){
      byDayDiv.innerHTML = '<div class="empty">No leads submitted in this range.</div>';
    } else {
      const maxDayCount = Math.max(1, ...dayEntries.map(([, c]) => c));
      byDayDiv.innerHTML = dayEntries.map(([day, count]) => `
        <div class="site-row">
          <div class="site-domain">${new Date(day + 'T00:00:00').toLocaleDateString([], { month: 'short', day: 'numeric' })}</div>
          <div class="site-bar-track"><div class="site-bar-fill" style="width:${Math.max(2, count / maxDayCount * 100)}%"></div></div>
          <div class="site-time">${count}</div>
        </div>
      `).join('');
    }
  }

  // v100: top campaigns — every campaign (Submission Form) with at least
  // one lead in range, most-submitted first. All statuses, unlike "By
  // agent" below which stays accepted-only (that one still backs the
  // sales-bonus-shaped number in monthTotal above).
  const byCampaignDiv = $('leadsByCampaign');
  if(byCampaignDiv){
    const byCampaign = {};
    leads.forEach(r => { byCampaign[r.submission_form_id || 'none'] = (byCampaign[r.submission_form_id || 'none'] || 0) + 1; });
    const campaignRows = Object.entries(byCampaign).sort((a, b) => b[1] - a[1]).slice(0, 12);
    if(!campaignRows.length){
      byCampaignDiv.innerHTML = '<div class="empty">No leads submitted in this range.</div>';
    } else {
      const maxCampaignCount = campaignRows[0][1];
      byCampaignDiv.innerHTML = campaignRows.map(([formId, count]) => `
        <div class="site-row">
          <div class="site-domain" title="${escapeHtml(formName(formId === 'none' ? null : formId))}">${escapeHtml(formName(formId === 'none' ? null : formId))}</div>
          <div class="site-bar-track"><div class="site-bar-fill" style="width:${Math.max(2, count / maxCampaignCount * 100)}%"></div></div>
          <div class="site-time">${count}</div>
        </div>
      `).join('');
    }
  }

  // v81: everything below used to render directly here. Now it's stored
  // module-level and handed off to renderLeadsQueueTable() /
  // renderIspdReviewTable() — both callable on their own (no re-fetch)
  // whenever one of the new per-subtab column filters changes, since they
  // read from this same already-fetched data instead of taking it as
  // params.
  leadsFullData = leads;
  leadsInboundPostbackByLeadId = ispeedtoleadByLeadId;
  leadsExtraFieldsLabelFn = extraFieldsLabel;
  leadsExtraFieldsEntriesFn = extraFieldsEntries;
  leadsAgentNameFn = agentName;
  leadsTaskNameFn = taskName;
  leadsFormNameFn = formName;
  leadsPrimeHomeBuyersFormId = (leadsAllForms.find(f => f.name === ISPD_DEFAULT_CAMPAIGN_NAME) || {}).id || null;
  // v107: same resolution pattern as leadsPrimeHomeBuyersFormId above —
  // the id of the seeded "Ticket" form, if it exists yet.
  leadsTicketFormId = (leadsAllForms.find(f => f.name === TICKET_FORM_NAME) || {}).id || null;
  populateLeadsCampaignFilterOptions();
  populateLeadsIspdSentByFilterOptions(agentName);
  renderLeadsQueueTable();
  renderIspdReviewTable();
  renderTicketsReviewTable();
  if(leadsActiveSection === 'all_queue') renderAllQueueTable();
  leadsLoadedOnce = true;
  subscribeLeadsLive();   // v715: from here on the queues update live
}

// v715: live Leads queues (the owner: "the lead queues should be updated, not
// cached -- real-time or 2-3 seconds delayed"). Every INSERT / UPDATE / DELETE
// on `leads` this person may see (Realtime applies the same row rules) is
// gathered for 0.7 s, then ONLY those leads are re-read -- the row plus its
// send history and postbacks -- merged into leadsFullData, and the queue
// tables redraw. No full reload per change. A full reload is still used where
// it is the only accurate answer: the Dashboard subtab (its cards are worked
// out inside loadLeadsNow), the Imported filter, a burst of more than 150
// leads (a file import), a failed re-read, and after the socket reconnects
// (changes made while it was down were never delivered). ispeedtolead_*
// tables are NOT in the realtime publication -- binding one would kill the
// channel (see the realtime memory note) -- so a send shows up through the
// lead row's own update, or the next load.
let leadsLiveChannel = null;
let leadsLiveEverSubscribed = false;
let leadsLiveRetryTimer = null;
let leadsLiveRetryDelay = 2000;
let leadsLiveTimer = null;
const leadsLivePending = new Set();
function subscribeLeadsLive(){
  if(leadsLiveChannel || !sb) return;
  const ch = sb.channel('leads-live-queues');
  leadsLiveChannel = ch;
  ch.on('postgres_changes', { event: '*', schema: 'public', table: 'leads' }, (payload) => {
      const id = (payload.new && payload.new.id) || (payload.old && payload.old.id);
      if(!id) return;
      leadsLivePending.add(id);
      leadsLiveSchedule();
    })
    .subscribe((status) => {
      if(ch !== leadsLiveChannel) return;   // an old channel being torn down
      if(status === 'SUBSCRIBED'){
        leadsLiveRetryDelay = 2000;
        if(leadsLiveEverSubscribed && leadsLoadedOnce) loadLeads();   // catch up on what the outage missed
        leadsLiveEverSubscribed = true;
      } else if(status === 'CHANNEL_ERROR' || status === 'TIMED_OUT'){
        leadsLiveScheduleRetry();
      }
    });
}
function leadsLiveScheduleRetry(){
  if(leadsLiveRetryTimer) return;
  const delay = leadsLiveRetryDelay;
  leadsLiveRetryDelay = Math.min(delay * 2, 60000);
  leadsLiveRetryTimer = setTimeout(() => {
    leadsLiveRetryTimer = null;
    const old = leadsLiveChannel;
    leadsLiveChannel = null;
    try{ if(old) sb.removeChannel(old); }catch(e){ /* already gone */ }
    subscribeLeadsLive();
  }, delay);
}
function leadsLiveSchedule(){
  if(!leadsLiveTimer) leadsLiveTimer = setTimeout(leadsLiveFlush, 700);
}
document.addEventListener('visibilitychange', () => { if(!document.hidden && leadsLivePending.size) leadsLiveSchedule(); });
function leadsRowInLoadedWindow(r){
  const { start, end } = leadsFetchRangeBounds();
  const t = new Date(r.submitted_at).getTime();
  if(start && t < new Date(start).getTime()) return false;
  if(end && t > new Date(end).getTime()) return false;
  return true;
}
function leadsRowOrder(a, b){
  const ta = new Date(a.submitted_at).getTime(), tb = new Date(b.submitted_at).getTime();
  if(ta !== tb) return tb - ta;                          // newest first
  return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;         // then id, as the fetch orders
}
async function leadsLiveFlush(){
  leadsLiveTimer = null;
  if(!leadsLoadedOnce){ leadsLivePending.clear(); return; }            // never opened: it loads fresh when it is
  const panel = $('tab-leads');
  if(!panel || !panel.classList.contains('active')){ leadsLivePending.clear(); return; }   // reloads on the next open
  if(document.hidden) return;                                           // kept; flushed when looked at again
  const ids = [...leadsLivePending];
  leadsLivePending.clear();
  if(!ids.length) return;
  if(leadsLoadInFlight){ try{ await leadsLoadInFlight; }catch(e){ /* shown by the load itself */ } }
  if(leadsActiveSection === 'dashboard' || leadsImportBatchFilter || ids.length > 150){ loadLeads(); return; }
  const [leadRes, subRes, pbRes] = await Promise.all([
    selectInChunks('leads', LEADS_SELECT_COLS, 'id', ids),
    selectInChunks('ispeedtolead_submissions', 'lead_id, success, created_at, error, submitted_by, channel', 'lead_id', ids, 'created_at'),
    selectInChunks('ispeedtolead_postbacks', 'matched_lead_id, mapped_status, status_raw, reason, amount, received_at, matched_via', 'matched_lead_id', ids, 'received_at'),
  ]);
  if(leadRes.error || subRes.error || pbRes.error){ loadLeads(); return; }
  if(leadsLoadInFlight) return;   // a full load started meanwhile, and it carries these too
  const idSet = new Set(ids);
  const merged = leadsFullData.filter(r => !idSet.has(r.id));
  leadRes.data.forEach(r => { if(leadsRowInLoadedWindow(r)) merged.push(r); });   // deleted / hidden / out of range -> dropped
  merged.sort(leadsRowOrder);
  leadsFullData = merged;
  ids.forEach(id => {
    delete leadsIspeedtoleadSendByLeadId[id]; delete leadsGyhomesSendByLeadId[id];
    delete leadsPrimehomeSendByLeadId[id]; delete leadsInboundPostbackByLeadId[id];
  });
  subRes.data.forEach(leadsNoteSendRow);
  pbRes.data.forEach(p => { if(!leadsInboundPostbackByLeadId[p.matched_lead_id]) leadsInboundPostbackByLeadId[p.matched_lead_id] = p; });
  renderLeadsQueueTable();
  renderIspdReviewTable();
  renderTicketsReviewTable();
  if(leadsActiveSection === 'all_queue') renderAllQueueTable();
}

// Matches a single lead row against one of the two independent per-subtab
// filter-state objects (leadsQueueFilters / leadsIspdFilters) — same 4
// columns in both (Seller Name / Phone / Campaign Name / Status), each
// subtab keeps its own state so filtering one doesn't affect the other.
// v88: null-safe membership check — leadsPrimeHomeBuyersFormId is null
// until that form actually exists (before any CSV import / manual
// creation), and a lead with NO campaign at all also has a null
// submission_form_id. Without the leadsPrimeHomeBuyersFormId truthiness
// check, null === null would wrongly claim every campaign-less lead as a
// "PrimeHome Buyers lead" the moment the form doesn't exist yet.
// v130: OR'd with "has an ispeedtolead_submissions row" (leadsIspeedtoleadSendByLeadId,
// populated earlier in loadLeads() from the same table the Send History
// modal reads from) — a lead can be genuinely, successfully sent to
// PrimeHome Buyers without submission_form_id ever getting set, if
// whatever sent it called the ispeedtolead-submit Edge Function directly
// rather than through the dashboard's own Send button (the ONLY UI path
// that sets this field — see openIspeedToLeadModal's one call site). That
// used to mean permanently invisible here despite having real send
// history. A lead already correctly tagged with the PrimeHome Buyers
// form still counts too, same as before — this only ever ADDS rows to
// the view, never removes any.
// v711 (the Wendy Carter lead: the property address held the seller's
// PHONE and the email held her NAME). Two helpers:
//   leadFieldProblem -- what an address or email field must never hold: an
//     address that is only a phone number, an email with no "@" (na / none /
//     n/a are allowed -- agents type them for "no email").
//   leadSemanticFallback -- when a form's address or email key is empty, the
//     lead's own value under ANOTHER form's key (Ticket: property_address,
//     email). A ticket moved between forms used to show those boxes blank
//     and required, which is how the wrong values went in.
const LEAD_PHONE_ONLY_RE = /^\s*\+?1?[\s.-]*\(?\d{3}\)?[\s.-]*\d{3}[\s.-]*\d{4}\s*$/;
function leadFieldKind(key, label){
  const t = `${key || ''} ${label || ''}`;
  if(/e-?mail/i.test(t)) return 'email';
  if(/address/i.test(t)) return 'address';
  return null;
}
function leadFieldProblem(key, label, value){
  const v = String(value || '').trim();
  if(!v) return null;
  const kind = leadFieldKind(key, label);
  if(kind === 'address' && LEAD_PHONE_ONLY_RE.test(v)) return `${label || 'Property address'} holds a phone number (${v}), not an address.`;
  if(kind === 'email' && !v.includes('@') && !/^(n\/?a|none|no email|-)$/i.test(v)) return `${label || 'Email'} does not look like an email address (${v}).`;
  return null;
}
function leadSemanticFallback(ef, key, label){
  const kind = leadFieldKind(key, label);
  if(!kind || !ef) return '';
  for(const [k, v] of Object.entries(ef)){
    if(k === key || v == null || String(v).trim() === '') continue;
    if(leadFieldKind(k, '') !== kind) continue;
    if(leadFieldProblem(k, '', v)) continue;          // never carry a bad value forward
    return String(v);
  }
  return '';
}

function isPrimeHomeBuyersLead(r){
  return (!!leadsPrimeHomeBuyersFormId && r.submission_form_id === leadsPrimeHomeBuyersFormId)
    || !!leadsIspeedtoleadSendByLeadId[r.id];
}

// v: Hard-blocks a duplicate PrimeHome Buyers submission before it's ever
// created. Checks the same phone+address combination iSpeedToLead's own
// Postback Setup Guide says makes a lead "unique and identifiable" on
// their end ("lead address + phone number... makes lead unique"). Added
// after the 2026-09 backfill found dozens of true duplicates — the same
// property submitted 2-3x within seconds, sometimes with typo'd phone
// digits — that nothing client-side had ever caught; this stops new ones
// at the source (agent submission form + CSV/Excel import) instead of
// relying on iSpeedToLead's own rejection, or a manual cleanup, after the
// fact.
//
// BUG FIX (user question, 2026-09-04 — "what if the seller has another
// address in different state"): this used to hard-block on a PHONE match
// alone, with no override — so a seller who genuinely owns a SECOND
// property in a different city/state (a real, separate, valid lead) was
// permanently rejected here just because their phone number already
// existed on file for their FIRST property. iSpeedToLead's own guide only
// calls "address + phone number" TOGETHER a match ("makes lead unique"),
// never phone alone. An address match stays a hard block with no
// override — that's the real, known failure mode this function exists
// for (the exact same property, sometimes with a typo'd phone digit,
// resubmitted seconds apart) — but a phone-only match (address differs or
// is new) now comes back as a separate, non-blocking signal instead, so
// the caller can warn-and-let-the-human-decide rather than silently
// losing a legitimate second property. Returns
// { id, status, submitted_at, extra_fields, matched_via: 'address'|'phone' }
// for whichever is found (address checked first — a real address match
// always wins over a merely-coincidental phone-only one), or null.
async function findPrimeHomeBuyersDuplicate(phoneNorm, address){
  if(!leadsPrimeHomeBuyersFormId) return null;
  const addressTrimmed = String(address || '').trim();
  if(addressTrimmed){
    const { data } = await sb.from('leads').select('id, status, submitted_at, extra_fields')
      .eq('submission_form_id', leadsPrimeHomeBuyersFormId)
      .ilike('extra_fields->>form_address', addressTrimmed)
      .order('submitted_at', { ascending: true }).limit(1);
    if(data && data.length) return { ...data[0], matched_via: 'address' };
  }
  if(phoneNorm){
    const { data } = await sb.from('leads').select('id, status, submitted_at, extra_fields')
      .eq('submission_form_id', leadsPrimeHomeBuyersFormId)
      .eq('seller_phone_norm', phoneNorm)
      .order('submitted_at', { ascending: true }).limit(1);
    if(data && data.length) return { ...data[0], matched_via: 'phone' };
  }
  return null;
}

// v (user request, 2026-09-04): "can I do the same in staff portal... when
// inputting address it recheck it" -- gyhomes' own lead-intake page shows
// live address suggestions as you type. Two independent pieces, both wired
// onto the SAME `form_address` input wherever it's rendered (the PrimeHome
// Buyers details panel and the agent-facing Lead Submission form both use
// the same data-field-key="form_address" convention already):
//   1. Google Places Autocomplete -- real, standardized address
//      suggestions while typing. Requires window.google.maps.places to
//      have loaded (see the <script> tag in <head>) -- silently skipped if
//      it hasn't (slow network, ad blocker, etc.), since typing an address
//      by hand must always keep working regardless.
//   2. A live duplicate check firing the moment an address is picked from
//      the dropdown (or the field/its paired phone field loses focus),
//      reusing findPrimeHomeBuyersDuplicate's exact same phone+address
//      logic -- so staff see "this looks like a duplicate" WHILE filling
//      the form, not only after clicking Submit.
// `opts`:
//   getPhoneNorm()      -- returns the current normalized phone to check
//                           against (the modal reads it off the
//                           already-loaded lead; the Lead Submission form
//                           reads its own sibling seller_phone input live).
//   getExcludeLeadId()  -- optional; the PrimeHome Buyers modal must
//                           exclude the lead it's currently editing from
//                           matching against itself.
//   phoneInput          -- optional sibling <input> to also re-run the
//                           check on when IT loses focus (only the Lead
//                           Submission form has one in the same container;
//                           the modal's phone lives on the lead object,
//                           not a field in this container).
function wireAddressAutocompleteAndDupCheck(container, opts){
  const addrInput = container.querySelector('input[data-field-key="form_address"]');
  if(!addrInput) return;
  let statusEl = addrInput.parentElement.querySelector('.address-dup-check-status');
  if(!statusEl){
    statusEl = document.createElement('div');
    statusEl.className = 'address-dup-check-status';
    statusEl.style.cssText = 'font-size:11px; margin-top:4px; display:none; line-height:1.4;';
    addrInput.insertAdjacentElement('afterend', statusEl);
  }
  async function runDupCheck(){
    const address = addrInput.value.trim();
    const phoneNorm = opts.getPhoneNorm ? opts.getPhoneNorm() : null;
    if(!address && !phoneNorm){ statusEl.style.display = 'none'; return; }
    const excludeId = opts.getExcludeLeadId ? opts.getExcludeLeadId() : null;
    let dup = await findPrimeHomeBuyersDuplicate(phoneNorm, address);
    if(dup && excludeId && dup.id === excludeId) dup = null;
    if(!dup){ statusEl.style.display = 'none'; return; }
    if(dup.matched_via === 'address'){
      statusEl.textContent = `⚠ A PrimeHome Buyers lead for this exact address already exists (status: ${dup.status}, submitted ${new Date(dup.submitted_at).toLocaleDateString()}).`;
      statusEl.style.color = 'var(--danger)';
    } else {
      const priorAddr = (dup.extra_fields || {}).form_address || 'no address on file';
      statusEl.textContent = `ℹ This phone number already has a PrimeHome Buyers lead on file for a different address (${priorAddr}, ${dup.status}). If this is genuinely a different property, that's fine.`;
      statusEl.style.color = 'var(--text-dim)';
    }
    statusEl.style.display = 'block';
  }
  if(window.googlePlacesReady && window.google?.maps?.places){
    // fields explicitly limited to what's actually used below -- Google
    // bills Autocomplete partly by which place fields a session requests,
    // so asking for everything by default (its own behavior if `fields`
    // is left unset) costs more for no benefit here. address_components is
    // needed to auto-fill the separate City/State/ZIP fields iSpeedToLead
    // requires alongside the free-text address line.
    addrInput.dataset.placesWired = '1';
    const ac = new google.maps.places.Autocomplete(addrInput, { types: ['address'], componentRestrictions: { country: 'us' }, fields: ['formatted_address', 'address_components'] });
    ac.addListener('place_changed', () => {
      const place = ac.getPlace();
      if(place && place.formatted_address) addrInput.value = place.formatted_address;
      const comps = place && place.address_components || [];
      const comp = type => comps.find(c => c.types.includes(type));
      const city = comp('locality') || comp('sublocality') || comp('postal_town');
      const state = comp('administrative_area_level_1');
      const zip = comp('postal_code');
      const cityInput = container.querySelector('[data-field-key="form_city"]');
      const stateInput = container.querySelector('[data-field-key="form_state"]');
      const zipInput = container.querySelector('[data-field-key="form_zip"]');
      if(cityInput && city) cityInput.value = city.long_name;
      if(stateInput && state) stateInput.value = state.short_name;
      if(zipInput && zip) zipInput.value = zip.long_name;
      runDupCheck();
    });
  }
  addrInput.addEventListener('blur', runDupCheck);
  if(opts.phoneInput) opts.phoneInput.addEventListener('blur', runDupCheck);
}

// Applies the Places Autocomplete widget to ANY submission form's address
// field, not just iSpeedToLead's fixed form_address key. Submission Forms
// Creator lets admins name fields anything, so there's no fixed "address"
// field type to key off of -- this matches on field_key/label text instead
// (containing "address", excluding "email"), so it works on whatever a
// given campaign's form actually calls its address field. Auto-fills any
// city/state/zip-looking sibling fields in the same container from the
// selected place's components, same as wireAddressAutocompleteAndDupCheck
// above. That function's iSpeedToLead-specific duplicate check is NOT
// duplicated here -- it stays scoped to PrimeHome Buyers since it needs
// iSpeedToLead's own lead data to compare against, which no other
// campaign has. Skips any field already wired by that function (tracked
// via data-places-wired) to avoid attaching two Autocomplete widgets to
// the same input.
function wireGenericAddressAutocomplete(container){
  if(!(window.googlePlacesReady && window.google?.maps?.places)){
    // v676: Places loads on demand now; wire this form once it arrives.
    if(typeof ensureGooglePlaces === 'function') ensureGooglePlaces().then(() => { if(container.isConnected) wireGenericAddressAutocomplete(container); }).catch(() => {});
    return;
  }
  const textInputs = Array.from(container.querySelectorAll('input[data-field-key]'));
  const labelFor = el => (el.previousElementSibling && el.previousElementSibling.tagName === 'LABEL') ? el.previousElementSibling.textContent : '';
  const looksLike = (el, re) => re.test(el.dataset.fieldKey || '') || re.test(labelFor(el));
  const addressInputs = textInputs.filter(el => !el.dataset.placesWired && !/email/i.test(el.dataset.fieldKey || '') && looksLike(el, /address/i));
  if(!addressInputs.length) return;
  const cityInput = textInputs.find(el => looksLike(el, /\bcity\b/i));
  const stateInput = textInputs.find(el => looksLike(el, /\bstate\b/i));
  const zipInput = textInputs.find(el => looksLike(el, /\bzip\b|postal/i));
  addressInputs.forEach(addrInput => {
    addrInput.dataset.placesWired = '1';
    const ac = new google.maps.places.Autocomplete(addrInput, { types: ['address'], componentRestrictions: { country: 'us' }, fields: ['formatted_address', 'address_components'] });
    ac.addListener('place_changed', () => {
      const place = ac.getPlace();
      if(place && place.formatted_address) addrInput.value = place.formatted_address;
      const comps = (place && place.address_components) || [];
      const comp = type => comps.find(c => c.types.includes(type));
      const city = comp('locality') || comp('sublocality') || comp('postal_town');
      const state = comp('administrative_area_level_1');
      const zip = comp('postal_code');
      if(cityInput && city) cityInput.value = city.long_name;
      if(stateInput && state) stateInput.value = state.short_name;
      if(zipInput && zip) zipInput.value = zip.long_name;
    });
  });
}

// v107: true while a ticket is still exclusively in the ticket flow — not
// yet actionable as a normal lead. 'staff_review' (awaiting staff Accept/
// Reject in Tickets Review) and 'client_review' (awaiting the client's
// Yes/No) both live ONLY in Tickets Review, same mutual-exclusivity idea
// as isPrimeHomeBuyersLead() above. 'recording_pending' (client said Yes)
// is deliberately NOT included here — at that point it's a completely
// ordinary pending lead under its real campaign and belongs in the
// general Leads Queue Review, even though it's still also visible for
// context in Tickets Review.
function isTicketInFlight(r){
  // v217: 'client_rejected' added — a ticket a client declined stays
  // "in flight" (exclusive to Tickets Review, never the plain Leads Queue
  // Review table) since staff can still redirect it to another campaign.
  return r.ticket_stage === 'staff_review' || r.ticket_stage === 'client_review' || r.ticket_stage === 'client_rejected';
}
// v713 (the owner: "leads from sales which is opportunity and converted to
// leads shouldn't be routed to Leads Queue Review -- that is for agents, not
// sales"). A Sales rep's "Convert to lead" on a dialer opportunity creates
// the lead with extra_fields.dialer_opportunity_id (dialer-call-control,
// convert_opportunity); an agent's submission never carries it. Those leads
// stay out of the agents' QA queue -- and out of its counts and export --
// but remain in All Queue with everything else.
function isSalesConversionLead(r){
  return !!(r && r.extra_fields && r.extra_fields.dialer_opportunity_id);
}
function excludedFromGeneralQueue(r){
  return isPrimeHomeBuyersLead(r) || isTicketInFlight(r) || isSalesConversionLead(r);
}
// v217: a lead that reached Leads Queue Review after a client said Yes to
// a ticket is otherwise indistinguishable from one submitted directly —
// ticket_stage stays 'recording_pending' for the rest of that lead's
// life (nothing ever clears it once set), so it's a reliable marker here.
function isLeadTicketOrigin(r){
  return r.ticket_stage === 'recording_pending';
}

function leadsRowMatchesFilters(r, filters){
  if(filters.user && r.user_id !== filters.user) return false;
  if(filters.seller && !(r.seller_investor_name || '').toLowerCase().includes(filters.seller.toLowerCase())) return false;
  if(filters.phone && !(r.seller_phone || '').replace(/\D/g, '').includes(filters.phone.replace(/\D/g, ''))) return false;
  // v88: "Campaign Name" = Submission Form now, not task — filters.task
  // keeps its original property name (internal plumbing only) but now
  // compares against submission_form_id.
  if(filters.task && r.submission_form_id !== filters.task) return false;
  if(filters.status && r.status !== filters.status) return false;
  // v192: From/To date range, matched against submitted_at. Previously
  // compared using `new Date(r.submitted_at).setHours(0,0,0,0)` — that
  // computes "the day" in the BROWSER's local timezone, while the Leads
  // Dashboard's own date range (leadsRangeBounds() above) computes it
  // using globalDisplayTzMode, the app-wide timezone toggle. A lead
  // submitted late at night could land on a different calendar day
  // depending on which of the two filters was doing the comparing —
  // now both use the exact same zoned day-boundary logic, so a lead on
  // the edge of a day reads identically everywhere in the Leads tab.
  if(filters.dateFrom || filters.dateTo){
    if(!r.submitted_at) return false;
    const submittedMs = new Date(r.submitted_at).getTime();
    if(filters.dateFrom){
      const [fy, fm, fd] = filters.dateFrom.split('-').map(Number);
      const { startMs } = dayBoundsMsInZone(globalDisplayTzMode, null, fy, fm, fd);
      if(submittedMs < startMs) return false;
    }
    if(filters.dateTo){
      const [ty, tm, td] = filters.dateTo.split('-').map(Number);
      const { endMs } = dayBoundsMsInZone(globalDisplayTzMode, null, ty, tm, td);
      if(submittedMs > endMs) return false;
    }
  }
  return true;
}

// Populates each subtab's own Campaign Name filter dropdown. General
// Queue Review: every OTHER campaign actually present in the currently-
// loaded (non-PrimeHome-Buyers) leads — same "only options that can
// possibly return a result" idea as before, just off submission_form_id
// instead of task_id. PrimeHome Buyers subtab: that tab is now exclusively
// PrimeHome Buyers leads (see renderIspdReviewTable), so there's nothing
// left to filter BY campaign there — the dropdown just shows the one
// campaign name, already selected, instead of a control that does nothing.
function populateLeadsCampaignFilterOptions(){
  const generalRows = leadsFullData.filter(r => !excludedFromGeneralQueue(r));
  const distinctIds = [...new Set(generalRows.map(r => r.submission_form_id).filter(Boolean))];
  const options = distinctIds.map(id => ({ id, name: leadsFormNameFn(id) })).sort((a, b) => a.name.localeCompare(b.name));
  const optionsHtml = '<option value="">All campaigns</option>' + options.map(o => `<option value="${o.id}">${escapeHtml(o.name)}</option>`).join('');
  const selGeneral = $('leadsQueueCampaignFilter');
  if(selGeneral){
    const prev = selGeneral.value;
    selGeneral.innerHTML = optionsHtml;
    if(options.some(o => o.id === prev)) selGeneral.value = prev;
  }

  const selIspd = $('leadsIspdCampaignFilter');
  if(selIspd){
    selIspd.innerHTML = leadsPrimeHomeBuyersFormId
      ? `<option value="${leadsPrimeHomeBuyersFormId}">${escapeHtml(ISPD_DEFAULT_CAMPAIGN_NAME)}</option>`
      : `<option value="">${escapeHtml(ISPD_DEFAULT_CAMPAIGN_NAME)}</option>`;
    selIspd.value = leadsPrimeHomeBuyersFormId || '';
    leadsIspdFilters.task = leadsPrimeHomeBuyersFormId || '';
  }
}

// v260: "Sent by" filter — who actually executed the PrimeHome Buyers
// send (ispeedtolead_submissions.submitted_by), not the agent who
// originally submitted the lead (that's the existing "User" filter).
// Built from whoever has actually sent at least one lead in the
// currently-loaded range, resolved via the unfiltered agentName() (an
// Owner/Admin can execute a send too, same reasoning leadsAllProfiles
// itself is unfiltered for).
function populateLeadsIspdSentByFilterOptions(agentName){
  const sel = $('leadsIspdSentByFilter');
  if(!sel) return;
  const senderIds = [...new Set(Object.values(leadsIspeedtoleadSendByLeadId).map(s => s.submitted_by).filter(Boolean))];
  const options = senderIds.map(id => ({ id, name: agentName(id) })).sort((a, b) => a.name.localeCompare(b.name));
  const prev = sel.value;
  sel.innerHTML = '<option value="">Anyone</option>' + options.map(o => `<option value="${o.id}">${escapeHtml(o.name)}</option>`).join('');
  if(options.some(o => o.id === prev)) sel.value = prev;
}

// Tiny generic debounce — used so the Seller Name/Phone text filters
// re-render after a short pause in typing rather than on every keystroke.
function debounce(fn, ms){
  let t;
  return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
}

// v805 (the owner: "make the display of queue 50 records per page to
// minimize the loading"): Leads Queue Review and PrimeHome Buyers (v806:
// and Tickets Review) draw one
// page of 50 rows instead of every lead in range. The page is kept across
// live updates and reloads (a send must not throw the reviewer back to page
// 1), clamped if the list got shorter, and reset to page 1 when that
// table's filters change. Stat cards and CSV export still count everything.
const LEADS_QUEUE_PAGE_SIZE = 50;
const leadsPagerState = {};   // key -> { page, sig }
function leadsPageRows(key, rows, filters, pagerId){
  const st = leadsPagerState[key] || (leadsPagerState[key] = { page: 1, sig: null });
  const sig = JSON.stringify(filters || {});
  if(st.sig !== null && st.sig !== sig) st.page = 1;
  st.sig = sig;
  const pages = Math.max(1, Math.ceil(rows.length / LEADS_QUEUE_PAGE_SIZE));
  if(st.page > pages) st.page = pages;
  if(st.page < 1) st.page = 1;
  const from = (st.page - 1) * LEADS_QUEUE_PAGE_SIZE;
  const slice = rows.slice(from, from + LEADS_QUEUE_PAGE_SIZE);
  const el = $(pagerId);
  if(el){
    if(rows.length <= LEADS_QUEUE_PAGE_SIZE){
      el.innerHTML = '';
      el.style.display = 'none';
    } else {
      el.style.display = 'flex';
      el.innerHTML = `
        <button type="button" class="btn-secondary" data-pg="first" ${st.page === 1 ? 'disabled' : ''}>&laquo; First</button>
        <button type="button" class="btn-secondary" data-pg="prev" ${st.page === 1 ? 'disabled' : ''}>&lsaquo; Prev</button>
        <span class="mono leads-pager-label">Page ${st.page} of ${pages} &middot; ${from + 1}&ndash;${from + slice.length} of ${rows.length}</span>
        <button type="button" class="btn-secondary" data-pg="next" ${st.page === pages ? 'disabled' : ''}>Next &rsaquo;</button>
        <button type="button" class="btn-secondary" data-pg="last" ${st.page === pages ? 'disabled' : ''}>Last &raquo;</button>`;
      el.querySelectorAll('button[data-pg]').forEach(b => b.addEventListener('click', () => {
        const go = b.dataset.pg;
        st.page = go === 'first' ? 1 : go === 'prev' ? st.page - 1 : go === 'next' ? st.page + 1 : pages;
        if(key === 'ispd') renderIspdReviewTable(); else if(key === 'tickets') renderTicketsReviewTable(); else renderLeadsQueueTable();
        const table = el.parentElement && el.parentElement.querySelector('table');
        if(table) table.scrollIntoView({ block: 'start', behavior: 'smooth' });
      }));
    }
  }
  return slice;
}

// v81: the Leads Queue Review table's own mini-dashboard + render, now
// callable standalone (reads leadsFullData/leadsQueueFilters instead of
// taking params) so the Seller Name/Phone/Campaign Name/Status filters
// above the table can re-render instantly with no re-fetch.
function renderLeadsQueueTable(){
  // v88: fully exclusive of the PrimeHome Buyers subtab now — a lead
  // whose submission_form_id is the PrimeHome Buyers form only ever shows
  // in Queue Review — PrimeHome Buyers (see renderIspdReviewTable), never
  // here, even unfiltered.
  // v250: call_back-status leads live in the dedicated Call Back subtab
  // until confirmed back to Pending — excluded here so they don't sit
  // around in this list with no Accept/Reject action available.
  const filtered = leadsFullData.filter(r => !excludedFromGeneralQueue(r) && r.status !== 'call_back' && leadsRowMatchesFilters(r, leadsQueueFilters));
  const agentName = leadsAgentNameFn, formName = leadsFormNameFn, extraFieldsLabel = leadsExtraFieldsLabelFn;
  const ispeedtoleadByLeadId = leadsInboundPostbackByLeadId;

  $('leadsQueueStatTotal').textContent = filtered.length;
  $('leadsQueueStatPending').textContent = filtered.filter(r => r.status === 'pending').length;
  $('leadsQueueStatAccepted').textContent = filtered.filter(r => r.status === 'accepted').length;
  $('leadsQueueStatRejected').textContent = filtered.filter(r => r.status === 'rejected').length;
  // v90: mirrored onto the Leads Dashboard subtab's own stat card so the
  // queue's total is visible without switching subtabs — this is the
  // unfiltered (date/user/status-range only, no local column filters)
  // count, same source data as leadsQueueStatTotal above minus this
  // function's own leadsQueueFilters narrowing.
  const dashQueueTotalEl = $('leadsDashboardQueueReviewTotal');
  if(dashQueueTotalEl) dashQueueTotalEl.textContent = leadsFullData.filter(r => !excludedFromGeneralQueue(r)).length;

  // CSV export intentionally reflects the FULL globally-filtered set
  // (Leads Dashboard's date/user/status filters), not these local column
  // filters — see the caption above the table. Built from leadsFullData
  // (minus PrimeHome Buyers leads, same exclusivity as the table itself),
  // not `filtered`.
  lastLeadsRows = leadsFullData.filter(r => !excludedFromGeneralQueue(r)).map(r => {
    const submittedLabel = new Date(r.submitted_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(leadsTzFor(r.user_id) ? { timeZone: leadsTzFor(r.user_id) } : {}) });
    const meta = LEAD_STATUS_META[r.status] || LEAD_STATUS_META.pending;
    const extraFieldsText = extraFieldsLabel(r.task_id, r.submission_form_id, r.extra_fields);
    const viaIspeedtolead = ispeedtoleadByLeadId[r.id] || null;
    const sendStatus = leadsIspeedtoleadSendByLeadId[r.id] || null;
    const sendStatusLabel = sendStatus ? (sendStatus.success ? `Sent ${new Date(sendStatus.created_at).toLocaleDateString([], { month: 'short', day: 'numeric', ...(leadsTzFor(r.user_id) ? { timeZone: leadsTzFor(r.user_id) } : {}) })}` : 'Send failed') : (ispdPostbackOnlyDelivery(r) ? 'Delivered (postback)' : (ispdManuallyDelivered(r) ? 'Closed by staff' : 'Not sent'));
    return {
      agent: agentName(r.user_id), submitted: submittedLabel, count: r.count,
      sellerInvestor: r.seller_investor_name || '—', phone: r.seller_phone || '', extraFieldsText,
      task: formName(r.submission_form_id), type: isLeadTicketOrigin(r) ? 'Lead Ticket' : 'Lead', status: meta.label,
      rejectReason: r.status === 'rejected' && r.review_note ? r.review_note : '',
      viaIspeedtolead: viaIspeedtolead ? 'PrimeHome Buyers' : '', ispeedtoleadSendStatus: sendStatusLabel,
    };
  });

  const body = $('leadsBody');
  body.innerHTML = '';
  if(filtered.length === 0){
    body.innerHTML = `<tr><td colspan="12" class="empty">${leadsFullData.length === 0 ? 'No leads submitted in this range.' : 'No leads match these filters.'}</td></tr>`;
    leadsPageRows('queue', [], leadsQueueFilters, 'leadsQueuePager');
    applyLeadsSectionEditGating('queue_review');
    return;
  }
  leadsPageRows('queue', filtered, leadsQueueFilters, 'leadsQueuePager').forEach(r => {   // v805: 50 per page
    const submittedLabel = new Date(r.submitted_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(leadsTzFor(r.user_id) ? { timeZone: leadsTzFor(r.user_id) } : {}) });
    const meta = LEAD_STATUS_META[r.status] || LEAD_STATUS_META.pending;
    const sellerInvestor = r.seller_investor_name || '—';
    const phone = r.seller_phone || '';
    const extraFieldsText = extraFieldsLabel(r.task_id, r.submission_form_id, r.extra_fields);
    const rejectReason = r.status === 'rejected' && r.review_note ? r.review_note : '';
    const viaIspeedtolead = ispeedtoleadByLeadId[r.id] || null;
    // v98: Campaign Fit — null (no fit computed at all, or every criterion
    // came back 'unclear') shows a plain dash rather than a false rating.
    const fitResult = leadsCampaignFitForBadge(r);
    const FIT_BADGE_META = {
      strong: { color: 'var(--good)', label: 'Strong Fit' },
      partial: { color: 'var(--away)', label: 'Partial Fit' },
      not_fit: { color: 'var(--danger)', label: 'Not a Fit' },
    };
    const guideBadge = (!fitResult || !fitResult.fit)
      ? '<span style="color:var(--text-dim); font-size:11px;">—</span>'
      : (() => {
          const meta = FIT_BADGE_META[fitResult.fit];
          const isAi = fitResult.verdicts.length && fitResult.verdicts.every(v => v.source === 'ai');
          const tooltip = fitResult.verdicts.map(v => `${v.label}: ${v.rating === 'unclear' ? 'unclear' : (v.rating === 'meets' ? 'meets' : 'does not meet')} (${v.source})`).join('\n');
          const tooltipHead = isAi ? `${fitResult.campaignName} — AI Second Opinion (${fitResult.aiModel || 'AI'}), ${fitResult.meetsCount}/${fitResult.evaluatedCount} criteria met${fitResult.aiSummary ? `\n${fitResult.aiSummary}` : ''}` : `${fitResult.campaignName} — ${fitResult.meetsCount}/${fitResult.evaluatedCount} criteria met`;
          const aiTag = isAi ? '<span style="opacity:0.7;">✓AI</span> ' : '';
          return `<span style="color:${meta.color}; font-size:11px; cursor:default;" title="${escapeHtml(`${tooltipHead}\n${tooltip}`)}">${aiTag}${meta.label}</span>`;
        })();

    // Delete is Owner/Admin only — everyone else (even roles with Leads
    // marked editable, which still grants Accept/Reject) never gets a
    // delete control here.
    const canDeleteLead = myIsOwner || myRole === 'admin';
    // A rejection with a reason recorded is final — no Accept control at
    // all once that's true (enforced server-side too, via a trigger, so
    // this isn't just a UI-level lock).
    const rejectedLocked = r.status === 'rejected' && !!r.review_note;
    // v140: the self-accept restriction that used to gate this on
    // view_scope including 'self' has been removed — a user can now
    // always accept/reject their own leads, same as any other lead they
    // can see. Mirrors can_edit_lead() in the DB (see schema.sql).
    const canEditThisLead = true;

    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${escapeHtml(agentName(r.user_id))}</td>
      <td class="mono">${submittedLabel}</td>
      <td class="mono">${r.count}</td>
      <td>${escapeHtml(sellerInvestor)}</td>
      <td><span class="lead-phone-cell edit-only" contenteditable="true" data-id="${r.id}" data-original="${escapeHtml(phone)}">${escapeHtml(phone)}</span></td>
      <td>${textPreviewCellHtml(extraFieldsText, 'Extra Fields')}</td>
      <td>${escapeHtml(formName(r.submission_form_id))}</td>
      <td>${isLeadTicketOrigin(r) ? '<span style="color:var(--focus); font-size:11px;">Lead Ticket</span>' : '<span style="color:var(--text-2); font-size:11px;">Lead</span>'}</td>
      <td>${guideBadge}</td>
      <td style="white-space:nowrap;"><span class="dot ${meta.dot}"></span><span class="${meta.text}">${meta.label}</span>${rejectedLocked ? ' <span class="lead-ispeedtolead-badge" title="A rejection with a reason recorded is final and cannot be re-accepted.">locked</span>' : ''}${viaIspeedtolead ? ` <span class="lead-ispeedtolead-badge" title="${viaIspeedtolead.amount != null ? `Amount: ${viaIspeedtolead.amount}` : 'Set automatically by a PrimeHome Buyers postback'}">via PrimeHome Buyers</span>` : ''}${r.desouky_chat_message_id ? ' <span class="lead-ispeedtolead-badge" title="Submitted through a chat conversation with Desouky, on behalf of this agent.">via Desouky</span>' : ''}</td>
      <td>${textPreviewCellHtml(rejectReason, 'Rejected reason')}</td>
      <td><div style="display:flex; gap:6px; align-items:center; flex-wrap:nowrap; white-space:nowrap;">
        ${r.status !== 'accepted' && !rejectedLocked && canEditThisLead ? `<button class="lead-review-btn edit-only" style="background:transparent; border:1px solid var(--away); border-radius:6px; color:var(--away); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px;">Review</button>` : ''}
        ${r.status === 'pending' && canEditThisLead ? `<button class="lead-callback-btn edit-only" data-id="${r.id}" style="background:transparent; border:1px solid var(--border-light); border-radius:6px; color:var(--text-2); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px;">Call Back</button>` : ''}
        ${
          // v152: undo an Accept pushed to the client by mistake — sends the
          // lead back to 'pending' (which also clears review_note/
          // reviewed_by/reviewed_at), the same state it'd be in if it had
          // never been reviewed. status='pending' immediately drops it out
          // of the client portal's own leads query (`.eq('status',
          // 'accepted')` — see client-portal.html), so it stops being
          // visible to the client the moment this saves. Gated the same
          // way Review/Reject already are — canEditThisLead plus
          // .edit-only — so an Owner/Admin, or a custom role granted Edit
          // on Leads Queue Review, can use it.
          r.status === 'accepted' && canEditThisLead ? `<button class="lead-recall-btn edit-only" style="background:transparent; border:1px solid var(--away); border-radius:6px; color:var(--away); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px;">Recall</button>` : ''
        }
        ${r.status !== 'rejected' && canEditThisLead ? `<button class="lead-reject-btn edit-only" style="background:transparent; border:1px solid var(--border-light); border-radius:6px; color:var(--danger); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px;">Reject</button>` : ''}
        ${canDeleteLead ? `<button class="lead-del-btn edit-only" data-id="${r.id}" style="background:transparent; border:1px solid var(--border-light); border-radius:6px; color:var(--text-dim); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px;">Delete</button>` : ''}
      </div></td>
    `;
    const reviewBtn = tr.querySelector('.lead-review-btn');
    const callBackBtn = tr.querySelector('.lead-callback-btn');
    const recallBtn = tr.querySelector('.lead-recall-btn');
    const rejectBtn = tr.querySelector('.lead-reject-btn');
    const delBtn = tr.querySelector('.lead-del-btn');
    const phoneEl = tr.querySelector('.lead-phone-cell');
    if(reviewBtn) reviewBtn.addEventListener('click', () => openLeadsQueueReviewModal(r, agentName(r.user_id)));
    if(callBackBtn) callBackBtn.addEventListener('click', () => openSendToCallBackModal(r, agentName(r.user_id)));
    if(recallBtn) recallBtn.addEventListener('click', () => recallAcceptedLeadToQueue(r, agentName(r.user_id)));
    if(rejectBtn) guardedClick(rejectBtn, () => setLeadStatus(r, 'rejected', agentName(r.user_id)));
    if(delBtn) delBtn.addEventListener('click', () => deleteLead(r, `${agentName(r.user_id)} — ${r.count} lead(s)`));
    if(phoneEl){
      phoneEl.addEventListener('blur', () => saveLeadPhone(phoneEl));
      phoneEl.addEventListener('keydown', (e) => {
        if(e.key === 'Enter'){ e.preventDefault(); phoneEl.blur(); }
        if(e.key === 'Escape'){ phoneEl.textContent = phoneEl.dataset.original; phoneEl.blur(); }
      });
    }
    body.appendChild(tr);
  });
  applyLeadsSectionEditGating('queue_review');
}

// v90: the Leads Queue Review column-filter row (Seller Name/Phone/
// Campaign Name/Status + Clear) was removed from this subtab — the
// Leads Dashboard's own date/user/status filters above still narrow
// what's fetched. leadsQueueFilters stays declared (all-empty, matching
// everything) purely so leadsRowMatchesFilters()'s shared shape doesn't
// need a special case for this subtab.

// v71: Lead Reviewing table, under Leads Queue Review → iSpeedToLead — the
// iSpeedToLead status/send column + button that used to live in the
// general Submissions table above, now on its own focused view. Reuses
// the SAME leadsFullData array loadLeads() already fetched (and the SAME
// leadsIspeedtoleadSendByLeadId map it just populated) rather than a
// second round trip.
// v81: param-less (reads leadsFullData/leadsIspdFilters module-level) so
// this subtab's own Seller Name/Phone/Campaign Name/Status filters can
// call it directly on every change — same pattern as
// renderLeadsQueueTable(), independent filter state.
function renderIspdReviewTable(){
  // v88: exclusively PrimeHome Buyers leads now (mutual exclusivity with
  // the general Queue Review tab — see that function's own comment). If
  // the PrimeHome Buyers form doesn't exist yet (leadsPrimeHomeBuyersFormId
  // null), this is simply empty rather than showing everything.
  // v250: same call_back exclusion as the general Queue Review table.
  // v: "Refund" isn't a real leads.status value -- both a straight
  // rejection and a refund leave the lead at status='rejected' (see
  // isIspdRefundLead's comment above), so leadsRowMatchesFilters (which
  // just compares filters.status === r.status) can't tell them apart on
  // its own. Swap 'refund' for 'rejected' before that shared check, then
  // split the two apart afterward using the matched postback's status_raw.
  const ispdStatusFilterValue = leadsIspdFilters.status;
  const ispdFiltersForMatch = ispdStatusFilterValue === 'refund' ? { ...leadsIspdFilters, status: 'rejected' } : leadsIspdFilters;
  let filtered = leadsFullData.filter(r => isPrimeHomeBuyersLead(r) && r.status !== 'call_back' && leadsRowMatchesFilters(r, ispdFiltersForMatch));
  if(ispdStatusFilterValue === 'refund') filtered = filtered.filter(r => isIspdRefundLead(r));
  else if(ispdStatusFilterValue === 'rejected') filtered = filtered.filter(r => !isIspdRefundLead(r));
  // v107: sent/not-sent filter — applied after leadsRowMatchesFilters since
  // it reads from leadsIspeedtoleadSendByLeadId, not a plain lead column.
  // v564: a postback counts as delivery here too. Without this a lead that
  // iSpeedToLead has already confirmed would sit under "Not sent" and get
  // swept into a bulk re-send — sending the buyer something they already
  // have. See ispdHasPostbackDelivery() for why it is never attributed to
  // a channel.
  if(leadsIspdFilters.sent === 'sent') filtered = filtered.filter(r => (leadsIspeedtoleadSendByLeadId[r.id] || {}).success || ispdHasPostbackDelivery(r) || ispdManuallyDelivered(r));
  else if(leadsIspdFilters.sent === 'not_sent') filtered = filtered.filter(r => !(leadsIspeedtoleadSendByLeadId[r.id] || {}).success && !ispdHasPostbackDelivery(r) && !ispdManuallyDelivered(r));
  // v471: "Sent via" — separate from the sent/not-sent filter above,
  // channel-specific (leadsGyhomesSendByLeadId/leadsPrimehomeSendByLeadId
  // are a clean partition of leadsIspeedtoleadSendByLeadId by channel).
  if(leadsIspdFilters.sentChannel === 'gyhomes') filtered = filtered.filter(r => (leadsGyhomesSendByLeadId[r.id] || {}).success);
  else if(leadsIspdFilters.sentChannel === 'primehome') filtered = filtered.filter(r => (leadsPrimehomeSendByLeadId[r.id] || {}).success);
  // v564: delivery confirmed by iSpeedToLead with no send record of our
  // own. Deliberately a THIRD state rather than folded into either
  // channel — a postback does not say which one it came through.
  else if(leadsIspdFilters.sentChannel === 'postback') filtered = filtered.filter(r => ispdPostbackOnlyDelivery(r));
  // v568: closed by a person, not by any provider signal.
  else if(leadsIspdFilters.sentChannel === 'manual') filtered = filtered.filter(r => ispdManuallyDelivered(r) && !(leadsIspeedtoleadSendByLeadId[r.id] || {}).success);
  // v260: "Sent by" — same reasoning as the sent/not-sent filter above,
  // applied after leadsRowMatchesFilters since it also reads from
  // leadsIspeedtoleadSendByLeadId rather than a plain lead column.
  if(leadsIspdFilters.sentBy) filtered = filtered.filter(r => (leadsIspeedtoleadSendByLeadId[r.id] || {}).submitted_by === leadsIspdFilters.sentBy);
  // Sent date range — filters on when the send actually happened
  // (leadsIspeedtoleadSendByLeadId[r.id].created_at), not submitted_at,
  // so it's a separate control from the From/To pair above which is
  // matched against leadsRowMatchesFilters. Only successful sends have
  // a meaningful "sent date", so this implicitly excludes not-sent/failed
  // rows once either bound is set.
  if(leadsIspdFilters.sentDateFrom || leadsIspdFilters.sentDateTo){
    filtered = filtered.filter(r => {
      const send = leadsIspeedtoleadSendByLeadId[r.id];
      if(!send || !send.success || !send.created_at) return false;
      const sentMs = new Date(send.created_at).getTime();
      if(leadsIspdFilters.sentDateFrom){
        const [fy, fm, fd] = leadsIspdFilters.sentDateFrom.split('-').map(Number);
        const { startMs } = dayBoundsMsInZone(globalDisplayTzMode, null, fy, fm, fd);
        if(sentMs < startMs) return false;
      }
      if(leadsIspdFilters.sentDateTo){
        const [ty, tm, td] = leadsIspdFilters.sentDateTo.split('-').map(Number);
        const { endMs } = dayBoundsMsInZone(globalDisplayTzMode, null, ty, tm, td);
        if(sentMs > endMs) return false;
      }
      return true;
    });
  }
  const agentName = leadsAgentNameFn, formName = leadsFormNameFn;
  const ispeedtoleadByLeadId = leadsInboundPostbackByLeadId;

  $('leadsIspdStatTotal').textContent = filtered.length;
  $('leadsIspdStatNotSent').textContent = filtered.filter(r => !leadsIspeedtoleadSendByLeadId[r.id]).length;
  $('leadsIspdStatSent').textContent = filtered.filter(r => (leadsIspeedtoleadSendByLeadId[r.id] || {}).success).length;
  $('leadsIspdStatFailed').textContent = filtered.filter(r => leadsIspeedtoleadSendByLeadId[r.id] && !leadsIspeedtoleadSendByLeadId[r.id].success).length;
  // v471: channel-specific successful-send counts, added alongside the
  // channel-agnostic cards above rather than replacing them.
  $('leadsIspdStatSentGyhomes').textContent = filtered.filter(r => (leadsGyhomesSendByLeadId[r.id] || {}).success).length;
  $('leadsIspdStatSentPrimehome').textContent = filtered.filter(r => (leadsPrimehomeSendByLeadId[r.id] || {}).success).length;
  // v (user request, 2026-09-04): "not published yet" per the most recent
  // iSpeedToLead lead-export import -- see istlExportBadge below for the
  // full explanation of what this state means and why it can only ever
  // come from a periodic export, never a live signal.
  $('leadsIspdStatNotPublished').textContent = filtered.filter(r => r.status === 'pending' && r.istl_export_status === 'not_published').length;
  // v90: mirrored onto the Leads Dashboard subtab, same idea as the
  // general Queue Review total above.
  const dashIspdTotalEl = $('leadsDashboardIspdTotal');
  if(dashIspdTotalEl) dashIspdTotalEl.textContent = leadsFullData.filter(r => isPrimeHomeBuyersLead(r)).length;

  // v260: volume breakdown by sender — successful sends only, matching
  // whatever's currently filtered above (same "site-row" bar styling as
  // the Leads Dashboard's own "By agent" card).
  const bySender = {};
  filtered.forEach(r => {
    const send = leadsIspeedtoleadSendByLeadId[r.id];
    if(send && send.success && send.submitted_by) bySender[send.submitted_by] = (bySender[send.submitted_by] || 0) + 1;
  });
  const senderRows = Object.entries(bySender).sort((a, b) => b[1] - a[1]);
  const bySenderDiv = $('leadsIspdBySender');
  if(bySenderDiv){
    if(senderRows.length === 0){
      bySenderDiv.innerHTML = '<div class="empty">No successful sends match these filters.</div>';
    } else {
      const maxCount = senderRows[0][1];
      bySenderDiv.innerHTML = senderRows.map(([userId, count]) => `
        <div class="site-row">
          <div class="site-domain" title="${escapeHtml(agentName(userId))}">${escapeHtml(agentName(userId))}</div>
          <div class="site-bar-track"><div class="site-bar-fill" style="width:${Math.max(2, count / maxCount * 100)}%"></div></div>
          <div class="site-time">${count}</div>
        </div>
      `).join('');
    }
  }

  const body = $('leadsIspdBody');
  if(!body) return;
  // v306: drop selections for rows that scrolled out of the current
  // filter (e.g. switching "Not sent" -> "Sent") so the bulk toolbar's
  // count/eligibility never reflects a row no longer visible.
  const filteredIds = new Set(filtered.map(r => r.id));
  Array.from(leadsIspdSelectedIds).forEach(id => { if(!filteredIds.has(id)) leadsIspdSelectedIds.delete(id); });
  body.innerHTML = '';
  if(!filtered.length){
    body.innerHTML = `<tr><td colspan="11" class="empty">${leadsFullData.length === 0 ? 'No leads submitted in this range.' : 'No leads match these filters.'}</td></tr>`;
    leadsPageRows('ispd', [], leadsIspdFilters, 'leadsIspdPager');
    applyLeadsSectionEditGating('queue_review_ispeedtolead');
    updateLeadsIspdBulkToolbar();
    return;
  }
  leadsPageRows('ispd', filtered, leadsIspdFilters, 'leadsIspdPager').forEach(r => {   // v805: 50 per page
    const submittedLabel = new Date(r.submitted_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(leadsTzFor(r.user_id) ? { timeZone: leadsTzFor(r.user_id) } : {}) });
    const meta = LEAD_STATUS_META[r.status] || LEAD_STATUS_META.pending;
    const sellerInvestor = r.seller_investor_name || '—';
    const phone = r.seller_phone || '';
    const viaIspeedtolead = ispeedtoleadByLeadId[r.id] || null;
    const isRefund = isIspdRefundLead(r, viaIspeedtolead);
    const statusLabel = isRefund ? 'refund' : meta.label;
    // v: same review_note the general Queue Review table's own "Rejected
    // reason" column reads (set either by a manual Reject or by the
    // ispeedtolead-postback Edge Function — see its comment on
    // update.review_note) -- a refund's reason lands here exactly the
    // same way a plain rejection's does, just relabeled per isRefund.
    const rejectReason = r.status === 'rejected' && r.review_note ? r.review_note : '';
    const sendStatus = leadsIspeedtoleadSendByLeadId[r.id] || null;
    const sendStatusLabel = sendStatus ? (sendStatus.success ? `Sent ${new Date(sendStatus.created_at).toLocaleDateString([], { month: 'short', day: 'numeric', ...(leadsTzFor(r.user_id) ? { timeZone: leadsTzFor(r.user_id) } : {}) })}` : 'Send failed') : (ispdPostbackOnlyDelivery(r) ? 'Delivered (postback)' : (ispdManuallyDelivered(r) ? 'Closed by staff' : 'Not sent'));
    // v140: self-accept restriction removed — see the matching comment in
    // the general Queue Review table above.
    const canEditThisLead = true;
    // v87: same "locked once rejected with a reason" rule as the general
    // Queue Review table's own Reject button — enforced server-side too
    // (leads_prevent_reaccept_rejected trigger), this just keeps the
    // button from appearing for a case the server would reject anyway.
    const rejectedLocked = r.status === 'rejected' && !!r.review_note;
    // v (user request, 2026-09-04): "can you track the unpublished leads?"
    // -- iSpeedToLead's live postback webhook only ever fires for a FINAL
    // decision (rejected/purchase/refund), never for "still under AI
    // review", so the only way to see that intermediate state at all is
    // the periodic lead-export snapshot (see leads_istl_export_status_tracking
    // migration + the exported-file.xlsx import this column is populated
    // from). Only shown for a still-pending lead — the moment a real
    // decision lands (via ispeedtolead-postback or a later export import),
    // istl_export_status is cleared, so this badge and a final status can
    // never both show at once.
    const istlExportBadge = (r.status === 'pending' && r.istl_export_status) ? (() => {
      const ageDays = r.istl_export_status_at ? Math.max(0, Math.floor((Date.now() - new Date(r.istl_export_status_at).getTime()) / 86400000)) : null;
      const ageText = ageDays != null ? ` — ${ageDays}d` : '';
      return r.istl_export_status === 'not_published'
        ? ` <span class="lead-ispeedtolead-badge" style="color:var(--text-dim);" title="Per iSpeedToLead's own lead export, this lead is still awaiting an AI publish/reject decision on their side.">awaiting gyhomes decision${ageText}</span>`
        : ` <span class="lead-ispeedtolead-badge" style="color:var(--good);" title="Per iSpeedToLead's own lead export, this lead passed their AI screening and is live for buyers, but not yet purchased.">published, awaiting sale${ageText}</span>`;
    })() : '';

    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td class="edit-only"><input type="checkbox" class="lead-ispd-select-cb" data-id="${r.id}" ${leadsIspdSelectedIds.has(r.id) ? 'checked' : ''}></td>
      <td>${escapeHtml(agentName(r.user_id))}</td>
      <td class="mono">${submittedLabel}</td>
      <td>${escapeHtml(sellerInvestor)}</td>
      <td class="mono">${escapeHtml(phone) || '—'}</td>
      <td>${r.submission_form_id ? escapeHtml(formName(r.submission_form_id)) : (sendStatus ? '<span title="Sent to PrimeHome Buyers, but never tagged with the PrimeHome Buyers campaign — likely sent outside the dashboard\'s own Send button.">PrimeHome Buyers (untagged)</span>' : escapeHtml(formName(r.submission_form_id)))}</td>
      <td style="white-space:nowrap;"><span class="dot ${meta.dot}"></span><span class="${meta.text}">${statusLabel}</span>${rejectedLocked ? ' <span class="lead-ispeedtolead-badge" title="A rejection with a reason recorded is final and cannot be re-accepted.">locked</span>' : ''}${viaIspeedtolead ? ` <span class="lead-ispeedtolead-badge" title="${viaIspeedtolead.amount != null ? `Amount: ${viaIspeedtolead.amount}` : 'Set automatically by a PrimeHome Buyers postback'}">via PrimeHome Buyers</span>` : ''}${istlExportBadge}</td>
      <td>${textPreviewCellHtml(rejectReason, isRefund ? 'Refund reason' : 'Rejected reason')}</td>
      <td>
        ${canEditThisLead ? `<button class="lead-ispeedtolead-btn edit-only" style="background:transparent; border:1px solid var(--border-light); border-radius:6px; color:${sendStatus && sendStatus.success ? 'var(--good)' : (sendStatus && !sendStatus.success ? 'var(--danger)' : 'var(--text-2)')}; cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px; white-space:nowrap;" title="${sendStatus && !sendStatus.success ? escapeHtml(sendStatus.error || 'Last send failed') : ''}">${escapeHtml(sendStatusLabel)}</button>` : escapeHtml(sendStatusLabel)}
      </td>
      <td style="color:var(--text-2);">${sendStatus && sendStatus.submitted_by ? escapeHtml(agentName(sendStatus.submitted_by)) : '—'}</td>
      <td><div style="display:flex; gap:6px; align-items:center; flex-wrap:nowrap; white-space:nowrap;">
        ${r.status === 'pending' && canEditThisLead ? `<button class="lead-callback-btn edit-only" data-id="${r.id}" style="background:transparent; border:1px solid var(--border-light); border-radius:6px; color:var(--text-2); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px;">Call Back</button>` : ''}
        ${r.status !== 'rejected' && canEditThisLead ? `<button class="lead-ispd-reject-btn edit-only" style="background:transparent; border:1px solid var(--border-light); border-radius:6px; color:var(--danger); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px; white-space:nowrap;">Reject</button>` : ''}
      </div></td>
    `;
    const selectCb = tr.querySelector('.lead-ispd-select-cb');
    const ispeedtoleadBtn = tr.querySelector('.lead-ispeedtolead-btn');
    const callBackBtn = tr.querySelector('.lead-callback-btn');
    const rejectBtn = tr.querySelector('.lead-ispd-reject-btn');
    if(selectCb) selectCb.addEventListener('change', () => {
      if(selectCb.checked) leadsIspdSelectedIds.add(r.id); else leadsIspdSelectedIds.delete(r.id);
      updateLeadsIspdBulkToolbar();
    });
    // v469: "Send to gyhomes" moved out of this row's Actions column --
    // now a button inside the "Send to PrimeHome Buyers" modal itself
    // (ispeedtoleadModalGyhomesBtn), next to Send to PrimeHome Buyers, per
    // your request. See openIspeedToLeadModal/that button's own listener.
    if(ispeedtoleadBtn) ispeedtoleadBtn.addEventListener('click', () => openIspeedToLeadModal(r, agentName(r.user_id)));
    if(callBackBtn) callBackBtn.addEventListener('click', () => openSendToCallBackModal(r, agentName(r.user_id)));
    if(rejectBtn) guardedClick(rejectBtn, () => setLeadStatus(r, 'rejected', agentName(r.user_id)));
    body.appendChild(tr);
  });
  applyLeadsSectionEditGating('queue_review_ispeedtolead');
  updateLeadsIspdBulkToolbar();
}

// v306: multi-select Call Back / Reject for the PrimeHome Buyers review
// table -- select any mix of rows (typically the "Not sent" filter,
// already sorted by Submitted at) and act on all of them in one write,
// instead of clicking each row's own Call Back/Reject one at a time.
// leadsIspdSelectedIds persists across re-renders (filter changes prune
// it, see renderIspdReviewTable) but NOT across leaving the tab, same
// lifetime as any other in-memory UI state in this dashboard.
let leadsIspdSelectedIds = new Set();
function updateLeadsIspdBulkToolbar(){
  const countEl = $('leadsIspdBulkSelectedCount');
  const callBackBtn = $('leadsIspdBulkCallBackBtn');
  const rejectBtn = $('leadsIspdBulkRejectBtn');
  const deleteBtn = $('leadsIspdBulkDeleteBtn');
  if(!countEl || !callBackBtn || !rejectBtn) return;
  const n = leadsIspdSelectedIds.size;
  countEl.textContent = n === 1 ? '1 selected' : `${n} selected`;
  callBackBtn.disabled = n === 0;
  rejectBtn.disabled = n === 0;
  if(deleteBtn){
    deleteBtn.style.display = myIsOwner ? '' : 'none';
    deleteBtn.disabled = n === 0;
  }
  // v572: available to anyone who can edit this section — unlike Delete,
  // this is reversible and touches no lead data.
  const closeBtn = $('leadsIspdBulkCloseBtn');
  const reopenBtn = $('leadsIspdBulkReopenBtn');
  if(closeBtn) closeBtn.disabled = n === 0;
  if(reopenBtn) reopenBtn.disabled = n === 0;
}
if($('leadsIspdSelectAllCb')) $('leadsIspdSelectAllCb').addEventListener('change', (e) => {
  document.querySelectorAll('.lead-ispd-select-cb').forEach(cb => {
    cb.checked = e.target.checked;
    const id = cb.dataset.id;
    if(e.target.checked) leadsIspdSelectedIds.add(id); else leadsIspdSelectedIds.delete(id);
  });
  updateLeadsIspdBulkToolbar();
});
// Only 'pending' leads ever show a per-row Call Back button (see the row
// template above) -- a lead already sent to Call Back, already rejected,
// etc. isn't a valid target. Bulk mirrors that instead of erroring on a
// mixed selection: eligible rows get acted on, ineligible ones are
// silently dropped, and the confirm text says how many will actually be
// touched so a staff member selecting a whole filtered page never gets a
// surprise.
if($('leadsIspdBulkCallBackBtn')) $('leadsIspdBulkCallBackBtn').addEventListener('click', async () => {
  const leads = leadsFullData.filter(r => leadsIspdSelectedIds.has(r.id) && r.status === 'pending');
  if(!leads.length){ alert('None of the selected rows are eligible for Call Back (already sent, rejected, or already in Call Back).'); return; }
  const reason = prompt(`Why do these ${leads.length} lead(s) need a call back? (required, applied to all selected)`);
  if(reason === null) return;
  const reasonTrim = reason.trim();
  if(!reasonTrim){ alert('A reason is required.'); return; }
  const { data: { user } } = await sb.auth.getUser();
  const ids = leads.map(l => l.id);
  const { error } = await sb.from('leads').update({
    status: 'call_back',
    callback_reason: reasonTrim,
    // Bulk skips the per-lead "which fields need confirming" checklist
    // the single-row modal offers (it's built from each lead's own blank
    // fields, which don't generalize across a mixed batch) -- the shared
    // reason above is expected to cover why, same as it would for any of
    // these leads individually.
    callback_fields_to_confirm: [],
    callback_claimed_by: null,
    callback_claimed_at: null,
    reviewed_by: user ? user.id : null,
    reviewed_at: new Date().toISOString(),
  }).in('id', ids);
  if(error){ alert(error.message); return; }
  logActivity('lead.call_back', 'lead', null, `Bulk sent ${ids.length} lead(s) to Call Back — reason: ${reasonTrim}`);
  leadsIspdSelectedIds.clear();
  await loadLeads();
});
if($('leadsIspdBulkRejectBtn')) $('leadsIspdBulkRejectBtn').addEventListener('click', async () => {
  const leads = leadsFullData.filter(r => leadsIspdSelectedIds.has(r.id) && r.status !== 'rejected');
  if(!leads.length){ alert('None of the selected rows are eligible for Reject (already rejected).'); return; }
  const reason = prompt(`Why are these ${leads.length} lead(s) being rejected? (required, applied to all selected)`);
  if(reason === null) return;
  const reasonTrim = reason.trim();
  if(!reasonTrim){ alert('A comment is required to reject a lead.'); return; }
  const { data: { user } } = await sb.auth.getUser();
  const ids = leads.map(l => l.id);
  const { error } = await sb.from('leads').update({
    status: 'rejected',
    review_note: reasonTrim,
    reviewed_by: user ? user.id : null,
    reviewed_at: new Date().toISOString(),
  }).in('id', ids);
  if(error){ alert(error.message); return; }
  logActivity('lead.review', 'lead', null, `Bulk rejected ${ids.length} lead(s) — reason: ${reasonTrim}`);
  leadsIspdSelectedIds.clear();
  await loadLeads();
});
// v572: mark closed / duplicate, and its undo.
//
// Fills a real gap: a lead that must never be sent had no way to leave the
// "Not sent" bucket. Two live cases drove it — 25 leads rejected on the
// call as already sold, and 9 true duplicates that could NOT be deleted
// because each carries its own send history and an iSpeedToLead postback
// (one with a $11.60 purchase against it). Both had to be set straight in
// the database because no control existed.
//
// This writes ONLY manual_delivery_at/_by/_note. It never touches status,
// submitted_at, review fields or extra_fields — so it cannot rewrite a
// review decision, and it is not a soft delete. That is also why it is
// available to anyone with edit rights here rather than Owner-only, and
// why Reopen sits next to it: an action this cheap to apply must be just
// as cheap to undo.
if($('leadsIspdBulkCloseBtn')) $('leadsIspdBulkCloseBtn').addEventListener('click', async () => {
  const leads = leadsFullData.filter(r => leadsIspdSelectedIds.has(r.id) && !r.manual_delivery_at);
  if(!leads.length){ alert('None of the selected rows need this — they are already marked closed.'); return; }
  const reason = prompt(
    `Why are these ${leads.length} lead(s) being closed? (required, applied to all selected)\n\n`
    + `Examples: "already sold, never submitted" or "duplicate of <lead id>".\n\n`
    + `They will leave the "Not sent" bucket and read "Closed by staff". Nothing about the lead's own data, status or dates changes, and Reopen undoes it.`
  );
  if(reason === null) return;
  const reasonTrim = reason.trim();
  if(!reasonTrim){ alert('A reason is required — it is the only record of why this lead was closed.'); return; }
  const { data: { user } } = await sb.auth.getUser();
  const ids = leads.map(l => l.id);
  const { error } = await sb.from('leads').update({
    manual_delivery_at: new Date().toISOString(),
    manual_delivery_by: user ? user.id : null,
    manual_delivery_note: reasonTrim,
  }).in('id', ids);
  if(error){ alert(error.message); return; }
  logActivity('lead.manual_close', 'lead', null, `Marked ${ids.length} lead(s) closed/duplicate — reason: ${reasonTrim}`);
  leadsIspdSelectedIds.clear();
  await loadLeads();
});
if($('leadsIspdBulkReopenBtn')) $('leadsIspdBulkReopenBtn').addEventListener('click', async () => {
  const leads = leadsFullData.filter(r => leadsIspdSelectedIds.has(r.id) && r.manual_delivery_at);
  if(!leads.length){ alert('None of the selected rows are marked closed.'); return; }
  if(!confirm(`Reopen ${leads.length} lead(s)? They go back into the sendable queue and the closed reason is cleared.`)) return;
  const ids = leads.map(l => l.id);
  const { error } = await sb.from('leads').update({
    manual_delivery_at: null, manual_delivery_by: null, manual_delivery_note: null,
  }).in('id', ids);
  if(error){ alert(error.message); return; }
  logActivity('lead.manual_close', 'lead', null, `Reopened ${ids.length} lead(s) — closed mark removed`);
  leadsIspdSelectedIds.clear();
  await loadLeads();
});

// v358: bulk delete for PrimeHome Buyers Queue Review -- Owner only (the
// button itself is hidden for everyone else, see updateLeadsIspdBulkToolbar,
// but this check guards the actual write too in case of a stale render).
// Permanent, same as every other lead delete in this app -- no undo.
if($('leadsIspdBulkDeleteBtn')) $('leadsIspdBulkDeleteBtn').addEventListener('click', async () => {
  if(!myIsOwner) return;
  const ids = Array.from(leadsIspdSelectedIds);
  if(!ids.length) return;
  if(!confirm(`Permanently delete these ${ids.length} lead(s)? This can't be undone.`)) return;
  const { error } = await sb.from('leads').delete().in('id', ids);
  if(error){ alert(error.message); return; }
  logActivity('lead.delete', 'lead', null, `Bulk deleted ${ids.length} lead(s) from Leads Queue Review — PrimeHome Buyers`);
  leadsIspdSelectedIds.clear();
  await loadLeads();
});

