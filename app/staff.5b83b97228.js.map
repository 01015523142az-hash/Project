// v72/v73: fields with an actual file attachment instead of (or in
// addition to) a pasted link. Both record_link and ping_id are plain
// string fields on PrimeHome Buyers' (iSpeedToLead's) side — nothing
// about their API knows or cares whether the value is a hand-typed id or
// a URL — so "attach a file" here just means: upload it somewhere with a
// stable public address, then send THAT address as the field's value.
// BUG FIX (2026-09-08): ping_id was accept:'*/*' on the theory that a
// "ping" proof could take any form. In practice it sits directly next to
// the record_link (audio) picker, and 140 of the 1,950 leads that have a
// ping_id got an .mp3 put in it -- an agent picking the recording twice.
// Those are not a cosmetic problem: gyhomes' field 127 is an image upload,
// so every one of them fails the send with "File type is not allowed"
// (confirmed live -- see the 2026-09-04 failures in
// ispeedtolead_submissions). The field is labelled and used as the dialer
// SCREENSHOT everywhere it is consumed, so constrain the picker to images
// and stop the mistake at the point it is made.
const ISPEEDTOLEAD_PING_ID_ACCEPT = 'image/*';
const ISPEEDTOLEAD_ATTACHMENT_FIELDS = {
  record_link: { accept: 'audio/*,video/*' },
  ping_id: { accept: ISPEEDTOLEAD_PING_ID_ACCEPT },
};

// `accept` only filters the file picker's default view -- it is trivially
// bypassed by switching the dialog to "All files", and does nothing for a
// pasted URL. This is the actual check.
const ISPEEDTOLEAD_IMAGE_EXT_RE = /\.(png|jpe?g|gif|webp|bmp|heic|heif)(\?|#|$)/i;
function ispdPingIdLooksLikeImage(value){
  const v = String(value || '').trim();
  if(!v) return true;                       // empty is a separate problem, not this one
  if(!/^https?:\/\//i.test(v)) return true; // a hand-typed id, not a file -- not ours to judge
  return ISPEEDTOLEAD_IMAGE_EXT_RE.test(v);
}

function ispeedtoleadFieldInputHtml(f, existingValue){
  const req = f.required ? ' <span style="color:var(--danger);">*</span>' : '';
  if(f.type === 'select'){
    const opts = ['<option value="">—</option>'].concat(f.options.map(o => `<option value="${escapeHtml(o)}"${existingValue === o ? ' selected' : ''}>${escapeHtml(o)}</option>`));
    return `<label>${escapeHtml(f.label)}${req}</label><select data-field-key="${f.key}">${opts.join('')}</select>`;
  }
  if(f.type === 'textarea'){
    return `<label>${escapeHtml(f.label)}${req}</label><textarea data-field-key="${f.key}" rows="2">${escapeHtml(existingValue || '')}</textarea>`;
  }
  if(f.type === 'multi'){
    const selected = new Set((existingValue || '').split('\n').filter(Boolean));
    const boxes = f.options.map(o => `
      <label style="display:flex; align-items:center; gap:6px; text-transform:none; letter-spacing:0; font-size:12px; font-weight:400; margin:2px 0;">
        <input type="checkbox" data-multi-key="${f.key}" value="${escapeHtml(o)}" ${selected.has(o) ? 'checked' : ''} style="width:auto;"> ${escapeHtml(o)}
      </label>`).join('');
    return `<label>${escapeHtml(f.label)}${req}</label><div style="border:1px solid var(--border-light); border-radius:6px; padding:8px 10px; max-height:140px; overflow-y:auto;">${boxes}</div>`;
  }
  if(ISPEEDTOLEAD_ATTACHMENT_FIELDS[f.key]){
    // Upload an actual file instead of only pasting a link — see
    // uploadIspeedtoleadAttachment(). The text input stays fully editable
    // too, so pasting an already-hosted URL still works exactly as
    // before; uploading just fills it in for you with the resulting
    // public storage URL, which is what actually gets sent.
    const accept = ISPEEDTOLEAD_ATTACHMENT_FIELDS[f.key].accept;
    return `<label>${escapeHtml(f.label)}${req}</label>
      <input type="text" data-field-key="${f.key}" placeholder="${escapeHtml(f.placeholder || '')}" value="${escapeHtml(existingValue || '')}">
      <div style="display:flex; align-items:center; gap:8px; margin-top:6px;">
        <input type="file" id="ispeedtoleadUpload_${f.key}_file" accept="${accept}" style="flex:1; font-size:11px; padding:0;">
        <button type="button" class="btn-secondary ispeedtolead-attach-upload-btn" data-attach-field="${f.key}" id="ispeedtoleadUpload_${f.key}_btn" style="width:auto; padding:6px 12px; font-size:11px; margin-top:0;">Upload</button>
      </div>
      <div class="msg" id="ispeedtoleadUpload_${f.key}_msg" style="margin-top:4px; margin-bottom:0;"></div>
      <div id="ispeedtoleadUpload_${f.key}_list"></div>`;
  }
  return `<label>${escapeHtml(f.label)}${req}</label><input type="text" data-field-key="${f.key}" placeholder="${escapeHtml(f.placeholder || '')}" value="${escapeHtml(existingValue || '')}">`;
}

// Mirrors splitName() in supabase/functions/ispeedtolead-submit/index.ts
// exactly — used only to PRE-FILL the First/Last name fields below with
// whatever the send logic would compute anyway if left untouched, so the
// admin can see it (and fix it, e.g. a one-word Seller Name with nothing
// to split off as a last name) instead of only finding out it's wrong
// after a failed send.
function ispeedtoleadSplitName(full){
  const trimmed = (full || '').trim().replace(/\s+/g, ' ');
  if(!trimmed) return { first: '', last: '' };
  const parts = trimmed.split(' ');
  if(parts.length === 1) return { first: parts[0], last: '' };
  return { first: parts.slice(0, -1).join(' '), last: parts[parts.length - 1] };
}

function renderIspeedToLeadFields(extraFields, sellerName){
  const ef = extraFields || {};
  const nameDefaults = ispeedtoleadSplitName(sellerName);
  return ISPEEDTOLEAD_FIELD_GROUPS.map(group => `
    <h4 style="margin:16px 0 8px; font-size:12px; color:var(--text-2); text-transform:uppercase; letter-spacing:0.04em;">${escapeHtml(group.title)}</h4>
    ${group.fields.map(f => {
      let existingValue = ef[f.key] != null ? ef[f.key] : (leadSemanticFallback(ef, f.key, f.label) || f.default || '');   // v711
      // Only pre-fill from the split if there's no explicit override
      // already saved — an existing form_first_name/form_last_name in
      // extra_fields always wins, same as the edge function's own logic.
      if(!existingValue && f.key === 'form_first_name') existingValue = nameDefaults.first;
      if(!existingValue && f.key === 'form_last_name') existingValue = nameDefaults.last;
      return `<div style="margin-bottom:10px;">${ispeedtoleadFieldInputHtml(f, existingValue)}</div>`;
    }).join('')}
  `).join('');
}

// Reads every field currently in the modal and returns a NEW extra_fields
// object: the lead's existing extra_fields with just the iSpeedToLead keys
// overwritten (set if non-empty, removed if left blank) — any unrelated
// key some other category's custom field put there is left untouched.
// v711: the same check for the Send to PrimeHome Buyers panel. Returns the
// problem to show, or null.
function ispdContactFieldProblem(){
  const container = $('ispeedtoleadModalFields');
  if(!container) return null;
  for(const key of ['form_address', 'form_email']){
    const el = container.querySelector(`[data-field-key="${key}"]`);
    if(!el) continue;
    const problem = leadFieldProblem(key, key === 'form_address' ? 'Property address' : 'Email', el.value);
    if(problem) return problem;
  }
  return null;
}
function collectIspeedToLeadFields(existingExtraFields){
  const result = { ...(existingExtraFields || {}) };
  const container = $('ispeedtoleadModalFields');
  ISPEEDTOLEAD_FIELD_GROUPS.forEach(group => group.fields.forEach(f => {
    if(f.type === 'multi'){
      const checked = Array.from(container.querySelectorAll(`[data-multi-key="${f.key}"]:checked`)).map(el => el.value);
      if(checked.length) result[f.key] = checked.join('\n'); else delete result[f.key];
    } else {
      const el = container.querySelector(`[data-field-key="${f.key}"]`);
      const val = el ? el.value.trim() : '';
      if(val) result[f.key] = val; else delete result[f.key];
    }
  }));
  return result;
}

let ispeedtoleadModalLead = null; // the full leads row currently open in the modal

// Uploads the chosen file to the lead-recordings storage bucket under
// this lead's own id (one bucket covers every attachment type — record_
// link and ping_id both just need "a file somewhere with a public URL",
// nothing bucket-specific to either), path-prefixed with the field key so
// multiple attachment types for the same lead don't collide. Fills the
// resulting public URL straight into that field's text input — same
// field Save/Send already reads from, so nothing else needs to know this
// happened. Public bucket (see schema.sql (v72 section)) so the URL
// stays valid indefinitely once handed to PrimeHome Buyers, not a signed
// URL that would eventually expire on their end.
async function uploadIspeedtoleadAttachment(file, fieldKey){
  if(!ispeedtoleadModalLead || !file) return;
  const msg = $(`ispeedtoleadUpload_${fieldKey}_msg`);
  const btn = $(`ispeedtoleadUpload_${fieldKey}_btn`);
  if(msg){ msg.textContent = 'Uploading…'; msg.className = 'msg'; }
  if(btn) btn.disabled = true;
  try {
    const ext = (file.name.split('.').pop() || 'dat').toLowerCase().replace(/[^a-z0-9]/g, '') || 'dat';
    const path = `${ispeedtoleadModalLead.id}/${fieldKey}-${Date.now()}.${ext}`;
    const { error: uploadErr } = await sb.storage.from('lead-recordings').upload(path, file, {
      upsert: false,
      contentType: file.type || 'application/octet-stream',
    });
    if(uploadErr){
      if(msg){ msg.textContent = `Upload failed: ${uploadErr.message}`; msg.className = 'msg error'; }
      return;
    }
    const { data: pub } = sb.storage.from('lead-recordings').getPublicUrl(path);
    const input = document.querySelector(`#ispeedtoleadModalFields [data-field-key="${fieldKey}"]`);
    if(input) input.value = pub.publicUrl;
    if(msg){ msg.textContent = 'Uploaded — link filled in above. Click "Save details" or "Send to PrimeHome Buyers" to keep it.'; msg.className = 'msg'; }
    await refreshIspeedtoleadAttachmentList(ispeedtoleadModalLead.id, fieldKey);
  } catch(e){
    if(msg){ msg.textContent = `Upload failed: ${e && e.message ? e.message : e}`; msg.className = 'msg error'; }
  } finally {
    if(btn) btn.disabled = false;
  }
}

// Builds one small public HTML page listing every file currently
// uploaded for this lead+field — audio files get an inline <audio>
// player, everything else (images, PDFs, logs — whatever a "ping"
// attachment turns out to be) gets an image preview or just a link.
// Uploaded with upsert:true at a FIXED path (not timestamped, unlike
// individual files) specifically so re-generating it after a new upload
// updates the SAME url — a link already sent to PrimeHome Buyers keeps
// showing everything uploaded since, without anyone needing to resend.
function ispeedtoleadIndexItemHtml(f){
  const ext = (f.url.split('?')[0].split('.').pop() || '').toLowerCase();
  const AUDIO_EXT = ['mp3', 'wav', 'm4a', 'ogg', 'aac', 'flac', 'webm'];
  const IMAGE_EXT = ['png', 'jpg', 'jpeg', 'gif', 'webp'];
  const preview = AUDIO_EXT.includes(ext)
    ? `<audio controls style="width:100%;" src="${escapeHtml(f.url)}"></audio>`
    : IMAGE_EXT.includes(ext)
      ? `<img src="${escapeHtml(f.url)}" style="max-width:100%; border-radius:6px; display:block;">`
      : '';
  return `
    <div style="margin-bottom:18px; padding:14px; border:1px solid #2a2f2c; border-radius:10px; background:#121714;">
      <div style="font-size:12px; color:#8a938d; margin-bottom:8px;">${escapeHtml(f.when)}</div>
      ${preview}
      <div style="margin-top:${preview ? '8px' : '0'}; font-size:12px;"><a href="${escapeHtml(f.url)}" style="color:#fd6262;">Open / download</a></div>
    </div>`;
}
async function regenerateIspeedtoleadRecordingsIndexPage(leadId, fieldKey, files){
  const title = (fieldKey === 'record_link' || fieldKey === 'recording_url') ? 'Call Recordings' : 'Ping ID Attachments';
  const html = `<!DOCTYPE html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>${escapeHtml(title)}</title>
<style>body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; max-width:680px; margin:40px auto; padding:0 20px; background:#0b0f0d; color:#e8e8e8;} h1{font-size:18px; font-weight:600;} a{color:#fd6262;}</style>
</head><body>
<h1>${escapeHtml(title)} (${files.length})</h1>
${files.map(ispeedtoleadIndexItemHtml).join('')}
</body></html>`;
  const path = `${leadId}/${fieldKey}-index.html`;
  const blob = new Blob([html], { type: 'text/html' });
  await sb.storage.from('lead-recordings').upload(path, blob, { upsert: true, contentType: 'text/html' });
  const { data: pub } = sb.storage.from('lead-recordings').getPublicUrl(path);
  return pub.publicUrl;
}

// A field can only ever SEND one URL (PrimeHome Buyers'/iSpeedToLead's API
// takes a single record_link/ping_id string, not a list) — but every file
// ever uploaded for this lead+field stays in storage and stays VISIBLE
// here, so uploading a 2nd or 3rd file doesn't silently bury the earlier
// ones with no way back to them. Each individual file has "Use" (points
// the field at just that one file) and delete; with 2+ files there's also
// a "Combined page" entry — one URL that lists/plays every file — for
// when the answer to "which one do I send" is "all of them."
async function refreshIspeedtoleadAttachmentList(leadId, fieldKey){
  const listEl = $(`ispeedtoleadUpload_${fieldKey}_list`);
  if(!listEl) return;
  listEl.innerHTML = '<span style="font-size:10px; color:var(--text-dim);">Loading uploads…</span>';
  const { data, error } = await sb.storage.from('lead-recordings').list(leadId, { sortBy: { column: 'name', order: 'desc' } });
  if(error || !data){ listEl.innerHTML = ''; return; }
  const indexFileName = `${fieldKey}-index.html`;
  const files = data.filter(f => f.name.startsWith(`${fieldKey}-`) && f.name !== indexFileName);
  if(!files.length){ listEl.innerHTML = ''; return; }

  const currentInput = document.querySelector(`#ispeedtoleadModalFields [data-field-key="${fieldKey}"]`);
  const currentUrl = currentInput ? currentInput.value.trim() : '';
  const attachListTz = nonAgentDisplayTz();

  let combinedRowHtml = '';
  if(files.length > 1){
    const withUrls = files.map(f => {
      const { data: pub } = sb.storage.from('lead-recordings').getPublicUrl(`${leadId}/${f.name}`);
      const when = f.created_at ? new Date(f.created_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(attachListTz ? { timeZone: attachListTz } : {}) }) : f.name;
      return { url: pub.publicUrl, when };
    });
    const combinedUrl = await regenerateIspeedtoleadRecordingsIndexPage(leadId, fieldKey, withUrls);
    const isCombinedActive = combinedUrl === currentUrl;
    combinedRowHtml = `
      <div style="display:flex; align-items:center; gap:6px; font-size:11px; padding:5px 6px; border-bottom:1px solid var(--border); background:var(--inset); margin-bottom:2px; border-radius:4px;">
        <a href="${escapeHtml(combinedUrl)}" target="_blank" rel="noopener" style="flex:1; color:var(--text); text-decoration:underline;">Combined page — all ${files.length} files</a>
        ${isCombinedActive ? '<span class="mono" style="font-size:9px; color:var(--focus);">IN USE</span>' : `<button type="button" class="btn-secondary ispeedtolead-attach-combine-btn" data-attach-field="${fieldKey}" data-attach-url="${escapeHtml(combinedUrl)}" style="width:auto; padding:2px 8px; font-size:10px; margin-top:0;">Use combined</button>`}
      </div>`;
  } else {
    // Down to 1 (or 0) files — a leftover combined page from before a 2nd
    // file got deleted no longer makes sense; best-effort cleanup, not
    // worth surfacing an error over.
    sb.storage.from('lead-recordings').remove([`${leadId}/${indexFileName}`]).catch(() => {});
  }

  listEl.innerHTML = `<div style="font-size:10px; color:var(--text-dim); margin:6px 0 3px;">${files.length} file${files.length === 1 ? '' : 's'} uploaded for this lead:</div>`
    + combinedRowHtml
    + files.map(f => {
      const path = `${leadId}/${f.name}`;
      const { data: pub } = sb.storage.from('lead-recordings').getPublicUrl(path);
      const isActive = pub.publicUrl === currentUrl;
      const when = f.created_at ? new Date(f.created_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(attachListTz ? { timeZone: attachListTz } : {}) }) : f.name;
      return `
        <div style="display:flex; align-items:center; gap:6px; font-size:11px; padding:3px 0; border-bottom:1px solid var(--border);">
          <a href="${pub.publicUrl}" target="_blank" rel="noopener" style="flex:1; color:var(--text-2); text-decoration:underline; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="Open in a new tab">${escapeHtml(when)}</a>
          ${isActive ? '<span class="mono" style="font-size:9px; color:var(--focus);">IN USE</span>' : `<button type="button" class="btn-secondary ispeedtolead-attach-use-btn" data-attach-field="${fieldKey}" data-attach-url="${escapeHtml(pub.publicUrl)}" style="width:auto; padding:2px 8px; font-size:10px; margin-top:0;">Use</button>`}
          <button type="button" class="ispeedtolead-attach-del-btn" data-attach-path="${escapeHtml(path)}" data-attach-field="${fieldKey}" data-attach-url="${escapeHtml(pub.publicUrl)}" title="Delete this file permanently" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:13px;">×</button>
        </div>`;
    }).join('');
  applyLeadsSectionEditGating('queue_review_ispeedtolead');
}

// Event delegation on the fields container — one listener handles every
// current AND future attachment-type field's Upload/Use/Combine/Delete
// buttons, rather than re-wiring specific button ids each time the modal
// re-renders (which is every single time it opens).
$('ispeedtoleadModalFields').addEventListener('click', async (e) => {
  const useBtn = e.target.closest('.ispeedtolead-attach-use-btn');
  if(useBtn){
    const input = document.querySelector(`#ispeedtoleadModalFields [data-field-key="${useBtn.dataset.attachField}"]`);
    if(input) input.value = useBtn.dataset.attachUrl;
    if(ispeedtoleadModalLead) refreshIspeedtoleadAttachmentList(ispeedtoleadModalLead.id, useBtn.dataset.attachField);
    return;
  }
  const combineBtn = e.target.closest('.ispeedtolead-attach-combine-btn');
  if(combineBtn){
    const input = document.querySelector(`#ispeedtoleadModalFields [data-field-key="${combineBtn.dataset.attachField}"]`);
    if(input) input.value = combineBtn.dataset.attachUrl;
    if(ispeedtoleadModalLead) refreshIspeedtoleadAttachmentList(ispeedtoleadModalLead.id, combineBtn.dataset.attachField);
    return;
  }
  const delBtn = e.target.closest('.ispeedtolead-attach-del-btn');
  if(delBtn){
    // audit fix (audit_chunk5.md #3, Medium): the applyLeadsSectionEditGating()
    // call at the end of refreshIspeedtoleadAttachmentList() only disables
    // elements carrying the .edit-only class -- these dynamically-rendered
    // Use/Combine/Delete buttons never carried that class, so it was never
    // actually gating them despite the call being present. Checking
    // canEditLeadsSection() directly here is the real enforcement point: a
    // view-only role could otherwise permanently delete an uploaded call
    // recording via this modal.
    if(!canEditLeadsSection('queue_review_ispeedtolead')){ alert('Your role has view-only access to this section.'); return; }
    if(!confirm('Delete this uploaded file permanently? This can\u2019t be undone, and if it\u2019s the one currently in use (or part of the combined page) you\u2019ll need to pick another before sending.')) return;
    const { error } = await sb.storage.from('lead-recordings').remove([delBtn.dataset.attachPath]);
    if(error){ alert(error.message); return; }
    // BUG FIX (2026-08-18, real failure: "Send to gyhomes" repeatedly
    // failing with "Failed to fetch file at .../record_link-....mp3: 400" --
    // the storage object had been deleted here, but this field was never
    // cleared, so it kept getting silently re-saved (Send auto-saves
    // whatever's on screen, see saveLeadPhone()'s sibling below) and
    // re-sent against a URL that no longer existed, every time. If the
    // just-deleted file is the one this field currently points to, clear
    // the field (both the visible input and the saved DB value, since
    // closing the modal without an explicit "Save details" click would
    // otherwise leave the stale URL sitting in extra_fields until the next
    // save) so a deleted file can never linger as a silently-broken
    // reference.
    const fieldKey = delBtn.dataset.attachField;
    const deletedInput = document.querySelector(`#ispeedtoleadModalFields [data-field-key="${fieldKey}"]`);
    if(deletedInput && deletedInput.value.trim() === delBtn.dataset.attachUrl && ispeedtoleadModalLead){
      deletedInput.value = '';
      const cleared = collectIspeedToLeadFields(ispeedtoleadModalLead.extra_fields);
      const { error: clearErr } = await sb.from('leads').update({ extra_fields: cleared }).eq('id', ispeedtoleadModalLead.id);
      if(!clearErr) ispeedtoleadModalLead.extra_fields = cleared;
    }
    if(ispeedtoleadModalLead) refreshIspeedtoleadAttachmentList(ispeedtoleadModalLead.id, fieldKey);
    return;
  }
  const uploadBtn = e.target.closest('.ispeedtolead-attach-upload-btn');
  if(!uploadBtn) return;
  const fieldKey = uploadBtn.dataset.attachField;
  const fileInput = $(`ispeedtoleadUpload_${fieldKey}_file`);
  const file = fileInput && fileInput.files && fileInput.files[0];
  if(!file){
    const msg = $(`ispeedtoleadUpload_${fieldKey}_msg`);
    if(msg){ msg.textContent = 'Choose a file first.'; msg.className = 'msg error'; }
    return;
  }
  uploadIspeedtoleadAttachment(file, fieldKey);
});

// ---------- v86: Leads Queue Review — "Review" popup ----------
// Same lead-recordings bucket + attachment-list logic as the iSpeedToLead
// modal above (regenerateIspeedtoleadRecordingsIndexPage/ispeedtoleadIndexItemHtml
// are fully generic and reused as-is), stored under extra_fields.recording_url
// so it survives alongside any category-specific fields. The one difference
// from iSpeedToLead's version: the file input here takes MULTIPLE files at
// once, uploaded one after another, since a reviewer attaching call
// recordings usually has more than one file ready at the same time.
const LEADS_QUEUE_RECORDING_FIELD_KEY = 'recording_url';
let leadsQueueReviewModalLead = null;

async function refreshLeadsQueueRecordingList(leadId){
  const listEl = $('leadsQueueReviewRecordingList');
  if(!listEl) return;
  listEl.innerHTML = '<span style="font-size:10px; color:var(--text-dim);">Loading uploads…</span>';
  const { data, error } = await sb.storage.from('lead-recordings').list(leadId, { sortBy: { column: 'name', order: 'desc' } });
  if(error || !data){ listEl.innerHTML = ''; return; }
  const indexFileName = `${LEADS_QUEUE_RECORDING_FIELD_KEY}-index.html`;
  const files = data.filter(f => f.name.startsWith(`${LEADS_QUEUE_RECORDING_FIELD_KEY}-`) && f.name !== indexFileName);
  if(!files.length){ listEl.innerHTML = ''; return; }

  const currentInput = $('leadsQueueReviewRecordingUrl');
  const currentUrl = currentInput ? currentInput.value.trim() : '';
  const recordingListTz = nonAgentDisplayTz();

  let combinedRowHtml = '';
  if(files.length > 1){
    const withUrls = files.map(f => {
      const { data: pub } = sb.storage.from('lead-recordings').getPublicUrl(`${leadId}/${f.name}`);
      const when = f.created_at ? new Date(f.created_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(recordingListTz ? { timeZone: recordingListTz } : {}) }) : f.name;
      return { url: pub.publicUrl, when };
    });
    const combinedUrl = await regenerateIspeedtoleadRecordingsIndexPage(leadId, LEADS_QUEUE_RECORDING_FIELD_KEY, withUrls);
    const isCombinedActive = combinedUrl === currentUrl;
    combinedRowHtml = `
      <div style="display:flex; align-items:center; gap:6px; font-size:11px; padding:5px 6px; border-bottom:1px solid var(--border); background:var(--inset); margin-bottom:2px; border-radius:4px;">
        <a href="${escapeHtml(combinedUrl)}" target="_blank" rel="noopener" style="flex:1; color:var(--text); text-decoration:underline;">Combined page — all ${files.length} files</a>
        ${isCombinedActive ? '<span class="mono" style="font-size:9px; color:var(--focus);">IN USE</span>' : `<button type="button" class="btn-secondary leads-queue-recording-combine-btn" data-attach-url="${escapeHtml(combinedUrl)}" style="width:auto; padding:2px 8px; font-size:10px; margin-top:0;">Use combined</button>`}
      </div>`;
  } else {
    // Down to 1 (or 0) files — a leftover combined page from before a 2nd
    // file got deleted no longer makes sense; best-effort cleanup.
    sb.storage.from('lead-recordings').remove([`${leadId}/${indexFileName}`]).catch(() => {});
  }

  listEl.innerHTML = `<div style="font-size:10px; color:var(--text-dim); margin:6px 0 3px;">${files.length} file${files.length === 1 ? '' : 's'} uploaded for this lead:</div>`
    + combinedRowHtml
    + files.map(f => {
      const path = `${leadId}/${f.name}`;
      const { data: pub } = sb.storage.from('lead-recordings').getPublicUrl(path);
      const isActive = pub.publicUrl === currentUrl;
      const when = f.created_at ? new Date(f.created_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(recordingListTz ? { timeZone: recordingListTz } : {}) }) : f.name;
      return `
        <div style="display:flex; align-items:center; gap:6px; font-size:11px; padding:3px 0; border-bottom:1px solid var(--border);">
          <a href="${pub.publicUrl}" target="_blank" rel="noopener" style="flex:1; color:var(--text-2); text-decoration:underline; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="Open in a new tab">${escapeHtml(when)}</a>
          ${isActive ? '<span class="mono" style="font-size:9px; color:var(--focus);">IN USE</span>' : `<button type="button" class="btn-secondary leads-queue-recording-use-btn" data-attach-url="${escapeHtml(pub.publicUrl)}" style="width:auto; padding:2px 8px; font-size:10px; margin-top:0;">Use</button>`}
          <button type="button" class="leads-queue-recording-del-btn" data-attach-path="${escapeHtml(path)}" data-attach-url="${escapeHtml(pub.publicUrl)}" title="Delete this file permanently" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:13px;">×</button>
        </div>`;
    }).join('');
}

// Uploads every chosen file, one after another (multiple files at once is
// the whole point here — see comment above). Each file gets its own
// timestamped+randomized path so simultaneous selections never collide.
async function uploadLeadsQueueRecordings(fileList){
  if(!leadsQueueReviewModalLead || !fileList || !fileList.length) return;
  const lead = leadsQueueReviewModalLead;
  const msg = $('leadsQueueReviewRecordingMsg');
  const btn = $('leadsQueueReviewRecordingUploadBtn');
  const files = Array.from(fileList);
  if(msg){ msg.textContent = `Uploading ${files.length} file${files.length > 1 ? 's' : ''}…`; msg.className = 'msg'; }
  if(btn) btn.disabled = true;
  let uploaded = 0, lastUrl = null;
  const failures = [];
  for(const file of files){
    try {
      const ext = (file.name.split('.').pop() || 'dat').toLowerCase().replace(/[^a-z0-9]/g, '') || 'dat';
      const path = `${lead.id}/${LEADS_QUEUE_RECORDING_FIELD_KEY}-${Date.now()}-${Math.random().toString(36).slice(2, 8)}.${ext}`;
      const { error: uploadErr } = await sb.storage.from('lead-recordings').upload(path, file, {
        upsert: false,
        contentType: file.type || 'application/octet-stream',
      });
      if(uploadErr){ failures.push(`${file.name}: ${uploadErr.message}`); continue; }
      const { data: pub } = sb.storage.from('lead-recordings').getPublicUrl(path);
      lastUrl = pub.publicUrl;
      uploaded++;
    } catch(e){
      failures.push(`${file.name}: ${e && e.message ? e.message : e}`);
    }
  }
  // Fill the URL field with the last successful upload so there's always
  // something in it (the reviewer can still pick a different one, or the
  // combined page, from the list below).
  const input = $('leadsQueueReviewRecordingUrl');
  if(input && lastUrl) input.value = lastUrl;
  if(msg){
    if(failures.length){
      msg.textContent = `Uploaded ${uploaded} of ${files.length}. Failed: ${failures.join('; ')}`;
      msg.className = 'msg error';
    } else {
      msg.textContent = `Uploaded ${uploaded} file${uploaded === 1 ? '' : 's'} — link filled in above.`;
      msg.className = 'msg';
    }
  }
  if(btn) btn.disabled = false;
  const fileInput = $('leadsQueueReviewRecordingFile');
  if(fileInput) fileInput.value = '';
  await refreshLeadsQueueRecordingList(lead.id);
}

$('leadsQueueReviewRecordingUploadBtn').addEventListener('click', () => {
  const fileInput = $('leadsQueueReviewRecordingFile');
  const files = fileInput && fileInput.files;
  if(!files || !files.length){
    const msg = $('leadsQueueReviewRecordingMsg');
    if(msg){ msg.textContent = 'Choose one or more files first.'; msg.className = 'msg error'; }
    return;
  }
  uploadLeadsQueueRecordings(files);
});

$('leadsQueueReviewRecordingList').addEventListener('click', async (e) => {
  const useBtn = e.target.closest('.leads-queue-recording-use-btn') || e.target.closest('.leads-queue-recording-combine-btn');
  if(useBtn){
    const input = $('leadsQueueReviewRecordingUrl');
    if(input) input.value = useBtn.dataset.attachUrl;
    if(leadsQueueReviewModalLead) refreshLeadsQueueRecordingList(leadsQueueReviewModalLead.id);
    return;
  }
  const delBtn = e.target.closest('.leads-queue-recording-del-btn');
  if(delBtn){
    // audit fix (audit_chunk5.md #3, Medium): refreshLeadsQueueRecordingList()
    // (unlike its iSpeedToLead counterpart) never called
    // applyLeadsSectionEditGating() at all, and \u2014 same as that counterpart,
    // see its own comment above \u2014 these Use/Delete buttons don't carry the
    // .edit-only class that call would need anyway. Checking
    // canEditLeadsSection() directly here is the real enforcement point: a
    // view-only role could otherwise permanently delete an uploaded call
    // recording via this modal.
    if(!canEditLeadsSection('queue_review')){ alert('Your role has view-only access to this section.'); return; }
    if(!confirm('Delete this uploaded file permanently? This can\u2019t be undone.')) return;
    const { error } = await sb.storage.from('lead-recordings').remove([delBtn.dataset.attachPath]);
    if(error){ alert(error.message); return; }
    // BUG FIX (2026-08-18): same stale-reference issue fixed in the
    // iSpeedToLead modal's own delete handler above (see its comment) --
    // if the just-deleted file is the one this field currently points to,
    // clear the input so Accept doesn't silently persist/require a
    // recording URL that no longer resolves to a real file.
    const recInput = $('leadsQueueReviewRecordingUrl');
    if(recInput && recInput.value.trim() === delBtn.dataset.attachUrl) recInput.value = '';
    if(leadsQueueReviewModalLead) refreshLeadsQueueRecordingList(leadsQueueReviewModalLead.id);
  }
});

function renderLeadsQueueReviewExtraFields(lead){
  const entries = leadsExtraFieldsEntriesFn(lead.task_id, lead.submission_form_id, lead.extra_fields);
  const wrap = $('leadsQueueReviewExtraFieldsWrap');
  const container = $('leadsQueueReviewExtraFields');
  if(!entries.length){
    container.innerHTML = '';
    wrap.style.display = 'none';
    return;
  }
  container.innerHTML = entries.map(e => {
    const val = String(e.value);
    // v97: a required field left blank gets its own flag — this is what
    // actually enforces "required" (see saveLeadsQueueReviewFieldsAndSetStatus()).
    const blankRequired = e.required && !val.trim();
    const highlightStyle = blankRequired ? 'border:1px solid var(--away); background:rgba(255,159,10,0.08);' : '';
    const requiredNote = blankRequired ? `<div style="font-size:10px; color:var(--away); margin-top:3px;">Required — this field must be filled in to accept.</div>` : '';
    return `
      <div style="margin-bottom:8px;">
        <label style="font-size:11px; color:var(--text-dim); font-weight:400; display:block; margin-bottom:3px;">${escapeHtml(e.label)}${e.required ? ' <span style="color:var(--away);">*</span>' : ''}</label>
        ${leadsExtraFieldInputHtml(e, 'leads-queue-review-extra-field', { requiredAttr: `data-required="${e.required ? 'true' : 'false'}"`, extraStyle: highlightStyle })}
        ${requiredNote}
      </div>`;
  }).join('');
  wrap.style.display = '';
}

// v389: the manual rule-based Campaign Fit Evaluation panel (Meets/
// Doesn't Meet/Unclear dropdowns) was removed from the Review popup —
// the AI Second Opinion below is now the sole/trusted analysis, and the
// learned-keyword memory it used to feed (saveCampaignFitEvaluations(),
// now deleted) is retired along with it.
//
// AI Quality Validator — independent Gemini second opinion, the sole
// Campaign Fit analysis now shown in the Review popup.
// Loads any previously-saved read on open; a reviewer explicitly triggers
// a new one via the button (a model call costs money — never automatic).
let leadsQueueReviewAIFitByLeadId = {}; // lead_id -> row from lead_ai_fit_evaluations

async function loadLeadsQueueReviewAIFit(lead){
  const wrap = $('leadsQueueReviewAIFitWrap');
  const container = $('leadsQueueReviewAIFit');
  if(!wrap || !container) return;
  leadsAiFitTranscriptShown = false;
  const fitResult = leadsCampaignFitFor(lead); // reuse the same guide match the rule-based tool found
  if(!fitResult || !fitResult.verdicts.length){
    wrap.style.display = 'none';
    return;
  }
  wrap.style.display = '';
  const { data, error } = await sb.from('lead_ai_fit_evaluations')
    .select('overall, summary, criteria, created_at, model, used_transcript, transcript_note')
    .eq('lead_id', lead.id).eq('campaign_norm_name', fitResult.normName).maybeSingle();
  if(error){ console.error('Failed to load AI fit evaluation', error); }
  leadsQueueReviewAIFitByLeadId[lead.id] = data || null;
  renderLeadsQueueReviewAIFit(lead, fitResult, data);
}

const AI_FIT_META = { strong: { color: 'var(--good)', label: 'Strong Fit' }, partial: { color: 'var(--away)', label: 'Partial Fit' }, not_fit: { color: 'var(--danger)', label: 'Not a Fit' } };

function renderLeadsQueueReviewAIFit(lead, fitResult, saved){
  const container = $('leadsQueueReviewAIFit');
  if(!container) return;
  if(!saved){
    container.innerHTML = `<div style="padding:6px 0;">No AI second opinion run yet for this lead.</div>`;
    return;
  }
  const aiFitTz = leadsTzFor(lead.user_id);
  const when = new Date(saved.created_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(aiFitTz ? { timeZone: aiFitTz } : {}) });
  const meta = AI_FIT_META[saved.overall] || { color: 'var(--text-dim)', label: saved.overall };
  // v116: whether this read factored in a transcript of the attached call
  // recording(s) — see campaign-fit-ai-validator's transcribeLeadRecordings().
  const transcriptNote = saved.used_transcript
    ? `<span style="color:var(--good);">\u{1F3A4} Includes call recording transcript</span> <button type="button" class="btn-secondary leads-ai-fit-view-transcript-btn" data-lead-id="${lead.id}" style="width:auto; padding:2px 8px; font-size:10px; margin-left:6px;">View transcript</button>`
    : (saved.transcript_note ? `<span style="color:var(--text-dim);">${escapeHtml(saved.transcript_note)}</span>` : '');
  container.innerHTML = `
    <div style="margin:6px 0; padding:8px 10px; border-radius:6px; background:rgba(255,255,255,0.04); color:${meta.color};">
      ${meta.label} — ${escapeHtml(saved.summary || '')}
      <div style="color:var(--text-dim); font-size:10px; margin-top:2px;">Checked ${when} (${escapeHtml(saved.model || 'AI')})</div>
      ${transcriptNote ? `<div style="font-size:10px; margin-top:4px;">${transcriptNote}</div>` : ''}
      <div id="leadsAiFitTranscriptBox" style="display:none; margin-top:8px; padding:8px; background:var(--inset); border-radius:6px; font-size:11px; white-space:pre-wrap; max-height:220px; overflow-y:auto;"></div>
    </div>
    ${(saved.criteria || []).map(c => {
      // v382: confidence (0-100, may be absent on evaluations run before
      // this was added — treated as "unknown", not shown as a fake 100%).
      // Anything below 70, or any 'unclear' verdict, surfaces what's
      // missing and a suggested follow-up question for a rep to ask on a
      // callback — the model was asked to fill these in whenever it isn't
      // confident, never just say "unclear" and stop there.
      const hasConfidence = typeof c.confidence === 'number';
      const lowConfidence = hasConfidence && c.confidence < 70;
      const needsFollowUp = c.verdict === 'unclear' || lowConfidence;
      const confBadge = hasConfidence
        ? `<span style="opacity:0.75; font-size:10px;"> · ${c.confidence}% confident</span>` : '';
      return `
      <div style="padding:6px 0; border-top:1px solid var(--border);">
        <div style="display:flex; justify-content:space-between; gap:8px;">
          <div style="flex:1;">
            <div style="color:var(--text);">${escapeHtml(c.label)}</div>
            <div style="color:var(--text-dim); font-size:10px;">${escapeHtml(c.reasoning || '')}</div>
          </div>
          <div style="white-space:nowrap; color:${c.verdict === 'meets' ? 'var(--good)' : c.verdict === 'does_not_meet' ? 'var(--danger)' : 'var(--text-dim)'};">
            ${c.verdict === 'meets' ? 'Meets' : c.verdict === 'does_not_meet' ? "Doesn't Meet" : 'Unclear'}${confBadge}
          </div>
        </div>
        ${c.conflict ? `<div style="margin-top:4px; padding:5px 7px; border-radius:5px; background:rgba(255,159,10,0.08); color:var(--away); font-size:10px;">⚠ Call vs. form conflict: ${escapeHtml(c.conflict)} (weighted toward what was said on the call)</div>` : ''}
        ${needsFollowUp && (c.missing_info || c.suggested_question) ? `
        <div style="margin-top:4px; padding:5px 7px; border-radius:5px; background:rgba(255,255,255,0.04); font-size:10px;">
          ${c.missing_info ? `<div style="color:var(--text-dim);">Missing: ${escapeHtml(c.missing_info)}</div>` : ''}
          ${c.suggested_question ? `<div style="color:var(--text); margin-top:2px;">Ask on follow-up: “${escapeHtml(c.suggested_question)}”</div>` : ''}
        </div>` : ''}
      </div>`;
    }).join('')}
  `;
  const viewBtn = container.querySelector('.leads-ai-fit-view-transcript-btn');
  if(viewBtn) viewBtn.addEventListener('click', () => toggleLeadAiFitTranscript(viewBtn.dataset.leadId));
}

// v116: fetches every cached transcript for this lead's recording(s) from
// lead_recording_transcripts (populated by campaign-fit-ai-validator) and
// shows them inline — works even after a page reload, since the raw
// transcript text isn't duplicated into lead_ai_fit_evaluations itself,
// just the used_transcript flag.
let leadsAiFitTranscriptShown = false;
async function toggleLeadAiFitTranscript(leadId){
  const box = $('leadsAiFitTranscriptBox');
  if(!box) return;
  leadsAiFitTranscriptShown = !leadsAiFitTranscriptShown;
  if(!leadsAiFitTranscriptShown){ box.style.display = 'none'; return; }
  box.style.display = '';
  box.textContent = 'Loading transcript\u2026';
  const { data, error } = await sb.from('lead_recording_transcripts')
    .select('transcript, status, source_url, created_at')
    .eq('lead_id', leadId).eq('status', 'done').order('created_at');
  if(error){ box.textContent = `Couldn't load transcript: ${error.message}`; return; }
  const parts = (data || []).filter(r => r.transcript);
  box.textContent = parts.length
    ? (parts.length === 1 ? parts[0].transcript : parts.map((p, i) => `Recording ${i + 1}:\n${p.transcript}`).join('\n\n'))
    : 'No cached transcript found.';
}

async function runCampaignFitAIValidator(lead){
  const btn = $('leadsQueueReviewAIFitBtn');
  const container = $('leadsQueueReviewAIFit');
  const fitResult = leadsCampaignFitFor(lead);
  if(!fitResult || !fitResult.verdicts.length) return;
  btn.disabled = true; btn.textContent = 'Checking\u2026';
  container.innerHTML = `<div style="padding:6px 0;">Asking AI for a second opinion\u2026</div>`;
  try {
    const criteria = fitResult.verdicts.map(v => ({ label: v.label, expected: v.expected }));
    const { data, error } = await sb.functions.invoke('campaign-fit-ai-validator', {
      body: { lead_id: lead.id, campaign_norm_name: fitResult.normName, campaign_display_name: fitResult.campaignName, criteria },
    });
    if(error || !data || !data.ok) throw new Error((data && data.error) || (error && error.message) || 'AI validator failed');
    renderLeadsQueueReviewAIFit(lead, fitResult, { ...data.result, model: undefined, created_at: new Date().toISOString() });
    await loadLeadsQueueReviewAIFit(lead); // re-pull the saved row so the model name + exact timestamp shown match what's stored
    // v390: the main queue table's Fit badge (leadsCampaignFitForBadge())
    // reads from leadAiFitEvaluationsByLeadId, a snapshot loaded once when
    // the queue list itself loads — without this, a fresh AI verdict only
    // showed up in this Review popup, and the queue row kept showing the
    // stale heuristic badge until a full page/list reload.
    const savedRow = leadsQueueReviewAIFitByLeadId[lead.id];
    if(savedRow){
      (leadAiFitEvaluationsByLeadId[lead.id] ||= {})[fitResult.normName] = { ...savedRow, campaign_norm_name: fitResult.normName };
      renderLeadsQueueTable();
    }
  } catch(e){
    console.error('AI fit validator failed', e);
    container.innerHTML = `<div style="padding:6px 0; color:var(--danger);">Couldn't get an AI second opinion: ${escapeHtml(e.message || String(e))}</div>`;
  } finally {
    btn.disabled = false; btn.textContent = 'Get AI Second Opinion';
  }
}
if($('leadsQueueReviewAIFitBtn')) $('leadsQueueReviewAIFitBtn').addEventListener('click', () => {
  if(leadsQueueReviewModalLead) runCampaignFitAIValidator(leadsQueueReviewModalLead);
});

async function openLeadsQueueReviewModal(lead, agentLabel){
  leadsQueueReviewModalLead = lead;
  $('leadsQueueReviewLeadId').value = lead.id;
  const reviewModalTz = leadsTzFor(lead.user_id);
  $('leadsQueueReviewSellerLabel').textContent = `Agent: ${agentLabel} — ${lead.count} lead(s) — submitted ${new Date(lead.submitted_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(reviewModalTz ? { timeZone: reviewModalTz } : {}) })}`;
  $('leadsQueueReviewSellerName').value = lead.seller_investor_name || '';
  $('leadsQueueReviewPhone').value = lead.seller_phone || '';
  $('leadsQueueReviewTask').textContent = leadsFormNameFn(lead.submission_form_id);
  renderLeadsQueueReviewExtraFields(lead);
  loadLeadsQueueReviewAIFit(lead);
  $('leadsQueueReviewRecordingUrl').value = (lead.extra_fields && lead.extra_fields[LEADS_QUEUE_RECORDING_FIELD_KEY]) || '';
  $('leadsQueueReviewRecordingMsg').textContent = '';
  $('leadsQueueReviewModalMsg').style.display = 'none';
  $('leadsQueueReviewRecordingFile').value = '';
  await refreshLeadsQueueRecordingList(lead.id);
  // v393: "Send as Ticket" only makes sense for a lead that's never been
  // through the ticket pipeline at all — leadsBody's own excludedFromGeneralQueue()
  // already keeps a lead currently IN FLIGHT as a ticket out of this table
  // entirely (see isTicketInFlight()), but a lead that already came BACK
  // from a ticket (ticket_stage='recording_pending') is still visible here
  // as an ordinary lead — hide the button for that case too, rather than
  // re-routing an already-once-ticketed lead back through the same flow.
  resetLeadsQueueReviewTicketNotes();
  const sendTicketBtn = $('leadsQueueReviewSendTicketBtn');
  if(sendTicketBtn) sendTicketBtn.style.display = lead.ticket_stage ? 'none' : '';
  $('leadsQueueReviewModalOverlay').classList.add('active');
}
function closeLeadsQueueReviewModal(){
  $('leadsQueueReviewModalOverlay').classList.remove('active');
  leadsQueueReviewModalLead = null;
}
$('leadsQueueReviewCancelBtn').addEventListener('click', closeLeadsQueueReviewModal);
$('leadsQueueReviewModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'leadsQueueReviewModalOverlay') closeLeadsQueueReviewModal(); });

// Persists the Seller Name / Phone / recording URL edited in the popup onto
// the lead row's own columns + extra_fields before applying the status
// change — same columns saveLeadPhone()/collectIspeedToLeadFields() already
// write to, just gathered from this modal's inputs instead.
// v583: FIX — one click, one SMS.
//
// Every lead action button ran its handler unguarded: not awaited, never
// disabled. The handler itself sent the client notification FIRST and only
// closed the modal after `await loadLeads()` -- a full re-fetch of the whole
// leads table, which takes seconds. So the operator clicked, saw nothing
// happen, and clicked again. Each click ran the entire action again,
// including another SMS.
//
// Measured on 2026-09-10 before this fix: one lead sent 7 "ticket_received"
// texts in 10 seconds, and activity_log holds 7 separate clicks 3-4s apart --
// human re-clicking cadence, not a retry loop. Two other leads took 7
// call-backs each and another took 3 accepts. The DB trigger was never at
// fault; it uses `select distinct client_id` and cannot duplicate.
//
// Keyed off the button element rather than a per-modal flag so the guard
// survives the modal being closed and reopened, and always re-enables in a
// finally so a thrown handler can't leave the button dead. Deliberately does
// NOT restore textContent -- the Send-as-Ticket button relabels itself to
// "Confirm Send as Ticket" on the first click, and resetting the label here
// would break that two-step flow.
// v584: takes an ELEMENT as well as an id. The accept/reject buttons in the
// Call Activity, Queue Review, PrimeHome and Tickets tables are rebuilt on
// every render and have no stable id, so they can only be guarded by
// reference. Same guard either way -- the busy flag lives on the element.
function guardedClick(btnOrId, handler){
  const btn = typeof btnOrId === 'string' ? document.getElementById(btnOrId) : btnOrId;
  if(!btn) return;
  btn.addEventListener('click', async (ev) => {
    if(btn.dataset.busy === '1') return;
    btn.dataset.busy = '1';
    btn.disabled = true;
    try {
      await handler(ev);
    } catch (err) {
      console.error(`guardedClick(${btnId}) failed:`, err);
    } finally {
      delete btn.dataset.busy;
      btn.disabled = false;
    }
  });
}

async function saveLeadsQueueReviewFieldsAndSetStatus(status){
  const lead = leadsQueueReviewModalLead;
  if(!lead) return;
  const msgEl = $('leadsQueueReviewModalMsg');
  msgEl.style.display = 'none';
  let reviewNote = null;
  if(status === 'rejected'){
    reviewNote = prompt(`Why is this lead being rejected? (required)\n\nAgent — ${lead.count} lead(s)`);
    if(reviewNote === null) return; // cancelled
    reviewNote = reviewNote.trim();
    if(!reviewNote){ alert('A comment is required to reject a lead.'); return; }
  }
  const sellerName = $('leadsQueueReviewSellerName').value.trim();
  const phone = $('leadsQueueReviewPhone').value.trim();
  const recordingUrl = $('leadsQueueReviewRecordingUrl').value.trim();

  // v93/v97: Seller Name and Phone are always required to accept (they're
  // the two reserved fields every lead has regardless of form). Every
  // OTHER submitted field is required only if the lead's own source form
  // (Submission Forms Creator / task category) actually marked it
  // required — see extraFieldsEntries()'s `required` flag and the
  // data-required attribute set on each input by
  // renderLeadsQueueReviewExtraFields(). Rejecting a lead is unaffected
  // (incomplete leads still need to be rejectable).
  // v107: the recording attachment used to be intentionally optional here
  // (typically attached after the fact) — now required to Accept, per
  // Adel's request. Still not required to Reject.
  if(status === 'accepted'){
    const missing = [];
    if(!sellerName) missing.push('Seller / Investor Name');
    if(!phone) missing.push('Phone');
    if(!recordingUrl) missing.push('Recording (Attach Recording(s) — paste a URL or upload a file)');
    document.querySelectorAll('#leadsQueueReviewExtraFields .leads-queue-review-extra-field').forEach(el => {
      if(el.dataset.required === 'true' && !el.value.trim()){
        const label = el.closest('div')?.querySelector('label')?.textContent.replace(/[\s*\u26a0]+$/, '') || el.dataset.key;
        missing.push(label);
      }
    });
    if(missing.length){
      msgEl.textContent = `Required fields missing: ${missing.join(', ')}.`;
      msgEl.style.display = '';
      return;
    }
  }

  const extraFields = { ...(lead.extra_fields || {}) };
  if(recordingUrl) extraFields[LEADS_QUEUE_RECORDING_FIELD_KEY] = recordingUrl; else delete extraFields[LEADS_QUEUE_RECORDING_FIELD_KEY];
  // v87: each submitted field's own (now-editable) input/textarea — see
  // renderLeadsQueueReviewExtraFields(). Blanking a field out removes it
  // rather than saving an empty string, same convention extraFieldsLabel()
  // already uses to decide what counts as "set".
  document.querySelectorAll('#leadsQueueReviewExtraFields .leads-queue-review-extra-field').forEach(el => {
    const key = el.dataset.key;
    const val = el.value.trim();
    if(val) extraFields[key] = val; else delete extraFields[key];
  });

  const { data: { user } } = await sb.auth.getUser();
  const update = {
    seller_investor_name: sellerName || null,
    seller_phone: phone || null,
    extra_fields: extraFields,
    status,
    reviewed_by: user ? user.id : null,
    reviewed_at: new Date().toISOString(),
  };
  if(status === 'rejected') update.review_note = reviewNote;
  else if(status === 'accepted') update.review_note = null;

  const { error } = await sb.from('leads').update(update).eq('id', lead.id);
  if(error){ msgEl.textContent = error.message; msgEl.style.display = ''; return; }
  // v153: this is the main "push a lead to the client" moment — text
  // every client granted this campaign. (v395: routed through the shared
  // notifyIfLeadAccepted helper — see its comment on setLeadStatus.)
  notifyIfLeadAccepted(lead, status);

  await loadLeads();
  await refreshDetailIfViewing(lead.user_id);
  logActivity('lead.review', 'lead', lead.id, `Marked ${status} — ${lead.count} lead(s)${status === 'rejected' ? ` — reason: ${reviewNote}` : ''}`);
  closeLeadsQueueReviewModal();
}
guardedClick('leadsQueueReviewAcceptBtn', () => saveLeadsQueueReviewFieldsAndSetStatus('accepted'));
guardedClick('leadsQueueReviewRejectBtn', () => saveLeadsQueueReviewFieldsAndSetStatus('rejected'));

// v393: "Send as Ticket" — pushes an already-normal (already
// campaign-tagged) lead to that same campaign's client for a Yes/No
// decision, via the exact same ticket_stage='client_review' pipeline the
// dedicated Ticket-submission workflow uses (see openTicketAcceptModal()'s
// confirm handler, which this closely mirrors) — just without a campaign
// picker, since this lead's submission_form_id is already its real
// campaign. First click reveals the mandatory Ticket Notes field and
// re-labels the button to "Confirm Send as Ticket"; a second click with
// notes filled in actually sends it.
function resetLeadsQueueReviewTicketNotes(){
  const wrap = $('leadsQueueReviewTicketNotesWrap');
  const btn = $('leadsQueueReviewSendTicketBtn');
  if(wrap) wrap.style.display = 'none';
  if($('leadsQueueReviewTicketNotes')) $('leadsQueueReviewTicketNotes').value = '';
  if(btn) btn.textContent = 'Send as Ticket';
}
async function sendLeadAsTicket(lead, notes){
  const msgEl = $('leadsQueueReviewModalMsg');
  const { data: { user } } = await sb.auth.getUser();
  const extraFields = { ...(lead.extra_fields || {}), ticket_notes: notes };
  // v583: the update is CONDITIONAL on the lead not already being a ticket,
  // and the notification only fires if a row actually changed. The button
  // guard above stops one person double-clicking; this stops everything else
  // -- two reviewers acting on the same lead at once, a retried request, a
  // stale modal left open in another tab. The DB decides, not the UI.
  //
  // `.neq()` alone would be wrong: ticket_stage is NULL on a normal lead and
  // `NULL <> 'client_review'` is NULL, not true, so the row would never match
  // and sending a ticket would silently do nothing. The explicit null branch
  // is required.
  const { data: updatedRows, error } = await sb.from('leads').update({
    ticket_stage: 'client_review',
    status: 'pending',
    review_note: null,
    reviewed_by: user ? user.id : null,
    reviewed_at: new Date().toISOString(),
    extra_fields: extraFields,
  }).eq('id', lead.id)
    .or('ticket_stage.is.null,ticket_stage.neq.client_review')
    .select('id');
  if(error){ msgEl.textContent = error.message; msgEl.style.display = ''; return; }
  if(!updatedRows || !updatedRows.length){
    msgEl.textContent = 'This lead is already waiting on the client — no second ticket was sent.';
    msgEl.style.display = '';
    await loadLeads();
    return;
  }
  // v153/v107 pattern: same notification kind + both-channels send the
  // Ticket-accept flow already uses for "this needs a client Yes/No".
  notifyClientsForFormId(lead.submission_form_id, 'ticket_received', leadsFormNameFn ? leadsFormNameFn(lead.submission_form_id) : null);
  await loadLeads();
  await refreshDetailIfViewing(lead.user_id);
  logActivity('lead.sent_as_ticket', 'lead', lead.id, `Sent as ticket for client Yes/No — ${lead.count} lead(s)`);
  closeLeadsQueueReviewModal();
}
guardedClick('leadsQueueReviewSendTicketBtn', async () => {
  const lead = leadsQueueReviewModalLead;
  if(!lead) return;
  const wrap = $('leadsQueueReviewTicketNotesWrap');
  const btn = $('leadsQueueReviewSendTicketBtn');
  const msgEl = $('leadsQueueReviewModalMsg');
  if(wrap.style.display === 'none'){
    wrap.style.display = '';
    btn.textContent = 'Confirm Send as Ticket';
    $('leadsQueueReviewTicketNotes').focus();
    return;
  }
  const notes = $('leadsQueueReviewTicketNotes').value.trim();
  if(!notes){
    msgEl.textContent = 'Ticket Notes is required to send this as a ticket.';
    msgEl.style.display = '';
    return;
  }
  msgEl.style.display = 'none';
  await sendLeadAsTicket(lead, notes);
});

// ===========================================================================
// v250: Call Back — Leads Queue Review / PrimeHome Buyers Queue Review can
// return a lead here instead of Accept/Reject, flagging which fields need
// re-confirming and why. Any agent with the Leads tab can claim one
// (exclusive — first to claim owns it, enforced by the conditional update in
// claimCallBackLead() plus the DB's own with_check) and confirm just the
// flagged fields, which sends it back to Pending for a normal review pass.
// Reuses the same {key,label,value} shape leadsExtraFieldsEntriesFn already
// produces for every OTHER lead field display, plus the two reserved
// columns (Seller Name/Phone) it doesn't cover, so the field list here is
// exactly what Queue Review's own Review popup already treats as "this
// lead's fields".
// ===========================================================================
function callBackFieldOptions(lead){
  const options = [
    { key: 'seller_investor_name', label: 'Seller / Investor Name', value: lead.seller_investor_name || '' },
    { key: 'seller_phone', label: 'Phone', value: lead.seller_phone || '' },
  ];
  leadsExtraFieldsEntriesFn(lead.task_id, lead.submission_form_id, lead.extra_fields)
    .filter(e => !RESERVED_FIELD_KEYS.has(e.key))
    .forEach(e => options.push({ key: e.key, label: e.label, value: e.value }));
  return options;
}

let sendToCallBackLead = null;
function openSendToCallBackModal(lead, agentLabel){
  sendToCallBackLead = lead;
  $('sendToCallBackLeadId').value = lead.id;
  $('sendToCallBackLeadLabel').textContent = `Agent: ${agentLabel} — ${lead.count} lead(s) — ${lead.seller_investor_name || 'no name yet'}`;
  $('sendToCallBackReason').value = '';
  const options = callBackFieldOptions(lead);
  $('sendToCallBackFields').innerHTML = options.map(o => `
    <label style="display:flex; align-items:center; gap:8px; font-size:13px; font-weight:400; text-transform:none; cursor:pointer;">
      <input type="checkbox" class="callback-field-cb" value="${escapeHtml(o.key)}" style="width:15px; height:15px; accent-color:var(--focus);">
      ${escapeHtml(o.label)} <span style="color:var(--text-dim); font-size:11px;">${o.value ? '— currently: ' + escapeHtml(String(o.value).slice(0, 40)) : '(blank)'}</span>
    </label>
  `).join('');
  $('sendToCallBackMsg').style.display = 'none';
  $('sendToCallBackModalOverlay').classList.add('active');
}
function closeSendToCallBackModal(){
  $('sendToCallBackModalOverlay').classList.remove('active');
  sendToCallBackLead = null;
}
$('sendToCallBackCancelBtn').addEventListener('click', closeSendToCallBackModal);
$('sendToCallBackModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'sendToCallBackModalOverlay') closeSendToCallBackModal(); });

guardedClick('sendToCallBackSubmitBtn', async () => {
  const lead = sendToCallBackLead;
  if(!lead) return;
  const msg = $('sendToCallBackMsg');
  const reason = $('sendToCallBackReason').value.trim();
  const fields = Array.from(document.querySelectorAll('.callback-field-cb:checked')).map(cb => cb.value);
  if(!reason){ msg.textContent = 'A reason is required.'; msg.style.display = ''; return; }
  if(!fields.length){ msg.textContent = 'Check at least one field that needs confirming.'; msg.style.display = ''; return; }
  msg.style.display = 'none';
  const { data: { user } } = await sb.auth.getUser();
  const { error } = await sb.from('leads').update({
    status: 'call_back',
    callback_reason: reason,
    callback_fields_to_confirm: fields,
    callback_claimed_by: null,
    callback_claimed_at: null,
    reviewed_by: user ? user.id : null,
    reviewed_at: new Date().toISOString(),
  }).eq('id', lead.id);
  if(error){ msg.textContent = error.message; msg.style.display = ''; return; }
  await loadLeads();
  logActivity('lead.call_back', 'lead', lead.id, `Sent to Call Back — ${lead.count} lead(s) — reason: ${reason} — fields to confirm: ${fields.join(', ')}`);
  closeSendToCallBackModal();
});

// ---------- Call Back subtab: available-to-claim + my-claimed lists ----------
let leadsCallBackRows = [];
async function loadCallBackQueue(){
  const { data, error } = await sb.from('leads')
    .select('id, user_id, task_id, submission_form_id, count, submitted_at, seller_investor_name, seller_phone, extra_fields, callback_reason, callback_fields_to_confirm, callback_claimed_by, callback_claimed_at')
    .eq('status', 'call_back')
    .order('submitted_at', { ascending: false });
  if(error){ console.error('Failed to load Call Back queue', error); return; }
  leadsCallBackRows = data || [];
  if(callBackIsManager() && !callBackAssignees) await loadCallBackAssignees();   // v724
  renderCallBackTables();
}
// v724 (the owner: "in My claimed call backs, admin/owner/team leader can see
// who claimed the call back and pull it and assign it to another"). The
// "Claimed by the team" card, plus an Assign-to on Available rows, for these
// three roles only -- leads_callback_assign() refuses anyone else anyway.
function callBackIsManager(){
  return myIsOwner || myRole === 'admin'
    || String(myRole || '').toLowerCase().replace(/[\s_-]+/g, ' ').trim() === 'team leader';
}
let callBackAssignees = null;   // [{ id, full_name, role }] from leads_callback_assignees()
async function loadCallBackAssignees(){
  const { data, error } = await sb.rpc('leads_callback_assignees');
  if(error){ console.warn('call back assignees:', error.message); callBackAssignees = []; return; }
  callBackAssignees = data || [];
}
function callBackPersonName(id){
  if(!id) return '—';
  if(id === myUserId) return 'You';
  const a = (callBackAssignees || []).find(x => x.id === id);
  if(a) return a.full_name;
  const n = leadsAgentNameFn(id);
  return n && n !== '—' ? n : 'Someone no longer on the list';
}
function callBackAssignSelectHtml(leadId, currentId){
  const opts = (callBackAssignees || []).filter(a => a.id !== currentId)
    .map(a => `<option value="${a.id}">${escapeHtml(a.full_name + (a.id === myUserId ? ' (you)' : ''))}</option>`).join('');
  return `<select class="callback-assign-sel" data-id="${r_esc(leadId)}" style="width:auto; min-width:150px; padding:5px 8px; font-size:11px;"><option value="">${currentId ? 'Reassign to…' : 'Assign to…'}</option>${opts}</select>`;
}
function r_esc(v){ return escapeHtml(String(v || '')); }
async function assignCallBackLead(leadId, toId){
  const lead = leadsCallBackRows.find(r => r.id === leadId);
  const label = (lead && lead.seller_investor_name) || 'this lead';
  const who = toId ? callBackPersonName(toId) : '';
  const ok = confirm(toId
    ? `Give the call back for ${label} to ${who}?`
    : `Pull the call back for ${label} back to "Available to claim"?`);
  if(!ok){ renderCallBackTables(); return; }
  const { data, error } = await sb.rpc('leads_callback_assign', { p_lead: leadId, p_to: toId || null });
  if(error){ alert(error.message); await loadCallBackQueue(); return; }
  const from = data && data.from ? callBackPersonName(data.from) : 'nobody';
  logActivity(toId ? 'lead.call_back_assign' : 'lead.call_back_pull', 'lead', leadId,
    toId ? `Call back for ${label} reassigned from ${from} to ${who}` : `Call back for ${label} pulled back from ${from}`);
  await loadCallBackQueue();
}
// Someone else's claim, pull or confirm lands here within a couple of
// seconds while the Call Back sub-tab is open (fed by the v723
// pending-counts channel's leads binding).
let callBackLiveTimer = null;
function callBackLiveSoon(){
  clearTimeout(callBackLiveTimer);
  callBackLiveTimer = setTimeout(() => {
    const panel = $('tab-leads');
    if(!document.hidden && panel && panel.classList.contains('active') && leadsActiveSection === 'call_back') loadCallBackQueue();
  }, 1500);
}
function callBackFieldsSummary(lead){
  const byKey = {};
  callBackFieldOptions(lead).forEach(o => { byKey[o.key] = o.label; });
  return (lead.callback_fields_to_confirm || []).map(k => byKey[k] || k).join(', ') || '—';
}
// v361: bulk delete, one independent selection Set per table (Available to
// claim / My claimed) — same Owner/Admin convention as every other lead
// delete button in this app (canDeleteLead below), not the per-role Edit
// checkbox system, so the checkbox column + toolbar are hidden entirely
// for anyone else rather than just disabled. Selections persist across a
// refresh only for rows still present (pruned in renderCallBackTables).
let callBackAvailSelectedIds = new Set();
let callBackMineSelectedIds = new Set();
function updateCallBackBulkToolbar(scope){
  const canDelete = myIsOwner || myRole === 'admin';
  const ids = scope === 'avail' ? callBackAvailSelectedIds : callBackMineSelectedIds;
  const toolbar = $(scope === 'avail' ? 'callBackAvailBulkToolbar' : 'callBackMineBulkToolbar');
  const selectAllTh = $(scope === 'avail' ? 'callBackAvailSelectAllTh' : 'callBackMineSelectAllTh');
  const countEl = $(scope === 'avail' ? 'callBackAvailBulkSelectedCount' : 'callBackMineBulkSelectedCount');
  const deleteBtn = $(scope === 'avail' ? 'callBackAvailBulkDeleteBtn' : 'callBackMineBulkDeleteBtn');
  toolbar.style.display = canDelete ? 'flex' : 'none';
  selectAllTh.style.display = canDelete ? '' : 'none';
  if(!canDelete) return;
  const n = ids.size;
  countEl.textContent = n === 1 ? '1 selected' : `${n} selected`;
  deleteBtn.disabled = n === 0;
}
async function bulkDeleteCallBackLeads(scope){
  const canDelete = myIsOwner || myRole === 'admin';
  if(!canDelete) return;
  const ids = Array.from(scope === 'avail' ? callBackAvailSelectedIds : callBackMineSelectedIds);
  if(!ids.length) return;
  if(!confirm(`Permanently delete these ${ids.length} lead(s)? This can't be undone.`)) return;
  const { error } = await sb.from('leads').delete().in('id', ids);
  if(error){ alert(error.message); return; }
  logActivity('lead.delete', 'lead', null, `Bulk deleted ${ids.length} lead(s) from Call Back — ${scope === 'avail' ? 'Available to claim' : 'My claimed call backs'}`);
  (scope === 'avail' ? callBackAvailSelectedIds : callBackMineSelectedIds).clear();
  await loadCallBackQueue();
}
function renderCallBackTables(){
  const agentName = leadsAgentNameFn, formName = leadsFormNameFn;
  const canDeleteLead = myIsOwner || myRole === 'admin';
  const available = leadsCallBackRows.filter(r => !r.callback_claimed_by);
  const mine = leadsCallBackRows.filter(r => r.callback_claimed_by === myUserId);

  const availIds = new Set(available.map(r => r.id));
  Array.from(callBackAvailSelectedIds).forEach(id => { if(!availIds.has(id)) callBackAvailSelectedIds.delete(id); });
  const mineIds = new Set(mine.map(r => r.id));
  Array.from(callBackMineSelectedIds).forEach(id => { if(!mineIds.has(id)) callBackMineSelectedIds.delete(id); });

  const availBody = $('callBackAvailableBody');
  $('callBackAvailableEmpty').style.display = available.length ? 'none' : 'block';
  availBody.innerHTML = available.map(r => `
    <tr>
      ${canDeleteLead ? `<td><input type="checkbox" class="callback-avail-select-cb" data-id="${r.id}" ${callBackAvailSelectedIds.has(r.id) ? 'checked' : ''}></td>` : ''}
      <td>${escapeHtml(r.seller_investor_name || '—')}</td>
      <td class="mono">${escapeHtml(r.seller_phone || '—')}</td>
      <td>${escapeHtml(formName(r.submission_form_id))}</td>
      <td>${textPreviewCellHtml(r.callback_reason, 'Call back reason')}</td>
      <td style="max-width:200px;">${escapeHtml(callBackFieldsSummary(r))}</td>
      <td style="color:var(--text-2);">${new Date(r.submitted_at).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(leadsTzFor(r.user_id) ? { timeZone: leadsTzFor(r.user_id) } : {}) })}</td>
      <td style="white-space:nowrap;"><button class="btn-secondary callback-claim-btn" data-id="${r.id}" style="width:auto; padding:5px 10px; font-size:11px;">Pick up</button>${callBackIsManager() ? ' ' + callBackAssignSelectHtml(r.id, null) : ''}</td>
    </tr>
  `).join('');
  availBody.querySelectorAll('.callback-claim-btn').forEach(btn => {
    btn.addEventListener('click', () => claimCallBackLead(btn.dataset.id));
  });
  availBody.querySelectorAll('.callback-avail-select-cb').forEach(cb => {
    cb.addEventListener('change', () => {
      if(cb.checked) callBackAvailSelectedIds.add(cb.dataset.id); else callBackAvailSelectedIds.delete(cb.dataset.id);
      updateCallBackBulkToolbar('avail');
    });
  });
  updateCallBackBulkToolbar('avail');

  const mineBody = $('callBackMineBody');
  $('callBackMineEmpty').style.display = mine.length ? 'none' : 'block';
  mineBody.innerHTML = mine.map(r => `
    <tr>
      ${canDeleteLead ? `<td><input type="checkbox" class="callback-mine-select-cb" data-id="${r.id}" ${callBackMineSelectedIds.has(r.id) ? 'checked' : ''}></td>` : ''}
      <td>${escapeHtml(r.seller_investor_name || '—')}</td>
      <td class="mono">${escapeHtml(r.seller_phone || '—')}</td>
      <td>${escapeHtml(formName(r.submission_form_id))}</td>
      <td>${textPreviewCellHtml(r.callback_reason, 'Call back reason')}</td>
      <td style="max-width:200px;">${escapeHtml(callBackFieldsSummary(r))}</td>
      <td style="color:var(--text-2);">${r.callback_claimed_at ? new Date(r.callback_claimed_at).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(leadsTzFor(r.user_id) ? { timeZone: leadsTzFor(r.user_id) } : {}) }) : '—'}</td>
      <td><button class="btn-primary callback-confirm-btn" data-id="${r.id}" style="width:auto; padding:5px 10px; font-size:11px; margin-top:0;">Confirm details</button></td>
    </tr>
  `).join('');
  mineBody.querySelectorAll('.callback-confirm-btn').forEach(btn => {
    btn.addEventListener('click', () => openCallBackConfirmModal(btn.dataset.id));
  });
  mineBody.querySelectorAll('.callback-mine-select-cb').forEach(cb => {
    cb.addEventListener('change', () => {
      if(cb.checked) callBackMineSelectedIds.add(cb.dataset.id); else callBackMineSelectedIds.delete(cb.dataset.id);
      updateCallBackBulkToolbar('mine');
    });
  });
  updateCallBackBulkToolbar('mine');

  // v724: Claimed by the team -- see callBackIsManager().
  const teamCard = $('callBackTeamCard');
  const manager = callBackIsManager();
  if(teamCard) teamCard.style.display = manager ? '' : 'none';
  if(teamCard && !manager) $('callBackTeamBody').innerHTML = '';
  if(teamCard && manager){
    const claimed = leadsCallBackRows.filter(r => r.callback_claimed_by)
      .sort((a, b) => String(b.callback_claimed_at || '').localeCompare(String(a.callback_claimed_at || '')));
    $('callBackTeamEmpty').style.display = claimed.length ? 'none' : 'block';
    $('callBackTeamBody').innerHTML = claimed.map(r => `
      <tr>
        <td>${escapeHtml(r.seller_investor_name || '—')}</td>
        <td class="mono">${escapeHtml(r.seller_phone || '—')}</td>
        <td>${escapeHtml(formName(r.submission_form_id))}</td>
        <td>${textPreviewCellHtml(r.callback_reason, 'Call back reason')}</td>
        <td style="font-weight:600;">${escapeHtml(callBackPersonName(r.callback_claimed_by))}</td>
        <td style="color:var(--text-2);">${r.callback_claimed_at ? new Date(r.callback_claimed_at).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(leadsTzFor(r.user_id) ? { timeZone: leadsTzFor(r.user_id) } : {}) }) : '—'}</td>
        <td>${callBackAssignSelectHtml(r.id, r.callback_claimed_by)}</td>
        <td><button class="btn-secondary callback-pull-btn" data-id="${r.id}" style="width:auto; padding:5px 10px; font-size:11px;">Pull back</button></td>
      </tr>
    `).join('');
    $('callBackTeamBody').querySelectorAll('.callback-pull-btn').forEach(btn => {
      btn.addEventListener('click', () => assignCallBackLead(btn.dataset.id, null));
    });
  }
  if(manager){
    document.querySelectorAll('#leadsSection-call_back .callback-assign-sel').forEach(sel => {
      sel.addEventListener('change', () => { if(sel.value) assignCallBackLead(sel.dataset.id, sel.value); });
    });
  }
}
$('callBackRefreshBtn').addEventListener('click', loadCallBackQueue);
$('callBackAvailSelectAllCb').addEventListener('change', (e) => {
  document.querySelectorAll('.callback-avail-select-cb').forEach(cb => {
    cb.checked = e.target.checked;
    if(e.target.checked) callBackAvailSelectedIds.add(cb.dataset.id); else callBackAvailSelectedIds.delete(cb.dataset.id);
  });
  updateCallBackBulkToolbar('avail');
});
$('callBackMineSelectAllCb').addEventListener('change', (e) => {
  document.querySelectorAll('.callback-mine-select-cb').forEach(cb => {
    cb.checked = e.target.checked;
    if(e.target.checked) callBackMineSelectedIds.add(cb.dataset.id); else callBackMineSelectedIds.delete(cb.dataset.id);
  });
