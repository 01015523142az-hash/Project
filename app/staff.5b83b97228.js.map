// v226: "New client chat" — lets Owner/Admin (myPermissions.canTextClients)
// proactively start a conversation with a client who's never messaged in,
// rather than only being able to reply into a thread the CLIENT already
// created via their portal. Every active client is listed; one who
// already has a thread (in clientChatThreadsDirectory) just opens that
// thread — clicking here never creates a second, duplicate one for the
// same client.
let chatNewClientChatDirectory = []; // [{id, full_name, company_name}]
function chatRenderNewClientChatPicker(){
  const search = ($('chatNewClientChatSearch').value || '').trim().toLowerCase();
  const list = chatNewClientChatDirectory.filter(c => {
    if(!search) return true;
    return (c.full_name || '').toLowerCase().includes(search) || (c.company_name || '').toLowerCase().includes(search);
  });
  $('chatNewClientChatPicker').innerHTML = list.map(c => `
    <div class="chat-conv-item" data-client-id="${c.id}" style="cursor:pointer;">
      ${chatAvatarHtml(c.id, c.full_name || c.company_name || 'Client', 32, false)}
      <div class="chat-conv-item-text">
        <div class="chat-conv-item-name">${escapeHtml(c.full_name || 'Client')}</div>
        <div class="chat-conv-item-preview">${escapeHtml(c.company_name || c.email || '')}</div>
      </div>
    </div>
  `).join('') || '<div class="empty" style="padding:8px;">No clients match.</div>';
  $('chatNewClientChatPicker').querySelectorAll('[data-client-id]').forEach(row => {
    row.addEventListener('click', () => chatStartOrOpenClientChat(row.dataset.clientId));
  });
}
async function chatStartOrOpenClientChat(clientId){
  const msg = $('chatNewClientChatMsg');
  msg.textContent = '';
  // Already has a thread — just open it, don't create a duplicate.
  if(clientChatThreadsDirectory.some(t => t.client_id === clientId)){
    $('chatNewClientChatView').style.display = 'none';
    openChatThread('client:' + clientId);
    return;
  }
  const { error } = await sb.from('client_chat_threads')
    .insert({ client_id: clientId, status: 'routed', assigned_staff_id: myUserId, queue_key: null });
  if(error){
    msg.textContent = error.message;
    msg.className = 'msg error';
    return;
  }
  await loadClientChatOverview(); // refreshes clientChatThreadsDirectory + seeds an empty chatConversations entry
  $('chatNewClientChatView').style.display = 'none';
  openChatThread('client:' + clientId);
}
