// ---------- v107: Tickets Review ----------
// Shows every lead with a non-null ticket_stage (see leads.ticket_stage /
// supabase/v107-ticket-workflow.sql), across all 3 stages, off the same
// already-fetched leadsFullData every other Leads subtab uses.
const TICKET_STAGE_META = {
  staff_review: { label: 'Awaiting staff review', color: 'var(--away)' },
  client_review: { label: 'Awaiting client (Yes/No)', color: 'var(--focus)' },
  recording_pending: { label: 'Client said Yes — back in Queue Review', color: 'var(--good)' },
  // v217: was ticket_stage = null (indistinguishable from any other
  // rejected lead) — now a distinct, visible stage; see "Redirect" below.
  client_rejected: { label: 'Client rejected — pick a new campaign?', color: 'var(--danger)' },
};
function renderTicketsReviewTable(){
  const filtered = leadsFullData.filter(r => {
    if(!r.ticket_stage) return false;
    if(leadsTicketsFilters.stage && r.ticket_stage !== leadsTicketsFilters.stage) return false;
    if(!leadsRowMatchesFilters(r, leadsTicketsFilters)) return false;
    return true;
  });
  const agentName = leadsAgentNameFn;
  const body = $('leadsTicketsBody');
  if(!body) return;

  if($('leadsTicketsStatTotal')){
    $('leadsTicketsStatTotal').textContent = filtered.length;
    $('leadsTicketsStatStaffReview').textContent = filtered.filter(r => r.ticket_stage === 'staff_review').length;
    $('leadsTicketsStatClientReview').textContent = filtered.filter(r => r.ticket_stage === 'client_review').length;
    $('leadsTicketsStatRecordingPending').textContent = filtered.filter(r => r.ticket_stage === 'recording_pending').length;
    $('leadsTicketsStatRejected').textContent = filtered.filter(r => r.status === 'rejected').length;
  }

  body.innerHTML = '';
  if(!filtered.length){
    body.innerHTML = `<tr><td colspan="8" class="empty">${leadsFullData.some(r => r.ticket_stage) ? 'No tickets match these filters.' : 'No tickets submitted in this range yet.'}</td></tr>`;
    leadsPageRows('tickets', [], leadsTicketsFilters, 'leadsTicketsPager');
    applyLeadsSectionEditGating('tickets_review');
    return;
  }
  leadsPageRows('tickets', filtered, leadsTicketsFilters, 'leadsTicketsPager').forEach(r => {   // v806: 50 per page
    const submittedLabel = new Date(r.submitted_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(leadsTzFor(r.user_id) ? { timeZone: leadsTzFor(r.user_id) } : {}) });
    const meta = LEAD_STATUS_META[r.status] || LEAD_STATUS_META.pending;
    const stageMeta = TICKET_STAGE_META[r.ticket_stage] || { label: r.ticket_stage, color: 'var(--text-dim)' };
    // BUG FIX (user report, 2026-09-11, with screenshot: this column read "—"
    // on 3 of the 4 tickets on screen, and the one row that DID show a name
    // showed the wrong one). Two separate faults:
    //  1. It read the LITERAL extra_fields key 'campaign_name'. That key only
    //     exists when the agent's form happened to ask a question keyed
    //     exactly that, so every other ticket rendered "—" despite being
    //     attached to a perfectly real campaign via submission_form_id.
    //     Live-confirmed: 3 of the 4 tickets on screen were all attached to
    //     "Mississippi Trial Number 1" and every one of them showed "—".
    //  2. It never consulted submission_form_id at all -- which is the LIVE
    //     campaign assignment, the thing openTicketAcceptModal()'s confirm
    //     handler rewrites when a ticket is accepted into, or redirected to,
    //     a different campaign. So after a redirect this column kept showing
    //     the agent's original free-text answer forever. Live-confirmed:
    //     Wendy Carter's ticket had already been moved to "PrimeHome Buyers"
    //     but still displayed the submitted text "Mississippi Trial Number 1".
    // Now shows the CURRENT campaign -- what the ticket is actually attached
    // to right now -- and keeps the agent's original answer beneath it only
    // when the two differ, so a redirect reads as a visible change instead of
    // silently overwriting history. The generic seeded "Ticket" form is not a
    // campaign, so it never counts as one here (the same leadsTicketFormId
    // exclusion openTicketAcceptModal already applies to its campaign list).
    const currentFormName = (r.submission_form_id && r.submission_form_id !== leadsTicketFormId)
      ? leadsFormNameFn(r.submission_form_id)
      : '';
    const currentCampaign = (currentFormName && currentFormName !== 'No campaign') ? currentFormName : '';
    // The agent's own free-text answer, matched by LABEL rather than by raw
    // key -- same reasoning as openTicketAcceptModal()'s v113 comment: these
    // are ordinary editable Submission Forms Creator fields, so an admin
    // renaming the key must not silently blank this column. Falls back to the
    // legacy literal key for leads whose form definition is long gone.
    const campaignEntries = leadsExtraFieldsEntriesFn(r.task_id, r.submission_form_id, r.extra_fields) || [];
    const labelledCampaign = campaignEntries.find(e => csubNormalizeLabel(e.label) === csubNormalizeLabel('Campaign Name'));
    const submittedCampaignName = String((labelledCampaign && labelledCampaign.value) || (r.extra_fields && r.extra_fields.campaign_name) || '').trim();
    const campaignCell = currentCampaign
      ? escapeHtml(currentCampaign) + (submittedCampaignName && csubNormalizeLabel(submittedCampaignName) !== csubNormalizeLabel(currentCampaign)
          ? `<div style="font-size:10px; color:var(--text-dim); margin-top:2px;">submitted as: ${escapeHtml(submittedCampaignName)}</div>`
          : '')
      : (submittedCampaignName ? escapeHtml(submittedCampaignName) : '—');
    // v140: self-accept restriction removed — see the matching comment in
    // the general Queue Review table above.
    const canEditThisLead = true;
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${escapeHtml(agentName(r.user_id))}</td>
      <td class="mono">${submittedLabel}</td>
      <td>${escapeHtml(r.seller_investor_name || '—')}</td>
      <td class="mono">${escapeHtml(r.seller_phone || '—')}</td>
      <td>${campaignCell}</td>
      <td><span style="color:${stageMeta.color};">${escapeHtml(stageMeta.label)}</span></td>
      <td><span class="dot ${meta.dot}"></span><span class="${meta.text}">${meta.label}</span></td>
      <td>
        ${r.ticket_stage === 'staff_review' && canEditThisLead ? `
          <button class="ticket-accept-btn edit-only" style="background:transparent; border:1px solid var(--good); border-radius:6px; color:var(--good); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px; white-space:nowrap; margin-right:4px;">Accept</button>
          <button class="ticket-reject-btn edit-only" style="background:transparent; border:1px solid var(--border-light); border-radius:6px; color:var(--danger); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px; white-space:nowrap;">Reject</button>
        ` : ''}
        ${
          // v158: undo an "Awaiting client (Yes/No)" push made by mistake —
          // moves the ticket back to ticket_stage = 'staff_review'
          // ("Awaiting staff review"), i.e. right back to where it sat
          // before the Ticket Accept modal was ever used — NOT into the
          // ordinary Leads Queue Review table (that was v152's original
          // behavior; changed in v158 per feedback that a recalled ticket
          // belongs back in its own designated queue, still tagged as a
          // ticket, not dropped into the general lead pipeline under
          // whatever campaign it happened to be pre-assigned to). Gated
          // the same way Accept/Reject already are here — canEditThisLead
          // plus the .edit-only class — so any Owner/Admin, or a custom
          // role granted Edit on Tickets Review, can use it.
          r.ticket_stage === 'client_review' && canEditThisLead ? `
          <button class="ticket-recall-btn edit-only" style="background:transparent; border:1px solid var(--away); border-radius:6px; color:var(--away); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px; white-space:nowrap;">Recall to Queue</button>
        ` : ''}
        ${
          // v217: a client's "No" no longer dead-ends the ticket — reuses
          // the same Accept-Ticket modal (pick a campaign, confirm/edit
          // details, send to that campaign's client) that a fresh
          // 'staff_review' ticket uses, just triggered from
          // 'client_rejected' instead. See openTicketAcceptModal()'s
          // confirm handler for the status='pending' reset this needs.
          r.ticket_stage === 'client_rejected' && canEditThisLead ? `
          <button class="ticket-redirect-btn edit-only" style="background:transparent; border:1px solid var(--focus); border-radius:6px; color:var(--focus); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px; white-space:nowrap;">Redirect to another campaign</button>
        ` : ''}
        ${(r.ticket_stage !== 'staff_review' && r.ticket_stage !== 'client_review' && r.ticket_stage !== 'client_rejected') || !canEditThisLead ? '<span style="color:var(--text-dim); font-size:11px;">—</span>' : ''}
      </td>
    `;
    const acceptBtn = tr.querySelector('.ticket-accept-btn');
    const rejectBtn = tr.querySelector('.ticket-reject-btn');
    const recallBtn = tr.querySelector('.ticket-recall-btn');
    const redirectBtn = tr.querySelector('.ticket-redirect-btn');
    if(acceptBtn) acceptBtn.addEventListener('click', () => openTicketAcceptModal(r));
    if(rejectBtn) guardedClick(rejectBtn, () => setLeadStatus(r, 'rejected', agentName(r.user_id), { ticket_stage: null }));
    if(recallBtn) recallBtn.addEventListener('click', () => recallTicketToQueue(r, agentName(r.user_id)));
    if(redirectBtn) redirectBtn.addEventListener('click', () => openTicketAcceptModal(r));
    body.appendChild(tr);
  });
  applyLeadsSectionEditGating('tickets_review');
}

// v158 (was v152 — see the button's own comment above for why this
// changed): "Recall to Queue" pulls a ticket back out of "Awaiting client
// (Yes/No)" and back to ticket_stage = 'staff_review' — its own
// designated queue (Tickets Review's "Awaiting staff review"), the same
// spot it sat in before Accept was ever clicked — rather than the
// ordinary Leads Queue Review table. status/seller/phone/extra_fields/
// submission_form_id are all left exactly as they were; only which stage
// of the ticket flow it's in changes.
async function recallTicketToQueue(lead, agentLabel){
  if(!confirm(`Recall this ticket back to "Awaiting staff review"?\n\nIt will stop being visible to the client immediately.\n\nAgent: ${agentLabel} — ${lead.count} lead(s)`)) return;
  const { error } = await sb.from('leads').update({ ticket_stage: 'staff_review' }).eq('id', lead.id);
  if(error){ alert(error.message); return; }
  await loadLeads();
  await refreshDetailIfViewing(lead.user_id);
  logActivity('lead.ticket_recall', 'lead', lead.id, `Recalled a ticket from "Awaiting client (Yes/No)" back to "Awaiting staff review" — ${agentLabel} — ${lead.count} lead(s)`);
}
$('leadsTicketsUserFilter').addEventListener('change', () => { leadsTicketsFilters.user = $('leadsTicketsUserFilter').value; renderTicketsReviewTable(); });
$('leadsTicketsDateFromFilter').addEventListener('change', () => { leadsTicketsFilters.dateFrom = $('leadsTicketsDateFromFilter').value; loadLeads(); });
$('leadsTicketsDateToFilter').addEventListener('change', () => { leadsTicketsFilters.dateTo = $('leadsTicketsDateToFilter').value; loadLeads(); });
$('leadsTicketsSellerFilter').addEventListener('input', debounce(() => { leadsTicketsFilters.seller = $('leadsTicketsSellerFilter').value.trim(); renderTicketsReviewTable(); }, 200));
$('leadsTicketsPhoneFilter').addEventListener('input', debounce(() => { leadsTicketsFilters.phone = $('leadsTicketsPhoneFilter').value.trim(); renderTicketsReviewTable(); }, 200));
$('leadsTicketsStageFilter').addEventListener('change', () => { leadsTicketsFilters.stage = $('leadsTicketsStageFilter').value; renderTicketsReviewTable(); });

// ---------------------------------------------------------------------------
// v113: All Queue — every lead (Leads Queue Review / PrimeHome Buyers /
// Tickets, off the already-fetched leadsFullData) AND every raw Client
// Submission (ghl_form_submissions — Client Qualification Form / Data
// Form) in one combined, filterable, deletable list. Mainly a housekeeping
// tool for an Owner/Admin to clean up test/duplicate/stray records without
// having to hunt through each individual subtab.
// ---------------------------------------------------------------------------
let allQueueSubmissions = [];
let allQueueDisputes = [];
let allQueueFilters = { dateFrom: '', dateTo: '', queue: '', search: '', user: '', status: '' };
let allQueueLoaded = false;
let allQueueExpandedKey = null; // `${source}-${id}` of the row currently showing full details

function allQueueClassifyLead(r){
  if(r.ticket_stage) return 'tickets';
  if(isPrimeHomeBuyersLead(r)) return 'primehome';
  // v713: a Sales rep's converted opportunity never enters Leads Queue
  // Review (see isSalesConversionLead), so it is not labelled as if it had.
  if(isSalesConversionLead(r)) return 'sales';
  return 'queue_review';
}

async function loadAllQueue(){
  const body = $('allQueueBody');
  if(body && !allQueueLoaded) body.innerHTML = '<tr><td colspan="8" class="empty">Loading…</td></tr>';
  const [{ data: submissions, error: subErr }, { data: disputes, error: dispErr }] = await Promise.all([
    sb.from('ghl_form_submissions')
      .select('id, form_name, contact_name, contact_phone, contact_email, submitted_at, fields')
      .order('submitted_at', { ascending: false })
      .limit(1000),
    // v115: Dispute/Feedback threads now have their own row in All Queue —
    // "full vision" here means the same lead/client context Dispute/
    // Feedback's own subtab shows, not just this table's summary columns.
    sb.from('lead_disputes')
      .select('id, lead_id, type, status, disputed_fields, created_at, leads(seller_investor_name, seller_phone, submission_form_id), client_accounts(full_name, company_name)')
      .order('created_at', { ascending: false })
      .limit(1000),
  ]);
  if(subErr) console.error('Failed to load Client Submissions for All Queue', subErr);
  if(dispErr) console.error('Failed to load Dispute/Feedback for All Queue', dispErr);
  allQueueSubmissions = submissions || [];
  allQueueDisputes = disputes || [];
  allQueueLoaded = true;
  renderAllQueueTable();
}

function renderAllQueueTable(){
  const body = $('allQueueBody');
  const emptyEl = $('allQueueEmpty');
  if(!body) return;

  const QUEUE_META = {
    queue_review: { label: 'Leads Queue Review', color: 'var(--text)' },
    primehome: { label: 'PrimeHome Buyers', color: 'var(--focus)' },
    sales: { label: 'Sales (converted opportunity)', color: 'var(--good)' },   // v713
    tickets: { label: 'Tickets Review', color: 'var(--away)' },
    dispute_feedback: { label: 'Dispute/Feedback', color: 'var(--danger)' },
    client_submission: { label: 'Client Submission', color: 'var(--text-dim)' },
  };

  let rows = (leadsFullData || []).map(r => ({
    source: 'lead',
    id: r.id,
    queue: allQueueClassifyLead(r),
    name: r.seller_investor_name || '—',
    phone: r.seller_phone || '—',
    campaignOrForm: leadsFormNameFn ? leadsFormNameFn(r.submission_form_id) : '—',
    submittedAt: r.submitted_at,
    status: r.status,
    userId: r.user_id || '',
    details: leadsExtraFieldsLabelFn ? leadsExtraFieldsLabelFn(r.task_id, r.submission_form_id, r.extra_fields) : '',
  }));
  rows = rows.concat(allQueueSubmissions.map(s => ({
    source: 'submission',
    id: s.id,
    queue: 'client_submission',
    name: s.contact_name || s.contact_email || '—',
    phone: s.contact_phone || '—',
    campaignOrForm: s.form_name || '(untitled form)',
    submittedAt: s.submitted_at,
    status: null,
    details: Object.entries(s.fields || {}).filter(([, v]) => v !== '' && v != null).map(([k, v]) => `${k}: ${Array.isArray(v) ? v.join(', ') : v}`).join('\n'),
  })));
  rows = rows.concat(allQueueDisputes.map(d => {
    const lead = d.leads || {};
    const client = d.client_accounts || {};
    const isFeedback = d.type === 'feedback';
    return {
      source: 'dispute',
      id: d.id,
      queue: 'dispute_feedback',
      name: lead.seller_investor_name || '—',
      phone: lead.seller_phone || '—',
      campaignOrForm: leadsFormNameFn ? leadsFormNameFn(lead.submission_form_id) : '—',
      submittedAt: d.created_at,
      status: `${isFeedback ? 'Feedback' : 'Dispute'} — ${d.status}`,
      details: `Client: ${client.company_name || client.full_name || '—'}` +
        (isFeedback ? '' : `\nReason: ${(d.disputed_fields || []).map(f => f.label || f.key).join(', ')}`),
    };
  }));

  const search = allQueueFilters.search.trim().toLowerCase();
  const filtered = rows.filter(r => {
    if(allQueueFilters.queue && r.queue !== allQueueFilters.queue) return false;
    if(allQueueFilters.user && r.userId !== allQueueFilters.user) return false;
    if(allQueueFilters.status && r.status !== allQueueFilters.status) return false;
    // v192: same timezone-sync fix as leadsRowMatchesFilters() above — was
    // comparing calendar days in the browser's local timezone instead of
    // globalDisplayTzMode, so All Queue's date filter could disagree with
    // every other Leads subtab's filter about which day a late-night lead
    // fell on.
    if(allQueueFilters.dateFrom || allQueueFilters.dateTo){
      if(!r.submittedAt) return false;
      const submittedMs = new Date(r.submittedAt).getTime();
      if(allQueueFilters.dateFrom){
        const [fy, fm, fd] = allQueueFilters.dateFrom.split('-').map(Number);
        const { startMs } = dayBoundsMsInZone(globalDisplayTzMode, null, fy, fm, fd);
        if(submittedMs < startMs) return false;
      }
      if(allQueueFilters.dateTo){
        const [ty, tm, td] = allQueueFilters.dateTo.split('-').map(Number);
        const { endMs } = dayBoundsMsInZone(globalDisplayTzMode, null, ty, tm, td);
        if(submittedMs > endMs) return false;
      }
    }
    if(search){
      const hay = `${r.name} ${r.phone} ${r.campaignOrForm}`.toLowerCase();
      if(!hay.includes(search)) return false;
    }
    return true;
  }).sort((a, b) => new Date(b.submittedAt || 0) - new Date(a.submittedAt || 0));

  if(!filtered.length){
    body.innerHTML = '';
    if(emptyEl) emptyEl.style.display = '';
    return;
  }
  if(emptyEl) emptyEl.style.display = 'none';

  // v276: a "submission" row is a raw ghl_form_submissions record — the
  // exact same data Campaign Guide (derived from it), Client Qualification
  // Form, and Data Order Form all read from Client Submissions. Deleting
  // one deletes it out of all three at once, so that's now Owner-only.
  // Leads/Dispute-Feedback rows are unrelated tables and keep the existing
  // Owner-or-Admin bar.
  const canDeleteAdminRows = myIsOwner || myRole === 'admin';
  body.innerHTML = '';
  filtered.forEach(r => {
    const meta = QUEUE_META[r.queue] || { label: r.queue, color: 'var(--text-dim)' };
    const allQueueTz = r.userId ? leadsTzFor(r.userId) : nonAgentDisplayTz();
    const submittedLabel = r.submittedAt ? new Date(r.submittedAt).toLocaleString([], { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', ...(allQueueTz ? { timeZone: allQueueTz } : {}) }) : '—';
    const statusLabel = typeof r.status === 'string' && !r.status.includes('—') ? (LEAD_STATUS_META[r.status] || { label: r.status }).label : (r.status || '—');
    const rowKey = `${r.source}-${r.id}`;
    const expanded = allQueueExpandedKey === rowKey;
    const canDelete = r.source === 'submission' ? myIsOwner : canDeleteAdminRows;
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td><span style="color:${meta.color};">${escapeHtml(meta.label)}</span></td>
      <td>${escapeHtml(r.name)}</td>
      <td class="mono">${escapeHtml(r.phone)}</td>
      <td>${escapeHtml(r.campaignOrForm)}</td>
      <td class="mono">${submittedLabel}</td>
      <td>${escapeHtml(statusLabel)}</td>
      <td>${r.details ? `<button class="btn-secondary all-queue-details-btn" data-key="${escapeHtml(rowKey)}" style="width:auto; padding:5px 10px; font-size:11px;">${expanded ? 'Hide' : 'Show'}</button>` : '<span style="color:var(--text-dim); font-size:11px;">—</span>'}</td>
      <td>${canDelete ? `<button class="btn-secondary all-queue-del-btn" style="width:auto; padding:5px 12px; font-size:11px; color:var(--danger); border-color:var(--danger);" data-source="${r.source}" data-id="${r.id}">Delete</button>` : '<span style="color:var(--text-dim); font-size:11px;">—</span>'}</td>
    `;
    body.appendChild(tr);
    if(expanded && r.details){
      const detailsTr = document.createElement('tr');
      detailsTr.innerHTML = `<td colspan="8" style="background:var(--inset); white-space:pre-wrap; font-size:12px; padding:10px 14px;">${escapeHtml(r.details)}</td>`;
      body.appendChild(detailsTr);
    }
  });
}

$('allQueueBody').addEventListener('click', async (e) => {
  const detailsBtn = e.target.closest('.all-queue-details-btn');
  if(detailsBtn){
    allQueueExpandedKey = allQueueExpandedKey === detailsBtn.dataset.key ? null : detailsBtn.dataset.key;
    renderAllQueueTable();
    return;
  }
  const btn = e.target.closest('.all-queue-del-btn');
  if(!btn) return;
  // v276: ghl_form_submissions rows (Campaign Guide / Client Qualification
  // Form / Data Order Form) are Owner-only to delete; leads/disputes stay
  // Owner-or-Admin \u2014 see the matching canDelete split in renderAllQueueTable().
  const isSubmissionRow = btn.dataset.source !== 'lead' && btn.dataset.source !== 'dispute';
  if(isSubmissionRow ? !myIsOwner : !(myIsOwner || myRole === 'admin')) return;
  if(!confirm('Permanently delete this record? This can\u2019t be undone.')) return;
  btn.disabled = true;
  const table = btn.dataset.source === 'lead' ? 'leads' : btn.dataset.source === 'dispute' ? 'lead_disputes' : 'ghl_form_submissions';
  const { error } = await sb.from(table).delete().eq('id', btn.dataset.id);
  if(error){ alert(error.message); btn.disabled = false; return; }
  logActivity('all_queue.delete', table === 'leads' ? 'lead' : (table === 'lead_disputes' ? 'lead_dispute' : 'ghl_form_submission'), btn.dataset.id, `Deleted a record from All Queue (${table})`);
  if(table === 'leads') await loadLeads(); else await loadAllQueue();
});

$('allQueueDateFromFilter').addEventListener('change', () => { allQueueFilters.dateFrom = $('allQueueDateFromFilter').value; loadLeads(); });
$('allQueueDateToFilter').addEventListener('change', () => { allQueueFilters.dateTo = $('allQueueDateToFilter').value; loadLeads(); });
$('allQueueQueueFilter').addEventListener('change', () => { allQueueFilters.queue = $('allQueueQueueFilter').value; renderAllQueueTable(); });
$('allQueueUserFilter').addEventListener('change', () => { allQueueFilters.user = $('allQueueUserFilter').value; renderAllQueueTable(); });
$('allQueueStatusFilter').addEventListener('change', () => { allQueueFilters.status = $('allQueueStatusFilter').value; renderAllQueueTable(); });
$('allQueueSearchFilter').addEventListener('input', debounce(() => { allQueueFilters.search = $('allQueueSearchFilter').value; renderAllQueueTable(); }, 200));

// v392: shared field-input builder for both renderTicketAcceptExtraFields()
// and renderLeadsQueueReviewExtraFields() — renders a real <select> for a
// field whose ORIGINAL submission form defined it as a dropdown ('select'
// field_type), matching that form's own options list, instead of always
// showing free text. Falls back to the previous textarea/input behavior
// for anything else (plain text, or a 'multi'/checkbox-group field, which
// still round-trips fine as a \n-joined textarea).
// If the field's saved value doesn't exactly match any current option
// (form options edited since submission, stale data, etc.), that value is
// injected as its own selected option rather than silently discarding it —
// a reviewer should never lose visibility into what was actually saved.
function leadsExtraFieldInputHtml(e, cssClass, opts){
  const val = String(e.value);
  const requiredAttr = (opts && opts.requiredAttr) || '';
  const extraStyle = (opts && opts.extraStyle) || '';
  if(e.type === 'select' && Array.isArray(e.options) && e.options.length){
    const hasVal = val !== '' && e.options.includes(val);
    const optionsHtml = (val !== '' && !hasVal ? [`<option value="${escapeHtml(val)}" selected>${escapeHtml(val)} (not a listed option)</option>`] : [])
      .concat(e.options.map(o => `<option value="${escapeHtml(o)}" ${o === val ? 'selected' : ''}>${escapeHtml(o)}</option>`));
    return `<select class="${cssClass}" data-key="${escapeHtml(e.key)}" ${requiredAttr} style="${extraStyle}"><option value="">—</option>${optionsHtml.join('')}</select>`;
  }
  const isMulti = e.type === 'multi' || val.includes('\n');
  return isMulti
    ? `<textarea class="${cssClass}" data-key="${escapeHtml(e.key)}" ${requiredAttr} rows="3" style="width:100%; font-family:var(--mono); font-size:12px; ${extraStyle}">${escapeHtml(val)}</textarea>`
    : `<input type="text" class="${cssClass}" data-key="${escapeHtml(e.key)}" ${requiredAttr} value="${escapeHtml(val)}" style="font-family:var(--mono); font-size:12px; ${extraStyle}">`;
}

// ---------- v107: Accept Ticket modal — pick the real target campaign ----------
let ticketAcceptModalLead = null;
// v112: same rendering approach as renderLeadsQueueReviewExtraFields, just
// targeting the Ticket Accept modal's own containers — every field the
// agent submitted on the Ticket form, editable, so a correction (e.g. a
// typo the agent made) can be fixed before it's sent to the client.
function renderTicketAcceptExtraFields(lead){
  const entries = leadsExtraFieldsEntriesFn(lead.task_id, lead.submission_form_id, lead.extra_fields);
  const wrap = $('ticketAcceptExtraFieldsWrap');
  const container = $('ticketAcceptExtraFields');
  if(!entries.length){
    container.innerHTML = '';
    wrap.style.display = 'none';
    return;
  }
  // audit fix (audit_chunk4.md #4, Medium): this used to call
  // leadsExtraFieldInputHtml() with no opts at all, so a required custom
  // field rendered identically to an optional one -- no data-required
  // marker, no visual flag, no asterisk -- and nothing in the
  // ticketAcceptConfirmBtn handler below checked it either. Same
  // required-field marking renderLeadsQueueReviewExtraFields() already
  // uses for the equivalent Lead Submission review path.
  container.innerHTML = entries.map(e => {
    const val = String(e.value);
    const blankRequired = e.required && !val.trim();
    const highlightStyle = blankRequired ? 'border:1px solid var(--away); background:rgba(255,159,10,0.08);' : '';
    const requiredNote = blankRequired ? `<div style="font-size:10px; color:var(--away); margin-top:3px;">Required — this field must be filled in to send to the client.</div>` : '';
    return `
      <div>
        <label style="font-size:11px; color:var(--text-dim); font-weight:400; display:block; margin-bottom:3px;">${escapeHtml(e.label)}${e.required ? ' <span style="color:var(--away);">*</span>' : ''}</label>
        ${leadsExtraFieldInputHtml(e, 'ticket-accept-extra-field', { requiredAttr: `data-required="${e.required ? 'true' : 'false'}"`, extraStyle: highlightStyle })}
        ${requiredNote}
      </div>`;
  }).join('');
  wrap.style.display = '';
}

// v196: wires a text-input + filtered-list UI onto a hidden native
// <select> that's ALREADY been populated with <option value>...</option>
// elements (by whatever existing code built it) — reads its options once,
// then every selection just sets select.value and fires a native 'change'
// event, so any code elsewhere that reads the select directly keeps
// working with zero changes. Call this fresh every time the select's
// options are rebuilt (it re-reads them each call).
function initSearchableSelect(selectId, searchId, listId){
  const select = $(selectId), search = $(searchId), list = $(listId);
  if(!select || !search || !list) return;
  const options = Array.from(select.options).map(o => ({ value: o.value, label: o.textContent, selected: o.selected }));
  const selected = options.find(o => o.selected && o.value);
  search.value = selected ? selected.label : '';

  function renderList(filterText){
    const q = (filterText || '').trim().toLowerCase();
    const matches = q ? options.filter(o => o.value && o.label.toLowerCase().includes(q)) : options.filter(o => o.value);
    list.innerHTML = matches.length
      ? matches.map(o => `<div class="searchable-select-option" data-value="${escapeHtml(o.value)}">${escapeHtml(o.label)}</div>`).join('')
      : `<div class="searchable-select-option empty">${options.some(o => !o.value) ? escapeHtml(options.find(o => !o.value).label) : 'No matches'}</div>`;
    list.querySelectorAll('.searchable-select-option[data-value]').forEach(el => {
      el.addEventListener('mousedown', (e) => {
        // mousedown (not click) fires before the input's blur, so the
        // list is still open and readable when the option is chosen.
        e.preventDefault();
        select.value = el.dataset.value;
        const opt = options.find(o => o.value === el.dataset.value);
        search.value = opt ? opt.label : '';
        select.dispatchEvent(new Event('change', { bubbles: true }));
        list.classList.remove('show');
      });
    });
  }
  search.oninput = () => { renderList(search.value); list.classList.add('show'); };
  search.onfocus = () => { renderList(search.value === (selected ? selected.label : '') ? '' : search.value); list.classList.add('show'); };
  search.onblur = () => { setTimeout(() => list.classList.remove('show'), 120); };
}

async function openTicketAcceptModal(lead){
  ticketAcceptModalLead = lead;
  const sel = $('ticketAcceptCampaignSelect');
  sel.innerHTML = '<option value="">Loading campaigns…</option>';
  $('ticketAcceptSellerName').value = lead.seller_investor_name || '';
  $('ticketAcceptPhone').value = lead.seller_phone || '';
  renderTicketAcceptExtraFields(lead);
  $('ticketAcceptModalMsg').style.display = 'none';
  $('ticketAcceptModalOverlay').classList.add('active');
  // Fetched directly (not off sfAllForms) since Submission Forms Creator's
  // own cache is only populated once that subtab has actually been
  // opened this session — Tickets Review needs this list independently.
  const { data: forms } = await sb.from('lead_submission_forms').select('id, name, is_active').eq('is_active', true).order('name');
  // Every active form EXCEPT "Ticket" itself — a ticket can map onto any
  // real campaign, including PrimeHome Buyers if that's genuinely where
  // it belongs.
  const options = (forms || []).filter(f => f.id !== leadsTicketFormId);
  // v113: matched by LABEL ("Campaign Name", case/whitespace-insensitive —
  // same helper leadsCampaignNameFor() already uses), not the literal
  // extra_fields key — the Ticket form's fields are ordinary, fully
  // editable Submission Forms Creator fields like any other form's, so an
  // admin renaming/replacing this field's key shouldn't silently break
  // this guess. Falls back to nothing found (no pre-selection) rather
  // than erroring if the field's been removed entirely.
  const submittedName = leadsCampaignNameFor(lead).trim().toLowerCase();
  // Pre-select by matching the agent's own free-text "Campaign Name"
  // answer against a real form's name — just a convenience guess; staff
  // always confirms/overrides before sending.
  const guessedMatch = options.find(f => f.name.trim().toLowerCase() === submittedName);
  sel.innerHTML = options.map(f => `<option value="${f.id}" ${guessedMatch && f.id === guessedMatch.id ? 'selected' : ''}>${escapeHtml(f.name)}</option>`).join('')
    || '<option value="">No other campaigns exist yet — create one under Submission Forms Creator first.</option>';
  initSearchableSelect('ticketAcceptCampaignSelect', 'ticketAcceptCampaignSearch', 'ticketAcceptCampaignList');
}
function closeTicketAcceptModal(){
  $('ticketAcceptModalOverlay').classList.remove('active');
  ticketAcceptModalLead = null;
}
$('ticketAcceptCancelBtn').addEventListener('click', closeTicketAcceptModal);
$('ticketAcceptModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'ticketAcceptModalOverlay') closeTicketAcceptModal(); });
$('ticketAcceptConfirmBtn').addEventListener('click', async () => {
  const lead = ticketAcceptModalLead;
  const msgEl = $('ticketAcceptModalMsg');
  if(!lead) return;
  const targetFormId = $('ticketAcceptCampaignSelect').value;
  if(!targetFormId){ msgEl.textContent = 'Pick a campaign first.'; msgEl.style.display = ''; return; }
  const sellerName = $('ticketAcceptSellerName').value.trim();
  const phone = $('ticketAcceptPhone').value.trim();
  if(!sellerName){ msgEl.textContent = 'Seller / Investor Name is required.'; msgEl.style.display = ''; return; }
  if(!phone){ msgEl.textContent = 'Phone is required.'; msgEl.style.display = ''; return; }
  // audit fix (audit_chunk4.md #4, Medium): required custom fields (same
  // `required` flag the original submission form set, same one Lead
  // Submission's own review path enforces via saveLeadsQueueReviewFields
  // AndSetStatus()) were never checked here — a ticket could be pushed to
  // ticket_stage: 'client_review' (visible to the client) with a required
  // field silently blank.
  const missingRequired = [];
  document.querySelectorAll('#ticketAcceptExtraFields .ticket-accept-extra-field').forEach(el => {
    if(el.dataset.required === 'true' && !el.value.trim()){
      const label = el.closest('div')?.querySelector('label')?.textContent.replace(/[\s*]+$/, '') || el.dataset.key;
      missingRequired.push(label);
    }
  });
  if(missingRequired.length){
    msgEl.textContent = `Required fields missing: ${missingRequired.join(', ')}.`;
    msgEl.style.display = '';
    return;
  }
  // v711: an address that is a phone number, or an email that is a name, is
  // refused here rather than saved onto the lead.
  const badValues = [];
  document.querySelectorAll('#ticketAcceptExtraFields .ticket-accept-extra-field').forEach(el => {
    const label = el.closest('div')?.querySelector('label')?.textContent.replace(/[\s*]+$/, '') || el.dataset.key;
    const problem = leadFieldProblem(el.dataset.key, label, el.value);
    if(problem) badValues.push(problem);
  });
  if(badValues.length){
    msgEl.textContent = badValues.join(' ');
    msgEl.style.display = '';
    return;
  }
  // v112: whatever's now in each submitted-detail input, same
  // blank-removes-the-key convention as Leads Queue Review's own popup.
  const extraFields = { ...(lead.extra_fields || {}) };
  document.querySelectorAll('#ticketAcceptExtraFields .ticket-accept-extra-field').forEach(el => {
    const key = el.dataset.key;
    const val = el.value.trim();
    if(val) extraFields[key] = val; else delete extraFields[key];
  });
  const { data: { user } } = await sb.auth.getUser();
  const targetFormLabel = $('ticketAcceptCampaignSelect').selectedOptions[0] ? $('ticketAcceptCampaignSelect').selectedOptions[0].textContent : targetFormId;
  const { error } = await sb.from('leads').update({
    submission_form_id: targetFormId,
    seller_investor_name: sellerName,
    seller_phone: phone,
    extra_fields: extraFields,
    ticket_stage: 'client_review',
    // v217: this modal is also used to redirect a 'client_rejected'
    // ticket (status='rejected' at that point) to a different campaign —
    // reset back to the normal in-flight state. No-op for the original
    // 'staff_review' -> 'client_review' path, where status is already
    // 'pending' and review_note is already null.
    status: 'pending',
    review_note: null,
    reviewed_by: user ? user.id : null,
    reviewed_at: new Date().toISOString(),
  }).eq('id', lead.id);
  if(error){ msgEl.textContent = error.message; msgEl.style.display = ''; return; }
  // v153: this is the "awaiting client Yes/No" push — text every client
  // granted the campaign it was just assigned to.
  notifyClientsForFormId(targetFormId, 'ticket_received', targetFormLabel);
  logActivity('lead.ticket_accept', 'lead', lead.id, `Ticket accepted and sent to client for review — campaign: ${targetFormLabel}`);
  closeTicketAcceptModal();
  await loadLeads();
});

// Phone number an agent (or an admin backfilling it) enters for a lead —
// this is the ONLY thing the ispeedtolead-postback Edge Function can match
// an incoming postback against (see schema.sql (v59 section)), so
// keeping it editable here matters even after the lead's already been
// submitted, not just at submission time in the extension.
// ---------- v83: Submission Forms — Lead Submission (fill & submit) +
// Submission Forms Creator (build/edit forms) — a fully independent
// system from task_category_fields (the extension's own per-task "Submit
// leads" popup, completely untouched by this) — see
// schema.sql (v83 section) for the full "why unlink from tasks" story.
// Two sub-subtabs sharing the one leadsSection-submission_forms panel,
// each its own separately grantable leads_sections permission
// (submission_forms for Lead Submission, submission_forms_creator for
// the Creator — see LEADS_SECTIONS above).
let sfAllForms = []; // { id, name, is_active, sort_order }
let sfFormFieldsCache = {}; // form_id -> its fields, refreshed by loadSfFormsAndFields()
// v84: role-scoped visibility — form_id -> Set of role names allowed to
// see it in Lead Submission. A form with no entry (or an empty Set) here
// is visible to every role, same "no assignment yet -> show everything"
// fallback the extension's own per-task assignment already uses.
let sfFormRolesCache = {};
let sfAssignableRoles = []; // [{ name }] — every role EXCEPT owner/admin AND agent (agent is assigned per-person below, not as a blanket role checkbox — see v85)
let sfAllAgentProfiles = []; // [{ id, full_name, email }] — every individual person with the 'agent' role
let sfFormAgentsCache = {}; // form_id -> Set of user_id, refreshed by loadSfFormsAndFields()
let sfAllTemplates = []; // [{ id, name, fields }] — reusable, named field-set snapshots (v85)

async function initSubmissionFormsSection(){
  await loadSfFormsAndFields();
  renderSfFormsCreatorList();
  renderSfTemplatesList();
  renderFillFormOptions();
  renderFillFields();
  // v97: the "Load from Campaign Guide" picker on each form card needs
  // campaignGuides populated — load it once per session the first time
  // Submission Forms Creator is opened (loadCampaignGuide() re-renders
  // this list itself once it resolves, so this doesn't need to be awaited
  // here — see loadCampaignGuide()'s own comment).
  if(!campaignGuidesLoaded) loadCampaignGuide();
  // Same view-gating pattern as initLeadsTab() uses for the outer Leads
  // subtabs — Forms Creator defaults to no View at all (see
  // leadsSectionDefault), so most roles never see this pill in the first
  // place, rather than seeing a permanently-disabled tab they were never
  // meant to know exists.
  document.querySelectorAll('.sf-subtab-btn').forEach(btn => {
    btn.style.display = canViewLeadsSection(btn.dataset.sfSection === 'creator' ? 'submission_forms_creator' : 'submission_forms') ? '' : 'none';
  });
  const activeBtn = document.querySelector('.sf-subtab-btn.active');
  const activeKey = activeBtn && activeBtn.style.display !== 'none' ? activeBtn.dataset.sfSection : null;
  const firstVisible = Array.from(document.querySelectorAll('.sf-subtab-btn')).find(b => b.style.display !== 'none');
  activateSfSection(activeKey || (firstVisible ? firstVisible.dataset.sfSection : 'submit'));
  // Disabling the Submit button via .edit-only is easy to miss (it just
  // dims slightly) — make the reason impossible to miss instead, since
  // "the button doesn't do anything" with no visible explanation is
  // exactly the confusing failure mode this is meant to prevent. Same
  // idea for the Creator side's own permission.
  const hint = $('lfFillPermissionHint');
  if(hint) hint.style.display = canEditLeadsSection('submission_forms') ? 'none' : 'block';
  const creatorHint = $('sfCreatorPermHint');
  if(creatorHint) creatorHint.style.display = canEditLeadsSection('submission_forms_creator') ? 'none' : '';
}

async function loadSfFormsAndFields(){
  const { data: forms } = await sb.from('lead_submission_forms').select('id, name, is_active, sort_order').order('sort_order');
  sfAllForms = forms || [];
  const { data: fields } = await sb.from('lead_submission_form_fields')
    .select('id, form_id, field_key, label, field_type, options, required, placeholder, sort_order').order('sort_order');
  sfFormFieldsCache = {};
  (fields || []).forEach(f => { (sfFormFieldsCache[f.form_id] = sfFormFieldsCache[f.form_id] || []).push(f); });
  const { data: formRoles } = await sb.from('lead_submission_form_roles').select('form_id, role');
  sfFormRolesCache = {};
  (formRoles || []).forEach(r => { (sfFormRolesCache[r.form_id] = sfFormRolesCache[r.form_id] || new Set()).add(r.role); });
  const { data: roles } = await sb.from('roles').select('name').order('name');
  // v85: 'agent' excluded — that role now gets assigned per INDIVIDUAL
  // person below (sfAllAgentProfiles/lead_submission_form_agents)
  // instead of as one blanket role-level checkbox. Every other role
  // (Manager, or whatever custom types exist) still works exactly like
  // v84 — a plain role-level checkbox.
  sfAssignableRoles = (roles || []).filter(r => !PROTECTED_ROLES.has(r.name) && r.name !== 'agent');
  // v85: every individual person with the 'agent' role, for the new
  // per-person assignment list under Submission Forms Creator's "Agents"
  // section.
  const { data: agentProfiles } = await sb.from('profiles').select('id, full_name, email').eq('role', 'agent').order('full_name');
  sfAllAgentProfiles = agentProfiles || [];
  const { data: formAgents } = await sb.from('lead_submission_form_agents').select('form_id, user_id');
  sfFormAgentsCache = {};
  (formAgents || []).forEach(a => { (sfFormAgentsCache[a.form_id] = sfFormAgentsCache[a.form_id] || new Set()).add(a.user_id); });
  const { data: templates } = await sb.from('lead_submission_field_templates').select('id, name, fields').order('name');
  sfAllTemplates = templates || [];
}

// True if the CURRENTLY SIGNED-IN user can see this form in Lead
// Submission — Owner/Admin always can (same bypass as everywhere else in
// this app). Below that, the check SPLITS by the user's own role:
//   - 'agent': checked against lead_submission_form_agents — per-person,
//     since that role is normally the bulk of a company's staff and a
//     blanket per-role toggle isn't granular enough (see v85).
//   - everything else: checked against lead_submission_form_roles —
//     per-role, unchanged from v84.
// Either way, no restriction at all for that mechanism (empty Set) means
// visible to everyone that mechanism governs.
// v107: previously this only consulted the per-agent assignment list
// (sfFormAgentsCache) when the CURRENT viewer's role was literally
// 'agent', and fell back to a totally separate per-role check otherwise.
// That's the wrong split — Adel grants a form to a specific INDIVIDUAL
// (whatever role they happen to hold today), and the whole point of
// naming that person is that they, specifically, should see it. Now: if
// a form has ANY per-person assignment at all, that list is authoritative
// for every viewer, full stop — you're either on it or you're not,
// regardless of your role. Only forms with NO per-person assignment fall
// through to the per-role check (unchanged from v84).
function sfFormVisibleToMe(formId){
  if(myIsOwner || myRole === 'admin') return true;
  const allowedAgents = sfFormAgentsCache[formId];
  if(allowedAgents && allowedAgents.size > 0) return allowedAgents.has(myUserId);
  const allowedRoles = sfFormRolesCache[formId];
  return !allowedRoles || allowedRoles.size === 0 || allowedRoles.has(myRole);
}

// ----- Submission Forms Creator: create/rename/activate/delete a form, edit its fields -----
$('sfAddFormBtn').addEventListener('click', async () => {
  const input = $('sfNewFormNameInput');
  const msg = $('sfNewFormMsg');
  const name = (input.value || '').trim();
  msg.textContent = ''; msg.className = 'msg';
  if(!name){ msg.textContent = 'Enter a name for the form.'; msg.className = 'msg error'; return; }
  const nextOrder = sfAllForms.reduce((m, f) => Math.max(m, f.sort_order), -10) + 10;
  const { data: { user } } = await sb.auth.getUser();
  // v178: form name IS the campaign name throughout this app (Leads,
  // Client Portal, Campaign Guide, etc. all key off lead_submission_forms.name)
  // — whatever the person types here becomes the campaign's name, so no
  // separate derivation step is needed.
  const { data: createdForm, error } = await sb.from('lead_submission_forms').insert({ name, sort_order: nextOrder, created_by: user ? user.id : null }).select('id').maybeSingle();
  if(error){
    msg.textContent = /duplicate|unique/i.test(error.message) ? 'A form with that name already exists.' : error.message;
    msg.className = 'msg error';
    return;
  }
  input.value = '';
  logActivity('lead_submission_form.create', null, null, `Created submission form "${name}"`);
  // v178: every new campaign now starts with whatever fields are CURRENTLY
  // on the "Default Template Final" template — kept live/editable by
  // whoever maintains it (Field Templates below), rather than a fixed set
  // baked into this button. If no such template exists yet, the form is
  // simply created empty, same as before — no error, nothing blocks
  // creation, and the existing "Load from Default Template Final" button
  // on the form card still works as a manual fallback/re-sync at any time.
  if(createdForm && createdForm.id){
    const template = sfFindDefaultTemplateFinal();
    if(template && (template.fields || []).length){
      let sortOrder = 0;
      let added = 0;
      for(const tf of template.fields){
        const { error: fErr } = await sb.from('lead_submission_form_fields').insert({
          form_id: createdForm.id, field_key: tf.field_key, label: tf.label, field_type: tf.field_type,
          options: tf.options || null, required: !!tf.required, placeholder: tf.placeholder || null, sort_order: sortOrder,
        });
        sortOrder += 10;
        if(!fErr) added++;
      }
      if(added) logActivity('lead_submission_form_field.apply_template', null, null, `Applied template "${template.name}" to new submission form "${name}" (${added} field(s) added)`);
    }
  }
  await loadSfFormsAndFields();
  renderSfFormsCreatorList();
  renderFillFormOptions();
});

// Same shape as the field-add UI other admin screens in this app use —
// reserved-key shortcuts (Seller Name/phone/Count map to real leads
// columns, same RESERVED_FIELD_KEYS as task_category_fields' own fields)
// plus a custom-field form with an options input that only shows for
// dropdown/checkbox-group types.
function sfFormFieldAddFormHtml(){
  return `
    <div class="edit-only" style="display:flex; gap:6px; align-items:center; margin-top:8px; flex-wrap:wrap;">
      <button class="btn-secondary sf-form-field-reserved-btn" data-key="seller_investor_name" data-label="Seller Name" data-type="text" data-required="true" style="width:auto; padding:4px 10px; font-size:11px;">+ Seller Name</button>
      <button class="btn-secondary sf-form-field-reserved-btn" data-key="seller_phone" data-label="Seller phone" data-type="tel" data-required="true" style="width:auto; padding:4px 10px; font-size:11px;">+ Seller phone</button>
      <button class="btn-secondary sf-form-field-reserved-btn" data-key="count" data-label="Count" data-type="number" data-required="true" style="width:auto; padding:4px 10px; font-size:11px;">+ Count</button>
    </div>
    <div class="edit-only" style="display:flex; gap:6px; align-items:center; margin-top:8px; flex-wrap:wrap;">
      <input type="text" class="sf-form-field-label-input" placeholder="Custom field label, e.g. Property address" style="flex:1; min-width:160px; padding:4px 8px; font-size:11px;">
      <select class="sf-form-field-type-select" style="padding:4px 8px; font-size:11px;">
        <option value="text">Text</option>
        <option value="tel">Phone</option>
        <option value="number">Number</option>
        <option value="textarea">Long text</option>
        <option value="select">Dropdown (single choice)</option>
        <option value="multi">Checkbox group (multiple choice)</option>
      </select>
      <label style="display:flex; align-items:center; gap:4px; cursor:pointer; text-transform:none; font-family:var(--sans); font-size:11px; color:var(--text-dim); letter-spacing:0;">
        <input type="checkbox" class="sf-form-field-required-input" style="width:14px; height:14px; accent-color:var(--focus);">
        Required
      </label>
      <button class="btn-secondary sf-form-field-add-btn" style="width:auto; padding:4px 10px; font-size:11px;">Add field</button>
    </div>
    <div class="sf-form-field-options-row edit-only" style="display:none; margin-top:6px;">
      <input type="text" class="sf-form-field-options-input" placeholder="Choices, comma-separated — e.g. Yes, No, Not sure">
    </div>
    <div class="msg sf-form-field-msg"></div>
  `;
}

async function addSfFormField(formId, fieldsContainer, { field_key, label, field_type, options, required }, onSuccess){
  const existing = sfFormFieldsCache[formId] || [];
  const nextOrder = existing.length ? Math.max(...existing.map(f => f.sort_order)) + 10 : 0;
  const row = { form_id: formId, field_key, label, field_type, required, sort_order: nextOrder, options: (options && options.length) ? options : null };
  const { error } = await sb.from('lead_submission_form_fields').insert(row);
  if(error){
    alert(/duplicate|unique/i.test(error.message) ? `This form already has a "${label}" field.` : error.message);
    return;
  }
  logActivity('lead_submission_form_field.create', null, null, `Added field "${label}" (${fieldTypeLabel(field_type)}) to a submission form`);
  await loadSfFormsAndFields();
  renderSfFormFieldsList(formId, fieldsContainer);
  renderFillFormOptions(); renderFillFields();
  if(onSuccess) onSuccess();
}

function renderSfFormFieldsList(formId, container){
  const fields = (sfFormFieldsCache[formId] || []).slice().sort((a, b) => a.sort_order - b.sort_order);
  container.innerHTML = '';
  if(!fields.length){
    const hint = document.createElement('div');
    hint.className = 'empty';
    hint.style.cssText = 'padding:8px 0;';
    hint.textContent = 'No fields yet — this form has nothing to submit.';
    container.appendChild(hint);
    applyLeadsSectionEditGating('submission_forms_creator', $('sfSection-creator'));
    return;
  }
  fields.forEach((f, i) => {
    if(sfFieldEditingId === f.id){
      container.appendChild(buildSfFieldEditRow(f, {
        onSaved: async () => { sfFieldEditingId = null; await loadSfFormsAndFields(); renderSfFormFieldsList(formId, container); renderFillFormOptions(); renderFillFields(); },
        onCancel: () => { sfFieldEditingId = null; renderSfFormFieldsList(formId, container); },
      }));
      return;
    }
    const row = document.createElement('div');
    row.style.cssText = 'display:flex; align-items:center; gap:8px; padding:5px 0; border-bottom:1px solid var(--border);';
    const optsNote = (f.field_type === 'select' || f.field_type === 'multi') && f.options && f.options.length
      ? `: ${f.options.slice(0, 3).map(escapeHtml).join(', ')}${f.options.length > 3 ? `, +${f.options.length - 3} more` : ''}` : '';
    row.innerHTML = `
      <span class="mono" style="font-size:12px; flex:1;">${escapeHtml(f.label)} <span style="color:var(--text-dim); font-size:10px;">(${fieldTypeLabel(f.field_type)}${f.required ? ', required' : ''}${RESERVED_FIELD_KEYS.has(f.field_key) ? ', maps to a fixed lead column' : ''}${optsNote})</span></span>
      <button class="edit-only sf-form-field-edit-btn" title="Edit field" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px;">Edit</button>
      <button class="edit-only sf-form-field-up-btn" title="Move up" ${i === 0 ? 'disabled' : ''} style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px;">▲</button>
      <button class="edit-only sf-form-field-down-btn" title="Move down" ${i === fields.length - 1 ? 'disabled' : ''} style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px;">▼</button>
      <button class="edit-only sf-form-field-del-btn" title="Remove field" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px;">×</button>
    `;
    row.querySelector('.sf-form-field-edit-btn').addEventListener('click', () => {
      sfFieldEditingId = f.id;
      renderSfFormFieldsList(formId, container);
    });
    row.querySelector('.sf-form-field-del-btn').addEventListener('click', async () => {
      if(!confirm(`Remove the "${f.label}" field? Values already submitted with it stay on those existing leads — this only stops it from being asked for on new submissions.`)) return;
      await sb.from('lead_submission_form_fields').delete().eq('id', f.id);
      logActivity('lead_submission_form_field.delete', null, null, `Removed field "${f.label}" from a submission form`);
      await loadSfFormsAndFields();
      renderSfFormFieldsList(formId, container);
      renderFillFormOptions(); renderFillFields();
    });
    const swapWith = async (other) => {
      if(!other) return;
      await Promise.all([
        sb.from('lead_submission_form_fields').update({ sort_order: other.sort_order }).eq('id', f.id),
        sb.from('lead_submission_form_fields').update({ sort_order: f.sort_order }).eq('id', other.id),
      ]);
      await loadSfFormsAndFields();
      renderSfFormFieldsList(formId, container);
    };
    row.querySelector('.sf-form-field-up-btn').addEventListener('click', () => swapWith(fields[i - 1]));
    row.querySelector('.sf-form-field-down-btn').addEventListener('click', () => swapWith(fields[i + 1]));
    container.appendChild(row);
  });
  applyLeadsSectionEditGating('submission_forms_creator', $('sfSection-creator'));
}

// v100: which single field (by id) is currently showing its inline edit
// row, across whichever list rendered it — a form's own field list or a
// template's field list (buildSfFieldEditRow is shared by both). Only one
// at a time; switching to edit a different field/template just replaces it.
let sfFieldEditingId = null;

// v100: shared inline edit row for a single field — label, type, options
// (dropdown/checkbox-group only), and required, matching the same
// add-field controls already used elsewhere on this page. field_key is
// shown but not editable (it's the stable identity a submitted lead's
// extra_fields/template snapshot is keyed by — renaming it would silently
// disconnect already-submitted values from this field). `onSave(patch)`
// receives the edited { label, field_type, options, required } and is
// responsible for actually persisting it (a form field vs. a template
// field save completely differently).
function buildSfFieldEditRow(f, { onSaved, onCancel, onSave }){
  const row = document.createElement('div');
  row.style.cssText = 'display:flex; gap:6px; align-items:center; padding:6px 0; border-bottom:1px solid var(--border); flex-wrap:wrap; background:var(--inset);';
  row.innerHTML = `
    <input type="text" class="sf-field-edit-label" value="${escapeHtml(f.label)}" placeholder="Label" style="flex:1; min-width:140px; padding:5px 8px; font-size:11px;">
    <select class="sf-field-edit-type" style="padding:5px 8px; font-size:11px;">
      <option value="text">Text</option>
      <option value="tel">Phone</option>
      <option value="number">Number</option>
      <option value="textarea">Long text</option>
      <option value="select">Dropdown (single choice)</option>
      <option value="multi">Checkbox group (multiple choice)</option>
    </select>
    <input type="text" class="sf-field-edit-options" placeholder="Choices, comma-separated" style="flex:1; min-width:160px; padding:5px 8px; font-size:11px; display:none;">
    <label style="display:flex; align-items:center; gap:4px; cursor:pointer; text-transform:none; font-family:var(--sans); font-size:11px; color:var(--text-dim); letter-spacing:0;">
      <input type="checkbox" class="sf-field-edit-required" style="width:14px; height:14px; accent-color:var(--focus);"> Required
    </label>
    <button class="btn-secondary sf-field-edit-cancel-btn" style="width:auto; padding:5px 10px; font-size:11px;">Cancel</button>
    <button class="btn-primary sf-field-edit-save-btn" style="width:auto; padding:5px 10px; font-size:11px; margin-top:0;">Save</button>
    <div class="msg sf-field-edit-msg" style="width:100%; margin:0;"></div>
  `;
  const typeSel = row.querySelector('.sf-field-edit-type');
  const optsInput = row.querySelector('.sf-field-edit-options');
  typeSel.value = f.field_type;
  optsInput.style.display = (f.field_type === 'select' || f.field_type === 'multi') ? '' : 'none';
  optsInput.value = (f.options || []).join(', ');
  row.querySelector('.sf-field-edit-required').checked = !!f.required;
  if(f.field_key && RESERVED_FIELD_KEYS.has(f.field_key)){
    typeSel.disabled = true;
    typeSel.title = 'This field maps to a fixed lead column — its type can\u2019t change, but its label and Required setting can.';
  }
  typeSel.addEventListener('change', () => {
    optsInput.style.display = (typeSel.value === 'select' || typeSel.value === 'multi') ? '' : 'none';
  });
  row.querySelector('.sf-field-edit-cancel-btn').addEventListener('click', () => onCancel());
  row.querySelector('.sf-field-edit-save-btn').addEventListener('click', async () => {
    const msg = row.querySelector('.sf-field-edit-msg');
    const label = row.querySelector('.sf-field-edit-label').value.trim();
    if(!label){ msg.textContent = 'Label is required.'; msg.className = 'msg sf-field-edit-msg error'; return; }
    const field_type = typeSel.value;
    let options = null;
    if(field_type === 'select' || field_type === 'multi'){
      options = optsInput.value.split(',').map(s => s.trim()).filter(Boolean);
      if(!options.length){ msg.textContent = 'Enter at least one choice, comma-separated.'; msg.className = 'msg sf-field-edit-msg error'; return; }
    }
    const required = row.querySelector('.sf-field-edit-required').checked;
    const patch = { label, field_type, options, required };
    if(onSave){
      const err = await onSave(patch);
      if(err){ msg.textContent = err; msg.className = 'msg sf-field-edit-msg error'; return; }
    } else {
      const { error } = await sb.from('lead_submission_form_fields').update(patch).eq('id', f.id);
      if(error){ msg.textContent = error.message; msg.className = 'msg sf-field-edit-msg error'; return; }
      logActivity('lead_submission_form_field.update', null, null, `Edited field "${label}" on a submission form`);
    }
    onSaved();
  });
  return row;
}

function wireSfFormFieldAddForm(container, formId, fieldsContainer){
  container.querySelectorAll('.sf-form-field-reserved-btn').forEach(btn => {
    btn.addEventListener('click', () => addSfFormField(formId, fieldsContainer, {
      field_key: btn.dataset.key, label: btn.dataset.label, field_type: btn.dataset.type, required: btn.dataset.required === 'true',
    }));
  });
  const typeSelect = container.querySelector('.sf-form-field-type-select');
  const optionsRow = container.querySelector('.sf-form-field-options-row');
  typeSelect.addEventListener('change', () => {
    optionsRow.style.display = (typeSelect.value === 'select' || typeSelect.value === 'multi') ? '' : 'none';
  });
  container.querySelector('.sf-form-field-add-btn').addEventListener('click', () => {
    const labelInput = container.querySelector('.sf-form-field-label-input');
    const requiredInput = container.querySelector('.sf-form-field-required-input');
    const optionsInput = container.querySelector('.sf-form-field-options-input');
    const msg = container.querySelector('.sf-form-field-msg');
    const label = (labelInput.value || '').trim();
    msg.textContent = ''; msg.className = 'msg sf-form-field-msg';
    if(!label){ msg.textContent = 'Enter a label for the custom field.'; msg.className = 'msg sf-form-field-msg error'; return; }
    const key = slugifyFieldKey(label);
    if(!key || RESERVED_FIELD_KEYS.has(key)){
      msg.textContent = 'That label produces a reserved or empty field key — try a more specific label.';
      msg.className = 'msg sf-form-field-msg error';
      return;
    }
    const fieldType = typeSelect.value;
    let options = null;
    if(fieldType === 'select' || fieldType === 'multi'){
      options = (optionsInput.value || '').split(',').map(s => s.trim()).filter(Boolean);
      if(!options.length){
        msg.textContent = 'Enter at least one choice, comma-separated.';
        msg.className = 'msg sf-form-field-msg error';
        return;
      }
    }
    addSfFormField(formId, fieldsContainer, { field_key: key, label, field_type: fieldType, options, required: requiredInput.checked }, () => {
      labelInput.value = ''; requiredInput.checked = false; optionsInput.value = '';
    });
  });
}

// v93: "Load from Default Template Final" replaces the old hardcoded
// "Load PrimeHome Buyers field set" button. Instead of a fixed list of
// PrimeHome-Buyers-specific fields, this now pulls from a named, saved
// template (same lead_submission_field_templates table/mechanism as
// "Save this form's fields as a template" / "Apply a template…" above) —
// whichever template is named exactly "Default Template Final".
//
// v100: this used to also force EVERY field on that template to
// required = true on every load, overwriting whatever an admin had set —
// effectively "reserving" the template's required flags from being
// managed like any other template's. Templates (including this one) are
// now directly editable in Field Templates below (label/type/options/
// required, add/remove fields), so that forced lock is removed: required
// here is simply whatever's saved on the template, same as any other.
const DEFAULT_TEMPLATE_FINAL_NAME = 'Default Template Final';

function sfFindDefaultTemplateFinal(){
  return sfAllTemplates.find(t => (t.name || '').trim().toLowerCase() === DEFAULT_TEMPLATE_FINAL_NAME.toLowerCase()) || null;
}

async function sfLoadDefaultTemplateFinal(formId, fieldsContainer, msgEl){
  const template = sfFindDefaultTemplateFinal();
  if(!template){
    msgEl.textContent = `No template named "${DEFAULT_TEMPLATE_FINAL_NAME}" exists yet — save one with that exact name first (any form's "Save this form's fields as a template" button below), then this button will load it.`;
    msgEl.className = 'msg sf-form-ispd-msg error';
    return;
  }
  if(!confirm(`Add every field from the "${DEFAULT_TEMPLATE_FINAL_NAME}" template to this form (each field's Required setting comes from however the template itself has it set)? Fields already on this form are left as-is; duplicates are skipped.`)) return;
  await sfApplyTemplate(formId, template.id, fieldsContainer, msgEl);
}

let sfFormsFilters = { name: '', status: '' };
if($('sfFormsFilterInput')) $('sfFormsFilterInput').addEventListener('input', debounce(() => {
  sfFormsFilters.name = $('sfFormsFilterInput').value.trim();
  renderSfFormsCreatorList();
}, 200));
if($('sfFormsStatusFilter')) $('sfFormsStatusFilter').addEventListener('change', () => {
  sfFormsFilters.status = $('sfFormsStatusFilter').value;
  renderSfFormsCreatorList();
});

function renderSfFormsCreatorList(){
  const list = $('sfFormsList');
  const filtered = sfAllForms.filter(f => {
    if(sfFormsFilters.name && !f.name.toLowerCase().includes(sfFormsFilters.name.toLowerCase())) return false;
    if(sfFormsFilters.status === 'active' && !f.is_active) return false;
    if(sfFormsFilters.status === 'inactive' && f.is_active) return false;
    return true;
  });
  if(!sfAllForms.length){
    list.innerHTML = '<div class="empty">No submission forms yet — add one above.</div>';
    return;
  }
  if(!filtered.length){
    list.innerHTML = '<div class="empty">No forms match these filters.</div>';
    return;
  }
  list.innerHTML = '';
  filtered.forEach(f => {
    const row = document.createElement('div');
    row.className = 'card';
    row.style.cssText = 'margin-bottom:12px;' + (f.is_active ? '' : ' opacity:0.55;');
    row.innerHTML = `
      <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
        <span class="mono" style="font-size:13px; font-weight:700; flex:1;">${escapeHtml(f.name)}${!f.is_active ? ' <span style="font-size:10px; color:var(--text-dim); font-weight:400;">(inactive \u2014 hidden from Lead Submission)</span>' : ''}</span>
        <button class="btn-secondary edit-only sf-form-ispd-btn" style="width:auto; padding:6px 12px; font-size:11px;">Load from Default Template Final</button>
        <button class="btn-secondary edit-only sf-form-toggle-btn" style="width:auto; padding:6px 12px; font-size:11px;">${f.is_active ? 'Deactivate' : 'Activate'}</button>
        <button class="edit-only sf-form-del-btn" title="Delete form" style="background:transparent; border:none; color:var(--danger); cursor:pointer; font-size:12px;">Delete</button>
      </div>
      <div style="margin-top:10px; padding-top:10px; border-top:1px solid var(--border);">
        <div style="font-size:10px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;">Visible to — user types</div>
        <div class="sf-form-roles-list" style="display:flex; gap:14px; flex-wrap:wrap; margin-bottom:4px;"></div>
        <div style="font-size:10px; color:var(--text-dim); margin-bottom:12px;">No types checked = visible to every type that can submit a lead at all (Agent isn't listed here — assigned individually below instead). Owner/Admin can always see every form regardless.</div>
        <div style="font-size:10px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;">Visible to — agents</div>
        <div class="sf-form-agents-list" style="display:flex; flex-direction:column; gap:4px; max-height:200px; overflow-y:auto; padding:8px 10px; border:1px solid var(--border-light); border-radius:8px; background:var(--inset); margin-bottom:4px;"></div>
        <div style="font-size:10px; color:var(--text-dim);">No agents checked = visible to every agent. Check specific agents to limit this form to just them.</div>
      </div>
      <div style="margin-top:10px; padding-top:10px; border-top:1px solid var(--border);">
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:10px;">
          <select class="sf-form-template-select edit-only" style="max-width:220px;"><option value="">Apply a template…</option>${sfAllTemplates.map(t => `<option value="${t.id}">${escapeHtml(t.name)}</option>`).join('')}</select>
          <button class="btn-secondary edit-only sf-form-template-apply-btn" style="width:auto; padding:6px 12px; font-size:11px;">Apply</button>
          <button class="btn-secondary edit-only sf-form-template-save-btn" style="width:auto; padding:6px 12px; font-size:11px;">Save this form's fields as a template</button>
        </div>
        <div class="msg sf-form-template-msg"></div>
        <div class="cat-fields-list sf-form-fields-list"></div>
        <div class="sf-form-field-add-wrap"></div>
        <div class="msg sf-form-ispd-msg"></div>
      </div>
    `;
    list.appendChild(row);
    renderSfFormRolesList(f, row.querySelector('.sf-form-roles-list'));
    renderSfFormAgentsList(f, row.querySelector('.sf-form-agents-list'));
    const fieldsContainer = row.querySelector('.sf-form-fields-list');
    renderSfFormFieldsList(f.id, fieldsContainer);
    const addWrap = row.querySelector('.sf-form-field-add-wrap');
    addWrap.innerHTML = sfFormFieldAddFormHtml();
    wireSfFormFieldAddForm(addWrap, f.id, fieldsContainer);
    row.querySelector('.sf-form-ispd-btn').addEventListener('click', () => sfLoadDefaultTemplateFinal(f.id, fieldsContainer, row.querySelector('.sf-form-ispd-msg')));
    const templateMsg = row.querySelector('.sf-form-template-msg');
    row.querySelector('.sf-form-template-apply-btn').addEventListener('click', () => {
      const templateId = row.querySelector('.sf-form-template-select').value;
      if(!templateId){ templateMsg.textContent = 'Pick a template first.'; templateMsg.className = 'msg sf-form-template-msg error'; return; }
      sfApplyTemplate(f.id, templateId, fieldsContainer, templateMsg);
    });
    row.querySelector('.sf-form-template-save-btn').addEventListener('click', () => sfSaveAsTemplate(f.id, f.name, templateMsg));
    row.querySelector('.sf-form-toggle-btn').addEventListener('click', async () => {
      await sb.from('lead_submission_forms').update({ is_active: !f.is_active }).eq('id', f.id);
      logActivity('lead_submission_form.update', null, null, `${f.is_active ? 'Deactivated' : 'Activated'} submission form "${f.name}"`);
      await loadSfFormsAndFields();
      renderSfFormsCreatorList();
      renderFillFormOptions(); renderFillFields();
    });
    row.querySelector('.sf-form-del-btn').addEventListener('click', async () => {
      if(!confirm(`Delete the "${f.name}" form? Its fields go with it. Leads already submitted through it keep their data — this only removes it from the picker going forward.`)) return;
      const { error } = await sb.from('lead_submission_forms').delete().eq('id', f.id);
      if(error){ alert(`Couldn't delete "${f.name}": ${error.message}`); return; }
      logActivity('lead_submission_form.delete', null, null, `Deleted submission form "${f.name}"`);
      await loadSfFormsAndFields();
      renderSfFormsCreatorList();
      renderFillFormOptions(); renderFillFields();
    });
  });
  applyLeadsSectionEditGating('submission_forms_creator', $('sfSection-creator'));
}

// v84: which user types (roles) can see this form in Lead Submission —
// checking the FIRST role for a previously-unrestricted form switches it
// from "everyone" to "just this role"; unchecking the LAST checked role
// switches it back to "everyone" (empty allow-list = no restriction, same
// convention as sfFormVisibleToMe()). Owner/Admin never appear in this
// list — they always see every form regardless, so there's nothing
// meaningful to check for them.
function renderSfFormRolesList(f, container){
  const allowed = sfFormRolesCache[f.id] || new Set();
  if(!sfAssignableRoles.length){
    container.innerHTML = '<span class="empty" style="font-size:11px;">No user types to list yet — add one under User Management → User Types.</span>';
    return;
  }
  container.innerHTML = sfAssignableRoles.map(r => `
    <label class="edit-only" style="display:flex; align-items:center; gap:5px; cursor:pointer; text-transform:none; font-family:var(--sans); font-size:12px; color:var(--text-2); letter-spacing:0;">
      <input type="checkbox" class="sf-form-role-cb" data-role="${escapeHtml(r.name)}" ${allowed.has(r.name) ? 'checked' : ''} style="width:13px; height:13px; accent-color:var(--focus);"> ${escapeHtml(r.name)}
    </label>
  `).join('');
  container.querySelectorAll('.sf-form-role-cb').forEach(cb => {
    cb.addEventListener('change', async () => {
      const role = cb.dataset.role;
      if(cb.checked){
        const { error } = await sb.from('lead_submission_form_roles').insert({ form_id: f.id, role });
        if(error){ alert(error.message); cb.checked = false; return; }
        logActivity('lead_submission_form.update', null, null, `Made submission form "${f.name}" visible to role "${role}"`);
      } else {
        await sb.from('lead_submission_form_roles').delete().eq('form_id', f.id).eq('role', role);
        logActivity('lead_submission_form.update', null, null, `Removed role "${role}" from submission form "${f.name}"'s allow-list`);
      }
      await loadSfFormsAndFields();
      renderFillFormOptions(); renderFillFields();
      // Not re-rendering this checklist itself — every checkbox's own
      // checked state already reflects what just happened; re-rendering
      // would just rebuild the same DOM with the same values.
    });
  });
  applyLeadsSectionEditGating('submission_forms_creator', $('sfSection-creator'));
}

// v85: apply a saved template's fields onto a form — same skip-duplicates
// logic the old hardcoded field-set loader used, just reading from a
// template's jsonb snapshot instead of a hardcoded field list.
async function sfApplyTemplate(formId, templateId, fieldsContainer, msgEl){
  const template = sfAllTemplates.find(t => t.id === templateId);
  if(!template) return;
  const existing = sfFormFieldsCache[formId] || [];
  const existingKeys = new Set(existing.map(f => f.field_key));
  let sortOrder = existing.reduce((m, f) => Math.max(m, f.sort_order), -10) + 10;
  let added = 0, skipped = 0;
  for(const tf of (template.fields || [])){
    if(existingKeys.has(tf.field_key)){ skipped++; continue; }
    const { error } = await sb.from('lead_submission_form_fields').insert({
      form_id: formId, field_key: tf.field_key, label: tf.label, field_type: tf.field_type,
      options: tf.options || null, required: !!tf.required, placeholder: tf.placeholder || null, sort_order: sortOrder,
    });
    sortOrder += 10;
    if(!error) added++; else skipped++;
  }
  logActivity('lead_submission_form_field.apply_template', null, null, `Applied template "${template.name}" to a submission form (${added} added, ${skipped} skipped)`);
  msgEl.textContent = `Applied "${template.name}": ${added} field(s) added${skipped ? `, ${skipped} skipped (already present or failed)` : ''}.`;
  msgEl.className = 'msg';
  await loadSfFormsAndFields();
  renderSfFormFieldsList(formId, fieldsContainer);
  renderFillFormOptions(); renderFillFields();
}

// v85: snapshot a form's CURRENT fields into a new named template — only
// field_key/label/field_type/options/required/placeholder are kept
// (sort_order is recomputed fresh whenever the template is later applied
// to some other form, same reasoning as the schema comment on
// lead_submission_field_templates.fields).
async function sfSaveAsTemplate(formId, formName, msgEl){
  const fields = sfFormFieldsCache[formId] || [];
  if(!fields.length){
    msgEl.textContent = 'This form has no fields yet — nothing to save as a template.';
    msgEl.className = 'msg sf-form-template-msg error';
    return;
  }
  const name = prompt(`Save "${formName}"'s ${fields.length} field(s) as a template — name it:`, `${formName} template`);
  if(!name || !name.trim()) return;
  const snapshot = fields.map(f => ({
    field_key: f.field_key, label: f.label, field_type: f.field_type,
    options: f.options || null, required: !!f.required, placeholder: f.placeholder || null,
  }));
  const { error } = await sb.from('lead_submission_field_templates').insert({ name: name.trim(), fields: snapshot });
  if(error){
    msgEl.textContent = /duplicate|unique/i.test(error.message) ? 'A template with that name already exists — pick a different name.' : error.message;
    msgEl.className = 'msg sf-form-template-msg error';
    return;
  }
  logActivity('lead_submission_field_template.create', null, null, `Saved template "${name.trim()}" (${snapshot.length} fields) from submission form "${formName}"`);
  msgEl.textContent = `Saved as template "${name.trim()}".`;
  msgEl.className = 'msg sf-form-template-msg';
  await loadSfFormsAndFields();
  renderSfFormsCreatorList(); // rebuilds every form's "Apply a template…" dropdown with the new one included
  renderSfTemplatesList();
}

let sfTemplateExpandedIds = new Set(); // which templates currently show their field-editor
let sfTemplateFieldEditingKey = null;  // `${templateId}:${index}` of the field currently in its inline edit row, or null

async function sfSaveTemplateFields(template, newFields){
  const { error } = await sb.from('lead_submission_field_templates').update({ fields: newFields }).eq('id', template.id);
  if(error) return error.message;
  template.fields = newFields;
  logActivity('lead_submission_field_template.update', null, null, `Edited fields on template "${template.name}"`);
  return null;
}

function renderSfTemplatesList(){
  const list = $('sfTemplatesList');
  if(!list) return;
  if(!sfAllTemplates.length){
    list.innerHTML = '<div class="empty">No templates saved yet — save one from any form below.</div>';
    return;
  }
  list.innerHTML = '';
  sfAllTemplates.forEach(t => {
    const wrap = document.createElement('div');
    wrap.style.cssText = 'padding:6px 0; border-bottom:1px solid var(--border);';
    const expanded = sfTemplateExpandedIds.has(t.id);
    const header = document.createElement('div');
    header.style.cssText = 'display:flex; align-items:center; gap:10px;';
    header.innerHTML = `
      <span class="mono" style="font-size:12px; flex:1;">${escapeHtml(t.name)} <span style="color:var(--text-dim); font-size:10px;">(${(t.fields || []).length} field${(t.fields || []).length === 1 ? '' : 's'})</span></span>
      <button class="edit-only sf-template-manage-btn" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px;">${expanded ? 'Hide fields' : 'Manage fields'}</button>
      <button class="edit-only sf-template-del-btn" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px;">Delete</button>
    `;
    header.querySelector('.sf-template-manage-btn').addEventListener('click', () => {
      if(expanded) sfTemplateExpandedIds.delete(t.id); else sfTemplateExpandedIds.add(t.id);
      renderSfTemplatesList();
    });
    header.querySelector('.sf-template-del-btn').addEventListener('click', async () => {
      if(!confirm(`Delete the "${t.name}" template? Forms it's already been applied to keep their fields — this only removes it from the "Apply a template…" list going forward.`)) return;
      const { error } = await sb.from('lead_submission_field_templates').delete().eq('id', t.id);
      if(error){ alert(`Couldn't delete "${t.name}": ${error.message}`); return; }
      logActivity('lead_submission_field_template.delete', null, null, `Deleted template "${t.name}"`);
      await loadSfFormsAndFields();
      renderSfFormsCreatorList();
      renderSfTemplatesList();
    });
    wrap.appendChild(header);

    if(expanded){
      const fieldsWrap = document.createElement('div');
      fieldsWrap.style.cssText = 'margin:8px 0 0 0; padding-left:4px;';
      const fields = t.fields || [];
      fields.forEach((f, i) => {
        const key = `${t.id}:${i}`;
        if(sfTemplateFieldEditingKey === key){
          fieldsWrap.appendChild(buildSfFieldEditRow(f, {
            onCancel: () => { sfTemplateFieldEditingKey = null; renderSfTemplatesList(); },
            onSave: async (patch) => {
              const newFields = fields.slice();
              newFields[i] = { ...f, ...patch };
              return await sfSaveTemplateFields(t, newFields);
            },
            onSaved: () => { sfTemplateFieldEditingKey = null; renderSfTemplatesList(); },
          }));
          return;
        }
        const optsNote = (f.field_type === 'select' || f.field_type === 'multi') && f.options && f.options.length
          ? `: ${f.options.slice(0, 3).map(escapeHtml).join(', ')}${f.options.length > 3 ? `, +${f.options.length - 3} more` : ''}` : '';
        const row = document.createElement('div');
        row.style.cssText = 'display:flex; align-items:center; gap:8px; padding:4px 0; border-top:1px solid var(--border);';
        row.innerHTML = `
          <span class="mono" style="font-size:12px; flex:1;">${escapeHtml(f.label)} <span style="color:var(--text-dim); font-size:10px;">(${fieldTypeLabel(f.field_type)}${f.required ? ', required' : ''}${optsNote})</span></span>
          <button class="edit-only sf-template-field-edit-btn" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px;">Edit</button>
          <button class="edit-only sf-template-field-del-btn" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:12px;">×</button>
        `;
        row.querySelector('.sf-template-field-edit-btn').addEventListener('click', () => { sfTemplateFieldEditingKey = key; renderSfTemplatesList(); });
        row.querySelector('.sf-template-field-del-btn').addEventListener('click', async () => {
          if(!confirm(`Remove "${f.label}" from the "${t.name}" template? This only changes the template — forms it's already been applied to are unaffected.`)) return;
          const newFields = fields.filter((_, idx) => idx !== i);
          const err = await sfSaveTemplateFields(t, newFields);
          if(err) alert(err);
          renderSfFormsCreatorList();
          renderSfTemplatesList();
        });
        fieldsWrap.appendChild(row);
      });
      if(!fields.length){
        const empty = document.createElement('div');
        empty.className = 'empty';
        empty.style.padding = '4px 0';
        empty.textContent = 'No fields on this template yet — add one below.';
        fieldsWrap.appendChild(empty);
      }

      const addRow = document.createElement('div');
      addRow.className = 'edit-only';
      addRow.style.cssText = 'margin-top:8px;';
      addRow.appendChild((() => {
        const el = document.createElement('div');
        el.innerHTML = sfFormFieldAddFormHtml();
        return el;
      })());
      fieldsWrap.appendChild(addRow);
      wireSfTemplateFieldAddForm(addRow, t, fieldsWrap);

      wrap.appendChild(fieldsWrap);
    }
    list.appendChild(wrap);
  });
  applyLeadsSectionEditGating('submission_forms_creator', $('sfSection-creator'));
}

// v100: same add-field markup/behavior as a form's own "+ Add field" row
// (sfFormFieldAddFormHtml/wireSfFormFieldAddForm), just appending onto a
// template's own fields jsonb array instead of inserting a
// lead_submission_form_fields row. The 3 reserved-key shortcut buttons
// still work here too — a template can include them like any other field,
// they just won't collide with a real column until actually applied to a
// form (sfApplyTemplate already skips duplicates by field_key there).
function wireSfTemplateFieldAddForm(container, template, fieldsWrapForRerender){
  container.querySelectorAll('.sf-form-field-reserved-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const newFields = (template.fields || []).slice();
      if(newFields.some(f2 => f2.field_key === btn.dataset.key)){ alert('This template already has that field.'); return; }
      newFields.push({ field_key: btn.dataset.key, label: btn.dataset.label, field_type: btn.dataset.type, required: btn.dataset.required === 'true', options: null });
      const err = await sfSaveTemplateFields(template, newFields);
      if(err){ alert(err); return; }
      renderSfFormsCreatorList();
      renderSfTemplatesList();
    });
  });
  const typeSelect = container.querySelector('.sf-form-field-type-select');
  const optionsRow = container.querySelector('.sf-form-field-options-row');
  typeSelect.addEventListener('change', () => {
    optionsRow.style.display = (typeSelect.value === 'select' || typeSelect.value === 'multi') ? '' : 'none';
  });
  container.querySelector('.sf-form-field-add-btn').addEventListener('click', async () => {
    const labelInput = container.querySelector('.sf-form-field-label-input');
    const requiredInput = container.querySelector('.sf-form-field-required-input');
    const optionsInput = container.querySelector('.sf-form-field-options-input');
    const msg = container.querySelector('.sf-form-field-msg');
    const label = (labelInput.value || '').trim();
    msg.textContent = ''; msg.className = 'msg sf-form-field-msg';
    if(!label){ msg.textContent = 'Enter a label for the custom field.'; msg.className = 'msg sf-form-field-msg error'; return; }
    const existingKeys = new Set((template.fields || []).map(f => f.field_key));
    let key = slugifyFieldKey(label);
    if(!key || RESERVED_FIELD_KEYS.has(key)){
      msg.textContent = 'That label produces a reserved or empty field key — try a more specific label.';
      msg.className = 'msg sf-form-field-msg error';
      return;
    }
    let suffix = 1;
    while(existingKeys.has(key)) key = `${slugifyFieldKey(label)}_${++suffix}`;
    const fieldType = typeSelect.value;
    let options = null;
    if(fieldType === 'select' || fieldType === 'multi'){
      options = (optionsInput.value || '').split(',').map(s => s.trim()).filter(Boolean);
      if(!options.length){
        msg.textContent = 'Enter at least one choice, comma-separated.';
        msg.className = 'msg sf-form-field-msg error';
        return;
      }
    }
    const newFields = (template.fields || []).slice();
    newFields.push({ field_key: key, label, field_type: fieldType, required: requiredInput.checked, options });
    const err = await sfSaveTemplateFields(template, newFields);
    if(err){ msg.textContent = err; msg.className = 'msg sf-form-field-msg error'; return; }
    logActivity('lead_submission_field_template.update', null, null, `Added field "${label}" to template "${template.name}"`);
    renderSfFormsCreatorList();
    renderSfTemplatesList();
  });
}

// renderSfFormRolesList above (empty allow-list = everyone), just against
// lead_submission_form_agents/sfFormAgentsCache instead of the role-level
// table, and listing people (sfAllAgentProfiles) instead of role names.
function renderSfFormAgentsList(f, container){
  const allowed = sfFormAgentsCache[f.id] || new Set();
  if(!sfAllAgentProfiles.length){
    container.innerHTML = '<span class="empty" style="font-size:11px;">No agents to list yet.</span>';
    return;
  }
  container.innerHTML = sfAllAgentProfiles.map(a => `
    <label class="edit-only" style="display:flex; align-items:center; gap:6px; cursor:pointer; text-transform:none; font-family:var(--sans); font-size:12px; color:var(--text-2); letter-spacing:0;">
      <input type="checkbox" class="sf-form-agent-cb" data-user-id="${a.id}" ${allowed.has(a.id) ? 'checked' : ''} style="width:13px; height:13px; accent-color:var(--focus);"> ${escapeHtml(a.full_name || a.email)}
    </label>
  `).join('');
  container.querySelectorAll('.sf-form-agent-cb').forEach(cb => {
    cb.addEventListener('change', async () => {
      const userId = cb.dataset.userId;
      const agentLabel = (sfAllAgentProfiles.find(a => a.id === userId) || {}).full_name || userId;
      if(cb.checked){
        const { error } = await sb.from('lead_submission_form_agents').insert({ form_id: f.id, user_id: userId });
        if(error){ alert(error.message); cb.checked = false; return; }
        logActivity('lead_submission_form.update', null, null, `Made submission form "${f.name}" visible to agent "${agentLabel}"`);
      } else {
        await sb.from('lead_submission_form_agents').delete().eq('form_id', f.id).eq('user_id', userId);
        logActivity('lead_submission_form.update', null, null, `Removed agent "${agentLabel}" from submission form "${f.name}"'s allow-list`);
      }
      await loadSfFormsAndFields();
      renderFillFormOptions(); renderFillFields();
    });
  });
  applyLeadsSectionEditGating('submission_forms_creator', $('sfSection-creator'));
}

// ----- Lead Submission: pick a form, fill it in, submit -----
// Plain-English description of what a field expects — shown as a small
// caption under the field itself (so the criteria is visible BEFORE
// submitting, not just after a failed attempt) and reused to build the
// "here's exactly what's missing" list if submission is blocked.
// v197: any plain-text field labeled "Campaign Name" (case/whitespace-
// insensitive — the same convention leadsCampaignNameFor()/the Ticket
// Accept modal already use to find this field by LABEL, not a fixed key,
// since it's an ordinary Submission Forms Creator field on any form, not
// one of the fixed RESERVED_FIELD_KEYS columns) gets a searchable
// autocomplete instead of a bare input. This is a rendering-only check —
// no field_type/schema change, so a form's field row is untouched and
// nothing here can be reset by re-running schema.sql.
function isCampaignNameField(f){
  return f.field_type === 'text' && csubNormalizeLabel(f.label) === csubNormalizeLabel('Campaign Name');
}

function fillFieldCriteriaText(f){
  if(f.field_type === 'select') return `Choose one: ${(f.options || []).join(', ')}`;
  if(f.field_type === 'multi') return `Select at least one: ${(f.options || []).join(', ')}`;
  if(f.field_type === 'tel') return 'Phone number';
  if(f.field_type === 'number') return 'Number';
  if(f.field_type === 'textarea') return 'Free text';
  if(isCampaignNameField(f)) return 'Must be an existing campaign — search and pick one';
  return f.placeholder ? `e.g. ${f.placeholder}` : 'Free text';
}

function fillFieldInputHtml(f){
  const req = f.required ? ' *' : '';
  const labelHtml = `<label style="display:block; font-size:11px; color:var(--text-dim); margin-bottom:4px;">${escapeHtml(f.label)}${req}</label>`;
  const criteriaHtml = `<div style="font-size:10px; color:var(--text-dim); margin-top:3px;">${escapeHtml(fillFieldCriteriaText(f))}</div>`;
  if(f.field_type === 'select'){
    const opts = (f.options || []).map(o => `<option value="${escapeHtml(o)}">${escapeHtml(o)}</option>`).join('');
    return `${labelHtml}<select data-field-key="${f.field_key}" data-required="${f.required ? '1' : ''}" data-field-label="${escapeHtml(f.label)}"><option value="">—</option>${opts}</select>${criteriaHtml}`;
  }
  if(f.field_type === 'textarea'){
    return `${labelHtml}<textarea rows="2" data-field-key="${f.field_key}" data-required="${f.required ? '1' : ''}" data-field-label="${escapeHtml(f.label)}" placeholder="${escapeHtml(f.placeholder || '')}"></textarea>`;
  }
  if(f.field_type === 'multi'){
    const boxes = (f.options || []).map(o => `
      <label style="display:flex; align-items:center; gap:6px; text-transform:none; font-weight:400; font-size:12px; margin:2px 0; cursor:pointer;">
        <input type="checkbox" value="${escapeHtml(o)}" style="width:auto;"> ${escapeHtml(o)}
      </label>`).join('');
    return `${labelHtml}<div data-field-key="${f.field_key}" data-field-type="multi" data-required="${f.required ? '1' : ''}" data-field-label="${escapeHtml(f.label)}" style="border:1px solid var(--border-light); border-radius:8px; padding:8px 10px; max-height:160px; overflow-y:auto; background:var(--inset);">${boxes}</div>`;
  }
  if(isCampaignNameField(f)){
    return `${labelHtml}<div class="searchable-select">
      <input type="text" data-field-key="${f.field_key}" data-required="${f.required ? '1' : ''}" data-field-label="${escapeHtml(f.label)}" data-campaign-autocomplete="1" autocomplete="off" placeholder="${escapeHtml(f.placeholder || 'Search campaigns…')}">
      <div class="searchable-select-list" data-campaign-list-for="${escapeHtml(f.field_key)}"></div>
    </div>${criteriaHtml}`;
  }
  const inputType = f.field_type === 'tel' ? 'tel' : f.field_type === 'number' ? 'number' : 'text';
  return `${labelHtml}<input type="${inputType}" data-field-key="${f.field_key}" data-required="${f.required ? '1' : ''}" data-field-label="${escapeHtml(f.label)}" placeholder="${escapeHtml(f.placeholder || '')}">${criteriaHtml}`;
}

// v197: wires up every "Campaign Name" autocomplete input rendered inside
// `container` (there's normally just one, but this handles more than one
// form field matching by label without assuming that). Fetched fresh each
// call — small dataset, and keeps the list honest if a campaign was just
// renamed/added under Submission Forms Creator earlier in the same
// session. Excludes the "Ticket" form itself, same convention as
// openTicketAcceptModal's campaign list — a ticket isn't a real campaign
// an agent could pick here either. Still free text underneath (the input
// itself, not a hidden select) — picking a suggestion just fills the
// text, it doesn't lock the value to only-existing campaigns, since a
// ticket can legitimately be a guess at a campaign that isn't set up yet.
// BUG FIX (2026-08-14, user request): used to allow typing an arbitrary
// campaign name here -- a ticket could get submitted against a campaign
// name that didn't actually exist, which nothing downstream could ever
// match to a real client/form. Now the input still supports typing to
// filter suggestions, but the value has to land on one of the real,
// existing campaign names to be accepted -- enforced both here
// (input.dataset.campaignValidNames, read by the submit handlers below via
// campaignNameFieldIsValid()) and via each submit button's own validation.
async function wireCampaignNameAutocompletes(container){
  const inputs = Array.from(container.querySelectorAll('input[data-campaign-autocomplete="1"]'));
  if(!inputs.length) return;
  const { data } = await sb.from('lead_submission_forms').select('name, is_active').eq('is_active', true).order('name');
  const names = (data || []).filter(f => f.name !== 'Ticket').map(f => f.name);
  inputs.forEach(input => {
    const list = container.querySelector(`[data-campaign-list-for="${CSS.escape(input.dataset.fieldKey)}"]`);
    if(!list) return;
    // Stashed on the input itself (not a shared/global var) so each
    // rendered field carries its own valid-names list, and the submit
    // handlers can read it straight off the element they already have.
    input.dataset.campaignValidNames = JSON.stringify(names);
    function renderList(filterText){
      const q = (filterText || '').trim().toLowerCase();
      const matches = q ? names.filter(n => n.toLowerCase().includes(q)) : names;
      list.innerHTML = matches.length
        ? matches.map(n => `<div class="searchable-select-option" data-value="${escapeHtml(n)}">${escapeHtml(n)}</div>`).join('')
        : `<div class="searchable-select-option empty">No matching campaigns.</div>`;
      list.querySelectorAll('.searchable-select-option[data-value]').forEach(el => {
        el.addEventListener('mousedown', (e) => {
          // mousedown (not click) fires before the input's blur, so the
          // list is still open/readable when the option is chosen —
          // same trick initSearchableSelect uses.
          e.preventDefault();
          input.value = el.dataset.value;
          list.classList.remove('show');
        });
      });
    }
    input.addEventListener('input', () => { renderList(input.value); list.classList.add('show'); });
    input.addEventListener('focus', () => { renderList(input.value); list.classList.add('show'); });
    input.addEventListener('blur', () => { setTimeout(() => list.classList.remove('show'), 120); });
  });
}
// Exact (case-insensitive) match against the input's own stashed valid-
// names list -- used by both submit handlers below so a typo or a made-up
// name blocks submission instead of silently going through as free text.
function campaignNameFieldIsValid(el){
  const names = JSON.parse(el.dataset.campaignValidNames || '[]');
  const v = el.value.trim().toLowerCase();
  return names.some(n => n.toLowerCase() === v);
}

function renderFillFormOptions(){
  const sel = $('lfFillFormSelect');
  const prev = sel.value;
  // v84: active AND (no role restriction, OR my own role is on the list) —
  // sfFormVisibleToMe() also always lets Owner/Admin through regardless.
  const visible = sfAllForms.filter(f => f.is_active && sfFormVisibleToMe(f.id));
  sel.innerHTML = '<option value="">Select a form…</option>' + visible.map(f => `<option value="${f.id}">${escapeHtml(f.name)}</option>`).join('');
  if(visible.some(f => f.id === prev)) sel.value = prev;
}
$('lfFillFormSelect').addEventListener('change', renderFillFields);

let sfFillFieldDefByKey = {}; // field_key -> its full def, for whatever form is currently rendered — read back when building error messages
function renderFillFields(){
  const sel = $('lfFillFormSelect');
  const container = $('lfFillFields');
  const formId = sel.value;
  const fields = (sfFormFieldsCache[formId] || []).slice().sort((a, b) => a.sort_order - b.sort_order);
  sfFillFieldDefByKey = {};
  fields.forEach(f => { sfFillFieldDefByKey[f.field_key] = f; });
  container.innerHTML = '';
  $('lfFillMsg').style.display = 'none';
  if(!formId){ container.innerHTML = '<div class="empty">Pick a form above to see its fields.</div>'; return; }
  if(!fields.length){ container.innerHTML = '<div class="empty">This form has no fields configured yet — an authorized role can add some under Submission Forms Creator.</div>'; return; }
  container.innerHTML = fields.map(f => `<div style="margin-bottom:12px;">${fillFieldInputHtml(f)}</div>`).join('');
  wireCampaignNameAutocompletes(container);
  // Only meaningful for PrimeHome Buyers -- that's the one channel this
  // whole duplicate-detection effort is about (see
  // findPrimeHomeBuyersDuplicate's own header comment). A form for some
  // other campaign has no matching data to check against, so skip it
  // entirely rather than showing a check that can never fire.
  if(formId === leadsPrimeHomeBuyersFormId){
    const phoneInput = container.querySelector('input[data-field-key="seller_phone"]');
    wireAddressAutocompleteAndDupCheck(container, {
      getPhoneNorm: () => (phoneInput ? phoneInput.value : '').replace(/\D/g, '').slice(-10),
      phoneInput,
    });
  }
  // Address autocomplete itself (as opposed to the iSpeedToLead-specific
  // duplicate check above) applies to every campaign's form, not just
  // PrimeHome Buyers -- wireAddressAutocompleteAndDupCheck already wired
  // PrimeHome Buyers' own form_address field above (flagged via
  // data-places-wired so this doesn't double-attach), so this only picks
  // up whatever other address-looking field the current form has.
  wireGenericAddressAutocomplete(container);
}

$('lfFillSubmitBtn').addEventListener('click', async () => {
  const msg = $('lfFillMsg');
  msg.style.display = 'none';
  msg.innerHTML = '';
  try {
    if($('lfFillSubmitBtn').disabled){
      msg.textContent = 'You don\u2019t have permission to submit through this form — see the note above the button.';
      msg.className = 'msg error'; msg.style.display = 'block';
      return;
    }
    const formId = $('lfFillFormSelect').value;
    if(!formId){ msg.textContent = 'Select a form first.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }
    const fieldEls = Array.from($('lfFillFields').querySelectorAll('[data-field-key]'));

    // Collect EVERY problem in one pass (not just the first) so a form
    // with several missing/invalid fields shows the whole list at once,
    // each with a plain-English explanation of what's actually expected —
    // reusing the exact same criteria text shown under each field.
    const problems = [];
    fieldEls.forEach(el => {
      if(!el.dataset.required) return;
      const f = sfFillFieldDefByKey[el.dataset.fieldKey] || { field_type: el.dataset.fieldType || 'text' };
      const label = el.dataset.fieldLabel || el.dataset.fieldKey;
      const criteria = fillFieldCriteriaText(f);
      if(el.dataset.fieldType === 'multi'){
        if(el.querySelectorAll('input[type="checkbox"]:checked').length === 0) problems.push(`"${label}" is required — ${criteria}.`);
      } else if(!el.value.trim()){
        problems.push(`"${label}" is required — ${criteria}.`);
      }
    });
    // BUG FIX (2026-08-14, user request): checked regardless of `required`
    // -- an optional Campaign Name field left blank is still fine, but one
    // with something typed in it has to match a real campaign, required
    // or not. Runs for every campaign-autocomplete input, not just the
    // ones already flagged above.
    fieldEls.forEach(el => {
      if(el.dataset.campaignAutocomplete !== '1' || !el.value.trim()) return;
      if(!campaignNameFieldIsValid(el)){
        const label = el.dataset.fieldLabel || el.dataset.fieldKey;
        problems.push(`"${label}" must be an existing campaign — pick one from the list instead of typing a new name.`);
      }
    });
    if(problems.length){
      msg.innerHTML = `<div style="margin-bottom:4px; color:var(--danger);">Fix ${problems.length === 1 ? 'this' : `these ${problems.length}`} before submitting:</div><ul style="margin:0; padding-left:18px; color:var(--danger);">${problems.map(p => `<li>${escapeHtml(p)}</li>`).join('')}</ul>`;
      msg.className = 'msg';
      msg.style.display = 'block';
      return;
    }

    let count = 1, sellerInvestor = '', sellerPhone = '';
    const extraFields = {};
    fieldEls.forEach(el => {
      const key = el.dataset.fieldKey;
      const value = el.dataset.fieldType === 'multi'
        ? Array.from(el.querySelectorAll('input[type="checkbox"]:checked')).map(cb => cb.value).join('\n')
        : el.value.trim();
      if(key === 'count'){ const n = parseInt(value, 10); if(n > 0) count = n; }
      else if(key === 'seller_investor_name') sellerInvestor = value;
      else if(key === 'seller_phone') sellerPhone = value;
      else if(value) extraFields[key] = value;
    });
    const { data: { user }, error: userErr } = await sb.auth.getUser();
    if(userErr || !user){ msg.textContent = 'Not signed in — refresh the page and sign in again.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }
    // BUG FIX (user request, 2026-09): submitting to PrimeHome Buyers had no
    // duplicate check at all — an agent resubmitting the same property (same
    // phone or address) created a brand-new lead row every time, which is
    // exactly the "true duplicate" pattern the 2026-09 backfill had to clean
    // up after the fact. An address match is hard-blocked here, no override,
    // same as the CSV/Excel import path enforces.
    // BUG FIX (user question, 2026-09-04): a phone-only match (address is
    // new/different) is NOT hard-blocked — see findPrimeHomeBuyersDuplicate's
    // own comment for why (a seller's second property in a different city/
    // state is a real, separate lead, not a duplicate). Instead it's a
    // confirm-to-override warning that shows the OTHER lead's address, so
    // whoever's submitting can tell in one glance whether this is genuinely
    // the same property (Cancel) or a different one (OK, proceed).
    if(formId === leadsPrimeHomeBuyersFormId){
      const phoneNorm = (sellerPhone || '').replace(/\D/g, '').slice(-10);
      const dup = await findPrimeHomeBuyersDuplicate(phoneNorm, extraFields.form_address);
      if(dup && dup.matched_via === 'address'){
        msg.textContent = `Not submitted — this looks like a duplicate. A PrimeHome Buyers lead for this exact address already exists (status: ${dup.status}, submitted ${new Date(dup.submitted_at).toLocaleDateString()}).`;
        msg.className = 'msg error'; msg.style.display = 'block';
        return;
      }
      if(dup && dup.matched_via === 'phone'){
        const priorAddress = (dup.extra_fields || {}).form_address || 'no address on file for that one';
        const proceed = confirm(`This phone number already has a PrimeHome Buyers lead on file for a DIFFERENT address:\n\n${priorAddress}\n(status: ${dup.status}, submitted ${new Date(dup.submitted_at).toLocaleDateString()})\n\nIf this is genuinely a different property, click OK to submit anyway. If it's the same property, click Cancel.`);
        if(!proceed){
          msg.textContent = 'Not submitted.';
          msg.className = 'msg error'; msg.style.display = 'block';
          return;
        }
      }
    }
    const { error } = await sb.from('leads').insert({
      user_id: user.id, submission_form_id: formId, count,
      seller_investor_name: sellerInvestor || null,
      seller_phone: sellerPhone || null,
      extra_fields: Object.keys(extraFields).length ? extraFields : null,
    });
    if(error){
      // Surface the real database error rather than failing silently —
      // most likely cause here is an RLS denial (role isn't actually
      // allowed to insert leads).
      msg.textContent = `Couldn't submit: ${error.message}`;
      msg.className = 'msg error'; msg.style.display = 'block';
      return;
    }
    fieldEls.forEach(el => {
      if(el.dataset.fieldType === 'multi') el.querySelectorAll('input[type="checkbox"]').forEach(cb => { cb.checked = false; });
      else el.value = '';
    });
    msg.textContent = 'Lead submitted.'; msg.className = 'msg'; msg.style.display = 'block';
    const formLabel = $('lfFillFormSelect').selectedOptions[0] ? $('lfFillFormSelect').selectedOptions[0].textContent : formId;
    logActivity('lead.create', 'lead', null, `Submitted a lead via the dashboard — form: ${formLabel}`);
  } catch(e){
    // Belt-and-suspenders: whatever this is, show it instead of the
    // button silently doing nothing.
    msg.textContent = `Something went wrong: ${e && e.message ? e.message : e}`;
    msg.className = 'msg error';
    msg.style.display = 'block';
  }
});

// ---------- v71: Leads Queue Review → PrimeHome Buyers → Upload CSV / Excel ----------
// Columns = Phone (+ Seller/Investor Name and Count, both "new leads only")
// plus every field from ISPEEDTOLEAD_FIELD_GROUPS — the SAME config the
// review modal and "Load PrimeHome Buyers field set" use, so a header
// matches either a field's human label or its raw form_* key. Unlike the
// agent/dashboard submission forms, record_link and ping_id ARE included
// here on purpose — this is precisely where those two get attached (see
// the ispdSection-upload card's own copy in the HTML).
const ISPD_UPLOAD_SPECIAL_COLUMNS = [
  { header: 'Phone', key: '__phone' },
  { header: 'Seller Name (new leads only)', key: '__seller_name' },
  { header: 'Count (new leads only)', key: '__count' },
];
function ispdUploadFieldColumns(){
  const cols = [];
  ISPEEDTOLEAD_FIELD_GROUPS.forEach(group => group.fields.forEach(f => cols.push({ header: f.label, key: f.key })));
  return cols;
}
function ispdAllUploadColumns(){ return [...ISPD_UPLOAD_SPECIAL_COLUMNS, ...ispdUploadFieldColumns()]; }

// ---------- v88: Upload CSV/Excel — default Campaign to the "PrimeHome
// Buyers" Submission Form (was: a task, v87) ----------
// Every lead created by this importer is, by definition, a PrimeHome
// Buyers lead — attributed to a real Submission Form literally named
// "PrimeHome Buyers" so it's mutually exclusive with every other campaign
// (see renderLeadsQueueTable/renderIspdReviewTable's exclusivity comments)
// and routes to the Queue Review — PrimeHome Buyers subtab automatically.
// v88 migrated this OFF `tasks` entirely — tasks is purely a time-tracking
// concept now, never a lead campaign (see the v88 changelog). If this is
// the very first CSV import on a fresh install, run
// supabase/v88b-primehome-buyers-form-migration.sql first (creates the
// form and backfills any leads still tagged via the old task-based v87
// system) — this resolver will also lazily create the form itself if it's
// somehow still missing, so nothing here is strictly blocked on that
// script, but existing task-tagged leads won't retroactively move over
// without it.
const ISPD_DEFAULT_CAMPAIGN_NAME = 'PrimeHome Buyers';
// v107: name of the seeded "Ticket" submission form (see
// supabase/v107-ticket-workflow.sql) — same "resolve by exact name"
// convention as ISPD_DEFAULT_CAMPAIGN_NAME above.
const TICKET_FORM_NAME = 'Ticket';
let ispdDefaultCampaignFormIdCache = null;
async function getIspdDefaultCampaignFormId(){
  if(ispdDefaultCampaignFormIdCache) return ispdDefaultCampaignFormIdCache;
  // leadsAllForms is already fetched by loadLeads() before this section
  // can even be reached — check it first, no extra round trip in the
  // common case where the campaign already exists.
  const cached = (leadsAllForms || []).find(f => f.name === ISPD_DEFAULT_CAMPAIGN_NAME);
  if(cached){ ispdDefaultCampaignFormIdCache = cached.id; return cached.id; }
  const { data: existing } = await sb.from('lead_submission_forms').select('id').eq('name', ISPD_DEFAULT_CAMPAIGN_NAME).limit(1).maybeSingle();
  if(existing){ ispdDefaultCampaignFormIdCache = existing.id; return existing.id; }
  // Doesn't exist yet anywhere — create it once. Inserting into
  // lead_submission_forms requires is_admin() or (role_has_any_tab('leads')
  // and role_can_edit_tab('leads')) per RLS — for a non-admin importer
  // this only matters the very first time, before an Owner/Admin has ever
  // run the v88b migration SQL (which also creates this same form).
  const { data: created, error } = await sb.from('lead_submission_forms').insert({ name: ISPD_DEFAULT_CAMPAIGN_NAME }).select('id').maybeSingle();
  if(error || !created) return null;
  ispdDefaultCampaignFormIdCache = created.id;
  return created.id;
}

// ---------- v78: Upload CSV/Excel — auto-detect & convert raw call-intake exports ----------
// Recognizes a raw lead-capture export in the shape a Google Forms/Sheets-
// style call-intake sheet produces — Timestamp / Seller Name / Phone Number
// / Property Address / Condition / Occupancy / Asking Price / Market Value
// / Reason / Closing / Additional Notes / Email / Call Recording — and
// converts it in-browser to the exact template shape ispdAllUploadColumns()
// expects, BEFORE the normal column-matching logic below ever runs. So a
// raw intake export can be dropped straight into this file picker with no
// separate pre-processing step. Field-mapping rules mirror the standalone
// vi_to_primehome.py script this was ported from — tune the tables below
// (not the parsing logic around them) to change a mapping's behavior.
const ISPD_RAW_FORMAT_HEADERS = ['Timestamp', 'Seller Name', 'Phone Number', 'Property Address', 'Condition', 'Occupancy', 'Asking Price', 'Market Value', 'Reason', 'Closing', 'Additional Notes', 'Email', 'Call Recording'];
function ispdNormHeader(s){ return String(s || '').trim().toLowerCase().replace(/\s+/g, ' '); }
// v379: this used to require >= 8 of the 13 headers above, exact-match
// only. Real-world exports from this source don't always carry every
// column (no Timestamp/Reason/Closing/Additional Notes/Email/Call
// Recording — just the core Seller Name/Phone/Property Address/
// Condition/Occupancy/Asking Price/Market Value fields), and some label
// the phone column just "Phone" rather than "Phone Number" — either of
// those alone dropped this below the old threshold, so the file fell
// through to strict template-column matching instead and imported
// almost nothing (reported: "doesn't capture most of the fields").
// "Phone" now counts as this format's phone column too. This is still
// safe against ever misfiring on an actual template upload: the ONLY
// headers a real PrimeHome Buyers template can coincidentally share with
// this list after case-insensitive normalization are its own "Phone"
// special column, "Property address"/"Property Address", and "Email" (a
// real template field) — 3 possible matches at most, nowhere near the
// threshold below.
function ispdDetectRawFormat(headerRow){
  const norm = headerRow.map(ispdNormHeader);
  const hasPhoneColumn = norm.includes('phone number') || norm.includes('phone');
  const otherMatches = ISPD_RAW_FORMAT_HEADERS.filter(h => h !== 'Phone Number' && norm.includes(ispdNormHeader(h))).length;
  return otherMatches + (hasPhoneColumn ? 1 : 0) >= 6;
}

// form_owner has no signal anywhere in the raw export. Every row in this
// source shape is a homeowner cold-call (not a wholesaler list), so
// defaulting to "owner" is the accurate call here — but it's a default,
// not a detected fact, hence its own constant, easy to blank out below.
const ISPD_RAW_DEFAULT_OWNER = 'Yes, i own this property';
const ISPD_RAW_OCCUPANCY_MAP = { owner: 'Owner Occupied', rented: 'Tenant Occupied', vacant: 'No its Vacant' };
// Condition is free text with no reliable "how much work" signal beyond
// adjectives — order matters, first match wins: explicit heavy-repair
// language > explicit light-repair language > "good/fine" language
// (mapped to the closest available option, meaning "doesn't need work")
// > no match (left blank rather than guessed).
const ISPD_RAW_REPAIRS_RULES = [
  [['total rehab', 'major repair', 'full repair', 'gut', 'alot of work', 'a lot of work'], 'Full Gut Renovation - Everything'],
  [['some repair', 'minor repair', 'need repair', 'needs repair', 'need some work', 'needs some work', 'needs work', 'fair condition', 'fair codnition', 'some repars', 'needs total rehab'], 'Remodel - Kitchen, Bathroom, Roof'],
  [['cosmetic', 'needs to be cleand', 'needs a new paint'], 'Cosmetic - Flooring, Paint'],
  [['good condition', 'good shape', 'good nothing major', 'no need to repair', "it's a good condition", 'in a good shape', 'goood', 'good'], 'Fully renovated and updated in past 2 years'],
];
// "Reason" is the messiest source column. Keyword rules cover the common
// cases; anything matching nothing falls back to PrimeHome Buyers' own
// "Other personal reason" option (a real choice, not a hidden default) —
// the full original text always also lands in "Reason for selling — in
// their own words" verbatim regardless of which bucket (if any) matched.
const ISPD_RAW_GOAL_RULES = [
  [['preforeclos', 'foreclos'], 'Preforeclosure'],
  [['behind on tax', 'behind on mortgage', 'back taxes'], 'Behind on taxes/mortgage'],
  [['emergency'], 'Emergency Reasons'],
  [['financial'], 'Financial Reasons'],
  [['vacant'], 'Selling a vacant/non-occupied property'],
  [['rent instead', 'sell and rent'], 'Sell and rent instead'],
  [['death', 'passed away', 'she passed', 'he passed', 'deceased'], 'Death in the family'],
  [['without showing'], 'Sell without showings'],
  [['inherit'], 'Inherited Property'],
  [['downsiz'], 'Downsizing'],
  [['tired of being', 'landlord'], 'Tired of being a landlord'],
  [['closer to family', 'close to family'], 'Moving closer to family'],
  [['relocat', 'moving out', 'moving'], 'Relocating'],
  [['retire', 'retirment', 'retirement'], 'Retirement elsewhere'],
  [['upsiz', 'upgrad'], 'Upgrading'],
  [['leaving the us', 'leaving the country', 'moving from the us'], 'Moving from United States'],
  [['old age', 'elder', 'getting old'], 'Old age'],
  [['divorce'], 'Divorce'],
  [['health', 'medical'], 'Health issues'],
  [['job loss', 'lost job', 'laid off'], 'Job loss'],
];
const ISPD_RAW_GOAL_FALLBACK = 'Other personal reason';

function ispdRawMapSellFast(raw){
  const s = String(raw || '').trim().toLowerCase();
  if(!s) return '';
  if(/asap|today|immediat/.test(s)) return 'ASAP';
  const m = s.match(/(\d+(?:\.\d+)?)\s*(day|week|month)/);
  if(m){
    const n = parseFloat(m[1]); const unit = m[2];
    const months = unit === 'day' ? n / 30 : (unit === 'week' ? n / 4.33 : n);
    if(months <= 1.4) return '1 month';
    if(months <= 3.5) return '2-3 months';
    if(months <= 5.5) return '4-5 months';
    return '6+ months';
  }
  return ''; // e.g. "moving", "after march 15th" — not a timeframe, left blank
}
// Best-effort extraction of listing status from the free-text Additional
// Notes blob, which usually contains a line like "listed:not listed" or
// "Listing Status:Off market".
function ispdRawMapListed(notes){
  const m = String(notes || '').match(/listed\s*[:\-]?\s*([^\n]{0,40})/i);
  if(!m) return '';
  const val = m[1].toLowerCase();
  if(/bed|condition|sqft|bath/.test(val)) return ''; // regex caught the wrong line — don't guess
  if(/not|off market|off/.test(val) || val.trim() === 'no') return "No it's not listed";
  if(/yes|active|on market|currently listed/.test(val)) return "Yes it's listed";
  return '';
}
function ispdRawMapRepairs(condition){
  const s = String(condition || '').trim().toLowerCase();
  for(const [keywords, value] of ISPD_RAW_REPAIRS_RULES) if(keywords.some(k => s.includes(k))) return value;
  return '';
}
function ispdRawMapGoal(reason){
  const s = String(reason || '').trim().toLowerCase();
  if(!s || s === 'n/a' || s === 'na' || s === 'refused to disclose') return '';
  for(const [keywords, value] of ISPD_RAW_GOAL_RULES) if(keywords.some(k => s.includes(k))) return value;
  return ISPD_RAW_GOAL_FALLBACK;
}
// Returns { street, city, state, zip, ok }. ok=false means the raw string
// didn't cleanly parse (multiple addresses pasted into one cell, missing
// comma, truncated zip, etc.) — street gets the whole raw string so
// nothing's lost; city/state/zip stay blank rather than guessed.
function ispdRawParseAddress(raw){
  const re = /^(.+?),\s*([A-Za-z .'-]+?),\s*([A-Z]{2})\s*(\d{5})?\s*$/;
  let a = String(raw || '').trim().replace(/^"+|"+$/g, '').trim();
  if(a.includes('\n')){
    const firstLine = a.split('\n').map(x => x.trim()).filter(Boolean)[0] || a;
    const m = firstLine.match(re);
    if(m) return { street: m[1], city: m[2], state: m[3], zip: m[4] || '', ok: false };
    return { street: a, city: '', state: '', zip: '', ok: false };
  }
  const m = a.match(re);
  if(m) return { street: m[1], city: m[2], state: m[3], zip: m[4] || '', ok: true };
  return { street: a, city: '', state: '', zip: '', ok: false };
}
// v567: one Property Address cell carrying MORE THAN ONE address — a
// caller logging two neighbouring properties in a single row. Seen live on
// three leads:
//   "8912 Centergrove Ln, Charlotte, NC 28214 //8924 Centergrove Ln"
//   "3575 Landis St, Winston Salem, NC 27107 //  3595 Landis St, ...,,,,"
//   "4936 Lakeview Rd, Charlotte, NC 28216,,,4940 Lakeview Rd Charlotte..."
//
// Left alone these are quietly corrosive: the whole string lands in
// form_address, ispdRawParseAddress can't match its city/state/zip regex
// (it anchors on the string ENDING at state+zip), so those fields come out
// blank — and because address is now the dedupe key, the mangled string
// never matches anything, so every future import of the same row looks
// like a brand-new property.
//
// Separators are deliberately narrow: "//", ";", " | ", or a run of 3+
// commas. All are punctuation nobody puts inside a single real address, so
// a legitimately long address is never split.
const ISPD_MULTI_ADDR_SEP_RE = /\s*(?:\/{2,}|;|\s\|\s|,{3,})\s*/;
function ispdSplitMultiAddress(raw){
  const s = String(raw || '').trim();
  if(!s) return [];
  return s.split(ISPD_MULTI_ADDR_SEP_RE)
    .map(x => x.replace(/^[\s,]+|[\s,]+$/g, '').trim())
    .filter(Boolean);
}
function ispdRawNormalizePhone(raw){ return String(raw || '').replace(/\s*\[dnc\]\s*/ig, '').trim(); }
function ispdRawIsDnc(raw){ return /\[dnc\]/i.test(String(raw || '')); }
// Detects the one known source-export corruption pattern seen in this
// format: a timestamp bleeding into the Seller Name column (and
// everything after it shifted by one) from a quoting break earlier in
// that row at the export's own source — not something this parser causes.
function ispdRawLooksShifted(sellerNameCell){ return /^\d{1,2}\/\d{1,2}\/\d{4}/.test(String(sellerNameCell || '').trim()); }

// Converts raw-format rows into template-shaped rows (a header array +
// a 2D data array matching TEMPLATE order), so the existing column-
// matching pipeline right below needs no changes at all — it just sees
// what looks like an already-correctly-headered upload. Returns
// { headerRow, dataRows, summary }; summary drives the info message
// shown above the preview.
function ispdConvertRawImport(headerRow, dataRows){
  const norm = headerRow.map(ispdNormHeader);
  const idx = (label) => norm.indexOf(ispdNormHeader(label));
  // v379: "Phone Number" is the full raw-export header, but some sources
  // (and the shorter, still-detected variant — see ispdDetectRawFormat's
  // v379 comment) just call it "Phone" — fall back to that so the phone
  // number actually makes it into the converted row instead of coming
  // out blank.
  const iPhone = idx('Phone Number') >= 0 ? idx('Phone Number') : idx('Phone');
  const iName = idx('Seller Name'), iAddr = idx('Property Address'),
        iCond = idx('Condition'), iOcc = idx('Occupancy'), iAsk = idx('Asking Price'),
        iMkt = idx('Market Value'), iReason = idx('Reason'), iClose = idx('Closing'),
        iNotes = idx('Additional Notes'), iEmail = idx('Email'), iRec = idx('Call Recording');

  const templateHeader = ispdAllUploadColumns().map(c => c.header);
  const outRows = [];
  let dncCount = 0, corruptCount = 0;

  dataRows.forEach(r => {
    const cell = (i) => i >= 0 ? String(r[i] || '').trim() : '';
    const sellerName = cell(iName), phoneRaw = cell(iPhone);

    if(ispdRawLooksShifted(sellerName)){ corruptCount++; return; } // column-shifted source row — can't safely use, skip
    if(ispdRawIsDnc(phoneRaw)){ dncCount++; return; } // never submit a [DNC]-tagged number

    const phone = ispdRawNormalizePhone(phoneRaw);
    const addr = ispdRawParseAddress(cell(iAddr));
    const condition = cell(iCond), occupancy = cell(iOcc), reason = cell(iReason),
          closing = cell(iClose), notes = cell(iNotes), email = cell(iEmail),
          askingPrice = cell(iAsk), marketValue = cell(iMkt), recordingRaw = cell(iRec);

    const repairs = ispdRawMapRepairs(condition);
    const occupied = ISPD_RAW_OCCUPANCY_MAP[occupancy.toLowerCase()] || '';
    const sellFast = ispdRawMapSellFast(closing);
    const goal = ispdRawMapGoal(reason);
    const listed = ispdRawMapListed(notes);

    // v: the raw import no longer fills in "Call recording link" (user
    // request, 2026-09-08). It used to take the first URL out of the
    // source's Call Recording column and put it straight into record_link.
    //
    // Deliberately NOT destructive: every link found is still written into
    // Conversation notes, so nothing from the source file is lost and the
    // recording can be attached by hand during the per-lead review step --
    // the same step that already exists for the fields this converter
    // leaves blank on purpose (Ping ID, Years owned, Type of house).
    //
    // Worth knowing: gyhomes' field 120 is a REQUIRED call-recording
    // upload, so an imported lead now has no recording until someone adds
    // one, and "Send to gyhomes" will refuse it until they do. That is the
    // intended trade -- an imported link nobody has checked is worse than
    // an obviously-empty field -- but it is why the count of gyhomes-ready
    // imported leads will drop.
    const recLinks = recordingRaw.split(/[,\s]+/).map(u => u.trim()).filter(u => u.startsWith('http'));
    const recordLink = '';
    const extraLinksNote = recLinks.length ? `Recording link(s) from the import file: ${recLinks.join(', ')}\n\n` : '';

    const emailClean = ['n/a', 'na', ''].includes(email.toLowerCase()) ? '' : email;

    let pricePrefix = '';
    if(askingPrice && !['n/a', 'na'].includes(askingPrice.toLowerCase())) pricePrefix += `Asking Price: ${askingPrice}\n`;
    if(marketValue && !['n/a', 'na'].includes(marketValue.toLowerCase())) pricePrefix += `Market Value: ${marketValue}\n`;
    const conversationNotes = `${pricePrefix}${extraLinksNote}${notes}`.trim();

    // Type of house / Square footage / Year / Garage / Bedrooms /
    // Bathrooms / Years owned / Ping ID: no reliable signal anywhere in
    // this source shape — left blank on purpose rather than guessed.
    // They'll show as "⚠ missing" in the preview below and again in
    // each lead's PrimeHome Buyers review modal, same as any other
    // incomplete row — that per-lead review step is the intended place
    // to fill them in, not something to fake here.
    const byHeader = {
      'Phone': phone,
      'Seller Name (new leads only)': sellerName,
      'Count (new leads only)': '1',
      'Email': emailClean,
      'Property address': addr.street, 'City': addr.city, 'State': addr.state, 'ZIP code': addr.zip,
      'Repairs needed': repairs,
      'Occupied': occupied,
      'When do they want to sell': sellFast,
      'Why they want to sell': goal,
      'Reason for selling — in their own words': reason,
      'Owner or agent/wholesaler': ISPD_RAW_DEFAULT_OWNER,
      'Currently listed with an agent': listed,
      'Conversation notes': conversationNotes,
      'Call recording link': recordLink,
    };
    outRows.push(templateHeader.map(h => (byHeader[h] != null ? byHeader[h] : '')));
  });

  return {
    headerRow: templateHeader,
    dataRows: outRows,
    summary: { sourceRows: dataRows.length, converted: outRows.length, dncExcluded: dncCount, corruptExcluded: corruptCount },
  };
}

$('ispdDownloadTemplateBtn').addEventListener('click', () => {
  if(!(myIsOwner || myRole === 'admin')) return; // v96 item 4
  const headerRow = ispdAllUploadColumns().map(c => c.header);
  const csv = headerRow.map(h => `"${h.replace(/"/g, '""')}"`).join(',') + '\n';
  const blob = new Blob([csv], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'primehome-buyers-upload-template.csv';
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
});

let ispdParsedRows = [];
$('ispdUploadInput').addEventListener('change', async (e) => {
  const file = e.target.files[0];
  const msg = $('ispdUploadMsg');
  msg.style.display = 'none';
  $('ispdUploadPreviewWrap').style.display = 'none';
  if(!file) return;
  try {
    const buf = await file.arrayBuffer();
    await ensureXlsx();
    const wb = XLSX.read(buf, { type: 'array' });
    const sheet = wb.Sheets[wb.SheetNames[0]];
    const rows = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '', raw: false });
    if(!rows.length){ msg.textContent = 'That file has no rows.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }
    let headerRow = rows[0].map(h => String(h || '').trim());
    let dataRows = rows.slice(1).filter(r => r.some(c => String(c || '').trim() !== ''));
    if(!dataRows.length){ msg.textContent = 'No data rows found below the header.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }

    // v78: a raw call-intake export (Timestamp/Seller Name/Phone Number/
    // Property Address/Condition/Occupancy/.../Call Recording) gets
    // auto-converted to the template shape right here — everything below
    // this block runs exactly as it always has, now against the
    // converted rows instead of the file's own.
    let rawImportSummary = null;
    if(ispdDetectRawFormat(headerRow)){
      const converted = ispdConvertRawImport(headerRow, dataRows);
      headerRow = converted.headerRow;
      dataRows = converted.dataRows;
      rawImportSummary = converted.summary;
      if(!dataRows.length){
        msg.textContent = `Detected a raw call-intake export, but every row was excluded (${converted.dncExcluded} DNC-tagged, ${converted.corruptExcluded} corrupted/unreadable) — nothing to import.`;
        msg.className = 'msg error'; msg.style.display = 'block';
        return;
      }
    }

    const allCols = ispdAllUploadColumns();
    // Match each header cell to a known column by its human label OR its
    // raw form_* key (case/space-insensitive) — so both a downloaded
    // template and a hand-typed key-style header work.
    const norm = s => String(s || '').trim().toLowerCase().replace(/\s+/g, ' ');
    const colByHeaderIndex = headerRow.map(h => allCols.find(c => norm(c.header) === norm(h) || norm(c.key) === norm(h)) || null);

    if(!colByHeaderIndex.some(c => c && c.key === '__phone')){
      msg.textContent = 'No "Phone" column found — required to match or create leads.';
      msg.className = 'msg error'; msg.style.display = 'block';
      return;
    }

    const parsed = dataRows.map(r => {
      const cells = {};
      colByHeaderIndex.forEach((c, i) => { if(c) cells[c.key] = String(r[i] || '').trim(); });
      return { __cells: cells, phoneNorm: (cells.__phone || '').replace(/\D/g, '').slice(-10) };
    }).filter(r => r.phoneNorm); // no usable phone → can't match or safely create — skip

    if(!parsed.length){ msg.textContent = 'No rows had a usable phone number.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }

    const phones = [...new Set(parsed.map(r => r.phoneNorm))];
    const { data: existingLeads } = await sb.from('leads').select('id, seller_phone_norm, submitted_at')
      .in('seller_phone_norm', phones).order('submitted_at', { ascending: false });
    const latestByPhone = {};
    (existingLeads || []).forEach(l => { if(!latestByPhone[l.seller_phone_norm]) latestByPhone[l.seller_phone_norm] = l; });

    const requiredKeys = ISPEEDTOLEAD_FIELD_GROUPS.flatMap(g => g.fields).filter(f => f.required).map(f => f.key);

    // v565 (user request, 2026-09-09): THE PROPERTY ADDRESS IS THE LEAD'S
    // IDENTITY — not the phone number.
    //
    // Phone was the primary match key until now, which is wrong for this
    // business: one owner routinely has several properties, so the same
    // phone legitimately belongs to several DIFFERENT leads. Matching on it
    // meant the second and third property an owner called about were
    // treated as duplicates of the first and silently dropped — real leads
    // lost, with nothing in the summary to say so.
    //
    // Address is now the primary key. Phone survives only as a fallback for
    // a row that carries no address at all, where there is nothing else to
    // compare and creating blindly risks a genuine duplicate.
    //
    // Matching is on a normalized key (lowercased, non-alphanumerics
    // stripped) rather than the raw string the old code compared, so
    // "123 Main St." / "123 main st" / "123  Main  St" are one property
    // instead of three.
    // v571: the key is street + CITY, not street alone.
    //
    // Street-only collides on common names: live there are two separate
    // leads at "40 High St" — one in Shrewsbury MA, one in Amsterdam NY.
    // Different states, different properties, identical key. Street-only
    // would silently drop one as a duplicate, and "Main St" / "Oak St"
    // guarantee more of these as markets are added.
    //
    // Safe to tighten: of 2,309 PrimeHome leads with an address, 2,296
    // carry a city, and NO street key currently has a mix of rows with and
    // without one — so no existing property splits into two keys. Zip is
    // the fallback, then street-only for the 13 rows that have neither
    // (a possible collision beats treating every city-less row as unique).
    const ispdAddrKey = (street, city, zip) => {
      const n = (v) => String(v || '').toLowerCase().replace(/[^a-z0-9]/g, '');
      const st = n(street);
      if(!st) return '';
      const loc = n(city) || n(zip);
      return loc ? `${st}|${loc}` : st;
    };

    // One fetch of every PrimeHome Buyers lead that has an address, so the
    // comparison can be done on normalized keys client-side. An exact-string
    // `.in()` (what this used to do) cannot match across formatting
    // differences, which is precisely where duplicates slipped through.
    // BUG FIX (2026-09-09, caught live after it did real damage): this block
    // used to be gated on `leadsPrimeHomeBuyersFormId` and, when that was
    // null or the fetch errored, simply carried on with an EMPTY map — so
    // every row looked new and the whole file imported as duplicates. Two
    // consecutive uploads created 341 leads each, 682 duplicates, because
    // that module-level variable is only ever set inside loadLeads(). The
    // campaign tagging right below never had the problem: it calls
    // getIspdDefaultCampaignFormId(), which falls back to its own query.
    // Hence the tell-tale signature — every duplicate correctly tagged.
    //
    // Two changes. Resolve the id the robust way, and FAIL CLOSED: if the
    // dedupe set cannot be built for any reason, refuse to import at all.
    // An import that cannot deduplicate is worse than no import.
    const dedupeFormId = await getIspdDefaultCampaignFormId();
    const existingByAddrKey = {};
    let dedupeReady = false;
    if(dedupeFormId){
      const PAGE = 1000;
      let fetchOk = true;
      for(let from = 0; ; from += PAGE){
        // Deliberately the same plain select this has always used. Selecting
        // only the address via a jsonb path would be lighter, but that
        // syntax is unverified here and this block now fails CLOSED — an
        // untested select that errored would block every import instead of
        // just skipping dedupe. Payload was never the cause anyway
        // (~2,800 leads, 2.4MB total); the null form id was.
        const { data: addrLeads, error: addrErr } = await sb.from('leads')
          .select('id, extra_fields, status, submitted_at')
          .eq('submission_form_id', dedupeFormId)
          .order('submitted_at', { ascending: false })
          .range(from, from + PAGE - 1);
        if(addrErr){ console.error('address-dedupe fetch failed:', addrErr); fetchOk = false; break; }
        if(!addrLeads || !addrLeads.length) break;
        addrLeads.forEach(l => {
          const ef = l.extra_fields || {};
          const k = ispdAddrKey(ef.form_address, ef.form_city, ef.form_zip);
          if(k && !existingByAddrKey[k]) existingByAddrKey[k] = l;
        });
        if(addrLeads.length < PAGE) break;
      }
      dedupeReady = fetchOk;
    }
    if(!dedupeReady){
      msg.innerHTML = '<div><strong>Import blocked — the duplicate check could not run.</strong></div>'
        + '<div style="margin-top:6px;">Nothing was imported. Without it every row would be created as a new lead, even the ones already on file.</div>'
        + '<div style="margin-top:6px;">Open Leads Queue Review → PrimeHome Buyers once so the campaign loads, then try the upload again. If it keeps failing, check the browser console.</div>';
      msg.className = 'msg error';
      msg.style.display = 'block';
      $('ispdUploadPreviewWrap').style.display = 'none';
      ispdParsedRows = [];
      return;
    }

    // v567: split a multi-address cell BEFORE anything else reads the
    // address — dedupe, city/state parsing and the stored lead all need the
    // cleaned value. Applied here rather than inside ispdConvertRawImport so
    // it covers a hand-filled template upload too, not just raw exports.
    //
    // The extra addresses are moved into Conversation notes rather than
    // dropped: the row genuinely mentioned another property, and that is
    // worth a human deciding about. The preview flags the row so that
    // decision happens before import, not after.
    parsed.forEach(r => {
      const parts = ispdSplitMultiAddress(r.__cells.form_address);
      if(parts.length > 1){
        r.multiAddress = parts;
        // Re-parse the first address on its own. ispdRawParseAddress anchors
        // its regex on the string ENDING at "City, ST 12345", so a
        // multi-address cell never matched and left city/state/zip blank —
        // which is exactly the state the three live examples were found in.
        // Split apart, the first one parses normally.
        const one = ispdRawParseAddress(parts[0]);
        r.__cells.form_address = one.ok ? one.street : parts[0];
        if(one.ok){
          if(!r.__cells.form_city)  r.__cells.form_city  = one.city;
          if(!r.__cells.form_state) r.__cells.form_state = one.state;
          if(!r.__cells.form_zip && one.zip) r.__cells.form_zip = one.zip;
        }
        const note = `⚠ The source row listed ${parts.length} addresses in one cell. Imported as the first: "${parts[0]}". Also mentioned: ${parts.slice(1).join(' | ')}`;
        r.__cells.form_conversation_notes = r.__cells.form_conversation_notes
          ? `${note}\n\n${r.__cells.form_conversation_notes}`
          : note;
      }
    });

    parsed.forEach(r => {
      r.missing = requiredKeys.filter(k => !r.__cells[k]);
      r.addrKey = ispdAddrKey(r.__cells.form_address, r.__cells.form_city, r.__cells.form_zip);
      const addrHit = r.addrKey ? existingByAddrKey[r.addrKey] : null;
      if(addrHit){
        r.matchedLeadId = addrHit.id;
        r.matchedOn = 'address';
      } else if(!r.addrKey && latestByPhone[r.phoneNorm]){
        // No address on this row — fall back to phone so a row with nothing
        // to identify the property by cannot quietly create a duplicate.
        r.matchedLeadId = latestByPhone[r.phoneNorm].id;
        r.matchedOn = 'phone (row has no address)';
      } else {
        r.matchedLeadId = null;
        r.matchedOn = null;
      }
    });

    // Two rows in the SAME file for the same property: only the first can
    // create the lead. Without this the file duplicates against itself,
    // since nothing exists in the database to match the second against yet.
    const seenAddrKeys = new Set();
    parsed.forEach(r => {
      if(r.matchedLeadId || !r.addrKey) return;
      if(seenAddrKeys.has(r.addrKey)) r.duplicateInFile = true;
      else seenAddrKeys.add(r.addrKey);
    });

    // v561: a lead that has ALREADY been delivered to PrimeHome Buyers is
    // finished — re-importing the same source file must not touch it. The
    // fields on a delivered lead are the ones that were actually sent, so
    // silently overwriting them from a later export makes the record
    // disagree with what the buyer received, and there is no way to tell
    // afterwards which version went out. Skipped outright (not merged,
    // not flagged for override), same hard-block treatment duplicateInFile
    // already gets. Only a SUCCESSFUL send counts: a failed attempt left
    // the lead undelivered, so it stays importable.
    const matchedIds = [...new Set(parsed.map(r => r.matchedLeadId).filter(Boolean))];
    const sentToPrimehome = new Set();
    const sentToGyhomes = new Set();
    if(matchedIds.length){
      // Chunked: .in() on a few hundred ids is fine, but an import can
      // carry more than PostgREST will accept in one URL. Both channels
      // come back in one pass — the importer reports them separately.
      for(let i = 0; i < matchedIds.length; i += 200){
        const { data: sentRows } = await sb.from('ispeedtolead_submissions')
          .select('lead_id, channel')
          .eq('success', true)
          .in('lead_id', matchedIds.slice(i, i + 200));
        (sentRows || []).forEach(s => {
          if(s.channel === 'primehome') sentToPrimehome.add(s.lead_id);
          else if(s.channel === 'gyhomes') sentToGyhomes.add(s.lead_id);
        });
      }
    }
    // v566: a lead can be delivered without this system holding a send
    // record — iSpeedToLead confirms it by postback instead. The queue
    // already treats that as delivery (see ispdHasPostbackDelivery), but
    // the import did not, so the same lead could be reported here as
    // "never sent — refreshed so they can be resent" while the queue showed
    // it as delivered. Acting on the summary would then resend something
    // the buyer already has. Same test as the queue, so the two agree.
    //
    // matched_via 'phone_ineligible' is excluded for the reason spelled out
    // on ispdHasPostbackDelivery: it is the postback function's
    // reference-only path, reporting on a different submission that merely
    // shares a phone number.
    const deliveredByPostback = new Set();
    if(matchedIds.length){
      for(let i = 0; i < matchedIds.length; i += 200){
        const { data: pbRows } = await sb.from('ispeedtolead_postbacks')
          .select('matched_lead_id, matched_via, received_at')
          .in('matched_lead_id', matchedIds.slice(i, i + 200))
          .order('received_at', { ascending: false });
        const seen = new Set();
        (pbRows || []).forEach(pb => {
          // Latest postback per lead wins, matching how the queue's own map
          // is built — a lead with one real match plus earlier
          // reference-only rows still counts as delivered.
          if(seen.has(pb.matched_lead_id)) return;
          seen.add(pb.matched_lead_id);
          if(pb.matched_via !== 'phone_ineligible') deliveredByPostback.add(pb.matched_lead_id);
        });
      }
    }

    // v569: the summary said "Never sent anywhere: 54 — refreshed so they
    // can be resent" while the queue's Not sent filter showed 6. Both were
    // right about their own definition; the import's was just far broader
    // than anything actionable. Of that 54: 25 were closed by staff
    // (manual_delivery_at — the import had no idea the flag existed), 23
    // were on call-back (which the review table excludes outright), and
    // only the remainder were genuinely workable. Telling someone 54 leads
    // are ready to resend when 6 are is worse than saying nothing.
    // Fetch what is needed to split them the same way the queue does.
    const leadStateById = {};
    if(matchedIds.length){
      for(let i = 0; i < matchedIds.length; i += 200){
        const { data: stateRows } = await sb.from('leads')
          .select('id, status, manual_delivery_at')
          .in('id', matchedIds.slice(i, i + 200));
        (stateRows || []).forEach(x => { leadStateById[x.id] = x; });
      }
    }

    parsed.forEach(r => {
      const st = r.matchedLeadId ? leadStateById[r.matchedLeadId] : null;
      r.closedByStaff = !!(st && st.manual_delivery_at);
      r.onCallBack    = !!(st && st.status === 'call_back');
      r.alreadySentPrimehome = !!(r.matchedLeadId && sentToPrimehome.has(r.matchedLeadId));
      // gyhomes and PrimeHome Buyers are two independent outbound channels,
      // so a gyhomes send does NOT mean this lead is finished — it may still
      // be owed to PrimeHome Buyers. Reported separately for that reason.
      r.alreadySentGyhomes = !!(r.matchedLeadId && sentToGyhomes.has(r.matchedLeadId) && !sentToPrimehome.has(r.matchedLeadId));
      // Only when there is no send record of our own — otherwise the send
      // record is the better answer and already covers it.
      r.deliveredByPostbackOnly = !!(r.matchedLeadId && deliveredByPostback.has(r.matchedLeadId)
        && !sentToPrimehome.has(r.matchedLeadId) && !sentToGyhomes.has(r.matchedLeadId));
    });

    if(rawImportSummary){
      const s = rawImportSummary;
      const skipped = s.dncExcluded + s.corruptExcluded;
      msg.textContent = `Detected a raw call-intake export — converted ${s.converted} of ${s.sourceRows} row(s)` +
        (skipped ? ` (${s.dncExcluded} skipped as DNC-tagged, ${s.corruptExcluded} skipped as unreadable/corrupted).` : '.') +
        ` Type of house, Years owned, and Ping ID have no source data and are always left blank — review the ⚠ marks below before importing.`;
      msg.className = 'msg ok'; msg.style.display = 'block';
    }

    ispdParsedRows = parsed;
    renderIspdPreview(allCols.filter(c => colByHeaderIndex.some(mc => mc && mc.key === c.key)));
  } catch(err){
    msg.textContent = `Couldn't read that file: ${err.message}`;
    msg.className = 'msg error';
    msg.style.display = 'block';
  }
});

function renderIspdPreview(usedCols){
  $('ispdPreviewHead').innerHTML = `<tr><th>Match</th>${usedCols.map(c => `<th>${escapeHtml(c.header)}</th>`).join('')}</tr>`;
  $('ispdPreviewBody').innerHTML = ispdParsedRows.map(r => `
    <tr>
      <td class="mono" style="white-space:nowrap; color:${(r.duplicateInFile || r.alreadySentPrimehome || r.matchedLeadId) ? 'var(--danger)' : 'var(--text-2)'};" title="${r.alreadySentPrimehome ? 'This property was already delivered to PrimeHome Buyers — skipped so the sent record is not overwritten.' : (r.matchedLeadId ? `This PROPERTY is already on file (matched on ${escapeHtml(r.matchedOn || 'address')})${r.alreadySentGyhomes ? ' and was already sent to gyhomes' : (r.deliveredByPostbackOnly ? ' and iSpeedToLead already confirmed delivery by postback (channel unknown)' : ' and has never been sent anywhere')}. Nothing on the lead will be changed — the import only creates new leads. It is still tagged into this import so you can find it under Imported → My last import.` : (r.duplicateInFile ? 'The same property appears earlier in this file — only the first row creates the lead.' : ''))}">${r.alreadySentPrimehome ? 'Sent to PrimeHome — will skip' : (r.matchedLeadId ? (r.alreadySentGyhomes ? 'On file, sent to gyhomes' : (r.deliveredByPostbackOnly ? 'On file, delivered (postback)' : 'On file, never sent — for resend')) : (r.duplicateInFile ? 'Duplicate in file — will skip' : 'New lead'))}${r.missing.length ? ` <span style="color:var(--danger);" title="Missing: ${escapeHtml(r.missing.join(', '))}">⚠ ${r.missing.length} missing</span>` : ''}${r.multiAddress ? ` <span style="color:var(--danger); font-weight:700;" title="This row's Property Address cell contained ${r.multiAddress.length} addresses: ${escapeHtml(r.multiAddress.join(' | '))}&#10;&#10;Importing as the first one. The others are saved into Conversation notes — check whether they are separate leads.">⚠ ${r.multiAddress.length} addresses</span>` : ''}</td>
      ${usedCols.map(c => `<td>${escapeHtml((r.__cells[c.key] || '').slice(0, 40))}</td>`).join('')}
    </tr>
  `).join('');
  $('ispdImportCount').textContent = ispdParsedRows.length;
  $('ispdUploadPreviewWrap').style.display = '';
}

$('ispdCancelImportBtn').addEventListener('click', () => {
  ispdParsedRows = [];
  $('ispdUploadPreviewWrap').style.display = 'none';
  $('ispdUploadInput').value = '';
});

$('ispdConfirmImportBtn').addEventListener('click', async () => {
  const msg = $('ispdUploadMsg');
  msg.style.display = 'none';
  const { data: { user } } = await sb.auth.getUser();
  if(!user){ msg.textContent = 'Not signed in.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }
  const btn = $('ispdConfirmImportBtn');
  btn.disabled = true;
  btn.textContent = 'Importing…';
  // v87: resolve once per import batch, not per row.
  // v130: this used to fail silently — if it ever comes back null, every
  // matched/created lead in this batch goes through untagged (no
  // submission_form_id), which is the exact bug that made leads
  // permanently invisible in the PrimeHome Buyers view before the
  // isPrimeHomeBuyersLead() fallback in v130. Surfaced as a visible
  // warning now instead, so an importer sees it immediately rather than
  // discovering missing leads later.
  const defaultCampaignFormId = await getIspdDefaultCampaignFormId();
  if(!defaultCampaignFormId) console.error('getIspdDefaultCampaignFormId() returned null — this import batch will not auto-tag any lead with the PrimeHome Buyers campaign.');
  // CORRECTNESS FIX (audit finding, dashboard pass): r.matchedLeadId was
  // computed once at parse time, entirely
  // from leads that already existed in the DB *before* this batch started
  // running — it never accounted for rows created earlier in this SAME
  // batch. A file with two rows sharing a phone number that DIDN'T already
  // have a lead (a purchased/outside list, exactly the case this import
  // exists for) would insert two separate lead rows for the same seller
  // instead of merging the second into the first.
  //
  // v565: that in-batch map is now keyed on the ADDRESS, not the phone.
  // Keying it on phone would have silently reinstated exactly the
  // behaviour this version removes — an owner's second property in the
  // same file resolving onto the lead created for their first one. Rows
  // that genuinely repeat a property inside one file are caught at parse
  // time (r.duplicateInFile), so this map only has to carry ids forward
  // for anything that slips past that.
  const matchedLeadIdByAddr = {};
  ispdParsedRows.forEach(r => { if(r.matchedLeadId && r.addrKey) matchedLeadIdByAddr[r.addrKey] = r.matchedLeadId; });
  // v561: one id per import run, stamped on every lead this run touches so
  // the queue can filter back to "my last import" — see the Imported filter
  // and leads.last_import_batch. Deliberately does NOT touch submitted_at or
  // status: a re-upload must never rewrite a review decision.
  const importBatchId = (crypto && crypto.randomUUID) ? crypto.randomUUID() : String(Date.now());
  const importStamp = { last_import_batch: importBatchId, last_imported_at: new Date().toISOString(), last_imported_by: user.id };
  let created = 0, failed = 0, skippedDuplicate = 0, skippedAlreadySent = 0, refreshedGyhomes = 0, refreshedNeverSent = 0, refreshedPostback = 0, refreshedClosed = 0, refreshedCallBack = 0;
  for(const r of ispdParsedRows){
    const matchedLeadId = r.matchedLeadId || (r.addrKey ? (matchedLeadIdByAddr[r.addrKey] || null) : null);
    // v562: this import is CREATE-ONLY for lead DATA (user request,
    // 2026-09-09). It used to merge a matched row's fields onto the
    // existing lead; it no longer writes a single field of lead data to an
    // existing lead — not extra_fields, not submission_form_id, and (as
    // before) never status or submitted_at.
    //
    // Why: the recording and ping screenshot are attached by hand during
    // the per-lead review, not carried by the file, so the merge had
    // nothing useful to add — while a re-upload of a stale export could
    // quietly overwrite fields a reviewer had already corrected. The last
    // run made this concrete: 320 updated, 0 created. Every write went to a
    // lead somebody was already working, and not one new seller came in.
    //
    // A matched lead IS still stamped with the batch columns, and only
    // those. That is what makes the file usable as a worklist: with a
    // create-only import and no stamp, re-uploading this file would do
    // literally nothing (0 created, 347 skipped) and "My last import"
    // would come back empty — which defeats the filter it was added for.
    // The stamp touches tracking columns exclusively, so it cannot change
    // anything anyone reviews.
    //
    // Deliberately NOT stamped: leads already delivered to PrimeHome
    // Buyers. Those are finished — surfacing them in a worklist would only
    // invite re-sending something the buyer already has.
    if(r.alreadySentPrimehome){ skippedAlreadySent++; continue; }
    if(matchedLeadId){
      const { error } = await sb.from('leads').update(importStamp).eq('id', matchedLeadId);
      if(error){ failed++; console.error('import: batch stamp failed for lead', matchedLeadId, error); }
      else if(r.alreadySentGyhomes) refreshedGyhomes++;
      // v566: delivered, just not by a send this system recorded — must not
      // be reported as "never sent", which invites a resend.
      else if(r.deliveredByPostbackOnly) refreshedPostback++;
      // v569: closed by staff, and on call-back, are both genuinely
      // "not sent" — but neither is resendable, so counting them under
      // "never sent, refreshed so they can be resent" overstates the
      // workable set by an order of magnitude.
      else if(r.closedByStaff) refreshedClosed++;
      else if(r.onCallBack) refreshedCallBack++;
      else refreshedNeverSent++;
      continue;
    }
    // v565: the same property appears earlier in THIS file. Only the first
    // row creates it — the rest would duplicate against a lead that did not
    // exist when the batch was parsed.
    if(r.duplicateInFile){ skippedDuplicate++; continue; }
    const extraFields = {};
    Object.entries(r.__cells).forEach(([k, v]) => { if(!k.startsWith('__') && v) extraFields[k] = v; });
    {
      // No existing lead for this phone, in the DB or elsewhere in this
      // batch — an outside/purchased list row. Attributed to the importing
      // admin as user_id (leads.user_id is NOT NULL and RLS requires
      // auth.uid() = user_id on insert — see schema.sql's "leads: self
      // insert" policy). v88: submission_form_id defaults to the
      // "PrimeHome Buyers" Submission Form — task_id is deliberately left
      // null now (tasks is a time-tracking-only concept, never a lead
      // campaign, per the v88 changelog). v79: imported:true so the
      // importer (or anyone else with Edit on this section) can still
      // open/send it afterward.
      const count = parseInt(r.__cells.__count, 10) || 1;
      // BUG FIX (caught live, 2026-08-27): leads.extra_fields is NOT NULL
      // (default '{}'::jsonb) -- an explicit null here bypasses that
      // default and violates the constraint, so any row with no extra
      // custom fields matched (a plain name/phone/count list, e.g. a
      // purchased outside list with no custom columns) failed this insert
      // outright. Confirmed live: a 239-row import for a team leader
      // failed 100% (0 created, 0 updated, 239 failed) for exactly this
      // reason, with the underlying error swallowed into a bare failed++
      // below -- nothing surfaced why. {} satisfies the constraint and is
      // the column's own default anyway.
      const { data: newLead, error } = await sb.from('leads').insert({
        user_id: user.id, count, imported: true, submission_form_id: defaultCampaignFormId || null,
        ...importStamp,
        seller_investor_name: r.__cells.__seller_name || null,
        seller_phone: r.__cells.__phone || null,
        extra_fields: Object.keys(extraFields).length ? extraFields : {},
      }).select('id').single();
      if(error) failed++; else { created++; if(r.addrKey) matchedLeadIdByAddr[r.addrKey] = newLead.id; }
    }
  }
  logActivity('lead.csv_import', null, null, `CSV/Excel import (create-only): ${created} created, ${refreshedGyhomes} already sent to gyhomes, ${refreshedNeverSent} never sent (workable), ${refreshedPostback} delivered by postback, ${refreshedClosed} closed by staff, ${refreshedCallBack} on call-back, ${skippedAlreadySent} skipped as already sent to PrimeHome Buyers${skippedDuplicate ? `, ${skippedDuplicate} skipped as duplicate address` : ''}${failed ? `, ${failed} failed` : ''} (batch ${importBatchId})${!defaultCampaignFormId ? ' — WARNING: PrimeHome Buyers campaign could not be resolved, leads went in untagged' : ''}`);

  // v563: the four-line breakdown staff actually asked for. Every import
  // reports the same shape whether or not a category is empty — a run that
  // says "0 new" is itself the answer to "did this file bring anything in?",
  // and hiding the line would leave that unanswered.
  const inWorklist = created + refreshedGyhomes + refreshedNeverSent + refreshedPostback + refreshedClosed + refreshedCallBack;
  const importSummaryLines = [
    `New leads created: ${created}`,
    `Already sent to gyhomes: ${refreshedGyhomes}`,
    `Never sent anywhere: ${refreshedNeverSent} — refreshed and ready to work`,
    `Skipped as already sent to PrimeHome Buyers: ${skippedAlreadySent}`,
  ];
  // Printed only when it happens — unlike the four core categories, this
  // is a rare state and a permanent "0" line would just be noise.
  if(refreshedPostback) importSummaryLines.push(`Delivered via iSpeedToLead postback (channel unknown): ${refreshedPostback}`);
  // v569: shown so the four core numbers reconcile with the queue's own
  // "Not sent" count instead of quietly exceeding it.
  if(refreshedClosed) importSummaryLines.push(`Closed by staff, not sendable: ${refreshedClosed}`);
  if(refreshedCallBack) importSummaryLines.push(`On call-back, not ready to send: ${refreshedCallBack}`);
  // v567: rows whose Property Address cell held more than one address. The
  // first was imported and the rest saved into Conversation notes; someone
  // still has to decide whether those are separate leads.
  const multiAddrCount = ispdParsedRows.filter(r => r.multiAddress).length;
  if(multiAddrCount) importSummaryLines.push(`Rows with more than one address in the cell: ${multiAddrCount} — imported the first, the rest are in Conversation notes`);
  if(skippedDuplicate) importSummaryLines.push(`Skipped as a repeat of the same property in this file: ${skippedDuplicate}`);
  if(failed) importSummaryLines.push(`Failed: ${failed}`);
  msg.innerHTML = importSummaryLines.map(t => `<div>${escapeHtml(t)}</div>`).join('')
    + (inWorklist
        ? `<div style="margin-top:6px;">Find all ${inWorklist} with the Imported filter &rarr; &quot;My last import&quot;.</div>`
        : `<div style="margin-top:6px;">Nothing to work from this file &mdash; every row was already delivered.</div>`)
    + (!defaultCampaignFormId ? `<div style="margin-top:6px;">Warning: could not resolve the PrimeHome Buyers campaign &mdash; these leads were NOT tagged and may not show under Lead Reviewing. Try the import again, or check Submission Forms Creator.</div>` : '');
  msg.className = (failed || !defaultCampaignFormId) ? 'msg error' : 'msg';
  msg.style.display = 'block';
  // v711: ONE notification for the whole file -- the same lines shown here --
  // to everyone who gets "New lead submitted", instead of one per lead.
  sb.rpc('leads_import_notify', {
    p_title: `PrimeHome Buyers file imported: ${created} new lead${created === 1 ? '' : 's'}${failed ? `, ${failed} failed` : ''}`,
    p_body: importSummaryLines.join('\n'),
  }).then(({ error }) => { if(error) console.warn('import summary notification failed:', error.message); });
  btn.disabled = false;
  btn.textContent = 'Import';
  ispdParsedRows = [];
  $('ispdUploadPreviewWrap').style.display = 'none';
  $('ispdUploadInput').value = '';
  await loadLeads(); // refresh Dashboard/Queue Review/Lead Reviewing with the new/updated rows
});

async function saveLeadPhone(phoneEl){
  const newPhone = phoneEl.textContent.trim();
  const leadId = phoneEl.dataset.id;
  const oldPhone = phoneEl.dataset.original;
  if(newPhone === oldPhone) return;
  const { error } = await sb.from('leads').update({ seller_phone: newPhone || null }).eq('id', leadId);
  if(error){
    alert(error.message);
    phoneEl.textContent = oldPhone;
  } else {
    phoneEl.dataset.original = newPhone;
    logActivity('lead.update', 'lead', leadId, `Set phone to "${newPhone}"`);
  }
}

// v395: the single place that fires the "lead accepted" client
// notification — shared by every write path that can flip a lead's status
// to 'accepted' (setLeadStatus below, and saveLeadsQueueReviewFieldsAndSetStatus,
// which writes leads.status directly rather than calling setLeadStatus
// because it has its own inline field-editing + reject-reason-textarea
// flow). Route any future direct `leads.status` writer's accept case
// through this instead of re-inlining the notifyClientsForFormId call, so
// the notification logic can't drift out of sync between call sites.
function notifyIfLeadAccepted(lead, status){
  if(status !== 'accepted') return;
  // v583: skip if it was ALREADY accepted. Re-saving an accepted lead (an
  // edited field, a re-click) is not a new delivery and must not text the
  // client again. `lead` here is the pre-update row, so its status is the
  // value before this write.
  if(lead && lead.status === 'accepted') return;
  notifyClientsForFormId(lead.submission_form_id, 'lead_received', leadsFormNameFn ? leadsFormNameFn(lead.submission_form_id) : null);
}

async function setLeadStatus(lead, status, agentLabel, extraUpdate){
  let reviewNote = null;
  if(status === 'rejected'){
    // v1.2.6: a rejection comment is mandatory — keep prompting until the
    // reviewer either enters a non-empty reason or cancels (which aborts the
    // rejection entirely).
    reviewNote = prompt(`Why is this lead being rejected? (required)\n\nAgent: ${agentLabel} — ${lead.count} lead(s)`);
    if(reviewNote === null) return; // cancelled — do not reject
    reviewNote = reviewNote.trim();
    if(!reviewNote){
      alert('A comment is required to reject a lead.');
      return;
    }
  }
  const { data: { user } } = await sb.auth.getUser();
  const update = {
    status,
    reviewed_by: user ? user.id : null,
    reviewed_at: new Date().toISOString(),
    // v107: e.g. { ticket_stage: null } from Tickets Review's Reject —
    // optional, undefined for every pre-existing caller.
    ...(extraUpdate || {}),
  };
  // Only set review_note on rejection; clear it if re-accepting.
  if(status === 'rejected') update.review_note = reviewNote;
  else if(status === 'accepted') update.review_note = null;
  const { error } = await sb.from('leads').update(update).eq('id', lead.id);
  if(error){ alert(error.message); return; }
  // v153: only fires if this particular caller's own row object happens to
  // carry submission_form_id (not every table feeding setLeadStatus
  // selects it — e.g. Activity → Staff Work's own query doesn't) — a
  // no-op (see notifyClientsForFormId's own guard) rather than an error
  // when it's missing.
  notifyIfLeadAccepted(lead, status);
  await loadLeads();
  await refreshDetailIfViewing(lead.user_id);
  logActivity('lead.review', 'lead', lead.id, `Marked ${status} — ${agentLabel} — ${lead.count} lead(s)${status === 'rejected' ? ` — reason: ${reviewNote}` : ''}`);
}

// v152: "Recall" — an Owner/Admin (or any role granted Edit on Leads Queue
// Review) undoing an Accept that got pushed to the client by mistake.
// Puts the lead back to 'pending' and clears the reviewer fields, exactly
// the pre-review state — nothing about seller/phone/extra_fields/recording
// is touched, only the status that controls client visibility.
// v395: iSpeedToLead can already have reported+been paid for this exact
// lead before a Recall (ispeedtolead_postbacks.matched_lead_id, mapped_status
// 'accepted') — Finance's Accepted/Purchased $ totals are computed purely
// off that table, which a plain status reset back to 'pending' never
// touches, so the two tabs silently disagree about whether this lead was
// sold. Warn about it up front and flag the postback row(s)
// needs_reconciliation so Finance -> iSpeedToLead Postbacks surfaces them
// for a human to actually reconcile (refund? already resold? no action
// needed?) rather than losing the mismatch entirely.
async function recallAcceptedLeadToQueue(lead, agentLabel){
  const { data: soldPostbacks } = await sb.from('ispeedtolead_postbacks')
    .select('id, amount, received_at')
    .eq('matched_lead_id', lead.id)
    .eq('mapped_status', 'accepted');
  const soldRows = soldPostbacks || [];
  const soldWarning = soldRows.length
    ? `\n\n⚠ iSpeedToLead already reported this lead ACCEPTED/PURCHASED (${soldRows.length} postback${soldRows.length > 1 ? 's' : ''}, ${soldRows.map(r => r.amount != null ? `$${r.amount}` : '—').join(', ')}). Recalling it will NOT undo that sale or its $ total in Finance — it'll be flagged there as "Needs reconciliation" so you can follow up manually.`
    : '';
  if(!confirm(`Recall this accepted lead back to Queue Review?\n\nIt will stop being visible to the client immediately.${soldWarning}\n\nAgent: ${agentLabel} — ${lead.count} lead(s)`)) return;
  const { error } = await sb.from('leads').update({
    status: 'pending',
    review_note: null,
    reviewed_by: null,
    reviewed_at: null,
  }).eq('id', lead.id);
  if(error){ alert(error.message); return; }
  if(soldRows.length){
    await sb.from('ispeedtolead_postbacks').update({ needs_reconciliation: true }).in('id', soldRows.map(r => r.id));
  }
  await loadLeads();
  await refreshDetailIfViewing(lead.user_id);
  logActivity('lead.recall', 'lead', lead.id, `Recalled an accepted lead back to Queue Review — ${agentLabel} — ${lead.count} lead(s)${soldRows.length ? ` — flagged ${soldRows.length} iSpeedToLead postback(s) for reconciliation` : ''}`);
}

async function deleteLead(lead, label){
  const id = typeof lead === 'object' ? lead.id : lead; // accept either the full row or just an id
  const userId = typeof lead === 'object' ? lead.user_id : null;
  // audit fix (audit_chunk5.md #6, Medium): this used to ignore the
  // delete's { error } entirely -- an RLS rejection or any other failure
  // still ran loadLeads() and unconditionally logged lead.delete to the
  // Audit Log as if it had succeeded, actively misleading anyone reviewing
  // it later (the lead is still very much present). Mirrors
  // bulkDeleteCallBackLeads, a few functions later in this same file,
  // which already checks the error correctly.
  const { error } = await sb.from('leads').delete().eq('id', id);
  if(error){ alert(`Couldn't delete this lead: ${error.message}`); return; }
  loadLeads();
  if(userId) await refreshDetailIfViewing(userId);
  logActivity('lead.delete', 'lead', id, `Deleted lead submission — ${label || id}`);
}

// ---------- v69: iSpeedToLead outbound submission — details modal ----------
// Field keys here are iSpeedToLead's OWN field names (form_address,
// form_multifamily, etc. — see the "Provider lead fields description" doc
// they supplied), stored verbatim under leads.extra_fields so the
// ispeedtolead-submit Edge Function needs almost no translation. This is a
// fixed config for one specific external vendor's intake form — separate
// from (and NOT read by) the generic task_category_fields system the
// extension's agent-facing "Submit leads" popup uses.
const ISPEEDTOLEAD_FIELD_GROUPS = [
  { title: 'Contact', fields: [
    { key: 'form_first_name', label: 'First name', type: 'text', placeholder: 'Auto-split from Seller Name unless set here' },
    { key: 'form_last_name', label: 'Last name', type: 'text', placeholder: 'Auto-split from Seller Name unless set here' },
    { key: 'form_email', label: 'Email', type: 'text', placeholder: 'seller@example.com' },
  ]},
  { title: 'Property', fields: [
    { key: 'form_address', label: 'Property address', type: 'text', required: true, placeholder: '243103 Doric Ave, Cranston, RI 02910' },
    { key: 'form_unit', label: 'Unit', type: 'text' },
    { key: 'form_city', label: 'City', type: 'text', required: true },
    { key: 'form_state', label: 'State', type: 'text', required: true, placeholder: 'RI or Rhode Island' },
    { key: 'form_zip', label: 'ZIP code', type: 'text' },
    { key: 'form_multifamily', label: 'Type of house', type: 'select', required: true, options: ['Ranch', '2-story', 'Mobile home owned land', 'Mobile home rented land', 'Multifamily', 'Single family', 'Bungalow', 'Cottage', 'Townhouse', 'Condominium', 'Duplex', 'Farmhouse', 'Split-level home', 'Land'] },
    { key: 'form_square', label: 'Square footage', type: 'select', options: ['0 - 500', '500 - 1000', '1000 - 2000', '2000 - 3000', '3000 - 4000', '4000 - 5000', '5000+'] },
    { key: 'form_year', label: 'Year of construction', type: 'select', options: ['1800-1900', '1900-1950', '1950-1970', '1970-1980', '1980-1990', '1990-2000', '2000-2010', '2010-2022'] },
    { key: 'form_garage', label: 'Garage', type: 'select', options: ['None', '1 Car Attached', '2 Car Attached', '1 Car Detached', '2 Car Detached', 'Carport', 'Other'] },
    { key: 'form_bedrooms', label: 'Bedrooms', type: 'select', options: ['1 Bedroom', '2 Bedroom', '3 Bedroom', '4 Bedroom', '5 Bedroom', 'More than 5'] },
