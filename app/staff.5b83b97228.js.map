// v: welcome email template settings -- mirrors hr-send-welcome-email's
// own DEFAULT_SUBJECT/DEFAULT_BODY/DEFAULT_MEETING_INFO exactly, so this
// editor shows real starting text (not a blank box) the first time
// anyone opens it, before app_settings has a saved row for either key.
const HR_WELCOME_EMAIL_DEFAULT_SUBJECT = "You're hired at proptech AI";
const HR_WELCOME_EMAIL_DEFAULT_BODY = `Hi {first_name},

Welcome onboard! and congrats on your new position as {position}.

Please find our CRM portal credentials below

Link: https://staffportal.proptechnologyai.com
Email: {email}
Password: {password}

Please join the onboarding meeting link on {meeting_datetime}.

Onboarding meeting
{meeting_datetime}
{meeting_info}

Please find the extension installation link below
https://chromewebstore.google.com/detail/proptech-ai-time-manageme/ejpaamckgoggmegolclnifbmdnbnlmei

Regards,
Hiring Team`;
const HR_ONBOARDING_MEETING_INFO_DEFAULT = `Time zone: America/Indiana/Knox
Google Meet joining info
Video call link: https://meet.google.com/gup-iiub-ngo
Or dial: (ZA) +27 10 823 0320 PIN: 567 814 214 1104#
More phone numbers: https://tel.meet/gup-iiub-ngo?pin=5678142141104`;
// v: CC'd on every welcome email by default, per explicit request.
const HR_WELCOME_EMAIL_DEFAULT_CC = 'rmariam190@gmail.com, info@proptechnologyai.com';
async function loadHrWelcomeEmailSettings(){
  const { data: rows } = await sb.from('app_settings').select('key, value')
    .in('key', ['hr_welcome_email_subject', 'hr_welcome_email_body', 'hr_onboarding_meeting_info', 'hr_welcome_email_cc']);
  const byKey = {}; (rows || []).forEach(r => { if(r.value != null) byKey[r.key] = r.value; });
  $('hrWelcomeEmailSubject').value = byKey['hr_welcome_email_subject'] || HR_WELCOME_EMAIL_DEFAULT_SUBJECT;
  $('hrWelcomeEmailBody').value = byKey['hr_welcome_email_body'] || HR_WELCOME_EMAIL_DEFAULT_BODY;
  $('hrOnboardingMeetingInfo').value = byKey['hr_onboarding_meeting_info'] || HR_ONBOARDING_MEETING_INFO_DEFAULT;
  $('hrWelcomeEmailCc').value = byKey['hr_welcome_email_cc'] || HR_WELCOME_EMAIL_DEFAULT_CC;
}
if($('hrWelcomeEmailSettingsSaveBtn')) $('hrWelcomeEmailSettingsSaveBtn').addEventListener('click', async () => {
  const msg = $('hrWelcomeEmailSettingsMsg');
  msg.textContent = '';
  const btn = $('hrWelcomeEmailSettingsSaveBtn');
  btn.disabled = true;
  const now = new Date().toISOString();
  const rows = [
    { key: 'hr_welcome_email_subject', value: $('hrWelcomeEmailSubject').value.trim() || HR_WELCOME_EMAIL_DEFAULT_SUBJECT, updated_at: now },
    { key: 'hr_welcome_email_body', value: $('hrWelcomeEmailBody').value.trim() || HR_WELCOME_EMAIL_DEFAULT_BODY, updated_at: now },
    { key: 'hr_onboarding_meeting_info', value: $('hrOnboardingMeetingInfo').value.trim() || HR_ONBOARDING_MEETING_INFO_DEFAULT, updated_at: now },
    { key: 'hr_welcome_email_cc', value: $('hrWelcomeEmailCc').value.trim() || HR_WELCOME_EMAIL_DEFAULT_CC, updated_at: now },
  ];
  const { error } = await sb.from('app_settings').upsert(rows, { onConflict: 'key' });
  btn.disabled = false;
  if(error){ msg.textContent = error.message; msg.className = 'msg error'; return; }
  msg.textContent = 'Saved.';
  msg.className = 'msg';
  logActivity('app_settings.update', null, null, 'Updated HR welcome email settings');
});

$('hrApproveCreateBtn').addEventListener('click', async () => {
  const msg = $('hrApproveMsg');
  msg.textContent = '';
  const full_name = $('hrApproveFullName').value.trim();
  const email = $('hrApproveEmail').value.trim();
  const mobile = $('hrApproveMobile').value.trim();
  const role = $('hrApproveRole').value;
  const password = $('hrApprovePassword').value;
  const startDate = $('hrApproveStartDate').value;
  const candidateId = hrApproveCandidateId;
  if(!candidateId) return;

  if(!full_name){ msg.textContent = 'Full name is required.'; return; }
  if(!email){ msg.textContent = 'Email is required.'; return; }
  if(!mobile){ msg.textContent = 'Mobile number is required.'; return; }
  if(!password || password.length < 8){ msg.textContent = 'Password must be at least 8 characters.'; return; }
  if(!startDate){ msg.textContent = 'Employment start date is required.'; return; }

  const btn = $('hrApproveCreateBtn');
  btn.disabled = true;
  const result = await invokeManageUser({ action: 'create_user', email, password, full_name, role });
  btn.disabled = false;
  if(!result.ok){
    msg.textContent = result.error || 'Failed to create user.';
    return;
  }

  // v: name/email/mobile as edited in THIS modal now get written back to
  // the hr_candidates row itself, not just used for the new account --
  // "Your submissions" and "My Commission" both read straight off this
  // row, so a correction made here (fixing a typo, updating a number)
  // used to silently never show up there, even though the actual account
  // got the right values.
  const { error } = await sb.from('hr_candidates').update({
    full_name,
    email,
    mobile_number: mobile,
    status: 'approved',
    rejection_reason: null,
    reviewed_by: myUserId,
    reviewed_at: new Date().toISOString(),
    created_user_id: result.userId,
    employment_start_date: startDate,
  }).eq('id', candidateId);
  if(error){
    // The account now exists even though this write failed — say so
    // explicitly rather than leaving the reviewer to guess and possibly
    // retry, which would just create a second, duplicate account.
    msg.textContent = `Account was created, but failed to update the candidate record: ${error.message}`;
    return;
  }

  // v645: categorise the new hire. Same RPC the Add User modal and the
  // Account panel use (profiles UPDATE is self-only, so this cannot be a
  // plain update -- see v643). Reported as a partial success: the account
  // and the candidate record are already written by this point, so a
  // failure here must not read as "approval failed" and send the reviewer
  // round to approve again.
  const hrDepartment = $('hrApproveDepartment').value;
  const hrTitle = $('hrApprovePosition').value.trim();
  const hrGrade = $('hrApproveGrade').value;
  let hrOrgWarning = '';
  if(hrDepartment || hrTitle || hrGrade){
    const org = await saveStaffOrgInfo(result.userId, hrDepartment, hrTitle, hrGrade);
    if(!org.ok){
      hrOrgWarning = ` The account was created, but the department/title was not saved (${org.error}). Set it from User Management > Users.`;
      console.error('set_staff_org_info failed after candidate approval', org.error);
    }
  }

  logActivity('hr.candidate_approved', 'hr_candidate', candidateId, `Approved and created ${role} account for ${email}${full_name ? ' ('+full_name+')' : ''}${hrTitle || hrDepartment ? ` — ${[hrTitle, hrDepartment].filter(Boolean).join(' · ')}` : ''}`);
  logActivity('user.create', 'agent', result.userId, `Created ${role} account for ${email}${full_name ? ' ('+full_name+')' : ''} (via Candidate Review approval)`);
  loadTeam();
  if(umActiveSection === 'users') loadUmUsersList();
  await loadHrReviewCandidates();

  $('hrApproveSuccessEmail').textContent = email;
  $('hrApproveSuccessPassword').textContent = password;
  $('hrApproveOrgWarning').textContent = hrOrgWarning;                       // v645
  $('hrApproveOrgWarning').style.display = hrOrgWarning ? 'block' : 'none';  // v645
  $('hrApproveFormView').style.display = 'none';
  $('hrApproveSuccessView').style.display = 'block';

  // v: welcome email -- sent AFTER the account/candidate-record writes
  // above already succeeded, so a failure here never blocks or rolls
  // back the actual hire. Account creation is the part that matters;
  // this is best-effort on top of it, surfaced clearly either way.
  const welcomeMsg = $('hrApproveWelcomeEmailMsg');
  if($('hrApproveSendWelcomeEmail').checked){
    welcomeMsg.style.display = 'block';
    welcomeMsg.className = 'msg';
    welcomeMsg.textContent = 'Sending welcome email…';
    const { data: sendResult, error: sendErr } = await sb.functions.invoke('hr-send-welcome-email', {
      body: {
        toEmail: email,
        fullName: full_name,
        position: $('hrApprovePosition').value.trim(),
        password,
        meetingDatetime: formatMeetingDatetimeLabel($('hrApproveMeetingDatetime').value),
      },
    });
    if(sendErr || !sendResult || !sendResult.ok){
      let errText = (sendResult && sendResult.error) || sendErr?.message || 'Failed to send.';
      if(sendErr && sendErr.context && typeof sendErr.context.json === 'function'){
        try{ const parsed = await sendErr.context.json(); if(parsed?.error) errText = parsed.error; }catch(_e){ /* fall through */ }
      }
      welcomeMsg.className = 'msg error';
      welcomeMsg.textContent = `Account created, but the welcome email failed to send: ${errText}`;
    } else {
      welcomeMsg.className = 'msg';
      welcomeMsg.textContent = `Welcome email sent to ${email}.`;
    }
  }
});
$('hrApproveCopyBtn').addEventListener('click', async () => {
