// ---------- User Management tab: sub-section navigation + per-section gating ----------
let umActiveSection = null;
function initUserManagementTab(){
  document.querySelectorAll('.um-subtab-btn').forEach(btn => {
    btn.style.display = canViewUmSection(btn.dataset.umSection) ? '' : 'none';
  });
  const firstVisible = Array.from(document.querySelectorAll('.um-subtab-btn')).find(b => b.style.display !== 'none');
  const target = (umActiveSection && canViewUmSection(umActiveSection)) ? umActiveSection : (firstVisible ? firstVisible.dataset.umSection : null);
  if(target) activateUmSection(target);
}
function activateUmSection(key){
  umActiveSection = key;
  document.querySelectorAll('.um-subtab-btn').forEach(b => b.classList.toggle('active', b.dataset.umSection === key));
  document.querySelectorAll('.um-section').forEach(s => { s.style.display = (s.id === 'um-section-' + key) ? 'block' : 'none'; });
  if(key === 'users') loadUmUsersList();
  if(key === 'tasks'){ loadTaskCategoriesList(); loadTasksList(); }
  if(key === 'dialer_domains') loadDialerDomainsList();
  if(key === 'min_version'){ loadMinExtensionVersion(); loadActivityCeilings(); }
  if(key === 'roles') initRolesTab();
  if(key === 'clients') loadUmClientsList();
  if(key === 'integrations'){ loadGhlConnections(); loadGhlClientSmsLocationSetting(); loadGhlAgentMap(); loadGhlCalls(); loadGhlLookupLocations(); loadRmConnections(); loadRmLeadPostingChannels(); loadRmChannelClientOptions(); loadRmAgentMap(); loadRmEmailImports(); loadRmLeadPushes(); loadGmailConnections(); }
  if(key === 'notifications_setting'){ loadStaffNotifRouting(); loadClientNotifSettings(); }
  if(key === 'chat_settings'){
    loadWebrtcTurnSettings();
    const routingWrap = $('clientChatRoutingWrap');
    if(routingWrap){
      const canSeeRouting = myIsOwner || myRole === 'admin';
      routingWrap.style.display = canSeeRouting ? '' : 'none';
      if(canSeeRouting) loadClientChatRoutes();
    }
  }
  applyUmSectionEditGating(key);
}
