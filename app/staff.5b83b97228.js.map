// "All users" is exclusive — checking it clears + disables the other
// three (they'd be redundant, since All already includes everyone).
// Checking any of the other three un-checks All. The other three combine
// freely with each other (e.g. "Only themselves" + "A specific user
// type" can both be on at once).
$('roleViewScopeSelf').addEventListener('change', onRoleViewScopeComboChange);
$('roleViewScopeSelected').addEventListener('change', onRoleViewScopeComboChange);
$('roleViewScopeSpecificRole').addEventListener('change', onRoleViewScopeComboChange);
$('roleViewScopeAll').addEventListener('change', onRoleViewScopeAllChange);

function onRoleViewScopeAllChange(){
  if($('roleViewScopeAll').checked){
    $('roleViewScopeSelf').checked = false;
    $('roleViewScopeSelected').checked = false;
    $('roleViewScopeSpecificRole').checked = false;
  }
  [$('roleViewScopeSelf'), $('roleViewScopeSelected'), $('roleViewScopeSpecificRole')].forEach(cb => cb.disabled = $('roleViewScopeAll').checked);
  updateRoleViewScopeVisibility();
}

function onRoleViewScopeComboChange(){
  if(this && this.checked){ $('roleViewScopeAll').checked = false; }
  updateRoleViewScopeVisibility();
}

function updateRoleViewScopeVisibility(){
  $('roleViewUsersPicker').style.display = $('roleViewScopeSelected').checked ? 'flex' : 'none';
  $('roleViewSpecificRoleWrap').style.display = $('roleViewScopeSpecificRole').checked ? 'block' : 'none';
}

function resetRoleForm(){
  editingRoleName = null;
  $('rolesFormTitle').textContent = 'Add a user type';
  $('roleNameInput').value = '';
  $('roleNameInput').disabled = false;
  renderRoleTabsPicker([], {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {});
  renderRoleTaskCategoriesPicker([]);
  $('roleCanTextClientsCb').checked = false;
  $('roleCanEditCompensationCb').checked = false;
  $('roleCanManualDialCb').checked = false;
  $('roleCanManualDialCb').disabled = !ceilingAllowsFlag('can_manual_dial');
  $('roleCanManualDialCb').title = '';
  $('roleViewScopeSelf').checked = true; // safest default — see anyone but themselves only once an Owner opts them in
  $('roleViewScopeSelected').checked = false;
  $('roleViewScopeSpecificRole').checked = false;
  $('roleViewScopeAll').checked = false;
  $('roleViewScopeAll').disabled = false;
  [$('roleViewScopeSelf'), $('roleViewScopeSelected'), $('roleViewScopeSpecificRole')].forEach(cb => cb.disabled = false);
