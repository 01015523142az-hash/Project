// ---- GoHighLevel OAuth2 (multi-location) ----
// Fill these in after creating your app at marketplace.gohighlevel.com —
// GHL_CLIENT_ID is public (safe to ship here, same as any OAuth client
// ID); the matching GHL_CLIENT_SECRET must ONLY ever live as a Supabase
// Edge Function secret (oauth-callback / ghl-api), never here.
// v482 FIX: v479's value was TRUNCATED -- GHL Client IDs have a
// `<id>-<suffix>` shape and only the id part before the dash got pasted
// in originally. This is the likely real root cause of every "Invalid
// client credentials!" failure across this whole debugging arc,
// including the ones that seemed to partially work (GHL apparently
// still resolves the app's display name / accepts a token exchange
// against some sufficiently-matching prefix in places, but not
// consistently) -- filled in now with the FULL id including suffix, from
// the Marketplace app's own "My Apps" page (public value, safe to ship
// in frontend code — the matching Client Secret stays a Supabase Edge
// Function secret only, per this block's own comment above).
const GHL_CLIENT_ID = '6a7c6322bd1f6848b4917540-msq22lxx';
// Must exactly match: (a) the redirect URI registered in your GHL app's
// settings, and (b) the GHL_REDIRECT_URI secret set on the oauth-callback
// Edge Function. All three have to agree exactly (including trailing
// slashes) or GHL will refuse the install.
// v480 FIX: v478 filled this in as .../ghl-oauth-callback, guessing by
// analogy to GMAIL_REDIRECT_URI's naming -- wrong guess. This project's
// real GHL callback function is named plain `oauth-callback`, NOT
// `ghl-oauth-callback` -- see oauth-callback/index.ts's own header
// comment: GHL's Marketplace app-registration form rejects any redirect
// URL containing a "Highlevel"/"ghl" reference for a white-label app
// ("The redirect uri contains a Highlevel reference..."), so the
// function was renamed specifically to satisfy that filter. The OLD
// `ghl-oauth-callback` function is still deployed live (leftover, v58)
// but is NOT what's registered on the Marketplace app -- pointing here
// at it caused a real live failure ("Invalid client credentials!" from
// GHL right after picking an account on its consent screen, since the
// redirect_uri this app was sending didn't match what's registered).
// Confirmed against the user's own Marketplace app settings before this
// fix.
const GHL_REDIRECT_URI = 'https://kqfoniinytvuddxiwvkc.supabase.co/functions/v1/oauth-callback';
// Scoped to just what lead-sync needs — trim further or extend if your
// use case grows, but the fewer scopes requested, the less damage a
// leaked token could do, and the smoother GHL's Marketplace review is.
// v477 BUG FIX (live report: "GoHighLevel rejected the calendar list
// (401)" when booking from the SMS footer's calendar button): the
// connected location's token has never carried any calendars.* scope --
// list_calendars/get_calendar_slots/book_appointment (added earlier the
// same day as this fix, v7 in ghl-api's own header) were built and
// deployed assuming the connection would already have them, but nothing
// had actually added them to what gets REQUESTED at connect time. Added
// calendars.readonly/calendars/events.readonly/calendars/events.write
// here so a fresh connect/reconnect actually asks GHL for them. Also
// brought this list up to date with what the live connection's token
// actually carries today (conversations.*/locations.readonly, needed by
// lookup_contact_activity/send-client-sms — this constant had drifted
// behind whatever scopes got added to the connection directly over
// time; keeping it accurate matters because a disconnect/reconnect
// re-requests exactly this list, and anything missing here would be
// LOST on reconnect, not just "still missing calendars"). NOTE: changing
// this list does NOT retroactively grant new scopes to the location
// that's already connected — GHL bakes the granted scope into the token
// at the moment of authorization. The existing connection under User
// Management → Integrations must be disconnected and reconnected
// (redoing the OAuth consent screen) for a token carrying the calendar
// scopes to actually get issued; only after that will list_calendars
// stop 401ing. If your marketplace app's own settings at
// marketplace.gohighlevel.com don't have the Calendars scope enabled/
// requestable for this app, add it there FIRST or the reconnect will
// still come back without it.
const GHL_SCOPES = [
  'contacts.readonly', 'contacts.write', 'opportunities.readonly', 'opportunities.write',
  'conversations.readonly', 'conversations/message.readonly', 'conversations/message.write',
  'locations.readonly',
  'calendars.readonly', 'calendars/events.readonly', 'calendars/events.write',
];
// SECURITY FIX (audit finding, ghl-oauth-callback's former "KNOWN GAP"
// header comment): now takes the CSRF `state` nonce minted by ghl-api's
// create_oauth_state action and sends it through to GHL, which echoes it
// straight back on the callback redirect — ghl-oauth-callback validates
// and consumes it before doing anything else. Without this a `code`
// obtained by completing GHL's consent screen against ANY location
// (someone's own free/trial account, say) could be replayed against our
// callback and get upserted into ghl_connections.
function ghlConnectUrl(state){
  const params = new URLSearchParams({
    response_type: 'code',
    client_id: GHL_CLIENT_ID,
    redirect_uri: GHL_REDIRECT_URI,
    scope: GHL_SCOPES.join(' '),
    state,
  });
  return `https://marketplace.gohighlevel.com/oauth/chooselocation?${params.toString()}`;
}

// ---- Gmail OAuth2 (single shared inbox) ----
// GMAIL_CLIENT_ID is public (safe to ship here, same as GHL_CLIENT_ID
// above); GMAIL_CLIENT_SECRET must ONLY ever live as a Supabase Edge
// Function secret (gmail-oauth-callback / gmail-api), never here.
const GMAIL_CLIENT_ID = '618099835839-2ul0surcf6lv8u1folrha35nvpt8a1pd.apps.googleusercontent.com';
// Must exactly match: (a) the Authorized redirect URI on the Google Cloud
// OAuth client, and (b) the GMAIL_REDIRECT_URI secret set on the
// gmail-oauth-callback Edge Function.
const GMAIL_REDIRECT_URI = 'https://kqfoniinytvuddxiwvkc.supabase.co/functions/v1/gmail-oauth-callback';
// gmail.send covers send; gmail.modify covers read + the mark-as-read
// (messages.modify, stripping UNREAD) get_thread does when a thread is
// opened -- readonly alone doesn't have write/modify rights on the
// mailbox, so mark-as-read 403'd ("insufficient authentication scopes")
// on every single call before this fix (v491, live-confirmed via
// gmail-api's own function logs: hundreds of failures, all silently
// swallowed by get_thread's best-effort catch, so the reading pane still
// worked -- messages just never actually got marked read in Gmail, so
// the Inbox subtab's unread-first sort/badge never cleared). gmail.modify
// is a superset of gmail.readonly for everything this app calls (list/get/
// modify), so readonly is dropped rather than kept redundant.
// openid+userinfo.email let gmail-oauth-callback resolve which address
// just connected. NOTE: an already-connected inbox's token was minted
// under the OLD scope list and does NOT retroactively gain gmail.modify --
// User Management -> Integrations -> Gmail must be disconnected and
// reconnected once for this fix to actually take effect.
const GMAIL_SCOPES = [
  'https://www.googleapis.com/auth/gmail.send',
  'https://www.googleapis.com/auth/gmail.modify',
  'openid',
  'https://www.googleapis.com/auth/userinfo.email',
];
// v514: the Taxes -> Invoice Archive connection (purpose 'invoices') is a
// SEPARATE Gmail account from the one above and never sends or marks mail
// read/modified -- gmail.readonly (not gmail.modify/gmail.send) is the
// correct minimal scope, not just what's convenient to reuse.
const GMAIL_INVOICE_SCOPES = [
  'https://www.googleapis.com/auth/gmail.readonly',
  'openid',
  'https://www.googleapis.com/auth/userinfo.email',
];
function gmailConnectUrl(state, scopes){
  const params = new URLSearchParams({
    response_type: 'code',
    client_id: GMAIL_CLIENT_ID,
    redirect_uri: GMAIL_REDIRECT_URI,
    scope: (scopes || GMAIL_SCOPES).join(' '),
    state,
    access_type: 'offline', // required to get a refresh_token back at all
    prompt: 'consent',       // required to get a refresh_token on every consent, not just the first ever
  });
  return `https://accounts.google.com/o/oauth2/v2/auth?${params.toString()}`;
}
async function callGmailApi(payload){
  const { data, error } = await sb.functions.invoke('gmail-api', { body: payload });
  if(error){
    try{ const body = await error.context.json(); return { ok: false, error: body.error || error.message }; }
    catch{ return { ok: false, error: error.message }; }
  }
  return data;
}

// Instantiated immediately (not lazily on Sign In) so the "Forgot
// password?" flow and the recovery-link landing below both have a
// client to call before anyone has actually signed in.
// Guarded rather than a bare call: if the Supabase CDN script above didn't
// load (network hiccup, ad-blocker, CDN outage), this would otherwise
// throw at the top level and silently kill every later line in this
// script — including totally unrelated features like the theme toggle —
// instead of just login failing with a clear, visible error.
let sb = null;
try{
  // v (user request, 2026-09-05): persistSession:true + storage:sessionStorage
  // (NOT the default localStorage) -- a same-tab refresh (e.g. clicking the
  // "new version available" banner's own Refresh button) now restores the
  // session instead of dumping the person back on the login screen, but
  // sessionStorage is per-tab and cleared the moment the tab/browser
  // closes, so that half of the old "always start signed out" behavior is
  // unchanged. Supabase's own autoRefreshToken would otherwise keep a
  // merely-open (not necessarily actively used) tab's session alive
  // indefinitely on top of that, so the boot/idle-timeout code further
  // down enforces a genuine 4-hour INACTIVITY timeout independent of the
  // token's own expiry -- see IDLE_TIMEOUT_MS.
  //
  // flowType:'implicit' (unrelated to the above, kept as-is -- v38 fix,
  // this WAS the "reset password link doesn't work" bug): supabase-js v2
  // defaults to the PKCE flow, which requires stashing a code_verifier in
  // storage before the person leaves the page, then reading it back when
  // the emailed link lands them back here with a `?code=...` param, to
  // exchange it for a session. A password-recovery email is opened in
  // whatever tab/browser the person is in when they click it -- often not
  // the one that requested it -- so nothing can be guaranteed to have
  // survived in THAT tab's storage regardless of what persistSession is
  // set to here. The rest of this file's recovery code (splitting the URL
  // on '#' when building redirectTo, and reading the recovery event
  // straight off onAuthStateChange) was written assuming the OLDER
  // implicit flow, where Supabase appends the access token directly to the
  // URL as a `#hash` fragment instead -- no stored verifier needed, no
  // exchange step, so it works regardless of which tab/browser the link is
  // opened in.
  sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
    auth: { persistSession: true, storage: window.sessionStorage, flowType: 'implicit' }
  });
}catch(e){
  console.error('Supabase client failed to initialize — check that the CDN script tag loaded.', e);
}
/* v802: hand the app's own client to the crash reporter, which has been
   buffering since before this script ran. */
try { if (window.__opsAttach) window.__opsAttach(sb); } catch (e) {}
// v830 (owner asked 2026-09-22): would the database be faster in the US? Once a
// day, in the background, a signed-in browser times a few round trips -- to
// our project today (Frankfurt), to AWS eu-central-1 (the region it runs in,
// as a baseline) and to AWS us-east-1 / us-east-2 -- and stores the medians in
// latency_probes. Ops Health shows the result per place. Waits 45 s after the
// page loads, only runs while the tab is visible, gives up for the day after
// three failed saves, and never affects the page.
(function () {
  var PORTAL = 'staff';
  var KEY = 'pt.latencyProbe.' + PORTAL;
  var done = false, tries = 0;
  function median(a) {
    var b = a.filter(function (x) { return x != null; }).sort(function (x, y) { return x - y; });
    return b.length ? Math.round(b[Math.floor(b.length / 2)]) : null;
  }
  async function time(url, opts) {
    var t = performance.now();
    try { await fetch(url, opts); } catch (e) { return null; }
    return performance.now() - t;
  }
  async function probe(url, opts) {
    await time(url, opts);   // warm-up: DNS and TLS are not what we are measuring
    var r = [];
    for (var i = 0; i < 5; i++) r.push(await time(url + (url.indexOf('?') < 0 ? '?' : '&') + 'r=' + Math.random(), opts));
    return median(r);
  }
  async function run() {
    try {
      if (done || document.hidden || typeof sb === 'undefined' || !sb || tries >= 3) return;
      var today = new Date().toISOString().slice(0, 10);
      try { if (localStorage.getItem(KEY) === today) { done = true; return; } } catch (e) {}
      var s = await sb.auth.getSession();
      if (!s || !s.data || !s.data.session) return;
      done = true;
      tries++;
      var aws = function (region) {
        return probe('https://dynamodb.' + region + '.amazonaws.com/ping', { mode: 'no-cors', cache: 'no-store' });
      };
      var row = {
        portal: PORTAL,
        tz: (Intl.DateTimeFormat().resolvedOptions().timeZone || null),
        supabase_ms: await probe(SUPABASE_URL + '/auth/v1/health', { cache: 'no-store', headers: { apikey: SUPABASE_ANON_KEY } }),
        eu_ms: await aws('eu-central-1'),
        use1_ms: await aws('us-east-1'),
        use2_ms: await aws('us-east-2')
      };
      var res = await sb.from('latency_probes').insert(row);
      if (res && !res.error) { try { localStorage.setItem(KEY, today); } catch (e) {} }
      else done = false;
    } catch (e) { done = false; }
  }
  setTimeout(run, 45000);
  setInterval(run, 10 * 60 * 1000);
})();
let config = { supabaseUrl: SUPABASE_URL, anonKey: SUPABASE_ANON_KEY };

// ---------- light / dark theme ----------
// The instant-apply script right after <body> already set data-theme
// before first paint; this just wires up the toggle buttons and keeps
// their icon in sync, on both the login screen and the app header.
function currentTheme(){
  return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
}
function applyThemeIcon(){
  const icon = currentTheme() === 'light' ? '☀️' : '🌙';
  const loginBtn = document.getElementById('themeToggleBtnLogin');
  const appBtn = document.getElementById('themeToggleBtn');
  if(loginBtn) loginBtn.textContent = icon;
  if(appBtn) appBtn.textContent = icon;
}
function toggleTheme(){
  const next = currentTheme() === 'light' ? 'dark' : 'light';
  if(next === 'light') document.documentElement.setAttribute('data-theme', 'light');
  else document.documentElement.removeAttribute('data-theme');
  try{ localStorage.setItem('dashboardTheme', next); }catch(e){}
  applyThemeIcon();
}
document.getElementById('themeToggleBtnLogin').addEventListener('click', toggleTheme);
document.getElementById('themeToggleBtn').addEventListener('click', toggleTheme);
applyThemeIcon();

