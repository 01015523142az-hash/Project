function wireRmImportButton(btnId, textareaId, action, label){
  const btn = document.getElementById(btnId);
  if(!btn) return;
  btn.addEventListener('click', async () => {
    const csvText = $(textareaId).value;
    const msg = $('rmImportMsg');
    if(!csvText.trim()){ msg.textContent = 'Paste some CSV content first.'; msg.className = 'msg error'; return; }
    btn.disabled = true;
    const result = await callRmApi({ action, csvText });
    btn.disabled = false;
    if(!result.ok){ msg.textContent = result.error || `Failed to import ${label}.`; msg.className = 'msg error'; return; }
    msg.textContent = `Imported ${result.imported} row(s) from ${label}.`;
    msg.className = 'msg ok';
    logActivity('integration.import', 'readymode_csv', null, `Imported ${result.imported} row(s) of ReadyMode ${label}`);
  });
}
wireRmImportButton('rmImportCallsBtn', 'rmCallsCsv', 'import_calls_csv', 'Call Logs');
wireRmImportButton('rmImportResearchBtn', 'rmResearchCsv', 'import_research_csv', 'Research Calls');
wireRmImportButton('rmImportProductivityBtn', 'rmProductivityCsv', 'import_productivity_csv', 'Agent Report');

// v (user request, 2026-09-04): "upload list to readymode directly... dedup
// with leads on ispeedtolead to avoid duplicate address" -- pushing straight
// into ReadyMode itself needs their inbound Channel/TPI API access, which
// is still pending from their Integrations team (same outreach process as
// readymode-webhook's outbound side). This is the half that doesn't depend
// on that: checking a raw property list against every address iSpeedToLead
// already knows about (any PrimeHome Buyers submission, ANY status --
// iSpeedToLead's own rejection category "Duplicate address/phone number"
// fires on ANY prior submission of that address, not just accepted ones),
// before agents burn dial time on a property that would just bounce.
//
// State full-name -> USPS abbreviation, needed because our own stored
// addresses (extra_fields.form_address) sometimes carry the full state
// name (e.g. "Kentucky") while DealMachine/BatchLeads exports typically
// use the 2-letter code -- without this, otherwise-identical addresses
// would silently fail to match on state alone.
const RM_STATE_ABBR = {
  alabama:'al', alaska:'ak', arizona:'az', arkansas:'ar', california:'ca', colorado:'co',
  connecticut:'ct', delaware:'de', florida:'fl', georgia:'ga', hawaii:'hi', idaho:'id',
  illinois:'il', indiana:'in', iowa:'ia', kansas:'ks', kentucky:'ky', louisiana:'la',
  maine:'me', maryland:'md', massachusetts:'ma', michigan:'mi', minnesota:'mn',
  mississippi:'ms', missouri:'mo', montana:'mt', nebraska:'ne', nevada:'nv',
  'new hampshire':'nh', 'new jersey':'nj', 'new mexico':'nm', 'new york':'ny',
  'north carolina':'nc', 'north dakota':'nd', ohio:'oh', oklahoma:'ok', oregon:'or',
  pennsylvania:'pa', 'rhode island':'ri', 'south carolina':'sc', 'south dakota':'sd',
  tennessee:'tn', texas:'tx', utah:'ut', vermont:'vt', virginia:'va', washington:'wa',
  'west virginia':'wv', wisconsin:'wi', wyoming:'wy', 'district of columbia':'dc',
};
const RM_STREET_TYPE_ABBR = {
  street:'st', avenue:'ave', av:'ave', boulevard:'blvd', drive:'dr', road:'rd', lane:'ln',
  court:'ct', place:'pl', circle:'cir', terrace:'ter', trail:'trl', parkway:'pkwy',
  highway:'hwy', square:'sq', crossing:'xing', north:'n', south:'s', east:'e', west:'w',
};
function rmExtractZip5(address){
  const m = String(address || '').match(/\b(\d{5})(?:-\d{4})?\b/);
  return m ? m[1] : '';
}
// Normalizes a full address string (or just the street portion) into a
// stable comparison form: lowercase, punctuation stripped, unit/apt/suite
// fragments dropped (the unit is never what makes iSpeedToLead treat two
// submissions as the same property -- the street address is), then every
// word run through the street-type map, plus the state map applied at the
// STATE POSITION only, so "123 North Main Street, Cranston, Rhode Island"
// and "123 N Main St, Cranston, RI" normalize identically.
//
// BUG FIX (user request, 2026-09-11): the state map used to be applied to
// EVERY word, which quietly mangled any street or city named after a state
// -- and in this data that is nearly every occurrence of a state word.
// "3024 Florida St" became "3024 fl st", "Kansas City MO" became "ks city
// mo", "Oklahoma City OK" became "ok city ok". Harmless while both sides of
// a comparison were mangled identically, but it is a standing false-merge
// risk anywhere a key is compared across sources, and it made the keys
// unreadable when debugging a duplicate.
// A state appears exactly once, at the end (before any zip), so that is the
// only place it is now looked for -- everything earlier in the string is
// left as written.
//
// Second bug fixed by the same restructure: the street-type pass used to run
// BEFORE the two-word state lookup, so "west virginia" was already "w
// virginia" by the time the state map saw it and never matched. "West
// Virginia" normalized to "w va" instead of "wv" (same for North/South
// Carolina). The state tokens are now resolved from the RAW words and are
// exempt from the street-type map entirely.
//
// Verified over all 2310 distinct production addresses: 62 keys corrected,
// ZERO new merges and ZERO new splits -- i.e. no dedupe DECISION changes,
// only the normalized form. That matters because this key also guards the
// ReadyMode duplicate-push path, where a false merge suppresses a real lead.
function normalizeAddressForDedupe(address){
  if(!address) return '';
  let s = String(address).toLowerCase().replace(/[.#]/g, ' ').replace(/,/g, ' ');
  s = s.replace(/\b(apt|apartment|unit|suite|ste)\s*\S*/g, ' ');
  const words = s.split(/\s+/).filter(Boolean);
  // A trailing country is noise ("..., MS 39047, USA") and would otherwise
  // sit where the state is expected.
  while(words.length && (words[words.length - 1] === 'usa' || words[words.length - 1] === 'us')) words.pop();
  // The state sits at the end, or immediately before a trailing zip.
  let stateEnd = words.length - 1;
  if(stateEnd >= 0 && /^\d{5}(-\d{4})?$/.test(words[stateEnd])) stateEnd--;
  // Multi-word state names ("new york", "rhode island", ...) get a two-word
  // check before falling back to the single-word map.
  let stateStart = -1, stateAbbr = '';
  if(stateEnd >= 1){
    const two = words[stateEnd - 1] + ' ' + words[stateEnd];
    if(RM_STATE_ABBR[two]){ stateAbbr = RM_STATE_ABBR[two]; stateStart = stateEnd - 1; }
  }
  if(stateStart === -1 && stateEnd >= 0 && RM_STATE_ABBR[words[stateEnd]]){
    stateAbbr = RM_STATE_ABBR[words[stateEnd]];
    stateStart = stateEnd;
  }
  const out = words.map((w, i) => (stateStart !== -1 && i >= stateStart && i <= stateEnd) ? null : (RM_STREET_TYPE_ABBR[w] || w));
  if(stateStart !== -1){
    out[stateStart] = stateAbbr;
    for(let i = stateStart + 1; i <= stateEnd; i++) out[i] = null;
  }
  return out.filter(w => w !== null).join(' ').replace(/\s+/g, ' ').trim();
}
// The actual dedupe key: normalized street address + zip when a zip is
// available on both sides (the strongest signal -- immune to city/state
// spelling drift), falling back to the full normalized string otherwise.
function rmDedupeKey(address){
  const zip = rmExtractZip5(address);
  const full = normalizeAddressForDedupe(address);
  if(!zip) return full;
  const streetOnly = full.split(zip)[0].trim() || full;
  return `${streetOnly}|${zip}`;
}

// ===== One definition of "an agent earned credit for this lead" =====
// v (user request, 2026-09-11): Activity -> Staff Activity and the payroll /
// bonus figure in Reports used to answer that question DIFFERENTLY, which is
// how the same agent could read 3 in one place and 10 in the other. Both now
// go through these two helpers, so the two reports cannot drift apart again
// without someone editing this block on purpose.
//
// A rejection categorised exactly "Duplicate address/phone number" counts as
// ACCEPTED. It is not a bad lead -- iSpeedToLead's own Lead Summary on these
// routinely reads "Good Lead" -- it merely already existed in their system,
// often because another agent (or an earlier resubmission) got there first.
// Docking the agent who genuinely found it would be wrong. NOTE this now
// applies to PAY as well, which reverses the original decision to scope it to
// Staff Activity alone; that was changed deliberately and on request.
// Matched on reject_reason_category (the short category iSpeedToLead returns)
// and never on review_note, which carries the elaborated summary text and
// would stop matching the moment that wording drifts.
const LEAD_DUPLICATE_REJECT_CATEGORY = 'Duplicate address/phone number';
function leadCountsAsAccepted(lead){
  if(!lead) return false;
  if(lead.status === 'accepted') return true;
  return lead.status === 'rejected' && lead.reject_reason_category === LEAD_DUPLICATE_REJECT_CATEGORY;
}

// A lead is a PROPERTY, so credit is deduped per property, never per phone --
// one owner routinely sells several houses and they are separate leads.
// Built on rmDedupeKey() (normalized street + zip) so this agrees with the
// ReadyMode/iSpeedToLead dedupe about what "the same property" means.
//
// The extra collapse: "3774 Tessland Road Rd" is a real production typo that
// rmDedupeKey turns into "3774 tessland rd rd" (it maps "road"->"rd" and
// leaves the duplicate), which would not match "3774 Tessland Rd" -- the same
// property counted twice. Only a repeated ADJACENT STREET-TYPE token is
// collapsed, which is never a legitimate address; collapsing any repeated
// word would corrupt real names like the city of Walla Walla. This lives here
// rather than inside rmDedupeKey() itself because that key also guards the
// ReadyMode duplicate-push path, where widening "the same property" can
// suppress a genuine lead -- the more expensive mistake.
//
// Phone is a LAST-RESORT key for a row carrying no address at all: without an
// address there is no property identity to compare. Theoretical today --
// form_address is populated on 100% of leads.
const LEAD_STREET_TYPE_TOKENS = new Set(Object.values(RM_STREET_TYPE_ABBR));
function collapseRepeatedStreetType(key){
  return key.split(' ').filter((t, i, arr) => !(i > 0 && t === arr[i - 1] && LEAD_STREET_TYPE_TOKENS.has(t))).join(' ');
}
function leadPropertyKey(address, phoneNorm){
  const addr = String(address || '').trim();
  if(addr) return 'a:' + collapseRepeatedStreetType(rmDedupeKey(addr));
  return phoneNorm ? 'p:' + phoneNorm : '';
}

// v: and the COUNTING itself, once, for the same reason the two rules above
// are shared. Three places ask "how many leads has this agent earned credit
// for" -- the payroll/bonus figure, and the "Leads today"/"Leads this month"
// readouts on a user's detail card -- and they answered it three different
// ways, which is the whole class of bug this pass exists to end.
//
// The address arrives via a JSON-key select rather than the whole
// extra_fields blob: those rows carry ~25 keys each including long free-text
// notes, and these queries can span an agent's entire month.
const CREDITED_LEAD_COLS = 'id, count, status, reject_reason_category, seller_phone_norm, '
  + 'addr:extra_fields->>form_address, addr_alt:extra_fields->>property_address';

// Callers fetch with .in('status', CREDITED_LEAD_STATUSES) and let
// leadCountsAsAccepted() make the real decision here -- deciding it in code
// rather than in a server-side filter, because RLS makes such a filter hard to
// verify from outside and one that silently excluded rows would undercount.
const CREDITED_LEAD_STATUSES = ['accepted', 'rejected'];

function creditedLeadCount(rows){
  const seen = new Set();
  return (rows || []).reduce((total, r) => {
    if(!leadCountsAsAccepted(r)) return total;
    const key = leadPropertyKey(r.addr || r.addr_alt, r.seller_phone_norm);
    if(key){
      if(seen.has(key)) return total;
      seen.add(key);
    }
    // `count` is summed rather than counting rows: it is 1 on every row today,
    // but the column exists so one submission can stand for several leads.
    return total + (r.count || 0);
  }, 0);
}

// v582: returns a Map on success and NULL on failure -- the caller MUST fail
// closed on null rather than treating an empty result as "nothing matched".
//
// This used to read leadsPrimeHomeBuyersFormId, which is assigned in exactly
// one place: inside loadLeads(), which only runs when the Leads TAB is
// opened. So going straight to Campaigns -> ReadyMode Upload List without
// visiting Leads first left it null, this returned an EMPTY map, and every
// row in the file reported "Clean" against a check that had silently
// compared against nothing. That is worse than no check at all, because the
// preview looks healthy -- and it is the same failure that pushed 682
// duplicate leads through the PrimeHome importer until that one was fixed
// this same way. Moving this card into Campaigns (v574) made it far easier
// to hit, since staff can now reach it without ever touching Leads.
async function rmFetchKnownIspeedtoleadAddresses(){
  // Every PrimeHome Buyers submission, any status -- see header comment
  // above for why status doesn't matter here. Paginated in chunks since
  // this can be a few thousand rows.
  const byKey = new Map(); // dedupeKey -> { address, status }
  // Resolved independently of loadLeads(): this helper checks leadsAllForms,
  // then queries, then creates the form as a last resort.
  const formId = await getIspdDefaultCampaignFormId();
  if(!formId) return null;
  const PAGE = 1000;
  for(let from = 0; ; from += PAGE){
    const { data, error } = await sb.from('leads')
      .select('status, extra_fields')
      .eq('submission_form_id', formId)
      .range(from, from + PAGE - 1);
    // A query error mid-pagination would otherwise return a PARTIAL map,
    // which under-reports duplicates just as silently. Fail closed.
    if(error) return null;
    if(!data || !data.length) break;
    data.forEach(r => {
      const addr = (r.extra_fields || {}).form_address;
      if(!addr) return;
      const key = rmDedupeKey(addr);
      if(key && !byKey.has(key)) byKey.set(key, { address: addr, status: r.status });
    });
    if(data.length < PAGE) break;
  }
  return byKey;
}

// v582: the second dedupe source -- leads THIS dashboard has already pushed
// into ReadyMode. The iSpeedToLead check above only knows the PrimeHome
// Buyers pipeline, so a list that overlaps one already sent to a ReadyMode
// channel read entirely "Clean" and got pushed a second time. Nothing had
// prevented that; the only reason it had not happened yet is that each list
// so far happened to be distinct (verified: 0 repeats across 11,541 pushes
// to Mississippi Trial Number 1).
//
// Every channel is checked, not just the one selected below, and the match
// reports WHICH channel it went to -- pushing the same property into a second
// campaign is worth seeing rather than silently allowing. Same null-on-error
// contract as above.
async function rmFetchPreviouslyPushedAddresses(){
  const byKey = new Map(); // dedupeKey -> { channel, pushedAt, address }
  const PAGE = 1000;
  for(let from = 0; ; from += PAGE){
    const { data, error } = await sb.from('readymode_lead_pushes')
      .select('channel_name, pushed_at, address, city, state, zip')
      .eq('success', true)
      .range(from, from + PAGE - 1);
    if(error) return null;
    if(!data || !data.length) break;
    data.forEach(r => {
      const full = [r.address, r.city, r.state, r.zip].filter(Boolean).join(', ');
      const key = rmDedupeKey(full);
      if(!key) return;
      const prev = byKey.get(key);
      // Keep the most recent push, so the preview shows the latest send.
      if(!prev || String(r.pushed_at || '') > String(prev.pushedAt || '')){
        byKey.set(key, { channel: r.channel_name, pushedAt: r.pushed_at, address: full });
      }
    });
    if(data.length < PAGE) break;
  }
  return byKey;
}

function rmCsvDownload(filename, headerRow, rows){
  const esc = v => `"${String(v == null ? '' : v).replace(/"/g, '""')}"`;
  const lines = [headerRow.map(esc).join(',')].concat(rows.map(r => r.map(esc).join(',')));
  const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
}

let rmListCheckResult = null; // { headerRow, results: [{cells, isDup, pushedBefore, isClean, matchedStatus, lead}] }
// Parsed file, held between "choose a file" and "Run dedupe check" so the
// uploader can adjust the column mapping before anything is checked.
let rmListParsed = null; // { headerRow, dataRows, detectedSource }

const RM_MAP_FIELDS = [
  { key: 'address', label: 'Address', required: true, hint: 'street, or a full address' },
  { key: 'city', label: 'City' },
  { key: 'state', label: 'State' },
  { key: 'zip', label: 'Zip' },
  { key: 'firstName', label: 'First name' },
  { key: 'lastName', label: 'Last name' },
  { key: 'fullName', label: 'Full name', hint: 'split, if no first/last' },
  { key: 'phone', label: 'Phone', hint: 'required to push' },
  { key: 'phone2', label: 'Phone 2' },
  { key: 'email', label: 'Email' },
];

// Builds one <select> per mappable field, listing every column in the file.
// Option value is the column index; -1 means "not mapped".
function rmRenderMapGrid(headerRow, detected){
  const grid = $('rmListMapGrid');
  if(!grid) return;
  const options = (selectedIdx) => ['<option value="-1"' + (selectedIdx === -1 ? ' selected' : '') + '>-- none --</option>']
    .concat(headerRow.map((h, i) => {
      const label = String(h || '').trim() || ('(unnamed column ' + (i + 1) + ')');
      return '<option value="' + i + '"' + (i === selectedIdx ? ' selected' : '') + '>' + escapeHtml(label) + '</option>';
    })).join('');
  grid.innerHTML = RM_MAP_FIELDS.map(f => `
    <div>
      <label style="display:block; margin:0 0 3px; font-size:11px; color:var(--text-dim);">
        ${escapeHtml(f.label)}${f.required ? ' <span style="color:var(--danger);">*</span>' : ''}${f.hint ? ` <span style="opacity:0.75;">(${escapeHtml(f.hint)})</span>` : ''}
      </label>
      <select class="rm-map-select" data-map-field="${f.key}" style="width:100%;">${options(typeof detected[f.key] === 'number' ? detected[f.key] : -1)}</select>
    </div>
  `).join('');
  grid.querySelectorAll('.rm-map-select').forEach(sel => sel.addEventListener('change', rmRenderMapSample));
  rmRenderMapSample();
}

function rmReadMapping(){
  const map = {};
  RM_MAP_FIELDS.forEach(f => { map[f.key] = -1; });
  document.querySelectorAll('#rmListMapGrid .rm-map-select').forEach(sel => {
    const n = parseInt(sel.value, 10);
    map[sel.dataset.mapField] = Number.isFinite(n) ? n : -1;
  });
  return map;
}

// Shows what the current mapping actually produces for the first data row --
// the quickest way to catch a mapping that is subtly wrong (a mailing address
// sitting where the property address should be) before running a whole file.
function rmRenderMapSample(){
  const el = $('rmListMapSample');
  if(!el || !rmListParsed || !rmListParsed.dataRows.length) return;
  const map = rmReadMapping();
  const row = rmListParsed.dataRows[0];
  const val = (i) => i > -1 ? String(row[i] || '').trim() : '';
  const addr = [val(map.address), val(map.city), val(map.state), val(map.zip)].filter(Boolean).join(', ');
  let who = [val(map.firstName), val(map.lastName)].filter(Boolean).join(' ');
  if(!who && map.fullName > -1) who = val(map.fullName);
  el.innerHTML = 'First row reads as &rarr; address: <span style="color:var(--text-2);">'
    + (addr ? escapeHtml(addr) : '<span style="color:var(--danger);">nothing -- pick an Address column</span>')
    + '</span> &nbsp;|&nbsp; name: <span style="color:var(--text-2);">' + (who ? escapeHtml(who) : '--')
    + '</span> &nbsp;|&nbsp; phone: <span style="color:var(--text-2);">' + (val(map.phone) ? escapeHtml(val(map.phone)) : '--') + '</span>';
}

const rmListUploadInput = document.getElementById('rmListUploadInput');
if(rmListUploadInput) rmListUploadInput.addEventListener('change', async (e) => {
  const file = e.target.files[0];
  const msg = $('rmListUploadMsg');
  msg.style.display = 'none';
  $('rmListUploadResults').style.display = 'none';
  $('rmListMapCard').style.display = 'none';
  rmListParsed = null;
  rmListCheckResult = null;
  if(!file) return;
  try {
    const buf = await file.arrayBuffer();
    await ensureXlsx();
    const wb = XLSX.read(buf, { type: 'array' });
    const sheet = wb.Sheets[wb.SheetNames[0]];
    const rows = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '', raw: false });
    if(!rows.length){ msg.textContent = 'That file has no rows.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }
    const headerRow = rows[0].map(h => String(h || '').trim());
    const dataRows = rows.slice(1).filter(r => r.some(c => String(c || '').trim() !== ''));
    if(!dataRows.length){ msg.textContent = 'No data rows found below the header.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }

    const norm = s => String(s || '').trim().toLowerCase();
    const findCol = names => headerRow.findIndex(h => names.includes(norm(h)));
    // v578: auto-detection is now only a SUGGESTION -- it preselects the
    // dropdowns and the uploader confirms. Sources are still resolved as a
    // whole rather than alias-by-alias, because findCol returns whichever
    // matching header comes first in the FILE: a skip-trace export carries
    // both Mailing_Street_Address and Property_Street_Address, and a street
    // taken from one source with a city from another describes an address
    // that exists nowhere. Tried in order; first source with an address wins.
    const ADDR_SOURCES = [
      { name: 'DealMachine',
        line: ['associated_property_address_line_1'],
        full: ['associated_property_address_full'],
        city: ['associated_property_address_city'],
        state: ['associated_property_address_state'],
        zip: ['associated_property_address_zipcode'] },
      { name: 'skip trace (property)',
        line: ['property_street_address'],
        full: ['formated_address', 'formatted_address'],
        city: ['property_city'],
        state: ['property_state'],
        zip: ['property_zip_code'] },
      { name: 'generic',
        line: ['property address', 'property_address', 'address', 'street address', 'street_address', 'address_line1', 'address_line_1', 'situs address', 'situs_address'],
        full: ['property address full', 'full address'],
        city: ['property city', 'city'],
        state: ['property state', 'state'],
        zip: ['property zip', 'zip', 'zip code', 'zip_code', 'postal code'] },
      { name: 'mailing', mailing: true,
        line: ['mailing address', 'mailing_address', 'mailing_street_address'],
        full: ['mailing_formated_address'],
        city: ['mailing_city'],
        state: ['mailing_state'],
        zip: ['mailing_zip_code'] },
    ];
    const detected = { address: -1, city: -1, state: -1, zip: -1 };
    let detectedSource = null;
    for(const src of ADDR_SOURCES){
      const lineCol = findCol(src.line), fullCol = findCol(src.full);
      if(lineCol === -1 && fullCol === -1) continue;
      detectedSource = src.name;
      if(lineCol > -1){
        detected.address = lineCol;
        detected.city = findCol(src.city); detected.state = findCol(src.state); detected.zip = findCol(src.zip);
        // A source may name its street column but leave city/state/zip on
        // plain unprefixed headers. Filling those from the generic names is
        // safe because they are not owned by a competing source -- but NOT
        // when the mailing block won, where a bare "City" is most likely the
        // property's and would re-introduce the mismatch described above.
        if(!src.mailing){
          if(detected.city === -1) detected.city = findCol(['property city', 'city']);
          if(detected.state === -1) detected.state = findCol(['property state', 'state']);
          if(detected.zip === -1) detected.zip = findCol(['property zip', 'zip', 'zip code', 'zip_code', 'postal code']);
        }
      } else {
        // A combined column already contains city/state/zip, so leave those
        // unmapped -- appending them again would duplicate that text in the
        // dedupe key.
        detected.address = fullCol;
      }
      break;
    }
    detected.firstName = findCol(['first_name', 'owner_first_name', 'owner first name', 'first name', 'firstname']);
    detected.lastName = findCol(['last_name', 'owner_last_name', 'owner last name', 'last name', 'lastname']);
    detected.fullName = findCol(['owner_name', 'owner name', 'seller name', 'name', 'full_name', 'full name']);
    detected.email = findCol(['email_address_1', 'email_1', 'email 1', 'email1', 'email']);
    // Phone columns -- covers DealMachine's numbered phone_1/phone_2 plus
    // BatchLeads'/generic aliases. NOTE: DealMachine also exports a per-phone
    // "phone_N_do_not_call" flag, deliberately NOT used to filter rows here --
    // ReadyMode runs its own DNC scrubbing account-side and DealMachine's flag
    // is not reliably current, so gating on it would both wrongly exclude
    // callable numbers and wrongly pass ones DealMachine has not caught.
    detected.phone = findCol(['phone_1', 'phone_number_1', 'phone 1', 'phone1', 'phone number 1', 'phone', 'phone number', 'primary phone', 'mobile']);
    detected.phone2 = findCol(['phone_2', 'phone_number_2', 'phone 2', 'phone2', 'phone number 2', 'secondary phone']);

    rmListParsed = { headerRow, dataRows, detectedSource };
    rmRenderMapGrid(headerRow, detected);
    $('rmListMapCard').style.display = 'block';
    msg.textContent = `Read ${dataRows.length} row(s) and ${headerRow.length} column(s).`
      + (detectedSource
          ? ` These headers look like a ${detectedSource} export, so the mapping below is pre-filled -- check it, then run the dedupe check.`
          : ' None of these headers were recognised automatically, so pick the columns below yourself, then run the dedupe check.');
    msg.className = detectedSource ? 'msg' : 'msg error';
    msg.style.display = 'block';
  } catch (err) {
    console.error('rmListUploadInput: failed to parse file:', err);
    msg.textContent = `Couldn't read that file: ${err instanceof Error ? err.message : String(err)}`;
    msg.className = 'msg error'; msg.style.display = 'block';
  } finally {
    e.target.value = '';
  }
});

document.getElementById('rmListRunCheckBtn')?.addEventListener('click', async () => {
  const msg = $('rmListUploadMsg');
  if(!rmListParsed){ msg.textContent = 'Choose a file first.'; msg.className = 'msg error'; msg.style.display = 'block'; return; }
  const map = rmReadMapping();
  if(map.address === -1){
    msg.textContent = 'Pick which column holds the address -- the dedupe check has nothing to compare without it.';
    msg.className = 'msg error'; msg.style.display = 'block'; return;
  }
  const { headerRow, dataRows } = rmListParsed;
  const btn = $('rmListRunCheckBtn');
  btn.disabled = true;
  try {
    msg.textContent = 'Checking against iSpeedToLead and previous ReadyMode pushes...';
    msg.className = 'msg'; msg.style.display = 'block';

    // Both sources fail CLOSED: a null means the check could not be run, and
    // reporting every row "Clean" off the back of that is how duplicates get
    // pushed. Refuse the run instead of producing a confident wrong answer.
    const knownByKey = await rmFetchKnownIspeedtoleadAddresses();
    if(!knownByKey){
      msg.textContent = "Couldn't load the known iSpeedToLead addresses, so the dedupe check cannot run -- nothing has been checked. Open the Leads tab once and try again; if it keeps failing, your role may not have access to the PrimeHome Buyers campaign.";
      msg.className = 'msg error'; msg.style.display = 'block'; return;
    }
    const pushedByKey = await rmFetchPreviouslyPushedAddresses();
    if(!pushedByKey){
      msg.textContent = "Couldn't load the ReadyMode push history, so the dedupe check cannot run -- nothing has been checked. Try again in a moment.";
      msg.className = 'msg error'; msg.style.display = 'block'; return;
    }

    const cell = (r, i) => i > -1 ? String(r[i] || '').trim() : '';
    const results = dataRows.map(r => {
      const rawAddr = cell(r, map.address);
      const city = cell(r, map.city);
      const state = cell(r, map.state);
      const zip = cell(r, map.zip);
      // City/State/Zip left unmapped collapses this to the address column on
      // its own, which is exactly what a combined "full address" column wants.
      const fullAddr = [rawAddr, city, state, zip].filter(Boolean).join(', ');
      const key = rmDedupeKey(fullAddr || rawAddr);
      const match = key ? knownByKey.get(key) : null;
      const pushedMatch = key ? pushedByKey.get(key) : null;
      let firstName = cell(r, map.firstName);
      let lastName = cell(r, map.lastName);
      if(!firstName && !lastName && map.fullName > -1){
        const parts = cell(r, map.fullName).split(/\s+/);
        firstName = parts.shift() || '';
        lastName = parts.join(' ');
      }
      const lead = {
        firstName, lastName,
        phone: cell(r, map.phone),
        phone2: cell(r, map.phone2),
        email: cell(r, map.email),
        address: rawAddr, city, state, zip,
      };
      // isClean is the single source of truth for what gets pushed and what
      // lands in the "clean" download -- both reasons for exclusion feed it,
      // so adding a third source later cannot leave one of them behind.
      return {
        cells: r,
        rawAddr: fullAddr || rawAddr,
        isDup: !!match,
        pushedBefore: pushedMatch || null,
        isClean: !match && !pushedMatch,
        matchedStatus: match ? match.status : null,
        lead,
      };
    });

    rmListCheckResult = { headerRow, results };
    const dupCount = results.filter(r => r.isDup).length;
    const pushedCount = results.filter(r => r.pushedBefore).length;
    const cleanCount = results.filter(r => r.isClean).length;
    const noAddrCount = results.filter(r => !r.rawAddr).length;
    $('rmListStatTotal').textContent = String(results.length);
    $('rmListStatDup').textContent = String(dupCount);
    if($('rmListStatPushed')) $('rmListStatPushed').textContent = String(pushedCount);
    $('rmListStatClean').textContent = String(cleanCount);
    $('rmListPreviewBody').innerHTML = results.slice(0, 500).map(r => `
      <tr style="border-top:1px solid var(--border-light);">
        <td style="padding:5px 8px;">${escapeHtml(r.rawAddr)}</td>
        <td style="padding:5px 8px; ${r.isClean ? 'color:var(--focus);' : 'color:var(--danger);'}">${r.isDup ? 'In iSpeedToLead' : (r.pushedBefore ? 'Already pushed' : 'Clean')}</td>
        <td style="padding:5px 8px; color:var(--text-dim);">${r.isDup
          ? escapeHtml(r.matchedStatus || 'known lead')
          : (r.pushedBefore
              ? escapeHtml(`${r.pushedBefore.channel || 'ReadyMode'}${r.pushedBefore.pushedAt ? ' \u2014 ' + new Date(r.pushedBefore.pushedAt).toLocaleDateString() : ''}`)
              : '&mdash;')}</td>
      </tr>
    `).join('') + (results.length > 500 ? `<tr><td colspan="3" style="padding:6px 8px; color:var(--text-dim);">... and ${results.length - 500} more row(s), not shown here but included in the downloads below.</td></tr>` : '');
    $('rmListUploadResults').style.display = 'block';
    $('rmListPushMsg').style.display = 'none';
    $('rmListPushResults').style.display = 'none';
    msg.textContent = `Checked ${results.length} row(s) against ${knownByKey.size} known iSpeedToLead address(es) and ${pushedByKey.size} address(es) already pushed to ReadyMode -- ${cleanCount} clean, ${dupCount} already in iSpeedToLead, ${pushedCount} already pushed to a ReadyMode channel.`
      + (noAddrCount ? ` ${noAddrCount} row(s) had nothing in the mapped Address column and could not be checked -- they are counted as clean, so re-check the mapping if that number looks wrong.` : '')
      + (map.phone > -1 ? '' : ' Note: no Phone column is mapped -- ReadyMode requires a phone per lead, so "Push clean list to ReadyMode" will reject every row until you map one.');
    msg.className = 'msg ok';
  } catch (err) {
    console.error('rmListRunCheckBtn: dedupe check failed:', err);
    msg.textContent = `Couldn't run the check: ${err instanceof Error ? err.message : String(err)}`;
    msg.className = 'msg error'; msg.style.display = 'block';
  } finally {
    btn.disabled = false;
  }
});

document.getElementById('rmListDownloadCleanBtn')?.addEventListener('click', () => {
  if(!rmListCheckResult) return;
  const clean = rmListCheckResult.results.filter(r => r.isClean).map(r => r.cells);
  if(!clean.length){ alert('Nothing to download — every row was flagged as a duplicate.'); return; }
  rmCsvDownload('readymode-upload-clean.csv', rmListCheckResult.headerRow, clean);
  logActivity('integration.readymode_list_dedupe', null, null, `Downloaded a cleaned ReadyMode upload list (${clean.length} row(s), duplicates removed)`);
});
document.getElementById('rmListDownloadDupBtn')?.addEventListener('click', () => {
  if(!rmListCheckResult) return;
  const dups = rmListCheckResult.results.filter(r => !r.isClean).map(r => r.cells);
  if(!dups.length){ alert('No duplicates were flagged.'); return; }
  rmCsvDownload('readymode-upload-duplicates.csv', rmListCheckResult.headerRow, dups);
});

// Pushes the dedupe-checked clean rows straight into ReadyMode via the
// confirmed Create Lead TPI endpoint (readymode-api's
// post_leads_batch action) -- see that action's own header comment for the
// endpoint/auth details. Each ReadyMode campaign is its own named Channel
// with its own posting URL (see the "Lead-posting channels" card above),
// so the channel/campaign has to be picked explicitly here rather than
// assumed from whatever account domain happens to be typed in.
document.getElementById('rmListPushBtn')?.addEventListener('click', async () => {
  if(!rmListCheckResult) return;
  const channelSelect = $('rmListChannelSelect');
  const channelName = channelSelect ? channelSelect.value : '';
  const selectedOption = channelSelect && channelSelect.selectedIndex > -1 ? channelSelect.options[channelSelect.selectedIndex] : null;
  const accountDomain = selectedOption ? (selectedOption.dataset.domain || '') : '';
  const pushMsg = $('rmListPushMsg');
  const pushResults = $('rmListPushResults');
  pushResults.style.display = 'none';
  if(!channelName || !accountDomain){
    pushMsg.textContent = 'Pick a channel/campaign to push into first — save one in the "Lead-posting channels" card above if the dropdown is empty.';
    pushMsg.className = 'msg error'; pushMsg.style.display = 'block';
    return;
  }
  const cleanLeads = rmListCheckResult.results.filter(r => r.isClean).map(r => r.lead);
  if(!cleanLeads.length){ alert('Nothing to push — every row was flagged as a duplicate.'); return; }
  const withPhone = cleanLeads.filter(l => l.phone);
  if(!withPhone.length){
    pushMsg.textContent = 'None of the clean rows have a callable phone number — ReadyMode requires one per lead, so there\'s nothing postable here.';
    pushMsg.className = 'msg error'; pushMsg.style.display = 'block';
    return;
  }
  if(!confirm(`Push ${withPhone.length} lead(s) into ReadyMode's "${channelName}" channel now? This creates real leads in your ReadyMode dialer account.`)) return;

  const btn = document.getElementById('rmListPushBtn');
  btn.disabled = true;
  pushMsg.className = 'msg'; pushMsg.style.display = 'block';

  // readymode-api's post_leads_batch caps a single call at 5000 leads (and,
  // more importantly, does ~1 sequential ReadyMode HTTP request per 25
  // leads inside one edge-function invocation -- a real 5000-lead call
  // would be ~200 sequential fetches in one invocation, close to Supabase's
  // execution time limit). Chunking client-side at 500/call keeps each
  // invocation well under that, and lets progress show as it goes for a
  // list this size (e.g. a real ~9,800-row DealMachine export).
  const CLIENT_CHUNK = 500;
  let succeeded = 0, failed = 0;
  const allFailures = [];
  let stoppedEarly = null;
  for(let offset = 0; offset < withPhone.length; offset += CLIENT_CHUNK){
    const chunk = withPhone.slice(offset, offset + CLIENT_CHUNK);
    pushMsg.textContent = `Pushing lead(s) ${offset + 1}-${offset + chunk.length} of ${withPhone.length} to ReadyMode ("${channelName}")…`;
    const result = await callRmApi({ action: 'post_leads_batch', accountDomain, channelName, leads: chunk });
    if(!result.ok){
      stoppedEarly = result.error || 'Failed to push leads to ReadyMode.';
      break;
    }
    succeeded += result.succeeded;
    failed += result.failed;
    allFailures.push(...(result.results || []).filter(r => !r.success));
  }
  btn.disabled = false;

  const attempted = succeeded + failed;
  if(stoppedEarly){
    pushMsg.textContent = `Stopped after pushing ${attempted} of ${withPhone.length} lead(s) (${succeeded} succeeded, ${failed} failed) — ${stoppedEarly}. Leads already pushed are recorded in "Lead push history" below; re-run to pick up where this left off (already-pushed rows aren't tracked for skip-on-retry, so remove them from the file first if you don't want duplicates in ReadyMode).`;
    pushMsg.className = 'msg error';
  } else {
    pushMsg.textContent = `Pushed ${attempted} lead(s) to "${channelName}" — ${succeeded} succeeded, ${failed} failed.`;
    pushMsg.className = failed ? 'msg' : 'msg ok';
  }
  logActivity('integration.readymode_list_push', null, null, `Pushed ${attempted} lead(s) to ReadyMode channel "${channelName}" via the Upload list dedupe tool — ${succeeded} succeeded, ${failed} failed${stoppedEarly ? ' (stopped early: ' + stoppedEarly + ')' : ''}`);
  loadRmLeadPushes();

  if(allFailures.length){
    pushResults.innerHTML = `
      <table class="mono" style="width:100%; font-size:11px; border-collapse:collapse;">
        <thead><tr><th style="text-align:left; padding:6px 8px;">Phone</th><th style="text-align:left; padding:6px 8px;">Address</th><th style="text-align:left; padding:6px 8px;">Error</th></tr></thead>
        <tbody>
          ${allFailures.map(f => `
            <tr style="border-top:1px solid var(--border-light);">
              <td style="padding:5px 8px;">${escapeHtml(f.input?.phone || '—')}</td>
              <td style="padding:5px 8px;">${escapeHtml(f.input?.address || '—')}</td>
              <td style="padding:5px 8px; color:var(--danger);">${escapeHtml(f.error || 'Rejected')}</td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
    pushResults.style.display = 'block';
  }
});

// v1.2.36: audit list for the automated Mailgun -> readymode-email-import
// pipeline, so a silently-broken or never-arriving report email is visible
// in the dashboard instead of only discoverable by noticing stale data.
async function loadRmEmailImports(){
  const box = $('rmEmailImportsList');
  if(!box) return;
  box.innerHTML = '<div class="empty">Loading…</div>';
  const result = await callRmApi({ action: 'list_email_imports', limit: 20 });
  if(!result.ok){ box.innerHTML = `<div class="msg error">${escapeHtml(result.error || 'Failed to load import history.')}</div>`; return; }
  const imports = result.imports || [];
  if(!imports.length){ box.innerHTML = '<div class="empty">No automated imports received yet. Once a ReadyMode Automated Task email arrives via Mailgun, it\'ll show up here.</div>'; return; }
  const reportLabel = { calls: 'Call Logs', agent_daily: 'Agent Report', unknown: 'Unrecognized' };
  box.innerHTML = `
    <table>
      <thead><tr><th>Received</th><th>Report</th><th>File</th><th>Rows</th><th>Imported</th><th>Status</th></tr></thead>
      <tbody>
        ${imports.map(i => `
          <tr>
            <td style="color:var(--text-2); white-space:nowrap;">${new Date(i.received_at).toLocaleString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {})}</td>
            <td>${escapeHtml(reportLabel[i.report_type] || i.report_type)}</td>
            <td style="color:var(--text-2);">${escapeHtml(i.filename || '—')}</td>
            <td>${i.row_count}</td>
            <td>${i.imported_count}</td>
            <td>
              ${i.status === 'ok'
                ? '<span style="color:var(--focus);">OK</span>'
                : `<span style="color:#e5484d;" title="${escapeHtml(i.error || '')}">Error${i.error ? ': ' + escapeHtml(i.error.slice(0, 60)) : ''}</span>`}
            </td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  `;
}

const rmRefreshEmailImportsBtn = document.getElementById('rmRefreshEmailImportsBtn');
if(rmRefreshEmailImportsBtn) rmRefreshEmailImportsBtn.addEventListener('click', () => loadRmEmailImports());

// Permanent audit trail for post_leads_batch (see that action's own
// comment in readymode-api/index.ts) -- independent of whatever
// ReadyMode's own optional "Lead Post Email Notifications" does.
async function loadRmLeadPushes(){
  const box = $('rmLeadPushesList');
  if(!box) return;
  box.innerHTML = '<div class="empty">Loading…</div>';
  const result = await callRmApi({ action: 'list_lead_pushes', limit: 100 });
