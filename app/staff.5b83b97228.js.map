  $('ispeedtoleadModalStatus').style.display = 'none';
  Object.keys(ISPEEDTOLEAD_ATTACHMENT_FIELDS).forEach(fieldKey => refreshIspeedtoleadAttachmentList(lead.id, fieldKey));
  await refreshIspeedToLeadModalStatus(lead.id);
  $('ispeedtoleadModalOverlay').classList.add('active');
}
function closeIspeedToLeadModal(){
