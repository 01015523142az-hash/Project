let chatNewGroupSelected = new Set();
function chatRenderGroupPicker(container, directory, selected, cap, excludeIds, onToggle){
  const search = ($('chatNewGroupSearch') && container === $('chatNewGroupPicker') ? $('chatNewGroupSearch').value : ($('chatAddMemberSearch') ? $('chatAddMemberSearch').value : '')).trim().toLowerCase();
  const list = directory.filter(p => !excludeIds.has(p.id) && (!search || (p.full_name || p.email || '').toLowerCase().includes(search)));
  container.innerHTML = list.map(p => `
    <label class="chat-picker-checkbox-row">
      <input type="checkbox" data-id="${p.id}" ${selected.has(p.id) ? 'checked' : ''}>
      ${chatAvatarHtml(p.id, p.full_name || p.email, 26, false)}
      <span>${escapeHtml(p.full_name || p.email)}${p.role ? ` <span style="color:var(--text-dim);">\u00b7 ${escapeHtml(roleDisplayLabel(p.role))}</span>` : ''}</span>
    </label>
  `).join('') || '<div class="empty" style="padding:8px;">No one matches.</div>';
  container.querySelectorAll('input[type=checkbox]').forEach(cb => {
    cb.addEventListener('change', () => {
      if(cb.checked && selected.size >= cap){
        cb.checked = false;
        alert(`A group can have at most ${cap + excludeIds.size} members total.`);
        return;
      }
      if(cb.checked) selected.add(cb.dataset.id); else selected.delete(cb.dataset.id);
      onToggle();
    });
  });
}
