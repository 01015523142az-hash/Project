// ===========================================================================
// v776: ONE description of every grantable permission, used by four things
// that used to each carry their own copy of the same list — the User Types
// editor, the per-person editor, the Save handler, and the "may I hand this
// out?" ceiling check. Adding a subtab means adding it to its *_SECTIONS
// array and nothing else.
//
// Built by a function rather than a const because FINANCE_SECTIONS,
// HR_SECTIONS, TAXES_SECTIONS and DIALER_ADMIN_SECTIONS are declared much
// further down this file; by the time anything calls this, they all exist.
// ===========================================================================
function permissionFamilies(){
  const alwaysEdit = () => true;
  const perSectionEdit = (sec) => !!sec.editable;
  return [
    { tab: 'time_management', family: 'time_management_sections', prop: 'timeManagementSections', cls: 'tm-section',
      sections: TIME_MANAGEMENT_SECTIONS, viewDefault: timeManagementSectionDefault, editDefault: () => true,
      hasEdit: perSectionEdit,
      note: 'Dashboard is view-only for every user type — editing there follows "Can manage users", which is Owner/Admin only.' },
    { tab: 'leads', family: 'leads_sections', prop: 'leadsSections', cls: 'leads-section',
      sections: LEADS_SECTIONS, viewDefault: leadsSectionDefault, editDefault: leadsSectionDefault, hasEdit: alwaysEdit,
      note: 'View/Edit here is the whole story — there is no separate whole-tab Edit toggle. Deleting a lead stays Owner/Admin only.' },
    { tab: 'call_activity', family: 'activity_sections', prop: 'activitySections', cls: 'activity-section',
      sections: (typeof ACTIVITY_SECTIONS !== 'undefined' ? ACTIVITY_SECTIONS.filter(x => x.group !== 'gmail') : []),
      viewDefault: activitySectionDefault, editDefault: () => false, hasEdit: () => false,
      groups: (typeof ACTIVITY_GROUPS !== 'undefined' ? ACTIVITY_GROUPS.filter(g => g.key !== 'gmail') : null),
      note: 'Every report here is read-only, so there is no Edit column. The Gmail Inbox follows "Can text clients" instead.' },
    { tab: 'dialer_admin', family: 'dialer_admin_sections', prop: 'dialerAdminSections', cls: 'da-section',
      sections: DIALER_ADMIN_SECTIONS, viewDefault: dialerAdminSectionDefault, editDefault: dialerAdminEditSectionDefault,
      hasEdit: perSectionEdit,
      note: 'Saving also sets the database\u2019s own dialer rights to match. Ordering phone numbers stays Owner/Admin only.' },
    { tab: 'client_submissions', family: 'csub_sections', prop: 'csubSections', cls: 'csub-section',
      sections: CSUB_SECTIONS, viewDefault: csubSectionDefault, editDefault: csubEditSectionDefault, hasEdit: alwaysEdit,
      note: 'Delete and Export CSV on every subtab stay Owner/Admin only, whatever is ticked here.' },
    { tab: 'usermanagement', family: 'um_sections', prop: 'umSections', cls: 'um-section',
      sections: UM_SECTIONS, viewDefault: umSectionDefault, editDefault: umSectionDefault, hasEdit: alwaysEdit,
      note: 'User Types is the section that hands out further access — whoever has it can only ever grant what they hold themselves.' },
    { tab: 'finance', family: 'finance_sections', prop: 'financeSections', cls: 'finance-section',
      sections: FINANCE_SECTIONS, viewDefault: financeSectionDefault, editDefault: financeEditSectionDefault,
      hasEdit: perSectionEdit,
      note: 'Edit is what lets a user type actually charge, refund or change pricing. iSpeedToLead Postbacks is Owner-only and is not listed.' },
    { tab: 'hr', family: 'hr_sections', prop: 'hrSections', cls: 'hr-section',
      sections: HR_SECTIONS, viewDefault: hrSectionDefault, editDefault: hrEditSectionDefault, hasEdit: perSectionEdit,
      note: 'Candidate Submission\u2019s Edit is what lets somebody submit a candidate; Candidate Review\u2019s is what lets them approve or reject.' },
    { tab: 'data_science', family: 'data_science_sections', prop: 'dataScienceSections', cls: 'datasci-section',
      sections: DATA_SCIENCE_SECTIONS, viewDefault: () => dataSciSectionDefault(), editDefault: dataSciEditSectionDefault,
      hasEdit: alwaysEdit,
      note: 'List Builder and Overview are Owner/Admin only in the database too, so they are not grantable here.' },
    { tab: 'taxes', family: 'taxes_sections', prop: 'taxesSections', cls: 'taxes-section',
      sections: TAXES_SECTIONS, viewDefault: () => true, editDefault: () => false, hasEdit: () => false,
      note: 'All three are read-only reports, so there is no Edit column.' },
  ];
}
function permissionFamilyForTab(tabKey){
  return permissionFamilies().find(f => f.tab === tabKey) || null;
}

// --- the ceiling -----------------------------------------------------------
// "You can only hand out what the Owner handed you." myGrantCeiling is null
// for the Owner, which every function below reads as "no ceiling". The same
// rule is enforced in the database (enforce_role_grant_ceiling); these are
// only so the editor can disable the box and say why, instead of letting
// somebody tick it and then hit a save error.
function ceilingAllowsTab(key){
  if(!myGrantCeiling) return true;
  return (myGrantCeiling.allowedTabs || []).includes(key);
}
function ceilingAllowsTabEdit(key){
  if(!myGrantCeiling) return true;
  if(!ceilingAllowsTab(key)) return false;
  const v = myGrantCeiling.tab_edit ? myGrantCeiling.tab_edit[key] : undefined;
  return typeof v === 'boolean' ? v : true;   // tab_edit defaults open
}
function ceilingAllowsSection(fam, key, mode){
  if(!myGrantCeiling) return true;
  if(!ceilingAllowsTab(fam.tab)) return false;
  const map = myGrantCeiling[fam.family] || {};
  const cur = map[key];
  if(cur && typeof cur[mode] === 'boolean') return cur[mode];
  return mode === 'edit' ? !!fam.editDefault(key) : !!fam.viewDefault(key);
}
function ceilingAllowsFlag(name){
  if(!myGrantCeiling) return true;
  return !!myGrantCeiling[name];
}
const CEILING_TITLE = 'Only the Owner can grant this \u2014 it is not part of your own access.';

let allRoles = [];
let allViewableUsers = []; // every non-protected user, for the "which users can view" picker
let editingRoleName = null; // null = the form is creating a new role

// ===========================================================================
// v776: ONE permission matrix, rendered either for a user type or for one
// person. Replaces renderRoleTabsPicker, which built the same checkboxes but
// as a flat column with each subtab block indented under its tab and no
// column alignment, so View and Edit drifted away from their labels on the
// taller tabs. Same checkbox classes and data attributes as before, so the
// Save handlers keep finding them — but every query is now scoped to the
// container, because two matrices (one per pane) can exist at once.
//
// `values`   — { allowed_tabs: [], tab_edit: {}, <family>: {} }
// `opts`     — { inherited }  the user type's own values, when this matrix is
//              for one person: any box that differs gets a "Custom" tag so it
//              is obvious what is an exception and what is just inherited.
// ===========================================================================
function permMatrixEl(rootId){ return document.getElementById(rootId); }

function permSectionValue(values, fam, key, mode){
  const cur = (values[fam.family] || {})[key];
  if(cur && typeof cur[mode] === 'boolean') return cur[mode];
  return mode === 'edit' ? !!fam.editDefault(key) : !!fam.viewDefault(key);
}

function renderPermissionMatrix(rootId, values, opts){
  opts = opts || {};
  values = values || {};
  values.allowed_tabs = values.allowed_tabs || [];
  const root = permMatrixEl(rootId);
  if(!root) return;
  const inherited = opts.inherited || null;

  const cb = (cls, dataAttr, dataVal, checked, allowed, extraCls) => {
    const dis = allowed ? '' : ' disabled';
    const t = allowed ? '' : ` title="${CEILING_TITLE}"`;
    return `<input type="checkbox" class="perm-cb ${cls}${extraCls ? ' ' + extraCls : ''}" ${dataAttr}="${dataVal}" ${checked ? 'checked' : ''}${dis}${t}>`;
  };

  root.innerHTML = DASHBOARD_TAB_KEYS.map(t => {
    const fam = permissionFamilyForTab(t.key);
    const tabOn = values.allowed_tabs.includes(t.key);
    const tabAllowed = ceilingAllowsTab(t.key);
    const editOn = tabOn && values.tab_edit && values.tab_edit[t.key] !== false;
    const editAllowed = ceilingAllowsTabEdit(t.key);
    const sections = fam ? fam.sections : [];
    const granted = sections.filter(s => permSectionValue(values, fam, s.key, 'view')).length;

    // A tab whose subtabs are grouped (Activity) keeps its group headings.
    const rowsFor = (list) => list.map(s => {
      const viewOn = permSectionValue(values, fam, s.key, 'view');
      const viewAllowed = ceilingAllowsSection(fam, s.key, 'view');
      const hasEdit = fam.hasEdit(s);
      const editVal = hasEdit ? permSectionValue(values, fam, s.key, 'edit') : false;
      const editAllowedS = hasEdit ? ceilingAllowsSection(fam, s.key, 'edit') : false;
      let custom = false;
      if(inherited){
        const inhV = permSectionValue(inherited, fam, s.key, 'view');
        const inhE = hasEdit ? permSectionValue(inherited, fam, s.key, 'edit') : false;
        custom = (inhV !== viewOn) || (hasEdit && inhE !== editVal);
      }
      // The "Owner only" tag means "you cannot show this subtab at all".
      // When only Edit is beyond the grantor's reach, the disabled Edit box
      // and its tooltip say so on their own — tagging the whole row would
      // read as though View were blocked too, which it is not.
      const capped = !viewAllowed;
      return `
        <div class="perm-row${capped ? ' is-capped' : ''}">
          <div class="perm-row-label">${escapeHtml(s.label)}${custom ? ' <span class="perm-custom-tag">Custom</span>' : ''}${capped ? ' <span class="perm-capped-tag">Owner only</span>' : ''}</div>
          <div class="perm-cell">${cb(fam.cls + '-view-cb', 'data-section', s.key, viewOn, viewAllowed)}</div>
          <div class="perm-cell">${
            hasEdit ? cb(fam.cls + '-edit-cb', 'data-section', s.key, editVal, editAllowedS)
            : '<span class="perm-cell-note">view only</span>'
          }</div>
        </div>`;
    }).join('');

    const body = !fam ? '' : `
      <div class="perm-body" data-perm-body="${t.key}"${tabOn ? '' : ' style="display:none;"'}>
        ${fam.note ? `<div class="perm-note">${fam.note}</div>` : ''}
        ${fam.groups
          ? fam.groups.map(g => {
              const list = sections.filter(s => s.group === g.key);
              return list.length ? `<div class="perm-group-label">${escapeHtml(g.label)}</div>${rowsFor(list)}` : '';
            }).join('')
          : rowsFor(sections)}
      </div>`;

    return `
      <div class="perm-tab-card${tabOn ? '' : ' is-off'}" data-perm-tab-card="${t.key}">
        <div class="perm-tab-head${tabAllowed ? '' : ' is-capped'}">
          <div class="perm-tab-title">
            ${fam ? `<button type="button" class="perm-disclose" data-perm-disclose="${t.key}" aria-label="Show or hide subtabs">${tabOn ? '&#9662;' : '&#9656;'}</button>` : '<span class="perm-disclose"></span>'}
            <label style="display:flex; align-items:center; gap:8px; cursor:pointer; text-transform:none; font-family:var(--sans); letter-spacing:0; margin:0; min-width:0;">
              ${cb('role-tab-cb', 'data-tab', t.key, tabOn, tabAllowed)}
              <span class="perm-tab-name">${escapeHtml(t.label)}</span>
            </label>
            ${fam ? `<span class="perm-tab-count" data-perm-count="${t.key}">${granted}/${sections.length}</span>` : ''}
            ${tabAllowed ? '' : '<span class="perm-capped-tag">Owner only</span>'}
          </div>
          <div class="perm-col-label">${fam ? 'View' : ''}</div>
          <div class="perm-cell">${
            t.editable ? cb('role-tab-edit-cb', 'data-tab', t.key, editOn, editAllowed)
            : (fam ? '<span class="perm-col-label">Edit</span>' : '')
          }</div>
        </div>
        ${body}
      </div>`;
  }).join('');

  // Kept so permReadMatrix can tell "this was already true in the database"
  // from "this box shows the default because nobody ever set it" — see its
  // own comment for why that distinction matters for a capped box.
  root._permValues = values;
  permBindMatrix(root);
  permRefreshCounts(root);
}

// Ticking a tab off hides its subtab rows and greys the card; the disclosure
// arrow opens or closes without changing any permission.
function permBindMatrix(root){
  root.querySelectorAll('.perm-disclose[data-perm-disclose]').forEach(btn => {
    btn.addEventListener('click', () => {
      const body = root.querySelector(`[data-perm-body="${btn.dataset.permDisclose}"]`);
      if(!body) return;
      const open = body.style.display !== 'none';
      body.style.display = open ? 'none' : '';
      btn.innerHTML = open ? '&#9656;' : '&#9662;';
    });
  });
  root.querySelectorAll('.role-tab-cb').forEach(box => {
    box.addEventListener('change', () => {
      const key = box.dataset.tab;
      const card = root.querySelector(`[data-perm-tab-card="${key}"]`);
      const body = root.querySelector(`[data-perm-body="${key}"]`);
      const arrow = root.querySelector(`[data-perm-disclose="${key}"]`);
      if(card) card.classList.toggle('is-off', !box.checked);
      if(body) body.style.display = box.checked ? '' : 'none';
      if(arrow) arrow.innerHTML = box.checked ? '&#9662;' : '&#9656;';
      // A tab that is off cannot be "edit"; turning it back on restores the
      // default (editable) rather than leaving a stale unticked box.
      const editBox = root.querySelector(`.role-tab-edit-cb[data-tab="${key}"]`);
      if(editBox && !editBox.disabled) editBox.checked = box.checked;
    });
  });
  root.querySelectorAll('input[class*="-view-cb"], input[class*="-edit-cb"]').forEach(box => {
    box.addEventListener('change', () => permRefreshCounts(root));
  });
}

function permRefreshCounts(root){
  permissionFamilies().forEach(fam => {
    const el = root.querySelector(`[data-perm-count="${fam.tab}"]`);
    if(!el) return;
    const boxes = Array.from(root.querySelectorAll(`.${fam.cls}-view-cb`));
    el.textContent = `${boxes.filter(b => b.checked).length}/${boxes.length}`;
  });
}

// The five buttons above the matrix. Everything they touch respects the
// ceiling, because a capped box is rendered disabled and a disabled box is
// skipped here.
function permApplyBulk(root, action){
  if(action === 'expand' || action === 'collapse'){
    root.querySelectorAll('[data-perm-body]').forEach(b => { b.style.display = action === 'expand' ? '' : 'none'; });
    root.querySelectorAll('[data-perm-disclose]').forEach(a => { a.innerHTML = action === 'expand' ? '&#9662;' : '&#9656;'; });
    return;
  }
  const set = (sel, val) => root.querySelectorAll(sel).forEach(b => { if(!b.disabled) b.checked = val; });
  if(action === 'view-all'){
    set('.role-tab-cb', true);
    set('input[class*="-view-cb"]', true);
  } else if(action === 'edit-all'){
    set('.role-tab-cb', true);
    set('input[class*="-view-cb"]', true);
    set('.role-tab-edit-cb', true);
    set('input[class*="-edit-cb"]', true);
  } else if(action === 'clear'){
    set('.role-tab-cb', false);
    set('.role-tab-edit-cb', false);
    set('input[class*="-view-cb"]', false);
    set('input[class*="-edit-cb"]', false);
  }
  root.querySelectorAll('.role-tab-cb').forEach(b => b.dispatchEvent(new Event('change')));
  permRefreshCounts(root);
}

// Reads a matrix back out into the same shape the `roles` row stores.
//
// A DISABLED box is one the signed-in person may not hand out, and it is
// rendered showing what the role has today — which, for a key nobody ever
// set, is the code default rather than a stored value. Writing that default
// back as an explicit `true` would be a grant this person is not allowed to
// make, and the database would refuse the whole save; writing it back as
// `false` would quietly strip a permission they were only ever shown. So a
// capped box re-emits exactly what was stored, and contributes nothing at
// all when nothing was stored. Whatever the role already had survives, and
// nothing new is invented.
function permReadMatrix(rootId){
  const root = permMatrixEl(rootId);
  const out = { allowed_tabs: [], tab_edit: {} };
  if(!root) return out;
  const orig = root._permValues || {};

  root.querySelectorAll('.role-tab-cb').forEach(b => {
    const on = b.disabled ? (orig.allowed_tabs || []).includes(b.dataset.tab) : b.checked;
    if(on) out.allowed_tabs.push(b.dataset.tab);
  });
  root.querySelectorAll('.role-tab-edit-cb').forEach(b => {
    if(b.disabled){
      const stored = (orig.tab_edit || {})[b.dataset.tab];
      if(typeof stored === 'boolean') out.tab_edit[b.dataset.tab] = stored;
    } else {
      out.tab_edit[b.dataset.tab] = b.checked;
    }
  });

  permissionFamilies().forEach(fam => {
    const map = {};
    const origMap = orig[fam.family] || {};
    fam.sections.forEach(sec => {
      const v = root.querySelector(`.${fam.cls}-view-cb[data-section="${sec.key}"]`);
      const e = root.querySelector(`.${fam.cls}-edit-cb[data-section="${sec.key}"]`);
      const stored = origMap[sec.key] || {};
      const entry = {};
      if(v && !v.disabled) entry.view = v.checked;
      else if(typeof stored.view === 'boolean') entry.view = stored.view;
      if(fam.hasEdit(sec)){
        if(e && !e.disabled) entry.edit = e.checked;
        else if(typeof stored.edit === 'boolean') entry.edit = stored.edit;
      } else if(typeof stored.edit === 'boolean') entry.edit = stored.edit;
      if(Object.keys(entry).length) map[sec.key] = entry;
    });
    out[fam.family] = map;
  });
  return out;
}

