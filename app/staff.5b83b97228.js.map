function lbFullCsvRow(r){
  return [
    r.address_line1, r.city, r.state, r.zip, r.county, r.apn ?? '', r.owner_name,
    r.owner_first_name || '', r.owner_last_name || '', r.owner_mailing_address,
    r.owner_mailing_city || '', r.owner_mailing_state || '',
    r.is_absentee_owner ? 'Yes' : 'No', r.owner_portfolio_size ?? '', r.is_corporate_owner ? 'Yes' : 'No',
    r.ownership_type || '', r.is_probate_estate ? 'Yes' : 'No',
    r.has_building_code_lawsuit ? 'Yes' : 'No', r.building_code_lawsuit_case_number || '', r.building_code_lawsuit_date || '',
    r.is_vacant_building ? 'Yes' : 'No', r.vacant_building_violation_code || '', r.vacant_building_flagged_date || '',
    r.is_preforeclosure ? 'Yes' : 'No', r.preforeclosure_sale_date || '',
    r.preforeclosure_trustee || '', r.preforeclosure_case_number || '', r.preforeclosure_status || '', r.preforeclosure_legal_description || '',
    r.last_sale_date || '', r.last_sale_type || '', r.is_inherited ? 'Yes' : 'No',
    r.beds ?? '', r.baths ?? '', r.sqft ?? '', r.year_built ?? '',
    r.lot_sqft ?? '', r.assessed_value ?? '', r.assessed_land_value ?? '', r.assessed_building_value ?? '',
    r.property_use_type || '', r.num_stories ?? '',
    r.has_garage ? 'Yes' : 'No', r.has_attic ? 'Yes' : 'No', r.has_basement ? 'Yes' : 'No',
