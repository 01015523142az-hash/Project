// v704 ("the profile picture is not clear at all"). Photos were stored exactly
// as picked -- a 2048x2048, 2.7MB camera photo shown in a 28-32px circle.
// Browsers shrink that badly in one step, so it looked blurred and jagged,
// and every chat list downloaded megabytes per face. A photo is now cut to a
// centred square and halved step by step down to 256x256 -- sharp at every
// size it is shown, and a few dozen KB.
async function avatarSquareJpeg(blob, size){
  const bmp = await createImageBitmap(blob);
  const side = Math.min(bmp.width, bmp.height);
  let cur = document.createElement('canvas');
  cur.width = cur.height = side;
  cur.getContext('2d').drawImage(bmp, (bmp.width - side) / 2, (bmp.height - side) / 2, side, side, 0, 0, side, side);
  if(bmp.close) bmp.close();
  while(cur.width > size){
    const next = document.createElement('canvas');
    next.width = next.height = Math.max(size, Math.round(cur.width / 2));
    const ctx = next.getContext('2d');
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(cur, 0, 0, next.width, next.height);
    cur = next;
  }
  return await new Promise((resolve, reject) => cur.toBlob(b => b ? resolve(b) : reject(new Error('Could not encode the photo')), 'image/jpeg', 0.9));
}
// A photo uploaded before v704 is shrunk once, the next time its owner opens
// the portal -- only the owner may write their own photo, so it cannot be
// done for everyone from one place. A HEAD request decides, so an already
// small photo costs nothing.
async function avatarAutoShrink(){
  try{
    if(!myAvatarUrl || !myUserId || !myAvatarUrl.includes('/storage/v1/object/public/avatars/')) return;
    const head = await fetch(myAvatarUrl, { method: 'HEAD', cache: 'no-store' });
    const len = Number(head.headers.get('content-length') || 0);
    if(!head.ok || !len || len < 200 * 1024) return;
    const blob = await (await fetch(myAvatarUrl, { cache: 'no-store' })).blob();
    const photo = await avatarSquareJpeg(blob, 256);
    const path = `${myUserId}/avatar.jpg`;
    const { error: upErr } = await sb.storage.from('avatars').upload(path, photo, { upsert: true, contentType: 'image/jpeg' });
    if(upErr){ console.warn('avatar shrink upload failed', upErr); return; }
    const { data: urlData } = sb.storage.from('avatars').getPublicUrl(path);
    const url = `${urlData.publicUrl}?v=${Date.now()}`;
    const { error: saveErr } = await sb.from('profiles').update({ avatar_url: url }).eq('id', myUserId);
    if(saveErr){ console.warn('avatar shrink save failed', saveErr); return; }
    myAvatarUrl = url;
    if(typeof renderProfileMenu === 'function') renderProfileMenu();
    try{ chatUpdateMyAvatarButton(); }catch(e){ /* chat not built yet */ }
  }catch(e){ console.warn('avatar shrink skipped', e); }
}
// v702: your profile photo is changed from the profile menu (top right) only
// -- not from the chat -- at the owner's request. Same upload as before, just
// started from there.
$('pmPhotoBtn').addEventListener('click', (e) => { e.stopPropagation(); $('pmPhotoInput').click(); });
$('pmPhotoInput').addEventListener('change', async () => {
  const file = $('pmPhotoInput').files[0];
  $('pmPhotoInput').value = '';
  if(!file) return;
  const msg = $('pmPhotoMsg');
  if(!file.type.startsWith('image/')){
    msg.textContent = 'Please choose an image file.';
    msg.className = 'msg error';
    return;
  }
  if(file.size > 15 * 1024 * 1024){   // v704: it is shrunk before upload, so a phone photo is fine
    msg.textContent = 'That image is larger than 15MB — please pick a smaller one.';
    msg.className = 'msg error';
    return;
  }
  msg.textContent = 'Uploading…';
  msg.className = 'msg';
  // Fixed filename (not a timestamped one, unlike chat attachments) so a
  // new upload just overwrites the last photo instead of accumulating —
  // upsert:true is what makes that overwrite actually work.
  // v704: always a 256x256 JPEG (avatarSquareJpeg), whatever was picked.
  let photo;
  try{ photo = await avatarSquareJpeg(file, 256); }
  catch(e){
    msg.textContent = 'Could not read that image — try a JPG or PNG.';
    msg.className = 'msg error';
    return;
  }
  const path = `${myUserId}/avatar.jpg`;
  const { error: uploadErr } = await sb.storage.from('avatars').upload(path, photo, { upsert: true, contentType: 'image/jpeg' });
  if(uploadErr){
    msg.textContent = uploadErr.message || 'Upload failed.';
    msg.className = 'msg error';
    return;
  }
  const { data: urlData } = sb.storage.from('avatars').getPublicUrl(path);
  // Cache-bust — same path, new content, otherwise the browser (and other
  // people's already-loaded pages) might keep showing the old cached image.
  const bustedUrl = `${urlData.publicUrl}?v=${Date.now()}`;
  const { error: updateErr } = await sb.from('profiles').update({ avatar_url: bustedUrl }).eq('id', myUserId);
  if(updateErr){
    msg.textContent = updateErr.message || 'Failed to save.';
    msg.className = 'msg error';
    return;
  }
  myAvatarUrl = bustedUrl;
  $('chatMyAvatarPreview').innerHTML = `<img src="${escapeHtml(bustedUrl)}" alt="">`;
  chatUpdateMyAvatarButton();
  renderProfileMenu();   // v702
  renderChatConvList($('chatSearchInput').value);
  msg.textContent = 'Updated!';
  msg.className = 'msg ok';
});
// v702: CHAT STATUS -- the state (Automatic / Busy / Do not disturb / Be
// right back / Appear offline), a message with an emoji, and when it all
// clears. Chat only. Saved to profiles (status_text, status_emoji,
// status_until); everyone's chat reads it through chat_directory().
function chatStatusUntilFrom(choice){
  const now = new Date();
  if(choice === '30m') return new Date(now.getTime() + 30 * 60000);
  if(choice === '1h') return new Date(now.getTime() + 3600000);
  if(choice === '4h') return new Date(now.getTime() + 4 * 3600000);
  if(choice === 'today'){ const d = new Date(now); d.setHours(23, 59, 59, 0); return d; }
  if(choice === 'week'){ const d = new Date(now); d.setDate(d.getDate() + ((7 - d.getDay()) % 7)); d.setHours(23, 59, 59, 0); return d; }
  return null;
}
async function chatSaveMyStatus(){
  const msg = $('chatMyProfileMsg');
  const choice = $('chatMyStatusSelect').value;
  const manual = choice === 'auto' ? null : choice;
  const text = $('chatStatusText').value.trim().slice(0, 80) || null;
  const emoji = $('chatStatusEmoji').value.trim().slice(0, 8) || null;
  const untilSel = $('chatStatusUntil').value;
  // "Clear after" left alone keeps the time already set, rather than
  // silently making a status permanent.
  let untilIso = myStatusUntil;
  if(untilSel) untilIso = chatStatusUntilFrom(untilSel).toISOString();
  if(!manual && !text && !emoji) untilIso = null;
  myChatStatusManual = manual; myStatusText = text; myStatusEmoji = emoji; myStatusUntil = untilIso;
  myChatStatus = manual === 'invisible' ? 'offline' : (manual || currentAutoStatus());
  const patch = { chat_status_manual: manual, chat_status: myChatStatus, status_text: text, status_emoji: emoji, status_until: untilIso };
  if(manual !== 'invisible') patch.last_seen_at = new Date().toISOString();
  const { error } = await sb.from('profiles').update(patch).eq('id', myUserId);
  if(error){ msg.textContent = error.message; msg.className = 'msg error'; return; }
  msg.textContent = (!manual && !text && !emoji) ? 'Your status is automatic.'
    : 'Status saved' + (untilIso ? ' \u2014 it clears ' + chatFmtUntil(untilIso) + '.' : '.');
  msg.className = 'msg ok';
  $('chatStatusUntil').value = '';
  chatUpdateMyAvatarButton();
  renderChatConvList($('chatSearchInput') ? $('chatSearchInput').value : '');
}
$('chatMyStatusSelect').addEventListener('change', chatSaveMyStatus);
