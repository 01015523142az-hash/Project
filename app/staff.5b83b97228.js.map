// admin isn't currently looking at that agent.
async function refreshDetailIfViewing(userId){
  if(currentDetailAgent && currentDetailAgent.id === userId){
    await renderDetail(currentDetailAgent);
  }
}

// ---------- internal chat: Communication channel, 1:1 DMs, and groups ----------
// State lives entirely client-side (re-fetched on load + kept current via
// a realtime subscription, with a periodic-refresh fallback piggybacked
// on the existing 20s poll in case realtime ever silently drops).
let chatDirectory = [];       // [{id, full_name, email, avatar_url, chat_status}] — DM-eligible (same role, or Owner/Admin), from chat_directory()
let chatGroupDirectory = [];  // same shape but EVERYONE (no role restriction) — for picking group members, from chat_group_directory()
let chatGroups = {};          // groupId -> { id, name, created_by, members:[{user_id, added_by, added_at}] }
let chatConversations = {};   // key ('team' | other user's id | 'group:<id>') -> { key, messages:[], unread }
let chatLastRead = {};        // conversation_key -> ISO timestamp, from chat_reads (mine only)
let chatReadsIndex = {};      // v314: `${user_id}|${conversation_key}` -> ISO timestamp, from chat_reads (everyone visible to me) — ticks/"seen by" render off this
let chatActiveConv = null;    // key of the currently OPEN thread, or null when showing the list
let chatOfflineHint = null;   // v125: { key, name } — set right after sending a DM to someone currently offline
// v91: parallel, much smaller directory for Client Chats — one entry per
// client whose thread is assigned to me, unclaimed-but-waiting for a
// queue I belong to, or (Owner/Admin) any client thread at all — see
// loadClientChatOverview(). Deliberately kept separate from
// chatConversations' population logic (chatAddMessageToState is
// chat_messages-specific); only the resulting {key, messages, unread}
// shape is shared so renderChatConvList()/updateChatUnreadBadge() can
// treat a client thread like any other conversation.
let clientChatThreadsDirectory = []; // [{client_id, full_name, company_name, status}]
let clientChatThreadsRefreshTimer = null; // v207: debounce for the client_chat_threads realtime handler
let chatActiveGroupInfoId = null; // group id currently shown in the Group Info view, or null
let chatChannel = null;       // realtime subscription handle
let chatChannelEverConnected = false; // v393d: distinguishes the initial connect from a reconnect-after-drop — see subscribeChatRealtime()'s 'SUBSCRIBED' callback
const CHAT_FETCH_LIMIT = 500; // recent-message window for the overview fetch — see loadChatOverview

// ---------- v316: "is typing…" indicator (Snapchat-style bubble) ----------
// Ephemeral only — Realtime Broadcast, nothing persisted to any table.
// Scoped to 1:1 conversations (DMs + client chats) only, not Team/groups,
// so a keystroke ping never fans out to an entire channel's worth of
// people. Mirrors the existing per-user "inbox" pattern voice-call
// signaling already uses (see initVoiceCallSignaling/call-signal-<id>):
// each side has a permanent inbox channel for DMs (chat-typing-<userId>),
// and a per-client-thread channel for client chats (opened only while
// that thread is on screen, same as call-signal-<clientId> is only opened
// for the duration of a call).
let chatMyTypingChannel = null;         // permanent DM-typing inbox, keyed by MY id
let chatTypingOutboundChannel = null;   // reused while composing to the SAME DM peer
let chatTypingOutboundKey = null;
let chatClientTypingChannel = null;     // staff-side: open only while a client's thread is active
let chatClientTypingChannelClientId = null;
let chatPeerTypingUntil = {};           // key (peer's user id | 'client:<id>') -> ms timestamp, expires itself
let chatTypingStopTimer = null;
let chatLastTypingPingAt = 0;

function chatIsPeerTyping(key){
  return !!(chatPeerTypingUntil[key] && chatPeerTypingUntil[key] > Date.now());
}
function chatOnPeerTypingChanged(key){
  if(key.startsWith('client:') && typeof ciIsViewing === 'function'){   // v701
    if(ciIsViewing(key)) ciRenderMsgs(false);
    if(ciTabActive()) ciRenderList();
  }
  if(chatActiveConv === key){
    if(key.startsWith('client:')) renderClientChatMessages(key.slice(7));
    else renderChatThread();
  }
  renderChatConvList($('chatSearchInput') ? $('chatSearchInput').value : '');
}
function chatTypingBubbleHtml(){
  return '<div class="chat-msg-row theirs chat-typing-row"><div class="chat-msg-bubble chat-typing-dots"><span></span><span></span><span></span></div></div>';
}
// v704 ("if the other person is typing, the voice message I'm playing
// stops"). Every realtime tick -- a typing ping, a read receipt, an edit --
// rebuilt the whole message list with innerHTML, which destroyed the <audio>
// element mid-play (and re-fetched every image). An attachment that has
// already loaded is now carried across by its path: the SAME element goes
// back into the new markup within the same task, and a media element that is
// back in the document by then never pauses.
// v716 (the owner: "a photo sent in chat should pop up, with zoom in and zoom
// out, instead of opening in another tab"). One viewer for every chat photo:
// the - / + buttons, the mouse wheel and a two-finger pinch zoom around the
// pointer; a zoomed photo is dragged around; double-click toggles fit / 2.5x;
// Esc, the x or a click on the dark area closes it. Download keeps the
// existing save-to-disk path (downloadFileToDisk). Built on first use.
const photoViewer = { el: null, stage: null, img: null, label: null, url: '', name: '',
  s: 1, fit: 1, tx: 0, ty: 0, pointers: new Map(), pinch: null, moved: false, downOnStage: false, prevOverflow: '' };
function photoViewerApply(){
  const v = photoViewer;
  v.img.style.transform = `translate(${v.tx}px, ${v.ty}px) translate(-50%, -50%) scale(${v.s})`;
  v.label.textContent = Math.round(v.s * 100) + '%';
  v.stage.classList.toggle('zoomed', v.s > v.fit * 1.01);
}
// Zoom to scale ns keeping the screen point (cx, cy) still -- the photo's
// centre sits at the stage centre + (tx, ty), a photo pixel q at centre + t + s*q.
function photoViewerZoomTo(ns, cx, cy){
  const v = photoViewer;
  ns = Math.min(Math.max(v.fit * 8, 4), Math.max(v.fit * 0.5, ns));
  const r = v.stage.getBoundingClientRect();
  const px = (cx == null ? r.left + r.width / 2 : cx) - (r.left + r.width / 2);
  const py = (cy == null ? r.top + r.height / 2 : cy) - (r.top + r.height / 2);
  const k = ns / v.s;
  v.tx = px - k * (px - v.tx);
  v.ty = py - k * (py - v.ty);
  v.s = ns;
  photoViewerApply();
}
function photoViewerZoomBy(f, cx, cy){ photoViewerZoomTo(photoViewer.s * f, cx, cy); }
function photoViewerFit(){
  const v = photoViewer;
  const r = v.stage.getBoundingClientRect();
  const w = v.img.naturalWidth || 1, h = v.img.naturalHeight || 1;
  v.fit = Math.max(0.01, Math.min((r.width - 32) / w, (r.height - 32) / h, 1));   // never blown up past its real size
  v.s = v.fit; v.tx = 0; v.ty = 0;
  photoViewerApply();
}
function photoViewerBuild(){
  if(photoViewer.el) return;
  const v = photoViewer;
  const el = document.createElement('div');
  el.className = 'photo-viewer';
  el.hidden = true;
  el.setAttribute('role', 'dialog');
  el.setAttribute('aria-modal', 'true');
  el.setAttribute('aria-label', 'Photo');
  el.innerHTML = `
    <div class="photo-viewer-bar">
      <div class="photo-viewer-name"></div>
      <button type="button" class="photo-viewer-btn" data-pv="out" title="Zoom out (-)" aria-label="Zoom out">&minus;</button>
      <div class="photo-viewer-zoom">100%</div>
      <button type="button" class="photo-viewer-btn" data-pv="in" title="Zoom in (+)" aria-label="Zoom in">+</button>
      <button type="button" class="photo-viewer-btn" data-pv="fit" title="Fit to screen (0)">Fit</button>
      <button type="button" class="photo-viewer-btn" data-pv="download" title="Download" aria-label="Download">&#11015;</button>
      <button type="button" class="photo-viewer-btn" data-pv="close" title="Close (Esc)" aria-label="Close">&times;</button>
    </div>
    <div class="photo-viewer-stage"><img class="photo-viewer-img" alt="" draggable="false"></div>`;
  document.body.appendChild(el);
  v.el = el;
  v.stage = el.querySelector('.photo-viewer-stage');
  v.img = el.querySelector('.photo-viewer-img');
  v.label = el.querySelector('.photo-viewer-zoom');
  el.querySelector('.photo-viewer-bar').addEventListener('click', (e) => {
    const b = e.target.closest('[data-pv]');
    if(!b) return;
    const act = b.dataset.pv;
    if(act === 'in') photoViewerZoomBy(1.25);
    else if(act === 'out') photoViewerZoomBy(0.8);
    else if(act === 'fit') photoViewerFit();
    else if(act === 'download') downloadFileToDisk(v.url, v.name || 'photo');
    else if(act === 'close') closePhotoViewer();
  });
  const stage = v.stage;
  stage.addEventListener('wheel', (e) => {
    e.preventDefault();
    photoViewerZoomBy(Math.exp(-e.deltaY * 0.0015), e.clientX, e.clientY);
  }, { passive: false });
  stage.addEventListener('dblclick', (e) => {
    if(v.s > v.fit * 1.05) photoViewerFit();
    else photoViewerZoomTo(Math.max(v.fit * 2.5, 1), e.clientX, e.clientY);
  });
  stage.addEventListener('pointerdown', (e) => {
    if(!v.pointers.size){ v.moved = false; v.downOnStage = e.target === stage; }
    try{ stage.setPointerCapture(e.pointerId); }catch(err){ /* pointer already gone */ }
    v.pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if(v.pointers.size === 2){
      const [a, b] = [...v.pointers.values()];
      v.pinch = { d: Math.hypot(a.x - b.x, a.y - b.y) || 1, s: v.s };
    }
  });
  stage.addEventListener('pointermove', (e) => {
    const prev = v.pointers.get(e.pointerId);
    if(!prev) return;
    const cur = { x: e.clientX, y: e.clientY };
    v.pointers.set(e.pointerId, cur);
    if(v.pointers.size === 2 && v.pinch){
      const [a, b] = [...v.pointers.values()];
      photoViewerZoomTo(v.pinch.s * Math.hypot(a.x - b.x, a.y - b.y) / v.pinch.d, (a.x + b.x) / 2, (a.y + b.y) / 2);
      v.moved = true;
      return;
    }
    const dx = cur.x - prev.x, dy = cur.y - prev.y;
    if(Math.abs(dx) + Math.abs(dy) > 1){ v.moved = true; stage.classList.add('dragging'); }
    v.tx += dx; v.ty += dy;
    photoViewerApply();
  });
  const release = (e) => {
    v.pointers.delete(e.pointerId);
    if(v.pointers.size < 2) v.pinch = null;
    if(!v.pointers.size) stage.classList.remove('dragging');
  };
  stage.addEventListener('pointerup', (e) => {
    release(e);
    // A plain click on the dark area (not the photo, not a drag) closes it.
    if(!v.pointers.size && !v.moved && v.downOnStage) closePhotoViewer();
  });
  stage.addEventListener('pointercancel', release);
  document.addEventListener('keydown', (e) => {
    if(!v.el || v.el.hidden) return;
    if(e.key === 'Escape'){ e.preventDefault(); e.stopImmediatePropagation(); closePhotoViewer(); }
    else if(e.key === '+' || e.key === '='){ e.preventDefault(); photoViewerZoomBy(1.25); }
    else if(e.key === '-' || e.key === '_'){ e.preventDefault(); photoViewerZoomBy(0.8); }
    else if(e.key === '0'){ e.preventDefault(); photoViewerFit(); }
  }, true);
  window.addEventListener('resize', () => { if(!v.el.hidden) photoViewerFit(); });
}
function openPhotoViewer(url, name){
  photoViewerBuild();
  const v = photoViewer;
  v.url = url;
  v.name = name || 'photo';
  v.el.querySelector('.photo-viewer-name').textContent = v.name;
  v.img.style.visibility = 'hidden';
  v.img.onload = () => { v.img.style.visibility = ''; photoViewerFit(); };
  v.img.src = url;
  v.prevOverflow = document.documentElement.style.overflow;
  document.documentElement.style.overflow = 'hidden';
  v.el.hidden = false;
  if(v.img.complete && v.img.naturalWidth){ v.img.style.visibility = ''; photoViewerFit(); }
  v.el.querySelector('[data-pv="close"]').focus({ preventScroll: true });
}
function closePhotoViewer(){
  const v = photoViewer;
  if(!v.el || v.el.hidden) return;
  v.el.hidden = true;
  v.pointers.clear();
  v.pinch = null;
  document.documentElement.style.overflow = v.prevOverflow || '';
}

function chatSwapHtml(box, html){
  const keep = new Map();
  box.querySelectorAll('.chat-msg-attachment[data-resolved="1"]').forEach(el => {
    if(!keep.has(el.dataset.attachmentPath)) keep.set(el.dataset.attachmentPath, el);
  });
  box.innerHTML = html;
  if(!keep.size) return;
  box.querySelectorAll('.chat-msg-attachment[data-attachment-path]').forEach(el => {
    const old = keep.get(el.dataset.attachmentPath);
    if(old){ el.replaceWith(old); keep.delete(el.dataset.attachmentPath); }
  });
}
// v704: the photo beside an incoming message. Staff: their profile photo
// (initial if none); a client: their initials on their inbox colour; the AI:
// its face.
function chatMsgAvatarHtml(kind, id, name){
  let inner;
  if(kind === 'ai') inner = chatBotAvatarIconHtml(28);
  else if(kind === 'client') inner = `<div class="chat-conv-avatar" style="width:28px; height:28px; font-size:11px; background:${ciAvColor(id)}; color:#fff;">${escapeHtml(ciInitials(name))}</div>`;
  else inner = chatAvatarHtml(id, name, 28, false);
  return `<div class="chat-msg-av">${inner}</div>`;
}

function initChatTypingSignaling(){
  if(!myUserId || chatMyTypingChannel) return;
  chatMyTypingChannel = sb.channel('chat-typing-' + myUserId);
  chatMyTypingChannel.on('broadcast', { event: 'typing' }, ({ payload }) => {
    if(!payload || !payload.from) return;
    if(payload.state === 'typing') chatPeerTypingUntil[payload.from] = Date.now() + 4000;
    else delete chatPeerTypingUntil[payload.from];
    chatOnPeerTypingChanged(payload.from);
  }).subscribe();
}
function teardownChatTypingSignaling(){
  if(chatMyTypingChannel){ sb.removeChannel(chatMyTypingChannel); chatMyTypingChannel = null; }
  if(chatTypingOutboundChannel){ sb.removeChannel(chatTypingOutboundChannel); chatTypingOutboundChannel = null; chatTypingOutboundKey = null; }
  chatCloseClientTypingChannel();
  chatPeerTypingUntil = {};
  clearTimeout(chatTypingStopTimer);
  chatStopTypingSweep();
}

// Staff-side: opened for whichever client's thread is currently on screen,
// closed the moment they leave it — a client isn't a `profiles` row so it
// has no permanent inbox of its own; this channel name IS the shared
// "room" both the client (always listening, see client-portal.html) and
// whichever staff member has the thread open use.
function chatOpenClientTypingChannel(clientId){
  if(chatClientTypingChannelClientId === clientId && chatClientTypingChannel) return;
  chatCloseClientTypingChannel();
  chatClientTypingChannelClientId = clientId;
  const key = 'client:' + clientId;
  const ch = sb.channel('chat-typing-client-' + clientId);
  ch.on('broadcast', { event: 'typing' }, ({ payload }) => {
    if(!payload || payload.from !== 'client') return; // ignore our own echo / other staff on the same thread
    if(payload.state === 'typing') chatPeerTypingUntil[key] = Date.now() + 4000;
    else delete chatPeerTypingUntil[key];
    chatOnPeerTypingChanged(key);
  }).subscribe();
  chatClientTypingChannel = ch;
}
function chatCloseClientTypingChannel(){
  if(chatClientTypingChannel){ sb.removeChannel(chatClientTypingChannel); chatClientTypingChannel = null; }
  chatClientTypingChannelClientId = null;
}

function chatTypingSend(key, state){
  if(key.startsWith('client:')){
    if(chatClientTypingChannel) chatClientTypingChannel.send({ type: 'broadcast', event: 'typing', payload: { from: 'staff', state } });
    return;
  }
  if(chatTypingOutboundChannel && chatTypingOutboundKey === key){
    chatTypingOutboundChannel.send({ type: 'broadcast', event: 'typing', payload: { from: myUserId, state } });
    return;
  }
  if(chatTypingOutboundChannel) sb.removeChannel(chatTypingOutboundChannel);
  chatTypingOutboundKey = key;
  const ch = sb.channel('chat-typing-' + key);
  chatTypingOutboundChannel = ch;
  voiceChannelReady(ch).then(() => ch.send({ type: 'broadcast', event: 'typing', payload: { from: myUserId, state } }));
}

let chatTypingSweepTimer = null; // catches a peer who stopped without sending an explicit 'stopped' (closed tab, lost connection, etc.)
function chatStartTypingSweep(){
  if(chatTypingSweepTimer) return;
  chatTypingSweepTimer = setInterval(() => {
    const now = Date.now();
    Object.keys(chatPeerTypingUntil).forEach(key => {
      if(chatPeerTypingUntil[key] <= now){ delete chatPeerTypingUntil[key]; chatOnPeerTypingChanged(key); }
    });
  }, 1000);
}
function chatStopTypingSweep(){
  if(chatTypingSweepTimer){ clearInterval(chatTypingSweepTimer); chatTypingSweepTimer = null; }
}

function chatContactName(userId){
  if(userId === myUserId) return myFullName || myEmail || 'You';
  const person = chatDirectory.find(p => p.id === userId) || chatGroupDirectory.find(p => p.id === userId);
  return (person && (person.full_name || person.email)) || 'Unknown user';
}
// v639: title + department, for the sender header in chat and the profile.
// Returns '' rather than a placeholder when somebody has not been
// categorised yet -- an empty subtitle reads as "no extra detail", where
// "Unassigned" reads as a label somebody chose, and this portal has three
// accounts (two bots and one real agent) with no department on purpose.
function chatContactRole(userId){
  const person = (userId === myUserId)
    ? { title: myTitle, department: myDepartment }
    : (chatDirectory.find(p => p.id === userId) || chatGroupDirectory.find(p => p.id === userId));
  if(!person) return '';
  return [person.title, person.department].filter(Boolean).join(' · ');
}
function chatContactAvatar(userId){
  if(userId === myUserId) return myAvatarUrl;
  const person = chatDirectory.find(p => p.id === userId) || chatGroupDirectory.find(p => p.id === userId);
  return (person && person.avatar_url) || null;
}
function chatContactStatus(userId){
  if(userId === myUserId){
    // my own dot: manual override wins, else my live auto state
    return myChatStatusManual || myChatStatus || 'offline';
  }
  // v135: Desouky/AI Assistant is a bot, not a real logged-in session — it
  // has no presence heartbeat of its own to derive from, so it always fell
  // through derivePresence() to 'offline'. It's always available, so
  // always show it as Active instead.
  if(AI_ASSISTANT_BOT_ID && userId === AI_ASSISTANT_BOT_ID) return 'active';
  const person = chatDirectory.find(p => p.id === userId) || chatGroupDirectory.find(p => p.id === userId);
  return derivePresence(person); // v1.2.9: freshness + manual-aware
}
// Builds one avatar circle — a real photo if the person has one, an
// initial-letter circle otherwise — with an optional presence-status dot
// overlaid on the bottom-right corner (used for DMs, not groups/Communication,
// since a status dot doesn't make sense for a multi-person conversation).
function chatAvatarHtml(userId, name, sizePx, showStatus){
  const url = chatContactAvatar(userId);
  const inner = url ? `<img src="${escapeHtml(url)}" alt="">` : escapeHtml((name || '?').charAt(0).toUpperCase());
  const dot = showStatus ? `<span class="chat-status-dot ${chatContactStatus(userId)}"></span>` : '';
  return `<div class="chat-conv-avatar" style="width:${sizePx}px; height:${sizePx}px; font-size:${Math.round(sizePx * 0.42)}px;">${inner}${dot}</div>`;
}
// v121: a compact, static (non-animated — this renders in a scrolling
// list, so no point animating it) version of Desouky's mascot face, used
// as its avatar circle instead of an initial-letter circle.
function chatBotAvatarIconHtml(sizePx){
  return `<div class="chat-conv-avatar bot-avatar" style="width:${sizePx}px; height:${sizePx}px;">
    <svg viewBox="0 0 24 24" width="${Math.round(sizePx * 0.8)}" height="${Math.round(sizePx * 0.8)}" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="1.6" y="9" width="3.2" height="6.4" rx="1.6" fill="#E2B774"/>
      <rect x="19.2" y="9" width="3.2" height="6.4" rx="1.6" fill="#E2B774"/>
      <circle cx="12" cy="12" r="9" fill="#434C60" stroke="#232A37" stroke-width="0.8"/>
      <path d="M8.6 4.3 Q12 3 15.4 4.3" stroke="#E2B774" stroke-width="1.5" stroke-linecap="round"/>
      <rect x="5.4" y="6.8" width="13.2" height="10.2" rx="4.2" fill="#5A3A14" stroke="#E2B774" stroke-width="0.9"/>
      <path d="M8 11.2 Q9.2 9.8 10.4 11.2 M13.6 11.2 Q14.8 9.8 16 11.2" stroke="#FFD38A" stroke-width="1.1" stroke-linecap="round"/>
      <path d="M10.1 13.1 Q12 15.4 13.9 13.1 Z" fill="#FFD38A"/>
    </svg>
  </div>`;
}
function chatConvDisplayName(key){
  if(key === 'team') return 'Communication';
  if(key.startsWith('group:')) return (chatGroups[key.slice(6)] && chatGroups[key.slice(6)].name) || 'Group';
  return chatContactName(key);
}

// v1.2.9: presence label + dot for a status value.
function chatStatusMeta(status){
  switch(status){
    case 'active': return { dot: 'active', label: 'Active' };
    case 'away':   return { dot: 'away',   label: 'Away' };
    case 'busy':   return { dot: 'busy',   label: 'Busy' };
    case 'dnd':    return { dot: 'dnd',    label: 'Do not disturb' };
    case 'brb':    return { dot: 'brb',    label: 'Be right back' };      // v702
    case 'invisible': return { dot: 'offline', label: 'Appear offline' }; // v702: how I see my own
    default:       return { dot: 'offline',label: 'Offline' };
  }
}
// v702: a person's status message, if it has not expired.
function chatPersonStatusMsg(userId){
  const p = userId === myUserId
    ? { status_text: myStatusText, status_emoji: myStatusEmoji, status_until: myStatusUntil }
    : chatDirectory.find(x => x.id === userId);
  if(!p || (!p.status_text && !p.status_emoji)) return null;
  if(p.status_until && Date.now() > new Date(p.status_until).getTime()) return null;
  return { emoji: p.status_emoji || '', text: p.status_text || '' };
}
function chatStatusBadgeHtml(userId){
  const s = chatPersonStatusMsg(userId);
  if(!s) return '';
  return `<span class="chat-status-emoji" title="${escapeHtml(s.text || '')}">${escapeHtml(s.emoji || '💬')}</span>`;
}
function chatLastSeenLabel(userId){
  const p = chatDirectory.find(x => x.id === userId) || chatGroupDirectory.find(x => x.id === userId);
  if(!p || !p.last_seen_at) return '';
  const s = (Date.now() - new Date(p.last_seen_at).getTime()) / 1000;
  if(s < 90) return 'just now';
  if(s < 3600) return Math.floor(s / 60) + 'm ago';
  if(s < 86400) return Math.floor(s / 3600) + 'h ago';
  const tz = nonAgentDisplayTz();
  return new Date(p.last_seen_at).toLocaleDateString([], { month: 'short', day: 'numeric', ...(tz ? { timeZone: tz } : {}) });
}
// Do not disturb (and not expired): no chat sound, no chat pop-up.
function chatIsMyDnd(){
  return myChatStatusManual === 'dnd' && !(myStatusUntil && Date.now() > new Date(myStatusUntil).getTime());
}
function chatFmtUntil(iso){
  const tz = nonAgentDisplayTz();
  return new Date(iso).toLocaleString([], { weekday: 'short', hour: 'numeric', minute: '2-digit', ...(tz ? { timeZone: tz } : {}) });
}
// Renders the little presence line under the conversation title: for a DM it's
// the other person's status (dot + label); for a group it's how many members
// are currently active; Communication/team shows nothing.
function renderChatThreadHeaderStatus(key){
  const el = $('chatThreadTitleStatus');
  if(!el) return;
  if(key === 'team'){ el.style.display = 'none'; el.innerHTML = ''; return; }
  if(key.startsWith('group:')){
    const gid = key.slice(6);
    const g = chatGroups[gid];
    const memberIds = (g && g.members) ? g.members.map(m => m.user_id) : [];
    // count members (excluding me) currently active
    let activeCount = 0;
    memberIds.forEach(id => {
      if(id === myUserId) return;
      const st = chatContactStatus(id);
      if(st === 'active') activeCount++;
    });
    const others = memberIds.filter(id => id !== myUserId).length;
    el.innerHTML = `<span class="chat-status-dot active" style="width:7px;height:7px;display:inline-block;border-radius:50%;margin-right:5px;vertical-align:middle;"></span>${activeCount} of ${others} active`;
    el.style.display = 'block';
    return;
  }
  // DM: key is the other user's id
  const st = chatContactStatus(key);
  const meta = chatStatusMeta(st);
  // v639: title + department sit alongside presence, so you can see who you
  // are actually writing to while you type -- "Offline" alone never told you
  // whether this was a teammate or a department head.
  const roleLine = chatContactRole(key);
  el.innerHTML = `<span class="chat-status-dot ${meta.dot}" style="width:7px;height:7px;display:inline-block;border-radius:50%;margin-right:5px;vertical-align:middle;"></span>${meta.label}`;
  // v702: when they were last here, and what they have said they are doing.
  if(st === 'offline'){ const seen = chatLastSeenLabel(key); if(seen) el.innerHTML += ` · last seen ${escapeHtml(seen)}`; }
  const sm = chatPersonStatusMsg(key);
  if(sm) el.innerHTML += ` · ${escapeHtml(((sm.emoji ? sm.emoji + ' ' : '') + (sm.text || '')).trim())}`;
  if(roleLine) el.innerHTML += `<span style="opacity:.75;"> · ${escapeHtml(roleLine)}</span>`;
  el.style.display = 'block';
}
// Whether the CURRENT signed-in account can post to Communication —
// mirrors the is_admin() check the RLS policy itself enforces server-side,
// so the UI never shows an input that would just get rejected.
function chatCanPostTeam(){
  return myIsOwner || myRole === 'admin';
}

// ---------- v1.2.5: user-profile click-through gating ----------
// Central rule for whether the CURRENT viewer may open a user's profile
// editor by clicking them (from Dashboard, Users list, or the Roles/Users-
// Types section):
//   - Owner and Admin: full profile edit.
//   - Human Resources: may open, but only the Schedule & limits section is
//     editable (everything else read-only/hidden) — see openDetail's HR mode.
//   - A custom role with explicit user-edit permission (can_manage_users):
//     full profile edit.
//   - Everyone else: no click-through.
// HR is a custom role identified by name; normalize a few common spellings.
function isHrRole(roleName){
  const r = (roleName || '').toLowerCase().replace(/[\s_-]+/g, '');
  return r === 'humanresources' || r === 'hr';
}
function viewerIsHR(){ return isHrRole(myRole); }
function viewerHasFullUserEdit(){
  return myIsOwner || myRole === 'admin' || myPermissions.canManageUsers;
}
// Can the viewer open this user at all (full OR HR-restricted)?
// Can the viewer open this user at all? Anyone may open THEIR OWN profile
// (view-only unless they also have edit rights). Otherwise it's the
// full-edit roles or HR.
function canOpenUserProfile(targetUserId){
  if(targetUserId && targetUserId === myUserId) return true; // always allow self
  return viewerHasFullUserEdit() || viewerIsHR();
}

async function initChatWidget(){
  if(!myUserId) return;
  $('chatWidget').style.display = 'block';
  await loadChatDirectory();
  await loadChatOverview(true); // v1.2.25: flag this as the post-login load so a pending-message badge can auto-pop the panel open
  await loadChatQueueLabels();
  await loadClientChatOverview();
  renderChatConvList($('chatSearchInput') ? $('chatSearchInput').value : '');
  subscribeChatRealtime();
  subscribeStaffOpsRealtime();
  subscribeChatReactions();   // v718
  initNotifCenter();
  handleCallbackHash();   // v702: a missed-call notification opened from the dialer
  initPushToggle();
  callNotifyGateCheck();   // v811 (W4): agents and sales must have call notifications on
  initVoiceCallSignaling();
  setTimeout(() => voiceResumeSavedCall(), 1500);   // v707: a call this tab was on before a refresh
  initChatTypingSignaling();
  chatStartTypingSweep();
  chatUpdateMyAvatarButton();
  // v190: Desouky's entry point moved into the left sidebar (see
  // #desoukySidebarBtn) — same "only shown once the bot is actually
  // configured" gating as before, just a different element. The floating
  // mascot art (#desoukyMascotWrap) is no longer toggled here; it now
  // only appears while Desouky's own DM thread is open, handled in
  // openChatThread()/the chatCloseBtn handler.
  if(AI_ASSISTANT_BOT_ID && $('desoukySidebarBtn')){
    $('desoukySidebarBtn').style.display = 'flex';
  }
}

function teardownChatWidget(){
  $('chatWidget').style.display = 'none';
  $('chatPanel').style.display = 'none';
  $('desoukyMascotWrap').style.display = 'none';
  if($('desoukySidebarBtn')) $('desoukySidebarBtn').style.display = 'none';
  if(chatChannel){ sb.removeChannel(chatChannel); chatChannel = null; }
  // LOW FIX (audit_chunk2.md #5): subscribeStaffOpsRealtime()'s channel was
  // never torn down here, unlike chatChannel/voice-call/typing-signal
  // channels above -- currently masked because signOutBtn always finishes
  // with a full page navigation (tearing down every socket anyway), but a
  // real incomplete-cleanup gap that would leak/go stale the moment
  // teardownChatWidget()/initChatWidget() are ever used without a full
  // reload. subscribeStaffOpsRealtime() also no-ops if staffOpsChannel is
  // already set, so without this it could never resubscribe either.
  if(staffOpsChannel){ sb.removeChannel(staffOpsChannel); staffOpsChannel = null; }
  teardownVoiceCallSignaling();
  teardownChatTypingSignaling();
  chatDirectory = []; chatGroupDirectory = []; chatGroups = {};
  chatConversations = {}; chatLastRead = {}; chatActiveConv = null; chatActiveGroupInfoId = null;
}

async function loadChatDirectory(){
  const { data, error } = await sb.rpc('chat_directory');
  if(error) console.error('chat_directory failed', error);
  else chatDirectory = (data || []).filter(p => p.id !== myUserId);

  const { data: groupDirData, error: groupDirErr } = await sb.rpc('chat_group_directory');
  if(groupDirErr) console.error('chat_group_directory failed', groupDirErr);
  else chatGroupDirectory = groupDirData || [];
}

async function loadChatGroups(){
  const { data: groups, error } = await sb.from('chat_groups').select('id, name, created_by, created_at');
  if(error){ console.error('loadChatGroups failed', error); return; }
  const { data: members } = await sb.from('chat_group_members').select('group_id, user_id, added_by, added_at');
  chatGroups = {};
  (groups || []).forEach(g => { chatGroups[g.id] = { ...g, members: [] }; });
  (members || []).forEach(m => { if(chatGroups[m.group_id]) chatGroups[m.group_id].members.push(m); });
}

// Fetches everything needed to render the conversation list: this
// account's own read markers, plus the most recent messages across
// Communication, every DM involving them, and every group they belong to.
// Grouping by conversation and counting "unread" (created after that
// conversation's last_read_at, and not sent by me) all happens
// client-side from that one fetch.
async function loadChatOverview(isInitialLoad){
  await loadChatGroups(); // need current group memberships before the .or() filter below can include them
  // v314: no longer filtered to just my own rows — RLS now also exposes a
  // DM peer's/team's/group's/client-thread's read markers (see the
  // migration's "self or conversation peer select" policy), which is what
  // lets a sender compute seen-ticks on their OWN sent messages. Indexed
  // both ways: chatLastRead (mine, by conv key, unchanged shape — still
  // what unread-counting and chatMarkRead() use) and chatReadsIndex (flat
  // `${user_id}|${conversation_key}` -> last_read_at, covering everyone
  // visible, used purely for rendering ticks/"seen by").
  const { data: reads } = await sb.from('chat_reads').select('user_id, conversation_key, last_read_at');
  chatLastRead = {};
  chatReadsIndex = {};
  (reads || []).forEach(r => {
    chatReadsIndex[`${r.user_id}|${r.conversation_key}`] = r.last_read_at;
    if(r.user_id === myUserId) chatLastRead[r.conversation_key] = r.last_read_at;
  });

  const myGroupIds = Object.keys(chatGroups);
  const orParts = [`recipient_id.is.null`, `sender_id.eq.${myUserId}`, `recipient_id.eq.${myUserId}`];
  if(myGroupIds.length) orParts.push(`group_id.in.(${myGroupIds.join(',')})`);

  const { data: msgs } = await sb.from('chat_messages')
    .select('id, sender_id, recipient_id, group_id, body, created_at, edited_at, attachment_path, attachment_name, attachment_mime')
    .or(orParts.join(','))
    .order('created_at', { ascending: false })
    .limit(CHAT_FETCH_LIMIT);

  // v212: THE actual root cause of every "client chat disappearing /
  // reordering / notification flickering" report across v206-v211 — and
  // none of those rounds could ever have caught it, because it isn't in
  // loadClientChatOverview() at all. chatConversations is ONE shared
  // dictionary used by BOTH this function (staff-to-staff: 'team', a
  // user id, 'group:<id>') AND loadClientChatOverview() ('client:<id>').
  // `chatConversations = {}` here wiped the WHOLE thing — every client
  // conversation included — then rebuilt ONLY the staff-chat entries
  // from `msgs` below, which never contains a single 'client:' row (it
  // only ever queries chat_messages, a completely different table from
  // client_chat_messages). This function runs on every 20s poll
  // (refreshAll()) and at login — so every 20 seconds, every client
  // conversation was being deleted outright and only repopulated
  // whenever loadClientChatOverview() (called separately, and NOT
  // awaited against this one in refreshAll — see the race that follows)
  // happened to win the race and run afterward. That race is exactly
  // "moves to the bottom of the list, then back to the top" (a wiped
  // conversation sorts last with no messages, then reappears once
  // repopulated), the notification badge flickering (updateChatUnreadBadge()
  // two lines below counts zero client conversations for a moment), and
  // needing a refresh to recover (a moment where the wipe was the last
  // thing to run before anyone looked).
  //
  // Fixed by only clearing the keys THIS function actually owns, leaving
  // every 'client:' entry (and whatever loadClientChatOverview() is
  // doing with it) completely alone.
  Object.keys(chatConversations).forEach(k => { if(!k.startsWith('client:')) delete chatConversations[k]; });
  (msgs || []).slice().reverse().forEach(m => chatAddMessageToState(m, false));
  updateChatUnreadBadge();
  if(chatActiveConv){
    // v212: was an unconditional renderChatThread() regardless of what
    // kind of conversation was actually open — if a CLIENT thread was
    // active, this rendered it with the wrong function entirely, against
    // whatever renderChatThread() found (or, after the wipe above used
    // to run, didn't find) at chatConversations[chatActiveConv]. That
    // mismatch is exactly why the empty state read "No messages yet —
    // say hello!" (renderChatThread()'s own fallback text) on a CLIENT
    // conversation in the reported screenshots — renderClientChatMessages()
    // has always used different wording, so seeing that exact phrase on
    // a client thread was the tell.
    if(chatActiveConv.startsWith('client:')) renderClientChatMessages(chatActiveConv.slice(7));
    else renderChatThread();
  } else {
    renderChatConvList($('chatSearchInput').value);
  }
  // v1.2.25: if this is the load right after signing in and there are
  // already unread messages waiting (sent while the user was away/offline),
  // pop the chat panel open automatically so they don't miss them — instead
  // of relying on them to notice the small badge on the FAB. Only fires on
  // this one post-login load, never on the periodic poll refresh, so it
  // can't keep re-opening a panel the user deliberately closed.
  if(isInitialLoad){
    const totalUnread = Object.values(chatConversations).reduce((t, c) => t + c.unread, 0);
    if(totalUnread > 0 && $('chatPanel').style.display === 'none'){
      $('chatPanel').style.display = 'flex';
    }
  }
}

function chatConvKeyForMessage(m){
  if(m.group_id) return 'group:' + m.group_id;
  return m.recipient_id === null ? 'team' : (m.sender_id === myUserId ? m.recipient_id : m.sender_id);
}

// ---------- v314: seen/delivered ticks + edit (internal chat) ----------
// DMs get the full WhatsApp-style 3-state treatment (sent/delivered/read).
// Team + groups get a single check plus a "Seen by" list on tap instead —
// matches what WhatsApp itself actually does for groups (no blue
// double-tick there either; you tap the message for a per-person read
// list), and sidesteps needing to define "delivered to everyone" for an
// audience that can change over time.
const CHAT_EDIT_WINDOW_MS = 15 * 60 * 1000;
function chatMessageEditable(m){
  return m.sender_id === myUserId && (Date.now() - new Date(m.created_at).getTime()) < CHAT_EDIT_WINDOW_MS;
}
function chatPersonLastSeenAt(userId){
  const person = chatDirectory.find(p => p.id === userId) || chatGroupDirectory.find(p => p.id === userId);
  return person && person.last_seen_at ? new Date(person.last_seen_at).getTime() : 0;
}
// peerId: the other party's id (DM conversation key IS their id).
function chatDmTickState(m, peerId){
  const sentMs = new Date(m.created_at).getTime();
  const peerReadAt = chatReadsIndex[`${peerId}|${myUserId}`]; // peer's own read-progress row for THEIR conversation with me
  if(peerReadAt && new Date(peerReadAt).getTime() >= sentMs) return 'read';
  if(chatPersonLastSeenAt(peerId) >= sentMs) return 'delivered';
  return 'sent';
}
function chatTicksHtml(state){
  if(state === 'sent') return '<span class="chat-tick sent" title="Sent">&#10003;</span>';
  const cls = state === 'read' ? 'read' : 'delivered';
  const title = state === 'read' ? 'Read' : 'Delivered';
  return `<span class="chat-tick ${cls}" title="${title}">&#10003;&#10003;</span>`;
}
// Audience for a team/group message's "seen by" — everyone who'd receive
// it, minus whoever sent it. Team's audience is chatGroupDirectory (every
// dashboard user, no DM-eligibility narrowing) rather than chatDirectory.
function chatSeenByNames(m, key){
  const sentMs = new Date(m.created_at).getTime();
  let audienceIds;
  if(key === 'team'){
    audienceIds = chatGroupDirectory.map(p => p.id);
  } else {
    const gid = key.slice(6);
    audienceIds = ((chatGroups[gid] && chatGroups[gid].members) || []).map(mm => mm.user_id);
  }
  return audienceIds
    .filter(id => id !== m.sender_id)
    .filter(id => {
      const readAt = chatReadsIndex[`${id}|${key}`];
      return readAt && new Date(readAt).getTime() >= sentMs;
    })
    .map(id => chatContactName(id));
}
function chatSeenByHtml(m, key){
  const names = chatSeenByNames(m, key);
  if(!names.length) return '<span class="chat-tick sent" title="Sent">&#10003;</span>';
  const label = names.length <= 3 ? names.join(', ') : `${names.slice(0, 3).join(', ')} +${names.length - 3} more`;
  return `<span class="chat-tick read chat-seen-by" title="Seen by: ${escapeHtml(names.join(', '))}">&#10003;&#10003; Seen by ${escapeHtml(label)}</span>`;
}

// ---------- notification sound (MSN Messenger–style) ----------
// An original, synthesized two-note blip — a quick, slightly "chippy"
// square-wave tick landing on a brighter triangle-wave note — built to
// evoke the late-90s/2000s IM "new message" ding rather than reproduce
// any app's actual copyrighted audio file. One shared AudioContext,
// created lazily on first use since browsers won't let one run before
// any user gesture on the page — logging in already counts as one, so
// by the time a message needs to play this, it's safe to create/resume.
let chatAudioCtx = null;
function chatPlayNotificationSound(){
  if(chatIsMyDnd()) return;   // v702: Do not disturb means no chat sound
  try{
    if(!chatAudioCtx) chatAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if(chatAudioCtx.state === 'suspended') chatAudioCtx.resume();
    // v628: the reference's incoming chime, value for value. Two SINE
    // notes that GLIDE upward rather than two fixed pitches:
    //   880 -> 1318.5Hz over 80ms, then 1760 -> 1975.5Hz from +100ms.
    // The glide is the whole character -- it is what makes this read as a
    // modern app chime instead of the square-wave MSN "blip" it replaces
    // (A#5 tick + D#6 landing note, kept here in the comment in case
    // anyone wants it back).
    const now = chatAudioCtx.currentTime;
    const glide = (fromHz, toHz, startAt, glideEnd, peak, decayEnd) => {
      const osc = chatAudioCtx.createOscillator();
      const gain = chatAudioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(fromHz, now + startAt);
      osc.frequency.exponentialRampToValueAtTime(toHz, now + glideEnd);
      gain.gain.setValueAtTime(0, now + startAt);
      gain.gain.linearRampToValueAtTime(peak, now + startAt + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.001, now + decayEnd);
      osc.connect(gain).connect(chatAudioCtx.destination);
      osc.start(now + startAt);
      osc.stop(now + decayEnd + 0.01);
    };
    glide(880,  1318.5, 0,   0.08, 0.20, 0.25);
    glide(1760, 1975.5, 0.1, 0.18, 0.25, 0.45);
  }catch(e){ console.error('Chat notification sound failed', e); }
}

// ---------- desktop notification ----------
let chatNotificationPermissionRequested = false;
function chatEnsureNotificationPermission(){
  if(chatNotificationPermissionRequested || !('Notification' in window)) return;
  chatNotificationPermissionRequested = true;
  if(Notification.permission === 'default') Notification.requestPermission();
}
function chatShowDesktopNotification(key, m){
  if(!('Notification' in window) || Notification.permission !== 'granted') return;
  if(chatIsMyDnd()) return;   // v702: ...and no chat pop-up
  const title = key === 'team' ? 'Communication' : (key.startsWith('group:') ? `${chatConvDisplayName(key)} \u00b7 ${chatContactName(m.sender_id)}` : chatContactName(m.sender_id));
  const body = m.body || (m.attachment_mime && m.attachment_mime.startsWith('audio/') ? 'Sent a voice message' : (m.attachment_name ? `Sent a file: ${m.attachment_name}` : 'New message'));
  const iconLink = document.querySelector('link[rel="icon"]');
  let n;
  try{
    n = new Notification(title, { body, icon: iconLink ? iconLink.href : undefined, tag: `chat-${key}` });
  }catch(e){ return; }
  n.onclick = () => {
    window.focus();
    $('chatPanel').style.display = 'flex';
    openChatThread(key);
    n.close();
  };
}

// Called for every message a realtime INSERT delivers — decides whether
// this counts as "worth interrupting for" (sound + OS notification) as
// opposed to just quietly updating the badge: skip if it's my own
// message, or if I'm already looking straight at that exact conversation
// with the panel open and the tab actually focused.
function chatMaybeNotify(key, m){
  if(m.sender_id === myUserId) return;
  const activelyViewing = chatActiveConv === key && $('chatPanel').style.display !== 'none' && document.hasFocus();
  // LOW-MEDIUM FIX (audit_chunk2.md #3): pushStaffNotification() used to run
  // unconditionally, before the activelyViewing check below -- so a message
  // in a thread the staff member had open and focused right now still rang
  // the bell and added a redundant Notification Center entry for something
  // already visible live in the open thread. activelyViewing was already
  // computed for exactly this purpose but only gated the sound/desktop
  // popup, not the bell itself.
  // v640: a message that MENTIONS YOU is not the same event as a message in
  // a busy channel, and it used to be treated identically -- same icon, same
  // title, and in a group the title was just the channel name, so "@Ellen
  // can you check this" arrived looking exactly like the forty messages
  // around it. Now it says who wants you and from where.
  const mentionsMe = chatMessageMentionsMe(m, key);
  const where = key === 'team' ? 'Team chat'
    : (key.startsWith('group:') ? chatConvDisplayName(key) : chatContactName(m.sender_id));
  if(!activelyViewing){
    pushStaffNotification({
      icon: mentionsMe ? '📣' : '💬',
      priority: mentionsMe, // v642: a mention needs you; an ordinary message does not
      title: mentionsMe
        ? `${chatContactName(m.sender_id)} mentioned you${key === 'team' || key.startsWith('group:') ? ' in ' + where : ''}`
        : where,
      body: m.body || (m.attachment_name ? `Sent a file: ${m.attachment_name}` : 'New message'),
      onClick: () => { $('chatPanel').style.display = 'flex'; openChatThread(key); },
      // Ordinary chat stays silent here because chatPlayNotificationSound()
      // and the desktop popup below already cover it. A MENTION is
      // deliberately NOT silent: that also routes it through
      // pushSelfNotification(), so it reaches your phone or a minimised
      // browser, which an ordinary channel message should not do.
      silent: !mentionsMe || chatIsMyDnd(),   // v702: Do not disturb silences a mention too
    });
  }
  if(activelyViewing) return;
  chatPlayNotificationSound();
  chatShowDesktopNotification(key, m);
}


// ---------- v641: profile menu ----------
// Replaces the bare "Sign out" button in the header. The button itself was
// NOT deleted -- it kept its id and moved inside this panel -- so the
// existing sign-out handler and the idle-timeout code that shares it are
// untouched.
function profileMenuInitials(name, email){
  const src = (name || email || '').trim();
  if(!src) return '—';
  const parts = src.split(/\s+/).filter(Boolean);
  if(parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
  return src.slice(0, 2).toUpperCase();
}
function renderProfileMenu(){
  const name = myFullName || myEmail || '';
  const initials = profileMenuInitials(myFullName, myEmail);
  const setText = (id, v) => { const el = $(id); if(el) el.textContent = v; };
  setText('profileMenuInitials', initials);
  setText('profileMenuAvatar', initials);
  // v702: your photo, when you have one -- in the menu and on its button.
  if(myAvatarUrl){
    const img = `<img src="${escapeHtml(myAvatarUrl)}" alt="">`;
    if($('profileMenuAvatar')) $('profileMenuAvatar').innerHTML = img;
    if($('profileMenuInitials')) $('profileMenuInitials').innerHTML = img;
  }
  setText('profileMenuName', name);
  setText('profileMenuEmail', myEmail || '');
  // Title and department, the reason this menu exists. Falls back to the
  // role label so somebody uncategorised still sees something meaningful
  // rather than a blank line.
  const roleEl = $('profileMenuRole');
  if(roleEl){
    const line = [myTitle, myDepartment].filter(Boolean).join(' · ');
    roleEl.textContent = line || (typeof roleDisplayLabel === 'function' ? roleDisplayLabel(myRole || '') : (myRole || ''));
  }
  const btn = $('profileMenuBtn');
  if(btn) btn.title = [name, myTitle, myDepartment].filter(Boolean).join(' — ') || 'Your profile';
}
function profileMenuSetOpen(open){
  const panel = $('profileMenuPanel'), btn = $('profileMenuBtn');
  if(!panel || !btn) return;
  panel.style.display = open ? 'block' : 'none';
  btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  if(open){ renderProfileMenu(); pmGoogleRefresh(); }   // v696: Google status too
}
(function wireProfileMenu(){
  const btn = $('profileMenuBtn');
  if(!btn) return;
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    profileMenuSetOpen($('profileMenuPanel').style.display === 'none');
  });
  // Click-away and Escape, so it behaves like every other menu rather than
  // needing a second click on the button to dismiss.
  document.addEventListener('click', (e) => {
    const wrap = $('profileMenuWrap');
    if(wrap && !wrap.contains(e.target)) profileMenuSetOpen(false);
  });
  document.addEventListener('keydown', (e) => { if(e.key === 'Escape') profileMenuSetOpen(false); });
})();

// ---------- v696: Google (Gmail & Calendar) in the profile menu ----------
// The caller's OWN Google connection -- the one the dialer sends automatic
// emails from, reads Conversations with and puts appointments on -- managed
// from here as well as from the dialer's profile menu. Everything goes
// through dialer-conversations (status / connect_url / disconnect): one
// function for the whole card in both places. A role without Conversations
// or Appointments gets a 403 on status, and the section stays hidden.
async function pmGoogleCall(action){
  const { data, error } = await sb.functions.invoke('dialer-conversations', { body: { action } });
  if(error){
    let msg = error.message || 'Request failed';
    const status = error.context && error.context.status;
    try { const b = await error.context.json(); if(b && b.error) msg = b.error; } catch(e){}
    return { ok: false, error: msg, status };
  }
  return data || { ok: false, error: 'No answer from the server' };
}
async function pmGoogleRefresh(){
  const sec = $('pmGoogle');
  if(!sec) return;
  const r = await pmGoogleCall('status');
  if(!r.ok){
    if(r.status === 403){ sec.style.display = 'none'; return; }   // this role has no use for it
    sec.style.display = 'block';
    $('pmGoogleState').textContent = 'Could not check your Google connection.';
    $('pmGoogleConnect').style.display = 'none';
    $('pmGoogleDisconnect').style.display = 'none';
    return;
  }
  sec.style.display = 'block';
  const partial = r.connected && (!r.can_read || !r.can_calendar);
  $('pmGoogleState').innerHTML = r.connected
    ? `Connected as <b>${escapeHtml(r.email || 'your Google account')}</b>${partial ? ' — some permissions are missing' : ''}`
    : 'Not connected. Use your @proptechnologyai.com Google account.';
  $('pmGoogleConnect').textContent = partial ? 'Reconnect for the rest' : 'Connect Google';
  $('pmGoogleConnect').style.display = (!r.connected || partial) ? '' : 'none';
  $('pmGoogleDisconnect').style.display = r.connected ? '' : 'none';
}
(function wirePmGoogle(){
  if(!$('pmGoogleConnect')) return;
  $('pmGoogleConnect').addEventListener('click', async (e) => {
    e.stopPropagation();
    const w = window.open('', '_blank');   // opened before the await, or the browser blocks it
    const r = await pmGoogleCall('connect_url');
    if(!r.ok || !r.url){
      if(w) w.close();
      $('pmGoogleState').textContent = r.error || 'Could not start the Google connection.';
      return;
    }
    if(w) w.location = r.url; else location.href = r.url;
    $('pmGoogleState').textContent = 'Finish in the Google tab, then come back here.';
  });
  $('pmGoogleDisconnect').addEventListener('click', async (e) => {
    e.stopPropagation();
    if(!confirm('Disconnect your Google account? Automatic emails, the email side of Conversations and calendar invitations all stop until you connect it again.')) return;
    $('pmGoogleDisconnect').disabled = true;
    const r = await pmGoogleCall('disconnect');
    $('pmGoogleDisconnect').disabled = false;
    if(!r.ok){ $('pmGoogleState').textContent = 'Could not disconnect: ' + (r.error || 'unknown error'); return; }
    await pmGoogleRefresh();
  });
  // Back from Google's consent tab with the menu still open.
  window.addEventListener('focus', () => {
    const panel = $('profileMenuPanel');
    if(panel && panel.style.display !== 'none') pmGoogleRefresh();
  });
})();

// ---------- v125: staff notification center ----------
// In-memory only (rebuilt fresh each session), same approach as the client
// portal's notification center added in v118 — no new table, no schema
// change. Aggregates chat messages (via chatMaybeNotify above), new tickets
// awaiting staff review, tickets a client just accepted, and new client
// dispute/feedback replies.
let staffNotifications = [];
// v729: 300, not 50 -- room for the 30 days the bell promises (see
// staffNotifSave below).
const STAFF_NOTIF_MAX = 300;
const STAFF_NC_KEEP_MS = 30 * 24 * 3600 * 1000;
let staffNotifRestored = false;
// v136: unread count (drives both the badge number and the ringing
// animation) tracked separately from the full history above — same
// pattern the client portal's own notification center already uses.
// Resets to 0 the moment the panel is opened ("steady once opened");
// a notification that arrives while the panel is already open doesn't
// bump it, mirroring how the portal treats "currently being looked at".
let staffNotifUnread = 0;
let staffNotifOpen = false;

function pushStaffNotification({ icon, title, body, onClick, silent, durableId, at, priority, readAt }){
  const id = `n${Date.now()}${Math.random().toString(36).slice(2, 6)}`;
  // v592: durableId ties an entry to its staff_notifications row, so
  // clicking or clearing it marks that row read.
  // v642: readAt makes per-item unread state possible (the dot and the
  // "Only show unread" filter); priority decides which tab it lands in.
  staffNotifications.unshift({ id, icon, title, body, onClick, durableId, priority: priority === true, readAt: readAt || null, at: at || Date.now() });
  // v729: restored history and 30 days of saved rows interleave by time.
  staffNotifications.sort((a, b) => (b.at || 0) - (a.at || 0));
  if(staffNotifications.length > STAFF_NOTIF_MAX) staffNotifications.length = STAFF_NOTIF_MAX;
  if(!staffNotifOpen && !readAt) staffNotifUnread++;
  renderNotifCenter();
  staffNotifSave();   // v729
  if(!durableId) staffNotifPersist(staffNotifications.find(n => n.id === id));   // v730: on the server too -- any device
  if(!silent) staffPlayOpsNotificationSound();
  // v492: every OTHER Notification Center alert (new lead, ticket, dispute
  // reply, billing activity, HR review, etc.) used to live ONLY in this
  // in-page list -- real OS push (see "Web Push (chat + calls)" below) was
  // wired up for chat DMs/calls alone, so none of this ever reached you
  // once you left the tab. Reuses that same already-authorized send path
  // (self-targeting passes can_chat_dm() trivially -- a user's role always
  // equals their own role) via pushSelfNotification() just below, skipped
  // when this tab is the one currently focused (its own in-app toast right
  // above is already the alert; a push on top would just double-ding the
  // same device) and for `silent` calls (same reasoning silent already
  // uses to skip the notification sound).
  if(!silent && !document.hasFocus()) pushSelfNotification({ title, body, tag: id });
}

// v492: companion to notifyPushRecipients() below, for the ONE case that
// deliberately excludes -- pushing a business-event alert to this SAME
// user's other open tabs/devices (e.g. a phone with push enabled, or this
// browser merely minimized) when THIS tab isn't the one currently in
// focus. notifyPushRecipients() itself can't be reused as-is: it filters
// out `id === myUserId` on purpose (chat/calls always target someone
// else). Fire-and-forget, same as notifyPushRecipients -- a failed/slow
// push here should never block rendering the in-app notification above.
function pushSelfNotification({ title, body, tag }){
  if(!myUserId) return;
  sb.functions.invoke('send-push-notification', { body: { user_id: myUserId, title, body, tag, url: '/' /* v636: was '/dashboard/dashboard.html', which 404s in production -- this portal is served from the ROOT and live/main has no dashboard/ directory at all. Worse than a dead link: sw.js focuses an already-open tab and then navigates it to this url, so clicking any push took a working signed-in portal and broke it. sw.js already defaults to '/' when no url is sent; this was overriding that. */ } })
    .then(({ error }) => { if(error) console.error('send-push-notification (self) failed', error); })
    .catch(err => console.error('send-push-notification (self) call failed', err));
}


// v729 (the owner: "Notifications sent to this inbox can be viewed for up to
// 30 days? -- they disappear; make them stay 30 days in both staff & client
// portals"). The bell said 30 days but kept nothing past a reload: the list
// was in-memory, and staff_notifications rows came back only while unread.
// Now, for 30 days:
//   - the list is saved in this browser per signed-in user
//     ('ncHistory:staff:<user id>') and put back at sign-in;
//   - server rows (missed calls, follow-ups, call backs handed over, ...) load
//     back read or unread, on any device -- the server is their record, so
//     they are left out of the browser copy.
// A restored browser item that pointed somewhere cannot carry that link
// across a reload (it was a function); it opens its detail card instead.
// Nothing is saved until the history has been put back, so an early
// notification at sign-in cannot overwrite it.
function staffNotifKey(){ return myUserId ? 'ncHistory:staff:' + myUserId : null; }
function staffNotifSave(){
  const key = staffNotifKey();
  if(!key || !staffNotifRestored) return;
  const cutoff = Date.now() - STAFF_NC_KEEP_MS;
  const keep = staffNotifications
    .filter(n => !n.durableId && (n.at || 0) >= cutoff)
    .map(n => ({ id: n.id, icon: n.icon || null, title: n.title || '', body: n.body || '', priority: n.priority === true, readAt: n.readAt || null, at: n.at || Date.now() }));
  try{ localStorage.setItem(key, JSON.stringify(keep)); }catch(e){ /* full or blocked: the list still works this session */ }
}
function staffNotifRestore(){
  const key = staffNotifKey();
  if(!key || staffNotifRestored) return;
  let saved = [];
  try{ saved = JSON.parse(localStorage.getItem(key) || '[]'); }catch(e){ saved = []; }
  const cutoff = Date.now() - STAFF_NC_KEEP_MS;
  const have = new Set(staffNotifications.map(n => n.id));
  (Array.isArray(saved) ? saved : []).filter(n => n && n.id && (n.at || 0) >= cutoff && !have.has(n.id))
    .forEach(n => staffNotifications.push(n));
  staffNotifications.sort((a, b) => (b.at || 0) - (a.at || 0));
  if(staffNotifications.length > STAFF_NOTIF_MAX) staffNotifications.length = STAFF_NOTIF_MAX;
  staffNotifRestored = true;
  staffNotifSave();   // drops anything that has aged past 30 days
  renderNotifCenter();
  staffNotifications.filter(n => !n.durableId).forEach(staffNotifPersist);   // v730: history kept only in this browser goes to the server once
}

// v730 (the owner: "make notifications stay on any device too"). Every
// notification this page raises is also written to staff_notifications as
// kind 'portal' (RLS lets a user insert only their own rows, only that kind),
// so the 30-day history loads on any device -- and in the dialer's bell. The
// row id is made here and registered as already shown BEFORE the insert, so
// the realtime echo of our own row is ignored; the same event raised in a
// second open tab is folded into the first by staffNotifDuplicate().
function staffNotifPersist(n){
  if(!n || n.durableId || n.persisting || !myUserId || !(window.crypto && crypto.randomUUID)) return;
  n.persisting = true;
  const rowId = crypto.randomUUID();
  shownDurableNotifIds.add(rowId);
  sb.from('staff_notifications').insert({
    id: rowId, user_id: myUserId, kind: 'portal',
    title: String(n.title || '').slice(0, 300),
    body: n.body ? String(n.body).slice(0, 2000) : null,
    icon: n.icon || null, priority: n.priority === true,
    created_at: new Date(n.at || Date.now()).toISOString(),
    read_at: n.readAt ? new Date(n.readAt).toISOString() : null,
  }).then(({ error }) => {
    n.persisting = false;
    if(error){ console.warn('notification not saved to the server:', error.message); return; }
    n.durableId = rowId;
    if(n.readAt) markStaffNotificationsRead([rowId]);   // read while the insert was in flight
    staffNotifSave();   // on the server now -- the browser copy drops it
  });
}
// The same title and body within two minutes is the same event.
function staffNotifDuplicate(row){
  const at = row.created_at ? new Date(row.created_at).getTime() : Date.now();
  return staffNotifications.find(n => n.durableId !== row.id
    && (n.title || '') === (row.title || '') && (n.body || '') === (row.body || '')
    && Math.abs((n.at || 0) - at) < 120000) || null;
}

// v642: the staff portal's binding for the shared notification centre below.
var NC_ADAPTER = {
  items: function(){ return staffNotifications; },
  // The bell badge counts UNREAD ITEMS now, not "arrived since you last
  // opened the panel". Opening the panel used to zero the counter whether or
  // not you had actually looked at anything in it.
  refreshBadge: function(){
    staffNotifUnread = (staffNotifications || []).filter(ncIsUnread).length;
    var badge = $('notifBellBadge'), bell = $('notifBellBtn');
    if(badge){
      badge.textContent = staffNotifUnread > 99 ? '99+' : String(staffNotifUnread);
      badge.style.display = staffNotifUnread > 0 ? 'flex' : 'none';
    }
    if(bell) bell.classList.toggle('ringing', staffNotifUnread > 0);
  },
  onRead: function(n){
    // markStaffNotificationsRead takes an ARRAY of durable row ids.
    // v730: plus any copy of the same event folded into this one.
    var ids = [n.durableId].concat(n.dupIds || []).filter(Boolean);
    if(ids.length && typeof markStaffNotificationsRead === 'function') markStaffNotificationsRead(ids);
    staffNotifSave();   // v729: remember it was read
  },
  onMarkAllRead: function(){
    var ids = [];
    (staffNotifications || []).forEach(function(n){ if(n.durableId) ids.push(n.durableId); (n.dupIds || []).forEach(function(d){ ids.push(d); }); });
    if(ids.length && typeof markStaffNotificationsRead === 'function') markStaffNotificationsRead(ids);
    staffNotifSave();   // v729
  },
  onClose: function(){ staffNotifOpen = false; }
};

// ---------- v642: notification centre (shared between both portals) ----------
// Generated once and inserted into the staff and client portals, so the two
// cannot drift. Each portal supplies NC_ADAPTER above; everything here is
// byte-identical in both files.
//
// PER-ITEM READ STATE IS NEW. Both portals previously tracked only a global
// unread COUNT, which is enough for a badge and nothing else -- there was no
// way to know which individual notification was unread, so the reference's
// per-card dot and its "Only show unread" filter had nothing to read. Items
// now carry readAt, defaulting to null (unread).
var ncTab = 'priority';
var ncUnreadOnly = false;
var ncDetailId = null;

// PRIORITY vs OTHERS. An item is Priority only when explicitly flagged --
// opt-in rather than guessed from the title, so a wording change cannot
// silently reclassify something. Priority means "this needs you now": you
// were mentioned, a client is waiting for a human, a call is ringing.
// Everything informational (payment succeeded, campaign status, a lead
// landed) is Others, which is what the reference shows there.
function ncIsPriority(n){ return n && n.priority === true; }
function ncIsUnread(n){ return !n || !n.readAt; }

function ncRelTime(ts){
  var diff = Date.now() - ts;
  var mins = Math.floor(diff / 60000);
  if(mins < 1) return 'Just now';
  if(mins < 60) return mins + (mins === 1 ? ' minute ago' : ' minutes ago');
  var hours = Math.floor(mins / 60);
  if(hours < 24) return hours + (hours === 1 ? ' hour ago' : ' hours ago');
  var days = Math.floor(hours / 24);
  return days + (days === 1 ? ' day ago' : ' days ago');
}

function ncVisibleItems(){
  var all = NC_ADAPTER.items() || [];
  return all.filter(function(n){
    if(ncTab === 'priority' ? !ncIsPriority(n) : ncIsPriority(n)) return false;
    if(ncUnreadOnly && !ncIsUnread(n)) return false;
    return true;
  });
}

// The filter switch and the Priority/Others tabs belong to the LIST. Left on
// screen in the detail view they are live controls over a list you cannot
// see, so the detail reads as a filtered list rather than as one
// notification. The back link is the only way out of the detail view.
function ncChrome(show){
  ['.nc-controls', '.nc-tabs'].forEach(function(sel){
    var el = document.querySelector(sel);
    if(el) el.style.display = show ? '' : 'none';
  });
}

function ncRenderList(){
  var list = document.getElementById('notifCenterList');
  var detail = document.getElementById('ncDetail');
  if(!list) return;
  if(ncDetailId){ ncRenderDetail(); return; }
  if(detail) detail.style.display = 'none';
  list.style.display = 'block';
  ncChrome(true);

  document.querySelectorAll('.nc-tab').forEach(function(b){
    b.classList.toggle('active', b.dataset.ncTab === ncTab);
  });
  var sw = document.getElementById('ncUnreadSwitch');
  if(sw) sw.setAttribute('aria-checked', ncUnreadOnly ? 'true' : 'false');

  var items = ncVisibleItems();
  if(!items.length){
    list.innerHTML = '<div class="notif-center-empty">No notifications</div>';
    ncPositionPanel();
    return;
  }
  list.innerHTML = items.map(function(n){
    var readCls = ncIsUnread(n) ? '' : ' is-read';
    var bodyHtml = n.body ? ('<div class="notif-center-item-body">' + escapeHtml(n.body) + '</div>') : '';
    return '<div class="notif-center-item' + readCls + '" data-notif-id="' + n.id + '">'
      + '<span class="nc-dot"></span>'
      + '<div class="notif-center-item-title">' + escapeHtml(n.title || '') + '</div>'
      + bodyHtml
      + '<div class="notif-center-item-time">' + ncRelTime(n.at || n.time || Date.now()) + '</div>'
      + '</div>';
  }).join('');
  list.querySelectorAll('.notif-center-item').forEach(function(el){
    el.addEventListener('click', function(){ ncOpenDetail(el.dataset.notifId); });
  });
  ncPositionPanel();
}

// v645: CLICKING A NOTIFICATION NOW GOES WHERE THE WORK IS. v642 put the
// detail card between the list and the notification's destination, so
// acting on something took two clicks and the second one was not obviously
// there. Every notification that points somewhere already carried an
// onClick that activates the right tab and section -- that routing existed
// and was simply being gate-kept.
//
// The detail card is NOT gone: it is what an item with nowhere to go opens
// instead (the appointment and new-email notifications deliberately have no
// onClick, see v623), so the click always does the most useful thing
// available rather than sometimes doing nothing.
function ncOpenDetail(id){
  var n = (NC_ADAPTER.items() || []).find(function(x){ return String(x.id) === String(id); });
  if(!n) return;
  if(ncIsUnread(n)){
    n.readAt = Date.now();
    if(NC_ADAPTER.onRead) NC_ADAPTER.onRead(n);
  }
  if(NC_ADAPTER.refreshBadge) NC_ADAPTER.refreshBadge();

  if(typeof n.onClick === 'function'){
    var panel = document.getElementById('notifCenterPanel');
    if(panel) panel.style.display = 'none';
    ncDetailId = null;
    if(NC_ADAPTER.onClose) NC_ADAPTER.onClose();
    try{ n.onClick(); }
    catch(e){ console.error('notification onClick failed', e); }
    return;
  }

  ncDetailId = id;
  ncRenderDetail();
}

function ncRenderDetail(){
  var list = document.getElementById('notifCenterList');
  var detail = document.getElementById('ncDetail');
  if(!detail) return;
  var n = (NC_ADAPTER.items() || []).find(function(x){ return String(x.id) === String(ncDetailId); });
  if(!n){ ncDetailId = null; ncRenderList(); return; }
  if(list) list.style.display = 'none';
  detail.style.display = 'block';
  ncChrome(false);
  var created = new Date(n.at || n.time || Date.now());
  var createdLabel = created.toLocaleString([], { month:'long', day:'numeric', year:'numeric', hour:'2-digit', minute:'2-digit' });
  var bodyHtml = n.body ? ('<div class="nc-detail-body">' + escapeHtml(n.body) + '</div>') : '';
  var goHtml = n.onClick
    ? '<button type="button" class="nc-markall" id="ncGoBtn" style="margin-top:16px; background:var(--focus); color:#1A1206; justify-content:center; font-weight:700;">Open</button>'
    : '';
  detail.innerHTML = '<button type="button" class="nc-back" id="ncBackBtn">&#8592; All notifications</button>'
    + '<div class="nc-detail-card">'
    + '<div class="nc-detail-title">' + escapeHtml(n.title || '') + '</div>'
    + '<div class="nc-detail-created">Created at: ' + escapeHtml(createdLabel) + '</div>'
    + bodyHtml + goHtml
    + '</div>';
  var back = document.getElementById('ncBackBtn');
  if(back) back.addEventListener('click', function(){ ncDetailId = null; ncRenderList(); });
  var go = document.getElementById('ncGoBtn');
  if(go) go.addEventListener('click', function(){
    var panel = document.getElementById('notifCenterPanel');
    if(panel) panel.style.display = 'none';
    ncDetailId = null;
    if(n.onClick) n.onClick();
  });
}


// v642: keep the panel on screen. It is 380px wide and anchored right:0 to
// its wrapper, and in the staff portal that wrapper sits near the LEFT edge
// of the header -- measured at x=148, which put the panel's left edge at
// -194px, i.e. 194px off-screen. Rather than hard-coding a side per portal
// (they differ, and a header can be rearranged), this measures and nudges it
// back inside whichever edge it overflows.
function ncPositionPanel(){
  var panel = document.getElementById('notifCenterPanel');
  var wrap = document.querySelector('.notif-center-wrap');
  if(!panel || !wrap) return;
  if(getComputedStyle(panel).display === 'none') return;
  var GUTTER = 12;
  panel.style.right = '0px';
  panel.style.left = 'auto';
  var r = panel.getBoundingClientRect();
  if(r.left < GUTTER){
    panel.style.right = (r.left - GUTTER) + 'px';      // shift right
  } else if(r.right > window.innerWidth - GUTTER){
    panel.style.right = (r.right - window.innerWidth + GUTTER) + 'px'; // shift left
  }
}
window.addEventListener('resize', ncPositionPanel);

function ncMarkAllRead(){
  (NC_ADAPTER.items() || []).forEach(function(n){ if(!n.readAt) n.readAt = Date.now(); });
  if(NC_ADAPTER.onMarkAllRead) NC_ADAPTER.onMarkAllRead();
  if(NC_ADAPTER.refreshBadge) NC_ADAPTER.refreshBadge();
  ncRenderList();
}

(function ncWire(){
  function on(id, ev, fn){ var el = document.getElementById(id); if(el) el.addEventListener(ev, fn); }
  document.querySelectorAll('.nc-tab').forEach(function(b){
    b.addEventListener('click', function(){ ncTab = b.dataset.ncTab; ncDetailId = null; ncRenderList(); });
  });
  on('ncUnreadSwitch', 'click', function(e){
    e.preventDefault();
    ncUnreadOnly = !ncUnreadOnly;
    ncDetailId = null;
    ncRenderList();
  });
  on('ncMoreBtn', 'click', function(e){
    e.stopPropagation();
    var m = document.getElementById('ncMoreMenu');
    if(!m) return;
    var open = m.style.display === 'none';
    m.style.display = open ? 'block' : 'none';
    e.currentTarget.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  on('ncMarkAllBtn', 'click', function(){
    var m = document.getElementById('ncMoreMenu');
    if(m) m.style.display = 'none';
    ncMarkAllRead();
  });
  on('ncCloseBtn', 'click', function(){
    var p = document.getElementById('notifCenterPanel');
    if(p) p.style.display = 'none';
    ncDetailId = null;
    if(NC_ADAPTER.onClose) NC_ADAPTER.onClose();
  });
  // The overflow menu closes on any outside click, like every other menu here.
  document.addEventListener('click', function(e){
    var w = document.querySelector('.nc-more-wrap');
    var m = document.getElementById('ncMoreMenu');
    if(m && w && !w.contains(e.target)) m.style.display = 'none';
  });
})();

// v642: now a thin delegate. Every existing caller (pushStaffNotification,
// the realtime handlers, the bell wiring) still calls renderNotifCenter();
// the panel itself is rendered by the shared ncRenderList() above.
function renderNotifCenter(){
  NC_ADAPTER.refreshBadge();
  ncRenderList();
}

// A short three-note ascending chime — deliberately different from the chat
// "blip" above so staff can tell an ops alert (ticket/dispute) apart from a
// chat message by ear without looking at the screen.
function staffPlayOpsNotificationSound(){
  try{
    if(!chatAudioCtx) chatAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if(chatAudioCtx.state === 'suspended') chatAudioCtx.resume();
    const notes = [
      { freq: 587.33, type: 'sine', at: 0,    dur: 0.11, vol: 0.13 }, // D5
      { freq: 739.99, type: 'sine', at: 0.09, dur: 0.11, vol: 0.13 }, // F#5
      { freq: 987.77, type: 'sine', at: 0.18, dur: 0.20, vol: 0.15 }, // B5
    ];
    notes.forEach(n => {
      const start = chatAudioCtx.currentTime + n.at;
      const osc = chatAudioCtx.createOscillator();
      const gain = chatAudioCtx.createGain();
      osc.type = n.type;
      osc.frequency.value = n.freq;
      gain.gain.setValueAtTime(0, start);
      gain.gain.linearRampToValueAtTime(n.vol, start + 0.012);
      gain.gain.exponentialRampToValueAtTime(0.0001, start + n.dur);
      osc.connect(gain).connect(chatAudioCtx.destination);
      osc.start(start);
      osc.stop(start + n.dur + 0.02);
    });
  }catch(e){ console.error('Ops notification sound failed', e); }
}
// v687: browsers keep audio switched off until the person clicks or types, and
// a context first created by a notification stays silent -- so the first
// notification sound of a session often never played. Create and resume it
// on the first interaction, so every later notification is heard.
['pointerdown', 'keydown', 'touchstart'].forEach(ev => document.addEventListener(ev, () => {
  try{
    if(!chatAudioCtx) chatAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if(chatAudioCtx.state === 'suspended') chatAudioCtx.resume();
  }catch(e){ /* no audio is not an error */ }
}, { capture: true, passive: true }));

// A quieter, single soft tone for the "recipient is offline" send-time hint
// — informational, not something worth interrupting for, so it's shorter
// and quieter than either notification chime above.
function chatPlayOfflineHintSound(){
  try{
    if(!chatAudioCtx) chatAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if(chatAudioCtx.state === 'suspended') chatAudioCtx.resume();
    const start = chatAudioCtx.currentTime;
    const osc = chatAudioCtx.createOscillator();
    const gain = chatAudioCtx.createGain();
    osc.type = 'sine';
    osc.frequency.value = 392.00; // G4 — low, unobtrusive
    gain.gain.setValueAtTime(0, start);
    gain.gain.linearRampToValueAtTime(0.08, start + 0.015);
    gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.18);
    osc.connect(gain).connect(chatAudioCtx.destination);
    osc.start(start);
    osc.stop(start + 0.2);
  }catch(e){ console.error('Offline hint sound failed', e); }
}

function initNotifCenter(){
  const bellBtn = $('notifBellBtn');
  const panel = $('notifCenterPanel');
  const clearBtn = $('notifClearBtn');
  if(!bellBtn || bellBtn.dataset.wired) return;
  bellBtn.dataset.wired = '1';
  bellBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    staffNotifOpen = panel.style.display === 'none';
    panel.style.display = staffNotifOpen ? 'block' : 'none';
    if(staffNotifOpen){
      // v642: NO LONGER zeroes the count. Unread is per item now, so opening
      // the panel is not the same as having read anything in it -- that is
      // what "Mark all as read" is for.
      renderNotifCenter();
    }
  });
  document.addEventListener('click', (e) => {
    if(panel.style.display !== 'none' && !panel.contains(e.target) && e.target !== bellBtn){
      panel.style.display = 'none';
      staffNotifOpen = false;
    }
  });
  clearBtn.addEventListener('click', () => {
    markStaffNotificationsRead(staffNotifications.map(n => n.durableId).filter(Boolean));
    staffNotifications = [];
    staffNotifUnread = 0;
    renderNotifCenter();
  });
  renderNotifCenter();
}

// v307: Notifications Setting (User Management subtab) — which user types
// see each of these client-triggered staff notifications. Stored as a
// JSON array of role NAMES under app_settings key staff_notif_roles_<kind>;
// no saved row for a kind = every role sees it (today's behavior, unchanged
// until an Owner/Admin narrows it from that subtab). An explicit saved
// array (including an empty one, meaning "notify nobody") always wins over
// the default. A role created AFTER a kind was narrowed is not
// automatically added to that kind's list — same "explicit wins" tradeoff,
// re-save to pick up a new role.
// v: briefly switched to per-individual routing (staff_notif_users_<kind>,
// array of profile ids), then reverted back to per-role per explicit
// follow-up request — the per-user experiment's settings were converted
// back into the equivalent role sets before this shipped.
const STAFF_NOTIF_KINDS = [
  { key: 'ticket_new', label: 'New ticket to review' },
  { key: 'lead_submitted', label: 'New lead submitted (Leads Queue Review)' },
  { key: 'lead_submitted_primehome', label: 'New lead submitted (Leads Queue Review — PrimeHome Buyers)' },   // v717
  { key: 'ticket_accepted', label: 'Client accepted a ticket' },
  { key: 'ticket_declined', label: 'Client declined a ticket' },
  { key: 'dispute_reply', label: 'Client reply on a dispute/feedback thread' },
  { key: 'campaign_guide_edit', label: 'Campaign Guide edit proposed' },
  { key: 'campaign_requested', label: 'New campaign requested' },
  // v356: three more client-triggered events that previously had no
  // notification-center entry at all -- a new one-time charge (client_
  // one_off_charges, covers both a staff-created charge and a system-
  // generated one from a failed caller-change proration, see chargeProrationNow's
  // comment in client-manage-subscription), a paid "Buy a list" request,
  // and a paid skip-trace order.
  { key: 'billing_activity', label: 'Billing activity (new one-time charge)' },
  { key: 'list_order_requested', label: 'New "Buy a list" request' },
  { key: 'skiptrace_order_paid', label: 'Skip trace order placed' },
  // v492: was already live-gating chatPollSmsForNotifications() (search
  // 'client_sms_reply' below) but had no entry here -- so it never appeared
  // in this Notifications Setting subtab at all, meaning an Owner/Admin
  // couldn't see it existed or narrow which roles get it. It silently
  // defaulted to "every canTextClients role" with no way to change that.
  // Fixed by giving it a real row like every other kind; behavior is
  // unchanged for anyone who hasn't touched this subtab yet (still defaults
  // open), but it's now visible and configurable.
  { key: 'client_sms_reply', label: 'Client replied via SMS' },
  // v: split out of client_sms_reply above -- Gmail's "new mail in the
  // shared inbox" notifier (pollGmailReplyNotifications) used to piggyback
  // on that exact same toggle, per explicit request that it get its own
  // routing instead of going to "all" canTextClients staff with no way to
  // narrow it. Still requires canTextClients as a base gate (same
  // permission that makes the Gmail Inbox subtab itself visible -- no
  // point notifying someone about mail they can't open), but which of
  // those roles actually gets pinged is now independently configurable
  // right here, same as every other kind in this array.
  { key: 'gmail_new_message', label: 'New email received (Gmail Inbox)' },
  // v494: same gap as client_sms_reply above, found the same way -- these 4
  // Human Resources hr_candidates notifications (search 'hr_candidate_' in
  // the realtime block above) had real staffNotifKindAllowed() gates added
  // alongside this same fix, but no row here until now, so an Owner/Admin
  // had no way to see them or narrow who gets them. Split into 4 (not 1
  // combined "HR activity" entry) to match this array's own established
  // granularity -- ticket_accepted/ticket_declined above are two entries
  // for the same reason despite being thematically similar.
  { key: 'hr_candidate_submitted', label: 'New HR candidate submitted for review' },
  { key: 'hr_candidate_approved', label: 'HR candidate submission approved' },
  { key: 'hr_candidate_rejected', label: 'HR candidate submission rejected' },
  { key: 'hr_candidate_closed', label: 'HR candidate account closed (terminated/found other offer)' },
  // v495: Activity -> GoHighLevel -> Appointments never had a notification
  // at all -- ghl_appointments (populated by ghl-webhook on every real
  // booking, whether made through this portal's own book_appointment flow
  // or directly in GHL) wasn't even in the supabase_realtime publication
  // yet, so no INSERT here could ever reach a browser regardless of
  // staffNotifKindAllowed. Added to the publication in the same migration
  // as this row (see v495_ghl_appointments_realtime_publication) -- RLS
  // already gates delivery correctly (role_has_any_tab('call_activity')
  // AND role_can_view_activity_section('appointment'), fixed in v491), so
  // this is purely additive, same two-layer design as every other kind.
  { key: 'appointment_booked', label: 'New appointment booked' },
  // v (user request, 2026-09-05): a new client account (staff-created via
  // "Add client", or self-signed-up through public-skiptrace's
  // client_signup) previously had zero staff-facing notification of any
  // kind -- nobody found out until someone happened to check User
  // Management -> Clients. client_accounts added to the supabase_realtime
  // publication in the same migration as this row (see
  // v520-client-accounts-realtime-and-notif-prefs.sql). RLS on
  // client_accounts (is_admin(), or the client's own row, or a staff
  // member with an assigned chat thread to that client) is deliberately
  // NOT broadened for this -- it already matches who can see the Clients
  // list at all today, so this only ever reaches staff who could already
  // see the new row by opening that tab themselves.
  { key: 'new_client', label: 'New client account created' },
];
// v: briefly switched to per-INDIVIDUAL routing, then reverted back to
// per-ROLE per explicit follow-up request — staff_notif_roles_<kind>
// (array of role names) is the live shape again. The per-user
// experiment's own settings were converted back into the equivalent
// role sets (same reasoning as the original migration, just mirrored)
// before this shipped, so nobody's setup silently reset to "everyone".
let staffNotifRolesCache = {}; // { [kind]: string[] | null } — null = every role
async function fetchStaffNotifRolesConfig(){
  const keys = STAFF_NOTIF_KINDS.map(k => `staff_notif_roles_${k.key}`);
  const { data: rows } = await sb.from('app_settings').select('key, value').in('key', keys);
  const byKey = {}; (rows || []).forEach(r => { byKey[r.key] = r.value; });
  const cfg = {};
  STAFF_NOTIF_KINDS.forEach(k => {
    const raw = byKey[`staff_notif_roles_${k.key}`];
    let arr = null;
    if(raw != null){ try{ const parsed = JSON.parse(raw); if(Array.isArray(parsed)) arr = parsed; }catch{ /* malformed — treat as unset */ } }
    cfg[k.key] = arr;
  });
  staffNotifRolesCache = cfg;
  return cfg;
}
function staffNotifKindAllowed(kind){
  const arr = staffNotifRolesCache[kind];
  if(!arr) return true; // unset for this kind — default is everyone
  return arr.includes(myRole);
}

// New ticket submissions and client ticket responses live as ticket_stage
// transitions on the leads table (see supabase/schema.sql, "leads.ticket_stage
// column"); client dispute/feedback replies live in lead_dispute_messages.
// Both tables already have realtime enabled (used by the client portal's own
// notification center in the other direction) — no migration needed here.
// v592: the durable half of the bell. Everything above is in-memory and can
// only show what happens while this tab is open. staff_notifications rows
// are written by the server for things due while nobody is looking -- a
// dialer follow-up coming due is the first -- so unread ones load at sign-in
// and new ones arrive over realtime. Opening or clearing one marks it read,
// so it does not come back at the next sign-in.
const STAFF_NOTIF_KIND_ICONS = { dialer_follow_up: '📞', missed_call: '📞', dialer_handoff: '🤝', dialer_appointment: '📅', dialer_task: '✅', client_chat_queue: '💬', leads_import: '📥', call_back_assigned: '↩️' };
// v700: the kinds that need the person to act go to the Priority tab -- the
// same set the dialer's bell uses (staff-shell.js KIND), plus a missed call
// (written by the voice_calls_missed_notify trigger).
const STAFF_NOTIF_PRIORITY_KINDS = new Set(['dialer_follow_up', 'dialer_handoff', 'dialer_appointment', 'dialer_task', 'missed_call', 'client_chat_queue', 'call_back_assigned']);
const shownDurableNotifIds = new Set();
function showDurableStaffNotification(row, silent){
  if(!row || shownDurableNotifIds.has(row.id)) return;
  shownDurableNotifIds.add(row.id);
  // v730: the same event saved by two open tabs shows once; read on either
  // copy counts as read on both.
  const dup = staffNotifDuplicate(row);
  if(dup){
    (dup.dupIds = dup.dupIds || []).push(row.id);
    if(dup.readAt && !row.read_at) markStaffNotificationsRead([row.id]);
    else if(row.read_at && !dup.readAt){
      dup.readAt = new Date(row.read_at).getTime();
      if(dup.durableId) markStaffNotificationsRead([dup.durableId]);
      renderNotifCenter();
    }
    return;
  }
  pushStaffNotification({
    icon: row.icon || STAFF_NOTIF_KIND_ICONS[row.kind] || '🔔',
    title: row.title,
    body: row.body || '',
    durableId: row.id,
    priority: row.priority === true || STAFF_NOTIF_PRIORITY_KINDS.has(row.kind),   // v700; v730: portal rows carry their own
    at: row.created_at ? new Date(row.created_at).getTime() : Date.now(),
    readAt: row.read_at ? new Date(row.read_at).getTime() : null,   // v729: read rows come back too
    silent,
    // v730: a saved 'portal' row has no link to rebuild -- it opens its card.
    onClick: row.kind === 'portal' ? undefined : () => {
      markStaffNotificationsRead([row.id]);
      // v701: a client waiting (or a chat handed to you) opens that
      // conversation in the Client Inbox here -- not the portal again in a
      // new tab.
      if(row.kind === 'client_chat_queue' && row.ref_id && ciCanUseInbox()){ ciOpenFromElsewhere(row.ref_id); return; }
      // v823: a scheduled-job alert opens Ops Health.
      if(row.kind === 'ops_alert' && opsHealthCanView()){ activateTab('ops_health'); return; }
      // v711: a file import's one summary -- open the PrimeHome Buyers queue.
      if(row.kind === 'leads_import'){ activateTab('leads'); activateLeadsSection('queue_review_ispeedtolead'); return; }
      // v724: a call back handed to you by a team leader -- open Call Back.
      if(row.kind === 'call_back_assigned'){ leadsActiveSection = 'call_back'; activateTab('leads'); activateLeadsSection('call_back'); return; }
      // v702: a missed call -- click to call them back.
      if(row.kind === 'missed_call' && row.ref_id){ voiceCallBackFromCallId(row.ref_id); return; }
      // The dialer is its own origin, so a new tab rather than a tab switch.
      if(row.url) window.open(row.url, '_blank');
    },
  });
}
async function loadDurableStaffNotifications(){
  if(!myUserId) return;
  // v729: the last 30 days, read ones included -- what the bell promises.
  const { data, error } = await sb.from('staff_notifications')
    .select('id, kind, title, body, url, ref_id, created_at, read_at, icon, priority')   // v701: ref_id opens the client chat
    .eq('user_id', myUserId).gte('created_at', new Date(Date.now() - STAFF_NC_KEEP_MS).toISOString())
    .order('created_at', { ascending: false }).limit(STAFF_NOTIF_MAX);
  if(error){ console.error('staff_notifications load failed', error); return; }
  // Silent: these are not new, they were waiting. They still count as unread.
  (data || []).forEach(row => showDurableStaffNotification(row, true));
}
function markStaffNotificationsRead(ids){
  if(!ids || !ids.length) return;
  sb.from('staff_notifications').update({ read_at: new Date().toISOString() })
    .in('id', ids).is('read_at', null)
    .then(({ error }) => { if(error) console.error('staff_notifications mark read failed', error); });
}

let staffOpsChannel = null;
async function subscribeStaffOpsRealtime(){
  if(staffOpsChannel) return;
  staffNotifRestore();   // v729: this browser's 30-day history, before anything new is saved
  await fetchStaffNotifRolesConfig();
  loadDurableStaffNotifications();
  staffOpsChannel = sb.channel('staff-ops-notifications')
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'leads' }, (payload) => {
      const lead = payload.new;
      if(lead.ticket_stage === 'staff_review'){
        if(!staffNotifKindAllowed('ticket_new')) return;
        pushStaffNotification({
          priority: true,   // v645: needs someone to act
          icon: '🎫',
          title: 'New ticket to review',
          body: lead.seller_name || lead.address || 'A new ticket needs staff review before it goes to the client.',
          onClick: () => activateTab('leads'),
        });
        return;
      }
      // v217: plain lead submissions (Leads Queue Review) had no
      // notification-center entry at all — only the ticket workflow and
      // dispute replies did. A fresh insert's ticket_stage is only ever
      // null or 'staff_review' (see set_ticket_stage_on_insert() in
      // schema.sql), so "not a ticket" here just means ticket_stage is
      // null. Skips PrimeHome Buyers auto-imported leads (its own
      // dedicated subtab, high postback volume, would otherwise flood
      // this) — same exclusivity excludedFromGeneralQueue() already uses
      // to decide what belongs in the plain Leads Queue Review table.
      // v711: an AGENT's PrimeHome Buyers submission now notifies too, the
      // same way as any other lead (the owner's request) -- it opens the
      // PrimeHome Buyers queue instead. What stays quiet is a FILE IMPORT
      // (imported / last_import_batch set on insert): a 200-row file used to
      // be the reason PrimeHome was excluded at all, and it now gets ONE
      // summary notification from the importer (leads_import_notify).
      const fromFile = !!(lead.imported || lead.last_import_batch);
      // v713: nor a Sales rep's converted opportunity -- it does not go to the
      // agents' QA queue, so a "needs review" alert pointing there is wrong.
      // v717: PrimeHome Buyers leads have their own row in Notifications
      // Setting ('lead_submitted_primehome'), seeded from this one's roles.
      const prime = !lead.ticket_stage && isPrimeHomeBuyersLead(lead);
      if(!lead.ticket_stage && !fromFile && !isSalesConversionLead(lead) && staffNotifKindAllowed(prime ? 'lead_submitted_primehome' : 'lead_submitted')){
        pushStaffNotification({
          priority: true,   // v645: needs someone to act
          icon: '📥',
          title: prime ? 'New PrimeHome Buyers lead submitted' : 'New lead submitted',
          body: lead.seller_investor_name ? `${lead.seller_investor_name} — awaiting review.` : (prime ? 'A new lead needs review in the PrimeHome Buyers queue.' : 'A new lead needs review in Leads Queue Review.'),
          onClick: () => { activateTab('leads'); activateLeadsSection(prime ? 'queue_review_ispeedtolead' : 'queue_review'); },
        });
      }
    })
    .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'leads' }, (payload) => {
      const lead = payload.new;
      // ticket_stage only ever reaches 'recording_pending' via the client
      // clicking Yes, or 'client_rejected' via clicking No (see the
      // ticket_stage check constraint + trigger comments in schema.sql) —
      // both unambiguous signals even without the pre-update row, so no
      // need for replica identity full here.
      // v238: 'client_rejected' had no notification at all before — only
      // the "Yes" path did, so a declined ticket could sit unnoticed
      // indefinitely.
      if(lead.ticket_stage === 'recording_pending'){
        if(!staffNotifKindAllowed('ticket_accepted')) return;
        pushStaffNotification({
          icon: '✅',
          title: 'Client accepted a ticket',
          body: `${lead.seller_name || lead.address || 'A ticket'} needs a recording attached.`,
          onClick: () => activateTab('leads'),
        });
      } else if(lead.ticket_stage === 'client_rejected'){
        if(!staffNotifKindAllowed('ticket_declined')) return;
        pushStaffNotification({
          icon: '❌',
          title: 'Client declined a ticket',
          body: `${lead.seller_name || lead.address || 'A ticket'} was declined by the client.`,
          onClick: () => activateTab('leads'),
        });
      }
    })
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'lead_dispute_messages' }, (payload) => {
      const msg = payload.new;
      if(msg.sender_type !== 'client') return;
      if(!staffNotifKindAllowed('dispute_reply')) return;
      pushStaffNotification({
        priority: true,   // v645: needs someone to act
        icon: '⚠️',
        title: 'Client reply on a dispute',
        body: msg.message || 'New message on a lead dispute/feedback thread.',
        onClick: () => activateTab('client_disputes'),   // v717: moved to Client Communications
      });
    })
    // v238: client-proposed Campaign Guide edits (Leads → Campaign Guide)
    // had no notification-center entry at all — an Owner/Admin only found
    // out one was waiting by happening to open that subtab. Table added to
    // the supabase_realtime publication in the same migration as this fix;
    // RLS (campaign_guide_edit_requests: client select own) already allows
    // is_admin()/role_has_any_tab('leads'), so realtime delivers correctly
    // with no policy change needed.
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'campaign_guide_edit_requests' }, (payload) => {
      const req = payload.new;
      if(!staffNotifKindAllowed('campaign_guide_edit')) return;
      pushStaffNotification({
        priority: true,   // v645: needs someone to act
        icon: '📝',
        title: 'Campaign Guide edit proposed',
        body: req.campaign_display_name
          ? `${req.campaign_display_name}${req.note ? ' — ' + req.note : ''}`
          : 'A client proposed changes to a Campaign Guide.',
        onClick: () => { activateTab('client_submissions'); activateCsubSection('campaign_guide'); },
      });
    })
    // v269: client portal's Dashboard "+ Create Campaign" button (see
    // client-create-campaign Edge Function) writes a real
    // ghl_form_submissions row so it flows through the exact same
    // Client Submissions / Campaign Guide derivation as a genuine GHL
    // form submission -- filtered here by its distinctive form_name so
    // this doesn't fire on every normal GHL webhook submission too.
    // Table added to the supabase_realtime publication in the same
    // migration as this feature; RLS (ghl_form_submissions: admin read)
    // already gates delivery to is_admin()/role_has_any_tab('client_submissions'
    // or 'leads'), same audience that already sees Client Submissions.
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'ghl_form_submissions' }, (payload) => {
      const sub = payload.new;
      if(sub.form_name === 'Client Portal — New Campaign Request'){
        if(!staffNotifKindAllowed('campaign_requested')) return;
        const campaignName = (sub.fields && (sub.fields['Campaign Name (Criteria)'] || sub.fields['Campaign Name'])) || null;
        pushStaffNotification({
          priority: true,   // v645: needs someone to act
          icon: '📣',
          title: 'New campaign requested',
          body: campaignName
            ? `${campaignName} — submitted by ${sub.contact_name || sub.contact_email || 'a client'}.`
            : `A client submitted a new campaign request.`,
          onClick: () => { activateTab('client_submissions'); activateCsubSection('campaign_guide'); },
        });
        return;
      }
      // v356: "Buy a list" requests write this same table (see
      // finalizeListOrder in public-skiptrace/index.ts) once payment
      // completes -- form_name is the exact string that function inserts,
      // must stay in sync with LIST_ORDER_PORTAL_FORM_NAME there.
      if(sub.form_name === 'Client Portal — Buy a List Request'){
        if(!staffNotifKindAllowed('list_order_requested')) return;
        pushStaffNotification({
          priority: true,   // v645: needs someone to act
          icon: '🗂️',
          title: 'New "Buy a list" request',
          body: sub.fields && sub.fields['Number of Records Requested']
            ? `${sub.fields['Number of Records Requested']} records — submitted by ${sub.contact_name || sub.contact_email || 'a client'}.`
            : `A client submitted a "Buy a list" request.`,
          onClick: () => { activateTab('data_science'); activateDataSciSection('data'); },
        });
      }
    })
    // v356: a new one-time charge -- either staff-created (Finance ->
    // Stripe payment -> "One-time client charges") or auto-generated by
    // chargeProrationNow (client-manage-subscription/staff-manage-
    // campaign-subscription) when a caller add/move/convert's proration
    // charge fails. Table added to the supabase_realtime publication in
    // the same migration as this feature; RLS (staff select one-off
    // charges) already gates delivery to is_admin()/role_has_any_tab
    // ('client_submissions' or 'leads').
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'client_one_off_charges' }, (payload) => {
      const charge = payload.new;
      if(!staffNotifKindAllowed('billing_activity')) return;
      pushStaffNotification({
        icon: '💳',
        title: 'Billing activity — new one-time charge',
        body: `$${((charge.amount_cents || 0) / 100).toFixed(2)}${charge.description ? ' — ' + charge.description : ''}`,
        onClick: () => { activateTab('finance'); activateFinanceSection('stripe_payments'); },
      });
    })
    // v356: a skip-trace order actually got paid -- either a credit-funded
    // order (public-skiptrace's create_order_with_credits, inserted
    // status:'paid' directly) or a guest/Stripe-checkout order (inserted
    // pending_payment, flipped to 'paid' by the Stripe webhook). status
    // only ever reaches 'paid' once per order (it moves on to processing/
    // completed/failed afterward and never returns), so checking the new
    // value alone on both INSERT and UPDATE can't double-fire for the same
    // order. Table + staff SELECT policy added in the same migration as
    // this feature -- previously staff only ever read this table through
    // the public-skiptrace Edge Function's own checkStaffAccess, with no
    // RLS policy of its own for direct/realtime reads.
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'public_skiptrace_orders' }, (payload) => {
      const order = payload.new;
      if(order.status !== 'paid') return;
      if(!staffNotifKindAllowed('skiptrace_order_paid')) return;
      pushStaffNotification({
        priority: true,   // v645: needs someone to act
        icon: '🔎',
        title: 'Skip trace order placed',
        body: `${order.record_count} record${order.record_count === 1 ? '' : 's'} — ${order.email || 'a client'}.`,
        onClick: () => { activateTab('data_science'); activateDataSciSection('skiptrace'); },
      });
    })
    .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'public_skiptrace_orders' }, (payload) => {
      const order = payload.new;
      if(order.status !== 'paid') return;
      if(!staffNotifKindAllowed('skiptrace_order_paid')) return;
      pushStaffNotification({
        priority: true,   // v645: needs someone to act
        icon: '🔎',
        title: 'Skip trace order placed',
        body: `${order.record_count} record${order.record_count === 1 ? '' : 's'} — ${order.email || 'a client'}.`,
        onClick: () => { activateTab('data_science'); activateDataSciSection('skiptrace'); },
      });
    })
    // v495: a real appointment landing in ghl_appointments (see
    // ghl-webhook's upsert -- fires for a booking made either through this
    // portal's own book_appointment flow or directly in GHL). onConflict is
    // 'ghl_appointment_id' so a later reschedule/update to the SAME
    // appointment lands as an UPDATE, not another INSERT here -- only a
    // genuinely NEW appointment notifies, same "new, not every change"
    // convention ticket_new/lead_submitted above already use.
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'ghl_appointments' }, (payload) => {
      const appt = payload.new;
      if(!staffNotifKindAllowed('appointment_booked')) return;
      pushStaffNotification({
        icon: '📅',
        title: 'New appointment booked',
        body: appt.contact_name ? `${appt.contact_name} — ${chatGhlFmtWhen(appt.start_time)}` : (appt.title || 'A new appointment was booked.'),
        // v623: NO onClick any more. It used to open Activity ->
        // GoHighLevel -> Appointments, and that group no longer exists; the
        // call would have left the Activity tab showing a GoHighLevel stats
        // row with every table hidden -- a dead end that looks like a bug
        // rather than a removed feature. onClick is optional and guarded at
        // the click site, so the notification still announces the booking,
        // it just no longer navigates.
        //
        // The notification itself is kept rather than deleted because this
        // subscription is the only thing that would tell anyone a GHL
        // appointment came in. It fires on ghl_appointments INSERTs, which
        // stop once GHL is fully decommissioned -- at which point this whole
        // block can go.
      });
    })
    // v239: Human Resources — new candidate submissions only ever reach a
    // reviewer's browser at all because hr_candidates' SELECT policy
    // (can_review_hr_candidates()) is what realtime checks per-subscriber;
    // a non-reviewer's session simply never receives this event, so there's
    // no extra permission check to do here beyond skipping your own
    // submission (Owner/Admin can submit too, and don't need telling about
    // their own row).
    // v494: these 4 HR pushStaffNotification() calls (this one + the 3 in
    // the UPDATE handler below) were the only ones in this whole realtime
    // block with no staffNotifKindAllowed() gate at all -- every OTHER kind
    // already had one, so they never showed up in Notification Settings for
    // an admin to see or narrow. Given real kinds/rows here, same as
    // client_sms_reply got in v493.
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'hr_candidates' }, (payload) => {
      const cand = payload.new;
      if(cand.submitted_by === myUserId) return;
      if(!staffNotifKindAllowed('hr_candidate_submitted')) return;
      pushStaffNotification({
        priority: true,   // v645: needs someone to act
        icon: '🧑‍💼',
        title: 'New candidate submitted for review',
        body: cand.full_name ? `${cand.full_name} is awaiting review.` : 'A new candidate submission is awaiting review.',
        onClick: () => { activateTab('hr'); activateHrSection('review'); },
      });
    })
    // Status moves pending -> approved/rejected via the review action below
    // (setHrCandidateStatus), or approved -> terminated/found_other_offer
    // later on if the staff account it created gets deleted (v371, see
    // manage-user's delete_user action) — unambiguous from payload.new
    // alone, same reasoning as the leads ticket_stage handler above. Only
    // the submitter needs telling; a reviewer whose own action just caused
    // this update doesn't need an echo of it.
    .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'hr_candidates' }, (payload) => {
      const cand = payload.new;
      if(cand.submitted_by !== myUserId) return;
      if(cand.status === 'approved'){
        if(!staffNotifKindAllowed('hr_candidate_approved')) return;
        pushStaffNotification({
          icon: '✅',
          title: 'Candidate submission approved',
          body: `${cand.full_name || 'Your candidate'} was approved.`,
          onClick: () => { activateTab('hr'); activateHrSection('submission'); },
        });
      } else if(cand.status === 'rejected'){
        if(!staffNotifKindAllowed('hr_candidate_rejected')) return;
        pushStaffNotification({
          icon: '❌',
          title: 'Candidate submission rejected',
          body: cand.rejection_reason ? `${cand.full_name || 'Your candidate'} was rejected — ${cand.rejection_reason}` : `${cand.full_name || 'Your candidate'} was rejected.`,
          onClick: () => { activateTab('hr'); activateHrSection('submission'); },
        });
      } else if(cand.status === 'terminated' || cand.status === 'found_other_offer'){
        // v371: set when the staff account this candidate's approval
        // created is later deleted via User Management -- see
        // manage-user's delete_user action.
        if(!staffNotifKindAllowed('hr_candidate_closed')) return;
        const statusLabel = cand.status === 'found_other_offer' ? 'found another offer' : 'was terminated';
        pushStaffNotification({
          icon: '🧑‍💼',
          title: 'Candidate account closed',
          body: cand.termination_reason ? `${cand.full_name || 'Your candidate'} ${statusLabel} — ${cand.termination_reason}` : `${cand.full_name || 'Your candidate'} ${statusLabel}.`,
          onClick: () => { activateTab('hr'); activateHrSection('submission'); },
        });
      }
    })
    // v (user request, 2026-09-05): see this kind's own comment in
    // STAFF_NOTIF_KINDS above for why client_accounts' existing RLS is
    // left as-is rather than broadened for this.
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'client_accounts' }, (payload) => {
      const client = payload.new;
      if(!staffNotifKindAllowed('new_client')) return;
      pushStaffNotification({
        icon: '🆕',
        title: 'New client account created',
        body: client.company_name ? `${client.full_name} — ${client.company_name}` : (client.full_name || client.email || 'A new client account was created.'),
        onClick: () => { activateTab('usermanagement'); activateUmSection('clients'); },
      });
    })
    // v592: durable notifications addressed to this user (see
    // showDurableStaffNotification above).
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'staff_notifications', filter: `user_id=eq.${myUserId}` }, (payload) => {
      showDurableStaffNotification(payload.new, false);
    })
    .subscribe();
}

// ---------- v127: Web Push (chat + calls) ----------
// Reaches a staff member even when their dashboard tab (or browser) isn't
// running — the realtime-driven in-app notification center above only
// works while a tab is open and connected. See sw.js and
// supabase/functions/send-push-notification/ for the other two-thirds of
// this (the service worker that shows the OS notification, and the Edge
// Function that actually delivers it via the Web Push protocol).
//
// REQUIRED before this does anything: replace the placeholder below with
// your own VAPID public key (generate a pair with
// `npx web-push generate-vapid-keys`, set the private half as a
// send-push-notification secret, put the public half here — see that
// function's header comment for the full checklist). Left blank/placeholder,
// pushToggleBtn quietly no-ops rather than throwing, so a fresh checkout
// doesn't break — it just won't offer push until configured.
const VAPID_PUBLIC_KEY = 'BIR9anFzwzF5xt9h4L7_A2JJq0DDymhYk4HMAjrkEtpTWb8qy0roGCBQHaczOvPMwxqTSoNBc9VvutsW9L5rfFk';

function urlBase64ToUint8Array(base64String){
  const padding = '='.repeat((4 - base64String.length % 4) % 4);
  const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
  const rawData = atob(base64);
  const outputArray = new Uint8Array(rawData.length);
  for(let i = 0; i < rawData.length; i++) outputArray[i] = rawData.charCodeAt(i);
  return outputArray;
}

function pushSupported(){
  return 'serviceWorker' in navigator && 'PushManager' in window && VAPID_PUBLIC_KEY && VAPID_PUBLIC_KEY.indexOf('REPLACE_WITH') !== 0;
}

async function updatePushToggleBtn(){
  const btn = $('pushToggleBtn');
  if(!btn) return;
  if(!pushSupported()){
    btn.style.display = 'none';
    return;
  }
  let subscribed = false;
  try{
    const reg = await navigator.serviceWorker.getRegistration();
    const sub = reg ? await reg.pushManager.getSubscription() : null;
    subscribed = !!sub;
  }catch(e){ /* not registered yet — treated as not subscribed */ }
  btn.textContent = subscribed ? '🔔' : '🔕';
  btn.title = subscribed
    ? 'Push notifications on — click to turn off'
    : 'Enable push notifications (works even when this tab is closed)';
}

async function pushSubscribeIfNeeded(){
  if(!pushSupported()) return;
  try{
    const permission = await Notification.requestPermission();
    if(permission !== 'granted') return;

    // sw.js lives alongside dashboard.html — registering it from here
    // (rather than site root) means its default scope only covers this
    // directory. That's fine as long as dashboard.html is the only page
    // that needs push; widen the scope (and where sw.js is hosted) if
    // that changes later — see sw.js's own header comment.
    const reg = await navigator.serviceWorker.register('sw.js');
    await navigator.serviceWorker.ready;

    let sub = await reg.pushManager.getSubscription();
    if(!sub){
      sub = await reg.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY),
      });
    }

    const json = sub.toJSON();
    await sb.from('push_subscriptions').upsert({
      user_id: myUserId,
      endpoint: json.endpoint,
      p256dh: json.keys.p256dh,
      auth: json.keys.auth,
      user_agent: navigator.userAgent,
      last_seen_at: new Date().toISOString(),
    }, { onConflict: 'endpoint' });
  }catch(e){
    console.error('Push subscribe failed', e);
  }finally{
    updatePushToggleBtn();
  }
}

async function pushUnsubscribe(){
  try{
    const reg = await navigator.serviceWorker.getRegistration();
    const sub = reg ? await reg.pushManager.getSubscription() : null;
    if(sub){
      await sb.from('push_subscriptions').delete().eq('endpoint', sub.endpoint);
      await sub.unsubscribe();
    }
  }catch(e){
    console.error('Push unsubscribe failed', e);
  }finally{
    updatePushToggleBtn();
  }
}

function initPushToggle(){
  const btn = $('pushToggleBtn');
  if(!btn || btn.dataset.wired) return;
  btn.dataset.wired = '1';
  btn.addEventListener('click', async () => {
    const reg = await navigator.serviceWorker.getRegistration().catch(() => null);
    const sub = reg ? await reg.pushManager.getSubscription().catch(() => null) : null;
    // v700: remember a deliberate "off", so the automatic switch-on below
    // never overrides it.
    if(sub){ try{ localStorage.setItem('pt.pushOff', '1'); }catch(e){} await pushUnsubscribe(); callNotifyGateCheck(); }
    else { try{ localStorage.removeItem('pt.pushOff'); }catch(e){} await pushSubscribeIfNeeded(); }
  });
  updatePushToggleBtn();
  // v700: PUSH WAS OPT-IN, AND ALMOST NOBODY OPTED IN. Only 3 of 13 staff had
  // ever clicked the bell button, so a call to anyone else rang only if their
  // portal tab happened to be open. Now: a browser that already allows
  // notifications is (re)registered silently at sign-in; one that has not
  // been asked is asked ONCE, at the next click (browsers only allow the
  // question after a click). "Block" is respected, and so is turning it off.
  if(!pushSupported() || !('Notification' in window)) return;
  // v811: while "Log in as" is active this browser belongs to the person
  // testing, not the account shown -- registering it would send that
  // account's calls to the tester's machine.
  if(staffImpersonating) return;
  let off = false, asked = false;
  try{ off = localStorage.getItem('pt.pushOff') === '1'; asked = localStorage.getItem('pt.pushAsked') === '1'; }catch(e){}
  if(off) return;
  if(Notification.permission === 'granted'){ pushSubscribeIfNeeded(); return; }
  if(Notification.permission !== 'default' || asked) return;
  const ask = () => {
    ['pointerup', 'keydown'].forEach(ev => document.removeEventListener(ev, ask, true));
    try{ localStorage.setItem('pt.pushAsked', '1'); }catch(e){}
    pushSubscribeIfNeeded();
  };
  ['pointerup', 'keydown'].forEach(ev => document.addEventListener(ev, ask, true));
}

// v811 (owner decision W4, 2026-09-21): anyone whose role TAKES CALLS must
// have call notifications switched on before they can use the portal.
//
// Why a hard gate and not another prompt: v700 made push re-register itself
// and ask once, and two weeks later four active staff still had no push
// subscription at all -- including two of the three agents. For them a call
// rang only while a portal tab happened to be open, which is exactly how the
// v700/v709 missed calls happened. A question that can be dismissed for ever
// gets dismissed for ever.
//
// Only agents and sales, by the owner's rule: for a recruiter a call
// notification is noise. The list is a Set so adding a role is one word.
//
// What it will NOT do:
//   * trap anyone -- Sign out is always on the card;
//   * run while "Log in as" is active -- otherwise the OWNER's browser would
//     be registered as that agent's call device, and the agent's calls would
//     ring on the owner's machine (initPushToggle got the same guard);
//   * sit above a ringing call -- it is z-index 9980, under the call banner
//     (10000), so a call that arrives while it is up can still be answered;
//   * lock out a browser that CANNOT do push (iPhone Safari, some embedded
//     browsers). There is nothing the person could click to comply, so that
//     one case says so and lets them continue.
const CALL_NOTIFY_REQUIRED_ROLES = new Set(['agent', 'sales']);
let callNotifyGateBusy = false;
let callNotifyPermWatch = false;
let callNotifySkippedUnsupported = false;

// "Allowed" is not enough: the device also has to be registered, and the
// registration has to have reached push_subscriptions, or a call still has
// nowhere to go. That second half is what the v700 path could silently miss.
async function callNotifyHasSubscription(){
  try{
    const reg = await navigator.serviceWorker.getRegistration();
    const sub = reg ? await reg.pushManager.getSubscription() : null;
    if(!sub) return false;
    const { data, error } = await sb.from('push_subscriptions')
      .select('endpoint').eq('user_id', myUserId).eq('endpoint', sub.endpoint).maybeSingle();
    return !error && !!data;
  }catch(e){ return false; }
}

async function callNotifyGateCheck(){
  if(callNotifyGateBusy) return;
  if(staffImpersonating || !myUserId || !CALL_NOTIFY_REQUIRED_ROLES.has(myRole)){
    callNotifyGateHide();
    return;
  }
  callNotifyGateBusy = true;
  try{
    if(!callNotifyPermWatch && navigator.permissions && navigator.permissions.query){
      callNotifyPermWatch = true;
      // Unblocking from the padlock menu fires this in Chrome and Edge, so
      // the card clears without anyone having to find a button.
      navigator.permissions.query({ name: 'notifications' })
        .then(s => { s.onchange = () => callNotifyGateCheck(); })
        .catch(() => {});
    }
    const supported = pushSupported() && ('Notification' in window);
    if(!supported){
      if(callNotifySkippedUnsupported) callNotifyGateHide();
      else callNotifyGateShow('unsupported');
      return;
    }
    if(Notification.permission === 'granted'){
      // The rule outranks a personal "off" from the bell button for these roles.
      try{ localStorage.removeItem('pt.pushOff'); }catch(e){}
      if(!(await callNotifyHasSubscription())) await pushSubscribeIfNeeded();   // already granted: no prompt
      if(await callNotifyHasSubscription()){ callNotifyGateHide(); return; }
      callNotifyGateShow('failed');
      return;
    }
    callNotifyGateShow(Notification.permission === 'denied' ? 'denied' : 'default');
  }finally{
    callNotifyGateBusy = false;
  }
}

function callNotifyGateHide(){
  const el = $('callNotifyGate');
  if(el) el.remove();
}

function callNotifyGateShow(state){
  let el = $('callNotifyGate');
  if(!el){
    el = document.createElement('div');
    el.id = 'callNotifyGate';
    el.setAttribute('role', 'dialog');
    el.setAttribute('aria-modal', 'true');
    el.setAttribute('aria-labelledby', 'callNotifyGateTitle');
    el.style.cssText = 'position:fixed; inset:0; z-index:9980; display:flex; align-items:center; justify-content:center;'
      + ' padding:20px; background:rgba(10,12,16,.72); backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px);';
    document.body.appendChild(el);
  }
  const p = 'margin:0 0 12px; font-size:14px; line-height:1.55; color:var(--text-2);';
  const primary = 'width:100%; margin-top:6px;';
  const copy = {
    default:
      `<p style="${p}">Your role takes calls. Without notifications, a call only rings while this tab is open and in front of you &mdash; and it is missed otherwise.</p>`
      + `<p style="${p}">Click below, then choose <strong>Allow</strong> when your browser asks.</p>`
      + `<button type="button" class="btn-primary" id="callNotifyAllowBtn" style="${primary}">Allow notifications</button>`,
    denied:
      `<p style="${p}">Your browser is <strong>blocking</strong> notifications for this site, so calls cannot reach you when the tab is closed.</p>`
      + `<ol style="${p} padding-left:20px;">`
      + `<li>Click the <strong>padlock</strong> (or the settings icon) at the left of the address bar.</li>`
      + `<li>Set <strong>Notifications</strong> to <strong>Allow</strong>.</li>`
      + `<li>Click the button below.</li></ol>`
      + `<button type="button" class="btn-primary" id="callNotifyReloadBtn" style="${primary}">I&rsquo;ve allowed it &mdash; reload</button>`,
    failed:
      `<p style="${p}">Notifications are allowed, but this device did not finish registering for calls.</p>`
      + `<p style="${p}">Try again. If it keeps failing, tell your admin which browser you are using.</p>`
      + `<button type="button" class="btn-primary" id="callNotifyRetryBtn" style="${primary}">Try again</button>`,
    unsupported:
      `<p style="${p}">This browser cannot receive call notifications &mdash; common on an iPhone or inside another app.</p>`
      + `<p style="${p}">To take calls, use <strong>Chrome</strong> or <strong>Edge</strong> on a computer.</p>`
      + `<button type="button" class="btn-primary" id="callNotifyContinueBtn" style="${primary}">Continue without call notifications</button>`,
  }[state] || '';
  el.innerHTML =
    `<div style="max-width:440px; width:100%; background:var(--card); border:1px solid var(--border); border-radius:16px;`
    + ` padding:26px 24px 18px; color:var(--text); font-family:var(--sans); box-shadow:0 20px 60px rgba(0,0,0,.35);">`
    + `<div aria-hidden="true" style="font-size:30px; line-height:1; margin-bottom:12px;">&#128276;</div>`
    + `<h2 id="callNotifyGateTitle" style="margin:0 0 12px; font-size:19px; font-weight:700; color:var(--text);">Turn on call notifications</h2>`
    + copy
    + `<div style="margin-top:18px; padding-top:12px; border-top:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; gap:10px;">`
    + `<span style="font-size:12px; color:var(--text-dim);">Required for everyone who takes calls.</span>`
    + `<button type="button" id="callNotifySignOutBtn" style="background:none; border:none; color:var(--text-2); font-size:12.5px; text-decoration:underline; cursor:pointer; padding:0; width:auto; margin:0;">Sign out</button>`
    + `</div></div>`;

  const allow = $('callNotifyAllowBtn');
  // requestPermission has to run inside the click, so it is the first thing
  // pushSubscribeIfNeeded awaits -- nothing async may come before it here.
  if(allow) allow.addEventListener('click', async () => { await pushSubscribeIfNeeded(); callNotifyGateCheck(); });
  const reload = $('callNotifyReloadBtn');
  if(reload) reload.addEventListener('click', () => location.reload());
  const retry = $('callNotifyRetryBtn');
  if(retry) retry.addEventListener('click', () => callNotifyGateCheck());
  const cont = $('callNotifyContinueBtn');
  if(cont) cont.addEventListener('click', () => { callNotifySkippedUnsupported = true; callNotifyGateHide(); });
  $('callNotifySignOutBtn').addEventListener('click', () => performSignOut());

  const first = allow || reload || retry || cont;
  if(first) setTimeout(() => { try{ first.focus(); }catch(e){} }, 0);
}

// Fire-and-forget: sends a push to each of the given user ids, but ONLY
// for someone whose live presence isn't 'active' right now — if they're
// actively looking at the dashboard, the existing realtime + in-page
// sound/desktop-notification path (chatMaybeNotify, chatPlayNotificationSound)
// already reaches them; a push on top of that would just be a duplicate
// ding. This is deliberately best-effort: a failed/slow push call never
// blocks sending the chat message or placing the call it's attached to.
// v700: opts.always skips that gate, for CALLS. Someone working in the dialer
// shows "active" (the dialer sends the same heartbeat) while no staff portal
// tab is listening for the call -- so the gate meant the person most likely
// to be at their desk was never told they were being called.
function notifyPushRecipients(userIds, payload, opts){
  const always = !!(opts && opts.always);
  const targets = (userIds || []).filter(id => id && id !== myUserId && (always || chatContactStatus(id) !== 'active'));
  targets.forEach(id => {
    sb.functions.invoke('send-push-notification', { body: { user_id: id, ...payload } })
      .then(({ error }) => { if(error) console.error('send-push-notification failed for', id, error); })
      .catch(err => console.error('send-push-notification call failed for', id, err));
  });
}

// Adds one message to local state (used both by the initial bulk load and
// by each realtime insert) and recomputes that conversation's unread
// count. `live` distinguishes a just-arrived realtime message (which may
// need to bump the badge / re-render whatever's currently on screen) from
// ones being loaded in bulk on open (where the caller re-renders once,
// after all of them are in).
function chatAddMessageToState(m, live){
  const key = chatConvKeyForMessage(m);
  if(!chatConversations[key]) chatConversations[key] = { key, messages: [], unread: 0 };
  if(!chatConversations[key].messages.some(x => x.id === m.id)){
    chatConversations[key].messages.push(m);
  }
  const lastReadMs = chatLastRead[key] ? new Date(chatLastRead[key]).getTime() : 0;
  chatConversations[key].unread = chatConversations[key].messages
    .filter(x => x.sender_id !== myUserId && new Date(x.created_at).getTime() > lastReadMs).length;
  if(live){
    chatMaybeNotify(key, m);
    updateChatUnreadBadge();
    if(chatActiveConv === key && $('chatPanel').style.display !== 'none'){
      chatMarkRead(key); // already looking at this conversation — new message counts as read immediately
      renderChatThread();
    } else if(!chatActiveConv){
      renderChatConvList($('chatSearchInput').value);
    }
  }
}

// v467: shared by every "pending count" badge on the chat panel -- the
// floating FAB badge, and the chat-bottom-tab-badge spans (see
// chatUpdateBottomTabBadges()). Rebuilt after being dropped alongside the
// rest of the SMS tab from an intermediate version.
function chatSetBadge(id, count){
  const el = $(id);
  if(!el) return;
  el.textContent = count > 99 ? '99+' : String(count);
  el.style.display = count > 0 ? 'flex' : 'none';
}

function updateChatUnreadBadge(){
  // v701: client conversations live in the Client Inbox; their unread count
  // is that page's badge, not the floating chat's (unless the inbox is not
  // available to this person, when they still show here as before).
  const ciOn = typeof ciCanUseInbox === 'function' && ciCanUseInbox();
  const total = Object.entries(chatConversations).reduce((t, [k, c]) => t + ((ciOn && k.startsWith('client:')) ? 0 : c.unread), 0);
  if(typeof ciSetNavBadge === 'function') ciSetNavBadge(ciUnreadTotal());
  const badge = $('chatUnreadBadge');
  badge.textContent = total > 99 ? '99+' : String(total);
  badge.style.display = total > 0 ? 'flex' : 'none';
  const fab = $('chatFabBtn');
  if(fab) fab.classList.toggle('has-unread', total > 0);
  chatSetBadge('chatBottomBadgeChats', total);
  // v122: Desouky's own floating button gets its own badge, scoped to
  // just its conversation's unread count (not the total across everyone).
  if(AI_ASSISTANT_BOT_ID){
    const desoukyUnread = (chatConversations[AI_ASSISTANT_BOT_ID] && chatConversations[AI_ASSISTANT_BOT_ID].unread) || 0;
    const desoukyBadge = $('desoukyMascotUnreadBadge');
    if(desoukyBadge){
      desoukyBadge.textContent = desoukyUnread > 99 ? '99+' : String(desoukyUnread);
      desoukyBadge.style.display = desoukyUnread > 0 ? 'flex' : 'none';
    }
  }
}

function renderChatConvList(filterText){
  const search = (filterText || '').trim().toLowerCase();
  const teamConv = chatConversations['team'];
  const lastOf = c => (c && c.messages.length) ? c.messages[c.messages.length - 1] : null;

  const items = [{
    key: 'team', name: 'Communication', isTeam: true, isGroup: false,
    last: lastOf(teamConv), unread: teamConv ? teamConv.unread : 0,
  }];
  chatDirectory
    .filter(p => !search || (p.full_name || p.email || '').toLowerCase().includes(search))
    .forEach(p => {
      const conv = chatConversations[p.id];
      items.push({ key: p.id, name: p.full_name || p.email, isTeam: false, isGroup: false, last: lastOf(conv), unread: conv ? conv.unread : 0, statusBadge: chatStatusBadgeHtml(p.id) });   // v702: status emoji
    });
  Object.values(chatGroups)
    .filter(g => !search || g.name.toLowerCase().includes(search))
    .forEach(g => {
      const conv = chatConversations['group:' + g.id];
      items.push({ key: 'group:' + g.id, name: g.name, isTeam: false, isGroup: true, memberCount: g.members.length, last: lastOf(conv), unread: conv ? conv.unread : 0 });
    });
  // v701: client conversations moved to the Client Inbox page -- one row
  // below links there instead (ciChatLinkRowHtml).
  if(!ciCanUseInbox()) clientChatThreadsDirectory
    .filter(t => !search || chatClientThreadName(t.client_id).toLowerCase().includes(search))
    .forEach(t => {
      const key = 'client:' + t.client_id;
      const conv = chatConversations[key];
      items.push({ key, name: chatClientThreadName(t.client_id), isTeam: false, isGroup: false, isClient: true, isUnclaimed: t.unclaimed, last: lastOf(conv), unread: conv ? conv.unread : 0 });
    });

  const [team, ...rest] = items;
  rest.sort((a, b) => {
    if(a.last && b.last) return new Date(b.last.created_at) - new Date(a.last.created_at);
    if(a.last) return -1;
    if(b.last) return 1;
    return a.name.localeCompare(b.name);
  });
  const sorted = [team, ...rest];

  const convHtml = ciChatLinkRowHtml() + sorted.map(it => {
    let previewText;
    const typingNow = chatIsPeerTyping(it.key); // v316
    if(typingNow){
      previewText = 'typing…';
    } else if(it.isClient && it.last){
      const senderPrefix = it.last.sender === 'staff' ? 'You: ' : (it.last.sender === 'ai' ? 'AI: ' : '');
      previewText = senderPrefix + (it.last.body || '');
    } else if(it.last){
      const senderPrefix = it.last.sender_id === myUserId ? 'You: ' : (it.isGroup ? `${chatContactName(it.last.sender_id)}: ` : '');
      const body = it.last.body || (it.last.attachment_mime && it.last.attachment_mime.startsWith('audio/') ? '\u{1F3A4} Voice message' : (it.last.attachment_name ? `\u{1F4CE} ${it.last.attachment_name}` : ''));
      previewText = senderPrefix + body;
    } else {
      previewText = it.isTeam ? 'Only Admins/Owner can post here' : (it.isGroup ? `${it.memberCount} member${it.memberCount === 1 ? '' : 's'}` : (it.isUnclaimed ? 'Waiting to be accepted' : 'No messages yet'));
    }
    const avatarHtml = it.isTeam
      ? `<div class="chat-conv-avatar" style="width:32px; height:32px;">\u{1F4E2}</div>`
      : it.isGroup
        ? `<div class="chat-conv-avatar" style="width:32px; height:32px;">\u{1F465}</div>`
        : it.isClient
          ? `<div class="chat-conv-avatar" style="width:32px; height:32px;">\u{1F3E2}</div>`
          : (it.key === AI_ASSISTANT_BOT_ID ? chatBotAvatarIconHtml(32) : chatAvatarHtml(it.key, it.name, 32, true));
    return `
      <div class="chat-conv-item" data-key="${it.key}">
        ${avatarHtml}
        <div class="chat-conv-info">
          <div class="chat-conv-name">${escapeHtml(it.name)}${it.isUnclaimed ? ' <span style="font-size:10px; font-weight:600; color:var(--away); text-transform:uppercase; letter-spacing:0.5px;">\u2022 Waiting</span>' : ''}${it.statusBadge || ''}</div>
          <div class="chat-conv-preview${typingNow ? ' chat-conv-preview-typing' : ''}">${escapeHtml(previewText)}</div>
        </div>
        ${it.unread > 0 ? `<div class="chat-conv-badge">${it.unread > 99 ? '99+' : it.unread}</div>` : ''}
      </div>
    `;
  }).join('');
  // v676: the list re-renders on every realtime event and presence tick;
  // rebuilding identical DOM (and re-binding every row) is what made the
  // panel stutter while typing. Skip the write when nothing changed.
  const convListEl = $('chatConvList');
  if(convListEl.__lastHtml === convHtml) return;
  convListEl.__lastHtml = convHtml;
  convListEl.innerHTML = convHtml;
  convListEl.querySelectorAll('.chat-conv-item').forEach(el => {
    if(el.dataset.ciLink){ el.addEventListener('click', () => ciOpenFromElsewhere(null)); return; }   // v701
    el.addEventListener('click', () => openChatThread(el.dataset.key));
  });
}

// v467: bottom SMS tab on the chat panel's conversation list -- rebuilt
// after being dropped from an intermediate version. Chats tab (above) is
// unchanged -- internal team/DM/group chat + client portal live chat,
// this app's own thing, unrelated to GHL.
//   - SMS tab lists your existing clients (client_accounts, same source
//     chatRenderNewClientChatPicker already uses for "New client chat")
//     rather than raw GHL conversations, so it's "who can I text" not
//     "who has GHL messaged recently". Opening one shows their real GHL
//     SMS thread (lookup_contact_activity, same action + classifier the
//     Integrations -> GoHighLevel "contact lookup" card uses) and lets
//     you send a genuinely freeform reply via send-client-sms's existing
//     'manual' kind -- polls every 8s while open so a reply shows up
//     without a manual refresh.
let chatBottomTab = 'chats';
let chatSmsDirectory = []; // [{id, full_name, company_name, phone}]
let chatSmsThreadClient = null;
let chatSmsThreadPollTimer = null;

// Location resolution mirrors loadGhlClientSmsLocationSetting(): the
// app_settings 'client_sms_location_id' row if set, else whichever GHL
// location connected first -- same fallback client-facing SMS already
// uses when only one location is connected.
async function chatResolveGhlLocationId(){
  const { data } = await sb.from('app_settings').select('value').eq('key', 'client_sms_location_id').maybeSingle();
  if(data?.value) return data.value;
  const result = await callGhlApi({ action: 'list_connections' });
  const rows = result.ok ? (result.connections || []) : [];
  return rows[0]?.location_id || null;
}

function chatGhlFmtWhen(iso){
  if(!iso) return '';
  const d = new Date(iso);
  if(isNaN(d.getTime())) return '';
  const sameDay = d.toDateString() === new Date().toDateString();
  return sameDay ? d.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : d.toLocaleDateString([], {month:'short', day:'numeric'});
}

// ---- SMS tab: client picker ----
async function chatRenderSmsList(){
  const box = $('chatSmsList');
  // No "Loading…" flash on a background refresh (chatPollSmsForNotifications
  // calls this every poll to keep the pending dots current) -- only show
  // it the very first time, before any rows exist yet.
  const isFirstRender = !box.querySelector('.chat-ghl-list-item');
  if(isFirstRender) box.innerHTML = '<div class="chat-ghl-list-loading">Loading…</div>';
  const { data, error } = await sb.from('client_accounts')
    .select('id, full_name, company_name, phone')
    .eq('is_active', true)
    .order('full_name');
  if(error){ if(isFirstRender) box.innerHTML = `<div class="chat-ghl-list-empty">${escapeHtml(error.message)}</div>`; return; }
  chatSmsDirectory = data || [];
  if(!chatSmsDirectory.length){ box.innerHTML = '<div class="chat-ghl-list-empty">No active clients yet.</div>'; return; }
  box.innerHTML = chatSmsDirectory.map(c => `
    <div class="chat-ghl-list-item" data-client-id="${c.id}">
      ${chatAvatarHtml(c.id, c.full_name || c.company_name || 'Client', 32, false)}
      <div class="chat-conv-info">
        <div class="chat-conv-name">${escapeHtml(c.full_name || 'Client')}</div>
        <div class="chat-conv-preview">${escapeHtml(c.company_name || c.phone || 'No phone on file')}</div>
      </div>
      ${chatSmsPendingByClient[c.id] ? '<div class="chat-ghl-list-item-badge" title="New text"></div>' : ''}
    </div>
  `).join('');
  box.querySelectorAll('.chat-ghl-list-item').forEach(el => {
    el.addEventListener('click', () => {
      const c = chatSmsDirectory.find(x => x.id === el.dataset.clientId);
      if(c) chatOpenSmsThread(c);
    });
  });
}

// ---- SMS tab: one client's real SMS thread ----
async function chatOpenSmsThread(client){
  clearInterval(chatSmsThreadPollTimer);
  chatSmsThreadClient = client;
  // Opening this client's thread IS "reading" it — clear the pending
  // dot/badge immediately (optimistic, before chatMarkRead's async
  // chat_reads upsert even resolves) and persist the read marker so it
  // stays cleared across reloads/devices, same key chatPollSmsForNotifications
  // reads back to decide pending state.
  chatSmsPendingByClient[client.id] = false;
  chatUpdateBottomTabBadges();
  chatMarkRead('sms:' + client.id);
  $('chatListView').style.display = 'none';
  $('chatSmsThreadView').style.display = 'flex';
  $('chatSmsThreadTitle').textContent = client.full_name || 'Client';
  const canText = !!myPermissions.canTextClients;
  $('chatSmsThreadNoPermMsg').style.display = canText ? 'none' : 'block';
  $('chatSmsThreadInput').value = '';
  $('chatSmsThreadBookBtn').style.display = (canText && client.phone) ? 'inline-flex' : 'none';
  if(!client.phone){
    $('chatSmsThreadBody').innerHTML = '<div class="chat-ghl-list-empty">This client has no phone number on file — add one under User Management → Clients.</div>';
    $('chatSmsThreadCompose').style.display = 'none';
    return;
  }
  $('chatSmsThreadCompose').style.display = canText ? 'flex' : 'none';
  delete $('chatSmsThreadBody').dataset.loaded;
  await chatRefreshSmsThread();
  chatSmsThreadPollTimer = setInterval(() => { if(!document.hidden) chatRefreshSmsThread(); }, 8000);
}
async function chatRefreshSmsThread(){
  if(!chatSmsThreadClient || !chatSmsThreadClient.phone) return;
  const body = $('chatSmsThreadBody');
  const firstLoad = !body.dataset.loaded;
  if(firstLoad) body.innerHTML = '<div class="chat-ghl-list-loading">Loading…</div>';
  const locationId = await chatResolveGhlLocationId();
  if(!locationId){ if(firstLoad) body.innerHTML = '<div class="chat-ghl-list-empty">No GoHighLevel location connected.</div>'; return; }
  const res = await callGhlApi({ action: 'lookup_contact_activity', locationId, phone: chatSmsThreadClient.phone, clientId: chatSmsThreadClient.id });
  if(!res.ok){ if(firstLoad) body.innerHTML = `<div class="chat-ghl-list-empty">${escapeHtml(res.error || 'Lookup failed.')}</div>`; return; }
  // lookup_contact_activity can succeed (res.ok true) while still carrying
  // a conversationError -- the messages sub-fetch 401ing because the
  // connected location's token lacks conversations/message.readonly is the
  // exact case the Integrations "GoHighLevel contact lookup" card's own
  // description already warns about ("disconnect and reconnect that
  // location"). Surfaced here instead of silently reading as "no messages
  // yet", indistinguishable from a client who's genuinely never texted in.
  if(res.conversationError){ if(firstLoad) body.innerHTML = `<div class="chat-ghl-list-empty">${escapeHtml(res.conversationError)}</div>`; return; }
  const filtered = (res.messages || [])
    .filter(m => ghlLookupClassifyMessage(m) === 'sms')
    .sort((a, b) => new Date(a.dateAdded || a.dateUpdated) - new Date(b.dateAdded || b.dateUpdated));
  body.dataset.loaded = '1';
  body.innerHTML = filtered.length
    ? filtered.map(m => {
        const mine = (m.direction || '').toLowerCase().includes('outbound');
        return `
          <div class="chat-msg-row ${mine ? 'mine' : 'theirs'}">
            <div class="chat-msg-meta">${ghlLookupFmtWhen(m.dateAdded || m.dateUpdated)}</div>
            <div class="chat-msg-bubble">${escapeHtml(ghlLookupMessageBody(m))}</div>
          </div>
        `;
      }).join('')
    : '<div class="chat-ghl-list-empty">No text messages yet — send one below.</div>';
  body.scrollTop = body.scrollHeight;
}
async function chatSendSmsFromThread(){
  const input = $('chatSmsThreadInput');
  const text = input.value.trim();
  if(!text || !chatSmsThreadClient) return;
  const sendBtn = $('chatSmsThreadSendBtn');
  input.disabled = true; sendBtn.disabled = true;
  const res = await callSendClientSms(chatSmsThreadClient.id, 'manual', text);
  input.disabled = false; sendBtn.disabled = false;
  if(!res.ok){ alert(res.error || 'Failed to send.'); return; }
  input.value = '';
  input.focus();
  await chatRefreshSmsThread();
}
$('chatSmsThreadSendBtn').addEventListener('click', chatSendSmsFromThread);
$('chatSmsThreadInput').addEventListener('keydown', (e) => { if(e.key === 'Enter'){ e.preventDefault(); chatSendSmsFromThread(); } });
$('chatSmsThreadBackBtn').addEventListener('click', () => {
  clearInterval(chatSmsThreadPollTimer);
  chatSmsThreadClient = null;
  $('chatSmsThreadView').style.display = 'none';
  $('chatListView').style.display = 'flex';
});

// ---- Book appointment (v474) -- driven off ghl-api's list_calendars /
// get_calendar_slots / book_appointment actions, all gated behind the same
// canTextClients permission the SMS thread itself already requires (see
// ghl-api's CLIENT_FACING_ACTIONS). Opened from the book icon in the SMS
// thread header, so chatSmsThreadClient is always set while this modal is
// open -- no separate client picker needed here.
let chatBookApptState = { calendarId: null, slotDurationMin: 30, chosenIso: null };
async function chatOpenBookApptModal(){
  if(!chatSmsThreadClient || !chatSmsThreadClient.phone) return;
  chatBookApptState = { calendarId: null, slotDurationMin: 30, chosenIso: null };
  $('chatBookApptForClient').textContent = `For ${chatSmsThreadClient.full_name || 'this client'} — ${chatSmsThreadClient.phone}`;
  $('chatBookApptStep1').style.display = 'block';
  $('chatBookApptStep2').style.display = 'none';
  $('chatBookApptConfirmBtn').style.display = 'none';
  $('chatBookApptModalMsg').style.display = 'none';
  $('chatBookApptSlots').innerHTML = '';
  $('chatBookApptCalendarSelect').innerHTML = '<option value="">Loading calendars…</option>';
  $('chatBookApptModalOverlay').style.display = 'flex';
  const res = await callGhlApi({ action: 'list_calendars' });
  if(!res.ok){
    $('chatBookApptCalendarSelect').innerHTML = '<option value="">—</option>';
    // v477 BUG FIX: a 401 here almost always means the connected GHL
    // location's token predates calendars.* being added to what this app
    // requests (see GHL_SCOPES's own comment) — reconnecting is the fix,
    // not a code change, so say that instead of leaving staff staring at
    // a bare "(401)" with no next step.
    const is401 = /\(401\)/.test(res.error || '');
    $('chatBookApptModalMsg').textContent = is401
      ? `${res.error} — the connected GoHighLevel location needs to be reconnected to grant calendar access. Ask an Owner/Admin to disconnect and reconnect it under User Management → Integrations.`
      : (res.error || 'Failed to load calendars.');
    $('chatBookApptModalMsg').style.display = 'block';
    return;
  }
  const calendars = res.calendars || [];
  if(!calendars.length){
    $('chatBookApptCalendarSelect').innerHTML = '<option value="">No calendars connected</option>';
    return;
  }
  $('chatBookApptCalendarSelect').innerHTML = '<option value="">Select a calendar…</option>' +
    calendars.map(c => `<option value="${c.id}" data-slot-duration="${c.slotDuration || 30}">${escapeHtml(c.name)}</option>`).join('');
}
async function chatLoadBookApptSlots(calendarId, slotDurationMin){
  const box = $('chatBookApptSlots');
  box.innerHTML = '<div class="chat-ghl-list-loading">Loading available times…</div>';
  const start = new Date();
  const end = new Date(Date.now() + 14 * 24 * 60 * 60 * 1000);
  const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
  const res = await callGhlApi({
    action: 'get_calendar_slots', calendarId,
    startDate: start.toISOString(), endDate: end.toISOString(), timezone,
  });
  if(!res.ok){
    box.innerHTML = `<div class="chat-ghl-list-empty">${escapeHtml(res.error || 'Failed to load slots.')}</div>`;
    return;
  }
  const dates = Object.keys(res.slotsByDate || {}).sort();
  if(!dates.length){
    box.innerHTML = '<div class="chat-ghl-list-empty">No open slots in the next 14 days.</div>';
    return;
  }
  box.innerHTML = dates.map(d => {
    const dLabel = new Date(d + 'T00:00:00').toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' });
    const slots = res.slotsByDate[d] || [];
    return `
      <div class="chat-book-slot-date-heading">${escapeHtml(dLabel)}</div>
      <div class="chat-book-slot-row">
        ${slots.map(iso => `<button type="button" class="chat-book-slot-btn" data-iso="${iso}">${escapeHtml(new Date(iso).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }))}</button>`).join('')}
      </div>
    `;
  }).join('');
  box.querySelectorAll('.chat-book-slot-btn').forEach(btn => {
    btn.addEventListener('click', () => chatChooseBookApptSlot(btn.dataset.iso, slotDurationMin));
  });
}
function chatChooseBookApptSlot(iso, slotDurationMin){
  chatBookApptState.chosenIso = iso;
  chatBookApptState.slotDurationMin = slotDurationMin || 30;
  $('chatBookApptStep1').style.display = 'none';
  $('chatBookApptStep2').style.display = 'block';
  $('chatBookApptChosenSlot').textContent = new Date(iso).toLocaleString([], { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
  $('chatBookApptTitleInput').value = '';
  $('chatBookApptConfirmBtn').style.display = 'inline-block';
  $('chatBookApptModalMsg').style.display = 'none';
}
$('chatBookApptCalendarSelect').addEventListener('change', (e) => {
  const opt = e.target.selectedOptions[0];
  const calendarId = e.target.value;
  chatBookApptState.calendarId = calendarId;
  if(!calendarId){ $('chatBookApptSlots').innerHTML = ''; return; }
  chatLoadBookApptSlots(calendarId, Number(opt?.dataset.slotDuration) || 30);
});
$('chatBookApptBackToSlotsBtn').addEventListener('click', () => {
  $('chatBookApptStep2').style.display = 'none';
  $('chatBookApptStep1').style.display = 'block';
  $('chatBookApptConfirmBtn').style.display = 'none';
});
$('chatSmsThreadBookBtn').addEventListener('click', chatOpenBookApptModal);
$('chatBookApptCancelBtn').addEventListener('click', () => { $('chatBookApptModalOverlay').style.display = 'none'; });
$('chatBookApptConfirmBtn').addEventListener('click', async () => {
  if(!chatBookApptState.calendarId || !chatBookApptState.chosenIso || !chatSmsThreadClient) return;
  const btn = $('chatBookApptConfirmBtn');
  btn.disabled = true; btn.textContent = 'Booking…';
  $('chatBookApptModalMsg').style.display = 'none';
  const startTime = chatBookApptState.chosenIso;
  const endTime = new Date(new Date(startTime).getTime() + chatBookApptState.slotDurationMin * 60000).toISOString();
  const title = $('chatBookApptTitleInput').value.trim();
  const res = await callGhlApi({
    action: 'book_appointment',
    calendarId: chatBookApptState.calendarId,
    phone: chatSmsThreadClient.phone,
    clientId: chatSmsThreadClient.id,
    startTime, endTime,
    title: title || undefined,
    timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
  });
  btn.disabled = false; btn.textContent = 'Confirm booking';
  if(!res.ok){
    $('chatBookApptModalMsg').textContent = res.error || 'Failed to book appointment.';
    $('chatBookApptModalMsg').style.display = 'block';
    return;
  }
  $('chatBookApptModalOverlay').style.display = 'none';
  alert('Appointment booked.');
});

// ---- Calls tab: this app's own native WebRTC call log -- rebuilt after
// being dropped alongside SMS from an intermediate version. Nothing to do
// with GHL at all -- the voice_calls table was already logging every
// call; this is just the UI that surfaces it. ----
async function chatRenderCallsList(){
  const box = $('chatCallsList');
  box.innerHTML = '<div class="chat-ghl-list-loading">Loading…</div>';
  const { data: calls, error } = await sb.from('voice_calls')
    .select(`
      id, status, started_at, answered_at, ended_at, caller_id, callee_id, caller_client_id, callee_client_id,
      caller_profile:profiles!voice_calls_caller_id_fkey(full_name),
      callee_profile:profiles!voice_calls_callee_id_fkey(full_name),
      caller_client:client_accounts!voice_calls_caller_client_id_fkey(full_name, company_name),
      callee_client:client_accounts!voice_calls_callee_client_id_fkey(full_name, company_name)
    `)
    .order('started_at', { ascending: false })
    .or(`caller_id.eq.${myUserId},callee_id.eq.${myUserId}`)   // v702: MY calls -- an admin can read everyone's
    .limit(50);
  if(error){ box.innerHTML = `<div class="chat-ghl-list-empty">${escapeHtml(error.message)}</div>`; return; }
  // Pending count for the Calls bottom-tab badge -- calls that happened
  // after staff last opened this tab (chat_reads key 'calls', stamped by
  // the chatBottomTabs click handler below). Computed here regardless of
  // whether the list itself is empty, so the badge is still accurate even
  // on a range with zero calls in it.
  const lastReadIso = chatLastRead['calls'];
  chatCallsPendingCount = (calls || []).filter(c => c.caller_id !== myUserId && (!lastReadIso || new Date(c.started_at) > new Date(lastReadIso))).length;   // v702: calls TO me, not my own
  chatUpdateBottomTabBadges();
  if(!calls || !calls.length){ box.innerHTML = '<div class="chat-ghl-list-empty">No calls yet.</div>'; return; }
  const statusLabel = { ringing: 'No answer', declined: 'Declined', missed: 'Missed', failed: 'Call failed', ended: 'Ended', answered: 'Answered' };
  box.innerHTML = calls.map(c => {
    const isMine = c.caller_id === myUserId;
    const otherName = isMine
      ? (c.callee_profile?.full_name || c.callee_client?.full_name || c.callee_client?.company_name || 'Unknown')
      : (c.caller_profile?.full_name || c.caller_client?.full_name || c.caller_client?.company_name || 'Unknown');
    const durationSec = (c.answered_at && c.ended_at) ? Math.max(0, Math.round((new Date(c.ended_at) - new Date(c.answered_at)) / 1000)) : null;
    const durationLabel = durationSec != null ? `${Math.floor(durationSec / 60)}:${String(durationSec % 60).padStart(2, '0')}` : (statusLabel[c.status] || c.status);
    const isPending = !isMine && (!lastReadIso || new Date(c.started_at) > new Date(lastReadIso));   // v702: calls TO me
    // v702: a call you missed says so, in red, and every row can call back.
    const missedByMe = !isMine && (c.status === 'missed' || c.status === 'ringing');
    const otherStaffId = isMine ? c.callee_id : c.caller_id;
    const otherClientId = isMine ? c.callee_client_id : c.caller_client_id;
    const canCallBack = !!otherStaffId || (!!otherClientId && myPermissions.canTextClients);
    return `
      <div class="chat-ghl-list-item${missedByMe ? ' chat-call-missed' : ''}">
        <div class="chat-conv-avatar" style="width:32px; height:32px;">${isMine ? '&#8599;&#65039;' : (missedByMe ? '&#128245;' : '&#8601;&#65039;')}</div>
        <div class="chat-conv-info">
          <div class="chat-conv-name">${escapeHtml(otherName)}</div>
          <div class="chat-conv-preview">${missedByMe ? '<span class="chat-call-missed-label">Missed call</span>' : `${isMine ? 'Outgoing' : 'Incoming'} &middot; ${escapeHtml(durationLabel)}`}</div>
        </div>
        <div class="mono" style="font-size:10px; color:var(--text-dim); white-space:nowrap;">${chatGhlFmtWhen(c.started_at)}</div>
        ${canCallBack ? `<button type="button" class="chat-call-back-btn" data-staff="${escapeHtml(otherStaffId || '')}" data-client="${escapeHtml(otherClientId || '')}" data-name="${escapeHtml(otherName)}" title="Call ${escapeHtml(otherName)} back">&#128222;</button>` : ''}
        ${isPending ? '<div class="chat-ghl-list-item-badge" title="Not yet seen"></div>' : ''}
      </div>
    `;
  }).join('');
  box.querySelectorAll('.chat-call-back-btn').forEach(b => b.addEventListener('click', (e) => {
    e.stopPropagation();
    chatCallBack(b.dataset.staff || null, b.dataset.client || null, b.dataset.name);
  }));
}

// v702: calling someone back -- from a Calls-tab row, a missed-call
// notification, or the dialer's bell (which opens #callback=<call id>).
function chatCallBack(staffId, clientId, name){
  if(voiceCallState){ alert('You are already on a call.'); return; }
  if(staffId) startVoiceCall(staffId, name || 'Colleague');
  else if(clientId) startVoiceCallToClient(clientId, name || 'Client');
}
async function voiceCallBackFromCallId(callId){
  const { data: c, error } = await sb.from('voice_calls')
    .select('id, caller_id, caller_client_id, caller_profile:profiles!voice_calls_caller_id_fkey(full_name), caller_client:client_accounts!voice_calls_caller_client_id_fkey(full_name, company_name)')
    .eq('id', callId).maybeSingle();
  if(error || !c){ alert('That call could not be found.'); return; }
  const name = (c.caller_profile && c.caller_profile.full_name)
    || (c.caller_client && (c.caller_client.full_name || c.caller_client.company_name)) || 'them';
  if(!c.caller_id && c.caller_client_id && !myPermissions.canTextClients){
    alert(`${name} is a client, and your role cannot call clients from the portal.`);
    return;
  }
  if(!confirm(`Call ${name} back now?`)) return;
  chatCallBack(c.caller_id || null, c.caller_id ? null : c.caller_client_id, name);
}
function handleCallbackHash(){
  const m = /^#callback=([0-9a-f-]{36})$/i.exec(location.hash || '');
  if(!m) return;
  history.replaceState(null, '', location.pathname + location.search);
  voiceCallBackFromCallId(m[1]);
}
window.addEventListener('hashchange', () => { if(myUserId) handleCallbackHash(); });

// ---- SMS tab: in-app notification when a client replies ----
// There's no reliable webhook feed for this -- ghl_messages (fed by a GHL
// Workflow) is stale/unreliable -- so this polls each active client's SMS
// history instead, the same lookup_contact_activity call the SMS tab
// itself already uses. Runs only for staff with canTextClients (the same
// permission that gates the SMS tab existing at all -- no point polling on
// behalf of someone who couldn't open it to see the result). Each
// qualifying staff member's own browser independently detects and
// notifies itself, which is exactly "notify everyone with the permission"
// without needing a shared broadcast. Dedup state lives in localStorage
// (per-browser, no new table) keyed by client id, so a message already
// notified about doesn't re-fire on the next poll or a page reload, and
// the very first check for a client just records the current high-water
// mark rather than notifying about their entire pre-existing history at once.
let chatSmsNotifyPollTimer = null;
let chatSmsNotifySeenAt = {}; // clientId -> iso string of the newest inbound message already notified about
function chatSmsNotifyStorageKey(){ return `chatSmsNotifySeenAt:${myUserId}`; }
function chatSmsNotifyLoadSeen(){
  try{ chatSmsNotifySeenAt = JSON.parse(localStorage.getItem(chatSmsNotifyStorageKey()) || '{}'); }
  catch{ chatSmsNotifySeenAt = {}; }
}
function chatSmsNotifySaveSeen(){
  try{ localStorage.setItem(chatSmsNotifyStorageKey(), JSON.stringify(chatSmsNotifySeenAt)); }catch{}
}
// Pending badge for the SMS bottom tab — "pending" means there's an
// inbound text staff hasn't opened yet, cleared the moment they actually
// open that client's thread. Read markers reuse chat_reads, same table/
// RLS the Chats tab's own per-conversation unread already runs on, just
// with a synthetic key ('sms:<clientId>') instead of a real chat_messages
// conversation — chat_reads' write policies only check auth.uid() =
// user_id, no constraint on what conversation_key looks like, so this
// needed no schema/RLS change.
let chatSmsPendingByClient = {}; // clientId -> boolean
let chatCallsPendingCount = 0;
function chatUpdateBottomTabBadges(){
  chatSetBadge('chatBottomBadgeSms', Object.values(chatSmsPendingByClient).filter(Boolean).length);
  chatSetBadge('chatBottomBadgeCalls', chatCallsPendingCount);
}

async function chatPollSmsForNotifications(){
  // canTextClients is a hard requirement (lookup_contact_activity itself
  // 403s without it, per ghl-api's own gate) -- staffNotifKindAllowed is
  // the separate, admin-configurable "who gets notified" narrowing on top
  // of that, same as every other kind in STAFF_NOTIF_KINDS. Both must
  // pass. Fetched fresh each poll (cheap single-row-per-kind query) rather
  // than assuming subscribeStaffOpsRealtime() already warmed
  // staffNotifRolesCache by the time this first runs.
  if(!myPermissions.canTextClients) return;
  await fetchStaffNotifRolesConfig();
  if(!staffNotifKindAllowed('client_sms_reply')) return;
  const locationId = await chatResolveGhlLocationId();
  if(!locationId) return;
  const { data: clients } = await sb.from('client_accounts').select('id, full_name, company_name, phone').eq('is_active', true).not('phone', 'is', null);
  let changed = false;
  for(const c of (clients || [])){
    if(!c.phone) continue;
    // Don't let one client's lookup failure (missing GHL scope, a hiccup,
    // etc.) stop the rest of the batch from being checked.
    let res;
    try{ res = await callGhlApi({ action: 'lookup_contact_activity', locationId, phone: c.phone }); }
    catch{ continue; }
    if(!res.ok || res.conversationError) continue;
    const inbound = (res.messages || [])
      .filter(m => ghlLookupClassifyMessage(m) === 'sms' && (m.direction || '').toLowerCase().includes('inbound'))
      .sort((a, b) => new Date(b.dateAdded || b.dateUpdated) - new Date(a.dateAdded || a.dateUpdated))[0];
    if(!inbound){ chatSmsPendingByClient[c.id] = false; continue; }
    const at = inbound.dateAdded || inbound.dateUpdated;
    // Pending badge: independent of the notify-dedup logic just below
    // (that one only cares about "have I already notified for this
    // message"; this cares about "has staff actually opened this client's
    // thread since this message arrived").
    const readAt = chatLastRead['sms:' + c.id];
    chatSmsPendingByClient[c.id] = !readAt || new Date(at) > new Date(readAt);
    const seenAt = chatSmsNotifySeenAt[c.id];
    if(seenAt && new Date(at) <= new Date(seenAt)) continue;
    const isFirstCheck = !seenAt;
    chatSmsNotifySeenAt[c.id] = at;
    changed = true;
    if(isFirstCheck) continue; // first-ever check for this client on this browser -- just record the high-water mark
    pushStaffNotification({
      icon: '✉️',
      title: c.full_name || 'Client',
      body: ghlLookupMessageBody(inbound),
      onClick: () => {
        $('chatPanel').style.display = 'flex';
        const smsTabBtn = $('chatBottomTabs').querySelector('[data-chat-bottom-tab="sms"]');
        if(smsTabBtn) smsTabBtn.click();
        chatOpenSmsThread(c);
      },
    });
  }
  if(changed) chatSmsNotifySaveSeen();
  chatUpdateBottomTabBadges();
  // Refresh the per-row dots if SMS is the tab currently on screen —
  // chatRenderSmsList() itself doesn't hit GHL (it only reads
  // client_accounts), so this is cheap and keeps the list in sync with
  // whatever this poll just found without staff needing to switch away
  // and back.
  if(chatBottomTab === 'sms') chatRenderSmsList();
}

// v477: Gmail lives as its own group under the Activity tab (see
// activateActivityKind's gmail_inbox branch and friends further down),
// not as a chat-widget bottom tab -- this block is now JUST the
// background "new mail in the shared inbox" notifier. No more per-client
// concept now that Gmail is a real general inbox (any sender) rather than
// scoped to client_accounts rows -- gmailNotifySeenAt is a single ISO
// timestamp (was a per-client map pre-v477; stored under the same
// localStorage key, so an old cached object value there just gets
// discarded and treated as "never checked" rather than migrated).
let gmailNotifyPollTimer = null;
let gmailNotifySeenAt = null; // iso 'date' of the newest inbox message already notified about
function gmailNotifyStorageKey(){ return `gmailNotifySeenAt:${myUserId}`; }
function gmailNotifyLoadSeen(){
  try{
    const raw = JSON.parse(localStorage.getItem(gmailNotifyStorageKey()) || 'null');
    gmailNotifySeenAt = (typeof raw === 'string') ? raw : null;
  }catch{ gmailNotifySeenAt = null; }
}
function gmailNotifySaveSeen(){
  try{ localStorage.setItem(gmailNotifyStorageKey(), JSON.stringify(gmailNotifySeenAt)); }catch{}
}

// Polls the shared inbox's first page (25 most recent) for new mail, same
// role/shape as chatPollSmsForNotifications. Runs at a slower 60s cadence
// (vs SMS's 30s) since each check here costs a Gmail list call PLUS one
// metadata fetch per message on that page, not a single GHL call.
async function pollGmailReplyNotifications(){
  if(!myPermissions.canTextClients) return;
  await fetchStaffNotifRolesConfig();
  if(!staffNotifKindAllowed('gmail_new_message')) return; // own routing now -- see STAFF_NOTIF_KINDS' 'gmail_new_message' entry
  let res;
  try{ res = await callGmailApi({ action: 'list_messages', folder: 'inbox' }); }
  catch{ return; }
  if(!res.ok){
    // v807: with no shared inbox connected this failed every minute, all day
    // (194 errors in gmail-api's logs from one open tab). Stop asking for the
    // rest of this session; the next sign-in or page load checks once again.
    if(/no gmail inbox is connected/i.test(res.error || '') && gmailNotifyPollTimer){
      clearInterval(gmailNotifyPollTimer);
      gmailNotifyPollTimer = 'stopped';   // truthy, so the sign-in path does not restart it this session
    }
    return;
  }
  const messages = res.messages || [];
  const badge = $('actGmailInboxUnreadBadge');
  if(badge) badge.style.display = messages.some(m => m.unread) ? '' : 'none';
  const newest = messages.slice().sort((a, b) => new Date(b.date || 0) - new Date(a.date || 0))[0];
  if(!newest) return;
  if(gmailNotifySeenAt && new Date(newest.date || 0) <= new Date(gmailNotifySeenAt)) return;
  const isFirstCheck = !gmailNotifySeenAt;
  gmailNotifySeenAt = newest.date;
  gmailNotifySaveSeen();
  if(isFirstCheck) return; // don't retroactively notify about mail that arrived before this ever ran
  pushStaffNotification({
    icon: '📧',
    title: newest.from || 'New email',
    body: newest.subject || newest.snippet || '',
    // v623: NO onClick. This opened Activity -> Gmail -> the message, and
    // the Gmail group is gone, so there is no in-portal inbox to open it in.
    // The notification still tells you mail arrived and who from; reading it
    // happens in Gmail itself now.
  });
}

$('chatBottomTabs').addEventListener('click', (e) => {
  const btn = e.target.closest('.chat-bottom-tab-btn');
  if(!btn || btn.dataset.chatBottomTab === chatBottomTab) return;
  chatBottomTab = btn.dataset.chatBottomTab;
  $('chatBottomTabs').querySelectorAll('.chat-bottom-tab-btn').forEach(b => b.classList.toggle('active', b.dataset.chatBottomTab === chatBottomTab));
  $('chatConvList').style.display = chatBottomTab === 'chats' ? 'block' : 'none';
  $('chatSearchInput').style.display = chatBottomTab === 'chats' ? '' : 'none';
  $('chatSmsList').style.display = chatBottomTab === 'sms' ? 'block' : 'none';
  $('chatCallsList').style.display = chatBottomTab === 'calls' ? 'block' : 'none';
  if(chatBottomTab === 'sms') chatRenderSmsList();
  // Render first (so calls that arrived since the last visit still show
  // their "not yet seen" dot for this one viewing), then mark the tab
  // read -- next time it's opened those same calls no longer count as
  // pending, same "open it once and it's read" behavior as SMS/Chats.
  if(chatBottomTab === 'calls') chatRenderCallsList().then(() => chatMarkRead('calls'));
});

async function chatMarkRead(key){
  const nowIso = new Date().toISOString();
  chatLastRead[key] = nowIso;
  if(chatConversations[key]) chatConversations[key].unread = 0;
  updateChatUnreadBadge();
  try{
    await sb.from('chat_reads').upsert({ user_id: myUserId, conversation_key: key, last_read_at: nowIso });
  }catch(e){ console.error('Failed to save chat read marker', e); }
}

async function openChatThread(key){
  // v316: leaving whatever conversation was open — tell that peer we're
  // no longer typing rather than waiting on the 2.5s timeout to say so.
  if(chatActiveConv && chatActiveConv !== key && chatActiveConv !== 'team' && !chatActiveConv.startsWith('group:')){
    clearTimeout(chatTypingStopTimer);
    chatTypingSend(chatActiveConv, 'stopped');
  }
  if(!key.startsWith('client:')) chatCloseClientTypingChannel();
  chatActiveConv = key;
  // v190: the floating mascot art now doubles as a "you're talking to
  // Desouky" indicator rather than an always-on entry point — it only
  // shows while his own DM thread is the one open, and disappears the
  // moment the person switches to any other conversation (or closes the
  // panel — see the chatCloseBtn handler below).
  if($('desoukyMascotWrap')){
    $('desoukyMascotWrap').style.display = (AI_ASSISTANT_BOT_ID && key === AI_ASSISTANT_BOT_ID) ? 'flex' : 'none';
    if(typeof positionDesoukyMascot === 'function'){ positionDesoukyMascot(); setTimeout(positionDesoukyMascot, 300); } // v695
  }
  if(chatOfflineHint && chatOfflineHint.key !== key) chatOfflineHint = null;
  chatClearPendingFile();
  chatHideMentionBox();
  chatStopRecording(true); // discard any in-progress recording from whatever thread was open before
  $('chatListView').style.display = 'none';
  $('chatMyProfileView').style.display = 'none';
  $('chatNewGroupView').style.display = 'none';
  $('chatNewClientChatView').style.display = 'none';
  $('chatThreadView').style.display = 'flex';
  // v230: client-only controls — "End this chat", the manual "text this
  // client's phone" composer, and the unclaimed-broadcast Accept bar — were
  // only ever explicitly hidden inside openClientChatThread(), never reset
  // here. Switching FROM a client conversation TO a staff DM/group/team
  // conversation left whichever of these were last shown still visible,
  // sitting on top of a conversation they have no meaning in. Unconditional
  // reset here; openClientChatThread() (below) re-shows whichever actually
  // apply for that specific client thread.
  $('chatEndClientChatBtn').style.display = 'none';
  $('clientTextComposer').style.display = 'none';
  $('chatClientClaimBar').style.display = 'none';
  $('chatTextClientBtn').style.display = 'none';
  $('chatCallClientInAppBtn').style.display = 'none';

  // v91: Client Chats are a different data model entirely (no
  // attachments/mentions/groups/voice-call — just a client and whichever
  // staff member their conversation is routed to), so this gets its own
  // render path rather than trying to fold it into the branches below.
  if(key.startsWith('client:')){
    // v701: a client conversation opens in the Client Inbox page.
    if(ciCanUseInbox()){
      chatActiveConv = null;
      $('chatThreadView').style.display = 'none';
      $('chatListView').style.display = 'flex';
      ciOpenFromElsewhere(key.slice(7));
      return;
    }
    openClientChatThread(key.slice(7));
    return;
  }

  $('chatThreadTitleName').textContent = chatConvDisplayName(key);
  renderChatThreadHeaderStatus(key); // v1.2.9: show the other person's presence (DM) or active-count (group)
  if(!chatConversations[key]) chatConversations[key] = { key, messages: [], unread: 0 };

  const isGroup = key.startsWith('group:');
  $('chatThreadInfoBtn').style.display = isGroup ? 'inline-block' : 'none';
  $('chatThreadInfoBtn').onclick = isGroup ? () => openChatGroupInfo(key.slice(6)) : null;

  const isTeam = key === 'team';
  const canPost = isTeam ? chatCanPostTeam() : true;
  $('chatCommunicationDisclaimer').style.display = (isTeam && !canPost) ? 'block' : 'none';
  $('chatInputRow').style.display = canPost ? 'flex' : 'none';
  // Google Meet is restricted to the company's own domain — anyone signed
  // in with an outside email (e.g. a contractor/external account) doesn't
  // get the button at all, regardless of canPost.
  $('chatMeetBtn').style.display = (canPost && chatMeetAllowed()) ? 'inline-block' : 'none';
  // v638: GROUPS CAN NOW BE CALLED. The comment that used to sit here said
  // a mesh call "isn't supported" and that it was out of scope -- which
  // stopped being true some time ago and nobody removed the button gate.
  // The whole mesh already exists and is in daily use: call_participants
  // keyed by call_group_id, voiceRosterInit/Insert/SetStatus, mesh-offer /
  // mesh-answer / mesh-ice-candidate signalling, a participants panel, a
  // per-invitee no-answer timer, and inviteToCall() to add people to a live
  // call. The ONLY thing missing was a way to start one from a group
  // instead of dialling somebody 1:1 and then adding the others by hand.
  //
  // So this is not new call machinery, it is the existing "Add to call"
  // path seeded from the group's membership -- see
  // startGroupConferenceCall().
  //
  // The original caution is still WORTH KEEPING IN MIND and is why there is
  // a size guard in that function rather than an unlimited fan-out: a full
  // mesh is N*(N-1)/2 connections and every participant uploads their audio
  // to everyone else, so it degrades without an SFU. It is fine for a small
  // team huddle and not for twenty people.
  //
  // 'team' stays excluded: it is everybody in the company, which is exactly
  // the case a mesh cannot carry.
  $('chatCallBtn').style.display = (canPost && !isTeam) ? 'inline-block' : 'none';
  $('chatCallBtn').title = isGroup
    ? 'Start a conference call — rings everyone in this group'
    : 'Voice call';

  renderChatThread();
  await chatMarkRead(key);
  if(canPost) $('chatInput').focus();
}

// ---------- v91: Client Chats (client-portal AI assistant, routed to a
// staff member's chat) ----------
// Fetches every client_chat_threads row assigned to me (Owner/Admin also
// see every 'routed' thread generally, so they can jump into any of them
// if a client needs help and their assigned person is away), then the
// messages for each — small volume by nature (one thread per client, at
// most a handful routed/active at once), so this is a couple of plain
// queries rather than anything paginated.
// v204: a small, read-only cache of queue_key -> label, used to show
// "waiting — Sales / Partnerships" in the claim bar (chatQueueLabel()
// below) for EVERY dashboard chat user — not just Owner/Admin, who are
// the only ones who can actually open the Chat Settings card that
// manages client_chat_routes. RLS on that table is has_dashboard_access()
// (any staff), so this is safe to load unconditionally.
let chatQueueRoutesCache = {};
async function loadChatQueueLabels(){
  const { data } = await sb.from('client_chat_routes').select('queue_key, label');
  chatQueueRoutesCache = {};
  (data || []).forEach(r => { chatQueueRoutesCache[r.queue_key] = r.label; });
}
function chatQueueLabel(queueKey){
  return chatQueueRoutesCache[queueKey] || queueKey;
}

// v207: the client_chat_threads realtime listener below fires this on
// EVERY change to ANY client thread (not just the one on screen), and a
// single client reopening a chat can trigger two or three of those
// events in quick succession (closed -> 'ai' on reopen, then possibly
// 'routed' again moments later if the AI routes it). Each call to this
// function does its own async round trip (thread list, then the message
// RPC) and then REPLACES chatConversations wholesale — so if an earlier
// call is still in flight when a later one starts and finishes first,
// the earlier call's now-stale results can land AFTER the newer one and
// silently overwrite it, wiping a conversation back to empty until the
// next event (or a full page reload, which only ever runs one clean
// call) fixes it. clientChatOverviewSeq guards against exactly this: a
// call whose result comes back after a newer call has already started
// discards itself instead of applying stale data.
let clientChatOverviewSeq = 0;
async function loadClientChatOverview(){
  if(!myUserId) return;
  const mySeq = ++clientChatOverviewSeq;
  const seeAll = myIsOwner || myRole === 'admin';
  let threads;
  if(seeAll){
    // v204: Owner/Admin used to only see 'routed' threads — meaning if a
    // client's conversation was still with the AI (or had never been
    // routed at all), there was nothing here to open and reply to.
    // Owner/Admin can now browse and message ANY client at any time,
    // same idea as being able to walk up to any desk — no status filter.
    const { data, error } = await sb.from('client_chat_threads')
      .select('client_id, status, queue_key, assigned_staff_id, updated_at, client_accounts(full_name, company_name)');
    if(error){ console.error('Failed to load client chat threads', error); return; }
    threads = data;
  } else {
    // Two separate queries, unioned client-side: threads already
    // assigned to me, plus unclaimed ('routed', assigned_staff_id null)
    // threads sitting in a queue I'm eligible for — RLS backs both
    // (see v204-incremental-schema.sql), this just avoids an `or`
    // filter across a joined table that PostgREST can't express cleanly
    // in one call.
    const { data: myQueues } = await sb.from('client_chat_route_staff').select('queue_key').eq('staff_id', myUserId);
    const queueKeys = (myQueues || []).map(q => q.queue_key);
    const [{ data: mine, error: mineErr }, { data: unclaimed, error: unclaimedErr }] = await Promise.all([
      sb.from('client_chat_threads').select('client_id, status, queue_key, assigned_staff_id, updated_at, client_accounts(full_name, company_name)').eq('assigned_staff_id', myUserId),
      queueKeys.length
        ? sb.from('client_chat_threads').select('client_id, status, queue_key, assigned_staff_id, updated_at, client_accounts(full_name, company_name)').eq('status', 'routed').is('assigned_staff_id', null).in('queue_key', queueKeys)
        : Promise.resolve({ data: [], error: null }),
    ]);
    if(mineErr || unclaimedErr){ console.error('Failed to load client chat threads', mineErr || unclaimedErr); return; }
    const seen = new Set();
    threads = [...(mine || []), ...(unclaimed || [])].filter(t => { if(seen.has(t.client_id)) return false; seen.add(t.client_id); return true; });
  }
  if(mySeq !== clientChatOverviewSeq) return; // a newer call already started — our thread list is stale, don't act on it

  const newDirectory = (threads || []).map(t => ({
    client_id: t.client_id,
    full_name: (t.client_accounts && t.client_accounts.full_name) || 'Client',
    company_name: (t.client_accounts && t.client_accounts.company_name) || '',
    status: t.status,
    queue_key: t.queue_key,
    assigned_staff_id: t.assigned_staff_id,
    unclaimed: t.status === 'routed' && !t.assigned_staff_id,
  }));

  if(!newDirectory.length){
    if(mySeq !== clientChatOverviewSeq) return;
    clientChatThreadsDirectory = newDirectory;
    updateChatUnreadBadge();
    return;
  }

  clientChatThreadsDirectory = newDirectory;
  // Drop any 'client:' conversation entries left over from a thread
  // that's no longer visible to me (reassigned, closed, or — for a
  // non-admin — routed to a different queue) — otherwise a stale entry
  // keeps contributing to the unread badge count forever.
  const currentKeys = new Set(newDirectory.map(t => 'client:' + t.client_id));
  Object.keys(chatConversations).forEach(k => { if(k.startsWith('client:') && !currentKeys.has(k)) delete chatConversations[k]; });

  // v211: THE actual fix, after three rounds (v206/v207/v208) of
  // race-guarding a fundamentally fragile design instead of removing the
  // fragility. This used to re-fetch full message history for EVERY
  // visible client on EVERY call — and this function gets called often
  // (any client_chat_threads change anywhere, a reply's own claim
  // update, the 20s poll). Every one of those was a chance for a fetch
  // to race, lag, or (for a non-admin) transiently miss a thread mid
  // reassignment, and even with v207's sequence guard and v208's
  // "don't regress to empty" guard, the stale-key cleanup two lines up
  // could still delete a conversation's entry outright if that ONE
  // fetch's directory query didn't happen to include it — bypassing
  // both guards, since neither one runs for a client that isn't in
  // newDirectory at all.
  //
  // Fixed by removing the repeated re-fetching entirely: a conversation
  // already present in chatConversations is now NEVER touched here
  // again. Message history is fetched exactly once, the moment a client
  // first becomes visible this session; from then on it's maintained
  // exclusively by the client_chat_messages realtime INSERT handler
  // (see subscribeChatRealtime() below), which only ever appends to an
  // existing array — there is no remaining code path that can replace
  // or empty an already-loaded conversation's messages.
  newDirectory.forEach(t => {
    const key = 'client:' + t.client_id;
    if(!chatConversations[key]) chatConversations[key] = { key, messages: [], unread: 0 };
  });
  const newClientIds = newDirectory.map(t => t.client_id).filter(id => !chatConversations['client:' + id].loadedOnce);
  if(!newClientIds.length){ updateChatUnreadBadge(); return; }

  const { data: msgs, error: msgsErr } = await sb.rpc('client_chat_messages_recent', { p_client_ids: newClientIds, p_per_client_limit: 100 });
  if(mySeq !== clientChatOverviewSeq) return; // superseded while the RPC was in flight — discard
  if(msgsErr){ console.error('Failed to load client chat messages', msgsErr); updateChatUnreadBadge(); return; }

  newClientIds.forEach(clientId => {
    const key = 'client:' + clientId;
    const messages = (msgs || [])
      .filter(m => m.client_id === clientId)
      .sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
    const lastReadIso = chatLastRead[key];
    const unread = messages.filter(m => m.sender !== 'staff' && m.sender !== 'system' && (!lastReadIso || new Date(m.created_at) > new Date(lastReadIso))).length;
    chatConversations[key] = { key, messages, unread, loadedOnce: true };
  });
  updateChatUnreadBadge();
}

function chatClientThreadName(clientId){
  const t = clientChatThreadsDirectory.find(x => x.client_id === clientId);
  if(!t) return 'Client';
  return t.company_name ? `${t.company_name} (${t.full_name})` : t.full_name;
}

// v231: the "text this client's phone" button now only ever sends this
// one canned confirmation nudge (kind: 'campaign_confirm' in
// send-client-sms) instead of a freeform message — see
// clientTextComposerOpen()'s click handler in openClientChatThread().
// This default mirrors DEFAULT_TEMPLATES.campaign_confirm in the edge
// function; the live one (possibly edited by an Owner/Admin under User
// Management → Integrations) is fetched fresh every time the composer
// opens, same source of truth send-client-sms itself reads from, so the
// preview shown here never drifts from what actually gets sent.
const CLIENT_TEXT_CAMPAIGN_CONFIRM_DEFAULT = 'Hi {client_name}, our team wants to connect with you for your campaign ({campaign}) — please log in https://clientportal.proptechnologyai.com/ > click on ask me button > to respond to the team.';
let clientTextComposerState = null; // { clientId, clientName, template, campaignNames }

async function clientTextComposerOpen(clientId, clientName){
  const composer = $('clientTextComposer');
  const msgEl = $('clientTextComposerMsg');
  const campaignRow = $('clientTextComposerCampaignRow');
  const campaignSelect = $('clientTextComposerCampaignSelect');
  const preview = $('clientTextComposerPreview');
  const sendBtn = $('clientTextComposerSendBtn');
  msgEl.textContent = '';
  preview.textContent = 'Loading…';
  campaignRow.style.display = 'none';
  campaignSelect.innerHTML = '';
  sendBtn.disabled = true;
  composer.style.display = 'block';

  const [{ data: campaigns }, { data: tmplRow }] = await Promise.all([
    sb.from('client_campaign_access').select('form_id, lead_submission_forms(name)').eq('client_id', clientId),
    sb.from('app_settings').select('value').eq('key', 'client_sms_template_campaign_confirm').maybeSingle(),
  ]);
  const template = (tmplRow && tmplRow.value) || CLIENT_TEXT_CAMPAIGN_CONFIRM_DEFAULT;
  const campaignNames = [...new Set((campaigns || []).map(c => c.lead_submission_forms && c.lead_submission_forms.name).filter(Boolean))];
  clientTextComposerState = { clientId, clientName, template, campaignNames };

  if(!campaignNames.length){
    preview.textContent = 'This client has no campaign access granted yet — nothing to send.';
    return;
  }
  sendBtn.disabled = false;
  if(campaignNames.length > 1){
    campaignRow.style.display = 'block';
    campaignSelect.innerHTML = campaignNames.map(n => `<option value="${escapeHtml(n)}">${escapeHtml(n)}</option>`).join('');
    campaignSelect.onchange = clientTextComposerRenderPreview;
  }
  clientTextComposerRenderPreview();
}

function clientTextComposerRenderPreview(){
  if(!clientTextComposerState) return;
  const { clientName, template, campaignNames } = clientTextComposerState;
  const campaign = campaignNames.length > 1 ? $('clientTextComposerCampaignSelect').value : campaignNames[0];
  $('clientTextComposerPreview').textContent = template
    .replaceAll('{client_name}', clientName || 'there')
    .replaceAll('{campaign}', campaign || 'your campaign');
}

function openClientChatThread(clientId){
  const key = 'client:' + clientId;
  const thread = clientChatThreadsDirectory.find(t => t.client_id === clientId) || {};
  chatOpenClientTypingChannel(clientId);
  $('chatThreadTitleName').textContent = chatClientThreadName(clientId);
  $('chatThreadTitleStatus').style.display = 'none';
  $('chatThreadInfoBtn').style.display = 'none';
  $('chatThreadInfoBtn').onclick = null;
  $('chatCommunicationDisclaimer').style.display = 'none';
  $('chatMeetBtn').style.display = 'none';
  $('chatCallBtn').style.display = 'none'; // client -> staff calling only, see voice_calls' caller_client_id — this dials THROUGH the app instead, see chatCallClientInAppBtn below

  // v231: "call in portal" — real in-app WebRTC calling, same mechanism as
  // staff-to-staff calls (see startVoiceCallToClient()), just the reverse
  // direction of the calling this app already had (client -> staff). Only
  // works if the client currently has their portal tab open — there's no
  // way to detect that from here, so it's shown whenever texting is
  // allowed on this thread at all (same gate as the tel: button/composer)
  // rather than trying to guess client presence.
  const inAppCallBtn = $('chatCallClientInAppBtn');
  inAppCallBtn.style.display = (myPermissions.canTextClients && !thread.unclaimed) ? 'inline-block' : 'none';
  inAppCallBtn.onclick = () => startVoiceCallToClient(clientId, chatClientThreadName(clientId));

  // v204: an unclaimed broadcast thread (routed to a team, nobody's
  // accepted it yet) shows an Accept bar instead of the normal reply
  // box — Owner/Admin can still see it via loadClientChatOverview's
  // seeAll branch, but sending straight into an unclaimed thread would
  // silently skip the "who's actually handling this" bookkeeping the
  // rest of the system relies on, so even they go through Accept first.
  const claimBar = $('chatClientClaimBar');
  if(thread.unclaimed){
    claimBar.style.display = 'flex';
    $('chatClientClaimBarText').textContent = 'Waiting to be accepted' + (thread.queue_key ? ` — ${chatQueueLabel(thread.queue_key)}` : '') + '.';
    $('chatClientClaimBtn').onclick = () => acceptClientChatThread(clientId);
    $('chatInputRow').style.display = 'none';
  } else {
    claimBar.style.display = 'none';
    $('chatInputRow').style.display = 'flex';
  }

  // End chat: available to Owner/Admin on any thread, or to whoever it's
  // currently assigned to — mirrors the RLS policies backing
  // endClientChatThread() below, so this never shows a button that would
  // just fail against the database.
  const endBtn = $('chatEndClientChatBtn');
  const canEndThisChat = !thread.unclaimed && thread.status !== 'closed' && (myIsOwner || myRole === 'admin' || thread.assigned_staff_id === myUserId);
  endBtn.style.display = canEndThisChat ? 'inline-block' : 'none';
  endBtn.onclick = () => endClientChatThread(clientId);

  // v195: attachments and voice messages now work in client conversations
  // too (see sendChatMessage()'s client: branch and renderClientChatMessages()
  // below) — only the emoji/mention picker still doesn't apply, since a
  // client conversation has no team roster to @mention.
  $('chatEmojiBtn').style.display = 'none';
  $('chatAttachBtn').style.display = thread.unclaimed ? 'none' : '';
  $('chatMicBtn').style.display = thread.unclaimed ? 'none' : '';

  // v194/v231: "text this client's phone" button — separate permission
  // from ordinary Client Chats access, see myPermissions.canTextClients.
  $('clientTextComposer').style.display = 'none';
  $('clientTextComposerMsg').textContent = '';
  const textBtn = $('chatTextClientBtn');
  textBtn.style.display = (myPermissions.canTextClients && !thread.unclaimed) ? 'inline-block' : 'none';
  textBtn.onclick = () => {
    const composer = $('clientTextComposer');
    if(composer.style.display !== 'none'){ composer.style.display = 'none'; return; }
    clientTextComposerOpen(clientId, chatClientThreadName(clientId));
  };
  $('clientTextComposerCancelBtn').onclick = () => { $('clientTextComposer').style.display = 'none'; };
  $('clientTextComposerSendBtn').onclick = async () => {
    if(!clientTextComposerState || !clientTextComposerState.campaignNames.length) return;
    const { campaignNames } = clientTextComposerState;
    const campaign = campaignNames.length > 1 ? $('clientTextComposerCampaignSelect').value : campaignNames[0];
    const msgEl = $('clientTextComposerMsg');
    const btn = $('clientTextComposerSendBtn');
    btn.disabled = true; btn.textContent = 'Sending…';
    try{
      callSendClientEmail(clientId, 'campaign_confirm', campaign); // v307: fire-and-forget alongside the SMS below
      const { data, error } = await sb.functions.invoke('send-client-sms', { body: { clientId, kind: 'campaign_confirm', details: campaign } });
      if(error){
        let msg = error.message;
        try{ const b = await error.context.json(); msg = b.error || msg; }catch(e){}
        throw new Error(msg);
      }
      if(!data || !data.ok) throw new Error((data && data.error) || 'Failed to send.');
      msgEl.textContent = 'Text sent.'; msgEl.className = 'msg success';
      setTimeout(() => { $('clientTextComposer').style.display = 'none'; msgEl.textContent = ''; }, 1200);
    }catch(e){
      console.error('Client campaign-confirm text failed:', e);
      msgEl.textContent = e.message || 'Failed to send.'; msgEl.className = 'msg error';
    }finally{
      btn.disabled = false; btn.textContent = 'Send text';
    }
  };

  if(!chatConversations[key]) chatConversations[key] = { key, messages: [], unread: 0 };
  renderClientChatMessages(clientId);
  chatMarkRead(key);
  // v314: staff is now looking at this thread -- mark the client's
  // messages to us as delivered+read. Fire-and-forget; the realtime
  // UPDATE handler (see subscribeChatRealtime) refreshes ticks once this
  // lands, and re-rendering here isn't needed since we already just
  // rendered above.
  sb.rpc('mark_client_chat_read', { p_client_id: clientId }).then(({ error }) => { if(error) console.error('mark_client_chat_read failed', error); });
  $('chatInput').focus();
}

function chatClientMessageEditable(m){
  return m.sender === 'staff' && m.staff_id === myUserId && (Date.now() - new Date(m.created_at).getTime()) < CHAT_EDIT_WINDOW_MS;
}
// v314: client_chat_messages is always exactly 2 parties, so ticks read
// straight off delivered_at/read_at -- no receipts index needed the way
// the internal DM/team/group chat needs one.
function chatClientTickState(m){
  if(m.read_at) return 'read';
  if(m.delivered_at) return 'delivered';
  return 'sent';
}
// v626: the reference's sender header -- name plus a role badge -- shown
// above an INCOMING message only, and only when it is not sequential.
//
// Why a role badge at all: this widget carries three different
// conversations (staff-staff, staff-client, client-staff) through one
// panel, and before this every sender looked identical. Naming the role
// next to the name is what the reference does and is the cheapest way to
// stop somebody answering a client in the tone they'd use with a
// colleague.
//
// role is 'staff' | 'client' | 'ai'. `detail` is the reference's
// "Client - <organization>" suffix; omitted when we have no org on file
// rather than printing "Client - External" as the reference does, since we
// usually DO know the company and a placeholder would be noise.
function chatMsgHeadHtml(name, role, detail){
  const label = role === 'client' ? (detail ? 'Client · ' + escapeHtml(detail) : 'Client')
    : role === 'ai' ? 'AI'
    : 'Staff';
  // v639: for a colleague the badge carries their TITLE rather than the
  // generic word "Staff" -- "Team Lead · Operations" tells you how to pitch
  // a reply in a way that "Staff" never did. Falls back to 'Staff' for
  // anyone not categorised yet, so nothing renders blank.
  const staffDetail = (role === 'staff' && detail) ? escapeHtml(detail) : null;
  return `<div class="chat-msg-head">`
    + `<span class="chat-msg-head-name">${escapeHtml(name || 'Unknown')}</span>`
    + `<span class="chat-role-badge ${role}">${staffDetail || label}</span>`
    + `</div>`;
}

// Consecutive messages from the same sender inside a minute collapse into
// one block -- the reference's own rule (same senderId, <60000ms). Without
// it a five-message burst repeats somebody's name and badge five times.
const CHAT_SEQUENTIAL_MS = 60000;
function chatIsSequential(prev, senderKey, atMs){
  if(!prev) return false;
  return prev.key === senderKey && (atMs - prev.at) < CHAT_SEQUENTIAL_MS;
}

function renderClientChatMessages(clientId){
  const key = 'client:' + clientId;
  const conv = chatConversations[key] || { messages: [] };
  const box = $('chatMessages');
  const wasAtBottom = chatAtBottom(box); // v632: read BEFORE innerHTML is replaced
  const clientChatTz = nonAgentDisplayTz();
  // v626: who sent the previous message, for the sequential check below.
  let prevSender = null;
  const clientDisplayName = chatClientThreadName(clientId);
  chatSwapHtml(box, conv.messages.map(m => {
    if(m.sender === 'system'){ prevSender = null; return `<div class="chat-system-note">${escapeHtml(m.body || '')}</div>`; }   // v704
    const mine = m.sender === 'staff';
    // v626: senderLabel moved OUT of the meta line and into the header
    // above the bubble (chatMsgHeadHtml), so it is empty here now. The
    // meta row keeps the timestamp, edit control and ticks.
    const senderLabel = '';
    // 'client' and 'ai' are the two incoming roles in a client thread.
    const role = m.sender === 'ai' ? 'ai' : (m.sender === 'client' ? 'client' : 'staff');
    const atMs = new Date(m.created_at).getTime();
    const isSeq = chatIsSequential(prevSender, m.sender, atMs);
    prevSender = { key: m.sender, at: atMs };
    const headHtml = (!mine && !isSeq)
      ? chatMsgHeadHtml(role === 'ai' ? 'AI Assistant' : clientDisplayName, role, null)
      : '';
    const time = new Date(m.created_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(clientChatTz ? { timeZone: clientChatTz } : {}) });
    if(chatEditingMessageId === m.id){
      return `
        <div class="chat-msg-row ${mine ? 'mine' : 'theirs'}">
          <div class="chat-msg-meta">${senderLabel}${time}</div>
          <div class="chat-msg-edit-wrap">
            <textarea class="chat-msg-edit-input" data-msg-id="${m.id}">${escapeHtml(m.body || '')}</textarea>
            <div class="chat-msg-edit-actions">
              <button type="button" class="chat-msg-edit-save-btn" data-msg-id="${m.id}" data-client-id="${clientId}">Save</button>
              <button type="button" class="chat-msg-edit-cancel-btn">Cancel</button>
            </div>
          </div>
        </div>`;
    }
    const editedLabel = m.edited_at ? ' <span class="chat-edited-label">(edited)</span>' : '';
    const editBtnHtml = mine && m.body && chatClientMessageEditable(m)
      ? `<span class="chat-msg-edit-btn" data-msg-id="${m.id}" title="Edit message">&#9998;</span>`
      : '';
    const bodyHtml = m.body ? `<div class="chat-msg-bubble">${chatLinkify(escapeHtml(m.body))}</div>` : '';
    // v194: client conversations can now carry an attachment (file/image/
    // voice message) uploaded from the client portal's chat widget — same
    // placeholder-then-resolve pattern as the staff-to-staff chat, just
    // pointed at the client-chat-attachments bucket (see
    // clientChatResolveVisibleAttachments below).
    const attachmentHtml = m.attachment_path
      ? `<div class="chat-msg-attachment" data-attachment-path="${escapeHtml(m.attachment_path)}" data-attachment-mime="${escapeHtml(m.attachment_mime || '')}" data-attachment-name="${escapeHtml(m.attachment_name || 'file')}">Loading attachment…</div>`
      : '';
    const ticksHtml = mine ? chatTicksHtml(chatClientTickState(m)) : '';
    return `
      <div class="chat-msg-row ${mine ? 'mine' : 'theirs with-av'} from-${role}${isSeq ? ' seq' : ''}">
        ${(!mine && !isSeq) ? chatMsgAvatarHtml(role, clientId, clientDisplayName) : ''}
        ${headHtml}
        ${bodyHtml}
        ${attachmentHtml}
        <div class="chat-msg-meta">${senderLabel}${time}${editedLabel}${editBtnHtml}${ticksHtml ? ' ' + ticksHtml : ''}${chatRxAddHtml('client', m.id, clientId)}</div>
        ${chatRxHtml('client', m.id, clientId, mine)}
      </div>
    `;
  }).join('') || '<div class="empty" style="padding:16px 0;">No messages yet.</div>');
  if(chatIsPeerTyping(key)) box.insertAdjacentHTML('beforeend', chatTypingBubbleHtml());   // v704
  // v632: see chatAtBottom() -- pin only if they were already at the bottom,
  // and re-pin once the attachments have resolved and their images loaded.
  if(wasAtBottom) chatPinToBottom(box);
  Promise.resolve(clientChatResolveVisibleAttachments(box))
    .then(() => chatKeepPinned(box, wasAtBottom));
  chatWireClientEditControls(box, clientId);
}
function chatWireClientEditControls(box, clientId){
  box.querySelectorAll('.chat-msg-edit-btn').forEach(el => {
    el.addEventListener('click', () => { chatEditingMessageId = el.dataset.msgId; renderClientChatMessages(clientId); });
  });
  const input = box.querySelector('.chat-msg-edit-input');
  if(input){
    input.focus();
    input.setSelectionRange(input.value.length, input.value.length);
    input.addEventListener('keydown', (e) => {
      if(e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); chatSaveEditedClientMessage(input.dataset.msgId, input.value, clientId); }
      else if(e.key === 'Escape'){ chatEditingMessageId = null; renderClientChatMessages(clientId); }
    });
  }
  const saveBtn = box.querySelector('.chat-msg-edit-save-btn');
  if(saveBtn) saveBtn.addEventListener('click', () => chatSaveEditedClientMessage(saveBtn.dataset.msgId, input ? input.value : '', clientId));
  const cancelBtn = box.querySelector('.chat-msg-edit-cancel-btn');
  if(cancelBtn) cancelBtn.addEventListener('click', () => { chatEditingMessageId = null; renderClientChatMessages(clientId); });
}
async function chatSaveEditedClientMessage(id, newBody, clientId){
  const body = (newBody || '').trim();
  if(!body){ alert("Message can't be empty."); return; }
  const { data, error } = await sb.from('client_chat_messages')
    .update({ body, edited_at: new Date().toISOString() })
    .eq('id', id)
    .select()
    .single();
  chatEditingMessageId = null;
  if(error){
    alert('Failed to save edit — edits are only allowed within 15 minutes of sending. (' + error.message + ')');
    renderClientChatMessages(clientId);
    return;
  }
  const key = 'client:' + clientId;
  const conv = chatConversations[key];
  if(conv){
    const idx = conv.messages.findIndex(x => x.id === id);
    if(idx !== -1) conv.messages[idx] = data;
  }
  renderClientChatMessages(clientId);
}

// Same idea as chatResolveAttachmentUrl/chatResolveVisibleAttachments
// above, pointed at the client-chat-attachments bucket instead — kept as
// its own small pair rather than parameterizing the originals, since the
// two buckets have different RLS policies and this keeps that boundary
// obvious at a glance.
const clientChatAttachmentUrlCache = {};
async function clientChatResolveAttachmentUrl(path){
  if(clientChatAttachmentUrlCache[path]) return clientChatAttachmentUrlCache[path];
  const { data, error } = await sb.storage.from('client-chat-attachments').createSignedUrl(path, 3600);
  if(error){ console.error('Failed to sign client chat attachment URL', error); return null; }
  clientChatAttachmentUrlCache[path] = data.signedUrl;
  return data.signedUrl;
}
async function clientChatResolveVisibleAttachments(container){
  const els = Array.from((container || $('chatMessages')).querySelectorAll('.chat-msg-attachment:not([data-resolved="1"])'));   // v704
  for(const el of els){
    const path = el.dataset.attachmentPath;
    const mime = el.dataset.attachmentMime || '';
    const name = el.dataset.attachmentName || 'file';
    const url = await clientChatResolveAttachmentUrl(path);
    if(!url){ el.textContent = 'Attachment unavailable'; continue; }
    el.dataset.resolved = '1';   // v704: chatSwapHtml carries it across re-renders
    if(mime.startsWith('image/')){
      el.innerHTML = `<img src="${url}" alt="${escapeHtml(name)}">`;
      el.querySelector('img').addEventListener('click', () => openPhotoViewer(url, name));   // v716: pop-up viewer, not a new tab
    } else if(mime.startsWith('audio/')){
      el.className = 'chat-msg-attachment chat-msg-audio';
      // v205: controlsList="nodownload" hides the browser's own forced-
      // download button in the native player's "..." menu (it behaved
      // inconsistently across browsers). v207: the companion link now
      // actually downloads to disk (downloadFileToDisk()) instead of
      // just opening the file in a new tab — a plain link/`download`
      // attribute doesn't force a save for a cross-origin Storage URL.
      el.innerHTML = `<audio controls controlsList="nodownload noremoteplayback" src="${url}"></audio><a class="chat-msg-attachment-file chat-msg-download-link" href="${url}" rel="noopener" style="margin-top:4px;">Download \u2b07</a>`;
      el.querySelector('.chat-msg-download-link').addEventListener('click', (e) => { e.preventDefault(); downloadFileToDisk(url, name); });
    } else {
      el.innerHTML = `<a class="chat-msg-attachment-file chat-msg-download-link" href="${url}" rel="noopener">&#128206; ${escapeHtml(name)}</a>`;
      el.querySelector('.chat-msg-download-link').addEventListener('click', (e) => { e.preventDefault(); downloadFileToDisk(url, name); });
    }
  }
}

// v204: claims an unclaimed broadcast thread — the "Accept" button in
// chatClientClaimBar. The `.is('assigned_staff_id', null)` guard (backed
// by the matching RLS policy, see v204-incremental-schema.sql) is what
// makes this race-safe: if two staff members hit Accept within the same
// second, only the first update actually matches a row — .select()
// coming back empty (no error, just no row) is how the second person
// finds out they were too slow.
async function acceptClientChatThread(clientId){
  const btn = $('chatClientClaimBtn');
  btn.disabled = true; btn.textContent = 'Accepting…';
  const { data, error } = await sb.from('client_chat_threads')
    .update({ assigned_staff_id: myUserId, status: 'routed', updated_at: new Date().toISOString() })
    .eq('client_id', clientId)
    .is('assigned_staff_id', null)
    .select()
    .maybeSingle();
  btn.disabled = false; btn.textContent = 'Accept';
  if(error){ alert('Failed to accept: ' + error.message); return; }
  if(!data){
    alert('Someone else already picked this one up.');
    await loadClientChatOverview();
    renderChatConvList($('chatSearchInput').value);
    $('chatThreadBackBtn').click();
    return;
  }
  await loadClientChatOverview();
  renderChatConvList($('chatSearchInput').value);
  if(chatActiveConv === 'client:' + clientId) openClientChatThread(clientId);
}

// v204: "End chat" — moved here from the client portal (see the
// client-chat-assistant Edge Function's header comment for why). Posts a
// closing note into the transcript first (while the thread's still
// assigned, so the RLS insert check on client_chat_messages passes),
// then closes the thread — a closed thread still shows up in Chat Logs
// (initChatLogsSection()) since messages are never deleted, only the
// thread's own status changes. The client's portal picks this up
// immediately via its own client_chat_threads UPDATE subscription and
// offers a fresh "Connect me to..." choice.
async function endClientChatThread(clientId){
  if(!confirm('End this conversation? The client will see a note that it ended and can start a new one anytime.')) return false;   // v701: returns whether it closed
  const closingNote = `Chat ended by ${myFullName || 'our team'}. Send a new message anytime to start a fresh conversation.`;
  const { error: msgErr } = await sb.from('client_chat_messages')
    .insert({ client_id: clientId, sender: 'staff', staff_id: myUserId, body: closingNote });
  if(msgErr) console.error('Failed to post end-chat note', msgErr);
  const { error } = await sb.from('client_chat_threads')
    .update({ status: 'closed', assigned_staff_id: null, updated_at: new Date().toISOString() })
    .eq('client_id', clientId);
  if(error){ alert('Failed to end chat: ' + error.message); return false; }
  delete chatConversations['client:' + clientId];
  await loadClientChatOverview();
  renderChatConvList($('chatSearchInput').value);
  $('chatThreadBackBtn').click();
  return true;
}

async function sendClientChatReply(clientId, body, attachmentFields){
  if(!body && !(attachmentFields && attachmentFields.attachment_path)) return;
  const { data, error } = await sb.from('client_chat_messages')
    .insert({ client_id: clientId, sender: 'staff', staff_id: myUserId, body: body || '', ...(attachmentFields || {}) })
    .select()
    .single();
  if(error){
    console.error('Failed to send client chat reply', error);
    alert('Failed to send: ' + error.message);
    return null;   // v701: the inbox puts the text back
  }
  const key = 'client:' + clientId;
  if(!chatConversations[key]) chatConversations[key] = { key, messages: [], unread: 0, loadedOnce: true };
  chatConversations[key].messages.push(data);
  if(chatActiveConv === key) renderClientChatMessages(clientId);

  // v210: replying claims the thread for whoever just sent it — same
  // "first to engage owns it" rule the Accept button already applies to
  // an unclaimed broadcast (see acceptClientChatThread()); typing a
  // reply is just as much a claim as clicking Accept, so it shouldn't
  // require a separate step. Covers Owner/Admin proactively messaging a
  // client whose thread was still 'ai' or assigned to someone else too
  // (is_admin() bypasses the RLS restriction that would otherwise limit
  // this to an unclaimed thread in your own queue) — this is what
  // resolves the "known nuance" from the v204 changelog, where a
  // proactive Owner/Admin reply used to leave the thread's assignment
  // untouched. Only writes when something would actually change, so
  // replying to a thread already yours doesn't trigger a no-op update
  // for everyone else watching it.
  const currentThread = clientChatThreadsDirectory.find(t => t.client_id === clientId);
  if(!currentThread || currentThread.assigned_staff_id !== myUserId || currentThread.status !== 'routed'){
    const { error: claimErr } = await sb.from('client_chat_threads')
      .update({ assigned_staff_id: myUserId, status: 'routed', updated_at: new Date().toISOString() })
      .eq('client_id', clientId);
    if(claimErr) console.error('Failed to claim client chat thread on reply', claimErr);
  }
  return data;   // v701
}

// Wraps "@Full Name" (or "@everyone" in the team channel) in a styled
// span — checked longest-name-first so "@Ann" doesn't get partially
// matched inside a rendered "@Anna Smith" further down the same message.
function chatHighlightMentions(escapedBody){
  const names = chatDirectory.map(p => p.full_name || p.email).concat(chatGroupDirectory.map(p => p.full_name || p.email)).concat([myFullName || myEmail]).filter(Boolean);
  if(chatActiveConv === 'team' || chatActiveConv.startsWith('group:')) names.push('everyone');
  names.sort((a, b) => b.length - a.length);
  let out = escapedBody;
  names.forEach(name => {
    const token = '@' + escapeHtml(name);
    if(!out.includes(token)) return;
    // v640: a mention OF ME is marked, so CSS can give it the alert
    // treatment instead of the brand one. 'everyone' counts as mentioning
    // everybody, which includes me.
    const isMe = (name === (myFullName || myEmail)) || name === 'everyone';
    out = out.split(token).join(`<span class="chat-mention${isMe ? ' me' : ''}">${token}</span>`);
  });
  return out;
}

// v640: does this message mention ME? Used to make the notification say so.
// Matches the same tokens chatHighlightMentions() highlights, so what you
// see in the bubble and what the bell tells you cannot disagree.
function chatMessageMentionsMe(m, key){
  const body = m && m.body;
  if(!body) return false;
  const mine = myFullName || myEmail;
  if(mine && body.includes('@' + mine)) return true;
  // '@everyone' only means anything in a channel that has a "everyone" --
  // the same condition chatHighlightMentions() uses before offering it.
  if((key === 'team' || (key && key.startsWith('group:'))) && body.includes('@everyone')) return true;
  return false;
}

// Turns a plain http(s) URL into a clickable link — same "operate only on
// already-escaped text" safety approach as chatHighlightMentions above, so
// this never re-introduces raw/unescaped HTML from a message body. Mainly
// for the Google Meet links chatMeetBtn shares into chat, but applies to
// any URL someone pastes. Trailing punctuation (a period ending the
// sentence, a comma, a closing paren) is kept outside the link since it's
// essentially never actually part of the URL.
function chatLinkify(escapedBody){
  return escapedBody.replace(/(https?:\/\/[^\s<]+)/g, (url) => {
    const trailing = url.match(/[.,;:!?)]+$/);
    const clean = trailing ? url.slice(0, -trailing[0].length) : url;
    const suffix = trailing ? trailing[0] : '';
    return clean ? `<a href="${clean}" target="_blank" rel="noopener noreferrer">${clean}</a>${suffix}` : url;
  });
}

// v205: Desouky's own DM thread (the staff-facing AI assistant bot) —
// same "auto-clears after a day of no activity" treatment as the client
// portal's AI conversation (see visibleClientChatMessages() there):
// render-time filter only, underlying chat_messages rows untouched. Any
// other conversation (team, DMs with real people, groups) is unaffected.
const AI_CHAT_VISIBLE_MS = 24 * 60 * 60 * 1000;
function visibleChatThreadMessages(key, messages){
  if(!AI_ASSISTANT_BOT_ID || key !== AI_ASSISTANT_BOT_ID) return messages;
  const cutoff = Date.now() - AI_CHAT_VISIBLE_MS;
  return messages.filter(m => new Date(m.created_at).getTime() >= cutoff);
}

// v314: id of the message currently in inline-edit mode, or null. Global
// (not per-row) since only one edit can reasonably be open at a time —
// re-rendering the whole thread on start/cancel/save is cheap enough at
// this scale (matches how every other chat re-render here already works).
let chatEditingMessageId = null;

// v718 (the owner: "add emoji reaction on messages"). Every chat message --
// staff chat (team, DMs, groups) and client chat (the widget's client threads
// and Client chat) -- gets a small ☺+ at the end of its time line that opens
// eight emojis. Reactions show as chips under the message; clicking a chip
// adds or takes back yours, hovering one shows who. Rows live in
// chat_message_reactions / client_chat_message_reactions (v718 migration),
// readable by exactly whoever can read the message. The renderers only emit
// placeholders: a thread's reactions are fetched in one batch the first time
// its messages are drawn, and realtime repaints the chips in place -- the
// thread itself is never re-rendered for a reaction.
const CHAT_RX_EMOJIS = ['👍', '❤️', '😂', '😮', '😢', '🙏', '🎉', '✅'];
const CHAT_RX_TABLE = { staff: 'chat_message_reactions', client: 'client_chat_message_reactions' };
const chatRx = { staff: new Map(), client: new Map() };          // message id -> [{ who, kind, emoji }]
const chatRxFetched = { staff: new Set(), client: new Set() };
const chatRxQueue = { staff: new Set(), client: new Set() };
let chatRxTimer = null;
function chatRxAttrs(kind, id, clientId){
  return `data-rx-kind="${kind}" data-rx-id="${escapeHtml(id)}"${clientId ? ` data-rx-client="${escapeHtml(clientId)}"` : ''}`;
}
function chatRxAddHtml(kind, id, clientId){
  return id ? `<span class="chat-rx-add" role="button" tabindex="0" title="React" ${chatRxAttrs(kind, id, clientId)}>&#9786;+</span>` : '';
}
function chatRxHtml(kind, id, clientId, mine){
  if(!id) return '';
  if(!chatRxFetched[kind].has(id)){ chatRxQueue[kind].add(id); if(!chatRxTimer) chatRxTimer = setTimeout(chatRxFlush, 60); }
  return `<div class="chat-rx${mine ? ' mine' : ''}" ${chatRxAttrs(kind, id, clientId)}>${chatRxInner(kind, id, clientId)}</div>`;
}
function chatRxRow(kind, r){
  return kind === 'staff' ? { who: r.user_id, kind: 'staff', emoji: r.emoji } : { who: r.reactor_id, kind: r.reactor_kind, emoji: r.emoji };
}
function chatRxAdd(kind, r){
  const x = chatRxRow(kind, r);
  const list = chatRx[kind].get(r.message_id) || [];
  if(!list.some(y => y.who === x.who && y.emoji === x.emoji)) list.push(x);
  chatRx[kind].set(r.message_id, list);
}
function chatRxRemove(kind, r){
  const x = chatRxRow(kind, r);
  chatRx[kind].set(r.message_id, (chatRx[kind].get(r.message_id) || []).filter(y => !(y.who === x.who && y.emoji === x.emoji)));
}
function chatRxName(r, clientId){
  if(r.who === myUserId) return 'You';
  if(r.kind === 'client') return clientId ? chatClientThreadName(clientId) : 'Client';
  return chatContactName(r.who) || 'Someone';
}
function chatRxInner(kind, id, clientId){
  const groups = new Map();
  (chatRx[kind].get(id) || []).forEach(r => { if(!groups.has(r.emoji)) groups.set(r.emoji, []); groups.get(r.emoji).push(r); });
  return [...groups.entries()].map(([emoji, rs]) => {
    const me = rs.some(r => r.who === myUserId);
    return `<button type="button" class="chat-rx-chip${me ? ' me' : ''}" data-emoji="${escapeHtml(emoji)}" title="${escapeHtml(rs.map(r => chatRxName(r, clientId)).join(', '))}">${escapeHtml(emoji)}<span>${rs.length}</span></button>`;
  }).join('');
}
function chatRxPaint(kind, id){
  document.querySelectorAll(`.chat-rx[data-rx-kind="${kind}"][data-rx-id="${CSS.escape(id)}"]`).forEach(el => {
    el.innerHTML = chatRxInner(kind, id, el.dataset.rxClient || null);
  });
}
async function chatRxFlush(){
  chatRxTimer = null;
  for(const kind of ['staff', 'client']){
    const ids = [...chatRxQueue[kind]];
    chatRxQueue[kind].clear();
    if(!ids.length) continue;
    ids.forEach(id => chatRxFetched[kind].add(id));
    const cols = kind === 'staff' ? 'message_id, user_id, emoji' : 'message_id, reactor_id, reactor_kind, emoji';
    const { data, error } = await selectInChunks(CHAT_RX_TABLE[kind], cols, 'message_id', ids);
    if(error){ ids.forEach(id => chatRxFetched[kind].delete(id)); console.warn('[chat] reactions load failed', error); continue; }
    ids.forEach(id => chatRx[kind].delete(id));
    data.forEach(r => chatRxAdd(kind, r));
    ids.forEach(id => chatRxPaint(kind, id));
  }
}
async function chatRxToggle(kind, id, clientId, emoji){
  if(!myUserId || !id) return;
  const has = (chatRx[kind].get(id) || []).some(r => r.who === myUserId && r.emoji === emoji);
  const row = kind === 'staff'
    ? { message_id: id, user_id: myUserId, emoji }
    : { message_id: id, client_id: clientId, reactor_id: myUserId, reactor_kind: 'staff', emoji };
  if(has) chatRxRemove(kind, row); else chatRxAdd(kind, row);
  chatRxPaint(kind, id);
  const whoCol = kind === 'staff' ? 'user_id' : 'reactor_id';
  const res = has
    ? await sb.from(CHAT_RX_TABLE[kind]).delete().eq('message_id', id).eq(whoCol, myUserId).eq('emoji', emoji)
    : await sb.from(CHAT_RX_TABLE[kind]).insert(row);
  if(res.error && res.error.code !== '23505'){
    if(has) chatRxAdd(kind, row); else chatRxRemove(kind, row);
    chatRxPaint(kind, id);
    alert('Could not save the reaction: ' + res.error.message);
  }
}
let chatRxPickerFor = null;
function chatRxOpenPicker(btn){
  let p = document.getElementById('chatRxPicker');
  if(!p){
    p = document.createElement('div');
    p.id = 'chatRxPicker';
    p.className = 'chat-rx-picker';
    p.hidden = true;
    p.innerHTML = CHAT_RX_EMOJIS.map(e => `<button type="button" data-emoji="${e}" title="${e}">${e}</button>`).join('');
    document.body.appendChild(p);
  }
  chatRxPickerFor = { kind: btn.dataset.rxKind, id: btn.dataset.rxId, clientId: btn.dataset.rxClient || null };
  p.hidden = false;
  const r = btn.getBoundingClientRect();
  const w = p.offsetWidth, h = p.offsetHeight;
  p.style.left = Math.max(8, Math.min(window.innerWidth - w - 8, r.left + r.width / 2 - w / 2)) + 'px';
  p.style.top = (r.top - h - 6 < 8 ? r.bottom + 6 : r.top - h - 6) + 'px';
}
function chatRxClosePicker(){
  const p = document.getElementById('chatRxPicker');
  if(p && !p.hidden) p.hidden = true;
  chatRxPickerFor = null;
}
document.addEventListener('click', (e) => {
  const pick = e.target.closest('#chatRxPicker button[data-emoji]');
  if(pick){
    e.stopPropagation();
    const f = chatRxPickerFor;
    chatRxClosePicker();
    if(f) chatRxToggle(f.kind, f.id, f.clientId, pick.dataset.emoji);
    return;
  }
  const add = e.target.closest('.chat-rx-add');
  if(add){ e.stopPropagation(); chatRxOpenPicker(add); return; }
  const chip = e.target.closest('.chat-rx-chip');
  if(chip){
    e.stopPropagation();
    const box = chip.closest('.chat-rx');
    chatRxToggle(box.dataset.rxKind, box.dataset.rxId, box.dataset.rxClient || null, chip.dataset.emoji);
    return;
  }
  chatRxClosePicker();
}, true);
document.addEventListener('keydown', (e) => {
  if(e.key === 'Escape') chatRxClosePicker();
  else if((e.key === 'Enter' || e.key === ' ') && e.target && e.target.classList && e.target.classList.contains('chat-rx-add')){ e.preventDefault(); chatRxOpenPicker(e.target); }
});
document.addEventListener('scroll', chatRxClosePicker, true);
// Its own channel, so a problem here can never take the chat channel down.
let chatRxChannel = null;
function subscribeChatReactions(){
  if(chatRxChannel || !sb) return;
  const ch = sb.channel('chat-reactions');
  chatRxChannel = ch;
  const handle = (kind) => (payload) => {
    const r = payload.eventType === 'DELETE' ? payload.old : payload.new;
    if(!r || !r.message_id || !chatRxFetched[kind].has(r.message_id)) return;   // not drawn yet: fetched when it is
    if(payload.eventType === 'DELETE') chatRxRemove(kind, r); else chatRxAdd(kind, r);
    chatRxPaint(kind, r.message_id);
  };
  ch.on('postgres_changes', { event: '*', schema: 'public', table: 'chat_message_reactions' }, handle('staff'))
    .on('postgres_changes', { event: '*', schema: 'public', table: 'client_chat_message_reactions' }, handle('client'))
    .subscribe((status) => {
      if(ch !== chatRxChannel) return;
      if(status === 'CHANNEL_ERROR' || status === 'TIMED_OUT'){
        chatRxChannel = null;
        try{ sb.removeChannel(ch); }catch(err){ /* already gone */ }
        setTimeout(subscribeChatReactions, 5000);
      }
    });
}

function renderChatThread(){
  const conv = chatConversations[chatActiveConv] || { messages: [] };
  const box = $('chatMessages');
  const wasAtBottom = chatAtBottom(box); // v632: read BEFORE innerHTML is replaced
  // v626: showSenderLabel is gone. It gated the old below-the-bubble name to
  // team/group threads only; the header above the bubble now shows on every
  // incoming non-sequential message including DMs, so there is nothing left
  // for it to decide. Deleted rather than left assigned-and-unread.
  const isDm = chatActiveConv !== 'team' && !chatActiveConv.startsWith('group:');
  const teamChatTz = nonAgentDisplayTz();
  let prevSender = null;
  chatSwapHtml(box, visibleChatThreadMessages(chatActiveConv, conv.messages).map(m => {
    const mine = m.sender_id === myUserId;
    // v626: the name moved above the bubble, with a Staff badge beside it.
    //
    // SHOWN IN DMs TOO, which the old senderLabel deliberately was not.
    // The reference shows a header on every non-sequential incoming
    // message regardless of thread type, and here it earns its place: a
    // colleague's message and a client's message now look different at a
    // glance in a panel that carries both. Sequential collapsing is what
    // keeps that from becoming repetitive in a fast back-and-forth.
    const senderLabel = '';
    const atMs = new Date(m.created_at).getTime();
    const isSeq = chatIsSequential(prevSender, m.sender_id, atMs);
    prevSender = { key: m.sender_id, at: atMs };
    const headHtml = (!mine && !isSeq)
      ? chatMsgHeadHtml(chatContactName(m.sender_id), 'staff', chatContactRole(m.sender_id)) // v639
      : '';
    const time = new Date(m.created_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(teamChatTz ? { timeZone: teamChatTz } : {}) });
    if(chatEditingMessageId === m.id){
      return `
        <div class="chat-msg-row ${mine ? 'mine' : 'theirs'}">
          <div class="chat-msg-meta">${senderLabel}${time}</div>
          <div class="chat-msg-edit-wrap">
            <textarea class="chat-msg-edit-input" data-msg-id="${m.id}">${escapeHtml(m.body || '')}</textarea>
            <div class="chat-msg-edit-actions">
              <button type="button" class="chat-msg-edit-save-btn" data-msg-id="${m.id}">Save</button>
              <button type="button" class="chat-msg-edit-cancel-btn">Cancel</button>
            </div>
          </div>
        </div>`;
    }
    const editedLabel = m.edited_at ? ' <span class="chat-edited-label">(edited)</span>' : '';
    const editBtnHtml = mine && m.body && chatMessageEditable(m)
      ? `<span class="chat-msg-edit-btn" data-msg-id="${m.id}" title="Edit message">&#9998;</span>`
      : '';
    const bodyHtml = m.body ? `<div class="chat-msg-bubble">${chatLinkify(chatHighlightMentions(escapeHtml(m.body)))}</div>` : '';
    const attachmentHtml = m.attachment_path
      ? `<div class="chat-msg-attachment" data-attachment-path="${escapeHtml(m.attachment_path)}" data-attachment-mime="${escapeHtml(m.attachment_mime || '')}" data-attachment-name="${escapeHtml(m.attachment_name || 'file')}">Loading attachment…</div>`
      : '';
    const ticksHtml = mine ? (isDm ? chatTicksHtml(chatDmTickState(m, chatActiveConv)) : chatSeenByHtml(m, chatActiveConv)) : '';
    return `
      <div class="chat-msg-row ${mine ? 'mine' : 'theirs with-av'} from-staff${isSeq ? ' seq' : ''}">
        ${(!mine && !isSeq) ? chatMsgAvatarHtml((AI_ASSISTANT_BOT_ID && m.sender_id === AI_ASSISTANT_BOT_ID) ? 'ai' : 'staff', m.sender_id, chatContactName(m.sender_id)) : ''}
        ${headHtml}
        ${bodyHtml}
        ${attachmentHtml}
        <div class="chat-msg-meta">${senderLabel}${time}${editedLabel}${editBtnHtml}${myIsOwner ? `<span class="chat-msg-del-btn" data-msg-id="${m.id}" title="Delete for everyone (owner only)">&#128465;</span>` : ''}${ticksHtml ? ' ' + ticksHtml : ''}${chatRxAddHtml('staff', m.id, null)}</div>
        ${chatRxHtml('staff', m.id, null, mine)}
      </div>
    `;
  }).join('') || '<div class="empty" style="padding:16px 0;">No messages yet — say hello!</div>');
  if(chatOfflineHint && chatOfflineHint.key === chatActiveConv){
    const h = chatOfflineHint, nm = escapeHtml(h.name);
    const line = h.status === 'dnd' ? `⛔ ${nm} has Do not disturb on — they'll see this, just without a sound or pop-up.`
      : h.status === 'busy' ? `🟠 ${nm} is busy — they may take a while to reply.`
      : h.status === 'brb' ? `🕒 ${nm} will be right back.`
      : `📴 ${nm} is offline — they'll see this when they're back.`;
    const hs = chatPersonStatusMsg(h.key);
    box.insertAdjacentHTML('beforeend', `<div class="chat-offline-hint">${line}${hs ? ' Their status: ' + escapeHtml(((hs.emoji ? hs.emoji + ' ' : '') + (hs.text || '')).trim()) : ''}</div>`);   // v704: += would rebuild every node
  }
  if(chatIsPeerTyping(chatActiveConv)) box.insertAdjacentHTML('beforeend', chatTypingBubbleHtml());   // v704
  // v726: the owner's rule -- Communication keeps 10 days (the hourly cron
  // clear-communication-chat-10d deletes anything older). Said up front.
  if(chatActiveConv === 'team') box.insertAdjacentHTML('afterbegin', '<div class="chat-offline-hint" style="margin:0 0 8px;">\u{1F4E3} Announcements here clear automatically after 10 days.</div>');
  // v632: see chatAtBottom().
  if(wasAtBottom) chatPinToBottom(box);
  Promise.resolve(chatResolveVisibleAttachments(box))
    .then(() => chatKeepPinned(box, wasAtBottom));
  chatWireEditControls(box);
}

// v314: wired fresh after every render rather than one delegated listener
// — same convention chatResolveVisibleAttachments already uses for this
// same container.
function chatWireEditControls(box){
  box.querySelectorAll('.chat-msg-del-btn').forEach(el => {   // v726
    el.addEventListener('click', () => chatDeleteMessage(el.dataset.msgId));
  });
  box.querySelectorAll('.chat-msg-edit-btn').forEach(el => {
    el.addEventListener('click', () => { chatEditingMessageId = el.dataset.msgId; renderChatThread(); });
  });
  const input = box.querySelector('.chat-msg-edit-input');
  if(input){
    input.focus();
    input.setSelectionRange(input.value.length, input.value.length);
    input.addEventListener('keydown', (e) => {
      if(e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); chatSaveEditedMessage(input.dataset.msgId, input.value); }
      else if(e.key === 'Escape'){ chatEditingMessageId = null; renderChatThread(); }
    });
  }
  const saveBtn = box.querySelector('.chat-msg-edit-save-btn');
  if(saveBtn) saveBtn.addEventListener('click', () => chatSaveEditedMessage(saveBtn.dataset.msgId, input ? input.value : ''));
  const cancelBtn = box.querySelector('.chat-msg-edit-cancel-btn');
  if(cancelBtn) cancelBtn.addEventListener('click', () => { chatEditingMessageId = null; renderChatThread(); });
}

// v726 (the owner: "how can I delete messages in staff to staff chat --
// please enable it for owner only"). Owner only, in every staff thread
// (Communication, DMs, groups) and in Audit Log > Chat Logs. The database
// agrees: the chat_messages delete policy is is_owner() alone
// (supabase/v726-...sql), so nobody else gets a button or could use one.
// Deletes the attachment file too, and every open portal drops the message
// over realtime (the DELETE handler in subscribeChatRealtime).
async function chatDeleteMessage(id){
  if(!myIsOwner || !id) return false;
  if(!confirm('Delete this message for everyone? This cannot be undone.')) return false;
  const { data, error } = await sb.from('chat_messages').delete().eq('id', id).select('id, attachment_path');
  if(error){ alert(error.message); return false; }
  if(!data || !data.length){ alert('That message could not be deleted -- it may already be gone.'); return false; }
  const path = data[0].attachment_path;
  if(path){
    sb.storage.from('chat-attachments').remove([path])
      .then(({ error: e }) => { if(e) console.warn('chat attachment not removed:', e.message); });
  }
  chatRemoveMessageFromState(id);
  logActivity('chat.message_delete', 'chat_message', id, 'Deleted a staff chat message');
  return true;
}
// Takes a deleted message out of whichever staff conversation holds it, and
// recounts that conversation's unread the same way chatAddMessageToState does.
function chatRemoveMessageFromState(id){
  let touched = null;
  Object.entries(chatConversations).forEach(([key, conv]) => {
    if(touched || key.startsWith('client:') || key.startsWith('sms:')) return;
    const idx = conv.messages.findIndex(x => x.id === id);
    if(idx === -1) return;
    conv.messages.splice(idx, 1);
    const lastReadMs = chatLastRead[key] ? new Date(chatLastRead[key]).getTime() : 0;
    conv.unread = conv.messages.filter(x => x.sender_id !== myUserId && new Date(x.created_at).getTime() > lastReadMs).length;
    touched = key;
  });
  if(!touched) return;
  updateChatUnreadBadge();
  if(chatActiveConv === touched && $('chatPanel').style.display !== 'none') renderChatThread();
  else if(!chatActiveConv) renderChatConvList($('chatSearchInput').value);
}

async function chatSaveEditedMessage(id, newBody){
  const body = (newBody || '').trim();
  if(!body){ alert("Message can't be empty."); return; }
  const nowIso = new Date().toISOString();
  const { data, error } = await sb.from('chat_messages')
    .update({ body, edited_at: nowIso })
    .eq('id', id)
    .select()
    .single();
  chatEditingMessageId = null;
  if(error){
    alert('Failed to save edit — edits are only allowed within 15 minutes of sending. (' + error.message + ')');
    renderChatThread();
    return;
  }
  const key = chatConvKeyForMessage(data);
  const conv = chatConversations[key];
  if(conv){
    const idx = conv.messages.findIndex(x => x.id === id);
    if(idx !== -1) conv.messages[idx] = data;
  }
  renderChatThread();
}

// v207: fetches the file and hands the browser a same-origin blob: URL to
// save, instead of just linking to it — a plain `<a href target=_blank>`
// (or even `<a download href>`) to a Supabase Storage signed URL just
// opens/streams it in a new tab, since browsers ignore the `download`
// attribute on cross-origin links as a security measure. This is the
// only reliable way to force an actual "save to disk" for these. Falls
// back to opening the URL in a new tab if the fetch itself fails (a
// network hiccup, or a bucket with stricter CORS) — worse than a real
// download, but still gets the person to the file rather than a dead
// click.
async function downloadFileToDisk(url, filename){
  try{
    const resp = await fetch(url);
    if(!resp.ok) throw new Error('HTTP ' + resp.status);
    const blob = await resp.blob();
    const blobUrl = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = blobUrl;
    a.download = filename || 'download';
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(blobUrl), 30000);
  }catch(e){
    console.error('Download failed, falling back to opening it directly:', e);
    window.open(url, '_blank', 'noopener');
  }
}

// Attachments render as a placeholder first, then get their real
// signed URL filled in — the bucket is private, so every download needs
// a fresh signed URL rather than a plain public path. Cached by path so
// re-rendering the same thread (e.g. after a new message arrives) doesn't
// re-request one for every attachment already resolved.
const chatAttachmentUrlCache = {};
async function chatResolveAttachmentUrl(path){
  if(chatAttachmentUrlCache[path]) return chatAttachmentUrlCache[path];
  const { data, error } = await sb.storage.from('chat-attachments').createSignedUrl(path, 3600);
  if(error){ console.error('Failed to sign chat attachment URL', error); return null; }
  chatAttachmentUrlCache[path] = data.signedUrl;
  return data.signedUrl;
}

// ---------------------------------------------------------------------------
// v632: "the chat scrolls up by itself after ~15 seconds".
//
// It was not scrolling up. It was being RE-RENDERED and then pinned to a
// height that had not finished growing yet.
//
// The sequence: a re-render replaces innerHTML, so every already-resolved
// image attachment reverts to the short "Loading attachment..." placeholder.
// `box.scrollTop = box.scrollHeight` then runs IMMEDIATELY, against that
// short height. The attachments resolve asynchronously afterwards (each one
// awaits a signed URL) and the images then load, and the content grows by
// however tall those images are -- with nothing re-scrolling. The view is
// left stranded that far above the bottom, which looks exactly like the
// thread scrolling up on its own.
//
// What re-renders while nobody is touching anything: the chat_reads realtime
// subscription re-renders the open thread on ANY read-receipt row changing,
// including other people's. Hence "wait about 15 seconds".
//
// Two things are wrong with the old one-liner and both are fixed here:
//
//   1. It pinned to the bottom UNCONDITIONALLY. Someone who had deliberately
//      scrolled up to read history got yanked back down by an unrelated
//      person's read receipt. Now the position is only restored if they were
//      already at the bottom when the re-render started.
//   2. It scrolled once, before the content had its final height. Now it
//      re-pins after attachments resolve AND after each image actually
//      loads, which is the point the height really settles.
function chatAtBottom(box, slack){
  if(!box) return true;
  return (box.scrollHeight - box.scrollTop - box.clientHeight) <= (slack === undefined ? 80 : slack);
}
function chatPinToBottom(box){ if(box) box.scrollTop = box.scrollHeight; }
// Re-pins as late-arriving content changes the height. Images are the ones
// that matter -- an <img> has zero height until it decodes, so the growth
// happens well after the markup is in the DOM.
function chatKeepPinned(box, wasAtBottom){
  if(!box || !wasAtBottom) return;
  chatPinToBottom(box);
  const imgs = box.querySelectorAll('img');
  imgs.forEach(img => {
    if(img.complete) return;
    img.addEventListener('load',  () => chatPinToBottom(box), { once: true });
    img.addEventListener('error', () => chatPinToBottom(box), { once: true });
  });
}

async function chatResolveVisibleAttachments(container){
  const els = Array.from((container || $('chatMessages')).querySelectorAll('.chat-msg-attachment:not([data-resolved="1"])'));   // v704
  for(const el of els){
    const path = el.dataset.attachmentPath;
    const mime = el.dataset.attachmentMime || '';
    const name = el.dataset.attachmentName || 'file';
    const url = await chatResolveAttachmentUrl(path);
    if(!url){ el.textContent = 'Attachment unavailable'; continue; }
    el.dataset.resolved = '1';   // v704: chatSwapHtml carries it across re-renders
    if(mime.startsWith('image/')){
      el.innerHTML = `<img src="${url}" alt="${escapeHtml(name)}">`;
      el.querySelector('img').addEventListener('click', () => openPhotoViewer(url, name));   // v716: pop-up viewer, not a new tab
    } else if(mime.startsWith('audio/')){
      el.className = 'chat-msg-attachment chat-msg-audio';
      // v205: controlsList="nodownload" hides the browser's own forced-
      // download button in the native player's "..." menu (it behaved
      // inconsistently across browsers). v207: the companion link now
      // actually downloads to disk (downloadFileToDisk()) instead of
      // just opening the file in a new tab — a plain link/`download`
      // attribute doesn't force a save for a cross-origin Storage URL.
      el.innerHTML = `<audio controls controlsList="nodownload noremoteplayback" src="${url}"></audio><a class="chat-msg-attachment-file chat-msg-download-link" href="${url}" rel="noopener" style="margin-top:4px;">Download \u2b07</a>`;
      el.querySelector('.chat-msg-download-link').addEventListener('click', (e) => { e.preventDefault(); downloadFileToDisk(url, name); });
    } else {
      el.innerHTML = `<a class="chat-msg-attachment-file chat-msg-download-link" href="${url}" rel="noopener">&#128206; ${escapeHtml(name)}</a>`;
      el.querySelector('.chat-msg-download-link').addEventListener('click', (e) => { e.preventDefault(); downloadFileToDisk(url, name); });
    }
  }
}

let chatPendingFile = null; // { file, previewUrl } — staged, not yet uploaded, until Send is clicked

function chatClearPendingFile(){
  if(chatPendingFile && chatPendingFile.previewUrl) URL.revokeObjectURL(chatPendingFile.previewUrl);
  chatPendingFile = null;
  $('chatAttachPreview').style.display = 'none';
  $('chatAttachPreview').innerHTML = '';
  $('chatFileInput').value = '';
}

// v636: three things this function did not do that the CLIENT portal's
// equivalent already did, found by reading the two side by side:
//
//   1. NOTHING TOLD THE PERSON A SEND HAD FAILED. All three failure paths
//      below -- attachment upload on a client thread, attachment upload on a
//      staff thread, and the message INSERT itself -- logged to the console,
//      handed the text back, and returned. From the sender's side that is
//      indistinguishable from never having pressed Send, so the worst case
//      is a message you believe you sent that was never sent. Same class as
//      the screen-share bug.
//   2. NO IN-FLIGHT GUARD. A second click while the first send was still
//      awaiting an upload sent the message twice.
//   3. THE SEND BUTTON WAS NEVER DISABLED, so there was no feedback that
//      anything was happening during a slow upload.
//
// chatSendFailed() keeps the existing "hand the text back" behaviour -- that
// part was right, losing someone's typing is worse than a silent failure --
// and adds the part that was missing.
let chatSendInFlight = false;
function chatSendFailed(input, body, what, err){
  console.error('[chat] ' + what, err);
  input.value = body; // never lose what they typed
  var detail = (err && (err.message || err.error_description)) || '';
  var NL = String.fromCharCode(10); // built, not escaped: a literal \n in this file has been mangled by a generator before
  alert(what + (detail ? NL + NL + detail : '') + NL + NL + 'Your message has been put back in the box.');
}
async function sendChatMessage(){
  const input = $('chatInput');
  const body = input.value.trim();
  const pendingFile = chatPendingFile;
  if((!body && !pendingFile) || !chatActiveConv) return;
  if(chatSendInFlight) return; // v636: no double-send on a second click
  chatSendInFlight = true;
  const sendBtn = $('chatSendBtn');
  if(sendBtn) sendBtn.disabled = true;
  try{
  await sendChatMessageInner(input, body, pendingFile);
  } finally {
    chatSendInFlight = false;
    if(sendBtn) sendBtn.disabled = false;
  }
}
async function sendChatMessageInner(input, body, pendingFile){
  if(chatActiveConv !== 'team' && !chatActiveConv.startsWith('group:')){
    clearTimeout(chatTypingStopTimer);
    chatTypingSend(chatActiveConv, 'stopped');
    chatLastTypingPingAt = 0;
  }
  // v195: Client Chats reuse this same input/send button (see
  // openClientChatThread()) but write to a completely different table —
  // branch off early rather than threading a client_id through every
  // branch below (mentions/AI-bot-forwarding don't apply to a client
  // conversation at all). Attachments/voice messages DO now apply here
  // too (v195) — uploaded to client-chat-attachments instead of
  // chat-attachments, everything else about staging/clearing is shared.
  if(chatActiveConv.startsWith('client:')){
    const clientId = chatActiveConv.slice(7);
    input.value = '';
    let clientAttachmentFields = null;
    if(pendingFile){
      const cleanName = pendingFile.file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
      const path = `${clientId}/${Date.now()}-${cleanName}`;
      const { error: uploadErr } = await sb.storage.from('client-chat-attachments').upload(path, pendingFile.file, {
        contentType: pendingFile.file.type || 'application/octet-stream',
      });
      if(uploadErr){
        chatSendFailed(input, body, "Couldn't upload that attachment.", uploadErr); // v636
        return;
      }
      clientAttachmentFields = {
        attachment_path: path,
        attachment_name: pendingFile.file.name,
        attachment_mime: pendingFile.file.type || 'application/octet-stream',
      };
      chatClearPendingFile();
    }
    await sendClientChatReply(clientId, body, clientAttachmentFields);
    return;
  }
  input.value = '';
  chatHideMentionBox();

  const isGroup = chatActiveConv.startsWith('group:');
  const payload = {
    sender_id: myUserId,
    recipient_id: (chatActiveConv === 'team' || isGroup) ? null : chatActiveConv,
    group_id: isGroup ? chatActiveConv.slice(6) : null,
    body,
  };

  if(pendingFile){
    const cleanName = pendingFile.file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
    const path = `${myUserId}/${Date.now()}-${cleanName}`;
    const { error: uploadErr } = await sb.storage.from('chat-attachments').upload(path, pendingFile.file, {
      contentType: pendingFile.file.type || 'application/octet-stream',
    });
    if(uploadErr){
      chatSendFailed(input, body, "Couldn't upload that attachment.", uploadErr); // v636
      return;
    }
    payload.attachment_path = path;
    payload.attachment_name = pendingFile.file.name;
    payload.attachment_mime = pendingFile.file.type || 'application/octet-stream';
    chatClearPendingFile();
  }

  const { data, error } = await sb.from('chat_messages').insert(payload).select().single();
  if(error){
    // v636: was console-only. A message that silently fails to send is the
    // worst outcome available here -- the sender believes it went.
    chatSendFailed(input, body, "Your message wasn't sent.", error);
    return;
  }
  // v125: a DM (not team/group, those have no single "the recipient") sent
  // to someone whose presence currently resolves to offline — let the
  // sender know right in the thread, with a distinct short tone, so they
  // don't wonder why there's been no reply. Doesn't affect the offline
  // person in any way (there's nothing running on their end to notify) —
  // this is purely a heads-up for whoever just sent the message.
  // v702: the same heads-up for Do not disturb, Busy and Be right back.
  const recipientSt = (!isGroup && chatActiveConv !== 'team') ? chatContactStatus(chatActiveConv) : null;
  if(['offline', 'dnd', 'busy', 'brb'].includes(recipientSt)){
    chatOfflineHint = { key: chatActiveConv, name: chatContactName(chatActiveConv), status: recipientSt };
    chatPlayOfflineHintSound();
  } else {
    chatOfflineHint = null;
  }
  // v127: real push, on top of the in-page hint above — reaches the
  // recipient even if their browser isn't running at all. DM only (not
  // team/group): pushing every non-active member on every team/group
  // message would be a lot of notifications for something that's often
  // not addressed to any one person in particular.
  if(!isGroup && chatActiveConv !== 'team'){
    notifyPushRecipients([chatActiveConv], {
      title: `${myFullName || 'A teammate'} sent you a message`,
      body: body || (pendingFile ? 'Sent a file' : 'New message'),
      tag: `chat-${myUserId < chatActiveConv ? myUserId + '_' + chatActiveConv : chatActiveConv + '_' + myUserId}`,
      url: '/' /* v636: was '/dashboard/dashboard.html', which 404s in production -- this portal is served from the ROOT and live/main has no dashboard/ directory at all. Worse than a dead link: sw.js focuses an already-open tab and then navigates it to this url, so clicking any push took a working signed-in portal and broke it. sw.js already defaults to '/' when no url is sent; this was overriding that. */,
    });
  }
  // Realtime will also deliver this back to us, but chatAddMessageToState
  // de-dupes by id, so rendering it immediately here (rather than waiting
  // on the round-trip) just makes sending feel instant.
  chatAddMessageToState(data, true);

  // If this DM was addressed to the AI Assistant bot, kick off the
  // Edge Function that classifies it and replies/routes. Deliberately
  // not awaited — the bot's reply arrives later via the normal Realtime
  // subscription, same as if a slow human were typing a response.
  if(AI_ASSISTANT_BOT_ID && payload.recipient_id === AI_ASSISTANT_BOT_ID){
    sb.functions.invoke('ai-chat-assistant', { body: { message_id: data.id } })
      .then(({ error: aiErr }) => { if(aiErr) console.error('ai-chat-assistant call failed', aiErr); })
      .catch((aiErr) => console.error('ai-chat-assistant call failed', aiErr));
  }
}

// v393d: client chat messages that arrived while this browser's realtime
// websocket was silently disconnected (tab backgrounded/throttled, laptop
// sleep, a network blip) never showed up on the dashboard — confirmed
// live: a client sent several follow-up messages over ~20 minutes and the
// already-open Client Chats conversation for them never updated past the
// last message the socket actually delivered, even though every message
// was correctly saved to client_chat_messages. Root cause: v211
// deliberately made loadClientChatOverview() fetch each client's message
// history exactly ONCE per session and rely entirely on the INSERT
// handler below for everything after that (a good fix for the race it
// was solving), but nothing ever re-syncs that history if the socket
// drops and misses inserts during the gap — Realtime does not replay
// missed events on reconnect. This does a targeted re-fetch (merging by
// id, not replacing) for every client conversation already on screen,
// called from the channel's own reconnect callback below.
async function resyncClientChatMessages(){
  const ids = Object.keys(chatConversations).filter(k => k.startsWith('client:')).map(k => k.slice(7));
  if(!ids.length) return;
  const { data: msgs, error } = await sb.rpc('client_chat_messages_recent', { p_client_ids: ids, p_per_client_limit: 100 });
  if(error){ console.error('resyncClientChatMessages failed', error); return; }
  ids.forEach(clientId => {
    const key = 'client:' + clientId;
    const conv = chatConversations[key];
    if(!conv) return;
    const existingIds = new Set(conv.messages.map(m => m.id));
    (msgs || []).filter(m => m.client_id === clientId && !existingIds.has(m.id)).forEach(m => conv.messages.push(m));
    conv.messages.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
  });
  if(chatActiveConv && chatActiveConv.startsWith('client:')) renderClientChatMessages(chatActiveConv.slice(7));
  renderChatConvList($('chatSearchInput').value);
  updateChatUnreadBadge();
}

function subscribeChatRealtime(){
  if(chatChannel) return;
  chatChannel = sb.channel('chat-messages')
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'chat_messages' }, (payload) => {
      const m = payload.new;
      // RLS already limits what this subscription receives to Communication,
      // this account's own DMs, and groups it belongs to, but double-check
      // here too — cheap, and avoids depending entirely on realtime's own
      // filtering.
      const isMine = m.sender_id === myUserId || m.recipient_id === myUserId;
      const isGroupImIn = m.group_id && chatGroups[m.group_id];
      if(m.recipient_id !== null && !isMine && !isGroupImIn) return;
      chatAddMessageToState(m, true);
    })
    .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'chat_messages' }, (payload) => {
      // v314: propagates an edit (or, in principle, any other future
      // UPDATE) live — same relevance check as the INSERT handler above.
      const m = payload.new;
      const isMine = m.sender_id === myUserId || m.recipient_id === myUserId;
      const isGroupImIn = m.group_id && chatGroups[m.group_id];
      if(m.recipient_id !== null && !isMine && !isGroupImIn) return;
      const key = chatConvKeyForMessage(m);
      const conv = chatConversations[key];
      if(conv){
        const idx = conv.messages.findIndex(x => x.id === m.id);
        if(idx !== -1) conv.messages[idx] = m;
      }
      if(chatActiveConv === key) renderChatThread();
    })
    // v726: an owner's delete, or the hourly Communication clear-out. A
    // DELETE event carries only the id -- enough to find and drop it.
    .on('postgres_changes', { event: 'DELETE', schema: 'public', table: 'chat_messages' }, (payload) => {
      const id = payload.old && payload.old.id;
      if(id) chatRemoveMessageFromState(id);
    })
    // v314: someone (me included, from another tab) marked a conversation
    // read — refresh so ticks/"seen by" reflect it live. No usable
    // postgres_changes filter for "conversations I'm in" (it only supports
    // plain equality), so this listens broadly and just re-renders the
    // currently-open thread, which is cheap and the only thing ticks are
    // visibly shown for anyway.
    .on('postgres_changes', { event: '*', schema: 'public', table: 'chat_reads' }, (payload) => {
      const row = (payload.new && payload.new.user_id) ? payload.new : payload.old;
      if(!row) return;
      chatReadsIndex[`${row.user_id}|${row.conversation_key}`] = payload.new ? payload.new.last_read_at : undefined;
      if(row.user_id === myUserId) chatLastRead[row.conversation_key] = payload.new ? payload.new.last_read_at : undefined;
      if(chatActiveConv && !chatActiveConv.startsWith('client:')) renderChatThread();
    })
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'chat_group_members', filter: `user_id=eq.${myUserId}` }, async () => {
      // Someone just added me to a (possibly brand-new) group — refresh the
      // group list so it shows up without needing a full page reload.
      await loadChatGroups();
      if(!chatActiveConv) renderChatConvList($('chatSearchInput').value);
    })
    .on('postgres_changes', { event: 'DELETE', schema: 'public', table: 'chat_groups' }, (payload) => {
      const deletedId = payload.old && payload.old.id;
      if(!deletedId || !chatGroups[deletedId]) return;
      delete chatGroups[deletedId];
      delete chatConversations['group:' + deletedId];
      if(chatActiveConv === 'group:' + deletedId){
        alert('This group was deleted.');
        $('chatThreadBackBtn').click();
      } else if(!chatActiveConv){
        renderChatConvList($('chatSearchInput').value);
      }
    })
    // v91: Client Chats. RLS on client_chat_messages already limits what
    // this delivers to threads assigned to me (or all, for Owner/Admin),
    // same "trust RLS, double-check anyway" posture as chat_messages
    // above — a message for a thread I can't currently see in
    // clientChatThreadsDirectory (e.g. it was JUST routed to me and the
    // thread-update event below hasn't been processed yet) gets a
    // best-effort refetch of the overview rather than being dropped.
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'client_chat_messages' }, async (payload) => {
      const m = payload.new;
      const key = 'client:' + m.client_id;
      const known = clientChatThreadsDirectory.some(t => t.client_id === m.client_id);
      if(!known){
        await loadClientChatOverview();
        if(!chatActiveConv) renderChatConvList($('chatSearchInput').value);
        ciRefresh();
        // v703: the first message from a thread this browser did not know yet
        // (a client who just connected, or a chat just handed to me) used to
        // be refreshed in silence -- and it is the one staff most need to hear.
        if(m.sender === 'client' && clientChatThreadsDirectory.some(t => t.client_id === m.client_id) && !ciIsViewing(key)) chatPlayNotificationSound();
        return;
      }
      if(!chatConversations[key]) chatConversations[key] = { key, messages: [], unread: 0 };
      if(chatConversations[key].messages.some(x => x.id === m.id)) return; // de-dupe against our own optimistic insert
      chatConversations[key].messages.push(m);
      // v314: a client message reaching this already-connected browser
      // counts as "delivered" — fire-and-forget, doesn't block rendering.
      if(m.sender === 'client'){
        sb.rpc('mark_client_chat_delivered', { p_client_id: m.client_id }).then(({ error }) => { if(error) console.error('mark_client_chat_delivered failed', error); });
      }
      const ciViewing = ciIsViewing(key);   // v701: open in the Client Inbox
      if(chatActiveConv === key || ciViewing){
        if(chatActiveConv === key) renderClientChatMessages(m.client_id);
        chatMarkRead(key);
        if(m.sender === 'client'){
          sb.rpc('mark_client_chat_read', { p_client_id: m.client_id }).then(({ error }) => { if(error) console.error('mark_client_chat_read failed', error); });
        }
      } else if(m.sender !== 'staff' && m.sender !== 'system'){   // v704: a transfer note is not the client
        chatConversations[key].unread++;
        chatPlayNotificationSound();
        renderChatConvList($('chatSearchInput').value);
      }
      ciRefresh();   // v701
    })
    // v314: propagates an edit, or the client marking one of our messages
    // delivered/read, live.
    .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'client_chat_messages' }, (payload) => {
      const m = payload.new;
      const key = 'client:' + m.client_id;
      const conv = chatConversations[key];
      if(conv){
        const idx = conv.messages.findIndex(x => x.id === m.id);
        if(idx !== -1) conv.messages[idx] = m;
      }
      if(chatActiveConv === key) renderClientChatMessages(m.client_id);
      ciRefresh();   // v701: ticks and edits
    })
    // A thread just got routed to me (or reassigned away from me) —
    // refresh the Client Chats list entirely rather than trying to patch
    // clientChatThreadsDirectory in place.
    // v207: debounced — a chat reopening (closed -> 'ai') and then
    // routing again moments later can fire this two or three times in
    // a couple hundred ms; collapsing them into one refresh means fewer
    // overlapping loadClientChatOverview() calls in flight at once
    // (the sequence guard inside it handles any that still overlap, but
    // fewer redundant calls is better for both correctness and load).
    .on('postgres_changes', { event: '*', schema: 'public', table: 'client_chat_threads' }, () => {
      clearTimeout(clientChatThreadsRefreshTimer);
      clientChatThreadsRefreshTimer = setTimeout(async () => {
        await loadClientChatOverview();
        if(!chatActiveConv) renderChatConvList($('chatSearchInput').value);
        else if(chatActiveConv.startsWith('client:')) openClientChatThread(chatActiveConv.slice(7));
        ciRefresh();   // v701
      }, 250);
    })
    // v393d: 'SUBSCRIBED' fires on the initial connect AND again on every
    // reconnect after a drop — the first firing is a no-op resync (there's
    // nothing loaded yet to be stale), but every firing after that means
    // the socket was down for some stretch and may have missed inserts
    // during it. See resyncClientChatMessages()'s own comment above.
    .subscribe((status, err) => {
      // v703: this channel was DEAD in production. One of its bindings
      // (chat_reads) named a table missing from the realtime publication,
      // and realtime refuses the whole channel for that -- and nothing here
      // noticed, because only 'SUBSCRIBED' was handled. Staff simply stopped
      // getting client messages and sounds until they refreshed. A failed or
      // timed-out join is now logged and retried with backoff, and whatever
      // arrived meanwhile is fetched on the retry.
      if(status === 'CHANNEL_ERROR' || status === 'TIMED_OUT'){
        console.error('Chat realtime channel ' + status + (err && err.message ? ': ' + err.message : ''));
        chatScheduleRealtimeRetry();
        return;
      }
      if(status !== 'SUBSCRIBED') return;
      chatRealtimeRetryDelay = 2000;
      if(chatChannelEverConnected) resyncClientChatMessages();
      chatChannelEverConnected = true;
    });
}
var chatRealtimeRetryTimer = null;
var chatRealtimeRetryDelay = 2000;
function chatScheduleRealtimeRetry(){
  if(chatRealtimeRetryTimer) return;
  const delay = chatRealtimeRetryDelay;
  chatRealtimeRetryDelay = Math.min(chatRealtimeRetryDelay * 2, 60000);
  chatRealtimeRetryTimer = setTimeout(() => {
    chatRealtimeRetryTimer = null;
    if(!chatChannel) return;   // signed out meanwhile
    const old = chatChannel;
    chatChannel = null;
    try{ sb.removeChannel(old); }catch(e){ /* already gone */ }
    subscribeChatRealtime();
    resyncClientChatMessages();
    loadClientChatOverview().then(() => { if(!chatActiveConv) renderChatConvList($('chatSearchInput').value); ciRefresh(); });
  }, delay);
}
// v393d: belt-and-suspenders alongside the reconnect callback above — a
// backgrounded/throttled tab can go quite a while without Realtime's own
// reconnect logic completing even after the tab is foregrounded again, so
// resync as soon as the tab becomes visible too rather than waiting on it.
//
// v396: resyncClientChatMessages() alone only re-fetches conversations
// ALREADY present in chatConversations (it iterates existing keys) — a
// client thread that got routed/created entirely while this tab was
// backgrounded (never loaded this session at all) has no key to resync,
// so it would sit invisible in the directory until the next
// client_chat_threads realtime event happened to fire on its own.
// loadClientChatOverview() is what actually re-derives the full thread
// list from scratch, so call it here too — it already has its own
// clientChatOverviewSeq guard against an in-flight/stale response
// clobbering a newer one, so calling it alongside resync is safe.
document.addEventListener('visibilitychange', () => {
  if(document.visibilityState === 'visible' && chatChannel){
    resyncClientChatMessages();
    loadClientChatOverview();
  }
});

// ================================================================ v701 ===
// CLIENT INBOX -- the staff side of client chat as a page, the way Telnyx,
// DealMachine and BatchLeads do it: conversations on the left, the chat in
// the middle, the client on the right.
//
// WHY. Client conversations lived inside the small floating chat, mixed in
// with colleagues: no way to see who had which, hand one on, find one, or see
// anything about the client while replying. The owner chose a full page with
// assign/transfer, quick replies and a client details panel.
//
// It is a VIEW over data the chat widget already keeps live --
// clientChatThreadsDirectory (which threads I may see: loadClientChatOverview)
// and chatConversations['client:<id>'] (messages, unread), both maintained by
// subscribeChatRealtime(), whose handlers now call ciRefresh(). Nothing is
// fetched twice. New server-side (supabase/v701-client-inbox.sql):
// client_chat_transfer(), client_chat_transfer_targets(),
// client_inbox_client_summary() and the client_chat_quick_replies table.
let ciInited = false;
let ciInitPromise = null;
let ciFilter = null;          // 'unassigned' | 'mine' | 'all' | 'closed'
let ciOpenClientId = null;
let ciQuickReplies = [];
let ciTargets = null;         // { staff:[{id,name,title}], teams:[{key,label}] }
const ciSummaryCache = {};    // clientId -> { at, data }
let ciPendingFile = null;
let ciTypingAt = 0;
let ciTypingStopTimer = null;
let ciQrEditingId = null;
let ciNewDirectory = [];

function ciIsAdmin(){ return myIsOwner || myRole === 'admin'; }
// The same people staff_can_handle_client_chat() lets take a chat.
function ciCanUseInbox(){
  if(!myUserId) return false;
  if(ciIsAdmin()) return true;
  const allowed = (myPermissions && myPermissions.allowedTabs) || [];
  if(allowed.includes('client_chat')) return true;
  return String(myRole || '').toLowerCase().replace(/[\s_-]+/g, '') === 'sales';
}
function ciTabActive(){
  const p = $('tab-client_chat');
  return !!(p && p.classList.contains('active'));
}
function ciIsViewing(key){
  return ciTabActive() && document.visibilityState === 'visible' && !!ciOpenClientId && key === 'client:' + ciOpenClientId;
}
function ciThread(clientId){ return clientChatThreadsDirectory.find(t => t.client_id === clientId) || null; }
function ciConv(clientId){ return chatConversations['client:' + clientId] || { messages: [], unread: 0 }; }
function ciLast(clientId){ const m = ciConv(clientId).messages; return m.length ? m[m.length - 1] : null; }
function ciUnclaimed(t){ return !!t && t.status === 'routed' && !t.assigned_staff_id; }
function ciStaffName(id){
  if(!id) return '';
  if(id === myUserId) return 'You';
  const s = ciTargets && (ciTargets.staff || []).find(x => x.id === id);
  return (s && s.name) || (typeof chatContactName === 'function' && chatContactName(id)) || 'a teammate';
}
function ciInFilter(t, f){
  if(f === 'unassigned') return ciUnclaimed(t);
  if(f === 'mine') return t.assigned_staff_id === myUserId && t.status !== 'closed';
  if(f === 'closed') return t.status === 'closed';
  return t.status !== 'closed';
}
function ciInitials(name){
  const p = String(name || '?').trim().split(/\s+/).filter(Boolean);
  if(!p.length) return '?';
  return ((p[0][0] || '?') + (p.length > 1 ? p[p.length - 1][0] : '')).toUpperCase();
}
const CI_AV_COLORS = ['#C9A66B', '#4EA8FF', '#B388FF', '#2DD4BF', '#F5A623', '#F28B82', '#3DD68C'];
function ciAvColor(id){
  let h = 0;
  for(const ch of String(id)) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
  return CI_AV_COLORS[h % CI_AV_COLORS.length];
}
function ciTzOpt(){ const tz = nonAgentDisplayTz(); return tz ? { timeZone: tz } : {}; }
function ciAgo(iso){
  if(!iso) return '';
  const d = new Date(iso);
  const s = (Date.now() - d.getTime()) / 1000;
  if(s < 60) return 'now';
  if(s < 3600) return Math.floor(s / 60) + 'm';
  if(s < 86400) return Math.floor(s / 3600) + 'h';
  if(s < 7 * 86400) return d.toLocaleDateString([], { weekday: 'short', ...ciTzOpt() });
  return d.toLocaleDateString([], { month: 'short', day: 'numeric', ...ciTzOpt() });
}
function ciDate(iso){
  return iso ? new Date(iso).toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric', ...ciTzOpt() }) : '—';
}
function ciPreview(m){
  if(!m) return '';
  const who = m.sender === 'staff' ? (m.staff_id === myUserId ? 'You: ' : ciStaffName(m.staff_id) + ': ')
    : (m.sender === 'ai' ? 'AI: ' : '');
  const body = m.body || (m.attachment_mime && m.attachment_mime.startsWith('audio/') ? '\u{1F3A4} Voice message'
    : (m.attachment_name ? '\u{1F4CE} ' + m.attachment_name : ''));
  return who + body;
}
function ciStatusLine(t){
  if(!t) return '';
  if(t.status === 'closed') return 'Closed';
  if(t.status === 'ai' || !t.status) return 'With the AI assistant';
  const team = t.queue_key ? ' · ' + chatQueueLabel(t.queue_key) : '';
  if(!t.assigned_staff_id) return 'Waiting to be accepted' + team;
  return (t.assigned_staff_id === myUserId ? 'Assigned to you' : 'Assigned to ' + ciStaffName(t.assigned_staff_id)) + team;
}

// ---- badges -------------------------------------------------------------
function ciUnreadTotal(){
  let n = 0;
  Object.entries(chatConversations).forEach(([k, c]) => { if(k.startsWith('client:')) n += c.unread || 0; });
  return n;
}
function ciSetNavBadge(n){
  const b = $('ciNavBadge');
  if(!b) return;
  b.textContent = n > 99 ? '99+' : String(n);
  b.style.display = n > 0 ? '' : 'none';
}
// The one row the floating chat keeps for clients: it goes to this page.
function ciChatLinkRowHtml(){
  if(!ciCanUseInbox()) return '';
  let waiting = 0;
  clientChatThreadsDirectory.forEach(t => { if(ciUnclaimed(t)) waiting++; });
  const unread = ciUnreadTotal();
  const sub = unread ? `${unread} unread from clients` : (waiting ? `${waiting} waiting to be accepted` : 'Client conversations are on their own page now');
  return `<div class="chat-conv-item ci-link-row" data-ci-link="1">
      <div class="chat-conv-avatar" style="width:32px; height:32px;">\u{1F4AC}</div>
      <div class="chat-conv-info"><div class="chat-conv-name">Client Inbox \u2192</div><div class="chat-conv-preview">${escapeHtml(sub)}</div></div>
      ${unread ? `<div class="chat-conv-badge">${unread > 99 ? '99+' : unread}</div>` : ''}
    </div>`;
}

// ---- lifecycle ----------------------------------------------------------
function ciInitTab(){
  if(!ciCanUseInbox()) return Promise.resolve();
  if(ciInitPromise) return ciInitPromise;
  ciInitPromise = (async () => {
    if(!ciInited){ ciInited = true; ciWire(); }
    if(!ciTargets) ciLoadTargets();
    ciLoadQuickReplies();
    await loadClientChatOverview();
    if(!ciFilter){
      ciFilter = clientChatThreadsDirectory.some(t => ciInFilter(t, 'unassigned')) ? 'unassigned'
        : (clientChatThreadsDirectory.some(t => ciInFilter(t, 'mine')) ? 'mine' : 'all');
    }
    ciRefresh();
  })().finally(() => { ciInitPromise = null; });
  return ciInitPromise;
}
async function ciLoadTargets(){
  const { data, error } = await sb.rpc('client_chat_transfer_targets');
  if(error){ console.error('client_chat_transfer_targets failed', error); return; }
  ciTargets = data || { staff: [], teams: [] };
  if(ciOpenClientId){ $('ciDetails').__sig = null; ciRenderDetails(); }
}
async function ciLoadQuickReplies(){
  const { data, error } = await sb.from('client_chat_quick_replies').select('id, title, body, sort').eq('kind', 'chat').order('sort').order('title');   // v717: not the dispute ones
  if(error){ console.error('quick replies load failed', error); return; }
  ciQuickReplies = data || [];
}
// Called by the chat realtime handlers on every client-chat change.
function ciRefresh(){
  ciSetNavBadge(ciUnreadTotal());
  if(!ciTabActive()) return;
  ciRenderList();
  if(ciOpenClientId){
    // Handed on or closed by someone else, and no longer mine to see:
    // close it rather than leave a dead conversation on screen.
    if(!ciThread(ciOpenClientId)){ ciClose(); return; }
    ciRenderHead();
    ciRenderMsgs(false);
    ciRenderDetails();
  }
}

// ---- the list -----------------------------------------------------------
function ciRenderList(){
  const q = ($('ciSearch').value || '').trim().toLowerCase();
  const counts = { unassigned: 0, mine: 0, all: 0, closed: 0 };
  clientChatThreadsDirectory.forEach(t => { Object.keys(counts).forEach(f => { if(ciInFilter(t, f)) counts[f]++; }); });
  document.querySelectorAll('#ciFilters .ci-filter').forEach(b => {
    const f = b.dataset.f;
    b.classList.toggle('active', f === ciFilter);
    b.querySelector('span').textContent = counts[f] ? String(counts[f]) : '';
    if(f === 'closed') b.style.display = ciIsAdmin() ? '' : 'none';
  });
  const rows = clientChatThreadsDirectory
    .filter(t => ciInFilter(t, ciFilter))
    .filter(t => !q || chatClientThreadName(t.client_id).toLowerCase().includes(q)
      || ciConv(t.client_id).messages.some(m => (m.body || '').toLowerCase().includes(q)))
    .map(t => ({ t, last: ciLast(t.client_id), unread: ciConv(t.client_id).unread || 0 }))
    .sort((a, b) => (b.last ? new Date(b.last.created_at).getTime() : 0) - (a.last ? new Date(a.last.created_at).getTime() : 0));
  const box = $('ciRows');
  if(!rows.length){
    const empty = { unassigned: 'Nobody is waiting. New requests from clients land here.', mine: 'Nothing assigned to you right now.',
      all: 'No open client conversations.', closed: 'No closed conversations.' };
    box.innerHTML = `<div class="ci-list-empty">${q ? 'No conversation matches that search.' : empty[ciFilter] || ''}</div>`;
    return;
  }
  box.innerHTML = rows.map(({ t, last, unread }) => {
    const name = t.full_name || 'Client';
    let tag = '';
    if(ciUnclaimed(t)) tag = `<span class="ci-tag wait">Waiting${t.queue_key ? ' · ' + escapeHtml(chatQueueLabel(t.queue_key)) : ''}</span>`;
    else if(t.status === 'ai' || !t.status) tag = '<span class="ci-tag ai">AI assistant</span>';
    else if(t.status === 'closed') tag = '<span class="ci-tag">Closed</span>';
    else if(t.assigned_staff_id === myUserId) tag = '<span class="ci-tag me">Yours</span>';
    else if(t.assigned_staff_id) tag = `<span class="ci-tag">${escapeHtml(ciStaffName(t.assigned_staff_id))}</span>`;
    const typing = chatIsPeerTyping('client:' + t.client_id);
    return `<div class="ci-row${t.client_id === ciOpenClientId ? ' active' : ''}${unread ? ' unread' : ''}" data-id="${escapeHtml(t.client_id)}">
        <div class="ci-av" style="background:${ciAvColor(t.client_id)}">${escapeHtml(ciInitials(name))}</div>
        <div class="ci-row-main">
          <div class="ci-row-top"><span class="ci-row-name">${escapeHtml(name)}</span><span class="ci-row-time">${escapeHtml(ciAgo(last && last.created_at))}</span></div>
          ${t.company_name ? `<div class="ci-row-co">${escapeHtml(t.company_name)}</div>` : ''}
          <div class="ci-row-bottom"><span class="ci-row-prev${typing ? ' typing' : ''}">${escapeHtml(typing ? 'typing\u2026' : (ciPreview(last) || 'No messages yet'))}</span>${unread ? `<span class="ci-unread">${unread > 99 ? '99+' : unread}</span>` : ''}</div>
          ${tag ? `<div class="ci-row-tags">${tag}</div>` : ''}
        </div>
      </div>`;
  }).join('');
}

// ---- one conversation ---------------------------------------------------
function ciOpen(clientId){
  const t = ciThread(clientId);
  if(!t) return;
  if(ciOpenClientId !== clientId){ ciClearAttachment(); $('ciDetails').__sig = null; }
  ciOpenClientId = clientId;
  chatOpenClientTypingChannel(clientId);
  $('ciEmpty').classList.add('ci-hide');
  $('ciThread').classList.remove('ci-hide');
  $('ciWrap').classList.add('show-thread');
  $('ciQrMenu').classList.add('ci-hide');
  const key = 'client:' + clientId;
  chatMarkRead(key);
  sb.rpc('mark_client_chat_read', { p_client_id: clientId }).then(({ error }) => { if(error) console.error('mark_client_chat_read failed', error); });
  ciRenderList(); ciRenderHead(); ciRenderMsgs(true); ciRenderDetails();
  ciSetNavBadge(ciUnreadTotal());
  renderChatConvList($('chatSearchInput') ? $('chatSearchInput').value : '');
  if(!ciUnclaimed(t)) $('ciInput').focus();
}
function ciClose(){
  ciOpenClientId = null;
  ciClearAttachment();
  $('ciThread').classList.add('ci-hide');
  $('ciEmpty').classList.remove('ci-hide');
  $('ciWrap').classList.remove('show-thread', 'show-details');
  $('ciDetails').innerHTML = '';
  $('ciDetails').__sig = null;
  ciRenderList();
}
// From a notification, the floating chat or anywhere else: go to this page
// and open that conversation (null = just the page).
async function ciOpenFromElsewhere(clientId){
  if(!ciCanUseInbox()) return;
  activateTab('client_chat');
  await ciInitTab();
  if(!clientId) return;
  if(!ciThread(clientId)) await loadClientChatOverview();
  const t = ciThread(clientId);
  if(!t){ alert("That conversation isn't available to you any more -- it may have been handed to someone else or closed."); return; }
  if(!ciInFilter(t, ciFilter)) ciFilter = ['unassigned', 'mine', 'all', 'closed'].find(f => ciInFilter(t, f)) || 'all';
  ciOpen(clientId);
}
function ciRenderHead(){
  const t = ciThread(ciOpenClientId);
  if(!t) return;
  $('ciThreadName').textContent = chatClientThreadName(t.client_id);
  $('ciThreadSub').textContent = ciStatusLine(t);
  const unclaimed = ciUnclaimed(t);
  $('ciClaimBar').classList.toggle('ci-hide', !unclaimed);
  $('ciClaimText').textContent = 'Waiting to be accepted' + (t.queue_key ? ' \u2014 ' + chatQueueLabel(t.queue_key) : '') + '. Accept it to reply.';
  $('ciComposer').classList.toggle('ci-hide', unclaimed);
  $('ciCallBtn').classList.toggle('ci-hide', !(myPermissions.canTextClients && !unclaimed));
}
function ciDayLabel(d){
  const key = (x) => x.toLocaleDateString('en-CA', ciTzOpt());
  const k = key(d);
  if(k === key(new Date())) return 'Today';
  if(k === key(new Date(Date.now() - 86400000))) return 'Yesterday';
  return d.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric', ...ciTzOpt() });
}
function ciRenderMsgs(forceBottom){
  const clientId = ciOpenClientId;
  if(!clientId) return;
  const box = $('ciMsgs');
  const msgs = ciConv(clientId).messages;
  const typing = chatIsPeerTyping('client:' + clientId);
  // Re-render only when something visible changed: a realtime tick for some
  // OTHER client must not rebuild this thread (and reload its images).
  const sig = clientId + '|' + typing + '|' + msgs.map(m => m.id + (m.read_at ? 'r' : m.delivered_at ? 'd' : '') + (m.edited_at || '')).join(',');
  if(!forceBottom && box.__sig === sig) return;
  box.__sig = sig;
  const wasAtBottom = forceBottom || chatAtBottom(box);
  const clientName = chatClientThreadName(clientId);
  let prev = null, lastDay = null;
  const html = msgs.map(m => {
    const d = new Date(m.created_at);
    const day = ciDayLabel(d);
    let sep = '';
    if(day !== lastDay){ sep = `<div class="ci-day"><span>${escapeHtml(day)}</span></div>`; prev = null; lastDay = day; }
    if(m.sender === 'system'){ prev = null; return `${sep}<div class="chat-system-note">${escapeHtml(m.body || '')}</div>`; }   // v704
    const mine = m.sender === 'staff';
    const role = m.sender === 'ai' ? 'ai' : (m.sender === 'client' ? 'client' : 'staff');
    const at = d.getTime();
    const senderKey = m.sender + ':' + (m.staff_id || '');
    const seq = chatIsSequential(prev, senderKey, at);
    prev = { key: senderKey, at };
    let head = '';
    if(!seq){
      if(!mine) head = chatMsgHeadHtml(role === 'ai' ? 'AI Assistant' : clientName, role, null);
      else if(m.staff_id && m.staff_id !== myUserId) head = `<div class="chat-msg-head"><span class="chat-msg-head-name">${escapeHtml(ciStaffName(m.staff_id))}</span></div>`;
    }
    const time = d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit', ...ciTzOpt() });
    const body = m.body ? `<div class="chat-msg-bubble">${chatLinkify(escapeHtml(m.body))}</div>` : '';
    const att = m.attachment_path
      ? `<div class="chat-msg-attachment" data-attachment-path="${escapeHtml(m.attachment_path)}" data-attachment-mime="${escapeHtml(m.attachment_mime || '')}" data-attachment-name="${escapeHtml(m.attachment_name || 'file')}">Loading attachment\u2026</div>`
      : '';
    const ticks = mine ? ' ' + chatTicksHtml(chatClientTickState(m)) : '';
    const edited = m.edited_at ? ' <span class="chat-edited-label">(edited)</span>' : '';
    return `${sep}<div class="chat-msg-row ${mine ? 'mine' : 'theirs with-av'} from-${role}${seq ? ' seq' : ''}">${(!mine && !seq) ? chatMsgAvatarHtml(role, clientId, clientName) : ''}${head}${body}${att}<div class="chat-msg-meta">${escapeHtml(time)}${edited}${ticks}${chatRxAddHtml('client', m.id, clientId)}</div>${chatRxHtml('client', m.id, clientId, mine)}</div>`;
  }).join('');
  chatSwapHtml(box, (html || '<div class="ci-list-empty">No messages yet. Say hello.</div>') + (typing ? chatTypingBubbleHtml() : ''));   // v704
  if(wasAtBottom) chatPinToBottom(box);
  Promise.resolve(clientChatResolveVisibleAttachments(box)).then(() => chatKeepPinned(box, wasAtBottom));
}

// ---- the client ---------------------------------------------------------
async function ciRenderDetails(){
  const clientId = ciOpenClientId;
  if(!clientId) return;
  const t = ciThread(clientId);
  if(!t) return;
  const box = $('ciDetails');
  const cached = ciSummaryCache[clientId];
  if(!cached || Date.now() - cached.at > 60000){
    if(!cached) box.innerHTML = '<div class="ci-list-empty">Loading\u2026</div>';
    const { data, error } = await sb.rpc('client_inbox_client_summary', { p_client_id: clientId });
    if(error) console.error('client_inbox_client_summary failed', error);
    ciSummaryCache[clientId] = { at: Date.now(), data: data || null };
    if(ciOpenClientId !== clientId) return;
  }
  const s = (ciSummaryCache[clientId] && ciSummaryCache[clientId].data) || {};
  // Rebuilding on every realtime tick would reset a half-chosen Transfer
  // menu; only rebuild when what it shows has changed.
  const sig = [clientId, t.status, t.assigned_staff_id, t.queue_key, ciSummaryCache[clientId].at, !!ciTargets].join('|');
  if(box.__sig === sig) return;
  box.__sig = sig;
  const a = s.account || {};
  const money = (c) => '$' + (Number(c || 0) / 100).toFixed(2);
  const camps = (s.campaigns || []).map(c => `<div class="ci-d-item"><div class="ci-d-item-name">${escapeHtml(c.name || 'Campaign')}</div>
      <div class="ci-d-item-sub"><span class="ci-tag ${c.status === 'active' ? 'me' : ''}">${escapeHtml(c.status || '\u2014')}</span>${c.complimentary ? ' <span class="ci-tag">Complimentary</span>' : ''}${c.unpaid ? ` <span class="ci-tag bad">Unpaid ${money(c.unpaid_cents)}</span>` : ''}${c.renews && c.status === 'active' ? ` renews ${escapeHtml(ciDate(c.renews))}` : ''}</div></div>`).join('')
    || '<div class="ci-d-none">No campaigns yet.</div>';
  const o = s.orders || {};
  const orders = o.count
    ? `${o.count} list order${o.count === 1 ? '' : 's'}` + (o.latest ? ` \u00b7 latest: ${escapeHtml(o.latest.type || 'order')} (${escapeHtml(o.latest.status || 'new')}), ${escapeHtml(ciDate(o.latest.created_at))}` : '')
    : 'No list orders.';
  const pays = (s.payments || []).map(p => `<div class="ci-d-item-sub">${escapeHtml(p.campaign || 'Campaign')} \u2014 ${escapeHtml(p.status || '\u2014')}${p.paid_at ? ', paid ' + escapeHtml(ciDate(p.paid_at)) : ''}</div>`).join('')
    || '<div class="ci-d-none">No payment requests.</div>';
  const canTransfer = ciIsAdmin() || t.assigned_staff_id === myUserId || ciUnclaimed(t);
  const staffOpts = ((ciTargets && ciTargets.staff) || []).filter(x => x.id !== t.assigned_staff_id)
    .map(x => `<option value="staff:${escapeHtml(x.id)}">${escapeHtml(x.id === myUserId ? 'Me (' + x.name + ')' : x.name)}${x.title ? ' \u2014 ' + escapeHtml(x.title) : ''}</option>`).join('');
  const teamOpts = ((ciTargets && ciTargets.teams) || [])
    .map(x => `<option value="team:${escapeHtml(x.key)}">${escapeHtml(x.label)}</option>`).join('');
  const canClose = t.status !== 'closed' && !ciUnclaimed(t) && (ciIsAdmin() || t.assigned_staff_id === myUserId);
  box.innerHTML = `
    <div class="ci-d-head">
      <div class="ci-av big" style="background:${ciAvColor(clientId)}">${escapeHtml(ciInitials(a.full_name || t.full_name))}</div>
      <div class="ci-d-name">${escapeHtml(a.full_name || t.full_name || 'Client')}</div>
      ${(a.company_name || t.company_name) ? `<div class="ci-d-co">${escapeHtml(a.company_name || t.company_name)}</div>` : ''}
      ${a.is_active === false ? '<div style="margin-top:6px;"><span class="ci-tag bad">Account disabled</span></div>' : ''}
    </div>
    <div class="ci-d-sec">
      ${a.email ? `<a class="ci-d-line" href="mailto:${escapeHtml(a.email)}">\u2709 ${escapeHtml(a.email)}</a>` : ''}
      ${a.phone ? `<a class="ci-d-line" href="tel:${escapeHtml(a.phone)}">\u260E ${escapeHtml(a.phone)}</a>` : ''}
      <div class="ci-d-line dim">Client since ${escapeHtml(ciDate(a.created_at))}${a.last_login_at ? ' \u00b7 last signed in ' + escapeHtml(ciDate(a.last_login_at)) : ''}</div>
    </div>
    <div class="ci-d-sec"><div class="ci-d-label">Campaigns</div>${camps}</div>
    <div class="ci-d-sec"><div class="ci-d-label">List orders</div><div class="ci-d-item-sub">${orders}</div></div>
    <div class="ci-d-sec"><div class="ci-d-label">Payments</div>${pays}</div>
    <div class="ci-d-sec">
      <div class="ci-d-label">Conversation</div>
      <div class="ci-d-item-sub">${escapeHtml(ciStatusLine(t))}</div>
      ${canTransfer ? `<div class="ci-transfer">
          <select id="ciTransferSel"><option value="">Transfer to\u2026</option>${staffOpts ? `<optgroup label="Teammates">${staffOpts}</optgroup>` : ''}${teamOpts ? `<optgroup label="Teams \u2014 first to accept gets it">${teamOpts}</optgroup>` : ''}</select>
          <button type="button" class="ci-btn" id="ciTransferBtn">Transfer</button>
        </div>
        <div class="ci-d-msg" id="ciTransferMsg"></div>` : ''}
      ${canClose ? '<button type="button" class="ci-btn danger" id="ciCloseBtn">Close conversation</button>' : ''}
    </div>`;
  const tb = $('ciTransferBtn');
  if(tb) tb.onclick = ciDoTransfer;
  const cb = $('ciCloseBtn');
  if(cb) cb.onclick = async () => {
    const done = await endClientChatThread(clientId);
    if(done){ delete ciSummaryCache[clientId]; ciClose(); ciRefresh(); }
  };
}
async function ciDoTransfer(){
  const clientId = ciOpenClientId;
  const sel = $('ciTransferSel');
  const msg = $('ciTransferMsg');
  if(!clientId || !sel) return;
  const v = sel.value;
  if(!v){ msg.textContent = 'Choose a teammate or a team.'; msg.className = 'ci-d-msg err'; return; }
  const kind = v.slice(0, v.indexOf(':'));
  const id = v.slice(v.indexOf(':') + 1);
  const label = sel.selectedOptions[0] ? sel.selectedOptions[0].textContent : '';
  $('ciTransferBtn').disabled = true;
  const { error } = await sb.rpc('client_chat_transfer', {
    p_client_id: clientId, p_staff_id: kind === 'staff' ? id : null, p_queue_key: kind === 'team' ? id : null,
  });
  if($('ciTransferBtn')) $('ciTransferBtn').disabled = false;
  if(error){ msg.textContent = error.message; msg.className = 'ci-d-msg err'; return; }
  logActivity('client_chat.transfer', 'client_chat_thread', clientId, `Transferred ${chatClientThreadName(clientId)} to ${label}`);
  msg.textContent = 'Transferred to ' + label + '.';
  msg.className = 'ci-d-msg ok';
  await loadClientChatOverview();
  if($('ciDetails')) $('ciDetails').__sig = null;
  ciRefresh();
}

// ---- composing ----------------------------------------------------------
function ciAutoGrow(){
  const i = $('ciInput');
  i.style.height = 'auto';
  i.style.height = Math.min(140, i.scrollHeight) + 'px';
}
function ciTypingPing(){
  if(!ciOpenClientId) return;
  const key = 'client:' + ciOpenClientId;
  clearTimeout(ciTypingStopTimer);
  if(!$('ciInput').value.trim()){ chatTypingSend(key, 'stopped'); ciTypingAt = 0; return; }
  if(Date.now() - ciTypingAt > 2000){ ciTypingAt = Date.now(); chatTypingSend(key, 'typing'); }
  ciTypingStopTimer = setTimeout(() => { chatTypingSend(key, 'stopped'); ciTypingAt = 0; }, 2500);
}
function ciSetAttachment(file){
  if(!file) return;
  if(file.size > 15 * 1024 * 1024){ alert('That file is too large \u2014 15MB max.'); return; }
  ciPendingFile = file;
  $('ciAttachName').textContent = '\u{1F4CE} ' + file.name;
  $('ciAttachPreview').classList.remove('ci-hide');
}
function ciClearAttachment(){
  ciPendingFile = null;
  if($('ciAttachPreview')) $('ciAttachPreview').classList.add('ci-hide');
}
async function ciSend(){
  const clientId = ciOpenClientId;
  if(!clientId) return;
  const input = $('ciInput');
  const btn = $('ciSendBtn');
  const body = input.value.trim();
  if((!body && !ciPendingFile) || btn.disabled) return;
  btn.disabled = true;
  clearTimeout(ciTypingStopTimer);
  chatTypingSend('client:' + clientId, 'stopped');
  ciTypingAt = 0;
  try{
    let fields = null;
    if(ciPendingFile){
      const f = ciPendingFile;
      const path = `${clientId}/${Date.now()}-${f.name.replace(/[^a-zA-Z0-9._-]/g, '_')}`;
      const { error: upErr } = await sb.storage.from('client-chat-attachments').upload(path, f, { contentType: f.type || 'application/octet-stream' });
      if(upErr){ console.error('inbox attachment upload failed', upErr); alert("Couldn't upload that attachment \u2014 try again."); return; }
      fields = { attachment_path: path, attachment_name: f.name, attachment_mime: f.type || 'application/octet-stream' };
    }
    input.value = '';
    ciAutoGrow();
    const sent = await sendClientChatReply(clientId, body, fields);
    if(!sent){ input.value = body; ciAutoGrow(); return; }
    ciClearAttachment();
    ciRenderMsgs(true);
    ciRenderList();
  } finally {
    btn.disabled = false;
  }
}

// ---- quick replies ------------------------------------------------------
function ciFillPlaceholders(text){
  const t = ciThread(ciOpenClientId) || {};
  const first = String(t.full_name || '').trim().split(/\s+/)[0] || 'there';
  return String(text)
    .replaceAll('{client_name}', first)
    .replaceAll('{company}', t.company_name || 'your company')
    .replaceAll('{my_name}', String(myFullName || '').trim().split(/\s+/)[0] || 'our team');
}
function ciRenderQrMenu(){
  const menu = $('ciQrMenu');
  const items = ciQuickReplies.map(q => `<button type="button" class="ci-qr-item" data-id="${escapeHtml(q.id)}"><span class="ci-qr-title">${escapeHtml(q.title)}</span><span class="ci-qr-body">${escapeHtml(q.body)}</span></button>`).join('');
  menu.innerHTML = (items || `<div class="ci-list-empty">No quick replies yet.${ciIsAdmin() ? '' : ' An owner or admin can add them.'}</div>`)
    + (ciIsAdmin() ? '<button type="button" class="ci-qr-manage" id="ciQrManageBtn">Manage quick replies\u2026</button>' : '');
  menu.querySelectorAll('.ci-qr-item').forEach(b => {
    b.onclick = () => {
      const q = ciQuickReplies.find(x => x.id === b.dataset.id);
      if(!q) return;
      const input = $('ciInput');
      const text = ciFillPlaceholders(q.body);
      const s = input.selectionStart ?? input.value.length;
      const e = input.selectionEnd ?? input.value.length;
      input.value = input.value.slice(0, s) + text + input.value.slice(e);
      menu.classList.add('ci-hide');
      input.focus();
      input.selectionStart = input.selectionEnd = s + text.length;
      ciAutoGrow();
    };
  });
  const mb = $('ciQrManageBtn');
  if(mb) mb.onclick = () => { menu.classList.add('ci-hide'); ciOpenQrModal(); };
}
// v717: one editor for both lists -- chat replies and Dispute/Feedback replies.
let ciQrKind = 'chat';
function ciQrList(){ return ciQrKind === 'dispute' ? disputeQuickReplies : ciQuickReplies; }
async function ciReloadQrKind(){ if(ciQrKind === 'dispute') await disputeLoadQuickReplies(); else await ciLoadQuickReplies(); }
function ciOpenQrModal(kind){
  ciQrKind = kind === 'dispute' ? 'dispute' : 'chat';
  const modal = $('ciQrModal');
  // v717: it lived inside the Client chat page, so it could not open anywhere else.
  if(modal.parentElement !== document.body) document.body.appendChild(modal);
  modal.querySelector('.ci-modal-head span').textContent = ciQrKind === 'dispute' ? 'Dispute & feedback replies' : 'Quick replies';
  modal.querySelector('.ci-modal-note').textContent = ciQrKind === 'dispute'
    ? 'Saved answers for dispute and feedback threads. Placeholders fill in when used: {client_name} (their first name), {company}, {seller} (the lead\u2019s seller), {my_name}.'
    : 'Saved answers for everyone who takes client chats. Placeholders fill in when used: {client_name} (their first name), {company}, {my_name}.';
  ciQrEditingId = null;
  $('ciQrTitle').value = ''; $('ciQrBody').value = ''; $('ciQrMsg').textContent = '';
  $('ciQrSave').textContent = 'Add reply';
  ciRenderQrManageList();
  $('ciQrModal').classList.remove('ci-hide');
}
function ciRenderQrManageList(){
  const box = $('ciQrManageList');
  box.innerHTML = ciQrList().length ? ciQrList().map(q => `<div class="ci-qr-manage-row">
      <div><b>${escapeHtml(q.title)}</b><span>${escapeHtml(q.body)}</span></div>
      <button type="button" class="ci-btn" data-edit="${escapeHtml(q.id)}">Edit</button>
      <button type="button" class="ci-btn" data-del="${escapeHtml(q.id)}" style="color:var(--danger);">Delete</button>
    </div>`).join('') : '<div class="ci-d-none">None yet \u2014 add the first one below.</div>';
  box.querySelectorAll('[data-edit]').forEach(b => {
    b.onclick = () => {
      const q = ciQrList().find(x => x.id === b.dataset.edit);
      if(!q) return;
      ciQrEditingId = q.id;
      $('ciQrTitle').value = q.title; $('ciQrBody').value = q.body;
      $('ciQrSave').textContent = 'Save changes';
      $('ciQrTitle').focus();
    };
  });
  box.querySelectorAll('[data-del]').forEach(b => {
    b.onclick = async () => {
      const q = ciQrList().find(x => x.id === b.dataset.del);
      if(!q || !confirm(`Delete the quick reply "${q.title}"?`)) return;
      const { error } = await sb.from('client_chat_quick_replies').delete().eq('id', q.id);
      if(error){ $('ciQrMsg').textContent = error.message; $('ciQrMsg').className = 'ci-d-msg err'; return; }
      await ciReloadQrKind();
      ciRenderQrManageList();
    };
  });
}
async function ciSaveQr(){
  const title = $('ciQrTitle').value.trim();
  const body = $('ciQrBody').value.trim();
  const msg = $('ciQrMsg');
  if(!title || !body){ msg.textContent = 'A title and the reply are both needed.'; msg.className = 'ci-d-msg err'; return; }
  $('ciQrSave').disabled = true;
  const res = ciQrEditingId
    ? await sb.from('client_chat_quick_replies').update({ title, body, updated_at: new Date().toISOString() }).eq('id', ciQrEditingId)
    : await sb.from('client_chat_quick_replies').insert({ title, body, sort: ciQrList().length, kind: ciQrKind });
  $('ciQrSave').disabled = false;
  if(res.error){ msg.textContent = res.error.message; msg.className = 'ci-d-msg err'; return; }
  msg.textContent = ciQrEditingId ? 'Saved.' : 'Added.';
  msg.className = 'ci-d-msg ok';
  ciQrEditingId = null;
  $('ciQrTitle').value = ''; $('ciQrBody').value = '';
  $('ciQrSave').textContent = 'Add reply';
  await ciReloadQrKind();
  ciRenderQrManageList();
}

// ---- starting a conversation (owner/admin, same rule as before) ---------
async function ciOpenNewModal(){
  $('ciNewSearch').value = '';
  $('ciNewMsg').textContent = '';
  $('ciNewList').innerHTML = '<div class="ci-list-empty">Loading\u2026</div>';
  $('ciNewModal').classList.remove('ci-hide');
  const { data, error } = await sb.from('client_accounts').select('id, full_name, company_name, email').eq('is_active', true).order('full_name');
  if(error){ $('ciNewList').innerHTML = `<div class="ci-list-empty">${escapeHtml(error.message)}</div>`; return; }
  ciNewDirectory = data || [];
  ciRenderNewList();
  $('ciNewSearch').focus();
}
function ciRenderNewList(){
  const q = $('ciNewSearch').value.trim().toLowerCase();
  const rows = ciNewDirectory.filter(c => !q || [c.full_name, c.company_name, c.email].some(v => String(v || '').toLowerCase().includes(q)));
  $('ciNewList').innerHTML = rows.length ? rows.map(c => `<div class="ci-new-row" data-id="${escapeHtml(c.id)}">
      <div class="ci-av" style="background:${ciAvColor(c.id)}">${escapeHtml(ciInitials(c.full_name || c.company_name))}</div>
      <div style="min-width:0;"><div class="ci-row-name">${escapeHtml(c.full_name || 'Client')}</div><div class="ci-row-co">${escapeHtml([c.company_name, c.email].filter(Boolean).join(' \u00b7 '))}</div></div>
    </div>`).join('') : '<div class="ci-list-empty">No client matches.</div>';
  $('ciNewList').querySelectorAll('.ci-new-row').forEach(r => { r.onclick = () => ciStartConversation(r.dataset.id); });
}
async function ciStartConversation(clientId){
  if(!ciThread(clientId)){
    const { error } = await sb.from('client_chat_threads').insert({ client_id: clientId, status: 'routed', assigned_staff_id: myUserId, queue_key: null });
    if(error){ $('ciNewMsg').textContent = error.message; $('ciNewMsg').className = 'ci-d-msg err'; return; }
    await loadClientChatOverview();
  }
  $('ciNewModal').classList.add('ci-hide');
  const t = ciThread(clientId);
  if(t && !ciInFilter(t, ciFilter)) ciFilter = ['mine', 'unassigned', 'all', 'closed'].find(f => ciInFilter(t, f)) || 'all';
  ciOpen(clientId);
}

// ---- wiring (once) ------------------------------------------------------
function ciWire(){
  $('ciSearch').addEventListener('input', ciRenderList);
  $('ciFilters').addEventListener('click', (e) => {
    const b = e.target.closest('.ci-filter');
    if(!b) return;
    ciFilter = b.dataset.f;
    ciRenderList();
  });
  $('ciRows').addEventListener('click', (e) => {
    const r = e.target.closest('.ci-row');
    if(r) ciOpen(r.dataset.id);
  });
  $('ciBackBtn').addEventListener('click', ciClose);
  $('ciDetailsBtn').addEventListener('click', () => $('ciWrap').classList.toggle('show-details'));
  $('ciCallBtn').addEventListener('click', () => { if(ciOpenClientId) startVoiceCallToClient(ciOpenClientId, chatClientThreadName(ciOpenClientId)); });
  $('ciClaimBtn').addEventListener('click', async () => {
    if(!ciOpenClientId) return;
    await acceptClientChatThread(ciOpenClientId);
    if($('ciDetails')) $('ciDetails').__sig = null;
    ciRefresh();
    if(ciOpenClientId && !ciUnclaimed(ciThread(ciOpenClientId))) $('ciInput').focus();
  });
  $('ciSendBtn').addEventListener('click', ciSend);
  $('ciInput').addEventListener('keydown', (e) => {
    if(e.key === 'Enter' && !e.shiftKey && !e.isComposing){ e.preventDefault(); ciSend(); }
  });
  $('ciInput').addEventListener('input', () => { ciAutoGrow(); ciTypingPing(); });
  $('ciInput').addEventListener('paste', (e) => {
    const items = e.clipboardData && e.clipboardData.items;
    if(!items) return;
    for(const item of items){
      if(item.kind !== 'file') continue;
      const file = item.getAsFile();
      if(!file) return;
      e.preventDefault();
      ciSetAttachment(file.name ? file : new File([file], `pasted-${Date.now()}.${(file.type.split('/')[1] || 'png')}`, { type: file.type }));
      return;
    }
  });
  $('ciAttachBtn').addEventListener('click', () => $('ciFile').click());
  $('ciFile').addEventListener('change', (e) => {
    const f = e.target.files && e.target.files[0];
    e.target.value = '';
    ciSetAttachment(f);
  });
  $('ciAttachRemove').addEventListener('click', ciClearAttachment);
  $('ciQrBtn').addEventListener('click', (e) => {
    e.stopPropagation();
    const m = $('ciQrMenu');
    if(m.classList.contains('ci-hide')){ ciRenderQrMenu(); m.classList.remove('ci-hide'); }
    else m.classList.add('ci-hide');
  });
  document.addEventListener('click', (e) => {
    if(!e.target.closest || !e.target.closest('.ci-qr-wrap')) $('ciQrMenu').classList.add('ci-hide');
  });
  $('ciQrModalClose').addEventListener('click', () => $('ciQrModal').classList.add('ci-hide'));
  $('ciQrClear').addEventListener('click', () => {
    ciQrEditingId = null; $('ciQrTitle').value = ''; $('ciQrBody').value = ''; $('ciQrMsg').textContent = '';
    $('ciQrSave').textContent = 'Add reply';
  });
  $('ciQrSave').addEventListener('click', ciSaveQr);
  $('ciNewBtn').classList.toggle('ci-hide', !ciIsAdmin());
  $('ciNewBtn').addEventListener('click', ciOpenNewModal);
  $('ciNewClose').addEventListener('click', () => $('ciNewModal').classList.add('ci-hide'));
  $('ciNewSearch').addEventListener('input', ciRenderNewList);
  [$('ciQrModal'), $('ciNewModal')].forEach(m => m.addEventListener('click', (e) => { if(e.target === m) m.classList.add('ci-hide'); }));
  document.addEventListener('keydown', (e) => {
    if(e.key !== 'Escape') return;
    $('ciQrMenu').classList.add('ci-hide');
    $('ciQrModal').classList.add('ci-hide');
    $('ciNewModal').classList.add('ci-hide');
  });
  // The relative times in the list ("5m") age while the page sits open.
  setInterval(() => { if(ciTabActive()) ciRenderList(); }, 60000);
}

// ---------- v62: native voice calls (WebRTC) ----------
// Two peers connect directly (peer-to-peer audio) using Supabase Realtime
// Broadcast purely to exchange the handshake (SDP offer/answer + ICE
// candidates) — nothing about the call's audio itself passes through
// Supabase. See schema.sql (v62 section) for the 2 inherent limitations
// (both sides need dashboard.html open; TURN is optional/admin-configured,
// NULL means STUN-only).
//
// voiceCallState holds everything about the CURRENT call (null when idle):
//   role            'caller' | 'callee'
//   peerId/peerName who's on the other end
//   pc              the RTCPeerConnection, once created
//   localStream     this browser's own mic MediaStream, once acquired
//   outboundChannel a Realtime channel scoped to the PEER's inbox, kept
//                   subscribed for this call's duration and reused for
//                   every message during it (offer/answer/ICE/hangup),
//                   rather than opening a new one per message.
//   callRowId       the voice_calls row id for this call (may be null if
//                   that insert failed — the call itself still proceeds;
//                   the log is best-effort, not load-bearing).
//   status          'ringing' | 'answered'
//   offerSdp        (callee only) the offer, held until Accept is clicked
//   ringTimeout / durationInterval  timer handles, cleared in endVoiceCall
//   videoSender     this browser's own RTCRtpSender for screen-share video,
//                   once created — every call starts audio-only, so this
//                   stays null until the first time THIS side shares its
//                   screen; reused (via replaceTrack) for any later
//                   share/stop toggles in the same call rather than
//                   recreated each time.
//   screenStream    this browser's own getDisplayMedia MediaStream while
//                   actively sharing its screen, else null
//   hasScreenShare  true while THIS side is sharing its screen
//   peerSharing     true while the OTHER side is sharing theirs (purely a
//                   UI flag — the actual video plays via ontrack/kind
//                   regardless of this)
//   videoPanelMinimized  true if the local admin has collapsed the
//                   call-video-panel preview via callMinimizeBtn. Purely a
//                   LOCAL display preference — never sent to the peer and
//                   never touches the actual MediaStreamTrack, so the real
//                   screen share keeps flowing to the other side the whole
//                   time; this only hides the floating black preview panel
//                   so the admin's own page underneath is fully visible
//                   again while still sharing.
//   videoPanelMaximized  v82, same local-only idea as videoPanelMinimized
//                   above but the other direction — expands
//                   call-video-panel to fill most of the viewport via
//                   callMaximizeBtn, for actually reading fine detail in
//                   whatever's being presented. Independent of minimized;
//                   never sent to the peer.
let voiceCallState = null;
let pendingMeetInvite = null; // { link, fromId, fromName } | null — separate from voiceCallState; no WebRTC involved in a Meet invite at all
let voiceMyChannel = null;   // permanent — subscribed once per session, receives calls FROM anyone
let webrtcTurnConfig = null; // { url, username, credential } | null — loaded once, refreshed on User Management save

// ---------- call sounds: ring, ringback, connect, hang-up ----------
// Generated with Web Audio oscillators rather than audio files, so
// there's nothing extra to bundle/host — this stays a single HTML file.
// Each sound is a short original chime sequence (an envelope-shaped tone
// per note, not a harsh on/off beep) rather than a single tone — aiming
// for the same *kind* of polish as a modern call app's sound design
// (distinct, pleasant, multi-note cues for ring / ringback / connect /
// hang-up), built from scratch rather than reproducing any specific
// app's actual proprietary sound.
//
// Browsers block audio with sound from playing before the page has seen
// ANY user interaction ("autoplay policy") — an incoming call is, by
// definition, not itself a click, so if this AudioContext were only
// created at ring-time it would frequently get silently blocked. Instead
// it's created once, on the very first click anywhere in the dashboard
// (near-certain to happen long before anyone calls this account), and
// reused for every sound after that — the standard workaround for this
// restriction. If it's still somehow unavailable when a call actually
// comes in, every sound below just silently no-ops — the visual banner
// still shows regardless, so a blocked sound degrades gracefully rather
// than breaking anything.
let voiceAudioCtx = null;
function voicePrimeAudioContext(){
  if(voiceAudioCtx) return;
  try{ voiceAudioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
  catch(e){ /* Web Audio unavailable — call sounds will just no-op */ }
}
document.addEventListener('click', voicePrimeAudioContext, { once: true });

// Plays one note as a short envelope (quick attack, gentle release)
// instead of an abrupt on/off — this alone is most of the difference
// between "pleasant chime" and "harsh beep". startOffset/duration are in
// seconds, scheduled relative to right now.
function voicePlayTone(freq, startOffset, duration, volume, waveType){
  if(!voiceAudioCtx) return;
  const t0 = voiceAudioCtx.currentTime + startOffset;
  const osc = voiceAudioCtx.createOscillator();
  osc.type = waveType || 'sine';
  osc.frequency.value = freq;
  const gain = voiceAudioCtx.createGain();
  gain.gain.setValueAtTime(0, t0);
  gain.gain.linearRampToValueAtTime(volume, t0 + 0.02);
  gain.gain.linearRampToValueAtTime(volume * 0.65, t0 + duration * 0.6);
  gain.gain.linearRampToValueAtTime(0, t0 + duration);
  osc.connect(gain);
  gain.connect(voiceAudioCtx.destination);
  osc.start(t0);
  osc.stop(t0 + duration + 0.02);
}
function voicePlaySequence(notes){
  if(!voiceAudioCtx) return;
  if(voiceAudioCtx.state === 'suspended') voiceAudioCtx.resume().catch(() => {});
  notes.forEach(n => voicePlayTone(n.freq, n.at, n.dur, n.vol, n.type));
}

// Note frequencies: C5=523.25 D5=587.33 E5=659.25 G5=783.99 B5=987.77
// A4=440.00 — simple major-scale intervals, chosen so ring/ringback are
// clearly different melodies (tell-apart-by-ear matters — you want to
// know instantly whether you're calling or being called) and
// connect/hang-up read as "up = good" / "down = over" respectively.
//
// Ring and ringback below are built as quick alternating square-wave
// blips rather than smooth sine notes — that nasal, chip-tune "doo-DIT"
// pattern is what reads as an MSN Messenger–style call alert. It's an
// original pattern in that spirit, not a reproduction of Microsoft's
// copyrighted audio.
const VOICE_CONNECT_NOTES  = [{ freq: 659.25, at: 0,    dur: 0.14, vol: 0.18 }, { freq: 987.77, at: 0.09, dur: 0.4, vol: 0.2 }];
const VOICE_HANGUP_NOTES   = [{ freq: 659.25, at: 0,    dur: 0.14, vol: 0.16 }, { freq: 440.00, at: 0.09, dur: 0.4, vol: 0.18 }];

// ---------- v628: call audio, matched to the design reference ----------
//
// The MSN-style square-wave blips (VOICE_RING_NOTES) and the two triangle
// notes (VOICE_RINGBACK_NOTES) are GONE, replaced by the reference's own
// synthesis, value for value:
//
//   incoming  -- a C-major arpeggio, C5 E5 G5 C6, each note 0.15s after the
//                last, every 2500ms. Warm and clearly "someone is calling
//                you", where the square wave read as a game console.
//   ringback  -- 440Hz + 480Hz sounded TOGETHER for 1.2s every 3500ms.
//                That pair is not arbitrary: it is the actual North
//                American telephone ringback cadence, which is why it
//                reads instantly as "the line is ringing at their end"
//                rather than as a notification.
//
// ENVELOPES ARE EXPONENTIAL, not the linear ramp voicePlayTone() uses.
// That is most of the difference in character -- a linear fade sounds
// synthetic, an exponential one sounds like something was struck. It is
// why these two sounds do not go through voicePlayTone().
//
// Still fully synthesized, no audio files: same reasoning as the original
// code, and the same reason nothing here reproduces anyone's copyrighted
// audio.
const VOICE_INCOMING_ARPEGGIO = [523.25, 659.25, 783.99, 1046.5]; // C5 E5 G5 C6
const VOICE_RINGBACK_PAIR = [440, 480];                            // US ringback

// v630: LOUDNESS IS OURS, THE MELODY IS THE REFERENCE'S.
//
// v628 copied the reference's absolute gain values along with its notes:
// a per-note gain of 0.1 into a master of 0.12, so a peak amplitude of
// 0.012. Measured on the live page, the ring topped out at 0.0135 -- about
// -37 dBFS, roughly TWELVE TIMES quieter than the MSN-style ring it
// replaced (per-note 0.15-0.17 straight to the destination). A blip that
// faint, once every 2.5 seconds, is inaudible on a laptop in a room with
// people in it. That is what "the ringing is not working" was: it was
// playing perfectly and nobody could hear it.
//
// Those levels are fine in a demo page and wrong for a call floor, so the
// numbers below restore the previous loudness while keeping everything
// that makes it the reference's sound -- the arpeggio, the 0.15s spacing,
// the exponential decay, the cadence.
//
// The master stays at 1 and the level lives in the note gain, so there is
// ONE number to change per sound rather than a product of two.
//
// Ringback is deliberately softer than the incoming ring: it plays in your
// own ear while you wait, where the incoming ring has to carry across a
// room. Its two oscillators sum, so the per-oscillator figure is about
// half the peak it actually reaches.
const VOICE_RING_NOTE_GAIN     = 0.16;  // peak ~0.16, matching the old ring
const VOICE_RINGBACK_OSC_GAIN  = 0.07;  // x2 oscillators -> peak ~0.14

let voiceRingInterval = null;
let voiceRingGain = null;

function voiceRingPlayIncoming(){
  const ctx = voiceAudioCtx;
  if(!ctx || !voiceRingGain) return;
  VOICE_INCOMING_ARPEGGIO.forEach((freq, idx) => {
    const at = ctx.currentTime + idx * 0.15;
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.frequency.value = freq;
    g.gain.setValueAtTime(VOICE_RING_NOTE_GAIN, at);
    g.gain.exponentialRampToValueAtTime(0.001, at + 0.35);
    osc.connect(g);
    g.connect(voiceRingGain);
    osc.start(at);
    osc.stop(at + 0.4);
  });
}

function voiceRingPlayRingback(){
  const ctx = voiceAudioCtx;
  if(!ctx || !voiceRingGain) return;
  // v630: each oscillator gets its own gain. They used to connect straight
  // to voiceRingGain, which carried the level -- now that the master is 1,
  // going direct would put two full-amplitude oscillators on the output and
  // clip hard. A short attack/release also removes the click that an
  // abruptly started and stopped oscillator makes at this amplitude.
  const oscs = VOICE_RINGBACK_PAIR.map(freq => {
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    const t0 = ctx.currentTime;
    osc.frequency.value = freq;
    g.gain.setValueAtTime(0, t0);
    g.gain.linearRampToValueAtTime(VOICE_RINGBACK_OSC_GAIN, t0 + 0.02);
    g.gain.setValueAtTime(VOICE_RINGBACK_OSC_GAIN, t0 + 1.16);
    g.gain.linearRampToValueAtTime(0, t0 + 1.2);
    osc.connect(g);
    g.connect(voiceRingGain);
    osc.start();
    return osc;
  });
  // 1.2s of tone, then silence until the next cycle -- the gap is what
  // makes it a ring rather than a drone.
  setTimeout(() => { oscs.forEach(o => { try{ o.stop(); }catch(e){} }); }, 1200);
}

// kind 'incoming': the arpeggio, for the person RECEIVING a call.
// kind 'ringback': the 440+480 pair, for the CALLER while waiting.
function voiceStartRingtone(kind){
  voiceStopRingtone();
  if(!voiceAudioCtx) voicePrimeAudioContext();
  if(!voiceAudioCtx) return;
  if(voiceAudioCtx.state === 'suspended') voiceAudioCtx.resume().catch(() => {});

  const incoming = kind === 'incoming';
  // One gain node per ringing session, torn down in voiceStopRingtone().
  // The reference does the same, and it is what makes "stop" instant: a
  // ringback oscillator is mid-1.2s-tone when someone answers, and
  // disconnecting the shared gain cuts it immediately rather than leaving
  // a tone hanging over the connect chime.
  voiceRingGain = voiceAudioCtx.createGain();
  // v630: master is 1 -- the level lives in the note/oscillator gains above
  // so there is one number per sound, not a product of two. This node now
  // exists purely so voiceStopRingtone() can cut everything at once.
  voiceRingGain.gain.value = 1;
  voiceRingGain.connect(voiceAudioCtx.destination);

  const playCycle = () => {
    if(!voiceAudioCtx || voiceAudioCtx.state === 'closed' || !voiceRingGain) return;
    if(incoming) voiceRingPlayIncoming(); else voiceRingPlayRingback();
  };
  playCycle();
  voiceRingInterval = setInterval(playCycle, incoming ? 2500 : 3500);
}
function voiceStopRingtone(){
  voiceIncomingAlertStop();   // v709: every path that stops the ring ends the alert too
  if(voiceRingInterval){ clearInterval(voiceRingInterval); voiceRingInterval = null; }
  if(voiceRingGain){
    try{ voiceRingGain.disconnect(); }catch(e){}
    voiceRingGain = null;
  }
}

// ---------- Google Meet: restricted to the company's own domain ----------
// Meet links get shared as plain, clickable URLs in chat — anyone signed
// in with an outside email (e.g. a contractor/external account on their
// own domain) can still open a link someone else pastes, but shouldn't be
// able to originate a Meet call themselves via the button. Checked at
// call time (not cached) since it's cheap and myEmail is already in
// memory from login.
function chatMeetAllowed(){
  return /@proptechnologyai\.com$/i.test(myEmail || '');
}

// ---------- Meet invite ringtone (Yahoo Messenger–style phone trill) ----------
// Yahoo Messenger's classic incoming-call alert was an actual telephone
// bell trill — two tones alternating rapidly in a short burst, then a
// pause, repeating — rather than a melodic chime. This is a separate,
// original sound built to evoke that *character* (not a reproduction of
// Yahoo's copyrighted audio file), kept distinct from the voice-call ring
// above so the two are tell-apart-by-ear: a Meet invite sounds like an
// old phone ringing, a voice call sounds like the chip-tune blip.
function meetPlayRingBurst(){
  if(!voiceAudioCtx) return;
  const toneA = 950, toneB = 1400;
  const noteDur = 0.045, gap = 0.045, trillCount = 10;
  for(let i = 0; i < trillCount; i++){
    voicePlayTone(i % 2 === 0 ? toneA : toneB, i * (noteDur + gap), noteDur, 0.13, 'square');
  }
}
let meetRingtoneInterval = null;
function meetStartRingtone(){
  meetStopRingtone();
  if(!voiceAudioCtx) voicePrimeAudioContext();
  if(!voiceAudioCtx) return;
  if(voiceAudioCtx.state === 'suspended') voiceAudioCtx.resume().catch(() => {});
  meetPlayRingBurst();
  meetRingtoneInterval = setInterval(meetPlayRingBurst, 1700);
}
function meetStopRingtone(){
  if(meetRingtoneInterval){ clearInterval(meetRingtoneInterval); meetRingtoneInterval = null; }
}
// One-shot cues — connect plays the instant a call actually connects
// (both sides, see voiceStartCallTimer); hang-up plays only when a call
// that was actually live disconnects (see endVoiceCall), not for a call
// that never got answered — that case just has the ringback stop, same
// as a real phone doesn't play a "hang up" sound for an unanswered call.
function voicePlayConnectSound(){
  if(!voiceAudioCtx) voicePrimeAudioContext();
  voicePlaySequence(VOICE_CONNECT_NOTES);
}
function voicePlayHangupSound(){
  if(!voiceAudioCtx) voicePrimeAudioContext();
  voicePlaySequence(VOICE_HANGUP_NOTES);
}

async function loadWebrtcTurnConfig(){
  const { data } = await sb.from('app_settings').select('key,value')
    .in('key', ['webrtc_turn_url', 'webrtc_turn_username', 'webrtc_turn_credential']);
  const byKey = {}; (data || []).forEach(r => { byKey[r.key] = r.value; });
  webrtcTurnConfig = { url: byKey.webrtc_turn_url || null, username: byKey.webrtc_turn_username || null, credential: byKey.webrtc_turn_credential || null };
}

// Returns an iceServers array for a fresh call. Prefers Cloudflare's
// auto-refreshing short-lived TURN credentials — via the
// cloudflare-turn-credentials Edge Function, which holds your Cloudflare
// TURN Token ID + API Token as server-side secrets and never exposes them
// to the browser (see that function's header comment for setup). If that
// function isn't deployed yet, or its secrets aren't set, it comes back
// with iceServers:null and this falls through to the static TURN server
// fields in Settings → Chat Settings (self-hosted coturn, or a provider
// that issues long-lived credentials) — same behavior as before Cloudflare
// support existed. Fetched fresh at the start of every call rather than
// cached, since Cloudflare's credentials expire.
async function voiceIceServers(){
  const servers = [{ urls: 'stun:stun.l.google.com:19302' }, { urls: 'stun:stun1.l.google.com:19302' }];
  try{
    const { data, error } = await sb.functions.invoke('cloudflare-turn-credentials', { body: {} });
    if(error){
      console.warn('[call] cloudflare-turn-credentials call failed, falling back:', error);
    } else if(data && data.ok && Array.isArray(data.iceServers) && data.iceServers.length){
      console.log('[call] got', data.iceServers.length, 'Cloudflare TURN ICE server entries');
      return servers.concat(data.iceServers);
    } else if(data && data.ok){
      console.log('[call] Cloudflare TURN not configured (no secrets set) — using STUN only unless a static TURN server is set in Settings');
    } else {
      console.warn('[call] cloudflare-turn-credentials returned an unexpected response:', data);
    }
  }catch(e){ console.warn('[call] cloudflare-turn-credentials threw, falling back:', e); }
  if(webrtcTurnConfig && webrtcTurnConfig.url){
    servers.push({ urls: webrtcTurnConfig.url, username: webrtcTurnConfig.username || undefined, credential: webrtcTurnConfig.credential || undefined });
  }
  return servers;
}

// Resolves once `channel` has actually joined — sending on a broadcast
// channel before it's subscribed isn't reliable, so every send path in
// this module goes through a channel that's been awaited via this first.
function voiceChannelReady(channel){
  return new Promise((resolve) => {
    channel.subscribe((status) => { if(status === 'SUBSCRIBED') resolve(); });
  });
}

function voiceSend(channel, payload){
  return channel.send({ type: 'broadcast', event: 'signal', payload: { ...payload, from: myUserId, fromName: myFullName || myEmail } });
}

// For a message that doesn't have (or doesn't need) an already-open
// outboundChannel — e.g. declining a call before ever accepting it. Opens
// a channel just long enough to deliver one message, then tears it down.
function voiceSendOneOff(toUserId, payload){
  const ch = sb.channel('call-signal-' + toUserId);
  voiceChannelReady(ch).then(() => voiceSend(ch, payload)).then(() => sb.removeChannel(ch));
}

function initVoiceCallSignaling(){
  if(!myUserId || voiceMyChannel) return;
  voiceMyChannel = sb.channel('call-signal-' + myUserId);
  // v709: this is the channel every incoming call arrives on, and a failed
  // or timed-out join used to leave it dead until a reload -- calls simply
  // stopped reaching this person. Same retry-with-backoff as the chat
  // channel (v703).
  voiceMyChannel.on('broadcast', { event: 'signal' }, ({ payload }) => handleVoiceSignal(payload)).subscribe((status) => {
    if(status === 'SUBSCRIBED') voiceSignalRetryDelay = 2000;
    else if(status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') voiceSignalRetry();
  });
  loadWebrtcTurnConfig();
}
var voiceSignalRetryTimer = null;
var voiceSignalRetryDelay = 2000;
function voiceSignalRetry(){
  if(voiceSignalRetryTimer || !voiceMyChannel) return;
  const delay = voiceSignalRetryDelay;
  voiceSignalRetryDelay = Math.min(voiceSignalRetryDelay * 2, 60000);
  voiceSignalRetryTimer = setTimeout(() => {
    voiceSignalRetryTimer = null;
    if(!voiceMyChannel) return;   // signed out meanwhile
    const old = voiceMyChannel;
    voiceMyChannel = null;
    try{ sb.removeChannel(old); }catch(e){ /* already gone */ }
    initVoiceCallSignaling();
  }, delay);
}
function voiceSignalCheck(){ if(voiceMyChannel && voiceMyChannel.state !== 'joined') voiceSignalRetry(); }
window.addEventListener('online', voiceSignalCheck);
document.addEventListener('visibilitychange', () => { if(document.visibilityState === 'visible') voiceSignalCheck(); });

// v709: an incoming call has to be NOTICED with this portal in a background
// tab. Staff calls to Mariam rang out unanswered -- she has no push
// subscription, and the ring and banner only show inside the tab. So, as
// the client portal has done since v697: a flashing tab title, and a desktop
// notification when notifications are allowed (tagged like the call's push,
// so the two replace each other rather than doubling up).
let voiceTitleTimer = null;
let voiceTitleOrig = null;
let voiceCallNotif = null;
function voiceIncomingAlertStart(name, callRowId){
  voiceIncomingAlertStop();
  voiceTitleOrig = document.title;
  let on = false;
  voiceTitleTimer = setInterval(() => {
    on = !on;
    document.title = on ? `📞 Incoming call — ${name}` : voiceTitleOrig;
  }, 1000);
  if(document.visibilityState !== 'visible' && 'Notification' in window && Notification.permission === 'granted'){
    try{
      const iconLink = document.querySelector('link[rel="icon"]');
      voiceCallNotif = new Notification(`Incoming call from ${name}`, {
        body: 'Click to answer in the staff portal.', tag: callRowId ? `call-${callRowId}` : 'staff-call',
        requireInteraction: true, icon: iconLink ? iconLink.href : undefined,
      });
      voiceCallNotif.onclick = () => { window.focus(); if(voiceCallNotif) voiceCallNotif.close(); };
    }catch(e){ voiceCallNotif = null; }
  }
}
function voiceIncomingAlertStop(){
  if(voiceTitleTimer){ clearInterval(voiceTitleTimer); voiceTitleTimer = null; }
  if(voiceTitleOrig !== null){ document.title = voiceTitleOrig; voiceTitleOrig = null; }
  if(voiceCallNotif){ try{ voiceCallNotif.close(); }catch(e){ /* gone */ } voiceCallNotif = null; }
}

function teardownVoiceCallSignaling(){
  if(voiceCallState) endVoiceCall(null, false);
  if(voiceMyChannel){ sb.removeChannel(voiceMyChannel); voiceMyChannel = null; }
}

// Flushes any ICE candidates that arrived before this call's peer
// connection existed yet, or before its remote description was set —
// see the 'ice-candidate' branch below for why that queue exists.
async function voiceFlushPendingCandidates(state){
  if(!state || !state.pc || !state.pendingCandidates || !state.pendingCandidates.length) return;
  const queued = state.pendingCandidates;
  state.pendingCandidates = [];
  console.log('[call] flushing', queued.length, 'queued ICE candidate(s)');
  for(const candidate of queued){
    try{ await state.pc.addIceCandidate(new RTCIceCandidate(candidate)); }
    catch(e){ console.error('[call] queued addIceCandidate failed', e); }
  }
}

// ---------- v106: "Add to call" — small mesh conferencing on top of the
// otherwise-untouched 1:1 call above. voiceCallState.pc (the original
// 2-party connection) is never touched by any of this; a person added
// mid-call gets their OWN separate RTCPeerConnection per existing
// participant, stored in voiceCallState.extraPeers[theirUserId], with its
// remote audio played through a dedicated <audio> element (see
// #extraCallAudios) rather than reusing #remoteCallAudio. Scoped to one
// added person (a 3-way call) — every extraPeers connection reuses the
// SAME localStream/track already captured for the primary call (a
// MediaStreamTrack can be added to more than one RTCPeerConnection at
// once), so mute (which just flips that one track's .enabled) keeps
// working everywhere for free, with no extra wiring.
function voiceGenId(){
  return (crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(16).slice(2)}`);
}

// ---------- v395: persistent call roster (call_participants) ----------
// Everything above (extraPeers, meshParticipants) is per-tab, in-memory
// WebRTC plumbing that vanishes on refresh and is never visible to other
// participants. This layer is the actual source of truth for "who's on
// this call and what's their status" — a real DB table, realtime-synced
// to every participant's tab, so a Google-Meet-style roster (ringing /
// connected / declined / no answer / left) can be shown and a no-answer
// participant can be rung again. Internal staff calls only — client calls
// stay strictly 1:1 (see startVoiceCallToClient, untouched by any of this).
let voiceCallRoster = {}; // user_id -> call_participants row (only for the CURRENT call)
let voiceRosterChannel = null;
let voiceRosterInviteTimeouts = {}; // user_id -> setTimeout handle, for detecting "no answer" on a mesh invite

function voiceRosterRowUpsertLocal(row){
  voiceCallRoster[row.user_id] = row;
  if(row.status !== 'ringing' && voiceRosterInviteTimeouts[row.user_id]){
    clearTimeout(voiceRosterInviteTimeouts[row.user_id]);
    delete voiceRosterInviteTimeouts[row.user_id];
  }
  renderCallParticipantsPanel();
  updateCallParticipantsBadge();
}

// Subscribes to every INSERT/UPDATE on this call's roster rows and does an
// initial fetch (covers rows inserted by ANOTHER participant's tab before
// this one's subscription was live — e.g. the callee's own row, inserted
// by the caller, needs to already be visible the moment the callee's tab
// starts up its own subscription).
async function voiceRosterInit(groupId){
  voiceCallRoster = {};
  voiceRosterInviteTimeouts = {};
  if(voiceRosterChannel){ sb.removeChannel(voiceRosterChannel); voiceRosterChannel = null; }
  const { data } = await sb.from('call_participants').select('*').eq('call_group_id', groupId);
  (data || []).forEach(row => { voiceCallRoster[row.user_id] = row; });
  voiceRosterChannel = sb.channel('call-roster-' + groupId)
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'call_participants', filter: `call_group_id=eq.${groupId}` }, (payload) => voiceRosterRowUpsertLocal(payload.new))
    .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'call_participants', filter: `call_group_id=eq.${groupId}` }, (payload) => voiceRosterRowUpsertLocal(payload.new))
    .subscribe();
  renderCallParticipantsPanel();
  updateCallParticipantsBadge();
}
function voiceRosterTeardown(){
  if(voiceRosterChannel){ sb.removeChannel(voiceRosterChannel); voiceRosterChannel = null; }
  Object.values(voiceRosterInviteTimeouts).forEach(h => clearTimeout(h));
  voiceRosterInviteTimeouts = {};
  voiceCallRoster = {};
}
// Best-effort — a roster write failing should never block the actual call
// audio, which is why call sites don't surface its errors to the user.
// Returns the promise (rather than firing-and-forgetting internally) so
// callers that need to INSERT a second row referencing the first one can
// await it — RLS's is_call_participant() check for "add someone else to a
// call I'm on" only passes once your OWN row actually exists, so the
// caller's self-row insert MUST land before the callee's row insert is
// attempted, or the second insert gets rejected by RLS.
function voiceRosterInsert(groupId, userId, userName, invitedBy, status){
  return sb.from('call_participants').insert({
    call_group_id: groupId, user_id: userId, user_name: userName, invited_by: invitedBy,
    status, connected_at: status === 'connected' ? new Date().toISOString() : null,
  }).select().single().then(({ data, error }) => {
    if(error){ console.error('[call] roster insert failed', error); return; }
    if(data) voiceRosterRowUpsertLocal(data);
  });
}
function voiceRosterSetStatus(userId, status){
  if(!voiceCallState || !voiceCallState.groupId) return;
  const patch = { status, updated_at: new Date().toISOString() };
  if(status === 'connected') patch.connected_at = new Date().toISOString();
  if(status === 'declined' || status === 'no_answer' || status === 'left' || status === 'ended') patch.ended_at = new Date().toISOString();
  sb.from('call_participants').update(patch).eq('call_group_id', voiceCallState.groupId).eq('user_id', userId)
    .then(({ error }) => { if(error) console.error('[call] roster status update failed', error); });
}
function updateCallParticipantsBadge(){
  const btn = $('callParticipantsBtn');
  const badge = $('callParticipantsCount');
  if(!btn || !badge) return;
  const rows = Object.values(voiceCallRoster);
  if(!voiceCallState || rows.length < 2){ btn.style.display = 'none'; return; }
  btn.style.display = '';
  const activeCount = rows.filter(r => r.status === 'connected' || r.status === 'ringing').length;
  badge.textContent = String(activeCount);
  badge.style.display = activeCount > 0 ? '' : 'none';
}
const CALL_ROSTER_STATUS_LABEL = { ringing: 'Ringing…', connected: 'Connected', declined: 'Declined', no_answer: 'No answer', left: 'Left', ended: 'Ended' };
function renderCallParticipantsPanel(){
  const list = $('callParticipantsList');
  if(!list) return;
  const rows = Object.values(voiceCallRoster).sort((a, b) => new Date(a.invited_at) - new Date(b.invited_at));
  if(!rows.length){ list.innerHTML = '<div class="call-add-panel-empty">No one on this call yet.</div>'; return; }
  list.innerHTML = rows.map(r => {
    const isMe = r.user_id === myUserId;
    const canRingAgain = !isMe && (r.status === 'declined' || r.status === 'no_answer');
    return `<div class="call-participants-row">
      <span class="call-participants-name">${escapeHtml(r.user_name || 'Someone')}${isMe ? ' (you)' : ''}</span>
      <span class="call-participants-status ${escapeHtml(r.status)}">${escapeHtml(CALL_ROSTER_STATUS_LABEL[r.status] || r.status)}</span>
      ${canRingAgain ? `<button type="button" class="call-participants-ring-again" data-user-id="${escapeHtml(r.user_id)}" data-user-name="${escapeHtml(r.user_name || '')}">Ring again</button>` : ''}
    </div>`;
  }).join('');
  list.querySelectorAll('.call-participants-ring-again').forEach(btn => {
    btn.addEventListener('click', () => ringAgainParticipant(btn.dataset.userId, btn.dataset.userName));
  });
}
if($('callParticipantsBtn')) $('callParticipantsBtn').addEventListener('click', () => {
  const panel = $('callParticipantsPanel');
  const showing = panel.style.display === 'block';
  if(showing){ panel.style.display = 'none'; return; }
  $('callAddPanel').style.display = 'none';
  renderCallParticipantsPanel();
  panel.style.display = 'block';
});

async function voiceFlushMeshCandidates(peer){
  if(!peer || !peer.pc || !peer.pendingCandidates || !peer.pendingCandidates.length) return;
  const queued = peer.pendingCandidates;
  peer.pendingCandidates = [];
  for(const candidate of queued){
    try{ await peer.pc.addIceCandidate(new RTCIceCandidate(candidate)); }
    catch(e){ console.error('[call] mesh queued addIceCandidate failed', e); }
  }
}

function voiceRemoveExtraPeer(peerId){
  if(!voiceCallState || !voiceCallState.extraPeers[peerId]) return;
  const peer = voiceCallState.extraPeers[peerId];
  if(peer.pc) peer.pc.close();
  if(peer.channel) sb.removeChannel(peer.channel);
  const audioEl = document.getElementById('extraAudio-' + peerId);
  if(audioEl) audioEl.remove();
  delete voiceCallState.extraPeers[peerId];
  renderCallAddPanel();
}

// Builds a fresh RTCPeerConnection wired the same way as the primary call
// (ICE gathering -> the given channel, diagnostics, remote audio into a
// per-peer <audio> element) — shared by both sides of a mesh leg (the
// side that dials out, and the side that silently auto-accepts).
async function voiceCreateMeshPc(peerId, peerName, channel){
  const iceServers = await voiceIceServers();
  const pc = new RTCPeerConnection({ iceServers });
  voiceCallState.localStream.getTracks().forEach(track => pc.addTrack(track, voiceCallState.localStream));
  let audioEl = document.getElementById('extraAudio-' + peerId);
  if(!audioEl){
    audioEl = document.createElement('audio');
    audioEl.id = 'extraAudio-' + peerId;
    audioEl.autoplay = true;
    audioEl.style.display = 'none';
    document.getElementById('extraCallAudios').appendChild(audioEl);
  }
  pc.ontrack = (e) => { audioEl.srcObject = e.streams[0]; };
  pc.onicecandidate = (e) => {
    if(e.candidate) voiceSend(channel, { type: 'mesh-ice-candidate', candidate: e.candidate, groupId: voiceCallState.groupId });
  };
  voiceAttachDiagnostics(pc);
  return pc;
}

// Called by the person who was just added to an existing call (after
// accepting the primary invite) — dials every OTHER participant directly
// so the mesh is complete. Silent on the receiving end (see 'mesh-offer'
// above): no ring, no Accept click, since they're already in this call.
async function meshDialAll(){
  const state = voiceCallState;
  if(!state || !state.meshParticipants || !state.meshParticipants.length) return;
  for(const p of state.meshParticipants){
    if(p.id === state.peerId || p.id === myUserId) continue;
    try{
      const channel = sb.channel('call-signal-' + p.id);
      await voiceChannelReady(channel);
      const pc = await voiceCreateMeshPc(p.id, p.name, channel);
      state.extraPeers[p.id] = { pc, channel, name: p.name, remoteDescSet: false, pendingCandidates: [] };
      const offer = await pc.createOffer();
      await pc.setLocalDescription(offer);
      voiceSend(channel, { type: 'mesh-offer', sdp: offer, groupId: state.groupId });
      renderCallAddPanel();
    }catch(e){ console.error('[call] meshDialAll failed for', p.id, e); }
  }
}

// Silent auto-accept side of a mesh leg — this browser is already on the
// call (groupId matched by the caller) so there's no ring banner, just a
// straight answer.
async function meshAcceptOffer(msg){
  const state = voiceCallState;
  const channel = sb.channel('call-signal-' + msg.from);
  await voiceChannelReady(channel);
  const pc = await voiceCreateMeshPc(msg.from, msg.fromName, channel);
  const peer = { pc, channel, name: msg.fromName, remoteDescSet: false, pendingCandidates: [] };
  state.extraPeers[msg.from] = peer;
  await pc.setRemoteDescription(new RTCSessionDescription(msg.sdp));
  peer.remoteDescSet = true;
  await voiceFlushMeshCandidates(peer);
  const answer = await pc.createAnswer();
  await pc.setLocalDescription(answer);
  voiceSend(channel, { type: 'mesh-answer', sdp: answer, groupId: state.groupId });
  renderCallAddPanel();
}

// Invite an additional person into the CURRENT call — sent as a normal
// 'offer' (so it rings/shows Accept-Decline exactly like any other
// incoming call) but tagged with this call's groupId and the list of
// who's already on it, so once accepted, the new person's own
// meshDialAll() can complete the 3-way mesh automatically.
const CALL_RING_AGAIN_TIMEOUT_MS = 30000; // matches the primary call's own ringTimeout above
async function inviteToCall(userId, userName){
  const state = voiceCallState;
  if(!state || !state.localStream) return;
  if(state.peerId === userId || state.extraPeers[userId]) return;
  try{
    const channel = sb.channel('call-signal-' + userId);
    await voiceChannelReady(channel);
    const pc = await voiceCreateMeshPc(userId, userName, channel);
    state.extraPeers[userId] = { pc, channel, name: userName, remoteDescSet: false, pendingCandidates: [] };
    const offer = await pc.createOffer();
    await pc.setLocalDescription(offer);
    // v395 bug fix: this used to hardcode a 2-entry participants list
    // ([myself, the primary peer]) no matter how many people were
    // already on the call — so a 4th person invited into an existing
    // 3-way call would run their own meshDialAll() against a roster
    // that never included the 3rd person, leaving them silently
    // unconnected to each other. Build the list from whoever's ACTUALLY
    // on the call right now instead.
    const currentParticipants = [
      { id: myUserId, name: myFullName || myEmail },
      { id: state.peerId, name: state.peerName },
      ...Object.keys(state.extraPeers).filter(id => id !== userId).map(id => ({ id, name: state.extraPeers[id].name })),
    ];
    voiceSend(channel, { type: 'offer', sdp: offer, groupId: state.groupId, participants: currentParticipants });
    // v395: persist + start a no-answer timer — mirrors the primary
    // call's own ringTimeout, since a mesh invite never had one before
    // (an invitee who never answered and never explicitly declined would
    // just sit as a permanently-pending, unringable invite otherwise).
    voiceRosterInsert(state.groupId, userId, userName, myUserId, 'ringing');
    voiceRosterInviteTimeouts[userId] = setTimeout(() => {
      if(voiceCallState && voiceCallState.extraPeers[userId] && !voiceCallState.extraPeers[userId].remoteDescSet){
        voiceRosterSetStatus(userId, 'no_answer');
        voiceRemoveExtraPeer(userId);
      }
    }, CALL_RING_AGAIN_TIMEOUT_MS);
    renderCallAddPanel();
    $('callAddPanel').style.display = 'none';
  }catch(e){ console.error('[call] inviteToCall failed', e); alert("Couldn't add them to the call."); }
}
// v395: re-ring someone who declined or didn't answer a mesh invite —
// their old (torn-down) extraPeers entry is already gone by the time this
// is clickable (voiceRemoveExtraPeer() on decline/no-answer clears it),
// so this is just a normal inviteToCall() call.
function ringAgainParticipant(userId, userName){
  inviteToCall(userId, userName);
}

function renderCallAddPanel(){
  const list = $('callAddPanelList');
  if(!list) return;
  const state = voiceCallState;
  if(!state){ list.innerHTML = ''; return; }
  const already = new Set([state.peerId, myUserId, ...Object.keys(state.extraPeers || {})]);
  const candidates = (chatDirectory || []).filter(p => !already.has(p.id));
  if(!candidates.length){
    list.innerHTML = '<div class="call-add-panel-empty">No one else available to add.</div>';
    return;
  }
  list.innerHTML = candidates.map(p => `<div class="call-add-panel-row" data-user-id="${escapeHtml(p.id)}" data-user-name="${escapeHtml(p.full_name || p.email || 'Colleague')}"><span class="chat-status-dot ${chatContactStatus(p.id)}" style="position:static; width:8px; height:8px; border:none;"></span> ${escapeHtml(p.full_name || p.email || 'Colleague')}</div>`).join('');
  list.querySelectorAll('.call-add-panel-row').forEach(row => {
    row.addEventListener('click', () => inviteToCall(row.dataset.userId, row.dataset.userName));
  });
}

$('callAddBtn').addEventListener('click', () => {
  const panel = $('callAddPanel');
  const showing = panel.style.display === 'block';
  if(showing){ panel.style.display = 'none'; return; }
  renderCallAddPanel();
  panel.style.display = 'block';
});



// ---------------------------------------------------------------------------
// v707 ("when the page is refreshed or the internet drops and comes back, the
// call should reconnect instead of calling again"). A 1:1 call used to END
// the moment its connection went 'failed', and a refresh simply lost it --
// the only way back was to ring again.
//
// Now a live call is remembered in this TAB (sessionStorage) for a minute,
// and the connection is rebuilt instead of the call being dropped:
//   - network blip: both sides see the connection go 'disconnected' /
//     'failed' and show "Reconnecting…". ONE side re-offers -- whoever
//     placed the call -- so the two never collide; it repeats every 3 s
//     until the other side answers (its realtime socket may still be down).
//   - refresh: the reloaded tab gets the microphone back and re-offers
//     itself. The other side answers it without ringing.
// A reconnect is a fresh RTCPeerConnection on the same microphone stream,
// exchanged as 'rejoin-request' / 'rejoin-answer', with ICE candidates tagged
// by the reconnect's id so a late candidate from the dead connection is
// never fed to the new one. If both sides re-offer at once the smaller id
// leads. The attempt gives up after VOICE_REJOIN_WINDOW_MS, and sooner if the
// voice_calls row says the other side hung up while we could not hear it.
// Pages from before v707 ignore these messages (the call then ends as it
// always did). "Add to call" legs are not restored -- only the 1:1 call.
const VOICE_REJOIN_WINDOW_MS = 60000;
const VOICE_SAVED_CALL_KEY = 'pt.activeCall';
function voiceSaveCallForRejoin(){
  const st = voiceCallState;
  // v709: a call I placed that is still RINGING is kept too, so a refresh
  // does not silently drop it (voiceResumeRinging).
  const ringingOut = !!st && st.status === 'ringing' && st.role === 'caller';
  if(!st || (st.status !== 'answered' && !ringingOut) || !st.callRowId || !st.peerId) return;
  try{
    sessionStorage.setItem(VOICE_SAVED_CALL_KEY, JSON.stringify({
      callRowId: st.callRowId, peerId: st.peerId, peerName: st.peerName, role: st.role,
      isClientCall: !!st.isClientCall, startedAt: st.startedAt || null,
      status: st.status, ringStartedAt: st.ringStartedAt || null,
      groupId: st.groupId || null, savedAt: Date.now(),
    }));
  }catch(e){ /* private mode: no rejoin after a refresh, nothing else lost */ }
}
function voiceReadSavedCall(){
  try{
    const saved = JSON.parse(sessionStorage.getItem(VOICE_SAVED_CALL_KEY) || 'null');
    if(!saved || !saved.callRowId || !saved.peerId) return null;
    if(Date.now() - (saved.savedAt || 0) > VOICE_REJOIN_WINDOW_MS){ sessionStorage.removeItem(VOICE_SAVED_CALL_KEY); return null; }
    return saved;
  }catch(e){ return null; }
}
function voiceClearSavedCall(){ try{ sessionStorage.removeItem(VOICE_SAVED_CALL_KEY); }catch(e){ /* nothing to clear */ } }
function voiceMarkLive(state){
  voiceSaveCallForRejoin();
  clearInterval(state.saveTimer);
  state.saveTimer = setInterval(voiceSaveCallForRejoin, 5000);
}
window.addEventListener('pagehide', voiceSaveCallForRejoin);
window.addEventListener('online', () => {
  const st = voiceCallState;
  if(st && st.reconnecting && (st.role === 'caller' || st.restored)) voiceSendRejoin(st);
});

// Every 1:1 call's connection reports here (replacing "failed = end call").
function voiceOnPcState(pc){
  const state = voiceCallState;
  console.log('[call] connection state:', pc.connectionState);
  if(!state || state.pc !== pc) return;              // a connection already replaced
  const cs = pc.connectionState;
  if(cs === 'connected'){ if(state.reconnecting) voiceRejoinDone(state); return; }
  if(state.status !== 'answered'){ if(cs === 'failed') endVoiceCall('failed', true); return; }   // never got going
  if(cs === 'disconnected' || cs === 'failed'){
    if(state.reconnecting){
      // A reconnect that itself failed: the leading side simply tries again.
      if(cs === 'failed' && (state.role === 'caller' || state.restored)){
        setTimeout(() => { if(voiceCallState === state && state.reconnecting && state.pc === pc) voiceSendRejoin(state); }, 2000);
      }
      return;
    }
    voiceBeginReconnect(state, cs === 'failed' ? 0 : 3000);
  }
}

function voiceBeginReconnect(state, kickDelay){
  if(voiceCallState !== state || state.reconnecting) return;
  const r = state.reconnecting = { since: Date.now() };
  voiceShowActiveBar(state.peerName, 'Reconnecting…', true);
  r.deadline = setTimeout(() => {
    if(voiceCallState === state && state.reconnecting === r) endVoiceCall('ended', true);
  }, VOICE_REJOIN_WINDOW_MS);
  // They may have hung up while we could not hear it.
  r.poll = setInterval(async () => {
    if(voiceCallState !== state || state.reconnecting !== r || !state.callRowId) return;
    const { data } = await sb.from('voice_calls').select('status').eq('id', state.callRowId).maybeSingle();
    if(data && ['ended', 'failed', 'missed', 'declined'].includes(data.status) && voiceCallState === state){
      endVoiceCall(state.role === 'caller' ? 'ended' : null, false);
    }
  }, 5000);
  // One side re-offers: whoever placed the call. (A tab restored after a
  // refresh leads instead -- voiceResumeSavedCall -- and passes null here.)
  if(kickDelay != null && state.role === 'caller'){
    r.kick = setTimeout(() => {
      if(voiceCallState !== state || state.reconnecting !== r || !state.pc) return;
      if(state.pc.connectionState === 'connected') voiceRejoinDone(state);
      else voiceSendRejoin(state);
    }, kickDelay);
  }
}
function voiceClearReconnect(state){
  if(!state) return;
  const r = state.reconnecting;
  if(r){ clearTimeout(r.deadline); clearInterval(r.poll); clearTimeout(r.kick); }
  state.reconnecting = null;
  clearInterval(state.rejoinRetry);
}
function voiceRejoinDone(state){
  voiceClearReconnect(state);
  state.rejoinId = null;
  if(!state.durationInterval) voiceStartCallTimer();
  else {
    voicePlayConnectSound();
    voiceShowActiveBar(state.peerName, '', false);
    $('callScreenShareBtn').style.display = 'flex';
  }
  const track = state.localStream && state.localStream.getAudioTracks()[0];
  if(track) $('callMuteBtn').classList.toggle('muted', !track.enabled);
  voiceMarkLive(state);
}

async function voiceEnsureChannel(state){
  if(state.outboundChannel) return;
  state.outboundChannel = sb.channel('call-signal-' + state.peerId);
  await voiceChannelReady(state.outboundChannel);
}
// A screen share does not survive a rebuilt connection; stop it cleanly.
function voiceDropScreenShare(state){
  if(state.screenStream) state.screenStream.getTracks().forEach(t => t.stop());
  state.screenStream = null; state.hasScreenShare = false; state.videoSender = null; state.peerSharing = false;
  try{ voiceUpdateScreenShareUI(); }catch(e){ /* no call UI yet */ }
}
async function voiceBuildPc(state, tag){
  const channel = state.outboundChannel;
  const iceServers = await voiceIceServers();
  const pc = new RTCPeerConnection({ iceServers });
  state.localStream.getTracks().forEach(track => pc.addTrack(track, state.localStream));
  pc.ontrack = (e) => { $(e.track.kind === 'video' ? 'remoteCallVideo' : 'remoteCallAudio').srcObject = e.streams[0]; };
  pc.onicecandidate = (e) => { if(e.candidate) voiceSend(channel, { type: 'ice-candidate', candidate: e.candidate, tag }); };
  voiceAttachDiagnostics(pc);
  pc.onconnectionstatechange = () => voiceOnPcState(pc);
  return pc;
}

async function voiceSendRejoin(state){
  if(voiceCallState !== state) return;
  const rejoinId = voiceGenId();
  // Set BEFORE the awaits below, so candidates for this reconnect that
  // arrive meanwhile are queued rather than fed to the dead connection.
  state.rejoinId = rejoinId;
  state.pcTag = rejoinId;
  state.remoteDescSet = false;
  state.pendingCandidates = [];
  await voiceEnsureChannel(state);
  const old = state.pc;
  voiceDropScreenShare(state);
  const pc = await voiceBuildPc(state, rejoinId);
  if(voiceCallState !== state || state.rejoinId !== rejoinId){ pc.close(); return; }
  state.pc = pc;
  if(old){ try{ old.close(); }catch(e){ /* already closed */ } }
  const offer = await pc.createOffer();
  await pc.setLocalDescription(offer);
  const payload = { type: 'rejoin-request', callRowId: state.callRowId, rejoinId, sdp: offer };
  voiceSend(state.outboundChannel, payload);
  clearInterval(state.rejoinRetry);
  state.rejoinRetry = setInterval(() => {
    if(voiceCallState !== state || state.rejoinId !== rejoinId || state.remoteDescSet){ clearInterval(state.rejoinRetry); return; }
    voiceSend(state.outboundChannel, payload);
  }, 3000);
}

// After a refresh: the call as it was, minus the connection.
let voiceRestoring = null;
function voiceEnsureRestored(saved){
  if(voiceCallState) return Promise.resolve(voiceCallState);
  if(!voiceRestoring) voiceRestoring = voiceRestoreFromSaved(saved).finally(() => { voiceRestoring = null; });
  return voiceRestoring;
}
async function voiceRestoreFromSaved(saved){
  let localStream;
  try{ localStream = await navigator.mediaDevices.getUserMedia({ audio: true }); }
  catch(e){
    voiceClearSavedCall();
    alert('Your call dropped when the page reloaded, and the microphone is blocked, so it could not reconnect. Allow the microphone and call them again.');
    return null;
  }
  if(voiceCallState){ localStream.getTracks().forEach(t => t.stop()); return voiceCallState; }
  const outboundChannel = sb.channel('call-signal-' + saved.peerId);
  await voiceChannelReady(outboundChannel);
  voiceCallState = { role: saved.role, isClientCall: !!saved.isClientCall, peerId: saved.peerId, peerName: saved.peerName, pc: null, localStream, outboundChannel, callRowId: saved.callRowId, status: 'answered', remoteDescSet: false, pendingCandidates: [], videoSender: null, screenStream: null, hasScreenShare: false, peerSharing: false, videoPanelMinimized: false, videoPanelMaximized: false, groupId: saved.groupId || voiceGenId(), extraPeers: {}, startedAt: saved.startedAt || Date.now(), restored: true };
  voiceBeginReconnect(voiceCallState, null);
  return voiceCallState;
}
async function voiceResumeSavedCall(){
  const saved = voiceReadSavedCall();
  if(!saved || voiceCallState) return;
  // v709: what happened while the page reloaded? The call record says.
  const { data } = await sb.from('voice_calls').select('status').eq('id', saved.callRowId).maybeSingle();
  const rowStatus = data ? data.status : null;
  if(saved.status === 'ringing'){
    if(rowStatus === 'ringing' && Date.now() - (saved.ringStartedAt || 0) < VOICE_RING_MS){ voiceResumeRinging(saved); return; }
    if(rowStatus !== 'answered'){ voiceClearSavedCall(); return; }
    // They answered during the reload: carry on below as an answered call.
  } else if(rowStatus && rowStatus !== 'answered'){ voiceClearSavedCall(); return; }
  const state = await voiceEnsureRestored(saved);
  if(!state || state.callRowId !== saved.callRowId) return;
  if(voiceCallState === state && !state.answeredRejoinId && !state.rejoinId && !state.remoteDescSet) voiceSendRejoin(state);
}
// v709: back to ringing after a refresh. A fresh connection and a fresh
// offer, sent as an 'offer-retry' flagged `replace` and tagged, so the other
// side swaps it in without ringing twice; the ring keeps its original
// 45-second budget.
async function voiceResumeRinging(saved){
  let localStream;
  try{ localStream = await navigator.mediaDevices.getUserMedia({ audio: true }); }
  catch(e){ voiceClearSavedCall(); return; }
  if(voiceCallState){ localStream.getTracks().forEach(t => t.stop()); return; }
  const outboundChannel = sb.channel('call-signal-' + saved.peerId);
  await voiceChannelReady(outboundChannel);
  if(voiceCallState){ localStream.getTracks().forEach(t => t.stop()); sb.removeChannel(outboundChannel); return; }
  const tag = voiceGenId();
  const state = voiceCallState = { role: 'caller', isClientCall: !!saved.isClientCall, peerId: saved.peerId, peerName: saved.peerName, pc: null, localStream, outboundChannel, callRowId: saved.callRowId, status: 'ringing', remoteDescSet: false, pendingCandidates: [], videoSender: null, screenStream: null, hasScreenShare: false, peerSharing: false, videoPanelMinimized: false, videoPanelMaximized: false, groupId: saved.groupId || voiceGenId(), extraPeers: {}, ringStartedAt: saved.ringStartedAt || Date.now(), pcTag: tag, restored: true };
  const pc = await voiceBuildPc(state, tag);
  if(voiceCallState !== state){ pc.close(); return; }
  state.pc = pc;
  const offer = await pc.createOffer();
  await pc.setLocalDescription(offer);
  const payload = { type: 'offer-retry', sdp: offer, callRowId: state.callRowId, replace: true, tag };
  if(!state.isClientCall) payload.groupId = state.groupId;
  voiceSend(outboundChannel, payload);
  voiceRepeatOffer(outboundChannel, payload);
  voiceShowActiveBar(state.peerName, 'Calling…', true);
  voiceStartRingtone('ringback');
  const left = Math.max(5000, VOICE_RING_MS - (Date.now() - state.ringStartedAt));
  state.ringTimeout = setTimeout(() => {
    if(voiceCallState === state && state.status === 'ringing') endVoiceCall('missed', true);
  }, left);
  voiceMarkLive(state);
}

async function voiceHandleRejoinRequest(msg){
  let state = voiceCallState;
  if(!state){
    // Only the tab that HAD this call answers; my other open tabs stay out.
    const saved = voiceReadSavedCall();
    if(!saved || saved.callRowId !== msg.callRowId || saved.peerId !== msg.from) return;
    state = await voiceEnsureRestored(saved);
    if(!state) return;
  }
  if(state.callRowId !== msg.callRowId || state.peerId !== msg.from || state.status !== 'answered') return;
  if(state.answeredRejoinId === msg.rejoinId){   // a repeat: our answer may have been lost
    if(state.lastRejoinAnswer && state.outboundChannel) voiceSend(state.outboundChannel, state.lastRejoinAnswer);
    return;
  }
  // Both sides re-offered at once: the smaller id leads, the other answers.
  if(state.rejoinId && state.rejoinId !== msg.rejoinId && !state.remoteDescSet && state.rejoinId < msg.rejoinId) return;
  clearInterval(state.rejoinRetry);
  state.rejoinId = null;
  state.pcTag = msg.rejoinId;
  state.remoteDescSet = false;
  state.pendingCandidates = (state.candidateStash && state.candidateStash[msg.rejoinId]) || [];
  if(state.candidateStash) delete state.candidateStash[msg.rejoinId];
  if(!state.reconnecting) voiceBeginReconnect(state, null);
  await voiceEnsureChannel(state);
  const old = state.pc;
  voiceDropScreenShare(state);
  const pc = await voiceBuildPc(state, msg.rejoinId);
  if(voiceCallState !== state || state.pcTag !== msg.rejoinId){ pc.close(); return; }
  state.pc = pc;
  if(old){ try{ old.close(); }catch(e){ /* already closed */ } }
  await pc.setRemoteDescription(new RTCSessionDescription(msg.sdp));
  state.remoteDescSet = true;
  await voiceFlushPendingCandidates(state);
  const answer = await pc.createAnswer();
  await pc.setLocalDescription(answer);
  state.answeredRejoinId = msg.rejoinId;
  state.lastRejoinAnswer = { type: 'rejoin-answer', callRowId: state.callRowId, rejoinId: msg.rejoinId, sdp: answer };
  voiceSend(state.outboundChannel, state.lastRejoinAnswer);
}

// v700: WHY SOME CALLS NEVER RANG. The offer used to be sent exactly ONCE.
// A callee whose realtime connection blinked at that moment (a laptop waking,
// a background tab, a network hiccup), or who opened the portal a few seconds
// after the push, never received it -- and the caller heard ringback into
// nothing. Now the caller repeats it as 'offer-retry' every 4 s while it
// rings, and rings for 45 s. A retry only rings a tab that is not already in
// a call and has not rung for that call before. Pages from before v700 ignore
// the new message type, so mixed versions stay safe.
const VOICE_RING_MS = 45000;
const VOICE_OFFER_RETRY_MS = 4000;
const voiceRangCallIds = new Set();
// v790: the other side's decline or hang-up is a one-off message and can be
// missed (a phone that just woke, a blinked connection) -- the call kept
// "Calling..." / ringing until the 45 s timeout. The call row is the backup:
// while this call rings, check it every 3 s and stop once the other side has
// declined or given up.
function voiceWatchRingingRow(state){
  if(!state || !state.callRowId) return;
  clearInterval(state.rowWatch);
  state.rowWatch = setInterval(async () => {
    if(voiceCallState !== state || state.status !== 'ringing'){ clearInterval(state.rowWatch); return; }
    const { data } = await sb.from('voice_calls').select('status').eq('id', state.callRowId).maybeSingle();
    if(voiceCallState !== state || state.status !== 'ringing' || !data) return;
    const s = data.status;
    if(state.role === 'caller'){
      if(s === 'declined'){ clearInterval(state.rowWatch); endVoiceCall('declined', false); }
      else if(s === 'missed' || s === 'ended' || s === 'failed'){ clearInterval(state.rowWatch); endVoiceCall(null, false); }
    } else if(s && s !== 'ringing'){
      clearInterval(state.rowWatch); endVoiceCall(null, false);
    }
  }, 3000);
}

function voiceRepeatOffer(channel, payload){
  const state = voiceCallState;
  if(!state || !payload.callRowId) return;
  state.offerRetry = setInterval(() => {
    if(voiceCallState !== state || state.status !== 'ringing'){ clearInterval(state.offerRetry); return; }
    voiceSend(channel, payload);
  }, VOICE_OFFER_RETRY_MS);
  voiceWatchRingingRow(state);   // v790
}

async function handleVoiceSignal(msg){
  if(msg.type === 'offer-retry'){
    // v709: the caller refreshed while this rang, and sent a NEW offer for
    // the same call. Swap it in and keep ringing -- it has not been
    // answered yet, so there is nothing else to change.
    if(msg.replace && voiceCallState && voiceCallState.role === 'callee' && voiceCallState.callRowId === msg.callRowId){
      if(voiceCallState.status === 'ringing' && !voiceCallState.pc && voiceCallState.offerTag !== msg.tag){
        voiceCallState.offerSdp = msg.sdp;
        voiceCallState.offerTag = msg.tag;
        voiceCallState.pcTag = msg.tag;
        voiceCallState.pendingCandidates = (voiceCallState.candidateStash && voiceCallState.candidateStash[msg.tag]) || [];
      }
      return;
    }
    if(voiceCallState || !msg.callRowId || voiceRangCallIds.has(msg.callRowId)) return;
    msg = { ...msg, type: 'offer' };
  }
  if(msg.type === 'offer'){
    if(voiceCallState){ voiceSendOneOff(msg.from, { type: 'busy' }); return; } // already on/starting a call
    if(msg.callRowId) voiceRangCallIds.add(msg.callRowId);
    voiceCallState = { role: 'callee', peerId: msg.from, peerName: msg.fromName, callRowId: msg.callRowId, offerSdp: msg.sdp, status: 'ringing', remoteDescSet: false, pendingCandidates: [], videoSender: null, screenStream: null, hasScreenShare: false, peerSharing: false, videoPanelMinimized: false, videoPanelMaximized: false, groupId: msg.groupId || voiceGenId(), extraPeers: {}, meshParticipants: msg.participants || [] };
    if(msg.tag){ voiceCallState.pcTag = msg.tag; voiceCallState.offerTag = msg.tag; }   // v709: a re-sent offer
    // v395: subscribe to the roster while still just ringing, not only
    // after Accept — the caller already inserted this browser's own row
    // (status 'ringing') when they placed the call, so it's there to be
    // seen the moment this subscription goes live.
    if(voiceCallState.groupId) voiceRosterInit(voiceCallState.groupId);
    $('incomingCallName').textContent = msg.fromName || 'Someone';
    $('incomingCallSub').textContent = (msg.participants && msg.participants.length)
      ? `Adding you to a call with ${msg.participants.map(p => p.name).join(', ')}…`
      : 'Incoming call…';
    $('incomingCallBanner').style.display = 'flex';
    requestAnimationFrame(voiceSetCallStackOffsets); // v634
    voiceStartRingtone('incoming');
    voiceIncomingAlertStart(msg.fromName || 'Someone', msg.callRowId);   // v709
    voiceWatchRingingRow(voiceCallState);   // v790: the caller hung up / gave up
  } else if(msg.type === 'answer'){
    if(!voiceCallState || voiceCallState.role !== 'caller' || !voiceCallState.pc) return;
    // v791: a client can have the app AND the web portal open -- only the
    // first device to answer gets the call; a second answer is ignored.
    if(voiceCallState.status === 'answered' || voiceCallState.remoteDescSet) return;
    clearTimeout(voiceCallState.ringTimeout);
    voiceStopRingtone();
    await voiceCallState.pc.setRemoteDescription(new RTCSessionDescription(msg.sdp));
    voiceCallState.remoteDescSet = true;
    await voiceFlushPendingCandidates(voiceCallState);
    voiceCallState.status = 'answered';
    voiceCallState.startedAt = Date.now();
    if(voiceCallState.callRowId) sb.from('voice_calls').update({ status: 'answered', answered_at: new Date().toISOString() }).eq('id', voiceCallState.callRowId).then(() => {});
    voiceStartCallTimer();
    voiceMarkLive(voiceCallState);   // v707
  } else if(msg.type === 'ice-candidate'){
    if(!voiceCallState || !msg.candidate) return;
    // v707: candidates carry the connection they belong to. One for a
    // reconnect this side has not built yet is kept for it; one from a
    // connection already replaced is dropped.
    const tag = msg.tag || 'o';
    if(tag !== (voiceCallState.pcTag || 'o')){
      if(tag !== 'o'){
        const stash = voiceCallState.candidateStash || (voiceCallState.candidateStash = {});
        (stash[tag] || (stash[tag] = [])).push(msg.candidate);
      }
      return;
    }
    // Two reasons a candidate can arrive "too early" to apply directly:
    // (1) the callee hasn't clicked Accept yet, so there's no peer
    // connection at all — the caller's candidates usually finish
    // gathering in under a second, well before a human answers; (2) the
    // peer connection exists but its remote description hasn't finished
    // being set yet (the 'answer'/'offer' handler above is still awaiting
    // setRemoteDescription — broadcast messages are dispatched without
    // waiting on each other, so this can race). Either way, calling
    // addIceCandidate now would throw and silently drop the candidate, so
    // queue it and flush once the connection is actually ready instead.
    if(voiceCallState.pc && voiceCallState.remoteDescSet){
      try{ await voiceCallState.pc.addIceCandidate(new RTCIceCandidate(msg.candidate)); }
      catch(e){ console.error('[call] addIceCandidate failed', e); }
    } else {
      console.log('[call] queuing ICE candidate — connection not ready yet');
      (voiceCallState.pendingCandidates || (voiceCallState.pendingCandidates = [])).push(msg.candidate);
    }
  } else if(msg.type === 'rejoin-request'){   // v707
    await voiceHandleRejoinRequest(msg);
  } else if(msg.type === 'rejoin-answer'){      // v707
    const st = voiceCallState;
    if(!st || st.callRowId !== msg.callRowId || st.rejoinId !== msg.rejoinId || !st.pc || st.remoteDescSet) return;
    clearInterval(st.rejoinRetry);
    await st.pc.setRemoteDescription(new RTCSessionDescription(msg.sdp));
    st.remoteDescSet = true;
    await voiceFlushPendingCandidates(st);
  } else if(msg.type === 'renegotiate-offer'){
    // Every call starts audio-only, so a renegotiation is only ever sent
    // for one reason in this app: the peer is adding a video track to
    // share their screen for the first time this call (subsequent
    // share/stop toggles from the same side reuse that sender via
    // replaceTrack and don't renegotiate again — see 'screenshare-status'
    // below). Set peerSharing before applying the offer so the resulting
    // ontrack event (routed by track kind, not this flag) lands with the
    // panel already visible.
    if(!voiceCallState || !voiceCallState.pc || !voiceCallState.outboundChannel) return;
    voiceCallState.peerSharing = true;
    voiceUpdateScreenShareUI();
    await voiceCallState.pc.setRemoteDescription(new RTCSessionDescription(msg.sdp));
    const answer = await voiceCallState.pc.createAnswer();
    await voiceCallState.pc.setLocalDescription(answer);
    voiceSend(voiceCallState.outboundChannel, { type: 'renegotiate-answer', sdp: answer });
  } else if(msg.type === 'renegotiate-answer'){
    if(!voiceCallState || !voiceCallState.pc) return;
    await voiceCallState.pc.setRemoteDescription(new RTCSessionDescription(msg.sdp));
  } else if(msg.type === 'screenshare-status'){
    // Lightweight UI-only ping — covers the cases that don't themselves
    // trigger a renegotiation (stopping a share, or re-sharing later in
    // the same call on a sender that already exists). The very first
    // share of a call is signaled by 'renegotiate-offer' above instead,
    // since that one does need a real SDP exchange.
    if(!voiceCallState) return;
    voiceCallState.peerSharing = !!msg.sharing;
    voiceUpdateScreenShareUI();
  } else if(msg.type === 'decline'){
    // v395 bug fix: this used to only handle a decline of the PRIMARY
    // call (role === 'caller'). A decline of a mid-call "add to call"
    // invite — sent by exactly the same 'decline' message type, from
    // whoever was just invited — had no handler at all: the inviter's
    // extraPeers entry (already a live pc + open signaling channel) was
    // never cleaned up, so it sat forever, and renderCallAddPanel()'s
    // "already invited" check kept blocking any attempt to re-add that
    // person for the rest of the call. Check for a matching mesh invite
    // FIRST, regardless of role, then fall through to the original
    // primary-call handling.
    if(voiceCallState && voiceCallState.extraPeers[msg.from]){
      voiceRosterSetStatus(msg.from, 'declined');
      voiceRemoveExtraPeer(msg.from);
    } else if(voiceCallState && voiceCallState.role === 'caller'){
      // v791: another of the client's devices declining after one answered
      // must not end the live call.
      if(voiceCallState.status === 'answered') return;
      voiceRosterSetStatus(msg.from, 'declined');
      endVoiceCall('declined', false);
    }
  } else if(msg.type === 'hangup'){
    if(voiceCallState) endVoiceCall(voiceCallState.status === 'answered' ? 'ended' : 'missed', false);
  } else if(msg.type === 'busy'){
    // Same fix as 'decline' above — someone invited mid-call who's
    // already on another call replies 'busy' too, and it hit the exact
    // same "only handled if I'm the primary caller" gap.
    if(voiceCallState && voiceCallState.extraPeers[msg.from]){
      voiceRosterSetStatus(msg.from, 'declined');
      voiceRemoveExtraPeer(msg.from);
    } else if(voiceCallState && voiceCallState.role === 'caller'){
      if(voiceCallState.status === 'answered') return;   // v791: another device of theirs
      const name = voiceCallState.peerName;
      voiceRosterSetStatus(msg.from, 'declined');
      endVoiceCall('missed', false);
      alert(`${name || 'They'} are on another call.`);
    }
  } else if(msg.type === 'claimed'){
    if(msg.callRowId) voiceRangCallIds.add(msg.callRowId);   // v700
    // One of MY OWN other open tabs accepted this same incoming call —
    // dismiss my banner rather than leave it ringing for a call that's
    // already been answered elsewhere.
    if(voiceCallState && voiceCallState.role === 'callee' && voiceCallState.status === 'ringing' && msg.callRowId === voiceCallState.callRowId){
      voiceStopRingtone();
      $('incomingCallBanner').style.display = 'none'; requestAnimationFrame(voiceSetCallStackOffsets); /* v634 */
      voiceCallState = null;
    }
  } else if(msg.type === 'mesh-offer'){
    // v106: "Add to call" mesh completion — an EXISTING participant
    // (already mid-call, matched by groupId) gets dialed directly by
    // whoever was just added, so everyone hears everyone without a
    // second ring/Accept step. Silently auto-accepted; if groupId
    // doesn't match this browser's current call, ignore it outright
    // rather than trust an arbitrary offer.
    if(!voiceCallState || voiceCallState.groupId !== msg.groupId) return;
    await meshAcceptOffer(msg);
  } else if(msg.type === 'mesh-answer'){
    const peer = voiceCallState && voiceCallState.extraPeers[msg.from];
    if(!peer || !peer.pc) return;
    await peer.pc.setRemoteDescription(new RTCSessionDescription(msg.sdp));
    peer.remoteDescSet = true;
    await voiceFlushMeshCandidates(peer);
  } else if(msg.type === 'mesh-ice-candidate'){
    const peer = voiceCallState && voiceCallState.extraPeers[msg.from];
    if(!peer || !msg.candidate) return;
    if(peer.pc && peer.remoteDescSet){
      try{ await peer.pc.addIceCandidate(new RTCIceCandidate(msg.candidate)); }
      catch(e){ console.error('[call] mesh addIceCandidate failed', e); }
    } else {
      (peer.pendingCandidates || (peer.pendingCandidates = [])).push(msg.candidate);
    }
  } else if(msg.type === 'mesh-hangup'){
    voiceRosterSetStatus(msg.from, 'left');
    voiceRemoveExtraPeer(msg.from);
  } else if(msg.type === 'meet-invite'){
    // Doesn't touch voiceCallState at all — this is a separate, much
    // simpler flow (no WebRTC here; Google Meet handles the actual call).
    // Reuses the same per-user signal channel purely for delivery.
    pendingMeetInvite = { link: msg.link, fromId: msg.from, fromName: msg.fromName, groupId: msg.groupId || null };
    $('incomingMeetName').textContent = msg.fromName || 'Someone';
    $('incomingMeetBanner').style.display = 'flex';
    requestAnimationFrame(voiceSetCallStackOffsets); // v634
    meetStartRingtone();
    voicePlayConnectSound(); // one gentle ping — deliberately NOT the repeating ring, so it doesn't read as an incoming voice call
  } else if(msg.type === 'meet-accepted' || msg.type === 'meet-declined'){
    console.log(`${msg.fromName || 'Someone'} ${msg.type === 'meet-accepted' ? 'joined' : 'declined'} the Google Meet you shared.`);
  }
}

// Posts a one-line note into the thread the invite came from (the DM with
// the inviter, or the group it was shared in) recording whether the
// invite was accepted or declined — same idea as voicePostCallSummary for
// voice calls. Posted by the person who just acted, so unlike the call
// summary there's no risk of it getting posted twice.
function postMeetResponseMessage(invite, accepted){
  const text = accepted ? '\u{1F4F9} Meeting accepted \u2014 started joining' : '\u{1F4F9} Meeting declined';
  const payload = {
    sender_id: myUserId,
    recipient_id: invite.groupId ? null : invite.fromId,
    group_id: invite.groupId || null,
    body: text,
  };
  sb.from('chat_messages').insert(payload).select().single()
    .then(({ data, error }) => {
      if(error){ console.error('Failed to post meet response to chat', error); return; }
      // Realtime will also deliver this back to us, but rendering it
      // immediately (like sendChatMessage does) makes the action feel
      // instant instead of waiting on the round-trip.
      chatAddMessageToState(data, true);
    });
}

function acceptMeetInvite(){
  if(!pendingMeetInvite) return;
  const invite = pendingMeetInvite;
  window.open(invite.link, '_blank', 'noopener');
  voiceSendOneOff(invite.fromId, { type: 'meet-accepted' });
  postMeetResponseMessage(invite, true);
  meetStopRingtone();
  $('incomingMeetBanner').style.display = 'none'; requestAnimationFrame(voiceSetCallStackOffsets); /* v634 */
  pendingMeetInvite = null;
}

function declineMeetInvite(){
  if(!pendingMeetInvite) return;
  const invite = pendingMeetInvite;
  voiceSendOneOff(invite.fromId, { type: 'meet-declined' });
  postMeetResponseMessage(invite, false);
  meetStopRingtone();
  $('incomingMeetBanner').style.display = 'none'; requestAnimationFrame(voiceSetCallStackOffsets); /* v634 */
  pendingMeetInvite = null;
}

$('acceptMeetBtn').addEventListener('click', acceptMeetInvite);
$('declineMeetBtn').addEventListener('click', declineMeetInvite);

// Diagnostic logging attached to every call's RTCPeerConnection — a
// failed ICE negotiation is otherwise a completely silent state change
// (nothing thrown, nothing in console by default), which makes "why
// didn't this call connect" impossible to answer from the console alone.
// This logs which ICE servers were actually offered (URLs only — never
// the TURN username/credential), what candidate types get gathered
// (host/srflx/relay — no 'relay' type showing up means TURN never
// actually got used, even if credentials were fetched fine), and every
// ICE/connection state transition.
function voiceLogIceServers(iceServers){
  console.log('[call] ICE servers offered:', iceServers.map(s => s.urls));
}
function voiceAttachDiagnostics(pc){
  pc.oniceconnectionstatechange = () => console.log('[call] ICE connection state:', pc.iceConnectionState);
  pc.onicegatheringstatechange = () => console.log('[call] ICE gathering state:', pc.iceGatheringState);
}

async function startVoiceCall(calleeId, calleeName){
  if(voiceCallState){ alert('You are already on a call.'); return; }
  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    alert('Voice calling needs microphone access, which this browser/context does not support.');
    return;
  }
  let localStream;
  try{ localStream = await navigator.mediaDevices.getUserMedia({ audio: true }); }
  catch(e){ alert('Microphone access was blocked or unavailable — allow microphone access to make a call.'); return; }

  const outboundChannel = sb.channel('call-signal-' + calleeId);
  await voiceChannelReady(outboundChannel);

  const iceServers = await voiceIceServers();
  voiceLogIceServers(iceServers);
  const pc = new RTCPeerConnection({ iceServers });
  localStream.getTracks().forEach(track => pc.addTrack(track, localStream));
  // Every call starts audio-only, so the only way a video track ever
  // shows up here is the peer sharing their screen mid-call — route by
  // track kind rather than any call-level flag, so this works regardless
  // of message-ordering between this event and the signaling messages
  // that update the screen-share UI (badge/panel).
  pc.ontrack = (e) => {
    $(e.track.kind === 'video' ? 'remoteCallVideo' : 'remoteCallAudio').srcObject = e.streams[0];
  };
  pc.onicecandidate = (e) => {
    if(e.candidate){
      console.log('[call] local ICE candidate:', e.candidate.type, e.candidate.protocol);
      // v709: tagged like the offer it answers, when that offer was re-sent.
      voiceSend(outboundChannel, { type: 'ice-candidate', candidate: e.candidate, tag: (voiceCallState && voiceCallState.pcTag) || undefined });
    }
  };
  voiceAttachDiagnostics(pc);
  pc.onconnectionstatechange = () => voiceOnPcState(pc);   // v707: reconnects instead of ending

  const { data: callRow } = await sb.from('voice_calls').insert({ caller_id: myUserId, callee_id: calleeId }).select().single();

  // v127: same "not actively looking at the dashboard right now" gate as
  // chat push — the in-page incoming-call banner/ringtone already covers
  // someone with the tab open; this is for someone who's stepped away or
  // has the browser closed entirely. Short TTL server-side (see
  // send-push-notification) since a call push that arrives after the
  // 30s ring timeout below is worse than useless — it just reads as a
  // missed call notification for something that already stopped ringing.
  notifyPushRecipients([calleeId], {
    title: `Incoming call from ${myFullName || 'a teammate'}`,
    body: 'Tap to open the dashboard and answer.',
    tag: `call-${callRow ? callRow.id : calleeId}`,
    url: '/' /* v636: was '/dashboard/dashboard.html', which 404s in production -- this portal is served from the ROOT and live/main has no dashboard/ directory at all. Worse than a dead link: sw.js focuses an already-open tab and then navigates it to this url, so clicking any push took a working signed-in portal and broke it. sw.js already defaults to '/' when no url is sent; this was overriding that. */,
    require_interaction: true,
  }, { always: true });   // v700: see notifyPushRecipients

  voiceCallState = { role: 'caller', peerId: calleeId, peerName: calleeName, pc, localStream, outboundChannel, callRowId: callRow ? callRow.id : null, status: 'ringing', remoteDescSet: false, pendingCandidates: [], videoSender: null, screenStream: null, hasScreenShare: false, peerSharing: false, videoPanelMinimized: false, videoPanelMaximized: false, groupId: voiceGenId(), extraPeers: {} };
  // v395: seed the persistent roster — caller connects immediately, callee
  // starts out ringing. See voiceRosterInit()'s own comment for why this
  // is a real DB table rather than something kept only in voiceCallState.
  voiceRosterInit(voiceCallState.groupId);
  // Sequenced, not fired in parallel — RLS only lets you insert a row for
  // someone ELSE once your own row already exists (is_call_participant()),
  // so the callee's row must wait for the caller's own insert to land.
  voiceRosterInsert(voiceCallState.groupId, myUserId, myFullName || myEmail, myUserId, 'connected')
    .then(() => voiceRosterInsert(voiceCallState.groupId, calleeId, calleeName, myUserId, 'ringing'));

  // v395 bug fix: the primary offer never used to carry groupId at all —
  // the callee's handleVoiceSignal('offer') branch fell back to generating
  // its OWN random groupId (msg.groupId || voiceGenId()). That meant if
  // this caller later added a 3rd person via inviteToCall(), that person's
  // own meshDialAll() would send a 'mesh-offer' to the ORIGINAL callee
  // tagged with the caller's real groupId — which never matched the
  // callee's self-generated one, so handleVoiceSignal's groupId check
  // silently dropped it. The 3rd person could hear/be heard by the
  // caller, but never by the original callee. Sending the real groupId
  // here is what makes every participant agree on one id from the start.
  const offer = await pc.createOffer();
  await pc.setLocalDescription(offer);
  voiceSend(outboundChannel, { type: 'offer', sdp: offer, callRowId: voiceCallState.callRowId, groupId: voiceCallState.groupId });
  voiceRepeatOffer(outboundChannel, { type: 'offer-retry', sdp: offer, callRowId: voiceCallState.callRowId, groupId: voiceCallState.groupId });   // v700
  voiceCallState.ringStartedAt = Date.now();
  voiceMarkLive(voiceCallState);   // v709: a refresh keeps this ringing

  voiceShowActiveBar(calleeName, 'Calling…', true);
  voiceStartRingtone('ringback');
  voiceCallState.ringTimeout = setTimeout(() => {
    if(voiceCallState && voiceCallState.status === 'ringing') endVoiceCall('missed', true);
  }, VOICE_RING_MS);
}

// v231: staff calling a CLIENT, in-app — nearly identical to startVoiceCall
// above, just targeting a client_accounts id instead of a profiles id.
// Reuses the exact same signaling shape (a channel named after the
// recipient), which is why nothing on the receiving end needed to change
// for staff-to-staff calls to keep working — see client-portal.html's
// handleClientCallSignal() for the answering side. No push notification
// here (unlike startVoiceCall): notifyPushRecipients()'s can_chat_dm()
// check is staff-to-staff only and would just 403 for a client id, so
// this only rings if the client already has their portal tab open.
async function startVoiceCallToClient(clientId, clientName){
  if(voiceCallState){ alert('You are already on a call.'); return; }
  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    alert('Voice calling needs microphone access, which this browser/context does not support.');
    return;
  }
  let localStream;
  try{ localStream = await navigator.mediaDevices.getUserMedia({ audio: true }); }
  catch(e){ alert('Microphone access was blocked or unavailable — allow microphone access to make a call.'); return; }

  const outboundChannel = sb.channel('call-signal-' + clientId);
  await voiceChannelReady(outboundChannel);

  const iceServers = await voiceIceServers();
  voiceLogIceServers(iceServers);
  const pc = new RTCPeerConnection({ iceServers });
  localStream.getTracks().forEach(track => pc.addTrack(track, localStream));
  pc.ontrack = (e) => {
    $(e.track.kind === 'video' ? 'remoteCallVideo' : 'remoteCallAudio').srcObject = e.streams[0];
  };
  pc.onicecandidate = (e) => {
    if(e.candidate) voiceSend(outboundChannel, { type: 'ice-candidate', candidate: e.candidate });
  };
  voiceAttachDiagnostics(pc);
  pc.onconnectionstatechange = () => voiceOnPcState(pc);   // v707

  const { data: callRow } = await sb.from('voice_calls').insert({ caller_id: myUserId, callee_client_id: clientId }).select().single();

  // v697: the client is now TOLD. The note above ("no push notification
  // here") was the bug the owner hit: a client whose portal was not open
  // never knew they were being called. send-push-notification's client
  // branch checks this staff member can see the client and forwards to the
  // client's phone (the Android app); the in-portal banner still rings for
  // a client who has the portal open.
  sb.functions.invoke('send-push-notification', { body: {
    client_id: clientId,
    title: `Incoming call from ${myFullName || 'PropTech AI'}`,
    body: 'Open the PropTech AI app or client portal to answer.',
    tag: `call-${callRow ? callRow.id : clientId}`, url: '/', require_interaction: true,
    // v783: the Android app rings this as a call (its own channel, full-screen
    // alert) and opens ready to answer, instead of treating it as a chat.
    category: 'voice_call',
  } }).then(({ error }) => { if(error) console.warn('call push to client failed', error); }).catch(() => {});

  voiceCallState = { role: 'caller', isClientCall: true, peerId: clientId, peerName: clientName, pc, localStream, outboundChannel, callRowId: callRow ? callRow.id : null, status: 'ringing', remoteDescSet: false, pendingCandidates: [], videoSender: null, screenStream: null, hasScreenShare: false, peerSharing: false, videoPanelMinimized: false, videoPanelMaximized: false, groupId: voiceGenId(), extraPeers: {} };

  const offer = await pc.createOffer();
  await pc.setLocalDescription(offer);
  voiceSend(outboundChannel, { type: 'offer', sdp: offer, callRowId: voiceCallState.callRowId });
  voiceRepeatOffer(outboundChannel, { type: 'offer-retry', sdp: offer, callRowId: voiceCallState.callRowId });   // v700
  voiceCallState.ringStartedAt = Date.now();
  voiceMarkLive(voiceCallState);   // v709

  voiceShowActiveBar(clientName, 'Calling…', true);
  voiceStartRingtone('ringback');
  voiceCallState.ringTimeout = setTimeout(() => {
    if(voiceCallState && voiceCallState.status === 'ringing') endVoiceCall('missed', true);
  }, VOICE_RING_MS);
}

async function acceptIncomingCall(){
  if(!voiceCallState || voiceCallState.role !== 'callee') return;
  voiceStopRingtone();
  $('incomingCallBanner').style.display = 'none'; requestAnimationFrame(voiceSetCallStackOffsets); /* v634 */
  let localStream;
  try{ localStream = await navigator.mediaDevices.getUserMedia({ audio: true }); }
  catch(e){ alert('Microphone access was blocked or unavailable.'); declineIncomingCall(); return; }

  const outboundChannel = sb.channel('call-signal-' + voiceCallState.peerId);
  await voiceChannelReady(outboundChannel);

  const iceServers = await voiceIceServers();
  voiceLogIceServers(iceServers);
  const pc = new RTCPeerConnection({ iceServers });
  localStream.getTracks().forEach(track => pc.addTrack(track, localStream));
  pc.ontrack = (e) => {
    $(e.track.kind === 'video' ? 'remoteCallVideo' : 'remoteCallAudio').srcObject = e.streams[0];
  };
  pc.onicecandidate = (e) => {
    if(e.candidate){
      console.log('[call] local ICE candidate:', e.candidate.type, e.candidate.protocol);
      // v709: tagged like the offer it answers, when that offer was re-sent.
      voiceSend(outboundChannel, { type: 'ice-candidate', candidate: e.candidate, tag: (voiceCallState && voiceCallState.pcTag) || undefined });
    }
  };
  voiceAttachDiagnostics(pc);
  pc.onconnectionstatechange = () => voiceOnPcState(pc);   // v707: reconnects instead of ending

  // Assign pc (and flush any candidates that arrived while this call was
  // still just ringing, queued above) before creating the answer — this
  // is what closes the gap that used to drop the caller's candidates.
  voiceCallState.pc = pc;
  await pc.setRemoteDescription(new RTCSessionDescription(voiceCallState.offerSdp));
  voiceCallState.remoteDescSet = true;
  await voiceFlushPendingCandidates(voiceCallState);
  const answer = await pc.createAnswer();
  await pc.setLocalDescription(answer);

  voiceCallState.localStream = localStream;
  voiceCallState.outboundChannel = outboundChannel;
  voiceCallState.status = 'answered';
  voiceCallState.startedAt = Date.now();

  voiceSend(outboundChannel, { type: 'answer', sdp: answer });
  if(voiceCallState.callRowId) sb.from('voice_calls').update({ status: 'answered', answered_at: new Date().toISOString() }).eq('id', voiceCallState.callRowId).then(() => {});
  if(voiceMyChannel) voiceSend(voiceMyChannel, { type: 'claimed', callRowId: voiceCallState.callRowId });
  // v395: same accept path whether this was the primary ring or a mid-call
  // "add to call" invite — either way, the caller already inserted this
  // browser's own roster row when they placed the call/sent the invite.
  voiceRosterSetStatus(myUserId, 'connected');

  voiceShowActiveBar(voiceCallState.peerName, 'Connecting…', true);
  voiceStartCallTimer();
  voiceMarkLive(voiceCallState);   // v707
  // v106: if this incoming call was itself an "Add to call" invite (this
  // browser is the person being added), complete the mesh by dialing
  // every other participant directly.
  if(voiceCallState.meshParticipants && voiceCallState.meshParticipants.length) meshDialAll();
}

function declineIncomingCall(){
  if(!voiceCallState || voiceCallState.role !== 'callee') return;
  voiceStopRingtone();
  $('incomingCallBanner').style.display = 'none'; requestAnimationFrame(voiceSetCallStackOffsets); /* v634 */
  voiceSendOneOff(voiceCallState.peerId, { type: 'decline' });
  if(voiceCallState.callRowId) sb.from('voice_calls').update({ status: 'declined', ended_at: new Date().toISOString() }).eq('id', voiceCallState.callRowId).then(() => {});
  voiceRosterSetStatus(myUserId, 'declined');
  voiceRosterTeardown();
  voiceCallState = null;
}

// ---------- screen sharing ----------
// Every call is audio-only at the start (there's no separate "video call"
// mode) — sharing your screen is what adds the one and only video track a
// call can ever have. Either side can start sharing at any point once the
// call is answered; either side can stop; starting again later in the same
// call reuses the same sender rather than renegotiating a second time.

// Recomputes the video panel / badge / button from current state — called
// after any change to hasScreenShare or peerSharing rather than poking the
// DOM inline in three different places, so those two flags are always the
// single source of truth for what's visible.
function voiceUpdateScreenShareUI(){
  const state = voiceCallState;
  if(!state) return;
  const showing = state.hasScreenShare || state.peerSharing;
  $('callScreenShareBtn').classList.toggle('active', !!state.hasScreenShare);

  // Minimize button only makes sense while there's actually a video panel
  // to minimize. Its own icon/title flips between "minimize" (\u2013, panel
  // currently visible) and "restore" (\u25A1, panel currently collapsed) —
  // note this is a purely local display preference: it never touches
  // hasScreenShare/the underlying MediaStreamTrack, so collapsing the
  // preview here does NOT pause or stop the actual share the peer sees.
  const minimizeBtn = $('callMinimizeBtn');
  minimizeBtn.style.display = showing ? 'flex' : 'none';
  if(!showing) state.videoPanelMinimized = false; // don't let a stale minimized flag carry into the next share
  const minimized = showing && state.videoPanelMinimized;
  // v629: was `minimizeBtn.textContent = ...`, which WIPED the SVG icon the
  // moment a share started -- assigning textContent removes every child
  // node. A regression from the v628 icon swap: the button silently
  // reverted to a text glyph mid-call. Both icons now live in the markup
  // and this toggles which one is shown.
  minimizeBtn.classList.toggle('alt', minimized);
  minimizeBtn.title = minimized ? 'Show screen share preview' : 'Minimize screen share preview';

  // v82: same local-only display preference as minimize, just the other
  // direction — the default 860px panel is still too small to read fine
  // detail (a spreadsheet, code, small text) comfortably, so this expands
  // it to fill most of the viewport on demand. Hidden while minimized
  // (nothing to maximize if the panel isn't even showing); un-minimizing
  // restores whatever maximized state was last set, independently.
  const maximizeBtn = $('callMaximizeBtn');
  maximizeBtn.style.display = (showing && !minimized) ? 'flex' : 'none';
  if(!showing) state.videoPanelMaximized = false; // same stale-flag guard as minimized above
  const maximized = showing && !minimized && state.videoPanelMaximized;
  maximizeBtn.classList.toggle('alt', maximized); // v629: same textContent bug as above
  maximizeBtn.title = maximized ? 'Restore screen share preview' : 'Maximize screen share preview';
  $('callVideoPanel').classList.toggle('maximized', maximized);

  $('callVideoPanel').style.display = (showing && !minimized) ? 'block' : 'none';
  if(!state.hasScreenShare) $('localCallVideo').srcObject = null;
  if(!state.peerSharing) $('remoteCallVideo').srcObject = null;
  if(!showing){ $('callScreenShareBadge').style.display = 'none'; return; }
  $('callScreenShareBadge').style.display = 'block';
  $('callScreenShareBadge').textContent = state.hasScreenShare
    ? 'You\u2019re sharing your screen'
    : `${state.peerName || 'They'} are sharing their screen`;
}

// Only hit when this side is adding a video track for the very first time
// in this call (voiceCallState.videoSender is still null) — a brand new
// m-line needs both sides to agree on new SDP, which a plain replaceTrack
// can't do on its own. addTrack() firing negotiationneeded isn't relied on
// here; the offer is created and sent explicitly instead, since we only
// ever want exactly one manual renegotiation per share-session, not
// whatever negotiationneeded happens to fire.
async function voiceRenegotiate(){
  const state = voiceCallState;
  if(!state || !state.pc || !state.outboundChannel) return;
  const offer = await state.pc.createOffer();
  await state.pc.setLocalDescription(offer);
  voiceSend(state.outboundChannel, { type: 'renegotiate-offer', sdp: offer });
}

async function startScreenShare(){
  // v629: THIS FUNCTION USED TO FAIL COMPLETELY SILENTLY, which is what
  // "share screen is not working" actually was. Two separate silent exits:
  //
  //   1. The guard below returned with no word if the call was not yet
  //      answered. The button is only revealed on connect, so that is rare
  //      -- but a click during the last moment of connecting did nothing.
  //   2. `catch(e){ return; }` swallowed EVERY failure on the reasoning
  //      that it meant "person cancelled the picker". Cancelling does land
  //      there -- but so does a browser without screen capture, an
  //      insecure context, a Permissions-Policy block, and (the common one
  //      on macOS) the browser itself lacking the operating system's
  //      Screen Recording permission. All of those produced exactly
  //      nothing: no picker, no message, no console line.
  //
  // Voice calling already got this right -- it capability-checks
  // getUserMedia up front and alerts when the microphone is blocked (see
  // startVoiceCall). Screen share had neither. This brings it into line.
  if(!voiceCallState || !voiceCallState.pc) return;
  if(voiceCallState.status !== 'answered'){
    alert('Wait until the call connects before sharing your screen.');
    return;
  }
  if(voiceCallState.hasScreenShare) return;

  if(!navigator.mediaDevices || !navigator.mediaDevices.getDisplayMedia){
    // Either an old browser or, far more often, a non-secure context:
    // getDisplayMedia is only exposed on HTTPS/localhost.
    alert(window.isSecureContext === false
      ? 'Screen sharing needs a secure (https) connection, and this page is not on one.'
      : 'This browser does not support screen sharing.');
    return;
  }

  let screenStream;
  try{ screenStream = await navigator.mediaDevices.getDisplayMedia({ video: true, audio: false }); }
  catch(e){
    // A genuine cancel is NotAllowedError/AbortError raised almost
    // instantly with no policy wording. A policy or OS-permission block
    // raises the same NotAllowedError, so the message text is what
    // separates them -- imperfect, but the alternative is the silence this
    // is replacing. Always logged either way.
    console.error('[call] getDisplayMedia failed:', e && e.name, e && e.message, e);
    const name = (e && e.name) || '';
    const msg = String((e && e.message) || '');
    // Requires POSITIVE evidence of a block. The first version of this
    // matched the bare word "permission", which is also in Chrome's
    // ordinary user-cancelled message ("Permission denied by user") -- so
    // dismissing the picker popped an alert, which is exactly the nagging
    // the old silent catch existed to avoid. Caught by testing the cancel
    // path, not by reading the regex.
    //
    // Ambiguous NotAllowedError therefore stays SILENT: that preserves the
    // previous behaviour for cancels, and we only speak when the browser
    // actually tells us it was blocked. Chrome reports "Permission denied
    // by system" for the macOS Screen Recording case, which is the common
    // real failure and is caught here.
    const policyBlocked = /by system|policy|disallow|blocked|not supported/i.test(msg);
    if(name === 'NotAllowedError' && !policyBlocked) return; // picker dismissed: stay quiet, as before
    if(name === 'NotFoundError'){
      alert('No screen or window was available to share.');
    } else if(policyBlocked || name === 'NotAllowedError'){
      alert('Your browser blocked screen sharing.\n\nOn macOS this is usually the operating system: System Settings → Privacy & Security → Screen Recording, tick your browser, then restart it.');
    } else if(name === 'NotSupportedError' || name === 'TypeError'){
      alert('This browser does not support screen sharing.');
    } else {
      alert('Screen sharing could not start: ' + (msg || name || 'unknown error'));
    }
    return;
  }
  if(!screenStream || !screenStream.getVideoTracks().length){
    // Defensive: a stream with no video track would set hasScreenShare and
    // light up the UI while sending nothing, which looks identical to the
    // silent failure above.
    console.error('[call] getDisplayMedia returned no video track');
    alert('Screen sharing started but no video track was produced.');
    return;
  }
  const screenTrack = screenStream.getVideoTracks()[0];
  // Covers the browser's own "Stop sharing" bar/button, not just our own
  // toggle — that's a track ending out from under us, not a click here.
  screenTrack.onended = () => { if(voiceCallState && voiceCallState.hasScreenShare) stopScreenShare(); };

  voiceCallState.screenStream = screenStream;
  voiceCallState.hasScreenShare = true;
  voiceUpdateScreenShareUI();
  $('localCallVideo').srcObject = screenStream;

  if(voiceCallState.videoSender){
    // Already shared earlier this call — same sender, just swap the track.
    try{ await voiceCallState.videoSender.replaceTrack(screenTrack); }
    catch(e){ console.error('[call] replaceTrack failed', e); }
    voiceSend(voiceCallState.outboundChannel, { type: 'screenshare-status', sharing: true });
  } else {
    voiceCallState.videoSender = voiceCallState.pc.addTrack(screenTrack, screenStream);
    await voiceRenegotiate();
  }
}

async function stopScreenShare(){
  const state = voiceCallState;
  if(!state || !state.hasScreenShare) return;
  state.hasScreenShare = false;
  if(state.screenStream) state.screenStream.getTracks().forEach(t => t.stop());
  state.screenStream = null;
  voiceUpdateScreenShareUI();
  // Kept as a real (but empty) sender rather than removed — removing a
  // transceiver mid-call would need yet another renegotiation; sending
  // null just stops frames while leaving the m-line as-is, and the same
  // sender is ready to reuse instantly if this side shares again.
  if(state.videoSender){
    try{ await state.videoSender.replaceTrack(null); }
    catch(e){ console.error('[call] replaceTrack(null) failed', e); }
  }
  if(state.outboundChannel) voiceSend(state.outboundChannel, { type: 'screenshare-status', sharing: false });
}

function voiceStartCallTimer(){
  voicePlayConnectSound();
  voiceShowActiveBar(voiceCallState.peerName, '00:00', false);
  $('callScreenShareBtn').style.display = 'flex';
  voiceCallState.durationInterval = setInterval(() => {
    if(!voiceCallState || !voiceCallState.startedAt || voiceCallState.reconnecting) return;   // v707: keep "Reconnecting…" up
    const secs = Math.floor((Date.now() - voiceCallState.startedAt) / 1000);
    $('activeCallStatus').textContent = `${String(Math.floor(secs/60)).padStart(2,'0')}:${String(secs%60).padStart(2,'0')}`;
  }, 1000);
}


// v634: ONE PLACE THAT DECIDES WHERE THE TOP-CENTRE LAYERS SIT.
//
// The active-call bar, the incoming-call card and the Meet invite are all
// top-centre, so they have to queue rather than overlap. This used to be a
// hardcoded `top:110px` on the Meet banner -- which only ever dodged ONE of
// the other two, and silently stopped being right the moment anything above
// it changed height.
//
// Heights are MEASURED off the real elements rather than assumed, because
// the card's height depends on its text: "Adding you to a call with Mariam,
// Eslam..." wraps to two lines where a one-word caller does not.
//
// Order: live call on top (you are in it), then the ringing card, then the
// Meet invite.
function voiceSetCallStackOffsets(){
  var TOP = 20, GAP = 12;
  // NOT offsetParent: that is null for every position:fixed element, which
  // all three of these are, so it reported them all hidden and the whole
  // stack collapsed onto 20px. Caught by measuring the rendered rects.
  var shown = function(el){ return !!el && getComputedStyle(el).display !== 'none'; };
  var h = function(el){ return el ? el.getBoundingClientRect().height : 0; };
  var bar  = document.getElementById('activeCallBar');
  var call = document.getElementById('incomingCallBanner');
  var meet = document.getElementById('incomingMeetBanner');
  var y = TOP;
  if(shown(bar)) y += h(bar) + GAP;
  document.documentElement.style.setProperty('--call-stack-top', y + 'px');
  if(shown(call)) y += h(call) + GAP;
  document.documentElement.style.setProperty('--meet-stack-top', y + 'px');
}

function voiceShowActiveBar(name, status, connecting){
  $('activeCallName').textContent = name || '';
  $('activeCallStatus').textContent = status;
  $('activeCallDot').className = 'call-bar-dot' + (connecting ? ' connecting' : '');
  // v628: the DIALING state is now visible on the bar itself, not just on
  // the 8px dot. The reference marks a call that has not connected yet with
  // a pulsing amber label ("Ringing…"), because "Calling…" and "04:12" in
  // identical styling is the difference between a call in progress and a
  // call nobody has picked up -- the one thing you actually want to know at
  // a glance while you wait.
  $('activeCallBar').classList.toggle('connecting', !!connecting);
  $('activeCallBar').style.display = 'flex';
  requestAnimationFrame(voiceSetCallStackOffsets); // v634
  $('callMuteBtn').classList.remove('muted');
  // Screen share only makes sense once actually connected — voiceStartCallTimer()
  // reveals it; this is just a defensive reset at the start of every call.
  $('callScreenShareBtn').style.display = 'none';
  $('callScreenShareBtn').classList.remove('active');
  $('callMinimizeBtn').style.display = 'none';
  $('callMaximizeBtn').style.display = 'none';
}

// finalStatus: what to write to voice_calls.status — null skips the
// update entirely (used on logout/teardown, where the call's real outcome
// was likely already recorded by whichever event triggered the hangup).
// notifyPeer: whether to tell the other side we're leaving (false when
// THIS end-call call is itself a reaction to the peer's own hangup/decline
// signal, to avoid an infinite reply-to-a-reply loop).
// Posts a one-line system-style note into the DM thread summarizing how
// the call ended — same idea as how iMessage/WhatsApp/Slack show call
// activity inline in the conversation, which this had no equivalent of
// before (voice_calls logs the call, but that table isn't visible in the
// chat UI itself). Only the CALLER posts this — both sides independently
// run endVoiceCall() for the same call (whoever didn't hang up first gets
// here via the 'hangup' signal), so gating on role avoids the same call
// getting summarized twice, once from each side.
function voicePostCallSummary(state, finalStatus){
  if(state.role !== 'caller' || !state.peerId || !finalStatus) return;
  let text;
  if(finalStatus === 'ended' && state.startedAt){
    const secs = Math.floor((Date.now() - state.startedAt) / 1000);
    text = `\u{1F4DE} Call ended \u00b7 ${String(Math.floor(secs/60)).padStart(2,'0')}:${String(secs%60).padStart(2,'0')}`;
  } else if(finalStatus === 'declined'){
    text = '\u{1F4DE} Call declined';
  } else if(finalStatus === 'missed'){
    text = '\u{1F4DE} No answer';
  } else if(finalStatus === 'failed'){
    text = '\u{1F4DE} Call failed to connect';
  } else {
    return;
  }
  // v231: a client call has no chat_messages DM thread to post into — it
  // logs to the client's own conversation (client_chat_messages) instead,
  // same table endClientChatThread() uses for its closing note.
  if(state.isClientCall){
    sb.from('client_chat_messages').insert({ client_id: state.peerId, sender: 'staff', staff_id: myUserId, body: text })
      .then(({ error }) => { if(error) console.error('Failed to post call summary to client chat', error); });
    return;
  }
  sb.from('chat_messages').insert({ sender_id: myUserId, recipient_id: state.peerId, body: text })
    .then(({ error }) => { if(error) console.error('Failed to post call summary to chat', error); });
}

function endVoiceCall(finalStatus, notifyPeer){
  if(!voiceCallState) return;
  const state = voiceCallState;
  clearTimeout(state.ringTimeout);
  clearInterval(state.offerRetry);   // v700
  clearInterval(state.rowWatch);   // v790
  clearInterval(state.durationInterval);
  clearInterval(state.saveTimer);   // v707
  voiceClearReconnect(state);
  voiceClearSavedCall();
  voiceStopRingtone();
  if(state.status === 'answered') voicePlayHangupSound();
  if(state.screenStream) state.screenStream.getTracks().forEach(t => t.stop());
  if(state.pc) state.pc.close();
  if(state.localStream) state.localStream.getTracks().forEach(t => t.stop());
  // v106: close every "Add to call" mesh leg too — this scoped feature
  // ends the whole call for everyone together rather than letting one
  // added person peel off on their own.
  Object.keys(state.extraPeers || {}).forEach(peerId => {
    const peer = state.extraPeers[peerId];
    if(notifyPeer && peer.channel) voiceSend(peer.channel, { type: 'mesh-hangup' });
    if(peer.pc) peer.pc.close();
    if(peer.channel) sb.removeChannel(peer.channel);
    const audioEl = document.getElementById('extraAudio-' + peerId);
    if(audioEl) audioEl.remove();
  });
  // v395: finalize this browser's own roster row (this is the only row
  // it's ever allowed to write for someone else's decision — RLS-wise —
  // but since ending the call closes every extraPeers leg too, this side
  // is also the one best positioned to know it's leaving all of them at
  // once) and tear down the roster subscription/timers for this call.
  if(state.groupId){
    voiceRosterSetStatus(myUserId, finalStatus === 'declined' ? 'declined' : (state.status === 'answered' ? 'left' : 'no_answer'));
    voiceRosterTeardown();
  }
  $('callAddPanel').style.display = 'none';
  $('callParticipantsPanel').style.display = 'none';
  $('callParticipantsBtn').style.display = 'none';
  $('remoteCallAudio').srcObject = null;
  $('remoteCallVideo').srcObject = null;
  $('localCallVideo').srcObject = null;
  $('callVideoPanel').style.display = 'none';
  $('callVideoPanel').classList.remove('maximized');
  $('callScreenShareBadge').style.display = 'none';
  $('callScreenShareBtn').classList.remove('active');
  $('callScreenShareBtn').style.display = 'none';
  $('callMinimizeBtn').style.display = 'none';
  $('callMaximizeBtn').style.display = 'none';
  if(notifyPeer && state.peerId){
    if(state.outboundChannel) voiceSend(state.outboundChannel, { type: 'hangup' });
    else voiceSendOneOff(state.peerId, { type: 'hangup' });
  }
  if(state.outboundChannel) sb.removeChannel(state.outboundChannel);
  if(state.callRowId && finalStatus){
    const update = { status: finalStatus };
    if(finalStatus === 'ended' || finalStatus === 'failed' || finalStatus === 'missed') update.ended_at = new Date().toISOString();
    sb.from('voice_calls').update(update).eq('id', state.callRowId).then(() => {});
  }
  voicePostCallSummary(state, finalStatus);
  $('incomingCallBanner').style.display = 'none'; requestAnimationFrame(voiceSetCallStackOffsets); /* v634 */
  $('activeCallBar').style.display = 'none';
  requestAnimationFrame(voiceSetCallStackOffsets); // v634
  voiceCallState = null;
}

$('acceptCallBtn').addEventListener('click', acceptIncomingCall);
$('declineCallBtn').addEventListener('click', declineIncomingCall);
$('callHangupBtn').addEventListener('click', () => {
  if(!voiceCallState) return;
  endVoiceCall(voiceCallState.status === 'answered' ? 'ended' : 'missed', true);
});
$('callMuteBtn').addEventListener('click', () => {
  if(!voiceCallState || !voiceCallState.localStream) return;
  const track = voiceCallState.localStream.getAudioTracks()[0];
  if(!track) return;
  track.enabled = !track.enabled;
  $('callMuteBtn').classList.toggle('muted', !track.enabled);
});
$('callScreenShareBtn').addEventListener('click', () => {
  if(!voiceCallState) return;
  if(voiceCallState.hasScreenShare) stopScreenShare(); else startScreenShare();
});
$('callMinimizeBtn').addEventListener('click', () => {
  if(!voiceCallState) return;
  voiceCallState.videoPanelMinimized = !voiceCallState.videoPanelMinimized;
  voiceUpdateScreenShareUI();
});
$('callMaximizeBtn').addEventListener('click', () => {
  if(!voiceCallState) return;
  voiceCallState.videoPanelMaximized = !voiceCallState.videoPanelMaximized;
  voiceUpdateScreenShareUI();
});
$('chatCallBtn').addEventListener('click', () => {
  if(!chatActiveConv || chatActiveConv === 'team' || chatActiveConv.startsWith('client:')) return;
  // v638: a group rings everyone in it; a DM still dials the one peer.
  if(chatActiveConv.startsWith('group:')){ startGroupConferenceCall(chatActiveConv.slice(6)); return; }
  startVoiceCall(chatActiveConv, chatConvDisplayName(chatActiveConv));
});

// v638: ring a whole group at once.
//
// Deliberately built on the EXISTING call path rather than a new one: it
// dials the first member with startVoiceCall() -- the same primary-peer
// call a DM makes -- and then hands every remaining member to
// inviteToCall(), which is the same code the "Add someone to this call"
// button has used since v106. So the roster, the per-invitee no-answer
// timer, the participants panel, mute, screen share and hang-up all behave
// exactly as they already do on a call somebody built up by hand. Nothing
// here is a second implementation of calling.
//
// MESH SIZE GUARD. A full mesh is N*(N-1)/2 peer connections and every
// participant uploads their audio to every other one, so it degrades
// without an SFU -- which is the real reason group calling was originally
// left out. Six is a working huddle; past that the warning is honest about
// what will happen rather than letting somebody discover it mid-call.
const CONFERENCE_SOFT_LIMIT = 6;
async function startGroupConferenceCall(groupId){
  const group = chatGroups[groupId];
  if(!group){ alert('That group could not be loaded — try reopening the chat.'); return; }
  const others = (group.members || [])
    .map(m => m.user_id)
    .filter(id => id && id !== myUserId);
  if(!others.length){
    alert("There's nobody else in this group to call yet.");
    return;
  }
  if(others.length + 1 > CONFERENCE_SOFT_LIMIT){
    const ok = confirm(
      'This group has ' + (others.length + 1) + ' people.' +
      String.fromCharCode(10) + String.fromCharCode(10) +
      'Calls here are peer-to-peer, so everyone sends their audio to everyone ' +
      'else. Past about ' + CONFERENCE_SOFT_LIMIT + ' that gets choppy and eats ' +
      'bandwidth.' + String.fromCharCode(10) + String.fromCharCode(10) + 'Ring them all anyway?');
    if(!ok) return;
  }

  const nameOf = (id) => chatContactName(id) || 'Colleague';
  // The first member becomes the primary peer; startVoiceCall() creates the
  // call, its groupId and the roster.
  await startVoiceCall(others[0], nameOf(others[0]));
  // startVoiceCall() bails out on its own (already on a call, no mic, mic
  // blocked) and alerts in each case. If it did, there is nothing to invite
  // anyone into and we must not carry on.
  if(!voiceCallState || !voiceCallState.localStream) return;

  // Sequential, not Promise.all: each invite inserts a call_participants
  // row, and RLS only permits inserting a row for someone else once your
  // own row exists (is_call_participant). Firing them in parallel races
  // that same check the roster seeding already has to sequence around.
  for(const id of others.slice(1)){
    if(!voiceCallState) break; // they hung up mid-fan-out
    try{ await inviteToCall(id, nameOf(id)); }
    catch(e){ console.error('[call] conference invite failed for', id, e); }
  }
}

// ---------- emoji picker ----------
const CHAT_EMOJIS = ['😀','😂','😊','😉','😍','🥰','😎','🤔','😅','😢','😭','😡','👍','👎','🙏','👏','🎉','🔥','💯','✅','❌','❤️','💪','🚀','☕','📞','⏰','📌','👀','🙌'];
function chatBuildEmojiPicker(){
  $('chatEmojiPicker').innerHTML = CHAT_EMOJIS.map(e => `<span>${e}</span>`).join('');
  $('chatEmojiPicker').querySelectorAll('span').forEach(span => {
    span.addEventListener('click', () => {
      const input = $('chatInput');
      const pos = input.selectionStart ?? input.value.length;
      input.value = input.value.slice(0, pos) + span.textContent + input.value.slice(pos);
      input.focus();
      input.setSelectionRange(pos + span.textContent.length, pos + span.textContent.length);
      $('chatEmojiPicker').style.display = 'none';
    });
  });
}
$('chatEmojiBtn').addEventListener('click', () => {
  if($('chatEmojiPicker').innerHTML === '') chatBuildEmojiPicker();
  $('chatEmojiPicker').style.display = $('chatEmojiPicker').style.display === 'none' ? 'grid' : 'none';
  $('chatMentionBox').style.display = 'none';
});

// ---------- file attachments ----------
// v315: shared by the file picker below AND pasting an image/file
// straight into the message box (Ctrl/Cmd+V) — same "stage now, upload on
// Send" flow either way, Telegram/WhatsApp-style.
function chatStagePendingFile(file){
  if(!file) return;
  if(file.size > 15 * 1024 * 1024){
    alert('That file is larger than 15MB — please pick a smaller one.');
    return;
  }
  chatClearPendingFile();
  const isImage = file.type.startsWith('image/');
  chatPendingFile = { file, previewUrl: isImage ? URL.createObjectURL(file) : null };
  const preview = $('chatAttachPreview');
  preview.style.display = 'flex';
  preview.innerHTML = `
    ${isImage ? `<img src="${chatPendingFile.previewUrl}">` : '📎'}
    <span>${escapeHtml(file.name)}</span>
    <span class="chat-attach-remove" title="Remove">&times;</span>
  `;
  preview.querySelector('.chat-attach-remove').addEventListener('click', chatClearPendingFile);
}
$('chatAttachBtn').addEventListener('click', () => $('chatFileInput').click());
$('chatFileInput').addEventListener('change', () => {
  const file = $('chatFileInput').files[0];
  chatStagePendingFile(file);
  $('chatFileInput').value = '';
});
// v315: paste an image (screenshot, copied photo) or file straight into
// the message box — only intercepts when the clipboard actually carries a
// file; a normal text paste falls through untouched.
$('chatInput').addEventListener('paste', (e) => {
  const items = e.clipboardData && e.clipboardData.items;
  if(!items) return;
  for(const item of items){
    if(item.kind === 'file'){
      const file = item.getAsFile();
      if(file){
        e.preventDefault();
        chatStagePendingFile(file.name ? file : new File([file], `pasted-${Date.now()}.${(file.type.split('/')[1] || 'png')}`, { type: file.type }));
      }
      return;
    }
  }
});

// v316: "is typing…" ping — throttled to one broadcast every 2s while
// actively composing, plus an explicit "stopped" the moment the box goes
// empty or 2.5s after the last keystroke (whichever comes first). Scoped
// to DMs and client chats only — see chatTypingSend/chatOnPeerTypingChanged.
$('chatInput').addEventListener('input', () => {
  const key = chatActiveConv;
  if(!key || key === 'team' || key.startsWith('group:')) return;
  clearTimeout(chatTypingStopTimer);
  if($('chatInput').value.trim() === ''){
    chatTypingSend(key, 'stopped');
    chatLastTypingPingAt = 0;
    return;
  }
  const now = Date.now();
  if(now - chatLastTypingPingAt > 2000){
    chatLastTypingPingAt = now;
    chatTypingSend(key, 'typing');
  }
  chatTypingStopTimer = setTimeout(() => { chatTypingSend(key, 'stopped'); chatLastTypingPingAt = 0; }, 2500);
});

// ---------- @mentions ----------
// Tracks the "@partial" token currently being typed (if any) so a chosen
// suggestion knows exactly what span of the input to replace.
let chatMentionStart = -1;
function chatHideMentionBox(){
  chatMentionStart = -1;
  $('chatMentionBox').style.display = 'none';
}
function chatMentionCandidates(){
  const names = chatDirectory.map(p => ({ id: p.id, name: p.full_name || p.email }));
  if(chatActiveConv === 'team') names.unshift({ id: 'everyone', name: 'everyone' });
  return names;
}
$('chatInput').addEventListener('input', () => {
  const input = $('chatInput');
  const pos = input.selectionStart ?? input.value.length;
  const uptoCursor = input.value.slice(0, pos);
  const match = uptoCursor.match(/(?:^|\s)@([\w\s]{0,30})$/);
  if(!match){ chatHideMentionBox(); return; }
  chatMentionStart = pos - match[1].length - 1; // index of the '@'
  const query = match[1].trim().toLowerCase();
  const candidates = chatMentionCandidates().filter(c => c.name.toLowerCase().includes(query)).slice(0, 6);
  if(candidates.length === 0){ chatHideMentionBox(); return; }
  $('chatMentionBox').innerHTML = candidates.map(c => `<div class="chat-mention-item" data-name="${escapeHtml(c.name)}">${escapeHtml(c.name)}</div>`).join('');
  $('chatMentionBox').querySelectorAll('.chat-mention-item').forEach(el => {
    el.addEventListener('click', () => chatInsertMention(el.dataset.name));
  });
  $('chatMentionBox').style.display = 'block';
  $('chatEmojiPicker').style.display = 'none';
});
function chatInsertMention(name){
  const input = $('chatInput');
  const pos = input.selectionStart ?? input.value.length;
  input.value = input.value.slice(0, chatMentionStart) + '@' + name + ' ' + input.value.slice(pos);
  const newPos = chatMentionStart + name.length + 2;
  input.focus();
  input.setSelectionRange(newPos, newPos);
  chatHideMentionBox();
}

$('chatFabBtn').addEventListener('click', () => {
  const opening = $('chatPanel').style.display === 'none';
  $('chatPanel').style.display = opening ? 'flex' : 'none';
  if(opening){
    chatEnsureNotificationPermission();
    if(chatActiveConv){
      chatMarkRead(chatActiveConv); // catch up on anything that arrived while the panel was closed
    }
  }
});

// v695: Desouky's mascot stands BESIDE the open chat panel, placed by
// measuring the panel instead of the fixed right:380px it had. That offset
// was worked out for the v376 panel (340px wide); v625 widened the panel to
// 440px, so ~84px of the mascot sat behind it -- the owner's "not fully
// visible". Left of the panel when there is room, bottom-aligned with it;
// above it when there is not; and hidden only when neither fits (a phone),
// rather than covering the panel's own controls. Called when his thread
// opens, again after the panel's 250ms open animation (its transform skews a
// measurement taken mid-animation), and on every resize.
function positionDesoukyMascot(){
  const wrap = $('desoukyMascotWrap'), panel = $('chatPanel');
  if(!wrap || !panel || wrap.style.display === 'none' || panel.style.display === 'none') return;
  const pr = panel.getBoundingClientRect();
  const ww = wrap.offsetWidth, wh = wrap.offsetHeight, gap = 16, pad = 8;
  let left = pr.left - ww - gap;
  let top = pr.bottom - wh;
  let fits = left >= pad;
  if(!fits){
    left = Math.min(Math.max(pad, pr.right - ww), window.innerWidth - ww - pad);
    top = pr.top - wh - gap;
    fits = top >= pad;
  }
  top = Math.max(pad, Math.min(top, window.innerHeight - wh - pad));
  wrap.style.left = Math.round(left) + 'px';
  wrap.style.top = Math.round(top) + 'px';
  wrap.style.right = 'auto';
  wrap.style.bottom = 'auto';
  wrap.style.visibility = fits ? 'visible' : 'hidden';
}
window.addEventListener('resize', positionDesoukyMascot);

// v122: Desouky's floating mascot — teaser pop-up shown once per browser
// session a couple seconds after the chat widget loads (sessionStorage,
// not localStorage — a nudge that nags every single visit forever stops
// feeling helpful), dismissible, and skipped if the chat panel's already
// open (don't nag someone already in the middle of using it).
function desoukyShowTeaserOnce(){
  try{
    if(sessionStorage.getItem('desoukyTeaserShown')) return;
  }catch(e){ /* ignore — private browsing etc. still shows it, just not "once" */ }
  setTimeout(() => {
    if($('chatPanel').style.display !== 'none') return;
    $('desoukyTeaser').classList.add('show');
    try{ sessionStorage.setItem('desoukyTeaserShown', '1'); }catch(e){}
  }, 2500);
}
function desoukyDismissTeaser(){
  $('desoukyTeaser').classList.remove('show');
}
// Opens the chat panel and jumps straight into Desouky's own DM thread,
// same as clicking Desouky in the conversation list would.
function desoukyOpenChat(){
  desoukyDismissTeaser();
  $('chatPanel').style.display = 'flex';
  chatEnsureNotificationPermission();
  openChatThread(AI_ASSISTANT_BOT_ID);
}
$('desoukyMascotBtn').addEventListener('click', desoukyOpenChat);
if($('desoukySidebarBtn')) $('desoukySidebarBtn').addEventListener('click', desoukyOpenChat);
$('desoukyTeaser').addEventListener('click', desoukyOpenChat);
$('desoukyTeaserCloseBtn').addEventListener('click', (e) => {
  e.stopPropagation();
  desoukyDismissTeaser();
});

// ---------- v723: pending counts + Desouky's sign-in reminder ----------
// The owner: "add the pending number next to [each Leads] subtab ... and the
// Leads tab should show (44)", and "I want Desouky to remind the quality team
// when they sign in what's pending on their queue ... and the team lead with
// Call Back". One RPC, staff_pending_counts() (supabase/v723-...sql), counts
// every queue the way its own sub-tab does, and it is SECURITY INVOKER -- no
// one is shown a number for rows RLS would not let them open:
//   queue_review      pending; not PrimeHome, not a ticket in flight, not a
//                     Sales conversion                 (renderLeadsQueueTable)
//   primehome_unsent  pending PrimeHome Buyers leads with no successful send,
//                     no delivery postback, no manual close
//                     (renderIspdReviewTable's "Not sent")
//   tickets_review    tickets awaiting staff Accept/Reject ('staff_review')
//   call_back         Call Back leads nobody has picked up (+ call_back_mine)
//   disputes_open     Dispute/Feedback still open
//   chats_waiting     client chats routed to staff, not accepted yet
// The Leads total is the three REVIEW queues, as the owner specified
// (1 + 42 + 1 = 44). Call Back has its own badge but is a pickup queue, not a
// review, so it stays out of that sum.
//
// Freshness: realtime on leads / lead_disputes / client_chat_threads (all in
// supabase_realtime -- one unpublished table would silently kill the whole
// channel), settled over 1.5 s, plus a 30 s poll for what realtime does not
// carry (a PrimeHome send writes ispeedtolead_submissions, not published).
const PEND_LEADS_SECTIONS = {
  queue_review: 'queue_review',
  queue_review_ispeedtolead: 'primehome_unsent',
  tickets_review: 'tickets_review',
  call_back: 'call_back',
};
const PEND_LEADS_TOTAL = ['queue_review', 'queue_review_ispeedtolead', 'tickets_review'];
let pendingCounts = null;
let pendingCountsStarted = false;
let pendingCountsSettle = null;
let desoukyRemindDue = false;
let desoukyRemindAutoHide = null;

function pendCanSeeLeads(section){
  const tabs = (myPermissions && myPermissions.allowedTabs) || [];
  return (myIsOwner || tabs.includes('leads')) && canViewLeadsSection(section);
}
// The same test applyRolePermissionsToNav() applies, read back off the button.
function pendNavVisible(tab){
  const b = document.querySelector(`.tab-btn[data-tab="${tab}"]`);
  return !!b && b.style.display !== 'none';
}
function pendSetBadge(el, n){
  if(!el) return;
  el.textContent = n > 99 ? '99+' : String(n);
  el.style.display = n > 0 ? '' : 'none';
}
function renderPendingBadges(){
  if(!pendingCounts) return;
  const seen = section => pendCanSeeLeads(section) ? Number(pendingCounts[PEND_LEADS_SECTIONS[section]] || 0) : 0;
  Object.keys(PEND_LEADS_SECTIONS).forEach(section => {
    pendSetBadge(document.querySelector(`.leads-subtab-btn[data-leads-section="${section}"] .pend-badge`), seen(section));
  });
  pendSetBadge($('leadsNavBadge'), PEND_LEADS_TOTAL.reduce((sum, section) => sum + seen(section), 0));
}
async function refreshPendingCounts(){
  if(!sb || !myUserId) return;
  const { data, error } = await sb.rpc('staff_pending_counts');
  if(error){ console.warn('pending counts:', error.message); return; }
  pendingCounts = data || {};
  renderPendingBadges();
  if(desoukyRemindDue){ desoukyRemindDue = false; setTimeout(desoukyRemindShow, 1200); }
  else if(!$('desoukyRemind').hidden) desoukyRemindRender();
}
function pendingCountsSoon(){
  clearTimeout(pendingCountsSettle);
  pendingCountsSettle = setTimeout(refreshPendingCounts, 1500);
}
// Called from establishSession() once the nav is permissioned.
//
// v723b (the owner: "desouky is not working"). The reminder fired only when
// isNewLogin was true -- but the owner's "Log in as" from User Management
// opens the portal with isNewLogin false, exactly like a refresh, so opening
// the portal as Maya (Quality) showed nothing. Now it fires the first time the
// portal opens for this person in this browser tab -- a sign-in, a "Log in
// as", or a new tab -- remembered per user in sessionStorage, so refreshing
// that tab stays quiet. A real sign-in always shows it.
function desoukyRemindFirstOpen(isNewLogin){
  const key = 'desoukyRemindShown:' + myUserId;
  try{
    if(!isNewLogin && sessionStorage.getItem(key)) return false;
    sessionStorage.setItem(key, '1');
  }catch(e){ return !!isNewLogin; }   // no storage: fall back to sign-in only
  return true;
}
function startPendingCounts(isNewLogin){
  if(desoukyRemindKeys().length && desoukyRemindFirstOpen(isNewLogin)) desoukyRemindDue = true;
  if(pendingCountsStarted){ refreshPendingCounts(); return; }
  const tabs = (myPermissions && myPermissions.allowedTabs) || [];
  if(!myIsOwner && !tabs.includes('leads') && !pendNavVisible('client_chat') && !pendNavVisible('client_disputes')) return;
  pendingCountsStarted = true;
  refreshPendingCounts();
  setInterval(() => { if(!document.hidden) refreshPendingCounts(); }, 30000);
  document.addEventListener('visibilitychange', () => { if(!document.hidden) pendingCountsSoon(); });
  const ch = sb.channel('pending-counts');
  ['leads', 'lead_disputes', 'client_chat_threads'].forEach(table => {
    ch.on('postgres_changes', { event: '*', schema: 'public', table },
      table === 'leads' ? () => { pendingCountsSoon(); callBackLiveSoon(); } : pendingCountsSoon);   // v724
  });
  ch.subscribe();
}

// Who Desouky reminds, and about which queues -- in the order they are listed.
// A queue the person cannot open is left out rather than shown as 0.
const DESOUKY_REMIND_ROLES = {
  'quality': ['client_chat', 'client_disputes', 'queue_review', 'queue_review_ispeedtolead', 'tickets_review'],
  'team leader': ['call_back'],
  'team lead': ['call_back'],
};
const DESOUKY_REMIND_ITEMS = {
  client_chat: { label: 'Client chat', key: 'chats_waiting',
    note: n => `${n === 1 ? 'chat' : 'chats'} waiting to be accepted`,
    can: () => pendNavVisible('client_chat'), go: () => pendOpenTab('client_chat') },
  client_disputes: { label: 'Dispute/Feedback', key: 'disputes_open',
    note: n => n === 1 ? 'open dispute or feedback' : 'open disputes and feedback',
    can: () => pendNavVisible('client_disputes'), go: () => pendOpenTab('client_disputes') },
  queue_review: { label: 'Leads Queue Review', key: 'queue_review',
    note: n => `${n === 1 ? 'lead' : 'leads'} waiting for review`,
    can: () => pendCanSeeLeads('queue_review'), go: () => pendOpenLeads('queue_review') },
  queue_review_ispeedtolead: { label: 'Leads Queue Review — PrimeHome Buyers', key: 'primehome_unsent',
    note: n => `pending ${n === 1 ? 'lead' : 'leads'} not sent yet`,
    can: () => pendCanSeeLeads('queue_review_ispeedtolead'), go: () => pendOpenLeads('queue_review_ispeedtolead') },
  tickets_review: { label: 'Tickets Review', key: 'tickets_review',
    note: n => `${n === 1 ? 'ticket' : 'tickets'} waiting for staff review`,
    can: () => pendCanSeeLeads('tickets_review'), go: () => pendOpenLeads('tickets_review') },
  call_back: { label: 'Call Back', key: 'call_back',
    note: (n, c) => `${n === 1 ? 'call back' : 'call backs'} waiting to be picked up`
      + (Number(c.call_back_mine || 0) ? ` \u00b7 ${c.call_back_mine} picked up by you` : ''),
    can: () => pendCanSeeLeads('call_back'), go: () => pendOpenLeads('call_back') },
};
function desoukyRemindKeys(){
  const role = String(myRole || '').toLowerCase().replace(/[\s_-]+/g, ' ').trim();
  return (DESOUKY_REMIND_ROLES[role] || []).filter(k => DESOUKY_REMIND_ITEMS[k].can());
}
function pendOpenTab(tab){
  const b = document.querySelector(`.tab-btn[data-tab="${tab}"]`);
  if(b) b.click();
}
function pendOpenLeads(section){
  const panel = $('tab-leads');
  if(panel && panel.classList.contains('active')){ activateLeadsSection(section); return; }
  leadsActiveSection = section;   // initLeadsTab() opens this one
  pendOpenTab('leads');
}
function desoukyRemindRender(){
  const keys = desoukyRemindKeys();
  const c = pendingCounts || {};
  const total = keys.reduce((sum, k) => sum + Number(c[DESOUKY_REMIND_ITEMS[k].key] || 0), 0);
  const first = String(myFullName || '').trim().split(/\s+/)[0] || 'there';
  $('desoukyRemindTitle').textContent = total ? `Hi ${first}, here's what's waiting for you` : `Hi ${first}, your queues are clear`;
  $('desoukyRemindSub').textContent = total
    ? `${total} ${total === 1 ? 'item needs' : 'items need'} you right now. Click one to open it.`
    : 'Nothing is waiting on your queues right now.';
  $('desoukyRemindRows').innerHTML = keys.map(k => {
    const it = DESOUKY_REMIND_ITEMS[k];
    const n = Number(c[it.key] || 0);
    return `<button type="button" class="desouky-remind-row${n ? '' : ' zero'}" data-k="${k}">
        <div><div class="desouky-remind-label">${escapeHtml(it.label)}</div><div class="desouky-remind-note">${escapeHtml(it.note(n, c))}</div></div>
        <span class="desouky-remind-count">${n > 999 ? '999+' : n}</span>
      </button>`;
  }).join('');
  $('desoukyRemindRows').querySelectorAll('.desouky-remind-row').forEach(b => {
    b.addEventListener('click', () => { desoukyRemindHide(); DESOUKY_REMIND_ITEMS[b.dataset.k].go(); });
  });
  return total;
}
function desoukyRemindShow(){
  if(!desoukyRemindKeys().length) return;
  const face = $('desoukyRemindFace');
  const art = document.querySelector('#desoukyMascotBtn svg');
  // His own artwork, with its gradient ids renamed: the original sits in a
  // display:none wrapper, and a url(#id) that resolves into a hidden SVG
  // paints nothing in some browsers.
  if(face && !face.firstChild && art) face.innerHTML = art.outerHTML.replace(/id="dsk/g, 'id="dskRm').replace(/#dsk/g, '#dskRm');
  const total = desoukyRemindRender();
  $('desoukyRemind').hidden = false;
  clearTimeout(desoukyRemindAutoHide);
  if(!total) desoukyRemindAutoHide = setTimeout(desoukyRemindHide, 12000);   // all clear: say so, then get out of the way
}
function desoukyRemindHide(){
  clearTimeout(desoukyRemindAutoHide);
  $('desoukyRemind').hidden = true;
}
$('desoukyRemindClose').addEventListener('click', desoukyRemindHide);
$('desoukyRemindOk').addEventListener('click', desoukyRemindHide);
$('chatFabBtn').addEventListener('click', desoukyRemindHide);

$('chatCloseBtn').addEventListener('click', () => {
  $('chatPanel').style.display = 'none';
  if($('desoukyMascotWrap')) $('desoukyMascotWrap').style.display = 'none';
});
$('chatSearchInput').addEventListener('input', (e) => renderChatConvList(e.target.value));
$('chatThreadBackBtn').addEventListener('click', () => {
  if(chatActiveConv && chatActiveConv !== 'team' && !chatActiveConv.startsWith('group:')){
    clearTimeout(chatTypingStopTimer);
    chatTypingSend(chatActiveConv, 'stopped');
  }
  chatCloseClientTypingChannel();
  chatActiveConv = null;
  chatClearPendingFile();
  chatHideMentionBox();
  chatStopRecording(true);
  $('chatThreadView').style.display = 'none';
  $('chatListView').style.display = 'flex';
  renderChatConvList($('chatSearchInput').value);
});
$('chatSendBtn').addEventListener('click', sendChatMessage);

// Opens a fresh instant Google Meet and, once you paste back the
// resulting link (see the note on cross-origin URLs below), both posts
// it as a normal message (the durable record in the thread) AND sends a
// live "meet-invite" signal to whoever's on the other end — same
// per-user Realtime channel voice calls use, just a different message
// type, since there's no WebRTC involved here at all (Google Meet does
// the actual call). They get a pop-up banner with Join/Decline; Join
// opens the SAME link in a new tab for them. For a group, every member
// gets their own invite banner. 'team' is left out of the live invite on
// purpose — broadcasting an accept/decline popup to everyone who can see
// Team Communication for every single Meet click isn't the right
// default; the chat message still reaches them same as before.
//
// No API/OAuth setup needed — meet.google.com/new creates a meeting for
// whoever's signed into Google in that new tab and redirects to its real
// URL, but that URL is cross-origin and only known once the redirect
// finishes, so this page can't read it automatically. The prompt stays
// open while the person switches to the new tab, copies the URL from its
// address bar, and comes back to paste it — cancel or leave it blank to
// just start the call without announcing or inviting anyone.
$('chatMeetBtn').addEventListener('click', () => {
  if(!chatActiveConv) return;
  if(!chatMeetAllowed()) return; // belt-and-suspenders — button should already be hidden for this account
  window.open('https://meet.google.com/new', '_blank', 'noopener');
  const link = prompt('Google Meet is opening in a new tab. Paste the meeting link here to invite this conversation to it (Cancel to skip):');
  if(link === null) return;
  const trimmed = link.trim();
  if(!trimmed) return;
  $('chatInput').value = `\u{1F4F9} Google Meet: ${trimmed}`;
  sendChatMessage();

  const isGroup = chatActiveConv.startsWith('group:');
  let recipientIds = [];
  let meetGroupId = null;
  if(isGroup){
    meetGroupId = chatActiveConv.slice(6);
    recipientIds = ((chatGroups[meetGroupId] && chatGroups[meetGroupId].members) || []).map(m => m.user_id).filter(id => id !== myUserId);
  } else if(chatActiveConv !== 'team'){
    recipientIds = [chatActiveConv];
  }
  recipientIds.forEach(id => voiceSendOneOff(id, { type: 'meet-invite', link: trimmed, groupId: meetGroupId }));
});
