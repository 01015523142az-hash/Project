let leadsAgentTz = {}; // user_id -> IANA timezone string, from schedules.timezone — same shape as Timesheets' tsAgentTz
let leadsIspeedtoleadSendByLeadId = {}; // lead_id -> latest ispeedtolead_submissions row (v69, outbound send status)
// v471: same idea, but split by channel -- 'channel' defaults to
// 'primehome' on every row that predates the gyhomes flow, so these two
// are a clean partition of leadsIspeedtoleadSendByLeadId above, not a
// separate/overlapping data source.
let leadsGyhomesSendByLeadId = {};
let leadsPrimehomeSendByLeadId = {};
// v81: full fetched leads + the helper closures loadLeads() builds each
// run, kept module-level so the new per-subtab column filters (Leads
// Queue Review, Leads Queue Review — PrimeHome Buyers) can re-render
// instantly from already-fetched data on every keystroke/select change,
// without a second round trip. Two independent filter-state objects —
// each subtab's filters are its own, not synced with the other's.
let leadsFullData = [];
// v561: when set, loadLeads() fetches this import batch INSTEAD of the
// dashboard date range — see its use in the leads query for why it has to
// override the range rather than narrow it. Resolved from the Imported
// filter by resolveLeadsImportBatch() below.
let leadsImportBatchFilter = '';
let leadsInboundPostbackByLeadId = {}; // lead_id -> latest ispeedtolead_postbacks row (inbound)
let leadsExtraFieldsLabelFn = () => '';
let leadsExtraFieldsEntriesFn = () => []; // v87 — see extraFieldsEntries() inside loadLeads()
let leadsAgentNameFn = () => '—';
let leadsTaskNameFn = () => 'No campaign';
// v88: the actual "Campaign Name" resolver everywhere in the Leads tab —
// see leadsFormNameFn's assignment in loadLeads() below. leadsTaskNameFn
// above is kept only for task_category_fields-driven extra-field labels
// on old, pre-v83 leads; it no longer drives any "Campaign Name" display.
let leadsFormNameFn = () => 'No campaign';
// Resolved once per loadLeads() — the id of the Submission Form named
// "PrimeHome Buyers" (ISPD_DEFAULT_CAMPAIGN_NAME, defined further down),
// if it exists yet. null until the first CSV/Excel import or manual form
// creation. This is what makes Queue Review vs Queue Review — PrimeHome
// Buyers mutually exclusive: a lead's submission_form_id matching this id
// routes it to the PrimeHome Buyers subtab ONLY; anything else (including
// null) routes to the general subtab ONLY.
let leadsPrimeHomeBuyersFormId = null;
// v107: id of the seeded "Ticket" form (TICKET_FORM_NAME, defined further
// down) — resolved each loadLeads() same as leadsPrimeHomeBuyersFormId.
let leadsTicketFormId = null;
// Opens on what still needs a decision: Pending.
let leadsQueueFilters = { user: '', seller: '', phone: '', task: '', status: 'pending', dateFrom: '', dateTo: '' };
let leadsTicketsFilters = { user: '', seller: '', phone: '', stage: '', dateFrom: '', dateTo: '' };
// v107: 'sent' added — filters Lead Reviewing by whether a lead has been
// sent to PrimeHome Buyers yet ('' = all, 'sent' = a successful send on
// record, 'not_sent' = no send attempt on record at all). Deliberately
// separate from 'Send failed', which stays lumped into 'not_sent' here —
// a failed send still isn't a SENT lead. Applied client-side against the
// already-fetched leadsIspeedtoleadSendByLeadId map, same as every other
// local filter on this subtab.
// Opens on the work still to do: Pending and not yet sent to PrimeHome Buyers.
let leadsIspdFilters = { user: '', seller: '', phone: '', task: '', status: 'pending', dateFrom: '', dateTo: '', sent: 'not_sent', sentChannel: '', sentBy: '', sentDateFrom: '', sentDateTo: '' };

// Resolves which IANA timezone to render a lead's "Submitted at" in, under
// the shared global "Times shown in" toggle — identical convention to
// tsTzFor() on Timesheets and resolveActTz() on the Activity tab: 'agent'
// mode uses that lead's own submitter's schedule timezone (falling back to
// browser-local if they have none), anything else pins every row to that
// one explicit zone.
function leadsTzFor(userId){
  if(globalDisplayTzMode === 'agent') return (userId && leadsAgentTz[userId]) || undefined;
  return globalDisplayTzMode || undefined;
}

// Leads "From"/"To" follow the global Cairo/Chicago "Times shown in" toggle
// — boundaries are computed in that zone so a lead submitted right around
// midnight lands on the calendar day the admin actually expects, not
// whatever day the browser's own clock says.
// v217: NEITHER field defaults to "today" anymore — leaving both blank
// (never picked a range, or explicitly cleared it) now means "no date
// filter at all", i.e. full history, not "just today". A lone "From" with
// no "To" (or vice versa) is an open-ended range in that one direction,
// same as before.
function leadsRangeBounds(){
  const fromVal = $('leadsFromDateInput').value;
  const toVal = $('leadsToDateInput').value || fromVal;
  if(!fromVal && !toVal) return { start: null, end: null };
  let startMs = null, endMs = null;
  if(fromVal){ const [fy, fm, fd] = fromVal.split('-').map(Number); ({ startMs } = dayBoundsMsInZone(globalDisplayTzMode, null, fy, fm, fd)); }
  if(toVal){ const [ty, tm, td] = toVal.split('-').map(Number); ({ endMs } = dayBoundsMsInZone(globalDisplayTzMode, null, ty, tm, td)); }
  return { start: startMs === null ? null : new Date(startMs).toISOString(), end: endMs === null ? null : new Date(endMs).toISOString() };
}
function leadsRangeLabel(){
  const fromVal = $('leadsFromDateInput').value;
  const toVal = $('leadsToDateInput').value || fromVal;
  if(!fromVal && !toVal) return 'All time';
  const fmt = v => { const [y,m,d] = v.split('-').map(Number); return new Date(y, m-1, d).toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' }); };
  if(fromVal && toVal) return fromVal === toVal ? fmt(fromVal) : `${fmt(fromVal)} – ${fmt(toVal)}`;
  return fromVal ? `Since ${fmt(fromVal)}` : `Through ${fmt(toVal)}`;
}

// v134: the date range used to reset to "today" on every page load with
// zero indication it happened — someone could widen it to see historical
// leads, reload the page (or just have their browser tab restore), and
// silently be back to "today" with no visual difference from the range
// they'd actually chosen. Everything downstream (Leads Dashboard, Queue
// Review, PrimeHome Buyers, All Queue) reads this same range, so this one
// silent reset could make the entire tab look empty for no visible reason
// — see CHANGELOG-v134 for the full debugging story that led here.
// Persisted in localStorage, restored on load, saved on every change.
// v257b: bumped to _v2 — a range saved under the old key (from before the
// fixed 2026-07-01..2050-12-31 default existed) would otherwise keep
// getting restored ahead of that new default forever, since restoring a
// saved range always takes priority over filling in a default. Bumping
// the key makes every browser's stale saved range simply not be found
// under the new name, so the new default actually takes effect instead
// of silently never firing for anyone who'd used a date filter before.
const LEADS_DATE_RANGE_STORAGE_KEY = 'ptai_leads_date_range_v2';
function restoreLeadsDateRange(){
  try{
    const saved = JSON.parse(localStorage.getItem(LEADS_DATE_RANGE_STORAGE_KEY) || 'null');
    if(saved && saved.from) $('leadsFromDateInput').value = saved.from;
    if(saved && saved.to) $('leadsToDateInput').value = saved.to;
  }catch(e){ /* corrupt/inaccessible storage — fall through to the normal today default below */ }
}
function saveLeadsDateRange(){
  try{
    localStorage.setItem(LEADS_DATE_RANGE_STORAGE_KEY, JSON.stringify({
      from: $('leadsFromDateInput').value,
      to: $('leadsToDateInput').value,
    }));
  }catch(e){ /* private browsing / storage quota — not worth failing anything over */ }
}
$('leadsFromDateInput').addEventListener('change', () => { saveLeadsDateRange(); loadLeads(); });
$('leadsToDateInput').addEventListener('change', () => { saveLeadsDateRange(); loadLeads(); });

// v192: the actual DB fetch now covers the union of the Dashboard's own
// date range AND every queue-family subtab's own local date filter
// (Queue Review / Tickets Review / PrimeHome Buyers Queue Review / All
// Queue). Previously the fetch was scoped ONLY by the Dashboard's range
// (leadsRangeBounds() above), so widening a queue subtab's own date
// filter past that window silently showed nothing — the underlying data
// had never been fetched in the first place, which read as the date
// filters being "linked" to the Dashboard's range in a confusing way.
// leadsRangeBounds()/leadsRangeLabel() are untouched and still describe
// just the Dashboard's own chosen range, for its own insights caption.
function leadsFetchRangeBounds(){
  const dash = leadsRangeBounds();
  // v217: no Dashboard range chosen at all means "full history" — already
  // the widest possible fetch, so there's nothing for a subtab's own local
  // date filter to widen beyond. Those filters still narrow what's shown
  // client-side per subtab (see leadsRowMatchesFilters()), same as always.
  if(!dash.start && !dash.end) return { start: null, end: null };
  let startMs = dash.start ? new Date(dash.start).getTime() : null;
  let endMs = dash.end ? new Date(dash.end).getTime() : null;
  const extraFromIds = ['leadsQueueDateFromFilter', 'leadsTicketsDateFromFilter', 'leadsIspdDateFromFilter', 'allQueueDateFromFilter'];
  const extraToIds = ['leadsQueueDateToFilter', 'leadsTicketsDateToFilter', 'leadsIspdDateToFilter', 'allQueueDateToFilter'];
  extraFromIds.forEach(id => {
    const el = $(id);
    if(el && el.value){
      const [y, m, d] = el.value.split('-').map(Number);
      const { startMs: s } = dayBoundsMsInZone(globalDisplayTzMode, null, y, m, d);
      if(startMs === null || s < startMs) startMs = s;
    }
  });
  extraToIds.forEach(id => {
    const el = $(id);
    if(el && el.value){
      const [y, m, d] = el.value.split('-').map(Number);
      const { endMs: e } = dayBoundsMsInZone(globalDisplayTzMode, null, y, m, d);
      if(endMs === null || e > endMs) endMs = e;
    }
  });
  return { start: startMs === null ? null : new Date(startMs).toISOString(), end: endMs === null ? null : new Date(endMs).toISOString() };
}

const LEAD_STATUS_META = {
  accepted: { label: 'accepted', dot: 'on', text: 'pct-focus' },
  pending:  { label: 'pending', dot: 'status-break', text: 'text-break' },
  rejected: { label: 'rejected', dot: 'status-idle', text: 'text-idle' },
  call_back: { label: 'call back', dot: 'status-break', text: 'text-break' },
};

// A refund is postbacked by iSpeedToLead the same way a rejection is --
// leads.status stays 'rejected' either way (see the ispeedtolead-postback
// Edge Function's mapStatus()) -- distinguished only by the matched
// postback row's status_raw containing "refund". `postback` is the
// matched ispeedtolead_postbacks row (leadsInboundPostbackByLeadId[r.id]),
// looked up automatically if not passed in. Used by the PrimeHome Buyers
// review table's Status column/filter to tell rejected and refunded
// leads apart even though both share the same underlying lead status.
function isIspdRefundLead(r, postback){
  const p = postback !== undefined ? postback : leadsInboundPostbackByLeadId[r.id];
  return r.status === 'rejected' && !!p && p.mapped_status === 'rejected' && String(p.status_raw || '').toLowerCase().includes('refund');
}

// v564: a lead can reach iSpeedToLead without this system holding a send
// record for it — most often a backfilled postback matched by phone to a
// lead that was created afterwards. A postback is proof of delivery, so
// such a lead must not read as "Not sent".
//
// What it is NOT is proof of a CHANNEL. Both outbound paths submit into
// iSpeedToLead — gyhomes via the coocalls pre-qualification form,
// PrimeHome Buyers via their JSON API — so both produce postbacks.
// Measured live before writing this: of 1,120 leads carrying a postback,
// 665 had a gyhomes send and 447 had a PrimeHome one. Attributing a
// postback to gyhomes would therefore have mislabelled 447 PrimeHome
// deliveries, and that attribution is what the Sent via filter, the
// gyhomes stat card and the per-agent scorecards all read. So this stays
// deliberately channel-agnostic: it reports "delivered", never "via X".
// CORRECTNESS FIX (caught while auditing the 8 postback-only leads):
// a bare "a postback exists" test is NOT delivery evidence. matched_via
// 'phone_ineligible' is the postback function's own reference-only path
// (see ispeedtolead-postback's `referenceOnly`): the phone matched a lead
// that had ALREADY been accepted/rejected, so nothing was applied and
// `applied` stays false. The dashboard's own Postbacks table labels those
// "phone (already decided) — most likely iSpeedToLead resold the same lead
// a second time."
//
// Those postbacks are about some other submission that happens to share a
// phone number. Live proof: 6 of the 7 affected leads were created on
// 08-16 21:37 in one bulk import, while "their" postbacks arrived on
// 08-14/08-15 — the postback predates the lead record, so it cannot be
// reporting on it. Counting them would have marked exactly 7 leads as
// delivered that were never sent.
// v568: a staff assertion that this lead is closed and must not be sent —
// e.g. rejected on the call because the property had already sold, so it
// was never submitted and no provider signal exists. Deliberately a
// separate field from the postback signal, and never written into
// ispeedtolead_postbacks: that table records what iSpeedToLead actually
// said, and its amounts feed Finance. A human decision must stay
// distinguishable from a provider response.
function ispdManuallyDelivered(r){
  return !!r.manual_delivery_at;
}
function ispdHasPostbackDelivery(r){
  const p = leadsInboundPostbackByLeadId[r.id];
  return !!p && p.matched_via !== 'phone_ineligible';
}
// True only when the postback is the ONLY evidence of delivery — i.e.
// there is no send record of our own. That is the case worth labelling
// differently, since everything else already says "Sent <date>".
function ispdPostbackOnlyDelivery(r){
  return ispdHasPostbackDelivery(r) && !(leadsIspeedtoleadSendByLeadId[r.id] || {}).success;
}

// ---------- Leads tab: sub-section navigation + per-section gating (v71) ----------
// Same 2-level pattern as User Management (initUserManagementTab/
// activateUmSection/applyUmSectionEditGating) — see those for the
// original. loadLeads() (below) is the one shared data fetch that
// populates Dashboard's filters/by-agent card, Queue Review's table, AND
// Lead Reviewing's table all in one pass (see its own comments), so most
// of these branches just re-show the right DOM; only Submission Forms has
// its own separate loader.
let leadsActiveSection = null;
function initLeadsTab(){
  document.querySelectorAll('.leads-subtab-btn').forEach(btn => {
    btn.style.display = canViewLeadsSection(btn.dataset.leadsSection) ? '' : 'none';
  });
  const firstVisible = Array.from(document.querySelectorAll('.leads-subtab-btn')).find(b => b.style.display !== 'none');
  const target = (leadsActiveSection && canViewLeadsSection(leadsActiveSection) && document.querySelector(`.leads-subtab-btn[data-leads-section="${leadsActiveSection}"]`)) ? leadsActiveSection : (firstVisible ? firstVisible.dataset.leadsSection : null);   // v717: only a sub-tab Leads still has
  if(target) activateLeadsSection(target);
}
function activateLeadsSection(key){
  leadsActiveSection = key;
  document.querySelectorAll('.leads-subtab-btn').forEach(b => b.classList.toggle('active', b.dataset.leadsSection === key));
  document.querySelectorAll('.leads-section').forEach(s => { s.style.display = (s.id === 'leadsSection-' + key) ? 'block' : 'none'; });
  // Dashboard/Queue Review/Queue Review iSpeedToLead all render off the
  // one shared loadLeads() fetch — cheap enough (one query set) to just
  // always refresh on switch rather than tracking per-section staleness.
  if(key === 'dashboard' || key === 'queue_review' || key === 'queue_review_ispeedtolead' || key === 'tickets_review' || key === 'all_queue') loadLeads();
  // v96/v98: Leads Queue Review's Campaign Fit column needs campaignGuides
  // and the learned keyword memory populated — loaded once per session the
  // first time Queue Review is opened, rather than requiring someone to
  // separately visit Campaign Guide first. loadCampaignGuide() re-renders
  // the table itself once it resolves (see its own comment), so this
  // doesn't need to be awaited here.
  if(key === 'queue_review' && !campaignGuidesLoaded) loadCampaignGuide();
  if(key === 'queue_review' && !campaignCriteriaKeywordsLoaded) loadCampaignCriteriaKeywords();
  // v83: submission_forms is deliberately excluded here — it now has TWO
  // independently-permissioned sub-panels sharing this one leadsSection
  // (Lead Submission / Forms Creator), so a single blanket call using
  // just the 'submission_forms' key would incorrectly apply that
  // permission to Forms Creator's own edit-only elements too (briefly,
  // until initSubmissionFormsSection's own correctly-scoped calls run a
  // moment later — but there's no reason to rely on that race resolving
  // right). initSubmissionFormsSection()/activateSfSection() handle both
  // sub-panels' gating themselves instead.
  if(key === 'submission_forms') initSubmissionFormsSection();
  else if(key === 'leads_dispute') loadDisputesList();
  else if(key === 'all_queue') loadAllQueue();
  else if(key === 'call_back') loadCallBackQueue();
  else applyLeadsSectionEditGating(key);
}
document.querySelectorAll('.leads-subtab-btn').forEach(btn => {
  btn.addEventListener('click', () => activateLeadsSection(btn.dataset.leadsSection));
});
// v137: Refresh buttons now live in each sub-tab's own filter row (see
// the .leads-refresh-btn markup in each leadsSection-* filter card below)
// instead of one shared button floating above the sub-tab nav — re-runs
// that section's own load function rather than re-activating the section
// (activating would also reset column filters/UI state, a re-fetch
// shouldn't).
function refreshLeadsSectionByKey(key){
  if(key === 'submission_forms') initSubmissionFormsSection();
  else if(key === 'leads_dispute') loadDisputesList();
  else if(key === 'all_queue') loadAllQueue();
  else loadLeads(); // dashboard / queue_review / tickets_review / queue_review_ispeedtolead all share this one fetch
}
document.querySelectorAll('.leads-refresh-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    if(btn.disabled) return;
    btn.disabled = true;
    const original = btn.innerHTML;
    btn.innerHTML = '&#8635; Refreshing…';
    await refreshLeadsSectionByKey(btn.dataset.refreshKey);
    btn.innerHTML = original;
    btn.disabled = false;
  });
});
// v83: optional 2nd param — most callers still just pass a key and let
// this find 'leadsSection-' + key itself (unchanged default behavior).
// Submission Forms Creator needs a narrower scope though: it shares the
// same leadsSection-submission_forms parent panel with Lead Submission
// (they're two .sf-section sub-panels toggled inside it, not two separate
// leads_sections' own top-level panels) but is its OWN separately
// grantable permission — so its call passes the specific sub-panel
// element directly rather than letting this derive one from the key.
function applyLeadsSectionEditGating(key, scopeEl){
  const panel = scopeEl || document.getElementById('leadsSection-' + key);
  if(!panel) return;
  const editable = canEditLeadsSection(key);
  panel.querySelectorAll('.edit-only').forEach(el => {
    el.disabled = !editable;
    el.style.opacity = editable ? '' : '0.4';
    el.title = editable ? '' : 'Your role has view-only access to this section';
  });
}

// ---------------------------------------------------------------------------
// v92: Client Submissions (GoHighLevel form submissions)
// ---------------------------------------------------------------------------
// Both subtabs render off the same one fetch (loadClientSubmissions()) —
// same "one shared fetch per tab" convention as Leads above. Forms are
// arbitrary/custom per client, so there's no fixed set of columns to
// display — the Data Form / Client Qualification Form tables' columns, and the "Most
// common answers" analysis, are both derived dynamically from whatever
// keys are actually present in the loaded rows' `fields` jsonb.
let csubAllRows = [];
let csubActiveSection = 'dashboard';

// v95: Data Form / Client Qualification Form routing
// ---------------------------------------------------------------------------
// Which subtab(s) a submission shows up in is driven entirely by whatever
// the client picked in the "Please select one of the following services"
// question — read the same dynamic way every other custom field already is
// (GHL sends it as one of the form's own `fields`, not a fixed schema
// column), so no webhook/schema change was needed for this.
//
// v95: live GHL data confirmed the SAME question can arrive under two
// different labels depending on which part of the payload it came from
// ("Please select one of the following services" in customData vs "Check
// one of the following services" at the top level of a real delivery) —
// both are checked here.
const CSUB_SERVICE_KEY_PATTERN = /(please\s*select|check)\s*one\s*of\s*the\s*following\s*services/i;
const CSUB_DATA_FORM_SERVICES = ['niche list (data order form)', 'skiptracing'];
const CSUB_QUALIFICATION_SERVICES = ['caller only (criteria) form'];
const CSUB_COLD_CALLER_SERVICE = 'cold caller package (criteria + data) form';

function csubServiceValue(row){
  const fields = row.fields || {};
  const key = Object.keys(fields).find(k => CSUB_SERVICE_KEY_PATTERN.test(k));
  return key ? String(fields[key] || '').trim() : '';
}

// Which of 'data' / 'qualification' this submission belongs under. Returns
// an array since Cold Caller package (Criteria + Data) Form is deliberately
// duplicated into BOTH subtabs, per instruction — not routed to just one.
function csubRoutesFor(row){
  const service = csubServiceValue(row).toLowerCase();
  if(!service) return ['data', 'qualification']; // no service value captured — surface everywhere rather than silently drop a real submission
  if(service === CSUB_COLD_CALLER_SERVICE) return ['data', 'qualification'];
  if(CSUB_DATA_FORM_SERVICES.includes(service)) return ['data'];
  if(CSUB_QUALIFICATION_SERVICES.includes(service)) return ['qualification'];
  // A value that doesn't match any of the 4 known services (typo, a 5th
  // option added later in GHL, etc.) — show it on both rather than hiding
  // a real submission because the label didn't match exactly.
  return ['data', 'qualification'];
}

// v95: punctuation/case/whitespace-agnostic normalizer — strips a trailing
// "(...)" suffix, then reduces everything else to lowercase letters/digits/
// spaces. This is deliberately aggressive (drops quotes, slashes, question
// marks, colons entirely) because live GHL data confirmed the exact same
// question shows up with inconsistent punctuation/quote characters between
// the top-level payload and customData copies (e.g. straight vs curly
// quotes around "Asking Price") — matching on the words alone is far more
// reliable than matching exact punctuation.
function csubNormalizeLabel(key){
  return String(key)
    .replace(/\(([^)]+)\)\s*$/, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim()
    .replace(/\s+/g, ' ');
}

// v95: the authoritative field → subtab map, sourced directly from the
// client submission form's own CSV header export — NOT inferred from
// whatever suffix (if any) happens to survive in a given live GHL
// delivery. This is the fix for fields silently defaulting to "shown on
// both" (or the wrong subtab) when GHL's live payload for that field
// arrives without its "(Criteria)"/"(data pulling)" suffix, which is
// common — confirmed live data had e.g. "Market value Source" with no
// suffix at all, even though the source form defines it as Criteria-only.
// Keys here are run through csubNormalizeLabel() before lookup, so exact
// punctuation/suffix differences between deliveries don't matter — only
// the underlying question text does.
const CSUB_FIELD_SECTION_MAP = {
  // Unlabeled / mutual fields — shown on both subtabs, called out
  // explicitly in the instructions (full name, phone, email, "any other
  // details…") plus the service-selector question itself.
  [csubNormalizeLabel('Full Name')]: 'both',
  [csubNormalizeLabel('Phone')]: 'both',
  [csubNormalizeLabel('Email')]: 'both',
  [csubNormalizeLabel('Please select one of the following services')]: 'both',
  [csubNormalizeLabel('Check one of the following services')]: 'both',
  [csubNormalizeLabel('Any other details to help us understand your order?')]: 'both',

  // Data Form fields
  [csubNormalizeLabel('Type of Leads (data pulling)')]: 'data',
  [csubNormalizeLabel('File Upload (Skiptracing)')]: 'data',
  [csubNormalizeLabel('Property Type (data pulling)')]: 'data',

  // Both (data pulling & Criteria)
  [csubNormalizeLabel('Target Market (data pulling & Criteria)')]: 'both',

  // Client Qualification Form fields
  [csubNormalizeLabel('Campaign Name (Criteria)')]: 'qualification',
  [csubNormalizeLabel('Do you want the seller to always have a valid reason for selling or you can accept leads when the seller says that he can sell the property for the right offer ? (Criteria)')]: 'qualification',
  [csubNormalizeLabel('Do you accept listed properties? (Criteria)')]: 'qualification',
  [csubNormalizeLabel('Do you cover Realtor Commission/Fees? (Criteria)')]: 'qualification',
  [csubNormalizeLabel('Do you cover closing fees ? (Criteria)')]: 'qualification',
  [csubNormalizeLabel('Do you need your Cold Caller to ask if the homeowner has an "Asking Price”? (Criteria)')]: 'qualification',
  [csubNormalizeLabel('Do you buy Above or Below Market price or do you accept any motivated seller even if it is Above Market Value? (Criteria)')]: 'qualification',
  [csubNormalizeLabel('Market value Source (Criteria)')]: 'qualification',
  [csubNormalizeLabel('Do you have any property price restrictions? For example, do you only work with properties above or below a specific price range? If so, could you please provide more details? (Criteria)')]: 'qualification',
  [csubNormalizeLabel('What is the maximum closing timeline acceptable? (Criteria)')]: 'qualification',
  [csubNormalizeLabel('Do you accept referrals outside of your targeted market? (Criteria)')]: 'qualification',
  [csubNormalizeLabel('Would you like us to ask about the email address of the seller ? (Criteria)')]: 'qualification',
};

// A field's own trailing "(...)" label — used only as a FALLBACK for a
// field that isn't in CSUB_FIELD_SECTION_MAP yet (e.g. a brand-new
// question added to the live form that hasn't been added to the map
// above). "(Criteria)", "(data pulling)", "(data pulling & Criteria)",
// "(Data order Form)", "(Skiptracing)" decide which subtab(s) — no
// suffix at all falls back to shown-on-both, same as the known-unlabeled
// fields.
function csubFieldSuffix(key){
  const m = String(key).match(/\(([^)]+)\)\s*$/);
  return m ? m[1].trim().toLowerCase() : null;
}
function csubFieldSectionFor(key){
  const known = CSUB_FIELD_SECTION_MAP[csubNormalizeLabel(key)];
  if(known) return known;
  const suffix = csubFieldSuffix(key);
  if(!suffix) return 'both';
  const isDataTagged = suffix.includes('data pulling') || suffix.includes('data order form') || suffix.includes('skiptracing');
  const isCriteriaTagged = suffix.includes('criteria');
  if(isDataTagged && isCriteriaTagged) return 'both';
  if(isDataTagged) return 'data';
  if(isCriteriaTagged) return 'qualification';
  return 'both';
}
function csubFieldBelongsToSection(key, section){
  const sec = csubFieldSectionFor(key);
  return sec === 'both' || sec === section;
}

// v283: Full Name/Phone/Email already have their own fixed Name/Phone/
// Email columns (from contact_name/contact_phone/contact_email) on the
// Data Form and Client Qualification Form tables — CSUB_FIELD_SECTION_MAP
// tags these 'both' so csubFieldBelongsToSection() lets them through into
// the dynamic-column list too, which duplicated them as extra "Full
// Name"/"Phone"/"Email" columns. Same exclusion loadCampaignGuide()'s
// excludedNorms already applies for its own (unrelated) reason.
const CSUB_TABLE_DUPLICATE_FIELDS = new Set([csubNormalizeLabel('Full Name'), csubNormalizeLabel('Phone'), csubNormalizeLabel('Email')]);

// ---------------------------------------------------------------------------
// v101: Campaign Guide — structured sections + typed Pass/Fail evaluation
// ---------------------------------------------------------------------------
// The Client Qualification Form uses a largely fixed/standard set of
// questions across campaigns (same one CSUB_FIELD_SECTION_MAP above already
// keys off of) — CAMPAIGN_GUIDE_FIELD_META below reuses those exact same
// normalized labels to do two more specific things per field:
//   1. which of the guide's display sections it belongs in (Target Market /
//      Seller Qualification / Property Criteria / Pricing & Deal Terms /
//      Referral Policy), so the guide can be laid out as a real document
//      instead of a flat list — and
//   2. how to actually EVALUATE it against a submitted lead (`kind`), for
//      questions specific enough to support a real rule rather than plain
//      string equality.
// A field NOT in this map (a client's own custom question) still gets a
// section via campaignGuideClassifyUnknownField()'s keyword heuristic below,
// just no specific `kind` — it falls through to the pre-existing generic
// campaignGuideFieldPasses()/keyword-learning path exactly as before this
// change, so nothing regresses for non-standard fields.
const CAMPAIGN_GUIDE_SECTION_LABELS = {
  target_market: 'Target Market',
  seller_qualification: 'Seller Qualification Criteria',
  property_criteria: 'Property Criteria',
  pricing_terms: 'Pricing & Deal Terms',
  referral_policy: 'Referral Policy',
  other: 'Additional Criteria',
};

const CAMPAIGN_GUIDE_FIELD_META = {
  [csubNormalizeLabel('Target Market (data pulling & Criteria)')]: { section: 'target_market', kind: 'geo' },
  [csubNormalizeLabel('Do you want the seller to always have a valid reason for selling or you can accept leads when the seller says that he can sell the property for the right offer ? (Criteria)')]: { section: 'seller_qualification', kind: 'valid_reason' },
  [csubNormalizeLabel('Do you accept listed properties? (Criteria)')]: { section: 'property_criteria', kind: 'listing_status' },
  [csubNormalizeLabel('Do you cover Realtor Commission/Fees? (Criteria)')]: { section: 'pricing_terms', informational: true },
  [csubNormalizeLabel('Do you cover closing fees ? (Criteria)')]: { section: 'pricing_terms', informational: true },
  [csubNormalizeLabel('Do you need your Cold Caller to ask if the homeowner has an "Asking Price”? (Criteria)')]: { section: 'pricing_terms', kind: 'must_capture', checklistText: 'Asking Price has been captured' },
  [csubNormalizeLabel('Do you buy Above or Below Market price or do you accept any motivated seller even if it is Above Market Value? (Criteria)')]: { section: 'pricing_terms', kind: 'mv_pricing' },
  [csubNormalizeLabel('Market value Source (Criteria)')]: { section: 'pricing_terms', informational: true },
  [csubNormalizeLabel('Do you have any property price restrictions? For example, do you only work with properties above or below a specific price range? If so, could you please provide more details? (Criteria)')]: { section: 'pricing_terms', kind: 'price_restriction' },
  [csubNormalizeLabel('What is the maximum closing timeline acceptable? (Criteria)')]: { section: 'pricing_terms', kind: 'max_days' },
  [csubNormalizeLabel('Do you accept referrals outside of your targeted market? (Criteria)')]: { section: 'referral_policy', kind: 'referral', informational: true },
  [csubNormalizeLabel('Would you like us to ask about the email address of the seller ? (Criteria)')]: { section: 'other', informational: true },
  [csubNormalizeLabel('Campaign Name (Criteria)')]: { section: 'other', informational: true },
};

// Fallback for a client's own custom question that isn't in the map above —
// bucket it into the closest display section by keyword, so custom fields
// (e.g. a client-specific "Property Types Accepted" question) still show up
// in a sensible place in the structured guide instead of always landing in
// "Additional Criteria". No `kind` is assigned here — evaluation for these
// still goes through the original generic path.
function campaignGuideClassifyUnknownField(normLabel){
  if(/\b(county|counties|state|city|cities|zip|area|market|region)\b/.test(normLabel)) return 'target_market';
  if(/\b(reason|motivat|cooperat|qualif)\b/.test(normLabel)) return 'seller_qualification';
  if(/\b(property|residential|commercial|land|condo|duplex|triplex|fourplex|single family|multi family|listed|listing|mls)\b/.test(normLabel)) return 'property_criteria';
  if(/\b(price|pricing|value|commission|fee|closing|budget|cap|equity|mortgage|lien)\b/.test(normLabel)) return 'pricing_terms';
  if(/\breferral/.test(normLabel)) return 'referral_policy';
  return 'other';
}

function campaignGuideFieldMeta(normLabel){
  const known = CAMPAIGN_GUIDE_FIELD_META[normLabel];
  if(known) return known;
  return { section: campaignGuideClassifyUnknownField(normLabel) };
}

// Extracts the largest "days" figure mentioned in free text, understanding
// "months" (x30) and "weeks" (x7) as well as raw days, and taking the upper
// bound of a range ("1-90 days", "up to 3 months") — used for the closing
// timeline's max_days rule. Returns null if nothing numeric is found at all
// (e.g. a purely descriptive answer with no figure) rather than guessing.
function parseMaxDaysFromText(text){
  const s = String(text || '').toLowerCase();
  if(!s.trim()) return null;
  const nums = [];
  const re = /(\d+(?:\.\d+)?)\s*(day|week|month|year)s?/g;
  let m;
  while((m = re.exec(s))){
    const n = parseFloat(m[1]);
    const unit = m[2];
    const days = unit === 'month' ? n * 30 : unit === 'week' ? n * 7 : unit === 'year' ? n * 365 : n;
    nums.push(days);
  }
  if(nums.length) return Math.max(...nums);
  // no unit at all — a bare number ("30", "1-90") is assumed to be days,
  // same assumption the pre-existing generic numeric fallback already made
  const bare = s.match(/\d+(?:\.\d+)?/g);
  if(bare && bare.length) return Math.max(...bare.map(Number));
  return null;
}

// Loose containment check for the Target Market criterion — true if any
// "place word" (3+ letters, county/state/city names) the guide names also
// appears in what the lead submitted, or vice versa. Deliberately permissive
// (a single shared place name is enough) since a lead form typically asks a
// single County/City/State question, not the full target list back.
function geoTextOverlap(guideValue, leadValue){
  const norm = v => String(v || '').toLowerCase().replace(/[^a-z\s]+/g, ' ').split(/\s+/).filter(w => w.length >= 3);
  const guideWords = new Set(norm(guideValue));
  const leadWords = norm(leadValue);
  if(!guideWords.size || !leadWords.length) return null;
  return leadWords.some(w => guideWords.has(w));
}

// kind-specific evaluators. Each returns 'meets' | 'does_not_meet' | null
// (null = this rule has nothing conclusive to say — falls through to the
// pre-existing generic/keyword path exactly as if there were no kind at all,
// rather than forcing a guess a specific rule can't actually support).
const CAMPAIGN_GUIDE_KIND_EVALUATORS = {
  geo(expected, actual, ctx){
    const overlap = geoTextOverlap(expected, actual);
    if(overlap != null) return overlap ? 'meets' : (ctx.referralOpen ? null : 'does_not_meet');
    return null;
  },
  valid_reason(expected, actual){
    const requiresReason = /valid\s*reason/i.test(String(expected || '')) && !/accept\s*(any|leads)/i.test(String(expected || ''));
    if(!requiresReason) return 'meets'; // client accepts any/no-reason sellers
    return String(actual || '').trim() ? 'meets' : 'does_not_meet';
  },
  listing_status(expected, actual){
    const acceptsListed = /^\s*yes\b/i.test(String(expected || ''));
    if(acceptsListed) return 'meets';
    const act = String(actual || '').toLowerCase();
    if(!act.trim()) return null; // lead's form doesn't say either way
    const soundsOffMarket = /off[\s-]*market|not\s*listed|no\b/.test(act);
    const soundsListed = /\blisted\b|\bmls\b|\byes\b/.test(act) && !soundsOffMarket;
    if(soundsOffMarket) return 'meets';
    if(soundsListed) return 'does_not_meet';
    return null;
  },
  max_days(expected, actual){
    const expDays = parseMaxDaysFromText(expected);
    const actDays = parseMaxDaysFromText(actual);
    if(expDays == null || actDays == null) return null;
    return actDays <= expDays ? 'meets' : 'does_not_meet';
  },
  must_capture(expected, actual){
    const required = /^\s*yes\b/i.test(String(expected || ''));
    if(!required) return 'meets';
    return String(actual == null ? '' : actual).trim() ? 'meets' : 'does_not_meet';
  },
  price_restriction(expected, actual){
    const exp = String(expected || '').trim();
    if(!exp || /^none/i.test(exp)) return 'meets'; // no restriction stated at all
    return null; // free-text restriction — too varied to safely auto-parse, defer to keyword/manual review
  },
  mv_pricing(){ return null; }, // inherently comparative (needs a real market-value lookup) — always defers to keyword/manual review
  referral(){ return null; }, // informational modifier for `geo` above, not evaluated on its own
};

// Whether the guide's OWN answer to a max_days-type question is itself
// non-numeric (e.g. "Yes" typed into a question expecting a number of
// days/months) — surfaced as a warning badge on the guide itself, same as
// the "Open item to confirm with client" callout in a manually-written
// guide, rather than silently treating it as unusable.
function campaignGuideFieldIsAmbiguous(meta, value){
  if(!meta || !meta.kind) return false;
  if(meta.kind === 'max_days') return parseMaxDaysFromText(value) == null && String(value || '').trim() !== '';
  return false;
}

// v95: Skiptracing attachments — File Upload (Skiptracing) comes through
// as one or more URLs (a single string, or an array — GHL sends
// multi-select/multi-file fields as arrays, same as e.g. "Market value
// Source" above). Rendered as one Download button per file instead of a
// raw URL string/array dump.
function csubIsAttachmentField(key){
  return csubNormalizeLabel(key) === csubNormalizeLabel('File Upload (Skiptracing)');
}
// v763: the optional caller script a client uploads while creating a
// campaign. Unlike the Skiptracing upload above, the value is a PATH in the
// private campaign-attachments bucket, not a URL -- so it cannot be rendered
// as a plain href. The button below is signed on click instead.
function csubIsCallerScriptField(key){
  return csubNormalizeLabel(key) === csubNormalizeLabel('Caller Script (attachment)');
}
// One delegated listener rather than per-card wiring: these buttons are
// rebuilt on every guide render, and a signed URL is short-lived so it has to
// be minted at click time anyway.
document.addEventListener('click', async (e) => {
  const b = e.target && e.target.closest ? e.target.closest('.csub-script-open') : null;
  if(!b) return;
  e.preventDefault();
  const path = b.dataset.path;
  if(!path) return;
  const label = b.textContent;
  b.disabled = true; b.textContent = 'Opening…';
  const { data, error } = await sb.storage.from('campaign-attachments').createSignedUrl(path, 3600);
  b.disabled = false; b.textContent = label;
  if(error || !data || !data.signedUrl){
    alert('Could not open the caller script: ' + ((error && error.message) || 'unknown error'));
    return;
  }
  window.open(data.signedUrl, '_blank', 'noopener');
});
// v152: `editable`/`rowId` are optional — every pre-existing caller that
// doesn't pass them keeps behaving exactly as before (plain escaped text).
// Attachment fields (Skiptracing file uploads) are deliberately never made
// editable here — those are download links, not text a person retypes.
function csubFieldValueHtml(key, value, editable, rowId){
  if(csubIsCallerScriptField(key)){
    const pth = Array.isArray(value) ? value[0] : value;
    if(pth == null || String(pth).trim() === '') return '—';
    return `<button type="button" class="btn-secondary csub-script-open" data-path="${escapeHtml(String(pth).trim())}" style="width:auto; padding:4px 10px; font-size:10px; margin:2px 6px 2px 0;">Open caller script</button>`;
  }
  if(csubIsAttachmentField(key)){
    if(value == null || value === '' || (Array.isArray(value) && !value.length)) return '—';
    const urls = (Array.isArray(value) ? value : String(value).split(/[\n,]+/))
      .map(u => String(u).trim()).filter(Boolean);
    if(!urls.length) return '—';
    return urls.map((u, i) => `<a href="${escapeHtml(safeHrefUrl(u))}" target="_blank" rel="noopener" download class="btn-secondary owner-admin-export-only" style="display:inline-block; width:auto; padding:4px 10px; font-size:10px; text-decoration:none; margin:2px 6px 2px 0;">Download${urls.length > 1 ? ' ' + (i + 1) : ''}</a>`).join('');
  }
  const display = Array.isArray(value) ? value.join(', ') : (value == null ? '' : String(value));
  if(editable && rowId){
    return `<span class="csub-editable-cell" contenteditable="true" data-id="${rowId}" data-key="${escapeHtml(key)}" data-original="${escapeHtml(display)}">${escapeHtml(display)}</span>`;
  }
  return display === '' ? '—' : escapeHtml(display);
}

// ---------------------------------------------------------------------------
// v96: Campaign Guide (Leads → Campaign Guide)
// ---------------------------------------------------------------------------
// Built automatically FROM Client Qualification Form data — no separate
// manual-entry step. For each Campaign Name that has a Client Qualification
// Form submission, its own criteria answers (Name/Phone/Email excluded, per
// instruction) become the reference a lead submitted under that same
// Campaign Name gets checked against in Leads Queue Review.
let campaignGuides = {}; // normalized campaign name -> { displayName, submittedAt, fields: [{ normLabel, label, value }] }
let campaignGuidesLoaded = false;

if($('campaignGuideFilterInput')) $('campaignGuideFilterInput').addEventListener('input', debounce(() => {
  campaignGuideFilterText = $('campaignGuideFilterInput').value.trim();
  renderCampaignGuideList();
}, 200));
async function loadCampaignGuide(){
  const listEl = $('campaignGuideList');
  if(listEl && !campaignGuidesLoaded) listEl.innerHTML = '<div class="empty">Loading…</div>';
  // Fetched fresh here (not reused from Client Submissions' own csubAllRows)
  // since Campaign Guide is a different top-level tab and can't assume
  // Client Submissions has already loaded in this session — same table,
  // same routing rule (csubRoutesFor()) as its Client Qualification Form
  // subtab, just queried independently.
  const { data, error } = await sb.from('ghl_form_submissions')
    .select('id, form_name, contact_name, contact_phone, contact_email, submitted_at, fields')
    .order('submitted_at', { ascending: false })
    .limit(1000);
  if(error){
    console.error('Failed to load Campaign Guide data', error);
    if(listEl) listEl.innerHTML = '<div class="empty">Couldn\u2019t load Client Qualification Form data.</div>';
    return;
  }
  const qualRows = (data || []).filter(r => csubRoutesFor(r).includes('qualification'));
  // v104: the Data Form and Client Qualification Form are separate
  // submission EVENTS (separate rows) for the same campaign — a
  // "Property Type" or "Type of Leads" question only ever lives on the
  // Data Form row, so building a guide purely from the qualification row
  // (as before) silently never saw them. Since the Data Form doesn't
  // reliably repeat the same "Campaign Name" question, match it to its
  // campaign via the same contact's email/phone instead (whichever the
  // qualification row itself has on file) — the same client fills both
  // forms with their own contact details.
  const dataRows = (data || []).filter(r => csubRoutesFor(r).includes('data'));
  const normContact = v => String(v || '').trim().toLowerCase();
  const guides = {};
  qualRows.forEach(r => { // already sorted submitted_at desc — first one seen per campaign is the latest
    const campaignName = csubCampaignNameValue(r);
    if(!campaignName) return; // nothing to key this submission's guide by
    const normName = csubNormalizeLabel(campaignName);
    if(guides[normName]) return;
    const excludedNorms = new Set([
      csubNormalizeLabel('Full Name'), csubNormalizeLabel('Phone'), csubNormalizeLabel('Email'),
      csubNormalizeLabel('Campaign Name'), csubNormalizeLabel('Any other details to help us understand your order?'),
      // v291: moved to Client Submissions > Campaign (internal fulfillment
      // logistics, not something a client needs to see on their own guide)
      // — see renderCsubCampaignTable() below.
      csubNormalizeLabel('Dialer (Criteria)'), csubNormalizeLabel('Data Source (Criteria)'), csubNormalizeLabel('Caller Staffing (Criteria)'),
    ]);
    const fields = Object.entries(r.fields || {})
      .filter(([k]) => csubFieldBelongsToSection(k, 'qualification'))
      .filter(([k]) => !CSUB_SERVICE_KEY_PATTERN.test(k))
      .filter(([k]) => !excludedNorms.has(csubNormalizeLabel(k)))
      .filter(([, v]) => v !== '' && v != null && !(Array.isArray(v) && !v.length))
      .map(([k, v]) => ({ normLabel: csubNormalizeLabel(k), label: k, value: Array.isArray(v) ? v.join(', ') : v }));

    // find this same campaign's Data Form submission, if any, by contact
    const matchedDataRow = dataRows.find(d =>
      (r.contact_email && normContact(d.contact_email) === normContact(r.contact_email)) ||
      (r.contact_phone && normContact(d.contact_phone) === normContact(r.contact_phone))
    );
    if(matchedDataRow){
      const existingNormLabels = new Set(fields.map(f => f.normLabel));
      Object.entries(matchedDataRow.fields || {})
        .filter(([k]) => csubFieldBelongsToSection(k, 'data'))
        .filter(([k]) => !CSUB_SERVICE_KEY_PATTERN.test(k))
        .filter(([k]) => !csubIsAttachmentField(k)) // a file-upload URL isn't a criterion
        .filter(([k]) => !excludedNorms.has(csubNormalizeLabel(k)))
        .filter(([k]) => !existingNormLabels.has(csubNormalizeLabel(k))) // don't duplicate a field already pulled from the qualification row (e.g. Target Market, tagged 'both')
        .filter(([, v]) => v !== '' && v != null && !(Array.isArray(v) && !v.length))
        .forEach(([k, v]) => fields.push({ normLabel: csubNormalizeLabel(k), label: k, value: Array.isArray(v) ? v.join(', ') : v }));
    }
    guides[normName] = { displayName: campaignName, submittedAt: r.submitted_at, submissionId: r.id, dataSubmissionId: matchedDataRow ? matchedDataRow.id : null, fields, overridden: false };
  });

  // v100: manual overrides — a campaign a reviewer has actually edited
  // (added/removed/renamed a criterion, changed an expected value) shows
  // its saved override fields instead of whatever's live-derived above.
  // A campaign with an override but no Client Qualification Form
  // submission at all yet (override created from scratch) still needs an
  // entry here, not just a patch onto one that already exists.
  const { data: overrideRows } = await sb.from('campaign_guide_overrides').select('campaign_norm_name, campaign_display_name, fields, updated_at, ai_draft, ai_generated_at, ai_model');
  (overrideRows || []).forEach(o => {
    guides[o.campaign_norm_name] = {
      displayName: o.campaign_display_name,
      submittedAt: (guides[o.campaign_norm_name] || {}).submittedAt || o.updated_at,
      // v282: keep whichever underlying submission id(s) this campaign
      // already had (undefined for a manually-created-from-scratch
      // override with no Client Qualification Form submission at all) --
      // needed by the Owner-only "Delete" button's full-record delete.
      submissionId: (guides[o.campaign_norm_name] || {}).submissionId,
      dataSubmissionId: (guides[o.campaign_norm_name] || {}).dataSubmissionId,
      fields: (o.fields || []).map(f => ({ normLabel: f.normLabel || csubNormalizeLabel(f.label), label: f.label, value: f.value })),
      overridden: true,
      overrideUpdatedAt: o.updated_at,
      // v763: an AI-written guide awaiting sign-off. Callers should not work
      // from it until a human approves, so the card says so loudly.
      aiDraft: !!o.ai_draft,
      aiGeneratedAt: o.ai_generated_at,
      aiModel: o.ai_model,
    };
  });

  campaignGuides = guides;
  campaignGuidesLoaded = true;
  renderCampaignGuideList();
  loadCampaignGuideEditRequests();
  // Re-render Submission Forms Creator's per-form "Load from Campaign
  // Guide" dropdown too, if that panel exists — cheap and idempotent even
  // when it isn't currently visible.
  if($('sfFormsList')) renderSfFormsCreatorList();
  // A campaign guide changing can change every lead's Pass/Review badge —
  // refresh the table live if it's the subtab currently on screen, rather
  // than waiting for the next 20s poll.
  if(leadsActiveSection === 'queue_review' && leadsFullData.length) renderLeadsQueueTable();
}

// ---------------------------------------------------------------------------
// v223: Campaign Resources — free-text reference material (call scripts, QA
// standards, SOPs) per campaign. Separate from the structured Campaign Guide
// fields above (those feed the AI fit evaluator; these are for a human to
// read). Read-only for all staff (RLS: has_dashboard_access()); add/edit/
// delete is Owner/Admin only, both here and via RLS (is_admin()) — this is a
// fixed permission, not the per-role-configurable canEditLeadsSection().
// ---------------------------------------------------------------------------
let campaignResourcesInitialized = false;
let campaignResourcesSelectedNorm = '';
let campaignResourcesEditingId = null;

function campaignResourcesCanManage(){ return myIsOwner || myRole === 'admin'; }

// v281: read-only staff visibility into self-serve campaign subscriptions
// — RLS on client_campaign_subscriptions already permits is_admin() /
// role_has_any_tab('client_submissions'|'leads') to SELECT directly, no
// Edge Function needed for this read (matching how the rest of this tab
// already queries ghl_form_submissions/lead_submission_forms directly).
const CAMPAIGN_SUB_STAFF_STATUS_LABEL = {
  active: 'Active', past_due: 'Payment failed — past due', pause_scheduled: 'Pause scheduled',
  paused: 'Paused', cancel_scheduled: 'Cancellation scheduled', canceled: 'Canceled',
};
// v294: "1 Part-time" / "2 Part-time, 1 Full-time" -- part_time_callers/
// full_time_callers replaced the single caller_tier string as the
// authoritative headcount once mixed tiers became possible (add_caller).
// Every row has both columns backfilled (v294-add-caller-mixed-tiers.sql),
// so this never needs to fall back to the legacy caller_tier field.
function campaignSubTierBreakdown(s){
  const parts = [];
  if(s.part_time_callers) parts.push(`${s.part_time_callers} Part-time`);
  if(s.full_time_callers) parts.push(`${s.full_time_callers} Full-time`);
  return parts.join(', ') || '—';
}

// v338: data choice joined dialer choice as PER-CALLER, so a
// subscription's caller composition is now (tier x dialer choice x data
// choice) -- up to 8 independent groups, mirrored from the client
// portal's campaignSubCallerGroups (itself mirroring client-manage-
// subscription's BUCKET_KEYS/bucketKey() on the backend).
const CAMPAIGN_SUB_BUCKET_KEYS = [
  'part_time_ours_dialer_ours_data', 'part_time_ours_dialer_own_data',
  'part_time_own_dialer_ours_data', 'part_time_own_dialer_own_data',
  'full_time_ours_dialer_ours_data', 'full_time_ours_dialer_own_data',
  'full_time_own_dialer_ours_data', 'full_time_own_dialer_own_data',
];
function campaignSubCallerGroups(s){
  const groups = [];
  ['part_time', 'full_time'].forEach((tier) => {
    ['ours', 'own'].forEach((dialerChoice) => {
      ['ours', 'own'].forEach((dataChoice) => {
        const count = s[`${tier}_${dialerChoice}_dialer_${dataChoice}_data`];
        if(count) groups.push({ tier, dialerChoice, dataChoice, count });
      });
    });
  });
  return groups;
}

// v301: was aggregating records across ALL callers on the subscription --
// used for a single group's "Switch to our data" price, that could show a
// blended total that didn't match what a single-tier group (which is the
// common case) would actually cost. Mirrors the client portal's
// campDataPriceForTier: price for ONE tier's own records count (full-
// time: 10,000 records/$400, part-time: 7,500/$300). Hoisted to module
// scope (v359) since both loadCampaignSubscriptionsStaffList and
// renderStaffManageSubBody need them now.
const CAMPAIGN_SUB_STAFF_DATA_RECORDS_BY_TIER = { part_time: 7500, full_time: 10000 };
const campaignSubStaffDataPriceForTier = (tier) => (((CAMPAIGN_SUB_STAFF_DATA_RECORDS_BY_TIER[tier] || CAMPAIGN_SUB_STAFF_DATA_RECORDS_BY_TIER.full_time)) * 4 / 100).toFixed(0);
const CAMPAIGN_SUB_STAFF_DIALER_PRICE = 200;

// v300: cache of the staff list's rows -- kept so various handlers can
// look up a subscription's current fields without a second round-trip to
// Supabase.
let campaignSubscriptionsStaffCache = [];
// v362: client_id -> Stripe credit balance, in cents (the client's Stripe
// customer.balance when negative -- built up from prorated credits when
// removing/downgrading a caller, auto-applied to their next invoice; same
// value the client's own Billing tab shows them as a banner -- see
// client-manage-subscription's list_my_subscriptions creditBalanceCents).
// NOT skip-trace credits (a separate, unrelated balance tracked in
// client_skiptrace_credits). Populated alongside the list above so both
// the card and the "Manage callers" modal can show it without a second
// round-trip. Owner/Admin only (see loadCampaignSubscriptionsStaffList's
// canManageStripe gate) -- stays empty for anyone else, same as the
// card's own credit badge.
let campaignSubStaffCreditBalanceCentsByClientId = {};
// v506: subscription ids with an already-pending resume payment request
// (client_campaign_payment_requests, status 'pending', converts_
// subscription_id pointing at a canceled row) -- see
// loadCampaignSubscriptionsStaffList's own comment on why this needs a
// separate lookup. Rebuilt on every list load, same lifetime as the
// caches above.
let campaignSubStaffPendingResumeSubIds = new Set();
// v359: redesigned from one dense table (campaign/client/callers-with-
// inline-buttons/data/status/next-billing/actions/delete all crammed into
// one row) to a card per subscription -- same visual language the client
// portal's own Subscriptions subtab uses (renderCampaignSubscriptions).
// Whole-subscription actions (pause/cancel/set billing date/convert to
// paid/delete) stay directly on the card; per-caller actions (convert/
// remove/add) moved into the new "Manage callers" modal -- see
// renderStaffManageSubBody below, same split the client side uses between
// its card and its own Manage subscription modal.
async function loadCampaignSubscriptionsStaffList(){
  const listEl = $('campaignSubscriptionsStaffList');
  if(!listEl) return;
  const { data, error } = await sb.from('client_campaign_subscriptions')
    .select('id, client_id, campaign_display_name, caller_tier, part_time_callers, full_time_callers, dialer_choice, data_choice, status, current_period_end, created_at, has_unpaid_invoice, unpaid_invoice_amount_cents, unpaid_invoice_url, is_complimentary, complimentary_expires_at, ' + CAMPAIGN_SUB_BUCKET_KEYS.join(', ') + ', client_accounts(full_name, company_name, email)')
    .order('created_at', { ascending: false })
    .limit(200);
  if(error){ listEl.innerHTML = '<div class="empty">Couldn’t load campaign subscriptions.</div>'; return; }
  campaignSubscriptionsStaffCache = data || [];
  if(!data || !data.length){ listEl.innerHTML = '<div class="empty">No paid campaign subscriptions yet.</div>'; return; }
  // v368: was myIsOwner || myRole === 'admin' -- now uses this subtab's own
  // granular Edit grant instead. Owner still always passes (isProtected
  // bypass); admin's stored finance_sections.campaign_subscriptions.edit
  // was flipped to true in the same migration that made this change, so
  // admin's own access is unchanged -- this is a strict widening to
  // whatever custom roles get granted from here on, not a behavior change
  // for either of them.
  const canManageStripe = canEditFinanceSection('campaign_subscriptions');
  // v362: Stripe credit balance per client, shown on each card so staff
  // don't have to open Stripe directly to see it before a call (e.g. to
  // explain why an upcoming invoice is smaller than expected). Requires a
  // live Stripe API call per client (there's no local table this is
  // cached in — it's Stripe's own customer.balance), so it's a single
  // batched Edge Function call for every distinct client on this page
  // rather than one request per card. Gated on canManageStripe same as
  // every other Owner/Admin-only action on this card — the Edge Function
  // itself also requires Finance edit access regardless.
  campaignSubStaffCreditBalanceCentsByClientId = {};
  if(canManageStripe){
    const clientIds = [...new Set(data.map(s => s.client_id).filter(Boolean))];
    if(clientIds.length){
      const { data: balData, error: balErr } = await sb.functions.invoke('staff-manage-one-off-charge', { body: { action: 'get_credit_balances', clientIds } });
      if(!balErr && balData && balData.ok !== false && balData.balances){
        campaignSubStaffCreditBalanceCentsByClientId = balData.balances;
      } else {
        console.error('Failed to load Stripe credit balances', balErr || balData);
      }
    }
  }
  // v506: "Resume campaign" (resume_canceled) only ever creates a pending
  // client_campaign_payment_requests row -- the card itself still shows
  // Canceled until the client actually pays (see that action's own
  // comment). Nothing on the card previously told staff a resume request
  // was ALREADY in flight, so clicking Resume again looked like the only
  // option even when one was already awaiting payment under Finance ->
  // Stripe Pending Payment. Looked up the same way loadPendingCampaignPayments
  // reads this table directly (staff already have read access via RLS,
  // same as that subtab) -- scoped to just this page's canceled rows
  // rather than every pending request platform-wide.
  campaignSubStaffPendingResumeSubIds = new Set();
  if(canManageStripe){
    const canceledSubIds = data.filter(s => s.status === 'canceled').map(s => s.id);
    if(canceledSubIds.length){
      const { data: pendingResumeData, error: pendingResumeErr } = await sb.from('client_campaign_payment_requests')
        .select('converts_subscription_id')
        .eq('status', 'pending')
        .in('converts_subscription_id', canceledSubIds);
      if(!pendingResumeErr && pendingResumeData){
        pendingResumeData.forEach(r => { if(r.converts_subscription_id) campaignSubStaffPendingResumeSubIds.add(r.converts_subscription_id); });
      } else if(pendingResumeErr){
        console.error('Failed to load pending resume payment requests', pendingResumeErr);
      }
    }
  }
  listEl.innerHTML = data.map(s => {
    // v310: complimentary campaigns have no real Stripe subscription --
    // caller scaling / dialer-data conversion (all Stripe line-item
    // edits) is blocked for them server-side (staff-manage-campaign-
    // subscription), so canScale excludes them here too.
    // v373: Pause now/Cancel now used to stay available for comp rows too
    // (stripe_subscription_id is null for a comp campaign — see
    // staff-create-campaign — so this only ever worked because the Stripe
    // call 404s and staff-manage-campaign-subscription's resource_missing
    // fallback quietly syncs local status instead; the confirm() text
    // shown to staff also flatly says "Billing stops on the live Stripe
    // subscription right now", which is simply false for a comp row).
    // There's no client Stripe record behind a comp campaign to act on, so
    // these buttons no longer render for one — use the Edit button on its
    // "Active until" date to end it early, or Delete (Owner) to remove it
    // outright.
    const isActiveish = ['active', 'past_due'].includes(s.status);
    const canScale = canManageStripe && isActiveish && !s.is_complimentary;
    const canPauseCancel = canManageStripe && isActiveish && !s.is_complimentary;
    // v369: mirrors canScale's shape but for the opposite case -- editing
    // the active-until date only ever applies to a still-active
    // complimentary campaign (see set_complimentary_expiry's own guards).
    const canEditExpiry = canManageStripe && isActiveish && s.is_complimentary;
    // v395: lets staff add/remove caller CAPACITY on a still-complimentary
    // campaign (set_complimentary_callers — pure local bucket-count edit,
    // no Stripe involved) without first using "Convert to paid". Separate
    // from canScale on purpose: canScale gates the Stripe-charging add/
    // remove/convert actions this same modal also offers for PAID
    // campaigns, which stay blocked for a comp row exactly as before.
    const canManageComplimentaryCallers = canManageStripe && isActiveish && s.is_complimentary;
    // v501: staff picking up a client's phone/email request to bring back a
    // genuinely canceled campaign -- mirrors Convert to paid's shape
    // (creates a pending client_campaign_payment_requests row via the same
    // converts_subscription_id mechanism, then staff uses the existing "Get
    // link" button under Finance -> Stripe Pending Payment to actually
    // charge the client). See resume_canceled's own comment
    // (staff-manage-campaign-subscription/index.ts) for why this needs no
    // new webhook/finalize logic.
    const canResumeCanceled = canManageStripe && s.status === 'canceled';
    // v506: see loadCampaignSubscriptionsStaffList's own comment on
    // campaignSubStaffPendingResumeSubIds -- true when a resume payment
    // request for THIS exact subscription is already awaiting payment, so
    // clicking "Resume campaign" again would just hand back the same
    // pending request (harmless, but worth telling staff before they
    // assume nothing is in flight yet).
    const hasPendingResumePayment = canResumeCanceled && campaignSubStaffPendingResumeSubIds.has(s.id);
    const clientName = (s.client_accounts && (s.client_accounts.company_name || s.client_accounts.full_name)) || '—';
    const campaignSubStaffTz = nonAgentDisplayTz();
    const periodEnd = s.current_period_end ? new Date(s.current_period_end).toLocaleDateString([], campaignSubStaffTz ? { timeZone: campaignSubStaffTz } : {}) : '—';
    const complimentaryExpiry = s.complimentary_expires_at ? new Date(s.complimentary_expires_at).toLocaleDateString([], campaignSubStaffTz ? { timeZone: campaignSubStaffTz } : {}) : '—';
    const clientCreditCents = s.client_id && campaignSubStaffCreditBalanceCentsByClientId.hasOwnProperty(s.client_id) ? campaignSubStaffCreditBalanceCentsByClientId[s.client_id] : null;
    return `
      <div class="card" style="margin-bottom:10px;" data-sub-id="${s.id}">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:10px; flex-wrap:wrap;">
          <div>
            <div style="font-weight:700; font-size:13px;">${escapeHtml(s.campaign_display_name)}</div>
            <div style="font-size:11px; color:var(--text-2); margin-top:2px;">${escapeHtml(clientName)} · ${escapeHtml(campaignSubTierBreakdown(s))} · ${s.data_choice === 'ours' ? 'Our data' : 'Own data'}${clientCreditCents ? ` · <span class="mono" style="color:var(--good);" title="This client's Stripe account balance — auto-applied to their next invoice">$${(clientCreditCents / 100).toFixed(2)} Stripe credit</span>` : ''}</div>
          </div>
          <div style="text-align:right; font-size:11px; color:var(--text-2);">
            <div style="font-weight:700; color:var(--text);">${s.is_complimentary ? '<span class="mono" style="color:var(--focus); text-transform:uppercase; font-size:10px;">Comp</span> · ' : ''}${escapeHtml(CAMPAIGN_SUB_STAFF_STATUS_LABEL[s.status] || s.status)}</div>
            <div style="display:flex; align-items:center; justify-content:flex-end; gap:6px; margin-top:2px;">${s.is_complimentary ? `Active until: ${complimentaryExpiry}${canEditExpiry ? ` <button class="btn-outline campaign-sub-staff-set-expiry-btn" data-id="${s.id}" style="width:auto; padding:3px 10px; font-size:11px;" title="Change this complimentary campaign's active-until date">Edit</button>` : ''}` : `Next billing: ${periodEnd}${canScale ? ` <button class="btn-outline campaign-sub-staff-set-billing-date-btn" data-id="${s.id}" style="width:auto; padding:3px 10px; font-size:11px;" title="Change this subscription's next billing/renewal date">Edit</button>` : ''}`}</div>
          </div>
        </div>
        ${s.has_unpaid_invoice ? `<div style="font-size:11px; color:var(--danger); font-weight:600; margin-top:8px;">${s.unpaid_invoice_amount_cents ? `$${(s.unpaid_invoice_amount_cents / 100).toFixed(2)} unpaid` : 'Payment issue'}${s.unpaid_invoice_url ? ` — <a href="${escapeHtml(s.unpaid_invoice_url)}" target="_blank" rel="noopener" style="color:inherit;">Invoice</a>` : ' (multiple open invoices — see Stripe)'}</div>` : ''}
        ${(!canScale && s.status === 'past_due') ? `<div style="font-size:11px; color:var(--danger); margin-top:8px;">Pay the unpaid invoice before adding or converting callers — removing one is still available from Manage callers.</div>` : ''}
        <div style="display:flex; gap:8px; margin-top:10px; flex-wrap:wrap; align-items:center;">
          ${(canScale || canManageComplimentaryCallers) ? `<button class="btn-outline btn-gold staff-manage-sub-open-btn" data-id="${s.id}" style="width:auto;">Manage callers</button>` : ''}
          ${(s.is_complimentary && canManageStripe && isActiveish) ? `<button class="btn-outline campaign-sub-staff-convert-to-paid-btn" data-id="${s.id}" style="width:auto;" title="Convert this complimentary campaign to a paid subscription">Convert to paid</button>` : ''}
          ${canResumeCanceled ? `<button class="btn-outline btn-gold campaign-sub-staff-resume-canceled-btn" data-id="${s.id}" style="width:auto;" title="Bring this canceled campaign back — same campaign name, lead history, and Campaign Guide">Resume campaign</button>` : ''}
          ${hasPendingResumePayment ? `<span class="mono" style="display:inline-flex; align-items:center; padding:1px 7px; border-radius:10px; background:var(--away-dim); color:var(--away); font-size:10px;" title="A resume payment request for this campaign is already awaiting payment — see Finance → Stripe Pending Payment to get the link">Payment pending</span>` : ''}
          ${canPauseCancel ? `<button class="btn-outline campaign-sub-staff-pause-btn" data-id="${s.id}" style="width:auto;">Pause now</button>` : ''}
          ${canPauseCancel ? `<button class="btn-outline campaign-sub-staff-cancel-btn" data-id="${s.id}" style="width:auto; color:var(--danger); border-color:var(--danger);">Cancel now</button>` : ''}
          ${myIsOwner ? `<button class="btn-outline campaign-sub-delete-btn" data-id="${s.id}" style="width:auto; margin-left:auto; color:var(--danger); border-color:var(--danger);">Delete</button>` : ''}
        </div>
      </div>`;
  }).join('');
}

// v359: "Manage callers" modal body -- mirrors client-portal.html's
// renderManageSubBody almost exactly (same layout, same per-caller
// convert/switch/remove row + add-caller row), just pointed at the
// existing staff button classes/handlers (campaign-sub-staff-* — unchanged
// from before this redesign, see campaignSubStaffListClickHandler) instead
// of the client-facing ones, and phrased for a staff audience (their vs.
// your).
function renderStaffManageSubBody(s){
  const groups = campaignSubCallerGroups(s);
  const manageSubTz = nonAgentDisplayTz();
  const periodEnd = s.current_period_end ? new Date(s.current_period_end).toLocaleDateString([], manageSubTz ? { timeZone: manageSubTz } : {}) : null;
  const isPastDue = s.status === 'past_due';
  const clientName = (s.client_accounts && (s.client_accounts.company_name || s.client_accounts.full_name)) || '—';
  const clientCreditCents = s.client_id && campaignSubStaffCreditBalanceCentsByClientId.hasOwnProperty(s.client_id) ? campaignSubStaffCreditBalanceCentsByClientId[s.client_id] : null;
  // v395: complimentary campaigns get a much simpler add/remove-only view
  // here (set_complimentary_callers — a pure local bucket-count edit, no
  // Stripe involved) instead of the paid flow's convert-tier/dialer/data +
  // Stripe-charging add/remove. See canManageComplimentaryCallers' comment
  // where this card's own "Manage callers" button visibility is decided.
  if(s.is_complimentary){
    return `
      <h3>${escapeHtml(s.campaign_display_name)}</h3>
      <p style="font-size:12px; color:var(--text-2); line-height:1.5; margin-top:-8px;">${escapeHtml(clientName)} — <span class="mono" style="color:var(--focus); text-transform:uppercase; font-size:10px;">Comp</span> campaign. Add or remove caller capacity — no Stripe charge, no billing cycle involved, since this campaign isn't being billed at all. Use "Convert to paid" on the card behind this modal if you want real Stripe billing instead.</p>

      <div style="margin-top:16px;">
        <div style="font-size:11px; font-weight:700; color:var(--text-2); margin-bottom:6px;">Callers on this campaign</div>
        ${groups.map((g, idx) => {
          const tierLabel = g.tier === 'full_time' ? 'Full-time' : 'Part-time';
          const dialerLabel = g.dialerChoice === 'ours' ? 'our dialer' : 'their own dialer';
          const dataLabel = g.dataChoice === 'ours' ? 'our data' : 'their own data';
          return `
          <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap; padding:8px 0; ${idx > 0 ? 'border-top:1px dashed var(--border-light);' : ''}">
            <div style="font-size:12px;">${g.count} × ${tierLabel} — ${dialerLabel}, ${dataLabel}</div>
            <button class="btn-outline campaign-sub-staff-comp-caller-btn" data-id="${s.id}" data-tier="${g.tier}" data-dialer="${g.dialerChoice}" data-data="${g.dataChoice}" data-delta="-1" style="width:auto; color:var(--danger); border-color:var(--danger);">Remove one</button>
          </div>`;
        }).join('') || `<div style="font-size:12px; color:var(--text-2);">${escapeHtml(campaignSubTierBreakdown(s))}</div>`}
      </div>

      <div style="margin-top:16px; border-top:1px solid var(--border-light); padding-top:12px;">
        <div style="font-size:11px; font-weight:700; color:var(--text-2); margin-bottom:6px;">Add a caller (free)</div>
        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
          <select class="campaign-sub-staff-comp-add-tier" data-id="${s.id}" style="width:auto; padding:8px 12px; font-size:12px; border-radius:10px;">
            <option value="part_time">Part-time</option>
            <option value="full_time">Full-time</option>
          </select>
          <select class="campaign-sub-staff-comp-add-dialer" data-id="${s.id}" style="width:auto; padding:8px 12px; font-size:12px; border-radius:10px;">
            <option value="ours">Our dialer</option>
            <option value="own">Own dialer</option>
          </select>
          <select class="campaign-sub-staff-comp-add-data" data-id="${s.id}" style="width:auto; padding:8px 12px; font-size:12px; border-radius:10px;">
            <option value="own" selected>Own data</option>
            <option value="ours">Our data</option>
          </select>
          <button class="btn-primary campaign-sub-staff-comp-caller-btn" data-id="${s.id}" data-delta="1" style="width:auto;">+ Add caller</button>
        </div>
      </div>

      <div class="modal-actions">
        <button class="btn-secondary" onclick="closeStaffManageSubModal()">Close</button>
      </div>
    `;
  }
  return `
    <h3>${escapeHtml(s.campaign_display_name)}</h3>
    <p style="font-size:12px; color:var(--text-2); line-height:1.5; margin-top:-8px;">${escapeHtml(clientName)}${clientCreditCents ? ` · <span class="mono" style="color:var(--good);" title="This client's Stripe account balance — auto-applied to their next invoice">$${(clientCreditCents / 100).toFixed(2)} Stripe credit</span>` : ''} — convert an existing caller's tier, dialer, or data source, add more callers, or remove one. Changes apply immediately, prorated for the rest of this billing cycle${periodEnd ? ` (through ${periodEnd})` : ''}.</p>
    <!-- v362: added here so changing the billing cycle doesn't require
         leaving this modal and hunting for the small "Edit" link on the
         card behind it (that one's still there too, just easier to see
         now — same campaign-sub-staff-set-billing-date-btn handler, bound
         on this modal's body too, so it works from either place). -->
    <div style="display:flex; align-items:center; gap:8px; margin-top:10px; font-size:12px; color:var(--text-2);">
      <span>Next billing: <strong style="color:var(--text);">${periodEnd || '—'}</strong></span>
      <button class="btn-outline campaign-sub-staff-set-billing-date-btn" data-id="${s.id}" style="width:auto; padding:4px 12px; font-size:11px;" title="Change this subscription's next billing/renewal date">Change billing date</button>
    </div>
    ${isPastDue ? `<div class="msg error" style="margin-top:10px;">This subscription has a failed payment. Pay the outstanding invoice before adding or converting callers — removing one is still available below.</div>` : ''}

    <div style="margin-top:16px;">
      <div style="font-size:11px; font-weight:700; color:var(--text-2); margin-bottom:6px;">Callers on this campaign</div>
      ${groups.map((g, idx) => {
        const tierLabel = g.tier === 'full_time' ? 'Full-time' : 'Part-time';
        const otherTier = g.tier === 'full_time' ? 'part_time' : 'full_time';
        const otherTierLabel = otherTier === 'full_time' ? 'Full-time' : 'Part-time';
        const dialerLabel = g.dialerChoice === 'ours' ? 'our dialer' : 'their own dialer';
        const otherDialer = g.dialerChoice === 'ours' ? 'own' : 'ours';
        const otherDialerLabel = otherDialer === 'ours' ? `our dialer (+$${CAMPAIGN_SUB_STAFF_DIALER_PRICE}/mo)` : 'their own dialer';
        const dataLabel = g.dataChoice === 'ours' ? 'our data' : 'their own data';
        const otherData = g.dataChoice === 'ours' ? 'own' : 'ours';
        const otherDataLabel = otherData === 'ours' ? `our data ($${campaignSubStaffDataPriceForTier(g.tier)}/mo)` : 'their own data';
        return `
        <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap; padding:8px 0; ${idx > 0 ? 'border-top:1px dashed var(--border-light);' : ''}">
          <div style="font-size:12px;">${g.count} × ${tierLabel} — ${dialerLabel}, ${dataLabel}</div>
          <div style="display:flex; gap:6px; flex-wrap:wrap;">
            ${isPastDue ? '' : `<button class="btn-outline campaign-sub-staff-convert-tier-btn" data-id="${s.id}" data-from-tier="${g.tier}" data-from-dialer="${g.dialerChoice}" data-from-data="${g.dataChoice}" data-to-tier="${otherTier}" data-to-dialer="${g.dialerChoice}" data-to-data="${g.dataChoice}" style="width:auto;">Convert to ${otherTierLabel}</button>`}
            ${isPastDue ? '' : `<button class="btn-outline campaign-sub-staff-convert-dialer-btn" data-id="${s.id}" data-from-tier="${g.tier}" data-from-dialer="${g.dialerChoice}" data-from-data="${g.dataChoice}" data-to-tier="${g.tier}" data-to-dialer="${otherDialer}" data-to-data="${g.dataChoice}" style="width:auto;">Switch to ${otherDialerLabel}</button>`}
            ${isPastDue ? '' : `<button class="btn-outline campaign-sub-staff-convert-data-btn" data-id="${s.id}" data-from-tier="${g.tier}" data-from-dialer="${g.dialerChoice}" data-from-data="${g.dataChoice}" data-to-tier="${g.tier}" data-to-dialer="${g.dialerChoice}" data-to-data="${otherData}" style="width:auto;">Switch to ${otherDataLabel}</button>`}
            <button class="btn-outline campaign-sub-staff-remove-caller-btn" data-id="${s.id}" data-tier="${g.tier}" data-dialer="${g.dialerChoice}" data-data="${g.dataChoice}" style="width:auto; color:var(--danger); border-color:var(--danger);">Remove one</button>
          </div>
        </div>`;
      }).join('') || `<div style="font-size:12px; color:var(--text-2);">${escapeHtml(campaignSubTierBreakdown(s))}</div>`}
    </div>

    ${isPastDue ? '' : `
    <div style="margin-top:16px; border-top:1px solid var(--border-light); padding-top:12px;">
      <div style="font-size:11px; font-weight:700; color:var(--text-2); margin-bottom:6px;">Add a caller</div>
      <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
        <select class="campaign-sub-staff-add-caller-tier" data-id="${s.id}" style="width:auto; padding:8px 12px; font-size:12px; border-radius:10px;">
          <option value="part_time">Part-time</option>
          <option value="full_time">Full-time</option>
        </select>
        <select class="campaign-sub-staff-add-caller-dialer" data-id="${s.id}" style="width:auto; padding:8px 12px; font-size:12px; border-radius:10px;">
          <option value="ours">Our dialer (+$${CAMPAIGN_SUB_STAFF_DIALER_PRICE}/mo)</option>
          <option value="own">Own dialer</option>
        </select>
        <!-- v338: data choice is genuinely per-caller now, same as dialer
             -- this dropdown sets what THIS new caller uses, no longer a
             shared subscription-wide setting. "Our data" price/records
             tracks whichever tier is currently selected next to it, see
             campaignSubStaffAddCallerTierChangeHandler. -->
        <select class="campaign-sub-staff-data-choice" data-id="${s.id}" title="Data source for this caller" style="width:auto; padding:8px 12px; font-size:12px; border-radius:10px;">
          <option value="own" selected>Own data</option>
          <option value="ours" class="campaign-sub-staff-data-choice-ours-option">Our data (${CAMPAIGN_SUB_STAFF_DATA_RECORDS_BY_TIER.part_time.toLocaleString()} records / $${campaignSubStaffDataPriceForTier('part_time')}/mo)</option>
        </select>
        <button class="btn-primary campaign-sub-staff-add-caller-btn" data-id="${s.id}" style="width:auto;">+ Add caller</button>
      </div>
    </div>`}

    <div class="modal-actions">
      <button class="btn-secondary" onclick="closeStaffManageSubModal()">Close</button>
    </div>
  `;
}
function openStaffManageSubModal(subscriptionId){
  const s = campaignSubscriptionsStaffCache.find(x => x.id === subscriptionId);
  if(!s) return;
  $('staffManageSubModalBody').innerHTML = renderStaffManageSubBody(s);
  $('staffManageSubModalOverlay').classList.add('active');
}
function closeStaffManageSubModal(){
  $('staffManageSubModalOverlay').classList.remove('active');
  $('staffManageSubModalBody').innerHTML = '';
}
if($('campaignSubscriptionsStaffList')) $('campaignSubscriptionsStaffList').addEventListener('click', (e) => {
  const openBtn = e.target.closest('.staff-manage-sub-open-btn');
  if(openBtn) openStaffManageSubModal(openBtn.dataset.id);
});
if($('staffManageSubModalOverlay')) $('staffManageSubModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'staffManageSubModalOverlay') closeStaffManageSubModal(); });

// v293: staff-initiated IMMEDIATE pause/cancel (staff-manage-campaign-
// subscription) -- unlike the client's own Request pause/cancel (which
// impose a 14-day delay by design), these take effect on the live Stripe
// subscription the moment staff clicks, for cases like a client who
// cancelled by phone/email and shouldn't keep being billed while the
// delayed flow would otherwise still be pending. v368: Owner/Admin or a
// role granted Finance edit + this subtab's own Edit (canManageStripe),
// enforced server-side via checkFinanceEditAccess() regardless of what
// canManageStripe hides client-side -- was hardcoded Owner/Admin only
// before this.
// v294: staff-initiated "add a caller" -- same live-Stripe, prorated
// scaling as the client's own Billing-tab control (staff-manage-campaign-
// subscription's add_caller action), for a client who asked to add a
// caller by phone/chat rather than doing it themselves.
// v338: switch_data (subscription-wide) removed -- data source is now
// per-caller, same as dialer already was. The old "Switch to our data"
// button/action is gone; per-caller data switching goes through the
// campaign-sub-staff-convert-data-btn handler below, which calls
// move_caller with only the data leg of the (tier, dialer, data) triple
// changed. This dropdown's value is only read when + Add caller is
// clicked (bundled into that one action, same as the client portal's
// equivalent). All this listener does is keep its "Our data" option's
// price/records synced to whichever tier is currently selected next to it.
// v359: named + attached to both the card list and the "Manage callers"
// modal, same reasoning as campaignSubStaffListClickHandler above (the
// add-caller row this watches now only ever renders inside the modal,
// but this stays dual-attached in case that changes again).
// LOW FIX (audit_chunk4.md #5): used to re-derive the same records/price
// numbers independently (a duplicate { part_time: 7500, full_time: 10000 }
// map + its own * 4 / 100 formula) instead of calling the canonical
// CAMPAIGN_SUB_STAFF_DATA_RECORDS_BY_TIER / campaignSubStaffDataPriceForTier
// above -- display-only (the real charge is computed server-side) but a
// maintenance trap if either ever changes in one place and not the other.
function campaignSubStaffAddCallerTierChangeHandler(e){
  const tierSelect = e.target.closest('.campaign-sub-staff-add-caller-tier');
  if(!tierSelect) return;
  const dataSelect = document.querySelector(`.campaign-sub-staff-data-choice[data-id="${tierSelect.dataset.id}"]`);
  const oursOption = dataSelect ? dataSelect.querySelector('.campaign-sub-staff-data-choice-ours-option') : null;
  if(!oursOption) return;
  const records = CAMPAIGN_SUB_STAFF_DATA_RECORDS_BY_TIER[tierSelect.value] || CAMPAIGN_SUB_STAFF_DATA_RECORDS_BY_TIER.full_time;
  const price = campaignSubStaffDataPriceForTier(tierSelect.value);
  oursOption.textContent = `Our data (${records.toLocaleString()} records / $${price}/mo)`;
}
if($('campaignSubscriptionsStaffList')) $('campaignSubscriptionsStaffList').addEventListener('change', campaignSubStaffAddCallerTierChangeHandler);
if($('staffManageSubModalBody')) $('staffManageSubModalBody').addEventListener('change', campaignSubStaffAddCallerTierChangeHandler);
// v339: same "ask via prompt at click-time instead of a persistent input"
// change as client-portal.html's campaignSubAskPromoCode -- see that
// function's comment for the full rationale.
function campaignSubStaffAskPromoCode(){
  const value = window.prompt('Discount code (optional) — leave blank if none:', '');
  const trimmed = (value || '').trim();
  return trimmed || undefined;
}
// v359: named so it can be attached to BOTH the card list (pause/cancel/
// convert-to-paid/set-billing-date/delete, which stayed on the card) AND
// the new "Manage callers" modal (add/remove/convert caller, which moved
// there) -- same split the client portal's own Subscriptions subtab
// uses (renderCampaignSubscriptions vs renderManageSubBody). Reads only
// e.target, never e.currentTarget, so the exact same function body is
// correct regardless of which element it's bound to.
// v359: reloads the card list, and if the "Manage callers" modal is
// currently open for the subscription just acted on, also re-renders its
// body with the fresh data (add/remove/convert caller can all be
// triggered from inside that modal now) -- without this the modal would
// keep showing stale caller counts until closed and reopened.
async function refreshCampaignSubStaffList(subscriptionIdForModal){
  await loadCampaignSubscriptionsStaffList();
  if(subscriptionIdForModal && $('staffManageSubModalOverlay') && $('staffManageSubModalOverlay').classList.contains('active')){
    const s = campaignSubscriptionsStaffCache.find(x => x.id === subscriptionIdForModal);
    if(s) $('staffManageSubModalBody').innerHTML = renderStaffManageSubBody(s);
    else closeStaffManageSubModal();
  }
}
async function campaignSubStaffListClickHandler(e){
  // v395: complimentary-campaign add/remove — set_complimentary_callers,
  // a pure local bucket-count edit (no Stripe, no proration, no promo
  // code prompt) — see renderStaffManageSubBody's is_complimentary branch.
  const compCallerBtn = e.target.closest('.campaign-sub-staff-comp-caller-btn');
  if(compCallerBtn){
    const delta = Number(compCallerBtn.dataset.delta);
    let tier, dialerChoice, dataChoice;
    if(delta > 0){
      const tierSelect = document.querySelector(`.campaign-sub-staff-comp-add-tier[data-id="${compCallerBtn.dataset.id}"]`);
      const dialerSelect = document.querySelector(`.campaign-sub-staff-comp-add-dialer[data-id="${compCallerBtn.dataset.id}"]`);
      const dataSelect = document.querySelector(`.campaign-sub-staff-comp-add-data[data-id="${compCallerBtn.dataset.id}"]`);
      tier = tierSelect ? tierSelect.value : 'part_time';
      dialerChoice = dialerSelect ? dialerSelect.value : 'own';
      dataChoice = dataSelect ? dataSelect.value : 'own';
    } else {
      tier = compCallerBtn.dataset.tier;
      dialerChoice = compCallerBtn.dataset.dialer;
      dataChoice = compCallerBtn.dataset.data;
    }
    const tierLabel = tier === 'full_time' ? 'Full-time' : 'Part-time';
    const dialerLabel = dialerChoice === 'ours' ? 'our dialer' : 'their own dialer';
    const dataLabel = dataChoice === 'ours' ? 'our data' : 'their own data';
    const confirmMsg = delta > 0
      ? `Add a ${tierLabel} caller on ${dialerLabel}, using ${dataLabel}, to this complimentary campaign? No charge — this campaign isn't billed.`
      : `Remove a ${tierLabel} caller on ${dialerLabel}, using ${dataLabel}, from this complimentary campaign?`;
    if(!confirm(confirmMsg)) return;
    compCallerBtn.disabled = true;
    const original = compCallerBtn.textContent;
    compCallerBtn.textContent = '…';
    const { data, error } = await sb.functions.invoke('staff-manage-campaign-subscription', { body: { action: 'set_complimentary_callers', subscriptionId: compCallerBtn.dataset.id, tier, dialerChoice, dataChoice, delta } });
    if(error || !data || data.ok === false){
      alert((data && data.error) || (error && error.message) || 'Failed to update caller capacity.');
      compCallerBtn.disabled = false;
      compCallerBtn.textContent = original;
      return;
    }
    logActivity('campaign_subscription.set_complimentary_callers', 'client_campaign_subscription', compCallerBtn.dataset.id, `Staff ${delta > 0 ? 'added' : 'removed'} a ${tierLabel.toLowerCase()} caller on ${dialerLabel}, using ${dataLabel}, on a complimentary campaign`);
    await refreshCampaignSubStaffList(compCallerBtn.dataset.id);
    return;
  }

  const addCallerBtn = e.target.closest('.campaign-sub-staff-add-caller-btn');
  if(addCallerBtn){
    const tierSelect = document.querySelector(`.campaign-sub-staff-add-caller-tier[data-id="${addCallerBtn.dataset.id}"]`);
    const dialerSelect = document.querySelector(`.campaign-sub-staff-add-caller-dialer[data-id="${addCallerBtn.dataset.id}"]`);
    const dataSelect = document.querySelector(`.campaign-sub-staff-data-choice[data-id="${addCallerBtn.dataset.id}"]`);
    const tier = tierSelect ? tierSelect.value : 'part_time';
    const dialerChoice = dialerSelect ? dialerSelect.value : 'ours';
    const dataChoice = dataSelect ? dataSelect.value : 'own';
    const tierLabel = tier === 'full_time' ? 'Full-time' : 'Part-time';
    const dialerLabel = dialerChoice === 'ours' ? 'our dialer' : 'own dialer';
    const dataLabel = dataChoice === 'ours' ? 'our data' : 'own data';
    if(!confirm(`Add a ${tierLabel} caller on ${dialerLabel}, using ${dataLabel}, to this subscription? Prorated for the rest of this billing cycle.`)) return;
    const promoCode = campaignSubStaffAskPromoCode();
    addCallerBtn.disabled = true;
    const original = addCallerBtn.textContent;
    addCallerBtn.textContent = 'Adding…';
    const { data, error } = await sb.functions.invoke('staff-manage-campaign-subscription', { body: { action: 'add_caller', subscriptionId: addCallerBtn.dataset.id, tier, dialerChoice, dataChoice, promoCode } });
    if(error || !data || data.ok === false){
      alert((data && data.error) || (error && error.message) || 'Failed to add caller.');
      addCallerBtn.disabled = false;
      addCallerBtn.textContent = original;
      return;
    }
    if(data.billingWarning) alert(`Caller added, but the billing charge failed: ${data.billingWarning}\n\nAdded as a pending charge the client can pay from their own Billing → Pending payment tab.`);
    logActivity('campaign_subscription.add_caller', 'client_campaign_subscription', addCallerBtn.dataset.id, `Staff added a ${tierLabel.toLowerCase()} caller on ${dialerLabel}, using ${dataLabel}, to a campaign subscription`);
    await refreshCampaignSubStaffList(addCallerBtn.dataset.id);
    return;
  }

  const removeCallerBtn = e.target.closest('.campaign-sub-staff-remove-caller-btn');
  if(removeCallerBtn){
    const tier = removeCallerBtn.dataset.tier, dialerChoice = removeCallerBtn.dataset.dialer, dataChoice = removeCallerBtn.dataset.data;
    const tierLabel = tier === 'full_time' ? 'Full-time' : 'Part-time';
    const dialerLabel = dialerChoice === 'ours' ? 'our dialer' : 'their own dialer';
    const dataLabel = dataChoice === 'ours' ? 'our data' : 'their own data';
    if(!confirm(`Remove a ${tierLabel} caller on ${dialerLabel}, using ${dataLabel}, from this subscription? Billing drops immediately, prorated for the rest of this billing cycle.`)) return;
    // Removing a caller only ever nets a CREDIT, never a charge (see
    // chargeProrationNow), so a discount code can never have anything to
    // discount here -- no longer prompted, same fix as client-portal.html's
    // campaignSubRemoveCaller.
    removeCallerBtn.disabled = true;
    const original = removeCallerBtn.textContent;
    removeCallerBtn.textContent = '…';
    const { data, error } = await sb.functions.invoke('staff-manage-campaign-subscription', { body: { action: 'remove_caller', subscriptionId: removeCallerBtn.dataset.id, tier, dialerChoice, dataChoice } });
    if(error || !data || data.ok === false){
      alert((data && data.error) || (error && error.message) || 'Failed to remove caller.');
      removeCallerBtn.disabled = false;
      removeCallerBtn.textContent = original;
      return;
    }
    if(data.billingWarning) alert(`Caller removed, but the billing charge failed: ${data.billingWarning}\n\nAdded as a pending charge the client can pay from their own Billing → Pending payment tab.`);
    logActivity('campaign_subscription.remove_caller', 'client_campaign_subscription', removeCallerBtn.dataset.id, `Staff removed a ${tierLabel.toLowerCase()} caller on ${dialerLabel}, using ${dataLabel}, from a campaign subscription`);
    await refreshCampaignSubStaffList(removeCallerBtn.dataset.id);
    return;
  }

  const convertBtn = e.target.closest('.campaign-sub-staff-convert-tier-btn') || e.target.closest('.campaign-sub-staff-convert-dialer-btn') || e.target.closest('.campaign-sub-staff-convert-data-btn');
  if(convertBtn){
    const d = convertBtn.dataset;
    const isDialerConvert = convertBtn.classList.contains('campaign-sub-staff-convert-dialer-btn');
    const isDataConvert = convertBtn.classList.contains('campaign-sub-staff-convert-data-btn');
    const label = isDataConvert
      ? `Switch one caller to ${d.toData === 'ours' ? 'our data' : 'their own data'}?`
      : isDialerConvert
      ? `Switch one caller to ${d.toDialer === 'ours' ? 'our dialer' : 'their own dialer'}?`
      : `Convert one caller to ${d.toTier === 'full_time' ? 'Full-time' : 'Part-time'}?`;
    if(!confirm(`${label} Billing adjusts immediately, prorated for the rest of this billing cycle.`)) return;
    const promoCode = campaignSubStaffAskPromoCode();
    convertBtn.disabled = true;
    const original = convertBtn.textContent;
    convertBtn.textContent = '…';
    const { data, error } = await sb.functions.invoke('staff-manage-campaign-subscription', {
      body: { action: 'move_caller', subscriptionId: d.id, fromTier: d.fromTier, fromDialerChoice: d.fromDialer, fromDataChoice: d.fromData, toTier: d.toTier, toDialerChoice: d.toDialer, toDataChoice: d.toData, promoCode },
    });
    if(error || !data || data.ok === false){
      alert((data && data.error) || (error && error.message) || 'Failed to update caller.');
      convertBtn.disabled = false;
      convertBtn.textContent = original;
      return;
    }
    if(data.billingWarning) alert(`Caller updated, but the billing charge failed: ${data.billingWarning}\n\nAdded as a pending charge the client can pay from their own Billing → Pending payment tab.`);
    logActivity('campaign_subscription.move_caller', 'client_campaign_subscription', d.id, 'Staff converted a caller on a campaign subscription');
    await refreshCampaignSubStaffList(d.id);
    return;
  }

  // v339: lets staff move a subscription's next billing/renewal date --
  // same capability Stripe's own dashboard exposes. A date of today (or
  // typing nothing but confirming with today's date) resets the cycle to
  // start now; any future date pushes the next invoice out to exactly
  // that date without charging or crediting anything in between (see
  // staff-manage-campaign-subscription's set_next_billing_date comment
  // for how each is implemented in Stripe).
  const setBillingDateBtn = e.target.closest('.campaign-sub-staff-set-billing-date-btn');
  if(setBillingDateBtn){
    const todayIso = new Date().toISOString().slice(0, 10);
    const input = prompt('New next billing date (YYYY-MM-DD):', todayIso);
    if(!input) return;
    const nextBillingDate = input.trim();
    if(!/^\d{4}-\d{2}-\d{2}$/.test(nextBillingDate) || Number.isNaN(new Date(`${nextBillingDate}T00:00:00Z`).getTime())){
      alert('Enter a valid date in YYYY-MM-DD format.');
      return;
    }
    if(!confirm(`Set this subscription's next billing date to ${nextBillingDate}? This only reschedules -- it does not charge or credit the client anything.`)) return;
    setBillingDateBtn.disabled = true;
    const original = setBillingDateBtn.textContent;
    setBillingDateBtn.textContent = '…';
    const { data, error } = await sb.functions.invoke('staff-manage-campaign-subscription', { body: { action: 'set_next_billing_date', subscriptionId: setBillingDateBtn.dataset.id, nextBillingDate } });
    if(error || !data || data.ok === false){
      alert((data && data.error) || (error && error.message) || 'Failed to update the billing date.');
      setBillingDateBtn.disabled = false;
      setBillingDateBtn.textContent = original;
      return;
    }
    logActivity('campaign_subscription.set_next_billing_date', 'client_campaign_subscription', setBillingDateBtn.dataset.id, `Staff changed a campaign subscription's next billing date to ${nextBillingDate}`);
    loadCampaignSubscriptionsStaffList();
    return;
  }

  // v369: same shape as setBillingDateBtn above, for a COMPLIMENTARY
  // campaign's active-until date instead -- previously this could only
  // ever be set once, at creation time (staff-create-campaign), with no
  // way to extend or pull it in afterward short of a direct DB edit. No
  // Stripe call (set_complimentary_expiry is a pure local status/date
  // update), so no "this only reschedules, no charge/credit" caveat
  // needed in the confirm -- it really is just changing a date.
  const setExpiryBtn = e.target.closest('.campaign-sub-staff-set-expiry-btn');
  if(setExpiryBtn){
    const defaultDate = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
    const input = prompt('New active-until date (YYYY-MM-DD) -- the campaign auto-cancels once this passes:', defaultDate);
    if(!input) return;
    const complimentaryExpiresAt = input.trim();
    if(!/^\d{4}-\d{2}-\d{2}$/.test(complimentaryExpiresAt) || Number.isNaN(new Date(`${complimentaryExpiresAt}T00:00:00Z`).getTime())){
      alert('Enter a valid date in YYYY-MM-DD format.');
      return;
    }
    if(new Date(`${complimentaryExpiresAt}T23:59:59.999Z`).getTime() <= Date.now()){
      alert('The active-until date must be in the future.');
      return;
    }
    if(!confirm(`Set this complimentary campaign's active-until date to ${complimentaryExpiresAt}?`)) return;
    setExpiryBtn.disabled = true;
    const original = setExpiryBtn.textContent;
    setExpiryBtn.textContent = '…';
    const { data, error } = await sb.functions.invoke('staff-manage-campaign-subscription', { body: { action: 'set_complimentary_expiry', subscriptionId: setExpiryBtn.dataset.id, complimentaryExpiresAt } });
    if(error || !data || data.ok === false){
      alert((data && data.error) || (error && error.message) || 'Failed to update the active-until date.');
      setExpiryBtn.disabled = false;
      setExpiryBtn.textContent = original;
      return;
    }
    logActivity('campaign_subscription.set_complimentary_expiry', 'client_campaign_subscription', setExpiryBtn.dataset.id, `Staff changed a complimentary campaign's active-until date to ${complimentaryExpiresAt}`);
    loadCampaignSubscriptionsStaffList();
    return;
  }

  // v343: converts an existing COMPLIMENTARY campaign to paid in place --
  // opens csubConvertToPaidModalOverlay so staff pick the PAID caller
  // tier/dialer/data first (see that modal + its submit handler below),
  // instead of just reusing whatever combo the campaign was created
  // complimentary with. This only creates a client_campaign_payment_
  // requests row; the actual charge happens from the existing "Get link"
  // button (Finance -> Stripe Pending Payment), which since
  // v339 already knows to attach straight onto an existing subscription
  // instead of a fresh Checkout link if this client already pays for
  // another campaign.
  const convertToPaidBtn = e.target.closest('.campaign-sub-staff-convert-to-paid-btn');
  if(convertToPaidBtn){
    $('csubConvertToPaidMsg').style.display = 'none';
    $('csubConvertToPaidTier').value = 'part_time';
    $('csubConvertToPaidDialer').value = 'ours';
    $('csubConvertToPaidData').value = 'own';
    $('csubConvertToPaidSubmitBtn').dataset.id = convertToPaidBtn.dataset.id;
    $('csubConvertToPaidModalOverlay').classList.add('active');
    return;
  }

  // v501: staff picking up a client's phone/email request to bring back a
  // genuinely canceled campaign -- opens csubResumeCanceledModalOverlay so
  // staff pick a fresh caller tier/dialer/data first, same shape as
  // Convert to paid above.
  const resumeCanceledBtn = e.target.closest('.campaign-sub-staff-resume-canceled-btn');
  if(resumeCanceledBtn){
    $('csubResumeCanceledMsg').style.display = 'none';
    $('csubResumeCanceledTier').value = 'part_time';
    $('csubResumeCanceledDialer').value = 'ours';
    $('csubResumeCanceledData').value = 'own';
    $('csubResumeCanceledSubmitBtn').dataset.id = resumeCanceledBtn.dataset.id;
    $('csubResumeCanceledModalOverlay').classList.add('active');
    return;
  }

  const pauseBtn = e.target.closest('.campaign-sub-staff-pause-btn');
  const cancelBtn = e.target.closest('.campaign-sub-staff-cancel-btn');
  const btn = pauseBtn || cancelBtn;
  if(!btn) return;
  const action = pauseBtn ? 'immediate_pause' : 'immediate_cancel';
  const confirmMsg = pauseBtn
    ? 'Pause this subscription immediately? Billing stops on the live Stripe subscription right now — unlike the client-facing Request pause, there is no 14-day delay.'
    : 'Cancel this subscription immediately? The live Stripe subscription is canceled right now — unlike the client-facing Request cancellation, there is no 14-day delay.';
  if(!confirm(confirmMsg)) return;
  btn.disabled = true;
  const original = btn.textContent;
  btn.textContent = pauseBtn ? 'Pausing…' : 'Cancelling…';
  const { data, error } = await sb.functions.invoke('staff-manage-campaign-subscription', { body: { action, subscriptionId: btn.dataset.id } });
  if(error || !data || data.ok === false){
    alert((data && data.error) || (error && error.message) || 'Failed to update subscription.');
    btn.disabled = false;
    btn.textContent = original;
    return;
  }
  logActivity(`campaign_subscription.${action}`, 'client_campaign_subscription', btn.dataset.id, pauseBtn ? 'Staff paused a campaign subscription immediately' : 'Staff cancelled a campaign subscription immediately');
  loadCampaignSubscriptionsStaffList();
}
