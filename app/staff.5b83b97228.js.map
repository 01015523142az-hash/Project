}

// ---------- Chat Logs: silent Owner/Admin oversight of every conversation ----------
// Relies entirely on the "is_admin()" branch already built into every
// chat_messages/chat_groups RLS policy — a caller who's Owner/Admin gets
// every row back regardless of participancy, with no membership row or
// any other trace inserted anywhere that would reveal to the people in a
// conversation that it was looked at.
let chatLogsConversations = []; // [{key, label}]
let chatLogsClientNames = {}; // client_id -> display name, populated by initChatLogsSection
async function initChatLogsSection(){
  const sel = $('chatLogsConvSelect');
  sel.innerHTML = '<option value="">Loading…</option>';
  $('chatLogsMessages').innerHTML = '';

  const [{ data: allProfiles }, { data: allGroups }, { data: clientThreads }] = await Promise.all([
    sb.from('profiles').select('id, full_name, email, role').order('full_name'),
    sb.from('chat_groups').select('id, name').order('name'),
    // v204: every client conversation, any status — including 'closed'
    // ones (the archive a chat lands in once staff hit "End chat"; see
    // endClientChatThread() in the Client Chats panel). This section is
    // Owner-only now (v360: moved under Audit Log, unconditionally
    // Owner-only — see initAuditLogTab()), and is_admin() at the RLS layer
    // already grants full read access to every one of these regardless of
    // who it was ever assigned to. is_admin() itself was deliberately left
    // unchanged (still Owner OR Admin) since these same policies also back
    // Admin's ordinary day-to-day chat duties elsewhere (thread assignment,
    // group moderation) — only this dashboard subtab's visibility tightened.
    sb.from('client_chat_threads').select('client_id, status, assigned_staff_id, updated_at, client_accounts(full_name, company_name)').order('updated_at', { ascending: false }),
  ]);

  chatLogsConversations = [{ key: 'team', label: 'Communication' }];
  const { data: dmPairs } = await sb
    .from('chat_messages')
    .select('sender_id, recipient_id')
    .not('recipient_id', 'is', null);
  const pairKeys = new Set();
  (dmPairs || []).forEach(m => {
    const pair = [m.sender_id, m.recipient_id].sort();
    pairKeys.add(pair.join('|'));
  });
  const nameOf = (id) => { const p = (allProfiles || []).find(x => x.id === id); return p ? (p.full_name || p.email) : 'Unknown'; };
  pairKeys.forEach(pk => {
    const [a, b] = pk.split('|');
    chatLogsConversations.push({ key: `dm:${a}:${b}`, label: `${nameOf(a)} \u2194 ${nameOf(b)}` });
  });
  (allGroups || []).forEach(g => {
    chatLogsConversations.push({ key: `group:${g.id}`, label: `${g.name} (group)` });
  });
  chatLogsClientNames = {};
  (clientThreads || []).forEach(t => {
    const clientName = (t.client_accounts && (t.client_accounts.company_name
      ? `${t.client_accounts.company_name} (${t.client_accounts.full_name})`
      : t.client_accounts.full_name)) || 'Client';
    chatLogsClientNames[t.client_id] = clientName;
    const statusTag = t.status === 'closed' ? ' \u2014 closed' : (t.status === 'routed' && t.assigned_staff_id ? ` \u2194 ${nameOf(t.assigned_staff_id)}` : '');
    chatLogsConversations.push({ key: `client:${t.client_id}`, label: `${clientName}${statusTag}` });
  });

  sel.innerHTML = '<option value="">Select a conversation…</option>' + chatLogsConversations
    .map(c => `<option value="${escapeHtml(c.key)}">${escapeHtml(c.label)}</option>`).join('');
}
$('chatLogsConvSelect').addEventListener('change', async () => {
  const key = $('chatLogsConvSelect').value;
  const box = $('chatLogsMessages');
  if(!key){ box.innerHTML = ''; return; }
  box.innerHTML = '<div class="empty" style="padding:16px;">Loading…</div>';

  // audit fix (audit_chunk3.md #5, Medium): every other read-sensitive/
  // administrative action in this range calls logActivity() (task edits,
  // role edits, integration connects/disconnects, promo-code actions,
  // etc.) — reading another staff member's or client's private DM/group
  // conversation through this panel didn't call it at all, by explicit
  // design (see the section comment above), leaving zero trace anywhere
  // — even the Owner's own Audit Log — that a private conversation was
  // read. Purely additive: doesn't change who can read what (RLS/
  // is_admin() are unchanged), just makes it accountable like every
  // other sensitive read/action nearby.
  const openedLabel = (chatLogsConversations.find(c => c.key === key) || {}).label || key;
  logActivity('chat_logs.view_conversation', null, null, `Viewed chat log: ${openedLabel}`);

  // v204: client conversations live in a completely different table
  // (client_chat_messages, not chat_messages) — same reason
  // sendChatMessage()/openClientChatThread() branch off early for a
  // 'client:' key elsewhere in this file.
  if(key.startsWith('client:')){
    const clientId = key.slice(7);
    const { data: msgs, error } = await sb.from('client_chat_messages')
      .select('id, sender, staff_id, body, created_at, attachment_path, attachment_name, attachment_mime')
      .eq('client_id', clientId)
      .order('created_at', { ascending: true });
    if(error){ box.innerHTML = `<div class="msg error" style="padding:16px;">${escapeHtml(error.message)}</div>`; return; }
    const chatLogsClientTz = nonAgentDisplayTz();
    box.innerHTML = (msgs || []).map(m => {
      const time = new Date(m.created_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(chatLogsClientTz ? { timeZone: chatLogsClientTz } : {}) });
      const sender = m.sender === 'client' ? (chatLogsClientNames[clientId] || 'Client') : (m.sender === 'ai' ? 'AI Assistant' : (m.sender === 'system' ? 'System note' : chatContactName(m.staff_id)));
      const bodyHtml = m.body ? `<div class="chat-msg-bubble">${escapeHtml(m.body)}</div>` : '';
      const attachmentHtml = m.attachment_path
        ? `<div class="chat-msg-attachment" data-attachment-path="${escapeHtml(m.attachment_path)}" data-attachment-mime="${escapeHtml(m.attachment_mime || '')}" data-attachment-name="${escapeHtml(m.attachment_name || 'file')}" data-attachment-bucket="client-chat-attachments">Loading attachment…</div>`
        : '';
      return `
        <div class="chat-msg-row theirs">
          <div class="chat-msg-meta">${escapeHtml(sender)} \u00b7 ${time}</div>
          ${bodyHtml}
          ${attachmentHtml}
        </div>
      `;
    }).join('') || '<div class="empty" style="padding:16px;">No messages in this conversation.</div>';
    clientChatResolveVisibleAttachments(box);
    return;
  }

  let query = sb.from('chat_messages').select('id, sender_id, recipient_id, group_id, body, created_at, attachment_path, attachment_name, attachment_mime').order('created_at', { ascending: true });
  if(key === 'team') query = query.is('recipient_id', null).is('group_id', null);
  else if(key.startsWith('dm:')){
    const [, a, b] = key.split(':');
    query = query.or(`and(sender_id.eq.${a},recipient_id.eq.${b}),and(sender_id.eq.${b},recipient_id.eq.${a})`);
  } else if(key.startsWith('group:')){
    query = query.eq('group_id', key.slice(6));
  }
  const { data: msgs, error } = await query;
  if(error){ box.innerHTML = `<div class="msg error" style="padding:16px;">${escapeHtml(error.message)}</div>`; return; }

  const chatLogsInternalTz = nonAgentDisplayTz();
  box.innerHTML = (msgs || []).map(m => {
    const time = new Date(m.created_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(chatLogsInternalTz ? { timeZone: chatLogsInternalTz } : {}) });
    const sender = chatContactName(m.sender_id);
    const bodyHtml = m.body ? `<div class="chat-msg-bubble">${escapeHtml(m.body)}</div>` : '';
    const attachmentHtml = m.attachment_path
      ? `<div class="chat-msg-attachment" data-attachment-path="${escapeHtml(m.attachment_path)}" data-attachment-mime="${escapeHtml(m.attachment_mime || '')}" data-attachment-name="${escapeHtml(m.attachment_name || 'file')}">Loading attachment…</div>`
      : '';
    return `
      <div class="chat-msg-row theirs">
        <div class="chat-msg-meta">${escapeHtml(sender)} \u00b7 ${time}${myIsOwner ? ` <span class="chat-msg-del-btn" data-msg-id="${m.id}" title="Delete for everyone (owner only)">&#128465;</span>` : ''}</div>
        ${bodyHtml}
        ${attachmentHtml}
      </div>
    `;
  }).join('') || '<div class="empty" style="padding:16px;">No messages in this conversation.</div>';
  chatResolveVisibleAttachments(box);
  // v726: the owner can delete from here too -- any staff conversation.
  box.querySelectorAll('.chat-msg-del-btn').forEach(el => {
    el.addEventListener('click', async () => { if(await chatDeleteMessage(el.dataset.msgId)) el.closest('.chat-msg-row').remove(); });
  });
});


async function callGhlApi(payload){
  const { data, error } = await sb.functions.invoke('ghl-api', { body: payload });
  if(error){
    try{ const body = await error.context.json(); return { ok: false, error: body.error || error.message }; }
    catch{ return { ok: false, error: error.message }; }
  }
  return data;
}

// v153: client SMS notifications, sent via GoHighLevel (send-client-sms
// Edge Function — see that file for the actual GHL calls/message
// wording). Deliberately fire-and-forget from every call site below: a
// text failing to send (no phone on file, GHL hiccup, etc.) should never
// block or fail the underlying staff action (accepting a lead, replying
// to a dispute, ...) that triggered it — failures just land in the
// console, same spirit as e.g. push notification sends elsewhere in this
// file.
// v200: returns { ok, error } instead of only console.warn-ing on
// failure — every existing fire-and-forget caller (notifyClientsForFormId
// etc.) still works unchanged since they don't look at the return value,
// but the account-password callers (Add Client, Reset password) now
// await this and tell staff directly whether the client's SMS actually
// went out, instead of the two of them silently assuming it did. The
// most common real failure here is no GoHighLevel connection yet, or no
// phone number on file — both come back as a clear `error` string from
// send-client-sms itself (never a generic thrown error).
async function callSendClientSms(clientId, kind, details){
  if(!clientId) return { ok: false, error: 'No client id.' };
  callSendClientEmail(clientId, kind, details); // v307: fire-and-forget alongside every SMS send — see that function's own comment
  try{
    const { data, error } = await sb.functions.invoke('send-client-sms', { body: { clientId, kind, details: details || null } });
    if(error){
      let msg = error.message;
      try{ const b = await error.context.json(); msg = b.error || msg; }
      catch{ /* use error.message as-is */ }
      console.warn('send-client-sms failed:', msg);
      return { ok: false, error: msg };
    }
    if(data && !data.ok){
      console.warn('send-client-sms failed:', data.error);
      return { ok: false, error: data.error };
    }
    return { ok: true };
  }catch(e){
    console.warn('send-client-sms error:', e);
    return { ok: false, error: e.message || String(e) };
  }
}
// v307: client email notifications, sent via Resend (send-client-email
// Edge Function). Mirrors callSendClientSms above exactly — same kinds,
// same fire-and-forget "never block the staff action that triggered it"
// reasoning, same per-kind app_settings-backed enable toggle and
// subject/body templates (see Notifications Setting under User
// Management). 'manual' has no email equivalent (freeform text-back has
// no email analog), so that kind is skipped here rather than erroring.
async function callSendClientEmail(clientId, kind, details){
  if(!clientId || kind === 'manual') return { ok: false, error: 'Not applicable.' };
  try{
    const { data, error } = await sb.functions.invoke('send-client-email', { body: { clientId, kind, details: details || null } });
    if(error){
      let msg = error.message;
      try{ const b = await error.context.json(); msg = b.error || msg; }
      catch{ /* use error.message as-is */ }
      console.warn('send-client-email failed:', msg);
      return { ok: false, error: msg };
    }
    if(data && !data.ok){
      console.warn('send-client-email failed:', data.error);
      return { ok: false, error: data.error };
    }
    return { ok: true };
  }catch(e){
    console.warn('send-client-email error:', e);
    return { ok: false, error: e.message || String(e) };
  }
}
// Every client granted access to this campaign (form_id) gets texted —
// a form/campaign can be granted to more than one client account.
async function notifyClientsForFormId(formId, kind, details){
  if(!formId) return;
  const { data: grants } = await sb.from('client_campaign_access').select('client_id').eq('form_id', formId);
  (grants || []).forEach(g => callSendClientSms(g.client_id, kind, details));
}

async function loadGhlConnections(){
  const list = $('ghlConnectionsList');
  list.innerHTML = '<div class="empty">Loading…</div>';
  const result = await callGhlApi({ action: 'list_connections' });
  if(!result.ok){
    list.innerHTML = `<div class="msg error">${escapeHtml(result.error || 'Failed to load connections.')}</div>`;
    return;
  }
  const connections = result.connections || [];
  if(connections.length === 0){
    list.innerHTML = '<div class="empty">No locations connected yet.</div>';
    return;
  }
  list.innerHTML = `
    <table>
      <thead><tr><th>Location</th><th>Connected</th><th>Type</th><th>Token status</th><th></th></tr></thead>
      <tbody>
        ${connections.map(c => `
          <tr>
            <td>${escapeHtml(c.location_name || c.location_id)}</td>
            <td style="color:var(--text-2);">${new Date(c.created_at).toLocaleDateString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {})}</td>
            <td style="color:var(--text-2);">${c.is_private_token ? 'Private token' : 'OAuth2'}</td>
            <td style="color:${c.is_expired ? 'var(--away)' : 'var(--good)'};">${c.is_private_token ? 'Static (no expiry)' : (c.is_expired ? 'Will refresh on next use' : 'Active')}</td>
            <td><button class="task-del-btn ghl-disconnect-btn" data-location="${escapeHtml(c.location_id)}" title="Disconnect">&times;</button></td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  `;
  list.querySelectorAll('.ghl-disconnect-btn').forEach(btn => {
    btn.addEventListener('click', () => disconnectGhlLocation(btn.dataset.location));
  });
}

// v474: mirrors loadGhlConnections() above -- one shared Gmail inbox
// instead of a list of GHL locations, so no per-row token-status column
// (Google's own refresh flow just silently keeps the access token fresh;
// nothing here is ever "expired" from the staff member's point of view).
async function loadGmailConnections(){
  const list = $('gmailConnectionsList');
  if(!list) return;
  list.innerHTML = '<div class="empty">Loading…</div>';
  const result = await callGmailApi({ action: 'list_connections' });
  if(!result.ok){
    list.innerHTML = `<div class="msg error">${escapeHtml(result.error || 'Failed to load connections.')}</div>`;
    return;
  }
  const connections = result.connections || [];
  if(connections.length === 0){
    list.innerHTML = '<div class="empty">No Gmail inbox connected yet.</div>';
    return;
  }
  list.innerHTML = `
    <table>
      <thead><tr><th>Inbox</th><th>Connected</th><th></th></tr></thead>
      <tbody>
        ${connections.map(c => `
          <tr>
            <td>${escapeHtml(c.email_address)}</td>
            <td style="color:var(--text-2);">${new Date(c.created_at).toLocaleDateString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {})}</td>
            <td><button class="task-del-btn gmail-disconnect-btn" data-email="${escapeHtml(c.email_address)}" title="Disconnect">&times;</button></td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  `;
  list.querySelectorAll('.gmail-disconnect-btn').forEach(btn => {
    btn.addEventListener('click', () => disconnectGmailInbox(btn.dataset.email));
  });
}
async function disconnectGmailInbox(emailAddress){
  if(!confirm(`Disconnect ${emailAddress}? Staff will no longer be able to send or read email through it.`)) return;
  const result = await callGmailApi({ action: 'disconnect', emailAddress });
  if(!result.ok){
    alert(result.error || 'Failed to disconnect.');
    return;
  }
  logActivity('integration.disconnect', 'gmail_inbox', null, `Disconnected Gmail inbox ${emailAddress}`);
  await loadGmailConnections();
}
if($('gmailOauthConnectBtn')) $('gmailOauthConnectBtn').addEventListener('click', async () => {
  const msg = $('gmailOauthMsg');
  const btn = $('gmailOauthConnectBtn');
  msg.textContent = '';
  msg.className = 'msg';
  if (GMAIL_CLIENT_ID === 'YOUR_GMAIL_CLIENT_ID' || GMAIL_REDIRECT_URI.includes('YOUR-PROJECT-REF')) {
    msg.textContent = 'GMAIL_CLIENT_ID (and/or GMAIL_REDIRECT_URI) hasn’t been filled in in index.html yet — see the comment above ghlConnectUrl() for where.';
    msg.className = 'msg error';
    return;
  }
  btn.disabled = true;
  const originalLabel = btn.textContent;
  btn.textContent = 'Starting…';
  const result = await callGmailApi({ action: 'create_oauth_state' });
  btn.disabled = false;
  btn.textContent = originalLabel;
  if(!result.ok){
    msg.textContent = result.error || 'Failed to start the connect flow.';
    msg.className = 'msg error';
    return;
  }
  window.open(gmailConnectUrl(result.state), '_blank', 'noopener');
});

// v153: which connected location client-facing SMS (send-client-sms) goes
// through, when more than one is connected — a plain app_settings row,
// same read/write pattern as min_extension_version etc. elsewhere in this
// tab. Only actually consulted server-side once there's more than one
// ghl_connections row; the dropdown here is shown regardless so it's easy
// to find/pre-set before that ever becomes ambiguous.
async function loadGhlClientSmsLocationSetting(){
  const sel = $('ghlClientSmsLocationSelect');
  if(!sel) return;
  // v155: ghl_connections has RLS enabled with NO policies granting
  // direct client-side select at all — every other read of this table
  // (loadGhlConnections() above) goes through ghl-api's own
  // list_connections action (service-role, gated on caller being
  // Owner/Admin inside the function). A direct sb.from('ghl_connections')
  // query here silently returned zero rows regardless of what's actually
  // connected — same mistake, not a second bug — so this now goes through
  // that same action instead.
  const [connResult, { data: setting }] = await Promise.all([
    callGhlApi({ action: 'list_connections' }),
    sb.from('app_settings').select('value').eq('key', 'client_sms_location_id').maybeSingle(),
  ]);
  const rows = connResult.ok ? (connResult.connections || []) : [];
  sel.innerHTML = rows.length
    ? rows.map(c => `<option value="${escapeHtml(c.location_id)}">${escapeHtml(c.location_name || c.location_id)}</option>`).join('')
    : `<option value="">${connResult.ok ? 'No locations connected yet' : escapeHtml(connResult.error || 'Failed to load connections')}</option>`;
  if(setting?.value && rows.some(c => c.location_id === setting.value)) sel.value = setting.value;
}
if($('ghlClientSmsLocationSaveBtn')) $('ghlClientSmsLocationSaveBtn').addEventListener('click', async () => {
  const sel = $('ghlClientSmsLocationSelect');
  const msg = $('ghlClientSmsLocationMsg');
  const value = sel ? sel.value : '';
  if(!value){ msg.textContent = 'Connect a location first.'; msg.className = 'msg error'; return; }
  const { error } = await sb.from('app_settings').upsert({ key: 'client_sms_location_id', value, updated_at: new Date().toISOString() });
  if(error){ msg.textContent = error.message; msg.className = 'msg error'; return; }
  msg.textContent = 'Saved.';
  msg.className = 'msg';
  logActivity('app_settings.update', null, null, `Set client SMS location to ${sel.selectedOptions[0] ? sel.selectedOptions[0].textContent : value}`);
});

