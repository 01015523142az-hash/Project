// Live per-campaign dialing progress, built from readymode-webhook's
// call-result events (campaign_progress action) -- distinct from
// ReadyMode's own Lead File "Leads remaining/Health/Round" screen, which
// isn't reachable via their API (confirmed by ReadyMode's Integrations
// team -- see this file's header comment).
//
// v579 LABELLING FIX (reported live, 2026-09-09). Two of these numbers were
// read as something they are not:
//   * "Reached" counts distinct phones with at least one call event, and
//     ReadyMode only posts an event when a call gets a DISPOSITION. A dial
//     that rings out logs nothing, so "Not yet reached" was read as "never
//     dialed" when ReadyMode's own file showed avg 4.41 calls per lead. It
//     means "no dispositioned call yet". Renamed to say exactly that.
//   * "Reached" also includes voicemail-only leads (468 of 1,931 on one real
//     campaign), so it overstates human contact. "Spoke to someone" is now
//     shown alongside it, computed from dispositions in readymode-api.

function renderRmCampaignProgressCard(c, opts){
  opts = opts || {};
  const dispositionBadges = Object.entries(c.dispositionCounts || {}).sort((a, b) => b[1] - a[1]).slice(0, 6);
  const reachPct = c.leadsPushed ? Math.round((c.leadsReached / c.leadsPushed) * 100) : null;
  // spokeToSomeone arrives from readymode-api v87 onward. Render an em dash
  // rather than "undefined" if a cached older response is still in play.
  const spokePct = (c.leadsPushed && typeof c.spokeToSomeone === 'number')
    ? Math.round((c.spokeToSomeone / c.leadsPushed) * 100) : null;
  const spokeStr = typeof c.spokeToSomeone === 'number'
    ? `${c.spokeToSomeone}${spokePct !== null ? ` (${spokePct}%)` : ''}`
    : '—';
  // c.file is ReadyMode's own progress export, present only once one has been
  // imported for this campaign (readymode-api v88+). Everything below degrades
  // to the webhook-only view when it is absent.
  const f = c.file || null;
  const fileNotReachedPct = (f && f.leads) ? Math.round((f.notYetReached / f.leads) * 100) : null;
  const fileOutcomeBadges = f
    ? Object.entries(f.outcomes || {})
        .filter(([k]) => String(k).trim().toLowerCase() !== 'not yet reached')
        .sort((a, b) => b[1] - a[1]).slice(0, 8)
    : [];
  const statCards = opts.uncategorized
    ? `<div class="act-stat-card"><div class="act-stat-label">Got a call result</div><div class="act-stat-value good">${c.leadsReached}</div></div>
       <div class="act-stat-card"><div class="act-stat-label">Spoke to someone</div><div class="act-stat-value good">${spokeStr}</div></div>
       <div class="act-stat-card"><div class="act-stat-label">Total call events</div><div class="act-stat-value">${c.totalCallEvents}</div></div>
       <div class="act-stat-card"><div class="act-stat-label">Appointments</div><div class="act-stat-value good">${c.appointmentsSet}</div></div>`
    : (f
       // A progress export has been imported, so show ReadyMode's OWN file
       // numbers -- these are the ones that match their screen. The live
       // webhook figures stay visible underneath rather than being dropped,
       // since they answer a different question (who did we actually speak
       // to) that the file cannot.
       ? `<div class="act-stat-card"><div class="act-stat-label">Leads in ReadyMode file</div><div class="act-stat-value">${f.leads}</div></div>
          <div class="act-stat-card"><div class="act-stat-label">Not yet reached</div><div class="act-stat-value">${f.notYetReached}${fileNotReachedPct !== null ? ` (${fileNotReachedPct}%)` : ''}</div></div>
          <div class="act-stat-card"><div class="act-stat-label">Got an outcome</div><div class="act-stat-value good">${f.withOutcome}</div></div>
          <div class="act-stat-card"><div class="act-stat-label">Appointments</div><div class="act-stat-value good">${f.positives}</div></div>`
       : `<div class="act-stat-card"><div class="act-stat-label">Leads pushed</div><div class="act-stat-value">${c.leadsPushed}</div></div>
          <div class="act-stat-card"><div class="act-stat-label">Got a call result</div><div class="act-stat-value good">${c.leadsReached}${reachPct !== null ? ` (${reachPct}%)` : ''}</div></div>
          <div class="act-stat-card"><div class="act-stat-label">Spoke to someone</div><div class="act-stat-value good">${spokeStr}</div></div>
          <div class="act-stat-card"><div class="act-stat-label">No dispositioned call yet</div><div class="act-stat-value">${c.leadsNotYetReached}</div></div>
          <div class="act-stat-card"><div class="act-stat-label">Appointments</div><div class="act-stat-value good">${c.appointmentsSet}</div></div>`);
  return `
    <div style="border:1px solid var(--border-light); border-radius:10px; padding:14px; margin-bottom:12px; ${opts.uncategorized ? 'border-style:dashed;' : ''}">
      <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:8px;">
        <div style="font-weight:600;">${opts.uncategorized ? 'Uncategorized (not pushed via this dashboard)' : escapeHtml(c.campaign)}</div>
        <div style="color:var(--text-dim); font-size:11px;">${c.lastCallAt ? 'Last call ' + new Date(c.lastCallAt).toLocaleString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {}) : 'No calls logged yet'}</div>
      </div>
      ${opts.uncategorized ? `<div style="font-size:11px; color:var(--text-dim); margin-top:4px;">Real call activity whose phone number doesn't match anything pushed via "Upload list for ReadyMode" — likely a different campaign uploaded straight into ReadyMode, or leads that predate this tool. Shown here so it isn't silently missing.</div>` : ''}
      <div class="act-stats-row" style="margin-top:10px; margin-bottom:0;">
        ${statCards}
      </div>
      ${f ? `
        <div style="margin-top:10px; padding-top:10px; border-top:1px dashed var(--border-light); font-size:11px; color:var(--text-dim); line-height:1.6;">
          <div><strong style="color:var(--text-2);">From ReadyMode's file</strong> — ${f.totalDialAttempts.toLocaleString()} dial attempt(s) across ${f.dialledAtLeastOnce.toLocaleString()} lead(s), averaging ${f.avgDialsPerDialledLead} each.${f.neverDialled ? ` ${f.neverDialled} lead(s) show 0 dials — ReadyMode carried their status over from an existing Lead Profile at upload.` : ''}${f.importedAt ? ` Imported ${new Date(f.importedAt).toLocaleString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {})}.` : ''}</div>
          ${fileOutcomeBadges.length ? `<div style="margin-top:6px; display:flex; flex-wrap:wrap; gap:5px;">${fileOutcomeBadges.map(([k, n]) => `<span class="mono" style="font-size:10px; padding:2px 7px; border:1px solid var(--border-light); border-radius:999px;">${escapeHtml(k)}: ${n}</span>`).join('')}</div>` : ''}
          <div style="margin-top:6px;">Live call events (a different question — who was actually spoken to): ${c.leadsReached} lead(s) produced a call result, ${spokeStr} spoke to someone.</div>
        </div>` : ''}
      ${dispositionBadges.length ? `
        <div style="margin-top:10px;">
          ${dispositionBadges.map(([d, n]) => `<span class="lead-ispeedtolead-badge" style="margin-right:6px; margin-bottom:4px; display:inline-block;">${escapeHtml(d)}: ${n}</span>`).join('')}
        </div>
      ` : ''}
    </div>
  `;
}

async function loadRmCampaignProgress(){
  const box = $('rmCampaignProgressList');
  if(!box) return;
  box.innerHTML = '<div class="empty">Loading…</div>';
  const result = await callRmApi({ action: 'campaign_progress' });
  if(!result.ok){ box.innerHTML = `<div class="msg error">${escapeHtml(result.error || 'Failed to load campaign progress.')}</div>`; return; }
  const campaigns = result.campaigns || [];
  if(!campaigns.length && !result.uncategorized){ box.innerHTML = '<div class="empty">No campaigns yet — save a lead-posting channel and push some leads, or wait for ReadyMode call-result webhook events to arrive.</div>'; return; }
  box.innerHTML = campaigns.map(c => renderRmCampaignProgressCard(c)).join('')
    + (result.uncategorized ? renderRmCampaignProgressCard(result.uncategorized, { uncategorized: true }) : '');
}
const rmRefreshCampaignProgressBtn = document.getElementById('rmRefreshCampaignProgressBtn');
if(rmRefreshCampaignProgressBtn) rmRefreshCampaignProgressBtn.addEventListener('click', () => loadRmCampaignProgress());

// v581: ReadyMode's own "Export a progress file" CSV. Parsed and chunked
// here rather than posted whole -- a real export is ~4MB / 11,673 rows, far
// past a comfortable edge-function request body, so this mirrors the
// client-side chunking the ReadyMode push already uses.
//
// Column names are taken from a REAL export (2026-09-09), whose header is:
//   Phone,"Alt. Phone","First Name","Last Name",Address,City,State,Country,
//   Zip,Email,"Batch Name","Original File Name","Upload Date",Status,
//   "Original Status","Status (time)","Status (agent)","Lead File Campaign",
//   "Profile Campaign","Times Called (Dialer)",u_assigntime,"Last Dispo",
//   "Removed Date","Consent Date",Ph#3..Ph#10
const rmProgressUploadInput = document.getElementById('rmProgressUploadInput');
if(rmProgressUploadInput) rmProgressUploadInput.addEventListener('change', async (e) => {
  const file = e.target.files[0];
  const msg = $('rmProgressUploadMsg');
  msg.style.display = 'none';
  if(!file) return;
  const input = e.target;
  input.disabled = true;
  try {
    msg.textContent = 'Reading file…';
    msg.className = 'msg'; msg.style.display = 'block';
    const buf = await file.arrayBuffer();
    await ensureXlsx();
    const wb = XLSX.read(buf, { type: 'array' });
    const sheet = wb.Sheets[wb.SheetNames[0]];
    const rows = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '', raw: false });
    if(rows.length < 2){ msg.textContent = 'That file has no data rows.'; msg.className = 'msg error'; return; }
    const headerRow = rows[0].map(h => String(h || '').trim());
    const norm = v => String(v || '').trim().toLowerCase();
    const col = names => headerRow.findIndex(h => names.includes(norm(h)));
    const iPhone = col(['phone']);
    if(iPhone === -1){
      msg.textContent = 'No "Phone" column found — this does not look like a ReadyMode progress export.';
      msg.className = 'msg error'; return;
    }
    const iStatus = col(['status']);
    const iTimes = col(['times called (dialer)', 'times called']);
    if(iStatus === -1 || iTimes === -1){
      msg.textContent = 'This file is missing "Status" and/or "Times Called (Dialer)" — those two are the whole point of the progress export, so ReadyMode\'s numbers could not be reproduced without them.';
      msg.className = 'msg error'; return;
    }
    const iCampaign = col(['lead file campaign', 'batch name', 'original file name']);
    const iFirst = col(['first name']), iLast = col(['last name']);
    const iAddr = col(['address']), iCity = col(['city']), iState = col(['state']), iZip = col(['zip', 'zip code']);
    const iLastDispo = col(['last dispo']);
    const iStatusTime = col(['status (time)']), iStatusAgent = col(['status (agent)']);
    const iUpload = col(['upload date']), iRemoved = col(['removed date']);

    const cell = (r, i) => i > -1 ? String(r[i] || '').trim() : '';
    const dataRows = rows.slice(1).filter(r => r.some(c => String(c || '').trim() !== ''));

    // The campaign name comes from the file itself so it always matches the
    // channel name the pushes were logged under; there is no free-text box to
    // get subtly wrong (a mismatch would silently create a second campaign).
    const campaignCounts = {};
    dataRows.forEach(r => { const v = cell(r, iCampaign); if(v) campaignCounts[v] = (campaignCounts[v] || 0) + 1; });
    const campaignName = Object.entries(campaignCounts).sort((a, b) => b[1] - a[1])[0]?.[0] || '';
    if(!campaignName){
      msg.textContent = 'Could not read a campaign name from this file (looked for "Lead File Campaign", "Batch Name", "Original File Name").';
      msg.className = 'msg error'; return;
    }
    const distinctCampaigns = Object.keys(campaignCounts).length;

    const payload = dataRows.map(r => ({
      phone: cell(r, iPhone),
      firstName: cell(r, iFirst),
      lastName: cell(r, iLast),
      address: cell(r, iAddr),
      city: cell(r, iCity),
      state: cell(r, iState),
      zip: cell(r, iZip),
      status: cell(r, iStatus),
      timesCalled: cell(r, iTimes),
      lastDispo: cell(r, iLastDispo),
      statusAgent: cell(r, iStatusAgent),
      statusTime: cell(r, iStatusTime),
      uploadDate: cell(r, iUpload),
      removedDate: cell(r, iRemoved),
    }));

    const CHUNK = 1000;
    let imported = 0, deduped = 0, skipped = 0;
    for(let off = 0; off < payload.length; off += CHUNK){
      const chunk = payload.slice(off, off + CHUNK);
      msg.textContent = `Importing row ${off + 1}-${off + chunk.length} of ${payload.length} for "${campaignName}"…`;
      const res = await callRmApi({ action: 'import_progress_csv', campaignName, filename: file.name, rows: chunk });
      if(!res.ok){
        msg.textContent = `Stopped at row ${off + 1}: ${res.error || 'import failed.'} ${imported} row(s) were imported before this.`;
        msg.className = 'msg error'; return;
      }
      imported += res.imported || 0;
      deduped += res.deduped || 0;
      skipped += res.skippedNoPhone || 0;
    }
    msg.textContent = `Imported ${imported} lead(s) for "${campaignName}".`
      + (deduped ? ` ${deduped} duplicate phone(s) collapsed — the row carrying a real outcome won.` : '')
      + (skipped ? ` ${skipped} row(s) skipped with no usable phone number.` : '')
      + (distinctCampaigns > 1 ? ` Note: this file names ${distinctCampaigns} campaigns; everything was filed under the most common one.` : '');
    msg.className = 'msg ok';
    loadRmCampaignProgress();
  } catch (err) {
    console.error('rmProgressUploadInput: import failed:', err);
    msg.textContent = `Couldn't read that file: ${err instanceof Error ? err.message : String(err)}`;
    msg.className = 'msg error'; msg.style.display = 'block';
  } finally {
    input.disabled = false;
    input.value = '';
  }
});

// v1.2.7: view_scope moved from a single value to a comma-separated list
// of combinable scopes (e.g. "self,specific_role"), so a role can be
// "themselves + a specific user type" at once. 'all' is stored alone.
// Old rows still hold a single bare value ('self', 'all', etc.) — those
// parse fine here since a value with no comma is just a one-item list.
function parseViewScopeList(viewScope){
  return (viewScope || 'self').split(',').map(s => s.trim()).filter(Boolean);
}

// v776: the user types are a list down the left of the editor now, not a
// table under it — picking one loads it into the form beside it instead of
// scrolling back up. Renaming moved onto the name box in the form (it used to
// be an inline contenteditable cell in that table); it still goes through
// staff-rename-role, because profiles.role has an `on update cascade` FK that
// only the service role may trigger.
let roleListFilter = '';

async function loadRolesList(){
  const { data, error } = await sb.from('roles').select('name, allowed_tabs, can_manage_users, is_protected, tab_edit, view_scope, viewable_user_ids, viewable_role, um_sections, activity_sections, leads_sections, csub_sections, finance_sections, hr_sections, data_science_sections, taxes_sections, time_management_sections, dialer_admin_sections, task_category_ids, can_text_clients, can_edit_compensation, can_manual_dial').order('name');
  const body = $('rolesListBody');
  if(!body) return;
  // v41 fix: a query failure used to render an EMPTY list, indistinguishable
  // from "no roles exist" — surface the real error instead.
  if(error){
    allRoles = [];
    body.innerHTML = `<div class="msg error" style="margin:0;">${escapeHtml(error.message)}</div>`;
    return;
  }
  allRoles = data || [];
  renderRolesSideList();
  // These rows are built after activateUmSection()'s gating pass has already
  // run (that call is synchronous, this list is not), so gating is re-applied
  // here or a view-only role's controls come back enabled on every reload.
  applyUmSectionEditGating('roles');
  permRenderUserList();
}

function renderRolesSideList(){
  const body = $('rolesListBody');
  if(!body) return;
  const q = (roleListFilter || '').trim().toLowerCase();
  const shown = allRoles.filter(r => !q || r.name.toLowerCase().includes(q) || roleDisplayLabel(r.name).toLowerCase().includes(q));
  if(!shown.length){
    body.innerHTML = '<div class="perm-side-empty">No user types match that.</div>';
    return;
  }
  const counts = {};
  (allViewableUsers || []).forEach(u => { counts[u.role || 'user'] = (counts[u.role || 'user'] || 0) + 1; });
  body.innerHTML = shown.map(r => {
    const tabs = (r.allowed_tabs || []).length;
    // Owner and Admin always see every user regardless of view_scope — that
    // bypass is hardcoded by role name in can_view_user() at the database
    // level, so it applies to Admin even now its other permissions are the
    // Owner's to set.
    const scopeList = parseViewScopeList(r.view_scope);
    const scope = ['owner', 'admin'].includes(r.name) ? 'all users'
      : scopeList.includes('all') ? 'all users'
      : scopeList.map(sc => sc === 'self' ? 'themselves'
          : sc === 'selected' ? `${(r.viewable_user_ids || []).length} selected`
          : sc === 'specific_role' ? roleDisplayLabel(r.viewable_role || '—')
          : sc).join(' + ') || 'themselves';
    const n = counts[r.name] || 0;
    const tag = r.is_protected ? 'protected' : (r.name === 'admin' ? 'core' : '');
    return `
      <button type="button" class="perm-side-item${editingRoleName === r.name ? ' active' : ''}" data-role-pick="${escapeHtml(r.name)}">
        <span class="perm-side-item-main">
          <span class="perm-side-item-name">${escapeHtml(roleDisplayLabel(r.name))}${tag ? ` <span class="type-badge">${tag}</span>` : ''}</span>
          <span class="perm-side-item-sub">${tabs} tab${tabs === 1 ? '' : 's'} &middot; sees ${escapeHtml(scope)}${n ? ` &middot; ${n} account${n === 1 ? '' : 's'}` : ''}</span>
        </span>
      </button>`;
  }).join('');
  body.querySelectorAll('[data-role-pick]').forEach(btn => {
    btn.addEventListener('click', () => startEditRole(btn.dataset.rolePick));
  });
}

// ===========================================================================
// v776: individual people. Same matrix, saved to user_permission_overrides
// instead of roles. The boxes open pre-filled from the person's user type, so
// "no exception" and "an exception that happens to match the type" look the
// same on screen and save the same way.
// ===========================================================================
let permUserId = null;          // whoever is open in the right-hand pane
let permUserRow = null;         // their profiles row
let permUserOverride = null;    // their user_permission_overrides row, or null
let permUserSearchText = '';
let permUserTypeFilterValue = '';
let permOverrideByUser = {};    // user_id -> true, for the "Custom" badge in the list

function permRoleValues(roleName){
  const r = allRoles.find(x => x.name === roleName);
  if(!r) return { allowed_tabs: [], tab_edit: {} };
  return {
    allowed_tabs: r.allowed_tabs || [],
    tab_edit: r.tab_edit || {},
    um_sections: r.um_sections || {},
    activity_sections: r.activity_sections || {},
    leads_sections: r.leads_sections || {},
    csub_sections: r.csub_sections || {},
    finance_sections: r.finance_sections || {},
    hr_sections: r.hr_sections || {},
    data_science_sections: r.data_science_sections || {},
    taxes_sections: r.taxes_sections || {},
    time_management_sections: r.time_management_sections || {},
    dialer_admin_sections: r.dialer_admin_sections || {},
    can_text_clients: !!r.can_text_clients,
    can_edit_compensation: !!r.can_edit_compensation,
    can_manual_dial: !!r.can_manual_dial,
  };
}

// The person's own values: their type, with their exception merged over it.
function permEffectiveValues(roleName, override){
  const base = permRoleValues(roleName);
  if(!override) return base;
  const fam = permissionFamilies().map(f => f.family);
  const out = Object.assign({}, base);
  if(Array.isArray(override.allowed_tabs)) out.allowed_tabs = override.allowed_tabs;
  fam.forEach(f => { out[f] = Object.assign({}, base[f] || {}, override[f] || {}); });
  out.tab_edit = Object.assign({}, base.tab_edit || {}, override.tab_edit || {});
  ['can_text_clients', 'can_edit_compensation', 'can_manual_dial'].forEach(k => {
    if(typeof override[k] === 'boolean') out[k] = override[k];
  });
  return out;
}

async function permLoadOverrides(){
  try {
    const { data } = await sb.from('user_permission_overrides').select('user_id');
    permOverrideByUser = {};
    (data || []).forEach(r => { permOverrideByUser[r.user_id] = true; });
  } catch(e) { permOverrideByUser = {}; }
}

function permRenderUserList(){
  const body = $('permUserListBody');
  if(!body) return;
  const sel = $('permUserTypeFilter');
  if(sel && !sel.dataset.filled){
    const types = Array.from(new Set((allViewableUsers || []).map(u => u.role || 'user'))).sort();
    sel.innerHTML = '<option value="">Every user type</option>' + types.map(t => `<option value="${escapeHtml(t)}">${escapeHtml(roleDisplayLabel(t))}</option>`).join('');
    sel.dataset.filled = '1';
  }
  const q = (permUserSearchText || '').trim().toLowerCase();
  const shown = (allViewableUsers || []).filter(u => {
    if(permUserTypeFilterValue && (u.role || 'user') !== permUserTypeFilterValue) return false;
    if(!q) return true;
    return (u.full_name || '').toLowerCase().includes(q) || (u.email || '').toLowerCase().includes(q);
  });
  if(!shown.length){
    body.innerHTML = '<div class="perm-side-empty">Nobody matches that.</div>';
    return;
  }
  body.innerHTML = shown.map(u => `
    <button type="button" class="perm-side-item${permUserId === u.id ? ' active' : ''}" data-perm-user="${u.id}">
      <span class="perm-side-item-main">
        <span class="perm-side-item-name">${escapeHtml(u.full_name || u.email)}${permOverrideByUser[u.id] ? ' <span class="perm-custom-tag">Custom</span>' : ''}</span>
        <span class="perm-side-item-sub">${escapeHtml(roleDisplayLabel(u.role || 'user'))}</span>
      </span>
    </button>`).join('');
  body.querySelectorAll('[data-perm-user]').forEach(btn => {
    btn.addEventListener('click', () => permOpenUser(btn.dataset.permUser));
  });
}

async function permOpenUser(userId){
  const u = (allViewableUsers || []).find(x => x.id === userId);
  if(!u) return;
  permUserId = userId;
  permUserRow = u;
  $('permUserMsg').textContent = '';
  let override = null;
  try {
    const { data } = await sb.from('user_permission_overrides').select('*').eq('user_id', userId).maybeSingle();
    override = data || null;
  } catch(e) { /* pre-v776 database */ }
  permUserOverride = override;
  permOverrideByUser[userId] = !!override;

  const roleName = u.role || 'user';
  $('permUserFormTitle').textContent = `${u.full_name || u.email} — ${roleDisplayLabel(roleName)}`;
  $('permUserFormIntro').innerHTML = override
    ? `This person has an exception on top of the <b>${escapeHtml(roleDisplayLabel(roleName))}</b> user type. Boxes marked <span class="perm-custom-tag">Custom</span> are where they differ from it.${override.note ? ` Reason recorded: ${escapeHtml(override.note)}` : ''}`
    : `This person currently gets exactly what the <b>${escapeHtml(roleDisplayLabel(roleName))}</b> user type gives them. Change anything below and it becomes an exception that follows them, not their type.`;
  $('permUserEditorBody').style.display = '';
  const values = permEffectiveValues(roleName, override);
  renderPermissionMatrix('permUserTabsPicker', values, { inherited: permRoleValues(roleName) });
  $('permUserCanTextClientsCb').checked = !!values.can_text_clients;
  $('permUserCanTextClientsCb').disabled = !ceilingAllowsFlag('can_text_clients');
  $('permUserCanEditCompensationCb').checked = !!values.can_edit_compensation;
  $('permUserCanEditCompensationCb').disabled = !ceilingAllowsFlag('can_edit_compensation');
  {
    // v778: Owner and Admin always may (dialer_manual_dial_allowed), so the
    // box would only mislead for them.
    const cb = $('permUserCanManualDialCb');
    const always = ['owner', 'admin'].includes(roleName);
    cb.checked = always || !!values.can_manual_dial;
    cb.disabled = always || !ceilingAllowsFlag('can_manual_dial');
    cb.title = always ? 'Owner and Admin can always manual dial.' : (ceilingAllowsFlag('can_manual_dial') ? '' : CEILING_TITLE);
  }
  $('permUserNote').value = (override && override.note) || '';
  $('permUserResetBtn').style.display = override ? '' : 'none';
  permRenderUserList();
  applyUmSectionEditGating('roles');
}

async function permSaveUser(){
  const msg = $('permUserMsg');
  if(!permUserId){ return; }
  if(permUserId === myUserId){
    msg.textContent = 'You cannot change your own access. Ask the Owner.';
    msg.className = 'msg error';
    return;
  }
  const matrix = permReadMatrix('permUserTabsPicker');
  const payload = Object.assign({ user_id: permUserId }, matrix, {
    can_text_clients: $('permUserCanTextClientsCb').checked,
    can_edit_compensation: $('permUserCanEditCompensationCb').checked,
    note: $('permUserNote').value.trim() || null,
  });
  {
    // v778: NULL = follow the user type. Writing the inherited value instead
    // would freeze it on this person, and would also make an Admin's save
    // fail the grant ceiling for anyone whose type already allows dialing.
    const roleName = (permUserRow && permUserRow.role) || 'user';
    const cb = $('permUserCanManualDialCb');
    payload.can_manual_dial = ['owner', 'admin'].includes(roleName) || cb.checked === !!permRoleValues(roleName).can_manual_dial
      ? null : cb.checked;
  }
  const btn = $('permUserSaveBtn');
  btn.disabled = true;
  msg.textContent = 'Saving…';
  msg.className = 'msg';
  const { error } = await sb.from('user_permission_overrides').upsert(payload, { onConflict: 'user_id' });
  btn.disabled = false;
  if(error){
    msg.textContent = error.message;
    msg.className = 'msg error';
    return;
  }
  logActivity('permission.user_override', 'user', permUserId, `Set a per-person access exception for ${permUserRow ? (permUserRow.full_name || permUserRow.email) : permUserId}`);
  msg.textContent = 'Saved. It applies the next time they sign in or refresh.';
  msg.className = 'msg success';
  await permLoadOverrides();
  await permOpenUser(permUserId);
}

async function permResetUser(){
  if(!permUserId) return;
  const who = permUserRow ? (permUserRow.full_name || permUserRow.email) : 'this person';
  if(!confirm(`Remove the exception for ${who}? They go back to exactly what their user type gives them, the next time they sign in or refresh.`)) return;
  const msg = $('permUserMsg');
  const { error } = await sb.from('user_permission_overrides').delete().eq('user_id', permUserId);
  if(error){
    msg.textContent = error.message;
    msg.className = 'msg error';
    return;
  }
  logActivity('permission.user_override_clear', 'user', permUserId, `Removed the per-person access exception for ${who}`);
  await permLoadOverrides();
  await permOpenUser(permUserId);
  msg.textContent = 'Exception removed — they follow their user type again.';
  msg.className = 'msg success';
}

// --- wiring ---------------------------------------------------------------
function permSetMode(mode){
  document.querySelectorAll('.perm-mode-btn').forEach(b => b.classList.toggle('active', b.dataset.permMode === mode));
  const g = $('permPaneGroups'), pp = $('permPanePeople');
  if(g) g.style.display = mode === 'groups' ? '' : 'none';
  if(pp) pp.style.display = mode === 'people' ? '' : 'none';
  if(mode === 'people'){ permLoadOverrides().then(permRenderUserList); }
}

function permInitRolesSection(){
  const banner = $('permCeilingBanner');
  if(banner){
    if(myGrantCeiling){
      $('permCeilingBannerText').innerHTML = `You can only grant access you have yourself. Anything the Owner has not given <b>${escapeHtml(roleDisplayLabel(myRole))}</b> is shown greyed out, and you cannot change your own user type. Ask the Owner to widen your access first.`;
      banner.style.display = '';
    } else {
      banner.style.display = 'none';
    }
  }
  permRenderUserList();
}

document.querySelectorAll('.perm-mode-btn').forEach(b => {
  b.addEventListener('click', () => permSetMode(b.dataset.permMode));
});
document.querySelectorAll('.perm-bulk-btn').forEach(b => {
  b.addEventListener('click', () => {
    const pane = b.closest('#permPanePeople') ? 'permUserTabsPicker' : 'roleTabsPicker';
    const root = permMatrixEl(pane);
    if(root) permApplyBulk(root, b.dataset.permBulk);
  });
});
if($('roleSearchInput')) $('roleSearchInput').addEventListener('input', (e) => { roleListFilter = e.target.value; renderRolesSideList(); });
if($('roleNewBtn')) $('roleNewBtn').addEventListener('click', () => { resetRoleForm(); renderRolesSideList(); });
if($('permUserSearch')) $('permUserSearch').addEventListener('input', (e) => { permUserSearchText = e.target.value; permRenderUserList(); });
if($('permUserTypeFilter')) $('permUserTypeFilter').addEventListener('change', (e) => { permUserTypeFilterValue = e.target.value; permRenderUserList(); });
if($('permUserSaveBtn')) $('permUserSaveBtn').addEventListener('click', permSaveUser);
if($('permUserResetBtn')) $('permUserResetBtn').addEventListener('click', permResetUser);
if($('roleDeleteBtn')) $('roleDeleteBtn').addEventListener('click', () => { if(editingRoleName) deleteRole(editingRoleName); });

function startEditRole(name){
  const role = allRoles.find(r => r.name === name);
  if(!role) return;
  editingRoleName = name;
  $('rolesFormTitle').textContent = `Editing "${name}"`;
  $('roleNameInput').value = role.name;
  // v776: renaming happens here now. It used to be an inline contenteditable
  // cell in the roles TABLE, which this screen no longer has. Owner and Admin
  // are hardcoded by name in a great many places, so those two are never
  // renameable (staff-rename-role and a DB trigger each refuse them too).
  const _renameable = !['owner', 'admin'].includes(role.name);
  $('roleNameInput').disabled = !_renameable;
  $('roleNameInput').dataset.original = role.name;
  $('roleNameInput').title = _renameable ? 'Change the name and click away to rename this user type' : 'Core user type — cannot be renamed';
  if($('roleDeleteBtn')) $('roleDeleteBtn').style.display = (role.is_protected || ['owner', 'admin'].includes(role.name)) ? 'none' : '';
  renderRoleTabsPicker(role.allowed_tabs || [], role.tab_edit || {}, role.um_sections || {}, role.activity_sections || {}, role.leads_sections || {}, role.csub_sections || {}, role.finance_sections || {}, role.hr_sections || {}, role.data_science_sections || {}, role.taxes_sections || {}, role.time_management_sections || {}, role.dialer_admin_sections || {});
  renderRoleTaskCategoriesPicker(role.task_category_ids || []);
  $('roleCanTextClientsCb').checked = !!role.can_text_clients;
  $('roleCanEditCompensationCb').checked = !!role.can_edit_compensation;
  $('roleCanManualDialCb').checked = !!role.can_manual_dial;
  $('roleCanManualDialCb').disabled = !ceilingAllowsFlag('can_manual_dial');
  $('roleCanManualDialCb').title = role.name === 'admin'
    ? 'Admins can always manual dial themselves. This decides whether they may give it to others.'
    : (ceilingAllowsFlag('can_manual_dial') ? '' : CEILING_TITLE);
  const scopeList = parseViewScopeList(role.view_scope);
  const isAll = scopeList.includes('all');
  $('roleViewScopeSelf').checked = !isAll && scopeList.includes('self');
  $('roleViewScopeSelected').checked = !isAll && scopeList.includes('selected');
  $('roleViewScopeSpecificRole').checked = !isAll && scopeList.includes('specific_role');
  $('roleViewScopeAll').checked = isAll;
  [$('roleViewScopeSelf'), $('roleViewScopeSelected'), $('roleViewScopeSpecificRole')].forEach(cb => cb.disabled = isAll);
  renderRoleViewUsersPicker(role.viewable_user_ids || []);
  renderRoleViewSpecificRoleOptions(role.viewable_role || null);
  updateRoleViewScopeVisibility();
  $('roleCancelEditBtn').style.display = 'inline-block';
  $('rolesMsg').textContent = '';
  if(typeof renderRolesSideList === 'function') renderRolesSideList();
}
$('roleCancelEditBtn').addEventListener('click', resetRoleForm);
// v776: rename on blur, the same convention task and task-category renames
// use. Only fires when the form is editing an existing type and the name
// actually changed (saveRoleRename checks that too).
if($('roleNameInput')){
  $('roleNameInput').addEventListener('blur', () => {
    if(editingRoleName && !$('roleNameInput').disabled) saveRoleRename($('roleNameInput'));
  });
  $('roleNameInput').addEventListener('keydown', (e) => {
    if(e.key === 'Enter'){ e.preventDefault(); $('roleNameInput').blur(); }
    if(e.key === 'Escape' && editingRoleName){ $('roleNameInput').value = $('roleNameInput').dataset.original || ''; $('roleNameInput').blur(); }
  });
}

$('roleSaveBtn').addEventListener('click', async () => {
  const msg = $('rolesMsg');
  const name = $('roleNameInput').value.trim().toLowerCase();
  // v776: one read of the matrix instead of eleven near-identical loops, one
  // per section family, that had to be kept in step with the renderer by hand.
  const matrix = permReadMatrix('roleTabsPicker');
  const allowedTabs = matrix.allowed_tabs;
  const tabEdit = matrix.tab_edit;
  // v1.2.7: "Only themselves" / "Only selected users" / "A specific user
  // type" are checkboxes now and can be combined freely; "All users" is
  // exclusive (checking it clears the other three in the UI already, but
  // we also enforce that here rather than trusting checkbox state alone).
  const checkedScopes = ['self', 'selected', 'specific_role'].filter(s => $(`roleViewScope${s === 'self' ? 'Self' : s === 'selected' ? 'Selected' : 'SpecificRole'}`).checked);
  const viewScopeList = $('roleViewScopeAll').checked ? ['all'] : (checkedScopes.length ? checkedScopes : ['self']);
  const viewScope = viewScopeList.join(',');
  const viewableUserIds = viewScopeList.includes('selected')
    ? Array.from(document.querySelectorAll('.role-view-user-cb:checked')).map(cb => cb.value)
    : [];
  const viewableRole = viewScopeList.includes('specific_role') ? ($('roleViewSpecificRoleSelect').value || null) : null;
  if(!name){
    msg.textContent = 'Give the role a name.';
    msg.className = 'msg error';
    return;
  }
  if(['owner', 'admin'].includes(name) && !editingRoleName){
    msg.textContent = '"owner" and "admin" already exist and are protected.';
    msg.className = 'msg error';
    return;
  }
  if(allowedTabs.length === 0){
    msg.textContent = 'Pick at least one tab, or this role won\u2019t have any dashboard access at all.';
    msg.className = 'msg error';
    return;
  }
  if(viewScopeList.includes('selected') && viewableUserIds.length === 0){
    msg.textContent = 'Pick at least one user this role can view, or uncheck "Only selected users".';
    msg.className = 'msg error';
    return;
  }
  if(viewScopeList.includes('specific_role') && !viewableRole){
    msg.textContent = 'Pick which user type this role can view.';
    msg.className = 'msg error';
    return;
  }

  // can_manage_users is intentionally omitted from this payload for every
  // role except when explicitly set below — creating, editing, resetting
  // passwords for, or deleting user accounts is Owner/Admin only,
  // enforced both by this dashboard and by the manage-user Edge Function.
  // No custom role can be granted it through this form; Admin already
  // has it from its seed data and this form never touches that value for
  // Admin specifically, so editing Admin's other permissions here can't
  // accidentally strip its ability to manage users.
  const taskCategoryIds = Array.from(document.querySelectorAll('.role-task-category-cb:checked')).map(cb => cb.value);

  // audit fix (audit_chunk3.md #4, Medium): saving a role can grant it any
  // combination of allowed_tabs (including finance/hr/data_science), full
  // Edit rights on any subtab, and a view_scope up to 'all' (every user's
  // data) -- in one click, taking effect for every user under that role
  // immediately, with no confirmation anywhere in this handler. Every other
  // consequential action nearby (deleteRole, deleteDialerDomain, every GHL/
  // ReadyMode "Disconnect", deactivating a promo code, canceling a one-off
  // charge) has a confirm() -- this was the one place explicitly designed
  // to control privilege escalation that didn't. Only prompts when
  // something sensitive is actually being granted (a bank/spending-adjacent
  // tab, or company-wide view access), so a routine tweak to an already-
  // narrow role isn't interrupted every time.
  const sensitiveTabs = allowedTabs.filter(t => ['finance', 'hr', 'data_science'].includes(t));
  const grantsAllUsers = viewScopeList.includes('all');
  if((sensitiveTabs.length || grantsAllUsers) && !confirm(
    `This role will have${sensitiveTabs.length ? ` access to: ${sensitiveTabs.join(', ')}` : ''}` +
    `${sensitiveTabs.length && grantsAllUsers ? ' and' : ''}` +
    `${grantsAllUsers ? ' visibility into every user’s data (view scope: All users)' : ''}. ` +
    `This takes effect immediately for every account with this role. Save anyway?`
  )) return;

  const payload = Object.assign({}, matrix, {
    view_scope: viewScope,
    viewable_user_ids: viewableUserIds,
    viewable_role: viewableRole,
    task_category_ids: taskCategoryIds,
    can_text_clients: $('roleCanTextClientsCb').checked,
    can_edit_compensation: $('roleCanEditCompensationCb').checked,
    can_manual_dial: $('roleCanManualDialCb').checked,
  });
  if(editingRoleName !== 'admin') payload.can_manage_users = false;
  // v675: the portal decides Dialer Admin access, so the database's own dialer
  // rights follow these ticks. Without this a role could be given Edit here
  // and have every save refused by the database.
  {
    const daTab = allowedTabs.includes('dialer_admin');
    const vals = Object.values(matrix.dialer_admin_sections || {});
    payload.can_manage_dialer = daTab && vals.some(v => v.edit);
    payload.can_review_calls = daTab && vals.some(v => v.view);
  }
  if(editingRoleName){
    // .select() here is deliberate: without it, an update blocked entirely
    // by RLS (e.g. this account isn't actually signed in as 'owner') comes
    // back with NO error and NO rows — Supabase treats "matched nothing"
    // as success. Checking data.length catches that silent no-op and
    // tells the user the truth instead of closing the form as if it saved.
    const { data, error } = await sb.from('roles').update(payload).eq('name', editingRoleName).select('name');
    if(error){ msg.textContent = error.message; msg.className = 'msg error'; return; }
    if(!data || data.length === 0){
      msg.textContent = 'Nothing was saved — you may not be signed in as the Owner account, which is required to edit user types.';
      msg.className = 'msg error';
      return;
    }
    logActivity('role.update', null, null, `Updated role "${editingRoleName}"`);
  } else {
    const { error } = await sb.from('roles').insert({ name, ...payload });
    if(error){
      msg.textContent = /duplicate|unique/i.test(error.message) ? 'That role name already exists.' : error.message;
      msg.className = 'msg error';
      return;
    }
    logActivity('role.create', null, null, `Created role "${name}" (tabs: ${allowedTabs.join(', ')})`);
  }
  resetRoleForm();
  await loadRolesList();
  await refreshAddUserRoleOptions(); // the Add User modal's Role dropdown should reflect the new/changed role immediately
});

async function deleteRole(name){
  // Name-based guard, deliberately not relying on is_protected alone —
  // Admin's is_protected is false (its permissions are editable now), but
  // it must still never be deletable: every Admin account depends on this
  // exact role row existing, the same way Owner's does.
  if(['owner', 'admin'].includes(name)){
    alert(`"${name}" can't be deleted.`);
    return;
  }
  if(!confirm(`Delete the "${name}" role? Any account still using it must be reassigned first.`)) return;
  const { error } = await sb.from('roles').delete().eq('name', name);
  if(error){
    alert(/foreign key|violat/i.test(error.message)
      ? `Can't delete "${name}" — at least one account still has this role. Reassign them first.`
      : error.message);
    return;
  }
  await loadRolesList();
  await refreshAddUserRoleOptions();
  logActivity('role.delete', null, null, `Deleted role "${name}"`);
}

// v361: rename a role — routed through the staff-rename-role Edge Function
// rather than a plain sb.from('roles').update(...), because profiles.role
// has a real FK back to roles(name) with `on update cascade`, and the
// cascaded update to every affected profiles row gets rejected by
// restrict_profile_self_update_columns() unless it's run with the service
// role key (see the Edge Function's own file-level comment for the full
// story). 'owner'/'admin' are never offered a rename control at all (see
// loadRolesList()); the Edge Function and a DB trigger both also
// independently refuse those two regardless.
async function roleRenameInvokeErrorMessage(error, data){
  if(data && data.error) return data.error;
  if(error && error.context && typeof error.context.json === 'function'){
    try {
      const body = await error.context.json();
      if(body && body.error) return body.error;
    } catch(e) { /* not JSON, or body already consumed -- fall through */ }
  }
  return (error && error.message) || 'unknown error';
}
// v776: this is an <input> now (the roles table it used to live in is gone),
// so it reads .value rather than .textContent. Everything else — including
// routing through staff-rename-role because profiles.role has an
// `on update cascade` FK only the service role may fire — is unchanged.
function _roleNameText(el){ return (el.value !== undefined ? el.value : el.textContent) || ''; }
function _setRoleNameText(el, v){ if(el.value !== undefined) el.value = v; else el.textContent = v; }
async function saveRoleRename(nameEl){
  const newName = _roleNameText(nameEl).trim().toLowerCase();
  const oldName = nameEl.dataset.original;
  if(!newName || newName === oldName){
    _setRoleNameText(nameEl, oldName);
    return;
  }
  const msg = $('rolesMsg');
  const { data, error } = await sb.functions.invoke('staff-rename-role', { body: { old_name: oldName, new_name: newName } });
  if(error || !data || data.ok === false){
    const errMsg = await roleRenameInvokeErrorMessage(error, data);
    msg.textContent = errMsg;
    msg.className = 'msg error';
    _setRoleNameText(nameEl, oldName);
    return;
  }
  nameEl.dataset.original = newName;
  _setRoleNameText(nameEl, newName);
  msg.textContent = 'Renamed.';
  msg.className = 'msg';
  msg.style.color = 'var(--focus)';
  logActivity('role.rename', null, null, `Renamed role "${oldName}" to "${newName}"`);
  if(editingRoleName === oldName){
    editingRoleName = newName;
    $('rolesFormTitle').textContent = `Editing "${newName}"`;
    $('roleNameInput').value = newName;
  }
  await loadRolesList();
  await refreshAddUserRoleOptions();
}

async function saveTaskRename(nameEl){
  const newName = nameEl.textContent.trim();
  const taskId = nameEl.dataset.id;
  const oldName = nameEl.dataset.original;
  if(!newName || newName === oldName) {
    nameEl.textContent = oldName;
    return;
  }
  const { error } = await sb.from('tasks').update({ name: newName }).eq('id', taskId);
  const msg = $('tasksMsg');
  if(error){
    msg.textContent = error.message;
    msg.className = 'msg error';
    nameEl.textContent = oldName;
  } else {
    nameEl.dataset.original = newName;
    msg.textContent = 'Renamed.';
    msg.className = 'msg';
    msg.style.color = 'var(--focus)';
    logActivity('task.rename', 'task', taskId, `Renamed task "${oldName}" to "${newName}"`);
  }
}

$('showArchivedTasksToggle') && $('showArchivedTasksToggle').addEventListener('change', loadTasksList);
$('addTaskBtn').addEventListener('click', async () => {
  const btn = $('addTaskBtn');
  if(btn.disabled) return; // guards against a fast double-click inserting two identical tasks
  const input = $('newTaskInput');
  const name = input.value.trim();
  if(!name) return;
  const msg = $('tasksMsg');
  btn.disabled = true;
  try{
    const projectId = await getOrCreateDefaultProject();
    const { data, error } = await sb.from('tasks').insert({ project_id: projectId, name }).select('id').single();
    if(error) throw error;
    input.value = '';
    msg.textContent = '';
    await loadTasksList();
    logActivity('task.create', 'task', data.id, `Created task "${name}"`);
  }catch(e){
    msg.textContent = e.message;
    msg.className = 'msg error';
  }finally{
    btn.disabled = false;
  }
});

// v103: previously this swallowed any error completely — a task with
// time_entries/leads recorded against it (exactly the well-used, real
// tasks like "Sales" or a Cold Calling task, not a fresh unused one) hits
// tasks.leads/time_entries' foreign key (deliberately not cascading, so
// old reports never go blank) and the delete silently no-ops, leaving the
// task sitting right there with no explanation — indistinguishable from
// the button just not working. Now that failure is caught and offered a
// real resolution: archive it instead (see tasks.archived_at above).
async function deleteTask(taskId, taskName){
  const { error } = await sb.from('tasks').delete().eq('id', taskId);
  if(error){
    if(error.code === '23503' || /foreign key|violates/i.test(error.message)){
      if(confirm(`"${taskName}" has time entries and/or leads recorded against it, so it can't be permanently deleted without breaking past reports. Archive it instead? Archived tasks disappear from assignment and the extension's task picker, but every existing timesheet/lead still shows "${taskName}" correctly. You can unarchive it later.`)){
        await archiveTask(taskId, taskName);
      }
      return;
    }
    alert(error.message);
    return;
  }
  await loadTasksList();
  if(currentDetailAgent) await loadAssignedTasks(currentDetailAgent.id);
  logActivity('task.delete', 'task', taskId, `Deleted task "${taskName || taskId}"`);
}

async function archiveTask(taskId, taskName){
  const { error } = await sb.from('tasks').update({ archived_at: new Date().toISOString() }).eq('id', taskId);
  if(error){ alert(error.message); return; }
  await loadTasksList();
  logActivity('task.archive', 'task', taskId, `Archived task "${taskName}"`);
}

async function unarchiveTask(taskId, taskName){
  const { error } = await sb.from('tasks').update({ archived_at: null }).eq('id', taskId);
  if(error){ alert(error.message); return; }
  await loadTasksList();
  logActivity('task.unarchive', 'task', taskId, `Unarchived task "${taskName}"`);
}

// ---------- per-agent task assignment ----------
async function loadAssignedTasks(agentId){
  const { data: allTasks } = await sb.from('tasks').select('id, name, archived_at').order('name');
  const { data: assignments } = await sb.from('task_assignments').select('task_id').eq('user_id', agentId);
  const assignedIds = new Set((assignments||[]).map(a => a.task_id));
  // Archived tasks drop out of this picker entirely — unless this agent
  // already happens to be assigned to one (e.g. it was archived after the
  // fact), in which case it still shows so the assignment is visible/
  // removable rather than silently vanishing.
  const tasks = (allTasks || []).filter(t => !t.archived_at || assignedIds.has(t.id));

  const list = $('assignedTasksList');
  list.innerHTML = '';
  if(!tasks || tasks.length === 0){
    list.innerHTML = '<div class="empty">No tasks exist yet — add some above.</div>';
    return;
  }
  tasks.forEach(t => {
    const row = document.createElement('div');
    row.className = 'assign-row';
    const checked = assignedIds.has(t.id);
    row.innerHTML = `
      <input type="checkbox" id="assign-${t.id}" class="edit-only" ${checked ? 'checked' : ''}>
      <label for="assign-${t.id}">${escapeHtml(t.name)}${t.archived_at ? ' <span class="mono" style="font-size:10px; color:var(--text-dim);">(archived)</span>' : ''}</label>
    `;
    row.querySelector('input').addEventListener('change', async (e) => {
      const agentLabel = currentDetailAgent ? (currentDetailAgent.full_name || currentDetailAgent.email) : agentId;
      if(e.target.checked){
        await sb.from('task_assignments').insert({ task_id: t.id, user_id: agentId });
        logActivity('assignment.add', 'agent', agentId, `Assigned "${t.name}" to ${agentLabel}`);
      } else {
        await sb.from('task_assignments').delete().eq('task_id', t.id).eq('user_id', agentId);
        logActivity('assignment.remove', 'agent', agentId, `Unassigned "${t.name}" from ${agentLabel}`);
      }
      loadTasksList();
    });
    list.appendChild(row);
  });
  applyTimeManagementSectionEditGating('staff'); // checkboxes were just rebuilt from scratch — need the lock state re-applied
}

// ---------- timesheets: view, filter, add/edit/delete ----------
let lastTimesheetRows = [];
let tsAllAgents = [];
let tsAllTasks = [];
let tsShotsLoaded = {};
let tsAgentTz = {}; // user_id -> IANA timezone string, from schedules.timezone

// "Today", as a date-input value, in the currently-selected global display
// zone (Cairo/Chicago) — NOT the browser's own local date. This keeps the
// Timesheets default filter consistent with the "Times shown in" toggle:
// near a day boundary, Cairo and Chicago can disagree on what "today" is,
// and the filter should match whichever zone the admin is currently
// viewing times in.
function todayDateInputValue(){
  return localDateKeyInZone(new Date(), globalDisplayTzMode);
}

// v237: last day of whichever calendar month contains "today" — used as
// the default upper bound for a handful of date-range filters that used
// to cap at "today" itself (Timesheets, Flags, Call Activity, Client
// Submissions). Deliberately only touches the upper bound of a default
// range, never the lower one — someone opening the dashboard on the 26th
// sees their normal default window extended through the 31st, not a
// differently-shaped window. Pure calendar math on the already tz-aware
// todayDateInputValue() output, so this doesn't need its own timezone
// handling.
function endOfLoginMonthDateInputValue(){
  const [y, m] = todayDateInputValue().split('-').map(Number);
  const lastDay = new Date(y, m, 0).getDate(); // day 0 of "next" 0-indexed month = last day of month m
  return `${String(y).padStart(4, '0')}-${String(m).padStart(2, '0')}-${String(lastDay).padStart(2, '0')}`;
}

// v257: fixed default date range, replacing the various relative
// defaults (today-only / last-N-days / end-of-current-month) that
// several tabs used to fall back to — a wide, explicit window (go-live
// through the foreseeable future) so a default filter never again
// silently caps out newly created records partway through a month.
// Still only ever fills in an EMPTY pair of fields, same as every
// default this replaces — a deliberately narrower range someone actually
// picked (or has saved) is never overwritten.
const DEFAULT_DATE_RANGE_FROM = '2026-07-01';
const DEFAULT_DATE_RANGE_TO = '2050-12-31';

// True only when From and To are the same calendar day — several things
// below (the hourly timeline, per-row time-only formatting) only make
// sense for a single day and switch to a range-appropriate fallback
// otherwise.
function tsIsSingleDay(){
  const fromVal = $('tsFromDateInput').value || todayDateInputValue();
  const toVal = $('tsToDateInput').value || fromVal;
  return fromVal === toVal;
}

function tsRangeBounds(){
  const fromVal = $('tsFromDateInput').value || todayDateInputValue();
  const toVal = $('tsToDateInput').value || fromVal;
  const [fy, fm, fd] = fromVal.split('-').map(Number);
  const [ty, tm, td] = toVal.split('-').map(Number);
  // Boundaries are timezone-sensitive. v1.2.34: resolved through tsTzFor()
  // — the SAME resolver every row's displayed timestamp already uses — so
  // the global "Times shown in" toggle (Cairo/Chicago) actually changes
  // which calendar day the daily timeline bar, its 12am–12am axis, and the
  // productive/break/idle totals are computed for. Previously this read
  // tsAgentTz directly and ignored the toggle entirely: switching Cairo/
  // Chicago re-ran loadTimesheets() (via the toggle's click handler) but
  // the boundaries never moved, so the bar and totals silently stayed on
  // whatever zone the agent's own schedule happened to specify. Only when
  // the toggle is explicitly left on "Per agent" does this now fall back
  // to that agent's own schedule timezone (or the browser's local day if
  // the agent has none set) — same overnight-shift-splits-at-local-
  // midnight behavior as before, just now opt-in instead of the only option.
  const tz = tsTzFor($('tsAgentFilter').value) || null;
  const { startMs } = dayBoundsMsInZone(tz, null, fy, fm, fd);
  const { endMs } = dayBoundsMsInZone(tz, null, ty, tm, td);
  // endMs here is the LAST millisecond of the "to" day (23:59:59.999) in
  // the selected timezone — correct as both the single-day case (fromVal
  // === toVal) and the multi-day range end.
  return { start: new Date(startMs).toISOString(), end: new Date(endMs).toISOString(), startMs, endMs };
}

// Clip a [rawStart, rawEnd] span to a [rangeStartMs, rangeEndMs] window,
// returning seconds. Used so entries spanning midnight (or the week
// boundary) don't overcount or vanish from the selected view.
function clipSeconds(rawStart, rawEnd, rangeStartMs, rangeEndMs){
  const s = Math.max(rawStart, rangeStartMs);
  const e = Math.min(rawEnd, rangeEndMs);
  return Math.max(0, (e - s) / 1000);
}

// Splits one time_entry into separate tracking/idle/break segments — this
// is what gives the Timesheets tab "one row per status" instead of one
// combined row with idle%/break% baked in, and as a side effect the
// tracking segment's own duration is automatically idle-free (idle time
// simply becomes its own separate row rather than being subtracted after
// the fact). idlePeriods/breaksForEntry are that entry's own idle_periods/
// breaks rows; everything is clipped to [windowStartMs, windowEndMs] and to
// "now" for anything still open (ongoing tracking/idle/break).
function buildStatusSegments(entry, idlePeriods, breaksForEntry, windowStartMs, windowEndMs){
  const rawStart = new Date(entry.start_time).getTime();
  const rawEnd = entry.end_time ? new Date(entry.end_time).getTime() : Date.now();
  const spanStart = Math.max(rawStart, windowStartMs);
  const spanEnd = Math.min(rawEnd, windowEndMs);
  if (spanEnd <= spanStart) return [];

  const pauses = [];
  (idlePeriods || []).forEach(p => {
    const s = Math.max(new Date(p.start_time).getTime(), spanStart);
    const en = Math.min(p.end_time ? new Date(p.end_time).getTime() : Date.now(), spanEnd);
    if (en > s) pauses.push({ status: 'idle', start: s, end: en, note: p.agent_note || null });
  });
  (breaksForEntry || []).forEach(p => {
    const s = Math.max(new Date(p.start_time).getTime(), spanStart);
    const en = Math.min(p.end_time ? new Date(p.end_time).getTime() : Date.now(), spanEnd);
    if (en > s) pauses.push({ status: 'break', start: s, end: en });
  });
  pauses.sort((a, b) => a.start - b.start);

  const segments = [];
  let cursor = spanStart;
  pauses.forEach(p => {
    if (p.start > cursor) segments.push({ status: 'tracking', start: cursor, end: p.start });
    if (p.end > cursor) {
      segments.push({ status: p.status, start: Math.max(p.start, cursor), end: p.end, note: p.note || null });
      cursor = p.end;
    }
  });
  if (cursor < spanEnd) segments.push({ status: 'tracking', start: cursor, end: spanEnd });

  return segments.filter(s => s.end > s.start);
}

$('tsFromDateInput').addEventListener('change', () => {
  // Keep To from ever being before From — swapping them silently would be
  // confusing, so just pull To up to match instead.
  if($('tsToDateInput').value && $('tsToDateInput').value < $('tsFromDateInput').value){
    $('tsToDateInput').value = $('tsFromDateInput').value;
  }
  loadTimesheets();
});
$('tsToDateInput').addEventListener('change', () => {
  if($('tsFromDateInput').value && $('tsFromDateInput').value > $('tsToDateInput').value){
    $('tsFromDateInput').value = $('tsToDateInput').value;
  }
  loadTimesheets();
});
$('tsAgentFilter').addEventListener('change', loadTimesheets);

// Resolves which IANA timezone to render times in for a given agent, based
// on the shared global "Times shown in" toggle (Cairo/Chicago):
//  - "agent": that agent's own schedules.timezone — i.e. their PC/local
//    time, exactly as chrome.idle/the popup timer see it, without touching
//    the extension at all (the extension already stores/reports everything
//    in UTC; this only changes how the dashboard *displays* it). Falls back
//    to browser-local if that agent has no schedule/timezone set. (Not
//    currently reachable from this toggle's UI, but left supported.)
//  - anything else: that explicit IANA zone, for every row regardless of agent.
function tsTzFor(agentId){
  if(globalDisplayTzMode === 'agent') return (agentId && tsAgentTz[agentId]) || undefined;
  return globalDisplayTzMode || undefined;
}
function tsFmtTime(d, agentId){
  const tz = tsTzFor(agentId);
  return new Date(d).toLocaleTimeString([], { hour:'2-digit', minute:'2-digit', ...(tz ? { timeZone: tz } : {}) });
}
function tsFmtDateTime(d, agentId){
  const tz = tsTzFor(agentId);
  return new Date(d).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(tz ? { timeZone: tz } : {}) });
}

// Merges a set of possibly-overlapping [start_time, end_time] rows into
// non-overlapping intervals and returns the total seconds actually
// covered. entryBounds (id -> {start, end} in ms) additionally clips each
// row to its OWN parent time_entry's span, not just the day window — an
// idle_periods/breaks row with a missing end_time (orphaned, never closed
// properly) would otherwise be treated as running all the way to "now",
// even if the entry it belongs to ended hours or days ago. Clamping to the
// parent entry's own end_time fixes that regardless of whether the
// idle/break row itself was ever closed out correctly.
function mergedCoverageSec(rows, rangeStartMs, rangeEndMs, entryBounds){
  const intervals = (rows || [])
    .map(r => {
      const eb = entryBounds && entryBounds[r.time_entry_id];
      const lo = eb ? Math.max(rangeStartMs, eb.start) : rangeStartMs;
      const hi = eb ? Math.min(rangeEndMs, eb.end) : rangeEndMs;
      const s = Math.max(new Date(r.start_time).getTime(), lo);
      const e = Math.min(r.end_time ? new Date(r.end_time).getTime() : Date.now(), hi);
      return [s, e];
    })
    .filter(([s, e]) => e > s)
    .sort((a, b) => a[0] - b[0]);

  let sec = 0, curStart = null, curEnd = null;
  intervals.forEach(([s, e]) => {
    if (curStart === null) { curStart = s; curEnd = e; return; }
    if (s <= curEnd) { curEnd = Math.max(curEnd, e); }
    else { sec += (curEnd - curStart) / 1000; curStart = s; curEnd = e; }
  });
  if (curStart !== null) sec += (curEnd - curStart) / 1000;
  return sec;
}

async function renderDayTimeline(entries, agentId, startMs, endMs){
  const track = $('tsDayTimeline');
  const marks = $('tsDayHourMarks');
  const label = $('tsDayTotalLabel');
  const singleDay = tsIsSingleDay();

  if(!agentId){
    track.style.display = 'none';
    marks.style.display = 'none';
    $('tsDayLegend').style.display = 'none';
    $('tsDayBreakdown').style.display = 'none';
    $('tsDayActivity').textContent = '—';
    label.textContent = 'Select a user to see their totals';
    return;
  }

  // The hourly bar itself only makes sense for a single day (it positions
  // segments as a % of one 24h span) — hidden for a wider range, with a
  // one-line hint instead. The productive/idle/break TOTALS below aren't
  // single-day-specific though (they're just clipped seconds within
  // whatever range is selected), so those still compute and show for a
  // multi-day range too, just without the visual bar.
  track.style.display = singleDay ? 'block' : 'none';
  marks.style.display = singleDay ? 'flex' : 'none';
  $('tsDayLegend').style.display = singleDay ? 'flex' : 'none';
  $('tsDayBreakdown').style.display = 'flex';
  track.innerHTML = '';

  const dayMs = endMs - startMs;
  let grossSec = 0;
  entries.forEach(e => {
    const rawStart = new Date(e.start_time).getTime();
    // v218: was `e.end_time ? ... : Date.now()` — see liveEntryEndMs()'s
    // own comment. A still-open entry whose heartbeat has gone stale
    // (agent signed out / crashed / lost network with no Stop click)
    // otherwise counted every second up to right now as gross/productive
    // time on this exact chart, growing forever until the hourly
    // auto-close-stale-entries job eventually closed the row.
    const rawEnd = liveEntryEndMs(e);
    const sec = clipSeconds(rawStart, rawEnd, startMs, endMs);
    if(sec <= 0) return;
    grossSec += sec;
    if(!singleDay) return; // totals still need grossSec above; bar itself is skipped
    const startPct = Math.max(0, (Math.max(rawStart, startMs) - startMs) / dayMs * 100);
    const endPct = Math.min(100, (Math.min(rawEnd, endMs) - startMs) / dayMs * 100);
    const div = document.createElement('div');
    div.className = 'segment';
    div.style.left = startPct + '%';
    div.style.width = Math.max(0.15, endPct - startPct) + '%';
    // v106: this bar's own legend promises green = Productive (see
    // #tsDayLegend just below it), but these base segments were being
    // colored per-TASK via colorFor() instead — whichever arbitrary color
    // a task happened to land on (often a pink/red from the same palette
    // used elsewhere), which read as "mostly idle" at a glance even on a
    // fully-productive day. Break/idle are already correctly overlaid in
    // orange/red below; the base segment is productive time, so it's
    // fixed green, matching the legend it sits under.
    div.style.background = 'var(--good)';
    track.appendChild(div);
  });

  // overlay real break (orange) and idle (red) segments on top of the
  // task-colored bars, so a glance at the timeline shows exactly when the
  // agent was working vs. on a break vs. genuinely idle.
  // Scoped to time_entry_id IN (this day's entries) rather than just
  // user_id + date overlap — without this, any orphaned/stale idle or
  // break row (e.g. left open from days ago, never properly closed) gets
  // pulled in and clipped to "now" within today's window, each
  // contributing up to a full day's worth of idle/break time and wildly
  // inflating the total (same class of bug already fixed for the Staff
  // tab's status column).
  // audit fix (Time Management deep-scan pass): paginated for consistency —
  // even single-agent-scoped, a wide date range's activity_samples below in
  // particular can plausibly exceed the row cap (~1 row/min while active);
  // see fetchAllRows()'s own comment.
  const entryIds = entries.map(e => e.id);
  const [breaksToday, idleToday] = entryIds.length
    ? await Promise.all([
        fetchAllRows((from, to) => sb.from('breaks').select('time_entry_id, start_time, end_time').in('time_entry_id', entryIds).order('id', { ascending: true }).range(from, to)),
        fetchAllRows((from, to) => sb.from('idle_periods').select('time_entry_id, start_time, end_time').in('time_entry_id', entryIds).order('id', { ascending: true }).range(from, to)),
      ])
    : [[], []];

  const entryBounds = {};
  entries.forEach(e => {
    entryBounds[e.id] = {
      start: new Date(e.start_time).getTime(),
      end: e.end_time ? new Date(e.end_time).getTime() : Date.now(),
    };
  });

  // drawOverlay is purely visual now — drawing each raw row is harmless
  // even if two overlap (they just stack), but the SECONDS TOTAL must not
  // be summed the same naive way, or overlapping/duplicate rows double-
  // count. See mergedCoverageSec above for the actual total. Also clipped
  // to each row's own parent entry bounds, same reasoning as
  // mergedCoverageSec, so the bar itself doesn't visually stretch an
  // orphaned idle/break row past when its entry actually ended.
  const drawOverlay = (rows, color) => {
    if(!singleDay) return; // bar itself isn't shown for a range — nothing to overlay
    (rows || []).forEach(r => {
      const eb = entryBounds[r.time_entry_id];
      const lo = eb ? Math.max(startMs, eb.start) : startMs;
      const hi = eb ? Math.min(endMs, eb.end) : endMs;
      const rawStart = new Date(r.start_time).getTime();
      const rawEnd = r.end_time ? new Date(r.end_time).getTime() : Date.now();
      const s = clipSeconds(rawStart, rawEnd, lo, hi);
      if(s <= 0) return;
      const startPct = Math.max(0, (Math.max(rawStart, lo) - startMs) / dayMs * 100);
      const endPct = Math.min(100, (Math.min(rawEnd, hi) - startMs) / dayMs * 100);
      const div = document.createElement('div');
      div.className = 'segment';
      div.style.left = startPct + '%';
      div.style.width = Math.max(0.15, endPct - startPct) + '%';
      div.style.background = color;
      track.appendChild(div);
    });
  };
  drawOverlay(breaksToday, 'var(--away)');   // breaks: orange
  drawOverlay(idleToday, 'var(--danger)');   // idle: red
  const tableBreakSec = mergedCoverageSec(breaksToday, startMs, endMs, entryBounds);
  const tableIdleSec = mergedCoverageSec(idleToday, startMs, endMs, entryBounds);

  // Manual entries (added via "+ Add time") never have their own
  // idle_periods/breaks rows — any idle/break time for them only exists as
  // the idle_seconds/break_seconds the admin typed into the modal. Add
  // those in here so a manual entry's non-idle/break portion correctly
  // counts as productive instead of the whole entry silently being left
  // out of every bucket.
  let manualBreakSec = 0, manualIdleSec = 0;
  entries.forEach(e => {
    if (e.is_manual) {
      manualBreakSec += e.break_seconds || 0;
      manualIdleSec += e.idle_seconds || 0;
    }
  });

  const breakSec = tableBreakSec + manualBreakSec;
  const idleSec = tableIdleSec + manualIdleSec;
  const productiveSec = Math.max(0, grossSec - breakSec - idleSec);

  // Total activity % for the summary card: the average of every activity
  // sample captured during this range (same activity_pct rows the per-row
  // "Activity" column below averages per segment), clipped to each entry's
  // own bounds so a sample from outside the selected range/entry never
  // pulls the total up or down. Manual entries have no samples of their
  // own (see manualBreakSec/manualIdleSec above) so they're simply
  // excluded from this average rather than counted as 0%.
  const activitySamples = entryIds.length
    ? await fetchAllRows((from, to) => sb.from('activity_samples').select('time_entry_id, activity_pct, sampled_at').in('time_entry_id', entryIds).order('id', { ascending: true }).range(from, to))
    : [];
  const activityValues = (activitySamples || []).filter(s => {
    const eb = entryBounds[s.time_entry_id];
    const lo = eb ? Math.max(startMs, eb.start) : startMs;
    const hi = eb ? Math.min(endMs, eb.end) : endMs;
    const ms = new Date(s.sampled_at).getTime();
    return ms >= lo && ms < hi && s.activity_pct != null;
  }).map(s => s.activity_pct);
  const totalActivityPct = activityValues.length
    ? Math.round(activityValues.reduce((a,v) => a+v, 0) / activityValues.length)
    : null;

  $('tsDayProductive').textContent = fmtHMSLong(productiveSec);
  $('tsDayBreak').textContent = fmtHMSLong(breakSec);
  $('tsDayIdle').textContent = fmtHMSLong(idleSec);
  $('tsDayActivity').textContent = totalActivityPct !== null ? totalActivityPct + '%' : '—';

  const fromVal = $('tsFromDateInput').value || todayDateInputValue();
  const toVal = $('tsToDateInput').value || fromVal;
  const fmtDate = v => new Date(v + 'T00:00:00').toLocaleDateString([], { weekday:'short', month:'short', day:'numeric', year:'numeric' });
  const rangeLabel = singleDay ? fmtDate(fromVal) : `${fmtDate(fromVal)} – ${fmtDate(toVal)}`;
  // Headline number is productive time only — idle and break are broken
  // out separately just below rather than folded into this total.
  label.textContent = `${rangeLabel}: ${fmtHMSLong(productiveSec)}`;
}

function fmtHMSLong(sec){
  sec = Math.max(0, Math.round(sec));
  const h = Math.floor(sec/3600), m = Math.floor((sec%3600)/60), s = sec%60;
  return `${h}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
}

// close any open Actions dropdown when clicking elsewhere
document.addEventListener('click', (e) => {
  if(!e.target.closest('.ts-actions')){
    document.querySelectorAll('.ts-dropdown-menu.open').forEach(m => m.classList.remove('open'));
  }
});

async function loadTimesheets(){
  tsShotsLoaded = {};
  if(!$('tsFromDateInput').value) $('tsFromDateInput').value = todayDateInputValue();
  if(!$('tsToDateInput').value) $('tsToDateInput').value = endOfLoginMonthDateInputValue();

  // audit fix (Time Management deep-scan pass): profiles/tasks/schedules are
  // small for most orgs today, but nothing archives old tasks and a large
  // roster can grow past the row cap over time — paginated for consistency
  // with every other Time Management query, same reasoning as
  // fetchAllRows()'s own comment.
  const agents = await fetchAllRows((from, to) => sb.from('profiles').select('id, full_name, email, role').order('full_name').range(from, to));
  tsAllAgents = (agents||[]).filter(a => !PROTECTED_ROLES.has(a.role));
  const tasks = await fetchAllRows((from, to) => sb.from('tasks').select('id, name').order('name').range(from, to));
  tsAllTasks = tasks || [];
  const scheduleRows = await fetchAllRows((from, to) => sb.from('schedules').select('user_id, timezone').order('user_id', { ascending: true }).range(from, to));
  tsAgentTz = {};
  (scheduleRows || []).forEach(s => { if(s.timezone) tsAgentTz[s.user_id] = s.timezone; });

  const filterSel = $('tsAgentFilter');
  const prevFilter = filterSel.value;
  filterSel.innerHTML = tsAllAgents.map(a => `<option value="${a.id}">${escapeHtml(a.full_name || a.email)}</option>`).join('');
  // No "All users" option anymore — the daily timeline only ever makes
  // sense for one specific agent, so always land on a real one: keep
  // whatever was previously selected if it's still valid, otherwise fall
  // back to the first agent in the list.
  filterSel.value = (prevFilter && tsAllAgents.some(a => a.id === prevFilter)) ? prevFilter : ((tsAllAgents[0] || {}).id || '');

  $('tsModalAgent').innerHTML = tsAllAgents.map(a => `<option value="${a.id}">${escapeHtml(a.full_name || a.email)}</option>`).join('');
  $('tsModalTask').innerHTML = '<option value="">No task</option>' +
    tsAllTasks.map(t => `<option value="${t.id}">${escapeHtml(t.name)}</option>`).join('');

  const { start, end, startMs, endMs } = tsRangeBounds();

  // fetch entries that OVERLAP the window (still open, or ended after it
  // started) rather than only ones that started inside it — see the same
  // pattern used in loadTeam for why.
  // audit fix (Time Management deep-scan pass): unbounded fetch — "All
  // users" (no filterSel.value) over a wide range can exceed the row cap;
  // see fetchAllRows()'s own comment.
  const rawEntries = await fetchAllRows((from, to) => {
    let q = sb.from('time_entries')
      .select('id, user_id, task_id, start_time, end_time, idle_seconds, break_seconds, is_manual, is_edited, last_heartbeat_at')
      .lte('start_time', end)
      .or(`end_time.is.null,end_time.gte.${start}`)
      .order('start_time', { ascending: false });
    if(filterSel.value) q = q.eq('user_id', filterSel.value);
    return q.range(from, to);
  });

  // Defensive de-dupe for the view: the database's exclusion constraint
  // (see schema.sql) now blocks new overlapping/duplicate rows outright,
  // but this collapses any pre-existing duplicate records (identical
  // agent/task/start/end) so they don't double-count in the list or the
  // totals below. Keeps the earliest-created row of each duplicate set.
  const seenKeys = new Set();
  const entries = (rawEntries || []).filter(e => {
    const key = `${e.user_id}|${e.task_id||''}|${e.start_time}|${e.end_time||''}`;
    if(seenKeys.has(key)) return false;
    seenKeys.add(key);
    return true;
  });

  const agentName = id => { const a = tsAllAgents.find(x=>x.id===id); return a ? (a.full_name||a.email) : '—'; };
  const taskName = id => { const t = tsAllTasks.find(x=>x.id===id); return t ? t.name : '—'; };

  await renderDayTimeline(entries || [], filterSel.value, startMs, endMs);

  const body = $('timesheetBody');
  body.innerHTML = '';
  lastTimesheetRows = [];
  if(!entries || entries.length === 0){
    body.innerHTML = '<tr><td colspan="7" class="empty">No entries in this range.</td></tr>';
    return;
  }

  // audit fix (Time Management deep-scan pass): these are bounded by
  // entryIds' size in principle, but that size is no longer capped now
  // that rawEntries itself is fully paginated above — "All users" over a
  // wide range can produce enough entries that activity_samples (~1
  // row/min per entry while active) still exceeds the row cap on its own.
  // Paginated for consistency; see fetchAllRows()'s own comment.
  const entryIds = entries.map(e => e.id);
  const shotRows = await fetchAllRows((from, to) => sb.from('screenshots').select('time_entry_id, taken_at').in('time_entry_id', entryIds).order('id', { ascending: true }).range(from, to));
  const shotsByEntry = {};
  (shotRows||[]).forEach(s => { if(!shotsByEntry[s.time_entry_id]) shotsByEntry[s.time_entry_id] = []; shotsByEntry[s.time_entry_id].push(s.taken_at); });

  const sampleRows = await fetchAllRows((from, to) => sb.from('activity_samples').select('time_entry_id, activity_pct, mouse_pct, keyboard_pct, sampled_at').in('time_entry_id', entryIds).order('id', { ascending: true }).range(from, to));
  const samplesByEntry = {};
  (sampleRows||[]).forEach(s => { if(!samplesByEntry[s.time_entry_id]) samplesByEntry[s.time_entry_id] = []; samplesByEntry[s.time_entry_id].push(s); });

  // This entry's own idle_periods/breaks — what buildStatusSegments splits
  // it into. Same tables the day timeline overlay already draws from.
  const [idleRows, breakRows] = await Promise.all([
    fetchAllRows((from, to) => sb.from('idle_periods').select('time_entry_id, start_time, end_time, agent_note').in('time_entry_id', entryIds).order('id', { ascending: true }).range(from, to)),
    fetchAllRows((from, to) => sb.from('breaks').select('time_entry_id, start_time, end_time').in('time_entry_id', entryIds).order('id', { ascending: true }).range(from, to)),
  ]);
  const idleByEntry = {}; (idleRows||[]).forEach(r => { if(!idleByEntry[r.time_entry_id]) idleByEntry[r.time_entry_id] = []; idleByEntry[r.time_entry_id].push(r); });
  const breakByEntry = {}; (breakRows||[]).forEach(r => { if(!breakByEntry[r.time_entry_id]) breakByEntry[r.time_entry_id] = []; breakByEntry[r.time_entry_id].push(r); });

  const STATUS_META = {
    tracking: { label: 'productive', dot: 'on', text: 'pct-focus' },
    idle: { label: 'idle', dot: 'status-idle', text: 'text-idle' },
    break: { label: 'break', dot: 'status-break', text: 'text-break' },
  };

  entries.forEach(e => {
    const task = tsAllTasks.find(t => t.id === e.task_id);
    const taskLabel = task ? task.name : 'No task';
    const initial = taskLabel.charAt(0).toUpperCase();
    const showFullDate = !tsIsSingleDay() || !filterSel.value;
    const timeFmt = d => showFullDate ? tsFmtDateTime(d, e.user_id) : tsFmtTime(d, e.user_id);

    const segments = buildStatusSegments(e, idleByEntry[e.id], breakByEntry[e.id], startMs, endMs);
    const mySamples = samplesByEntry[e.id] || [];
    const myShots = shotsByEntry[e.id] || [];
    let actionsAttached = false;

    // buildStatusSegments returns segments oldest-first (needed for the
    // duration/activity math above and for the day timeline overlay), but
    // the table itself lists entries newest-first, so render each entry's
    // own segments newest-first too. Otherwise the live/current segment —
    // and the once-per-entry Actions menu, which attaches to the first
    // tracking segment encountered below — end up buried under older,
    // closed segments instead of on the top row, and which row that is
    // shifts every time the tab auto-refreshes and a new segment opens.
    const segmentsNewestFirst = segments.map((seg, i) => ({ seg, segIdx: i })).reverse();

    segmentsNewestFirst.forEach(({ seg, segIdx }) => {
      const meta = STATUS_META[seg.status];
      const durSec = (seg.end - seg.start) / 1000;
      const shotsInSeg = myShots.filter(t => { const ms = new Date(t).getTime(); return ms >= seg.start && ms < seg.end; }).length;

      let activityPct = null;
      let activityKb = null, activityMouse = null;
      if (seg.status === 'tracking') {
        const inSeg = mySamples.filter(s => { const ms = new Date(s.sampled_at).getTime(); return ms >= seg.start && ms < seg.end; });
        if (inSeg.length) {
          activityPct = Math.round(inSeg.reduce((a,s)=>a+(s.activity_pct||0),0) / inSeg.length);
          // v1.2.2: keyboard/mouse breakdown (only for samples that carry it —
          // rows from before v1.2.2 have null and are skipped in the average).
          const kbRows = inSeg.filter(s => s.keyboard_pct != null);
          const mRows = inSeg.filter(s => s.mouse_pct != null);
          if (kbRows.length) activityKb = Math.round(kbRows.reduce((a,s)=>a+s.keyboard_pct,0) / kbRows.length);
          if (mRows.length) activityMouse = Math.round(mRows.reduce((a,s)=>a+s.mouse_pct,0) / mRows.length);
        }
      }
      const activityTitle = (activityKb != null || activityMouse != null)
        ? ` title="keyboard ${activityKb != null ? activityKb : 0}% · mouse ${activityMouse != null ? activityMouse : 0}%"`
        : '';

      const timeLabel = `${timeFmt(seg.start)} \u2013 ${seg.status === 'tracking' && segIdx === segments.length - 1 && !e.end_time ? 'live' : timeFmt(seg.end)}`;
      // v144: 'manual' (whole entry created via "+ Add time") and
      // 'manually adjusted' (a real tracked entry whose Start/End/Idle/
      // Break was corrected via Actions -> Edit) are deliberately
      // separate tags, not the same one — a manual entry has no original
      // tracked session behind it at all, while an edited entry does and
      // was only corrected. Both only ever show on the tracking segment's
      // row, same as the Actions menu itself.
      const manualTag = seg.status === 'tracking' && e.is_manual ? ' <span class="task-row-count" style="margin-left:4px;">manual</span>' : '';
      const editedTag = seg.status === 'tracking' && !e.is_manual && e.is_edited ? ' <span class="task-row-count" style="margin-left:4px;">manually adjusted</span>' : '';
      // The agent's own "what were you doing?" note, entered when they
      // confirmed the "Still there?" resume prompt (now required on that
      // path — see extension/modules/idle.js). Segments from before that
      // change, or from the quick-return/system-auto-resume paths that
      // never show the prompt at all, simply have no note — render
      // nothing extra for those rather than an empty tag.
      const idleNoteTag = seg.status === 'idle' && seg.note
        ? ` <span class="task-row-count" style="margin-left:4px;" title="${escapeHtml(seg.note)}">${escapeHtml(seg.note.length > 40 ? seg.note.slice(0, 40) + '…' : seg.note)}</span>`
        : '';

      lastTimesheetRows.push({
        agent: agentName(e.user_id),
        task: taskLabel,
        status: meta.label,
        activity: activityPct !== null ? activityPct + '%' : '—',
        duration: fmtShort(durSec),
        time: timeLabel,
        shots: shotsInSeg,
      });

      const segKey = `${e.id}__${segIdx}`;

      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>
          <div class="task-cell">
            <div class="task-avatar" style="background:${colorFor(e.task_id, tsAllTasks)}">${initial}</div>
            <div class="task-cell-text">
              <div class="task-cell-name">${taskLabel}${manualTag}${editedTag}</div>
              <div class="task-cell-sub">${!filterSel.value ? agentName(e.user_id) : 'General'}</div>
            </div>
          </div>
        </td>
        <td><span class="dot ${meta.dot}"></span><span class="${meta.text}">${meta.label}</span>${idleNoteTag}</td>
        <td class="mono ${activityPct !== null ? 'pct-focus' : ''}"${activityTitle}>${activityPct !== null ? activityPct + '%' : '—'}</td>
        <td class="mono">${fmtShort(durSec)}</td>
        <td class="mono">${timeLabel}</td>
        <td><button class="shots-toggle" data-entry="${e.id}" data-seg="${segIdx}"><span class="caret">▸</span>${shotsInSeg}</button></td>
        <td>${
          seg.status === 'tracking' && !actionsAttached
            ? `<div class="ts-actions">
                 <button class="ts-actions-btn edit-only" data-id="${e.id}">Actions ▾</button>
                 <div class="ts-dropdown-menu">
                   <button class="ts-menu-edit">Edit</button>
                   ${!e.end_time ? '<button class="ts-menu-endnow">End now</button>' : ''}
                   <button class="ts-menu-danger danger">Delete</button>
                 </div>
               </div>`
            : ''
        }</td>
      `;

      if (seg.status === 'tracking' && !actionsAttached) {
        actionsAttached = true;
        const actionsBtn = tr.querySelector('.ts-actions-btn');
        const menu = tr.querySelector('.ts-dropdown-menu');
        actionsBtn.addEventListener('click', (ev) => {
          ev.stopPropagation();
          document.querySelectorAll('.ts-dropdown-menu.open').forEach(m => { if(m !== menu) m.classList.remove('open'); });
          menu.classList.toggle('open');
        });
        tr.querySelector('.ts-menu-edit').addEventListener('click', () => { menu.classList.remove('open'); openTsModal(e); });
        const endNowBtn = tr.querySelector('.ts-menu-endnow');
        if(endNowBtn) endNowBtn.addEventListener('click', () => {
          menu.classList.remove('open');
          if(!confirm(`End ${agentName(e.user_id)}'s live entry now? This stops tracking as of this moment.`)) return;
          endTimesheetEntryNow(e, `${agentName(e.user_id)} — ${taskLabel}`);
        });
        tr.querySelector('.ts-menu-danger').addEventListener('click', () => {
          menu.classList.remove('open');
          // CRITICAL FIX (audit finding, dashboard pass): this used to only
          // confirm when the entry was still live (!e.end_time) — a
          // completed entry deleted with zero confirmation, no undo. Now
          // always confirms, with wording that matches which case it is.
          const confirmMsg = e.end_time
            ? `Permanently delete this time entry for ${agentName(e.user_id)} — ${taskLabel}? This can't be undone.`
            : 'This entry is still live — the agent may be actively tracking against it. Delete anyway?';
          if(!confirm(confirmMsg)) return;
          deleteTimesheetEntry(e, `${agentName(e.user_id)} — ${taskLabel}`);
        });
      }

      // Every segment — tracking, idle, AND break — gets its own expand
      // row and its own shots-toggle, not just the segment the Actions
      // menu happens to be attached to. The extension takes real
      // screenshots during idle time by design (see
      // docs/SCREENSHOT-IDLE-PRIVACY-POLICY.md — idle/unfocused capture is
      // deliberate, since that's exactly the time admins most want
      // visibility into), so idle segments needed this. Break is included
      // too now for the same reason as idle: even though
      // captureScreenshot() is written to skip while on an explicit
      // break, a shot can still land inside a break segment's window in
      // practice — e.g. one that was mid-capture right as the break
      // started, a break started/edited after the fact so its boundary
      // moved across an existing screenshot's timestamp, or older data
      // from before that skip existed — and there's no reason to make
      // those unreachable just because they're the exception rather than
      // the rule; shotsInSeg (computed above from the real screenshots
      // table) already reflects whatever's actually there, so a break
      // segment with zero shots simply expands to "No screenshots for
      // this segment." same as any other empty one. An entry that goes
      // tracking → break → tracking (agent takes a break without clocking
      // out) produces two tracking segments on two separate rows;
      // previously only the newest one got a working "▸ N shots"
      // button/expand row, since both the button AND the expand row were
      // gated on the same once-per-entry actionsAttached flag. Each
      // segment's expand row is scoped to that segment's own start/end,
      // so it shows only that segment's screenshots and site visits
      // instead of the whole entry's combined total under whichever
      // button happened to be clickable.
      const expandTr = document.createElement('tr');
      expandTr.className = 'ts-expand-row';
      expandTr.style.display = 'none';
      expandTr.innerHTML = `
        <td colspan="7">
          <div class="expand-grid">
            <div>
              <h4>Screenshots</h4>
              <div class="shots-grid" id="ts-shots-${segKey}"></div>
            </div>
            <div>
              <h4>Sites visited</h4>
              <div id="ts-sites-${segKey}"></div>
            </div>
          </div>
        </td>
      `;
      tr.querySelector('.shots-toggle').addEventListener('click', () =>
        toggleTsExpand(segKey, tr.querySelector('.shots-toggle'), expandTr, e.id, seg.start, seg.end, e.user_id));

      body.appendChild(tr);
      body.appendChild(expandTr);
    });
  });
  applyTimeManagementSectionEditGating('timesheets');
}

async function toggleTsExpand(segKey, btn, expandTr, entryId, segStartMs, segEndMs, agentId){
  const isOpen = expandTr.style.display !== 'none';
  if(isOpen){
    expandTr.style.display = 'none';
    btn.classList.remove('expanded');
    return;
  }
  expandTr.style.display = 'table-row';
  btn.classList.add('expanded');
  if(tsShotsLoaded[segKey]) return; // already fetched this session
  tsShotsLoaded[segKey] = true;

  const shotsGrid = $(`ts-shots-${segKey}`);
  const sitesDiv = $(`ts-sites-${segKey}`);
  shotsGrid.innerHTML = '<div class="empty">Loading…</div>';
  sitesDiv.innerHTML = '<div class="empty">Loading…</div>';

  // Scoped to this segment's own start/end, not the whole entry — an
  // entry that goes tracking → break → tracking has two tracking segments
  // sharing one time_entry_id, and each segment's row should only show
  // the screenshots actually taken during that segment's window.
  const segStartIso = new Date(segStartMs).toISOString();
  const segEndIso = new Date(segEndMs).toISOString();

  const { data: shots } = await sb.from('screenshots')
    .select('id, storage_path, taken_at, activity_pct_at_capture')
    .eq('time_entry_id', entryId)
    .gte('taken_at', segStartIso)
    .lt('taken_at', segEndIso)
    .order('taken_at', { ascending: true });

  shotsGrid.innerHTML = '';
  if(!shots || shots.length === 0){
    shotsGrid.innerHTML = '<div class="empty">No screenshots for this segment.</div>';
  } else {
    const resolvedShots = [];
    for(const shot of shots){
      const { data: signed } = await sb.storage.from('screenshots').createSignedUrl(shot.storage_path, 3600);
      resolvedShots.push({
        url: signed ? signed.signedUrl : '',
        taken_at: shot.taken_at,
        activity_pct_at_capture: shot.activity_pct_at_capture,
      });
    }
    resolvedShots.forEach((shot, idx) => {
      const div = document.createElement('div');
      div.className = 'shot-card';
      div.innerHTML = `
        <img src="${shot.url}" loading="lazy">
        <div class="shot-meta">${tsFmtTime(shot.taken_at, agentId)} · ${shot.activity_pct_at_capture ?? '—'}%</div>
      `;
      div.addEventListener('click', () => openLightbox(resolvedShots, idx));
      shotsGrid.appendChild(div);
    });
  }

  // Same segment-scoping for site visits: fetch everything tagged to the
  // entry, then keep only visits that overlap this segment's window
  // (client-side, since an ongoing visit has no end_time to filter on in
  // the query itself).
  const { data: visits } = await sb.from('url_visits')
    .select('domain, start_time, end_time')
    .eq('time_entry_id', entryId)
    .lt('start_time', segEndIso);

  const totals = {};
  (visits||[]).forEach(v => {
    const vStart = new Date(v.start_time).getTime();
    const vEnd = v.end_time ? new Date(v.end_time).getTime() : Date.now();
    const overlapStart = Math.max(vStart, segStartMs);
    const overlapEnd = Math.min(vEnd, segEndMs);
    if (overlapEnd <= overlapStart) return; // no actual overlap with this segment
    const dur = (overlapEnd - overlapStart) / 1000;
    const key = v.domain || '(unknown)';
    totals[key] = (totals[key]||0) + dur;
  });
  const rows = Object.entries(totals).sort((a,b) => b[1]-a[1]).slice(0, 10);
  sitesDiv.innerHTML = '';
  if(rows.length === 0){
    sitesDiv.innerHTML = '<div class="empty">No site activity logged for this segment.</div>';
    return;
  }
  const maxSec = rows[0][1];
  rows.forEach(([domain, sec]) => {
    const row = document.createElement('div');
    row.className = 'site-row';
    row.innerHTML = `
      <div class="site-domain" title="${escapeHtml(domain)}">${escapeHtml(domain)}</div>
      <div class="site-bar-track"><div class="site-bar-fill" style="width:${Math.max(2, sec/maxSec*100)}%"></div></div>
      <div class="site-time">${fmtShort(sec)}</div>
    `;
    sitesDiv.appendChild(row);
  });
}

$('tsRefreshBtn').addEventListener('click', async () => {
  const btn = $('tsRefreshBtn');
  if(btn.disabled) return; // already refreshing — ignore repeat clicks
  btn.disabled = true;
  const original = btn.innerHTML;
  btn.innerHTML = '&#8635; Refreshing…';
  try{
    await loadTimesheets();
  }finally{
    btn.disabled = false;
    btn.innerHTML = original;
  }
});
$('tsExportCsvBtn').addEventListener('click', () => {
  const headers = ['User','Project/Task','Status','Activity','Duration','Time','Screenshots'];
  const rows = lastTimesheetRows.map(r => [r.agent, r.task, r.status, r.activity, r.duration, r.time, r.shots]);
  exportCSV(`timesheets-${new Date().toISOString().slice(0,10)}.csv`, headers, rows);
  logActivity('export.timesheets_csv', null, null, `Exported timesheet CSV (${rows.length} rows)`);
});
$('tsExportPdfBtn').addEventListener('click', () => {
  const headers = ['User','Project/Task','Status','Activity','Duration','Time','Shots'];
  const rows = lastTimesheetRows.map(r => [r.agent, r.task, r.status, r.activity, r.duration, r.time, r.shots]);
  exportPDF('Timesheet Report', headers, rows);
  logActivity('export.timesheets_pdf', null, null, `Exported timesheet PDF (${rows.length} rows)`);
});

// ---------- reports tab ----------
// Column definitions available to every report — the 3 default reports
// below are just named presets over a subset of these; Custom Report lets
// the admin pick any combination and (optionally) save that combination
// as a named, reusable template.
const REPORT_COLUMNS = {
  productive: { label: 'Productive (hrs)', get: s => (s.productiveSec / 3600).toFixed(2) },
  break:      { label: 'Break (hrs, paid)', get: s => (s.breakSec / 3600).toFixed(2) },
  idle:       { label: 'Idle (hrs, unpaid)', get: s => (s.idleSec / 3600).toFixed(2) },
  payable:    { label: 'Payable (hrs)', get: s => (s.payableSec / 3600).toFixed(2) },
  rate:       { label: () => `Rate (${curUnit()}/hr)`, get: s => s.hourlyRate != null ? (toUSD(Number(s.hourlyRate), s.hourlyRateCurrency) * fxMultiplier()).toFixed(2) : '—' },
  basicPay:   { label: () => `Basic pay (${curUnit()})`, get: s => s.basicPay != null ? (s.basicPay * fxMultiplier()).toFixed(2) : '—' },
  leads:      { label: 'Accepted leads', get: s => String(s.leadsCount) },
  leadsTarget:{ label: 'Lead target', get: s => s.leadsTarget != null ? String(s.leadsTarget) : '—' },
  leadBonus:  { label: () => `Lead bonus (${curUnit()})`, get: s => s.leadBonus != null ? (Number(s.leadBonus) * fxMultiplier()).toFixed(2) : '0.00' },
  extraBonus: { label: () => `Extra target bonus (${curUnit()})`, get: s => s.extraBonus != null ? (Number(s.extraBonus) * fxMultiplier()).toFixed(2) : '0.00' },
  pay:        { label: () => `Total pay (${curUnit()})`, get: s => s.pay != null ? (Number(s.pay) * fxMultiplier()).toFixed(2) : (s.basicPay != null ? (s.basicPay * fxMultiplier()).toFixed(2) : '—') },
  activity:   { label: 'Avg activity %', get: s => s.avgActivity != null ? s.avgActivity + '%' : '—' },
  days:       { label: 'Days worked', get: s => String(s.daysWorked) },
  avgPerDay:  { label: 'Avg hrs/day', get: s => s.daysWorked ? (s.productiveSec / 3600 / s.daysWorked).toFixed(2) : '0.00' },
  login:      { label: 'First login', get: s => s.firstLogin ? reportFmtDT(s.firstLogin, s.agentTz) : '—' },
  logout:     { label: 'Last logout', get: s => s.lastLogout ? reportFmtDT(s.lastLogout, s.agentTz) : (s.stillLive ? 'live' : '—') },
};
const DEFAULT_REPORTS = {
  payroll:      { title: 'Monthly Payroll Summary', columns: ['payable','rate','basicPay','leads','leadsTarget','leadBonus','extraBonus','pay'] },
  productivity: { title: 'User Productivity Report', columns: ['productive','idle','break','activity','days','avgPerDay'] },
  login:        { title: 'Login / Logout Tracker', columns: ['login','logout','productive','activity'], perDay: true },
};
// Columns checked by default when building a fresh Custom Report
const CUSTOM_DEFAULT_COLUMNS = ['productive','idle','break','payable'];

function reportFmtDT(ms, tz){
  return new Date(ms).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(tz ? { timeZone: tz } : {}) });
}

// Converts an admin-entered amount into USD using the dashboard's
// daily-refreshed USD->EGP rate, so every downstream $ calculation
// (basic pay, bonuses, totals) can stay in one consistent unit regardless
// of which currency each rate was originally typed in. Reports then
// convert that USD figure to whichever currency is currently selected in
// the Reports tab via fxMultiplier().
function toUSD(amount, currency){
  if(amount == null) return null;
  return currency === 'EGP' ? amount / (usdToEgpRate || 1) : amount;
}

// Sales pay = basic (hourly rate × payable hours) + a lead bonus that only
// kicks in once accepted leads reach the agent's target_leads, plus an
// optional "extra target" stretch bonus for beating that target by a
// margin. Payout shapes, admin's choice per agent on the Schedule card:
//  - lead bonus 'per_lead': bonus rate × every accepted lead (not just the
//    ones over target — hitting target unlocks the rate for the whole
//    period); 'bulk': one flat bonus, paid once, for reaching the target.
//  - extra target: a list of { extra_leads, bonus, currency } tiers. Once
//    accepted leads exceed target_leads by at least a tier's extra_leads,
//    that tier's bonus is payable; only the highest qualifying tier is
//    paid (tiers don't stack). No tiers set = this part is always 0.
// No target set = lead/extra bonuses are always 0, so an hourly/
// operations agent's pay is exactly the basic hourly figure, unchanged
// from before this feature.
function computeSalesPay(agent, stats){
  // v498: alternate pay model -- a flat monthly salary keyed off which
  // qualified-leads tier the agent hit for the period, instead of
  // hourly-rate + bonus stacking below. Reuses `basicPay` as the carrier
  // for the tiered amount (rather than adding a new field every
  // downstream consumer would need updating for) since leadBonus/
  // extraBonus are both forced to 0 here -- `pay` (and everywhere that
  // sums basicPay+leadBonus+extraBonus) comes out to exactly the tier
  // amount with no other changes needed.
  if(agent.payModel === 'lead_tier_salary'){
    const tiers = Array.isArray(agent.salaryTiers) ? agent.salaryTiers : [];
    const qualifying = tiers
      .filter(t => stats.leadsCount >= Number(t.min_leads || 0))
      .sort((a, b) => Number(b.min_leads || 0) - Number(a.min_leads || 0));
    const basicPay = qualifying.length ? (toUSD(Number(qualifying[0].amount || 0), qualifying[0].currency) || 0) : null;
    return { basicPay, leadBonus: 0, extraBonus: 0, pay: basicPay };
  }

  const hourlyRateUSD = toUSD(agent.hourlyRate, agent.hourlyRateCurrency);
  const basicPay = hourlyRateUSD != null ? (stats.payableSec / 3600) * hourlyRateUSD : null;

  let leadBonus = 0;
  if(agent.targetLeads && stats.leadsCount >= agent.targetLeads){
    const leadBonusRateUSD = toUSD(agent.leadBonusRate, agent.leadBonusCurrency) || 0;
    leadBonus = agent.leadBonusType === 'bulk'
      ? leadBonusRateUSD
      : stats.leadsCount * leadBonusRateUSD;
  }

  let extraBonus = 0;
  if(agent.targetLeads && Array.isArray(agent.extraTiers) && agent.extraTiers.length){
    const extraLeads = stats.leadsCount - agent.targetLeads;
    if(extraLeads > 0){
      const qualifying = agent.extraTiers
        .filter(t => extraLeads >= Number(t.extra_leads || 0))
        .sort((a, b) => Number(b.extra_leads || 0) - Number(a.extra_leads || 0));
      if(qualifying.length){
        extraBonus = toUSD(Number(qualifying[0].bonus || 0), qualifying[0].currency) || 0;
      }
    }
  }

  const pay = (basicPay != null || leadBonus || extraBonus) ? (basicPay || 0) + leadBonus + extraBonus : null;
  return { basicPay, leadBonus, extraBonus, pay };
}

let reportState = { type: 'payroll' };
let reportAgents = [];
let reportTemplates = [];
let lastReportRows = [];
let reportsInitialized = false;

// ---------- currency (USD / EGP) for payroll figures ----------
// hourly_rate is always stored in the DB as USD (the source of truth for
// payroll math); this section only controls how it's *displayed*. The
// USD->EGP exchange rate is fetched once per calendar day and cached in
// localStorage so switching the dropdown or reopening the tab doesn't
// re-hit the FX API every time — only the first load of a new day does.
let reportCurrency = 'USD';
let usdToEgpRate = null;
const FX_CACHE_KEY = 'ptai_fx_usd_egp';

function curUnit(){ return reportCurrency === 'EGP' ? 'EGP' : '$'; }
function fxMultiplier(){ return reportCurrency === 'EGP' ? (usdToEgpRate || 1) : 1; }
// REPORT_COLUMNS.label is a plain string for most columns but a function
// for the money columns above (their unit changes with reportCurrency) —
// this normalizes access to a string wherever a label is displayed.
function colLabel(key){
  const def = REPORT_COLUMNS[key];
  return typeof def.label === 'function' ? def.label() : def.label;
}

function setFxNote(text){
  const note = $('fxRateNote');
  if(note) note.textContent = text;
}

async function ensureFxRate(){
  const today = new Date().toISOString().slice(0, 10);
  try {
    const cached = JSON.parse(localStorage.getItem(FX_CACHE_KEY) || 'null');
    if(cached && cached.date === today && cached.rate){
      usdToEgpRate = cached.rate;
      setFxNote(`1 USD ≈ ${cached.rate.toFixed(2)} EGP · rate as of ${cached.date}`);
      return;
    }
  } catch(e) {}
  await refreshFxRate();
}

// Free, no-API-key exchange rate feed; rates on this endpoint refresh
// daily, matching the once-a-day cache above.
async function refreshFxRate(){
  setFxNote('Fetching today\u2019s USD → EGP rate…');
  try {
    const res = await fetch('https://open.er-api.com/v6/latest/USD');
    const data = await res.json();
    const rate = data && data.rates && data.rates.EGP;
    if(!rate) throw new Error('EGP rate missing from response');
    // LOW FIX (audit_chunk3.md #9): no sanity check on the returned rate
    // before feeding it straight into every EGP payroll figure in the
    // Reports tab -- a malformed/wrong-currency response (or a future API
    // change) could silently produce wildly wrong pay figures with no
    // warning beyond the easy-to-miss fxRateNote text. Bounds are wide
    // (well outside any real-world USD/EGP range) specifically so this
    // only catches something clearly broken, not ordinary rate movement.
    if(!Number.isFinite(rate) || rate <= 5 || rate >= 300) throw new Error(`Implausible USD->EGP rate from API: ${rate}`);
    const today = new Date().toISOString().slice(0, 10);
    usdToEgpRate = rate;
    localStorage.setItem(FX_CACHE_KEY, JSON.stringify({ rate, date: today }));
    setFxNote(`1 USD ≈ ${rate.toFixed(2)} EGP · updated ${today}`);
  } catch(err){
    // Fall back to the last cached rate (even if stale) rather than
    // silently showing $0 EGP figures; only fall back to 1:1 if nothing
    // has ever been cached.
    let cached = null;
    try { cached = JSON.parse(localStorage.getItem(FX_CACHE_KEY) || 'null'); } catch(e) {}
    if(cached && cached.rate){
      usdToEgpRate = cached.rate;
      setFxNote(`1 USD ≈ ${cached.rate.toFixed(2)} EGP · couldn't refresh, showing rate cached ${cached.date}`);
    } else {
      usdToEgpRate = 1;
      setFxNote('Couldn\u2019t fetch today\u2019s EGP rate — showing 1:1 for now.');
    }
  }
}

function renderReportColumnPicker(){
  const colPicker = $('reportColumnsPicker');
  if(!colPicker) return;
  colPicker.innerHTML = Object.keys(REPORT_COLUMNS).map(key => `
    <label style="display:flex; align-items:center; gap:6px; cursor:pointer; text-transform:none; font-family:var(--sans); font-size:12px; color:var(--text); letter-spacing:0;">
      <input type="checkbox" class="report-col-cb" value="${key}" ${CUSTOM_DEFAULT_COLUMNS.includes(key) ? 'checked' : ''} style="width:14px; height:14px; accent-color:var(--focus);"> ${colLabel(key)}
    </label>
  `).join('');
  // v1.2.5: custom report's currency filter appears only if a money column
  // is picked — re-evaluate whenever the selection changes.
  colPicker.querySelectorAll('.report-col-cb').forEach(cb => {
    cb.addEventListener('change', () => { if(reportState.type === 'custom') applyReportCurrencyVisibility('custom'); });
  });
}

async function initReportsTab(){
  $('reportCurrencySelect').value = reportCurrency;
  if(!$('reportMonthInput').value){
    const now = new Date();
    $('reportMonthInput').value = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`;
  }

  const { data: agents } = await sb.from('profiles').select('id, full_name, email, role').order('full_name');
  const { data: scheduleRows } = await sb.from('schedules').select('user_id, hourly_rate, hourly_rate_currency, timezone, target_leads, lead_bonus_type, lead_bonus_rate, lead_bonus_currency, extra_target_tiers, pay_model, salary_tiers');
  const rateMap = {}, rateCurMap = {}, tzMap = {}, targetMap = {}, bonusTypeMap = {}, bonusRateMap = {}, bonusCurMap = {}, tiersMap = {}, payModelMap = {}, salaryTiersMap = {};
  (scheduleRows || []).forEach(s => {
    rateMap[s.user_id] = s.hourly_rate;
    rateCurMap[s.user_id] = s.hourly_rate_currency;
    tzMap[s.user_id] = s.timezone;
    targetMap[s.user_id] = s.target_leads;
    bonusTypeMap[s.user_id] = s.lead_bonus_type;
    bonusRateMap[s.user_id] = s.lead_bonus_rate;
    bonusCurMap[s.user_id] = s.lead_bonus_currency;
    tiersMap[s.user_id] = Array.isArray(s.extra_target_tiers) ? s.extra_target_tiers : [];
    payModelMap[s.user_id] = s.pay_model;
    salaryTiersMap[s.user_id] = Array.isArray(s.salary_tiers) ? s.salary_tiers : [];
  });
  reportAgents = (agents || []).filter(a => !PROTECTED_ROLES.has(a.role)).map(a => ({
    id: a.id,
    name: a.full_name || a.email,
    hourlyRate: rateMap[a.id] != null ? Number(rateMap[a.id]) : null,
    hourlyRateCurrency: rateCurMap[a.id] || 'USD',
    tz: tzMap[a.id] || null,
    targetLeads: targetMap[a.id] != null ? Number(targetMap[a.id]) : null,
    leadBonusType: bonusTypeMap[a.id] || 'per_lead',
    leadBonusRate: bonusRateMap[a.id] != null ? Number(bonusRateMap[a.id]) : null,
    leadBonusCurrency: bonusCurMap[a.id] || 'USD',
    extraTiers: tiersMap[a.id] || [],
    payModel: payModelMap[a.id] || 'hourly_bonus',
    salaryTiers: salaryTiersMap[a.id] || [],
  }));

  const picker = $('reportAgentPicker');
  picker.innerHTML = reportAgents.length ? reportAgents.map(a => `
    <label style="display:flex; align-items:center; gap:6px; cursor:pointer; text-transform:none; font-family:var(--sans); font-size:12px; color:var(--text); letter-spacing:0; margin-bottom:6px;">
      <input type="checkbox" class="report-agent-cb" value="${a.id}" checked style="width:14px; height:14px; accent-color:var(--focus);"> ${escapeHtml(a.name)}
    </label>
  `).join('') : '<div class="empty">No users yet.</div>';

  renderReportColumnPicker();

  await ensureFxRate();

  await loadReportTemplates();

  if(!reportsInitialized){
    reportsInitialized = true;
    document.querySelectorAll('.report-type-btn').forEach(btn => {
      btn.addEventListener('click', () => setReportType(btn.dataset.report));
    });
    $('reportGenerateBtn').addEventListener('click', generateReport);
    $('reportSaveTemplateBtn').addEventListener('click', saveReportTemplate);
    $('reportTemplateSelect').addEventListener('change', applyReportTemplate);
    $('reportDeleteTemplateBtn').addEventListener('click', deleteReportTemplate);
    $('reportExportCsvBtn').addEventListener('click', () => {
      const headers = Array.from($('reportTableHead').children).map(th => th.textContent);
      exportCSV(`report-${reportState.type}-${reportState.lastMonthVal || $('reportMonthInput').value}-${reportCurrency}.csv`, headers, lastReportRows);
      logActivity('export.report_csv', null, null, `Exported ${reportState.type} report CSV`);
    });
    $('reportExportPdfBtn').addEventListener('click', () => {
      const headers = Array.from($('reportTableHead').children).map(th => th.textContent);
      exportPDF($('reportResultsTitle').textContent, headers, lastReportRows);
      logActivity('export.report_pdf', null, null, `Exported ${reportState.type} report PDF`);
    });
    $('reportCurrencySelect').addEventListener('change', () => {
      reportCurrency = $('reportCurrencySelect').value;
      renderReportColumnPicker();
      // Re-render from the already-fetched rows rather than re-querying
      // Supabase — switching currency is purely a display conversion.
      if(reportState.lastRows){
        renderReportTable(reportState.lastTitle, reportState.lastColumns, reportState.lastRows, reportState.lastPerDay, reportState.lastMonthVal);
      }
      logActivity('report.currency_change', null, null, `Switched report currency to ${reportCurrency}`);
    });
    setReportType('payroll');
  }
}

function setReportType(type){
  reportState.type = type;
  document.querySelectorAll('.report-type-btn').forEach(b => b.classList.toggle('active', b.dataset.report === type));
  $('reportCustomColumns').style.display = type === 'custom' ? 'block' : 'none';
  $('reportResultsCard').style.display = 'none';
  // v1.2.5: the Monthly/Daily period selector now applies to EVERY report
  // type, not just payroll — each report can be run for a whole month or a
  // single day, reusing the same tested date paths.
  $('payrollPeriodModeWrap').style.display = 'block';
  syncPayrollPeriodInputs($('payrollPeriodModeSelect').value);
  // v1.2.5: currency filter only shows for reports that actually have a
  // money/currency column (see reportHasCurrency).
  applyReportCurrencyVisibility(type);
}

// Which report types produce money columns (and therefore need the currency
// switch). Custom reports depend on the chosen columns, handled separately.
function reportHasCurrency(type){
  if(type === 'payroll') return true;
  if(type === 'custom') return customReportHasMoneyColumn();
  return false; // productivity, login — no money columns
}
function customReportHasMoneyColumn(){
  const moneyCols = new Set(['pay','earnings','hourly_rate','bonus','total_pay','gross_pay','amount']);
  const chosen = Array.from(document.querySelectorAll('.report-col-cb:checked')).map(cb => cb.value.toLowerCase());
  return chosen.some(c => moneyCols.has(c) || c.includes('pay') || c.includes('rate') || c.includes('bonus') || c.includes('earn'));
}
function applyReportCurrencyVisibility(type){
  const wrap = document.getElementById('reportCurrencyWrap');
  if(wrap) wrap.style.display = reportHasCurrency(type) ? 'block' : 'none';
}

function syncPayrollPeriodInputs(mode){
  $('reportMonthWrap').style.display = mode === 'daily' ? 'none' : 'block';
  $('reportDayWrap').style.display = mode === 'daily' ? 'block' : 'none';
  if(mode === 'daily' && !$('reportDayInput').value){
    $('reportDayInput').value = todayDateInputValue();
  }
}
$('payrollPeriodModeSelect').addEventListener('change', () => syncPayrollPeriodInputs($('payrollPeriodModeSelect').value));

async function loadReportTemplates(){
  const { data } = await sb.from('report_templates').select('id, name, columns').order('name');
  reportTemplates = data || [];
  const sel = $('reportTemplateSelect');
  const prev = sel.value;
  sel.innerHTML = '<option value="">Load saved template…</option>' +
    reportTemplates.map(t => `<option value="${t.id}">${escapeHtml(t.name)}</option>`).join('');
  sel.value = reportTemplates.some(t => t.id === prev) ? prev : '';
  $('reportDeleteTemplateBtn').style.display = sel.value ? 'inline-block' : 'none';
}

async function saveReportTemplate(){
  const btn = $('reportSaveTemplateBtn');
  if(btn.disabled) return; // guards against a fast double-click saving two identically-named templates
  const name = $('reportTemplateName').value.trim();
  if(!name){ alert('Give the template a name first.'); return; }
  const columns = Array.from(document.querySelectorAll('.report-col-cb:checked')).map(cb => cb.value);
  if(!columns.length){ alert('Pick at least one column first.'); return; }
  btn.disabled = true;
  try{
    const { data: { user } } = await sb.auth.getUser();
    const { error } = await sb.from('report_templates').insert({ name, columns, created_by: user ? user.id : null });
    if(error){ alert(error.message); return; }
    $('reportTemplateName').value = '';
    await loadReportTemplates();
    logActivity('report_template.create', null, null, `Saved report template "${name}" (${columns.length} columns)`);
  }finally{
    btn.disabled = false;
  }
}

function applyReportTemplate(){
  const id = $('reportTemplateSelect').value;
  $('reportDeleteTemplateBtn').style.display = id ? 'inline-block' : 'none';
  if(!id) return;
  const tmpl = reportTemplates.find(t => t.id === id);
  if(!tmpl) return;
  document.querySelectorAll('.report-col-cb').forEach(cb => { cb.checked = tmpl.columns.includes(cb.value); });
}

async function deleteReportTemplate(){
  const id = $('reportTemplateSelect').value;
  const tmpl = reportTemplates.find(t => t.id === id);
  if(!id || !confirm(`Delete template "${tmpl ? tmpl.name : ''}"?`)) return;
  await sb.from('report_templates').delete().eq('id', id);
  await loadReportTemplates();
  logActivity('report_template.delete', null, null, `Deleted report template "${tmpl ? tmpl.name : id}"`);
}

// Computes every metric for one agent over [rangeStartMs, rangeEndMs].
// Reuses the same entry-bounded, overlap-merged idle/break calculation
// that the Timesheets day view uses, so a payroll total and the daily
// timeline can never disagree about what counts as idle vs. break vs.
// productive. Break time counts toward "payable" (it's paid time off,
// not absence); idle time does not.
async function computeAgentStats(agentId, rangeStartMs, rangeEndMs){
  const startISO = new Date(rangeStartMs).toISOString();
  const endISO = new Date(rangeEndMs).toISOString();

  // audit fix (Time Management deep-scan pass): paginated for consistency
  // — single-agent-scoped so lower risk than the team-wide queries, but a
  // wide report range (e.g. a full year of daily payroll rows) shouldn't
  // silently lose sessions either; see fetchAllRows()'s own comment.
  const entries = await fetchAllRows((from, to) => sb.from('time_entries')
    .select('id, start_time, end_time, is_manual, idle_seconds, break_seconds, last_heartbeat_at')
    .eq('user_id', agentId)
    .lte('start_time', endISO)
    .or(`end_time.is.null,end_time.gte.${startISO}`)
    .order('id', { ascending: true }).range(from, to));

  let grossSec = 0, firstLogin = null, lastLogout = null, stillLive = false;
  const daySet = new Set();
  entries.forEach(e => {
    const rawStart = new Date(e.start_time).getTime();
    // v218: was `e.end_time ? ... : Date.now()` — see liveEntryEndMs()'s
    // own comment. This feeds productiveSec straight into the Reports
    // tab's payroll-facing totals/CSV export, so a stale open entry
    // (agent signed out / crashed / lost network with no Stop click)
    // silently inflating "productive" hours here was the highest-stakes
    // version of this bug.
    const rawEnd = liveEntryEndMs(e);
    const sec = clipSeconds(rawStart, rawEnd, rangeStartMs, rangeEndMs);
    if(sec <= 0) return;
    grossSec += sec;
    const clippedStart = Math.max(rawStart, rangeStartMs);
    const clippedEnd = Math.min(rawEnd, rangeEndMs);
    if(firstLogin === null || clippedStart < firstLogin) firstLogin = clippedStart;
    if(lastLogout === null || clippedEnd > lastLogout) lastLogout = clippedEnd;
    if(!e.end_time && !liveEntryIsStale(e)) stillLive = true;
    let cur = new Date(clippedStart); cur.setHours(0,0,0,0);
    const endMarker = new Date(clippedEnd);
    while(cur.getTime() <= endMarker.getTime()){
      daySet.add(cur.toDateString());
      cur.setDate(cur.getDate() + 1);
    }
  });

  const entryIds = entries.map(e => e.id);
  const entryBounds = {};
  entries.forEach(e => {
    entryBounds[e.id] = { start: new Date(e.start_time).getTime(), end: liveEntryEndMs(e) };
  });

  let idleSec = 0, breakSec = 0;
  if(entryIds.length){
    const [idleRows, breakRows] = await Promise.all([
      fetchAllRows((from, to) => sb.from('idle_periods').select('time_entry_id, start_time, end_time').in('time_entry_id', entryIds).order('id', { ascending: true }).range(from, to)),
      fetchAllRows((from, to) => sb.from('breaks').select('time_entry_id, start_time, end_time').in('time_entry_id', entryIds).order('id', { ascending: true }).range(from, to)),
    ]);
    idleSec = mergedCoverageSec(idleRows, rangeStartMs, rangeEndMs, entryBounds);
    breakSec = mergedCoverageSec(breakRows, rangeStartMs, rangeEndMs, entryBounds);
  }
  // manual entries never have their own idle_periods/breaks rows — their
  // idle/break minutes only exist as the numbers typed into the "+ Add
  // time" modal, same reasoning as the Timesheets day-breakdown fix.
  entries.forEach(e => {
    if(e.is_manual){
      idleSec += e.idle_seconds || 0;
      breakSec += e.break_seconds || 0;
    }
  });

  const productiveSec = Math.max(0, grossSec - idleSec - breakSec);
  const payableSec = productiveSec + breakSec; // break is paid; idle is not

  // audit fix (Time Management deep-scan pass): this fed the Payroll/
  // Productivity report's headline "average activity %" from a single
  // unbounded fetch — a full-time agent logs ~1 sample/minute while
  // active, so a full month is easily 10,000+ rows, silently capped at
  // PostgREST's default 1000-row limit with the resulting average
  // presented as if it covered the whole period. See fetchAllRows()'s own
  // comment for the full reasoning.
  const sampleRows = await fetchAllRows((from, to) => sb.from('activity_samples')
    .select('activity_pct')
    .eq('user_id', agentId)
    .gte('sampled_at', startISO).lte('sampled_at', endISO)
    .order('id', { ascending: true }).range(from, to));
  const avgActivity = sampleRows && sampleRows.length
    ? Math.round(sampleRows.reduce((a,s) => a + (s.activity_pct || 0), 0) / sampleRows.length)
    : null;

  // Leads that count toward reports and the sales bonus formula. Pending
  // submissions are still excluded until a human verifies them on the Leads
  // tab. See leads.status in schema.sql.
  //
  // v (user request, 2026-09-11): this figure and Activity -> Staff Activity's
  // Accepted column were computed by two different rules, which is how the
  // same agent could read 3 here and 10 there. Both now go through the shared
  // leadCountsAsAccepted() / leadPropertyKey() helpers. Two deliberate changes
  // to what gets PAID, chosen explicitly:
  //   1. A rejection categorised "Duplicate address/phone number" now COUNTS
  //      (see leadCountsAsAccepted). This is material: it takes one agent's
  //      September figure from 3 to 10. No pay actually moves today only
  //      because that agent's salary tiers start at 40 leads.
  //   2. Credit is deduped per PROPERTY, so one property resubmitted and
  //      accepted twice is paid once. Measured over all history: exactly one
  //      such group exists, and it belongs to someone with no lead-based comp,
  //      so no past payroll figure moves because of this half.
  //
  // Both statuses are fetched and the decision made HERE rather than in a
  // server-side .or() filter: RLS makes such a filter impossible to verify
  // properly from outside this app, and one that silently excluded rows would
  // quietly underpay somebody. Paged through fetchAllRows() because this now
  // pulls rejected rows too -- a busy agent's month can approach PostgREST's
  // 1000-row cap, which would truncate a payroll number in silence.
  const leadRows = await fetchAllRows((from, to) => sb.from('leads')
    .select(CREDITED_LEAD_COLS)
    .eq('user_id', agentId)
    .in('status', CREDITED_LEAD_STATUSES)
    .gte('submitted_at', startISO).lte('submitted_at', endISO)
    .order('id', { ascending: true }).range(from, to));
  const leadsCount = creditedLeadCount(leadRows);

  return {
    grossSec, idleSec, breakSec, productiveSec, payableSec,
    avgActivity, leadsCount, daysWorked: daySet.size,
    firstLogin, lastLogout, stillLive,
  };
}

async function generateReport(){
  const isPayroll = reportState.type === 'payroll';
  // v1.2.5: period mode (monthly/daily) now applies to every report type.
  const isDaily = $('payrollPeriodModeSelect').value === 'daily';
  const payrollDaily = isDaily; // kept name for the downstream code below

  let monthVal = null, y, m, singleDayVal = null, dy, dm, dd;
  if(payrollDaily){
    singleDayVal = $('reportDayInput').value;
    if(!singleDayVal) return;
    [dy, dm, dd] = singleDayVal.split('-').map(Number);
  } else {
    monthVal = $('reportMonthInput').value;
    if(!monthVal) return;
    [y, m] = monthVal.split('-').map(Number);
  }

  const selectedIds = Array.from(document.querySelectorAll('.report-agent-cb:checked')).map(cb => cb.value);
  const agentsToRun = reportAgents.filter(a => selectedIds.includes(a.id));
  if(agentsToRun.length === 0){ alert('Select at least one user.'); return; }

  let columns, title, perDay = false;
  if(reportState.type === 'payroll'){
    columns = DEFAULT_REPORTS.payroll.columns;
    title = payrollDaily ? 'Daily Payroll Summary' : DEFAULT_REPORTS.payroll.title;
  }
  else if(reportState.type === 'productivity'){ columns = DEFAULT_REPORTS.productivity.columns; title = DEFAULT_REPORTS.productivity.title; }
  else if(reportState.type === 'login'){ columns = DEFAULT_REPORTS.login.columns; title = DEFAULT_REPORTS.login.title; perDay = true; }
  else {
    columns = Array.from(document.querySelectorAll('.report-col-cb:checked')).map(cb => cb.value);
    title = 'Custom Report';
    if(!columns.length){ alert('Pick at least one column.'); return; }
  }
  // v1.2.5: in daily (single-day) mode, a normally per-day report (login)
  // collapses to just that one day rather than iterating the whole month.
  if(payrollDaily) perDay = false;

  const btn = $('reportGenerateBtn');
  btn.disabled = true;
  const origLabel = btn.textContent;
  btn.textContent = 'Generating…';

  try {
    const rows = [];
    if(perDay){
      // Every day of the month gets its own row, per agent — each day's
      // boundary is computed in THAT AGENT's own schedule timezone, not
      // the admin browser's, so an overnight shift lands on the calendar
      // day the agent would actually recognize, not a day split by
      // whatever timezone the admin happens to be viewing the dashboard
      // from.
      const { daysInMonth } = monthBoundsMsInZone(y, m, null); // day-count itself isn't timezone-sensitive
      for(const agent of agentsToRun){
        for(let d = 1; d <= daysInMonth; d++){
          const { startMs: dayStartMs, endMs: dayEndRaw } = dayBoundsMsInZone(agent.tz, null, y, m, d);
          if(dayStartMs > Date.now()) break; // don't compute into the future
          const dayEndMs = Math.min(dayEndRaw, Date.now());
          const stats = await computeAgentStats(agent.id, dayStartMs, dayEndMs);
          if(stats.grossSec <= 0) continue; // skip days with no activity at all
          stats.hourlyRate = agent.hourlyRate;
          stats.hourlyRateCurrency = agent.hourlyRateCurrency;
          stats.agentTz = agent.tz;
          rows.push({
            agent,
            dateLabel: new Date(dayStartMs).toLocaleDateString([], { month:'short', day:'numeric', year:'numeric', ...(agent.tz ? { timeZone: agent.tz } : {}) }),
            stats,
          });
        }
      }
    } else {
      // One row per agent — either the whole month (payroll-monthly,
      // productivity, custom) or one specific day (payroll-daily), with
      // the boundary computed in each agent's own schedule timezone.
      for(const agent of agentsToRun){
        const { startMs: rangeStartMs, endMs: rangeEndRaw } = payrollDaily
          ? dayBoundsMsInZone(agent.tz, null, dy, dm, dd)
          : monthBoundsMsInZone(y, m, agent.tz);
        const rangeEndMs = Math.min(rangeEndRaw, Date.now());
        const stats = await computeAgentStats(agent.id, rangeStartMs, rangeEndMs);
        stats.hourlyRate = agent.hourlyRate;
        stats.hourlyRateCurrency = agent.hourlyRateCurrency;
        stats.agentTz = agent.tz;
        stats.leadsTarget = agent.targetLeads;
        const payCalc = computeSalesPay(agent, stats);
        stats.basicPay = payCalc.basicPay;
        stats.leadBonus = payCalc.leadBonus;
        stats.extraBonus = payCalc.extraBonus;
        stats.pay = payCalc.pay;
        rows.push({ agent, stats });
      }
    }
    reportState.lastRows = rows;
    reportState.lastColumns = columns;
    reportState.lastTitle = title;
    reportState.lastPerDay = perDay;
    reportState.lastMonthVal = payrollDaily ? singleDayVal : monthVal;
    renderReportTable(title, columns, rows, perDay, reportState.lastMonthVal);
  } finally {
    btn.disabled = false;
    btn.textContent = origLabel;
  }
}

function renderReportTable(title, columns, rows, perDay, monthVal){
  $('reportResultsCard').style.display = 'block';
  $('reportResultsTitle').textContent = `${title} — ${monthVal}`;

  const head = $('reportTableHead');
  head.innerHTML = '<th>User</th>' + (perDay ? '<th>Date</th>' : '') + columns.map(c => `<th>${colLabel(c)}</th>`).join('');

  const body = $('reportTableBody');
  body.innerHTML = '';
  lastReportRows = [];

  if(rows.length === 0){
    body.innerHTML = `<tr><td colspan="${columns.length + (perDay ? 2 : 1)}" class="empty">No data for this range.</td></tr>`;
    $('reportTotalsRow').textContent = '';
    return;
  }

  rows.forEach(r => {
    const rowVals = columns.map(c => REPORT_COLUMNS[c].get(r.stats));
    lastReportRows.push([r.agent.name, ...(perDay ? [r.dateLabel] : []), ...rowVals]);

    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${escapeHtml(r.agent.name)}</td>` + (perDay ? `<td class="mono">${r.dateLabel}</td>` : '') +
      rowVals.map(v => `<td class="mono">${v}</td>`).join('');
    body.appendChild(tr);
  });

  const SUMMABLE = ['productive','break','idle','payable','basicPay','leadBonus','extraBonus','pay','leads'];
  const totalParts = [];
  SUMMABLE.forEach(c => {
    if(!columns.includes(c)) return;
    let sum = 0, any = false;
    rows.forEach(r => {
      const raw = REPORT_COLUMNS[c].get(r.stats);
      const num = parseFloat(raw);
      if(!isNaN(num)){ sum += num; any = true; }
    });
    if(any) totalParts.push(`${colLabel(c)}: ${sum.toFixed(2)}`);
  });
  $('reportTotalsRow').textContent = totalParts.length ? `Totals — ${totalParts.join('   ·   ')}` : '';
}


// ---------- activity log tab ----------
// v360: Audit Log gained subtabs — Billing AK (from Finance) and Chat Logs
// (from User Management), alongside the original audit trail as 'log'. No
// separate per-subtab permission array is needed here (unlike Finance/HR/
// Data Science/Taxes/Time Management) — the whole 'activity' tab is
// unconditionally Owner-only already (deliberately absent from
// DASHBOARD_TAB_KEYS), so anyone who can even open this tab-panel is
// already Owner and can see every subtab under it.
let auditActiveSection = 'log';
// ---------- v823 (owner decision W5): Ops Health ----------
// Owner and Admin by role. Everything comes from one server call,
// public.ops_health(), which checks the role itself -- this function only
// decides whether to show the tab.
function opsHealthCanView(){ return !!(myIsOwner || myRole === 'admin'); }
let opsHealthData = null;
let opsHealthLoading = false;
function opsTime(ts){
  if(!ts) return '—';
  const tz = (typeof globalDisplayTzMode === 'string' && globalDisplayTzMode && globalDisplayTzMode !== 'agent') ? globalDisplayTzMode : undefined;
  try{ return new Date(ts).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(tz ? { timeZone: tz } : {}) }); }
  catch(e){ return new Date(ts).toLocaleString(); }
}
function opsAgo(ts){
  if(!ts) return '';
  const s = Math.max(0, Math.round((Date.now() - new Date(ts).getTime()) / 1000));
  if(s < 90) return 'just now';
  if(s < 5400) return Math.round(s / 60) + ' min ago';
  if(s < 129600) return Math.round(s / 3600) + ' h ago';
  return Math.round(s / 86400) + ' days ago';
}
// Plain words for pg_cron's five-field schedule; anything unusual falls back
// to the raw text.
function opsSchedule(expr){
  const e = String(expr || '').trim();
  let m;
  if(e === '* * * * *') return 'every minute';
  if((m = e.match(/^\*\/(\d+) \* \* \* \*$/))) return `every ${m[1]} min`;
  if((m = e.match(/^(\d+) \* \* \* \*$/))) return `hourly (:${m[1].padStart(2, '0')})`;
  if((m = e.match(/^(\d+) (\d+) \* \* \*$/))) return `daily ${m[2].padStart(2, '0')}:${m[1].padStart(2, '0')} UTC`;
  if((m = e.match(/^(\d+) \*\/(\d+) \* \* \*$/))) return `every ${m[2]} h`;
  return e;
}
function opsPlain(t){
  // A function's JSON reply ({"ok":false,"error":"..."}) shows as its sentence;
  // a gateway error page as its text.
  let x = String(t || '');
  try{ const j = JSON.parse(x); if(j && (j.error || j.message)) x = String(j.error || j.message); }catch(e){}
  return x.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
}
function opsJobState(j){
  if(!j.active) return { label: 'Off', color: 'var(--text-dim)' };
  if(j.open_failures > 0 || j.db_failures_24h > 0) return { label: 'Needs a look', color: 'var(--danger)' };
  if(j.call_failures_24h > 0) return { label: 'Recovered', color: 'var(--away)' };
  return { label: 'OK', color: 'var(--good)' };
}
function opsStat(label, value, color, note){
  return `<div class="card" style="margin:0; padding:14px 16px;">
    <div style="font-size:11px; color:var(--text-dim); text-transform:uppercase; letter-spacing:.8px;">${escapeHtml(label)}</div>
    <div class="mono" style="font-size:26px; font-weight:700; margin-top:4px; color:${color};">${escapeHtml(String(value))}</div>
    ${note ? `<div style="font-size:11.5px; color:var(--text-dim); margin-top:2px;">${escapeHtml(note)}</div>` : ''}
  </div>`;
}
function renderOpsHealth(){
  const d = opsHealthData;
  if(!d) return;
  const jobs = d.jobs || [];
  const active = jobs.filter(j => j.active);
  const needs = active.filter(j => opsJobState(j).label === 'Needs a look');
  const errors = d.errors || [];
  const unlabelled = Number(d.unlabelled_open || 0);
  $('opsUpdated').textContent = 'Updated ' + opsTime(d.generated_at);
  $('opsSummary').innerHTML =
      opsStat('Jobs needing a look', needs.length, needs.length ? 'var(--danger)' : 'var(--good)',
        needs.length ? needs.slice(0, 3).map(j => j.job).join(', ') + (needs.length > 3 ? '…' : '') : 'Everything scheduled is working')
    + opsStat('Jobs running', active.length, 'var(--text)', `${jobs.length - active.length} switched off`)
    + opsStat('Portal errors (24 h)', Number(d.errors_24h || 0), Number(d.errors_24h || 0) ? 'var(--away)' : 'var(--good)',
        errors.length ? 'Latest ' + opsAgo(errors[0].occurred_at) : 'None recorded')
    // v828 (W1): call recordings kept for d.retention.months; deleting stays
    // off until the Owner switches it on (app_settings 'recording_retention').
    + (d.retention ? opsStat(`Recordings past ${Number(d.retention.months || 6)} months`, Number(d.retention.eligible || 0),
        d.retention.error ? 'var(--danger)' : 'var(--text)',
        d.retention.error ? 'Last check failed: ' + d.retention.error
          : (d.retention.delete_enabled ? `Deleted automatically · ${Number(d.retention.deleted || 0)} removed on the last run`
                                        : 'Counted daily · automatic deleting is off')) : '')
    + (unlabelled ? opsStat('Other failed calls', unlabelled, 'var(--away)', 'Not from a named scheduled job (older alerts, or a database trigger)')
        .replace(/<\/div>\s*$/, `<button class="btn-secondary ops-seen-btn" data-job="unlabelled" style="width:auto; margin-top:8px; padding:5px 10px; font-size:11px;">Mark as seen</button></div>`) : '');

  const showOff = $('opsShowOff').checked;
  const rows = jobs.filter(j => showOff || j.active);
  $('opsJobsBody').innerHTML = rows.length ? rows.map(j => {
    const st = opsJobState(j);
    const fail = (d.failures || []).find(f => f.job === j.job);
    const problem = fail ? `${fail.status}: ${opsPlain(fail.detail)}`
      : (j.last_status && j.last_status !== 'succeeded' ? `${j.last_status}: ${j.last_message || ''}` : '');
    return `<tr>
      <td class="mono" style="white-space:nowrap;">${escapeHtml(j.job)}</td>
      <td style="white-space:nowrap;"><span style="color:${st.color}; font-weight:600;">&#9679; ${st.label}</span></td>
      <td style="white-space:nowrap;" title="${escapeHtml(opsTime(j.last_start))}">${j.last_start ? escapeHtml(opsAgo(j.last_start)) : '—'}</td>
      <td class="mono">${Number(j.runs_24h || 0)}</td>
      <td class="mono" style="color:${j.call_failures_24h || j.db_failures_24h ? 'var(--danger)' : 'inherit'};">${Number(j.call_failures_24h || 0) + Number(j.db_failures_24h || 0)}${j.open_failures ? ` <span style="color:var(--text-dim); font-size:11px;">(${Number(j.open_failures)} open)</span>` : ''}</td>
      <td style="white-space:nowrap; font-size:12px;" title="${escapeHtml(j.schedule)}">${escapeHtml(opsSchedule(j.schedule))}</td>
      <td style="font-size:12px; max-width:420px; word-break:break-word;">${problem ? escapeHtml(problem.slice(0, 220)) + (fail ? ` <span style="color:var(--text-dim);">(${escapeHtml(opsAgo(fail.occurred_at))})</span>` : '') : '<span style="color:var(--text-dim);">—</span>'}</td>
      <td>${j.open_failures ? `<button class="btn-secondary ops-seen-btn" data-job="${escapeHtml(j.job)}" style="width:auto; margin-top:0; padding:5px 10px; font-size:11px; white-space:nowrap;">Mark as seen</button>` : ''}</td>
    </tr>`;
  }).join('') : '<tr><td colspan="8" style="color:var(--text-dim);">No scheduled jobs.</td></tr>';
  document.querySelectorAll('#tab-ops_health .ops-seen-btn').forEach(b => b.addEventListener('click', () => opsMarkSeen(b)));

  $('opsErrorsBody').innerHTML = errors.length ? errors.map(e => {
    const where = [e.page, e.source ? `${e.source}${e.line ? ':' + e.line : ''}` : ''].filter(Boolean).join(' · ');
    return `<tr>
      <td style="white-space:nowrap;" title="${escapeHtml(opsTime(e.occurred_at))}">${escapeHtml(opsAgo(e.occurred_at))}</td>
      <td>${escapeHtml(e.portal || '—')}${e.version ? ` <span style="color:var(--text-dim); font-size:11px;">${escapeHtml(e.version)}</span>` : ''}</td>
      <td>${escapeHtml(e.who || '—')}</td>
      <td style="font-size:12px; max-width:420px; word-break:break-word;">${escapeHtml(e.message || '')}</td>
      <td style="font-size:11.5px; color:var(--text-dim); max-width:260px; word-break:break-all;">${escapeHtml(where || '—')}</td>
    </tr>`;
  }).join('') : '<tr><td colspan="5" style="color:var(--text-dim);">No errors recorded. Nobody has hit a crash.</td></tr>';

  // v830: database-region speed test.
  const lat = d.latency || [];
  const ms = (v, base) => {
    if(v == null) return '—';
    const diff = base == null ? 0 : Math.round(v - base);
    const tag = base == null || diff === 0 ? '' : ` <span style="color:${diff < 0 ? 'var(--good)' : 'var(--danger)'}; font-size:11px;">(${diff < 0 ? '' : '+'}${diff})</span>`;
    return `${Math.round(v)} ms${tag}`;
  };
  $('opsLatencyBody').innerHTML = lat.length ? lat.map(r => `<tr>
      <td>${escapeHtml(r.place || '—')}</td>
      <td>${escapeHtml(r.portal === 'client' ? 'Client portal' : r.portal === 'staff' ? 'Staff portal' : (r.portal || '—'))}</td>
      <td class="mono">${Number(r.people || 0)} <span style="color:var(--text-dim); font-size:11px;">(${Number(r.samples || 0)} tests)</span></td>
      <td class="mono">${ms(r.today_ms, null)}</td>
      <td class="mono">${ms(r.us_east_1_ms, r.today_ms)}</td>
      <td class="mono">${ms(r.us_east_2_ms, r.today_ms)}</td>
    </tr>`).join('') : '<tr><td colspan="6" style="color:var(--text-dim);">No results yet. Browsers test once a day, starting a minute after someone signs in.</td></tr>';
}
async function loadOpsHealth(){
  if(!opsHealthCanView() || opsHealthLoading) return;
  opsHealthLoading = true;
  const btn = $('opsRefreshBtn');
  if(btn){ btn.disabled = true; btn.textContent = 'Loading…'; }
  try{
    const { data, error } = await sb.rpc('ops_health');
    if(error) throw error;
    opsHealthData = data || {};
    renderOpsHealth();
  }catch(e){
    $('opsSummary').innerHTML = `<div class="msg error" style="grid-column:1/-1;">Could not load Ops Health: ${escapeHtml(e && e.message ? e.message : String(e))}</div>`;
  }finally{
    opsHealthLoading = false;
    if(btn){ btn.disabled = false; btn.textContent = 'Refresh'; }
  }
}
async function opsMarkSeen(btn){
  const job = btn.dataset.job;
  btn.disabled = true;
  const { error } = await sb.rpc('ops_mark_job_seen', { p_job: job });
  if(error){ btn.disabled = false; alert(error.message || 'Could not update.'); return; }
  logActivity('ops.mark_seen', 'ops', null, `Marked the failures of scheduled job "${job}" as seen`);
  await loadOpsHealth();
}
$('opsRefreshBtn').addEventListener('click', () => loadOpsHealth());
$('opsShowOff').addEventListener('change', () => renderOpsHealth());

function initAuditLogTab(){
  activateAuditSection(auditActiveSection || 'log');
}
function activateAuditSection(key){
  auditActiveSection = key;
  document.querySelectorAll('.audit-subtab-btn').forEach(b => b.classList.toggle('active', b.dataset.auditSection === key));
  document.querySelectorAll('.audit-section').forEach(s => { s.style.display = (s.id === 'auditSection-' + key) ? 'block' : 'none'; });
  if(key === 'log') loadActivityLog();
  else if(key === 'billing_ak') loadBillingAk();
  else if(key === 'chat_logs') initChatLogsSection();
}
document.querySelectorAll('.audit-subtab-btn').forEach(btn => {
  btn.addEventListener('click', () => activateAuditSection(btn.dataset.auditSection));
});

let actRangeMode = 'today';

// Monday 08:00 Cairo-time boundary, matching weekStartCairoISO() used
// elsewhere on this dashboard for "This week (toward limit)" — kept as a
// thin wrapper so "This week" means the same calendar week everywhere in
// the app.
function weekStartISO(){
  return weekStartCairoISO();
}

document.querySelectorAll('.act-range-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.act-range-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    actRangeMode = btn.dataset.range;
    loadActivityLog();
  });
});
$('actAdminFilter').addEventListener('change', loadActivityLog);

async function loadActivityLog(){
  // v395: the filter DROPDOWN stays limited to non-agent roles (agents
  // filtering the audit log by name is a rare need, and the list would
  // otherwise get long fast) — but the NAME LOOKUP below is now built
  // from every profile, not just non-agents. Several logged actions
  // (lead.review, lead.call_back, etc.) can be performed by whichever
  // role a permission grant allows, which is admin-configurable per role
  // (see UM_SECTIONS/leads_sections) — an agent-role user granted one of
  // those permissions had their action logged correctly, but rendered
  // with a blank "—" actor here since they weren't in the old admins-only
  // lookup, and couldn't be found via the filter either.
  const [{ data: admins }, { data: allProfiles }] = await Promise.all([
    sb.from('profiles').select('id, full_name, email').not('role', 'eq', 'agent').order('full_name'),
    sb.from('profiles').select('id, full_name, email'),
  ]);
  const filterSel = $('actAdminFilter');
  const prevFilter = filterSel.value;
  filterSel.innerHTML = '<option value="">All users</option>' +
    (admins||[]).map(a => `<option value="${a.id}">${escapeHtml(a.full_name||a.email)}</option>`).join('');
  filterSel.value = prevFilter;

  // v395: was hard-capped at 300 rows with no pagination and no
  // indication that older rows had been silently dropped once the range
  // exceeded it — an investigator reviewing an incident from a few weeks
  // back could wrongly conclude "no matching action was ever logged"
  // when it simply scrolled out of the fetch window. Fetches one extra
  // row (301) purely to detect truncation without a second count query;
  // the 301st is trimmed back off before rendering.
  const ACTIVITY_LOG_PAGE_SIZE = 300;
  let query = sb.from('activity_log')
    .select('id, admin_id, action, target_type, target_id, details, created_at')
    .order('created_at', { ascending: false })
    .limit(ACTIVITY_LOG_PAGE_SIZE + 1);
  if(actRangeMode === 'today'){
    query = query.gte('created_at', todayRangeISO().start);
  } else if(actRangeMode === 'week'){
    query = query.gte('created_at', weekStartISO());
  }
  if(filterSel.value) query = query.eq('admin_id', filterSel.value);
  const { data: rawLogs } = await query;
  const truncated = (rawLogs || []).length > ACTIVITY_LOG_PAGE_SIZE;
  const logs = truncated ? rawLogs.slice(0, ACTIVITY_LOG_PAGE_SIZE) : (rawLogs || []);

  const truncationNote = $('activityLogTruncationNote');
  if(truncationNote){
    truncationNote.style.display = truncated ? '' : 'none';
    truncationNote.textContent = truncated
      ? `Showing the most recent ${ACTIVITY_LOG_PAGE_SIZE} of more than ${ACTIVITY_LOG_PAGE_SIZE} entries in this range — narrow the range or filter by user to see older ones.`
      : '';
  }

  const adminName = id => { const a = (allProfiles||[]).find(x=>x.id===id); return a ? (a.full_name||a.email) : '—'; };

  // Rendered in the global "Times shown in" zone (Cairo/Chicago toggle in
  // the nav) like Dashboard/Timesheets/Activity — audit log rows track an
  // admin action rather than a monitored agent, so there's no per-row
  // schedule timezone to fall back to for 'agent' mode; that case (and no
  // toggle selection) just renders in the browser's own local zone, same
  // as before this fix. Previously this ignored the toggle entirely, so
  // switching to Egypt/Central had no visible effect on this tab.
  const auditDisplayTz = (globalDisplayTzMode && globalDisplayTzMode !== 'agent') ? globalDisplayTzMode : undefined;

  const body = $('activityBody');
  body.innerHTML = '';
  if(!logs || logs.length === 0){
    body.innerHTML = '<tr><td colspan="4" class="empty">No activity in this range.</td></tr>';
    return;
  }
  logs.forEach(l => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td class="mono">${new Date(l.created_at).toLocaleString([], {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(auditDisplayTz ? { timeZone: auditDisplayTz } : {})})}</td>
      <td>${escapeHtml(adminName(l.admin_id))}</td>
      <td class="mono">${escapeHtml(l.action)}</td>
      <td>${escapeHtml(l.details || '—')}</td>
    `;
    body.appendChild(tr);
  });
}

// Activity tab: full GHL call log (with contact + agent info), independent
// from the compact "Recent GoHighLevel calls" list on the Integrations
// panel. Reads ghl_calls directly — RLS on that table only allows
// Owner/Admin to select rows, so a custom role granted this tab without
// that role will simply see an empty/error state, same restriction the
// Integrations panel's call list already has via the ghl-api function.
// Default range is "today" as seen in the currently-selected global display
// zone (Cairo/Chicago toggle) — same convention as Timesheets' 
// todayDateInputValue(), not the browser's own UTC/local day, which could
// disagree with the selected zone's actual calendar day near a boundary.
function defaultCallActRange(){
  return { from: todayDateInputValue(), to: endOfLoginMonthDateInputValue() };
}
// Turns the two <input type=date> values into an inclusive UTC ISO range,
// with day boundaries computed in the currently-selected global display
// zone — same tz-aware convention tsRangeBounds() uses for Timesheets —
// rather than the admin browser's own local zone.
function callActRangeISO(){
  const fromVal = $('callActFromInput').value;
  const toVal = $('callActToInput').value;
  if(!fromVal && !toVal) return { start: null, end: null };
  const [fy, fm, fd] = (fromVal || toVal).split('-').map(Number);
  const [ty, tm, td] = (toVal || fromVal).split('-').map(Number);
  const { startMs } = dayBoundsMsInZone(globalDisplayTzMode, null, fy, fm, fd);
  const { endMs } = dayBoundsMsInZone(globalDisplayTzMode, null, ty, tm, td);
  return { start: new Date(startMs).toISOString(), end: new Date(endMs).toISOString() };
}

$('callActFromInput').addEventListener('change', loadCallActivity);
$('callActToInput').addEventListener('change', loadCallActivity);
$('callActAgentFilter').addEventListener('change', loadCallActivity);
$('callActDirectionFilter').addEventListener('change', loadCallActivity);
$('callActRoleFilter').addEventListener('change', loadCallActivity);
// v145: covers every column of whichever activity table is currently
// showing — see each kind's own branch in loadCallActivity() for exactly
// which fields it's matched against (ispeedtolead_postback's is the one
// this was specifically added for, but it's wired generically here so any
// other table's branch can opt into the same searchTerm variable too).
$('callActSearchInput').addEventListener('input', debounce(loadCallActivity, 250));
$('callActRefreshBtn').addEventListener('click', loadCallActivity);

// ---------- Activity tab: GoHighLevel / ReadyMode groups, each with its own sub-tabs ----------
// Each kind has its own table+tbody in the DOM (own columns, since calls
// have duration/disposition, texts have a message body, appointments have
// a title — trying to force them into one shared column set was the old
// behavior and left a lot of "—" filler). Emails has no backing table yet
// (see schema.sql note near ghl_messages) so its pill stays disabled.
//
// v40: sub-tabs are now split into two groups (GoHighLevel / ReadyMode,
// see ACTIVITY_GROUPS/ACTIVITY_SECTIONS above) and each is independently
// grantable per role via activity_sections — a role can be scoped to only
// GoHighLevel's Calls, or only ReadyMode's Agent Report, etc., rather than
// all-or-nothing on the whole Activity tab. This is a client-side/UI
// permission layer only, same as um_sections — the underlying tables
// (ghl_calls, readymode_calls, etc.) are still gated server-side by the
// single coarser 'call_activity' RLS claim, not per sub-tab.
let activeActivityGroup = 'ghl';
let activeActivityKind = 'call'; // 'call' | 'sms' | 'appointment'

// A sub-tab is actually usable if its data-act-group matches the active
// group, the role can view that section, and it isn't a permanently-
// disabled placeholder (sms/email — see the button's `disabled` attribute
// in the markup, untouched by permissions since there's no data behind
// them regardless of role).
function activitySubtabBtns(group){
  return Array.from(document.querySelectorAll('.act-subtab-btn')).filter(b =>
    (!group || b.dataset.actGroup === group) && !b.disabled && canViewActivitySection(b.dataset.actKind)
  );
}

async function initActivityTab(){
  // v144: rebuild the Extension group's per-task pills first, so the
  // gating logic right below (which reads ACTIVITY_SECTIONS/reads the
  // buttons just created) sees the current task list. Cheap, small query
  // — safe to re-run every time this tab is opened rather than trying to
  // reuse whatever User Management's Tasks admin panel last fetched
  // (which may not have loaded yet this session for a role without
  // User Management access).
  const { data: tasksForExtension } = await sb.from('tasks').select('id, name, archived_at').order('name');
  refreshExtensionTaskSections(tasksForExtension || []);

  // Land on the first group that actually has a visible sub-tab under
  // this role's permissions, rather than always defaulting to GoHighLevel
  // — a role granted ReadyMode-only access would otherwise land on an
  // empty GoHighLevel group with nothing to click.
  document.querySelectorAll('.act-group-btn').forEach(b => {
    b.style.display = activitySubtabBtns(b.dataset.actGroup).length > 0 ? '' : 'none';
  });
  // v714: back to the group this person was last on (a refresh restores it)
  // while it still has a sub-tab they can see; otherwise the first usable one.
  const rememberedGroup = ACTIVITY_GROUPS.find(g => g.key === activeActivityGroup && activitySubtabBtns(g.key).length > 0);
  const firstUsableGroup = rememberedGroup || ACTIVITY_GROUPS.find(g => activitySubtabBtns(g.key).length > 0);
  activateActivityGroup(firstUsableGroup ? firstUsableGroup.key : activeActivityGroup);
}

function activateActivityGroup(group){
  activeActivityGroup = group;
  document.querySelectorAll('.act-group-btn').forEach(b => b.classList.toggle('active', b.dataset.actGroup === group));
  document.querySelectorAll('.act-subtab-btn').forEach(b => {
    const inGroup = b.dataset.actGroup === group;
    const permitted = canViewActivitySection(b.dataset.actKind);
    b.style.display = (inGroup && permitted) ? '' : 'none';
  });
  // v44: the stat cards mirror whichever group is active, one card per
  // sub-tab in that group, rather than one fixed row mixing both sources.
  $('actStatsRowGhl').style.display = group === 'ghl' ? '' : 'none';
  $('actStatsRowReadymode').style.display = group === 'readymode' ? '' : 'none';
  $('actStatsRowExtension').style.display = group === 'extension' ? '' : 'none';
  $('actStatsRowStaffActivity').style.display = group === 'staff_activity' ? '' : 'none';
  const usable = activitySubtabBtns(group);
  const stillValid = usable.find(b => b.dataset.actKind === activeActivityKind);
  activateActivityKind(stillValid ? activeActivityKind : (usable[0] ? usable[0].dataset.actKind : null));
}

document.querySelectorAll('.act-group-btn').forEach(btn => {
  btn.addEventListener('click', () => activateActivityGroup(btn.dataset.actGroup));
});

function activateActivityKind(kind){
  if(!kind){
    // This role has no permitted sub-tabs in the active group (or at
    // all) — hide every table rather than leave a stale one showing.
    document.querySelectorAll('.act-type-table').forEach(t => t.style.display = 'none');
    $('actGmailPanel').style.display = 'none';
    $('actFilterCard').style.display = '';
    $('actNoAccessMsg').style.display = '';
    return;
  }
  $('actNoAccessMsg').style.display = 'none';
  activeActivityKind = kind;
  document.querySelectorAll('.act-subtab-btn').forEach(b => b.classList.toggle('active', b.dataset.actKind === kind));
  // v144: every per-task Extension pill ('task_<id>') shares the one
  // staff_work table in the DOM — there's no separate actTable-task_<id>
  // element per task, just a different filter on the same query (see
  // loadCallActivity()'s staff_work branch).
  const tableIdKind = kind.startsWith('task_') ? 'staff_work' : kind;
  document.querySelectorAll('.act-type-table').forEach(t => t.style.display = (t.id === 'actTable-' + tableIdKind) ? '' : 'none');

  // Direction only means anything for calls/texts — grey it out otherwise
  // rather than leave a filter on screen that silently does nothing.
  const dirSel = $('callActDirectionFilter');
  const dirApplies = (kind === 'call' || kind === 'rm_call');
  dirSel.disabled = !dirApplies;
  dirSel.title = dirApplies ? '' : "Direction doesn't apply to this activity type";

  // Role, same idea, only meaningful for Staff Activity.
  const roleSel = $('callActRoleFilter');
  const roleApplies = (kind === 'staff_activity');
  roleSel.disabled = !roleApplies;
  roleSel.title = roleApplies ? '' : "Role only applies to Staff Activity";

  // v477: Gmail's Inbox is a live three-pane mail client, not a
  // filterable report table like everything else in this tab -- swap the
  // shared filter card and every act-type-table out for actGmailPanel
  // instead of trying to make From/To/Agent/Direction/Search mean
  // anything for it.
  const isGmailInbox = kind === 'gmail_inbox';
  $('actFilterCard').style.display = isGmailInbox ? 'none' : '';
  $('actGmailPanel').style.display = isGmailInbox ? 'block' : 'none';
  if(isGmailInbox) loadActGmailMessageList(true);

  if(kind !== 'email' && kind !== 'gmail_inbox') loadCallActivity();
}

document.querySelectorAll('.act-subtab-btn').forEach(btn => {
  btn.addEventListener('click', () => { if(!btn.disabled) activateActivityKind(btn.dataset.actKind); });
});

// ---- Activity → Gmail → Inbox (v477) -- rebuilt into a real general
// inbox mail client per explicit request ("make it exactly like gmail"):
// any sender/recipient (no client_accounts concept anymore), free compose
// to any address, real reply threading. Backed by gmail-api's
// list_messages/get_thread/send_message actions. Three panes: folder nav
// (left) / paginated message list (middle) / reading pane + reply, or the
// compose form when Compose is clicked (right). ----
let actGmailFolder = 'inbox'; // 'inbox' | 'sent'
let actGmailMessages = []; // accumulated across "Load more" pages, current folder only
let actGmailNextPageToken = null;
let actGmailInboxAddress = '';
let actGmailSelectedMessageId = null;
let actGmailThreadData = null; // last get_thread response for the open message
let actGmailMode = 'empty'; // 'empty' | 'thread' | 'compose'
let actGmailThreadPollTimer = null;

function actGmailShowPane(mode){
  actGmailMode = mode;
  $('actGmailReadingEmpty').style.display = mode === 'empty' ? 'block' : 'none';
  $('actGmailReadingThread').style.display = mode === 'thread' ? 'flex' : 'none';
  $('actGmailComposeForm').style.display = mode === 'compose' ? 'flex' : 'none';
}

document.querySelectorAll('.actGmailFolderBtn').forEach(btn => {
  btn.addEventListener('click', () => {
    if(btn.dataset.folder === actGmailFolder) return;
    document.querySelectorAll('.actGmailFolderBtn').forEach(b => b.classList.toggle('active', b === btn));
    actGmailFolder = btn.dataset.folder;
    actGmailSelectedMessageId = null;
    clearInterval(actGmailThreadPollTimer);
    actGmailShowPane('empty');
    loadActGmailMessageList(true);
  });
});

async function loadActGmailMessageList(reset){
  const listEl = $('actGmailMessageList');
  if(reset){
    actGmailMessages = [];
    actGmailNextPageToken = null;
    listEl.innerHTML = '<div class="chat-ghl-list-loading">Loading…</div>';
  }
  const res = await callGmailApi({ action: 'list_messages', folder: actGmailFolder, pageToken: actGmailNextPageToken || undefined });
  if(!res.ok){
    listEl.innerHTML = `<div class="chat-ghl-list-empty">${escapeHtml(res.error || 'Failed to load messages.')}</div>`;
    $('actGmailLoadMoreBtn').style.display = 'none';
    return;
  }
  actGmailInboxAddress = res.inboxAddress || '';
  $('actGmailInboxAddress').textContent = actGmailInboxAddress;
  actGmailMessages = actGmailMessages.concat(res.messages || []);
  actGmailNextPageToken = res.nextPageToken || null;
  renderActGmailMessageList();
  $('actGmailLoadMoreBtn').style.display = actGmailNextPageToken ? '' : 'none';
}

// Unread-first, same as real Gmail: unread messages sort to the top
// (newest first within each group); once a message is opened it's
// marked read (see openActGmailMessage below) and naturally sorts back
// down among the read messages on the next render, no manual reorder
// needed since this always re-derives order from each message's current
// m.unread flag rather than caching a position.
function actGmailSortedMessages(){
  return actGmailMessages.slice().sort((a, b) => {
    if(!!a.unread !== !!b.unread) return a.unread ? -1 : 1;
    return new Date(b.date || 0) - new Date(a.date || 0);
  });
}
function renderActGmailMessageList(){
  const listEl = $('actGmailMessageList');
  if(!actGmailMessages.length){
    listEl.innerHTML = `<div class="chat-ghl-list-empty">No ${({sent:'sent mail', updates:'updates', spam:'spam'})[actGmailFolder] || 'inbox mail'} yet.</div>`;
    return;
  }
  listEl.innerHTML = actGmailSortedMessages().map(m => `
    <div class="chat-ghl-list-item ${m.id === actGmailSelectedMessageId ? 'active' : ''}" data-msg-id="${m.id}">
      <div class="chat-conv-info">
        <div class="chat-conv-name">${escapeHtml(actGmailFolder === 'sent' ? (m.to || '(no recipient)') : (m.from || '(unknown sender)'))}</div>
        <div class="chat-conv-preview">${escapeHtml(m.subject || '(no subject)')} &middot; ${escapeHtml(m.snippet || '')}</div>
      </div>
      <div style="display:flex; flex-direction:column; align-items:flex-end; gap:4px;">
        <div class="mono" style="font-size:10px; color:var(--text-dim); white-space:nowrap;">${chatGhlFmtWhen(m.date)}</div>
        ${m.unread ? '<div class="chat-ghl-list-item-badge" title="Unread"></div>' : ''}
      </div>
    </div>
  `).join('');
  listEl.querySelectorAll('.chat-ghl-list-item').forEach(el => {
    el.addEventListener('click', () => {
      const m = actGmailMessages.find(x => x.id === el.dataset.msgId);
      if(m) openActGmailMessage(m);
    });
  });
}
$('actGmailLoadMoreBtn').addEventListener('click', () => loadActGmailMessageList(false));

async function openActGmailMessage(msg){
  clearInterval(actGmailThreadPollTimer);
  actGmailSelectedMessageId = msg.id;
  renderActGmailMessageList();
  actGmailShowPane('thread');
  $('actGmailReadingTitle').textContent = msg.subject || '(no subject)';
  $('actGmailReadingBody').innerHTML = '<div class="chat-ghl-list-loading">Loading…</div>';
  $('actGmailReplyBodyInput').value = '';
  const canText = !!myPermissions.canTextClients;
  $('actGmailReplyNoPermMsg').style.display = canText ? 'none' : 'block';
  $('actGmailReplyCompose').style.display = canText ? 'flex' : 'none';
  await refreshActGmailThread(msg.threadId);
  actGmailThreadPollTimer = setInterval(() => { if(!document.hidden) refreshActGmailThread(msg.threadId); }, 20000);
}

async function refreshActGmailThread(threadId){
  const res = await callGmailApi({ action: 'get_thread', threadId });
  if(actGmailMode !== 'thread' || !actGmailSelectedMessageId) return; // pane switched away while this was in flight
  const bodyEl = $('actGmailReadingBody');
  if(!res.ok){ bodyEl.innerHTML = `<div class="chat-ghl-list-empty">${escapeHtml(res.error || 'Failed to load thread.')}</div>`; return; }
  actGmailThreadData = res;
  // gmail-api's get_thread already stripped Gmail's own UNREAD label from
  // every message in this thread (real-Gmail "opening it reads it"
  // behavior) -- mirror that here so the list re-sorts/drops its unread
  // dot immediately instead of waiting on the next 60s notification poll
  // or a manual folder switch to notice.
  let markedAnyRead = false;
  actGmailMessages.forEach(m => { if(m.threadId === threadId && m.unread){ m.unread = false; markedAnyRead = true; } });
  if(markedAnyRead) renderActGmailMessageList();
  const messages = res.messages || [];
  bodyEl.innerHTML = messages.length
    ? messages.map(m => `
        <div class="chat-msg-row ${m.direction === 'outbound' ? 'mine' : 'theirs'}">
          <div class="chat-msg-meta">${escapeHtml(m.from)} &middot; ${chatGhlFmtWhen(m.date)}</div>
          <div class="chat-msg-bubble" style="white-space:pre-wrap;">${chatLinkify(escapeHtml(m.bodyText))}</div>
        </div>
      `).join('')
    : '<div class="chat-ghl-list-empty">No messages in this thread.</div>';
  bodyEl.scrollTop = bodyEl.scrollHeight;
}

async function sendActGmailReply(){
  const input = $('actGmailReplyBodyInput');
  const text = input.value.trim();
  if(!text || !actGmailThreadData) return;
  const sendBtn = $('actGmailReplySendBtn');
  input.disabled = true; sendBtn.disabled = true;
  const subj = actGmailThreadData.replySubject || '';
  const res = await callGmailApi({
    action: 'send_message',
    to: actGmailThreadData.replyTo,
    subject: /^re:/i.test(subj) ? subj : `Re: ${subj}`,
    body: text,
    threadId: actGmailThreadData.threadId,
    inReplyTo: actGmailThreadData.threadLastMessageId,
    references: actGmailThreadData.threadReferences,
  });
  input.disabled = false; sendBtn.disabled = false;
  if(!res.ok){ alert(res.error || 'Failed to send.'); return; }
  input.value = '';
  input.focus();
  await refreshActGmailThread(actGmailThreadData.threadId);
}
$('actGmailReplySendBtn').addEventListener('click', sendActGmailReply);
$('actGmailReplyBodyInput').addEventListener('keydown', (e) => { if(e.key === 'Enter'){ e.preventDefault(); sendActGmailReply(); } });

$('actGmailComposeBtn').addEventListener('click', () => {
  clearInterval(actGmailThreadPollTimer);
  actGmailSelectedMessageId = null;
  renderActGmailMessageList();
  actGmailShowPane('compose');
  $('actGmailComposeTo').value = '';
  $('actGmailComposeCc').value = '';
  $('actGmailComposeSubject').value = '';
  $('actGmailComposeBody').value = '';
  $('actGmailComposeTo').focus();
});

async function sendActGmailCompose(){
  const to = $('actGmailComposeTo').value.trim();
  const cc = $('actGmailComposeCc').value.trim();
  const subject = $('actGmailComposeSubject').value.trim();
  const body = $('actGmailComposeBody').value.trim();
  if(!to){ alert('Enter a "To" address.'); return; }
  if(!body){ alert('Write something to send.'); return; }
  const sendBtn = $('actGmailComposeSendBtn');
  sendBtn.disabled = true;
  const res = await callGmailApi({ action: 'send_message', to, cc: cc || undefined, subject, body });
  sendBtn.disabled = false;
  if(!res.ok){ alert(res.error || 'Failed to send.'); return; }
  actGmailShowPane('empty');
  if(actGmailFolder === 'sent') loadActGmailMessageList(true);
}
$('actGmailComposeSendBtn').addEventListener('click', sendActGmailCompose);

// v107: ghl_calls.call_at/call_start_time/call_end_time still land ~5h
// behind the real clock time despite the v99 ghl-webhook fix (flagged
// against live data) — fmtCallAdj below applies a DISPLAY-ONLY correction
// so Activity -> GHL -> Call reads right. v395: that same gap means the
// range FILTER on call_at (both the table query below and
// loadActivityTotals' ghl_calls stat card) was comparing real-world day
// boundaries against a stored value that's hours earlier than real time —
// a call in roughly the first few hours of a real calendar day would have
// call_at still timestamped the previous day, silently excluding it from
// "today"'s results even though its DISPLAYED time (once fmtCallAdj
// corrects it) looks like it belongs. Shifting the query bounds by the
// same amount (see ghlCallAtRangeISO) makes the fetched SET match the
// calendar day the filter claims, without touching the stored value or
// requiring the ingestion bug to be re-diagnosed first. If ghl-webhook's
// own stored value is ever corrected at the source, both this and
// fmtCallAdj should come back out together.
//
// CORRECTNESS FIX (audit finding, dashboard pass): the gap is GHL sending
// America/Chicago wall-clock time that ghl-webhook stores as if it were
// UTC, so the true correction is
// Chicago's OWN UTC offset at that instant — 5h during CDT, 6h during
// CST — not a flat 5h. A flat constant was only right for roughly half
// the year; the other half (CST, ~Nov-Mar) every adjusted time and every
// range boundary was off by an hour. chicagoUtcOffsetMinutes() mirrors
// cairoUtcOffsetMinutes()'s Intl-based approach so this tracks Chicago's
// DST transitions automatically instead of needing a manual flip twice a
// year.
function chicagoUtcOffsetMinutes(date){
  const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Chicago', timeZoneName: 'shortOffset' }).formatToParts(date);
  const tzPart = (parts.find(p => p.type === 'timeZoneName') || {}).value || 'GMT-6';
  const m = tzPart.match(/GMT([+-]\d+)(?::(\d+))?/);
  if(!m) return -360; // fallback: Chicago standard time, UTC-6
  const hours = parseInt(m[1], 10);
  const mins = m[2] ? parseInt(m[2], 10) : 0;
  return hours * 60 + (hours < 0 ? -mins : mins);
}
// Magnitude of Chicago's UTC offset (in ms) at a given instant — always
// positive since Chicago is west of UTC — for shifting a stored call_at
// value toward or away from real time.
function ghlCallAtAdjMs(date){
  return Math.abs(chicagoUtcOffsetMinutes(date)) * 60000;
}
function ghlCallAtRangeISO(rangeStart, rangeEnd){
  return {
    start: rangeStart ? new Date(new Date(rangeStart).getTime() - ghlCallAtAdjMs(new Date(rangeStart))).toISOString() : null,
    end: rangeEnd ? new Date(new Date(rangeEnd).getTime() - ghlCallAtAdjMs(new Date(rangeEnd))).toISOString() : null,
  };
}

async function loadCallActivity(){
  const kind = activeActivityKind;
  if(kind === 'email') return; // no data source active — see act-subtab-btn note

  // v144: every per-task Extension pill resolves to the same underlying
  // staff_work body/table/colspan — see the tableIdKind comment in
  // activateActivityKind() above.
  const tableIdKind = kind.startsWith('task_') ? 'staff_work' : kind;
  const bodyIds = { call: 'callActivityBody', sms: 'smsActivityBody', appointment: 'apptActivityBody', rm_call: 'rmCallActivityBody', agent_report: 'agentReportActivityBody', productivity: 'productivityActivityBody', staff_work: 'staffWorkActivityBody', staff_activity: 'staffActivityBody' };
  const colspans = { call: 10, sms: 5, appointment: 8, rm_call: 8, agent_report: 11, productivity: 8, staff_work: 6, staff_activity: 8 };
  const body = $(bodyIds[tableIdKind]);
  body.innerHTML = `<tr><td colspan="${colspans[tableIdKind]}" class="empty">Loading…</td></tr>`;

  if(!$('callActFromInput').value || !$('callActToInput').value){
    const { from, to } = defaultCallActRange();
    $('callActFromInput').value = from;
    $('callActToInput').value = to;
  }

  const { data: agents } = await sb.from('profiles').select('id, full_name, email, ghl_user_id, readymode_username').order('full_name');
  const agentSel = $('callActAgentFilter');
  const prevAgent = agentSel.value;
  agentSel.innerHTML = '<option value="">All agents</option>' +
    (agents||[]).filter(a => a.ghl_user_id || a.readymode_username).map(a => `<option value="${a.id}">${escapeHtml(a.full_name||a.email||'—')}</option>`).join('');
  agentSel.value = prevAgent;

  const agentId = agentSel.value;
  const dirVal = (kind === 'call') ? $('callActDirectionFilter').value : '';
  const { start: rangeStart, end: rangeEnd } = callActRangeISO();

  // Totals row always shows all 3 categories regardless of the active
  // sub-tab, so it stays a useful at-a-glance breakdown.
  loadActivityTotals(agentId, dirVal, rangeStart, rangeEnd);

  const nameById = {}; (agents||[]).forEach(a => { nameById[a.id] = a.full_name || a.email; });
  // Same "Agent local / Cairo / Chicago" global toggle used on Dashboard and
  // Timesheets — 'agent' resolves per-row via each row's own user_id and
  // that agent's schedules.timezone (falling back to browser local for an
  // unmapped/no-schedule agent), matching what those other two tabs mean by
  // "agent local". Needs its own lookup here since ghl_calls/ghl_appointments/
  // etc. rows carry a user_id but not a timezone directly.
  const { data: actScheduleRows } = await sb.from('schedules').select('user_id, timezone');
  const actAgentTz = {};
  (actScheduleRows || []).forEach(s => { if(s.timezone) actAgentTz[s.user_id] = s.timezone; });
  const resolveActTz = userId => globalDisplayTzMode === 'agent' ? actAgentTz[userId] : globalDisplayTzMode;
  // Short label for whichever zone times are ACTUALLY being rendered in for
  // a given row — matches the toggle button text ("Egypt"/"US (Central
  // Time)") so the Timezone column reads consistently with the toggle,
  // rather than falling back to the raw IANA string for an agent-local zone.
  const tzShortLabel = tz => tz === 'Africa/Cairo' ? 'Cairo' : tz === 'America/Chicago' ? 'Chicago' : (tz || null);
  const fmt = (iso, userId) => {
    if(!iso) return '—';
    const tz = resolveActTz(userId);
    return new Date(iso).toLocaleString([], {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(tz ? { timeZone: tz } : {})});
  };
  // See ghlCallAtAdjMs's comment above — same DST-aware offset, applied
  // to the two rendered columns (Call started/Call ended) rather than the
  // query bounds. "Recent GoHighLevel calls" (Integrations panel) is a
  // separate widget backed by ghl-api's own live GHL fetch, not this
  // table, so it was never affected by this and doesn't need the
  // adjustment.
  const fmtCallAdj = (iso, userId) => {
    if(!iso) return '—';
    const adjusted = new Date(new Date(iso).getTime() + ghlCallAtAdjMs(new Date(iso)));
    const tz = resolveActTz(userId);
    return adjusted.toLocaleString([], {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(tz ? { timeZone: tz } : {})});
  };
  // Third arg (firstName) is optional and currently only passed for
  // appointments — GHL's {{appointment.user.first_name}} merge tag gives a
  // readable fallback label when the assigned user can't be resolved to a
  // platform agent (see resolveUserId's comment on why that's common for
  // appointment/message events).
  const whoCell = (userId, ghlUserId, firstName) => userId
    ? escapeHtml(nameById[userId] || 'Agent')
    : `<span style="color:var(--text-dim);">unmapped${firstName ? ` (${escapeHtml(firstName)})` : ` (${escapeHtml(ghlUserId || '—')})`}</span>`;
  const contactCell = (name, phone, email, id) => {
    const bits = [name, phone, email].filter(Boolean).map(escapeHtml);
    return bits.length ? bits.join(' · ') : (id ? escapeHtml(id) : '—');
  };

  if(kind === 'call'){
    const { start: callRangeStart, end: callRangeEnd } = ghlCallAtRangeISO(rangeStart, rangeEnd);
    let q = sb.from('ghl_calls')
      .select('id, user_id, ghl_user_id, contact_id, contact_name, contact_phone, contact_email, direction, status, disposition, duration_seconds, from_number, to_number, recording_url, call_at, call_start_time, call_end_time')
      .order('call_at', { ascending: false }).limit(300);
    if(callRangeStart) q = q.gte('call_at', callRangeStart);
    if(callRangeEnd) q = q.lte('call_at', callRangeEnd);
    if(agentId) q = q.eq('user_id', agentId);
    if(dirVal) q = q.eq('direction', dirVal);
    const { data, error } = await q;
    if(error){ body.innerHTML = `<tr><td colspan="10" class="msg error">${escapeHtml(error.message)}</td></tr>`; return; }
    if(!data || !data.length){ body.innerHTML = '<tr><td colspan="10" class="empty">No calls in this range.</td></tr>'; return; }
    body.innerHTML = '';
    data.forEach(r => {
      const dur = r.duration_seconds != null ? `${Math.floor(r.duration_seconds/60)}m ${r.duration_seconds%60}s` : '—';
      const num = r.direction === 'outbound' ? (r.to_number || '—') : (r.from_number || '—');
      const recording = r.recording_url ? `<a href="${escapeHtml(safeHrefUrl(r.recording_url))}" target="_blank" rel="noopener">Play</a>` : '—';
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="mono" style="color:var(--text-2);">${fmtCallAdj(r.call_start_time || r.call_at, r.user_id)}</td>
        <td class="mono" style="color:var(--text-2);">${fmtCallAdj(r.call_end_time, r.user_id)}</td>
        <td>${whoCell(r.user_id, r.ghl_user_id)}</td>
        <td>${contactCell(r.contact_name, r.contact_phone, r.contact_email, r.contact_id)}</td>
        <td>${escapeHtml(r.direction || '—')}</td>
        <td>${escapeHtml(r.status || '—')}</td>
        <td>${escapeHtml(r.disposition || '—')}</td>
