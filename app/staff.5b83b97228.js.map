async function initListBuilderSection(){
  if(!lbFacetsLoadPromise) lbFacetsLoadPromise = loadListBuilderFacets();
  await lbFacetsLoadPromise;
  loadListBuilderBackfillStatus();
  loadListBuilderSavedFilters();
}
// v436: Task 4 -- per-county progress of the background full-county
// backfill job (list-builder-maintenance's backfill_step, on a 2-minute
// pg_cron tick). Read-only status card; the job itself needs no action
// from here.
async function loadListBuilderBackfillStatus(){
  const grid = $('lbBackfillStatusGrid');
  if(!grid) return;
  const result = await listBuilderCall({ action: 'backfill_status' });
  if(!result || result.ok === false){
    grid.innerHTML = `<div style="font-size:11px; color:var(--danger);">Couldn't load backfill status: ${escapeHtml((result && result.error) || 'Unknown error')}</div>`;
    return;
  }
  const countyCard = (label, s) => {
    if(!s) return '';
    const pct = s.areasTotal ? Math.round((s.areasDone / s.areasTotal) * 100) : 0;
    return `
      <div style="border:1px solid var(--border); border-radius:8px; padding:10px 12px;">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px;">
          <span class="mono" style="font-size:11px; text-transform:uppercase; letter-spacing:0.5px; color:var(--text-2);">${escapeHtml(label)}</span>
          <span class="mono" style="font-size:11px; color:${s.complete ? 'var(--good)' : 'var(--text-dim)'};">${s.complete ? 'Complete' : 'In progress'}</span>
        </div>
        <div style="height:6px; background:var(--card-hover); border-radius:3px; overflow:hidden; margin-bottom:8px;">
          <div style="height:100%; width:${pct}%; background:${s.complete ? 'var(--good)' : 'var(--focus)'};"></div>
        </div>
        <div style="font-size:11px; color:var(--text-dim); line-height:1.5;">
          ${s.areasDone || 0} / ${s.areasTotal || 0} areas done &middot; ${(s.totalUpserted || 0).toLocaleString()} properties pulled so far<br>
          ${s.lastRunAt ? 'Last ran ' + new Date(s.lastRunAt).toLocaleString() : 'Not started yet'}
          ${s.currentError ? `<br><span style="color:var(--danger);">${escapeHtml(s.currentError)}</span>` : ''}
        </div>
      </div>`;
  };
  grid.innerHTML = countyCard('Cook, IL', result.cook) + countyCard('DuPage, IL', result.dupage);
}
document.getElementById('lbBackfillRefreshBtn')?.addEventListener('click', loadListBuilderBackfillStatus);
async function loadListBuilderFacets(){
  const result = await listBuilderCall({ action: 'facets' });
  if(!result.ok){ console.error('Failed to load List Builder facets', result.error); return; }
  const countySel = $('lbFilterCounty');
  const prevCounty = countySel.value;
  countySel.innerHTML = '<option value="">Any</option>' + (result.counties || []).map(c => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
  countySel.value = (result.counties || []).includes(prevCounty) ? prevCounty : '';
  lbTownshipsByCounty = result.townshipsByCounty || {};
  populateListBuilderTownshipOptions();
}
let lbTownshipsByCounty = {};
function populateListBuilderTownshipOptions(){
  const county = $('lbFilterCounty').value;
  const townships = county ? (lbTownshipsByCounty[county] || []) : Array.from(new Set(Object.values(lbTownshipsByCounty).flat())).sort();
  const sel = $('lbFilterTownship');
  const prev = sel.value;
  sel.innerHTML = '<option value="">Any</option>' + townships.map(t => `<option value="${escapeHtml(t)}">${escapeHtml(t)}</option>`).join('');
  sel.value = townships.includes(prev) ? prev : '';
}
$('lbFilterCounty').addEventListener('change', populateListBuilderTownshipOptions);

// v436: Task 6 -- shared by runListBuilderSearch (Search button), the
// Save Filter button, and Load Filter -- reading/writing the same set of
// controls from one place so a new filter added here can't drift between
// the three call sites.
// v437: numeric filter inputs -- '' means "not set" (undefined, not sent),
// anything else parsed as a Number so a stray non-numeric paste doesn't
// silently become the string "abc" in the request body.
function lbNumOrUndef(id){
  const raw = $(id).value.trim();
  if(!raw) return undefined;
  const n = Number(raw);
  return Number.isFinite(n) ? n : undefined;
}
function lbCollectFilterParams(){
  return {
    // v446: unified free-text search box -- see the input's own comment
    // in the markup and the search action's own comment (staff-list-
    // builder) for exactly what it matches.
    q: $('lbFilterSearch').value.trim() || undefined,
    county: $('lbFilterCounty').value || undefined,
    township: $('lbFilterTownship').value || undefined,
    city: $('lbFilterCity').value.trim() || undefined,
    zip: $('lbFilterZip').value.trim() || undefined,
    absenteeOnly: $('lbFilterAbsenteeOnly').checked || undefined,
    tiredLandlordOnly: $('lbFilterTiredLandlordOnly').checked || undefined,
    corporateOwnerOnly: $('lbFilterCorporateOwnerOnly').checked || undefined,
    individualOwnerOnly: $('lbFilterIndividualOwnerOnly').checked || undefined,
    isProbateEstateOnly: $('lbFilterProbateEstateOnly').checked || undefined,
    isVacantBuildingOnly: $('lbFilterVacantBuildingOnly').checked || undefined,
    isPreforeclosureOnly: $('lbFilterPreforeclosureOnly').checked || undefined,
    // v437: the remaining ~24 search params -- see the Advanced Filters
    // <details> block's own comment for the full inventory and why each
    // group is scoped the way it is.
    longTermOwnerOnly: $('lbFilterLongTermOwnerOnly').checked || undefined,
    minPortfolioSize: lbNumOrUndef('lbFilterMinPortfolioSize'),
    minOwnershipYears: lbNumOrUndef('lbFilterMinOwnershipYears'),
    hasBuildingCodeLawsuitOnly: $('lbFilterBuildingCodeLawsuitOnly').checked || undefined,
    isInherited: $('lbFilterInheritedOnly').checked || undefined,
    ownershipType: $('lbFilterOwnershipType').value || undefined,
    ownerMailingState: $('lbFilterOwnerMailingState').value.trim().toUpperCase() || undefined,
    minBeds: lbNumOrUndef('lbFilterMinBeds'),
    minBaths: lbNumOrUndef('lbFilterMinBaths'),
    minSqft: lbNumOrUndef('lbFilterMinSqft'),
    maxSqft: lbNumOrUndef('lbFilterMaxSqft'),
    minYearBuilt: lbNumOrUndef('lbFilterMinYearBuilt'),
    maxYearBuilt: lbNumOrUndef('lbFilterMaxYearBuilt'),
    minLotSqft: lbNumOrUndef('lbFilterMinLotSqft'),
    maxLotSqft: lbNumOrUndef('lbFilterMaxLotSqft'),
    minNumStories: lbNumOrUndef('lbFilterMinNumStories'),
    propertyUseType: $('lbFilterPropertyUseType').value || undefined,
    isMfh2to4: $('lbFilterMfh2to4').checked || undefined,
    isMfh5Plus: $('lbFilterMfh5Plus').checked || undefined,
    hasGarage: $('lbFilterHasGarage').checked || undefined,
    hasAttic: $('lbFilterHasAttic').checked || undefined,
    hasBasement: $('lbFilterHasBasement').checked || undefined,
    minAssessedValue: lbNumOrUndef('lbFilterMinAssessedValue'),
    maxAssessedValue: lbNumOrUndef('lbFilterMaxAssessedValue'),
    lastSaleType: $('lbFilterLastSaleType').value || undefined,
    excludedOnly: $('lbFilterExcludedOnly').checked || undefined,
  };
}
function lbApplyFilterParams(params){
  params = params || {};
  $('lbFilterSearch').value = params.q || '';
  $('lbFilterCounty').value = params.county || '';
  populateListBuilderTownshipOptions();
  $('lbFilterTownship').value = params.township || '';
  $('lbFilterCity').value = params.city || '';
  $('lbFilterZip').value = params.zip || '';
  $('lbFilterAbsenteeOnly').checked = !!params.absenteeOnly;
  $('lbFilterTiredLandlordOnly').checked = !!params.tiredLandlordOnly;
  $('lbFilterCorporateOwnerOnly').checked = !!params.corporateOwnerOnly;
  $('lbFilterIndividualOwnerOnly').checked = !!params.individualOwnerOnly;
  $('lbFilterProbateEstateOnly').checked = !!params.isProbateEstateOnly;
  $('lbFilterVacantBuildingOnly').checked = !!params.isVacantBuildingOnly;
  $('lbFilterPreforeclosureOnly').checked = !!params.isPreforeclosureOnly;
  $('lbFilterLongTermOwnerOnly').checked = !!params.longTermOwnerOnly;
  $('lbFilterMinPortfolioSize').value = params.minPortfolioSize ?? '';
  $('lbFilterMinOwnershipYears').value = params.minOwnershipYears ?? '';
  $('lbFilterBuildingCodeLawsuitOnly').checked = !!params.hasBuildingCodeLawsuitOnly;
  $('lbFilterInheritedOnly').checked = !!params.isInherited;
  $('lbFilterOwnershipType').value = params.ownershipType || '';
  $('lbFilterOwnerMailingState').value = params.ownerMailingState || '';
  $('lbFilterMinBeds').value = params.minBeds ?? '';
  $('lbFilterMinBaths').value = params.minBaths ?? '';
  $('lbFilterMinSqft').value = params.minSqft ?? '';
  $('lbFilterMaxSqft').value = params.maxSqft ?? '';
  $('lbFilterMinYearBuilt').value = params.minYearBuilt ?? '';
  $('lbFilterMaxYearBuilt').value = params.maxYearBuilt ?? '';
  $('lbFilterMinLotSqft').value = params.minLotSqft ?? '';
  $('lbFilterMaxLotSqft').value = params.maxLotSqft ?? '';
  $('lbFilterMinNumStories').value = params.minNumStories ?? '';
  $('lbFilterPropertyUseType').value = params.propertyUseType || '';
  $('lbFilterMfh2to4').checked = !!params.isMfh2to4;
  $('lbFilterMfh5Plus').checked = !!params.isMfh5Plus;
  $('lbFilterHasGarage').checked = !!params.hasGarage;
  $('lbFilterHasAttic').checked = !!params.hasAttic;
  $('lbFilterHasBasement').checked = !!params.hasBasement;
  $('lbFilterMinAssessedValue').value = params.minAssessedValue ?? '';
  $('lbFilterMaxAssessedValue').value = params.maxAssessedValue ?? '';
  $('lbFilterLastSaleType').value = params.lastSaleType || '';
  $('lbFilterExcludedOnly').checked = !!params.excludedOnly;
}

// v435: 500 -> 1000 (staff-list-builder's old per-call cap) -- was purely a
// UI browsing limit, not the export limit (see lbExportBtn's own comment
// for that fix). v436: also now the page size for Prev/Next browsing
// (lbFetchPage below) -- distinct from lbExportBtn's own PAGE=2000 export
// loop, which pages through the FULL result set for export regardless of
// what's currently displayed here.
const LB_PAGE_SIZE = 1000;
let lbPageOffset = 0;

async function runListBuilderSearch(){
  // v435/v436: remembered so lbExportBtn can re-run this exact search with
  // a growing offset, and so Prev/Next (lbFetchPage) can re-page it --
  // see each's own comment. A fresh Search always starts back at page 1.
  lbLastSearchParams = lbCollectFilterParams();
  await lbFetchPage(0);
}
// v436: Task 6 -- basic next/previous page browsing using search's own
// offset param. Deliberately separate from lbExportBtn's "select all ->
// export every matching row" loop above (that one pages through results
// for a CSV without ever rendering them here) -- this one pages through
// results FOR DISPLAY, one LB_PAGE_SIZE page at a time.
//
// v442: click-to-sort -- a table-view concern like pagination/columns, not
// part of lbLastSearchParams/saved filters. null means "use the server's
// own default" (created_at desc), matching pre-v442 behavior exactly until
// a header is actually clicked.
let lbSortBy = null;
let lbSortDir = 'asc';
// BUG FIX: nothing used to stop an older, slower-resolving call from
// overwriting state a newer one already set once IT resolved first -- e.g.
// a Next click immediately followed by Prev, or two sort-header clicks in a
// row, raced two fetches with final state decided by response order, not
// click order (the pager could end up showing page-2 rows while its own
// buttons/offset claimed page 1). `lbFetchSeq` only lets the most recently
// STARTED call mutate state; a response from a superseded call is dropped.
let lbFetchSeq = 0;
async function lbFetchPage(offset){
  const seq = ++lbFetchSeq;
  const btn = $('lbSearchBtn');
  btn.disabled = true;
  const original = btn.textContent;
  btn.textContent = 'Searching…';
  const result = await listBuilderCall({ action: 'search', ...lbLastSearchParams, limit: LB_PAGE_SIZE, offset, sortBy: lbSortBy || undefined, sortDir: lbSortBy ? lbSortDir : undefined });
  btn.disabled = false;
  btn.textContent = original;
  if(seq !== lbFetchSeq) return; // superseded by a newer request started after this one
  if(!result.ok){ alert(result.error || 'Search failed'); return; }
  lbPageOffset = offset;
  lbResultRows = result.rows || [];
  lbLastTotal = result.total || lbResultRows.length;
  renderListBuilderResults(lbLastTotal);
}
// Matches staff-list-builder's own SORTABLE_COLUMNS allowlist exactly --
// keep in sync if that changes. 'address_line1' isn't in LB_COLUMN_DEFS
// (it's the locked, always-shown column), so it's handled as its own case
// in renderListBuilderResults' header-building below rather than via the
// `sortable` flag the rest of LB_COLUMN_DEFS uses.
// BUG FIX: 'created_at' was missing here even though LB_COLUMN_DEFS marks
// it sortable:true (so its "First Synced" header rendered with a pointer
// cursor) and the backend's own SORTABLE_COLUMNS allowlist has always
// accepted it -- clicking the header silently did nothing.
const LB_SORTABLE_KEYS = new Set(['address_line1', 'city', 'state', 'zip', 'county', 'owner_name', 'owner_last_name', 'is_absentee_owner', 'owner_portfolio_size', 'assessed_value', 'last_sale_date', 'year_built', 'created_at']);
function lbSortIndicator(key){
  if(lbSortBy !== key) return '';
  return lbSortDir === 'asc' ? ' &#9650;' : ' &#9660;';
}
function lbHandleSortClick(key){
  if(!LB_SORTABLE_KEYS.has(key)) return;
  if(lbSortBy === key) lbSortDir = (lbSortDir === 'asc') ? 'desc' : 'asc';
  else { lbSortBy = key; lbSortDir = 'asc'; }
  lbFetchPage(0);
}
// v438: full column registry backing the results table's column picker --
// 44 displayable fields (Address plus these 43), closing the audit's "7 of
// 46 fields shown" finding. Independent from LB_FULL_CSV_HEADERS/
// lbFullCsvRow (v437's Task 7 export shape) -- what's on screen and what's
// exported are separate concerns, same split the Custom Report tab's own
// display-vs-export columns already keep. `id`/raw `extra_fields` aren't
// listed -- `id` is an internal UUID with no staff value, and `extra_fields`
// is a raw JSONB blob whose one useful subfield ("class") already has its
// own column below.
// v442: `sortable: true` marks the columns staff-list-builder's own
// SORTABLE_COLUMNS allowlist accepts -- keep the two in sync if either
// changes. Every sortable key here is intentionally identical to its own
// db column name, so no separate key-mapping table is needed; see
