  const statusEl = $('ispeedtoleadModalStatus');
  statusEl.textContent = 'Details saved.';
  statusEl.style.display = 'block';
});

$('ispeedtoleadModalSendBtn').addEventListener('click', async () => {
  if(!ispeedtoleadModalLead) return;
  const msg = $('ispeedtoleadModalMsg');
  const statusEl = $('ispeedtoleadModalStatus');
  msg.style.display = 'none';
  statusEl.style.display = 'none';

  // Save whatever's currently in the form first, so Send always reflects
  // what's on screen even if the admin forgot to click "Save details".
  const ispdSendProblem = ispdContactFieldProblem();   // v711
  if(ispdSendProblem){ msg.textContent = ispdSendProblem; msg.style.display = 'block'; return; }
  const updated = collectIspeedToLeadFields(ispeedtoleadModalLead.extra_fields);
  const { error: saveErr } = await sb.from('leads').update({ extra_fields: updated }).eq('id', ispeedtoleadModalLead.id);
  if(saveErr){ msg.textContent = saveErr.message; msg.style.display = 'block'; return; }
  ispeedtoleadModalLead.extra_fields = updated;

  const sendBtn = $('ispeedtoleadModalSendBtn');
  sendBtn.disabled = true;
  sendBtn.textContent = 'Sending…';
  try {
    let { data, error } = await sb.functions.invoke('ispeedtolead-submit', { body: { lead_id: ispeedtoleadModalLead.id } });
    // supabase-js surfaces a non-2xx Edge Function response as `error` with
    // no parsed body — re-fetch what the function actually said so a 400
    // (missing fields) or 409 (already sent) shows a useful message instead
    // of a generic "Edge Function returned a non-2xx status code".
    if(error && error.context && typeof error.context.json === 'function'){
      try { data = await error.context.json(); } catch(_e) { /* fall through to generic message */ }
    }
    if(data && data.already_sent){
      const resend = confirm('This lead was already sent successfully to PrimeHome Buyers. Send it again anyway?');
      if(!resend){ statusEl.textContent = 'Not resent.'; statusEl.style.display = 'block'; return; }
      sendBtn.textContent = 'Sending…';
      ({ data, error } = await sb.functions.invoke('ispeedtolead-submit', { body: { lead_id: ispeedtoleadModalLead.id, force: true } }));
      if(error && error.context && typeof error.context.json === 'function'){
        try { data = await error.context.json(); } catch(_e) { /* fall through */ }
      }
    }
    // BUG FIX (user request, 2026-09-04): real data showed "Duplicate call
    // record transcription" + "Duplicate address/phone number" are
    // iSpeedToLead's single biggest rejection bucket (~46% of all
    // rejections) — almost always the same seller reaching them twice under
    // two different lead rows (a different call, maybe worked by a
    // different agent). The edge function's own duplicate_phone guard
    // catches this before a likely-doomed send goes out; surface it the
    // same warn-then-confirm way already_sent works above.
    if(data && data.duplicate_phone){
      const when = data.previous?.created_at ? new Date(data.previous.created_at).toLocaleString() : 'a previous date';
      const via = data.previous?.channel === 'gyhomes' ? 'gyhomes' : 'PrimeHome Buyers';
      // BUG FIX (user question, 2026-09-04 — "what if the seller has another
      // address in different state"): a bare phone match on its own doesn't
      // tell you whether this is the same property or a seller's genuinely
      // separate second one elsewhere — show both addresses so whoever's
      // confirming can tell at a glance, same reasoning as
      // findPrimeHomeBuyersDuplicate's own submission-time fix.
      const priorAddr = data.previous?.address;
      const addrNote = data.same_address
        ? `\n\nSame address on file for both — this looks like the same property.`
        : (priorAddr ? `\n\nThat prior lead's address: ${priorAddr}\nThis lead's address: ${data.this_address || 'not set'}\n\nIf that's a different property, this is probably fine to send.` : '');
      const resend = confirm(`This seller's phone number was already sent to iSpeedToLead as a DIFFERENT lead (via ${via}) on ${when}. This is the #1 cause of rejections.${addrNote}\n\nSend anyway?`);
      if(!resend){ statusEl.textContent = 'Not sent.'; statusEl.style.display = 'block'; return; }
      sendBtn.textContent = 'Sending…';
      ({ data, error } = await sb.functions.invoke('ispeedtolead-submit', { body: { lead_id: ispeedtoleadModalLead.id, force: true } }));
      if(error && error.context && typeof error.context.json === 'function'){
        try { data = await error.context.json(); } catch(_e) { /* fall through */ }
      }
    }
    if(data && data.missing_fields && data.missing_fields.length){
      msg.textContent = `Fill in before sending: ${data.missing_fields.join(', ')}`;
      msg.style.display = 'block';
      return;
    }
    if(data && data.ok){
      statusEl.textContent = 'Sent to PrimeHome Buyers successfully.';
      statusEl.style.color = 'var(--focus)';
      statusEl.style.display = 'block';
      logActivity('lead.ispeedtolead_send', 'lead', ispeedtoleadModalLead.id, `Sent to PrimeHome Buyers — ${ispeedtoleadModalLead.seller_investor_name || ispeedtoleadModalLead.id}`);
      // v130: close the exact gap that caused leads to go permanently
      // invisible in this view (see that changelog) — a successful send
      // through THIS button now always leaves the lead correctly tagged,
      // even if it somehow reached this point without one (e.g. it was
      // only visible because of the v130 "has send history" fallback in
      // isPrimeHomeBuyersLead, not because it was already tagged).
      // Doesn't touch a lead that already has a real, different campaign
      // — same "never silently relabel" rule the CSV import already
      // follows.
      if(!ispeedtoleadModalLead.submission_form_id){
        const defaultFormId = await getIspdDefaultCampaignFormId();
        if(defaultFormId){
          const { error: tagErr } = await sb.from('leads').update({ submission_form_id: defaultFormId }).eq('id', ispeedtoleadModalLead.id);
          if(tagErr) console.error('Failed to auto-tag lead with PrimeHome Buyers campaign after send', tagErr);
          else ispeedtoleadModalLead.submission_form_id = defaultFormId;
        }
      }
      await refreshIspeedToLeadModalStatus(ispeedtoleadModalLead.id);
      // v: the Lead Reviewing table used to only reflect a send once the
      // full loadLeads() reload finished (a many-query, multi-second fetch
      // covering the org's entire lead history) — so right after sending,
      // the "Not sent" filter/stat cards still showed the lead as unsent
      // until someone waited it out or clicked the (equally slow) Refresh
      // button. loadLeads() itself just rebuilds
      // leadsIspeedtoleadSendByLeadId/leadsPrimehomeSendByLeadId from this
      // exact ispeedtolead_submissions row anyway, so patch both maps with
      // it directly and re-render now — instant, no round trip — then let
      // loadLeads() run in the background (not awaited) purely to
      // reconcile anything else that changed server-side meanwhile.
      const optimisticSend = { lead_id: ispeedtoleadModalLead.id, success: true, created_at: new Date().toISOString(), submitted_by: myUserId, error: null, channel: 'primehome' };
      leadsIspeedtoleadSendByLeadId[ispeedtoleadModalLead.id] = optimisticSend;
      leadsPrimehomeSendByLeadId[ispeedtoleadModalLead.id] = optimisticSend;
      renderIspdReviewTable();
      loadLeads();
    } else {
      msg.textContent = (data && data.error) || (error && error.message) || 'Failed to send — check the function logs.';
      msg.style.display = 'block';
    }
  } catch(e){
    msg.textContent = e.message || 'Failed to send.';
    msg.style.display = 'block';
  } finally {
    sendBtn.disabled = false;
    sendBtn.textContent = 'Send to PrimeHome Buyers';
  }
});

// v466: "Send to gyhomes" — separate modal/flow from the PrimeHome Buyers
// one above, see this file's own comment on the modal HTML and
// ispeedtolead-gyhomes-submit's header comment for the full picture.
// v469: no longer collects a fresh screenshot upload -- gyhomesScreenshotUrl
// is now derived straight from this lead's own extra_fields.ping_id (the
// same attachment already required/uploaded in the Send to PrimeHome
// Buyers modal, per request) the moment this modal opens, same "reuse
// what's already on the lead" reasoning ispeedtolead-gyhomes-submit's own
// backend already applies to record_link (the call recording) -- see that
// function's header comment, step 2.
let gyhomesModalLead = null;
let gyhomesScreenshotUrl = null; // derived from lead.extra_fields.ping_id, see above
let gyhomesRecordLinkUrl = null; // derived from lead.extra_fields.record_link, see below
async function openGyhomesModal(lead, agentLabel){
  gyhomesModalLead = lead;
  $('gyhomesModalLeadId').value = lead.id;
  $('gyhomesModalSellerLabel').textContent = `${lead.seller_investor_name || 'Unnamed seller'} — ${lead.seller_phone || 'no phone on file'} (agent: ${agentLabel})`;
  gyhomesScreenshotUrl = (lead.extra_fields && lead.extra_fields.ping_id) ? String(lead.extra_fields.ping_id).trim() || null : null;
  const statusEl = $('gyhomesScreenshotStatus');
  if(gyhomesScreenshotUrl){
    statusEl.textContent = gyhomesScreenshotUrl;
    statusEl.style.color = 'var(--text-2)';
  } else {
    statusEl.textContent = 'No Ping ID attachment on this lead yet — add one in Send to PrimeHome Buyers first, then try again.';
    statusEl.style.color = 'var(--danger)';
  }
  gyhomesRecordLinkUrl = (lead.extra_fields && lead.extra_fields.record_link) ? String(lead.extra_fields.record_link).trim() || null : null;
  const recordingStatusEl = $('gyhomesRecordingStatus');
  if(gyhomesRecordLinkUrl){
    recordingStatusEl.textContent = gyhomesRecordLinkUrl;
    recordingStatusEl.style.color = 'var(--text-2)';
  } else {
    recordingStatusEl.textContent = 'No call recording attached to this lead yet — add one in Send to PrimeHome Buyers first, then try again.';
    recordingStatusEl.style.color = 'var(--danger)';
  }
  $('gyhomesModalMsg').style.display = 'none';
  $('gyhomesModalStatus').style.display = 'none';
  $('gyhomesCheckAiBtn').style.display = 'none';
  $('gyhomesFeedbackReview').style.display = 'none';
  $('gyhomesAiWarning').style.display = 'none';
  $('gyhomesAiMsg').style.display = 'none';
  $('gyhomesAiResults').style.display = 'none';
  $('gyhomesAiMatchFlags').innerHTML = '';
  $('gyhomesAiOnlyFields').innerHTML = '';
  // BUG FIX (user request, 2026-09): fresh state per lead -- the previous
  // lead's selected values/notes must never bleed into this one.
  gyhomesMandatoryState = {};
  GYHOMES_REVIEW_FIELDS.forEach(({ field }) => { gyhomesMandatoryState[field] = { value: null, note: '', known: null, ai: null }; });
  renderGyhomesMandatoryChecklist();
  await refreshGyhomesModalHistory(lead.id);
  // v510: restores the last saved review for THIS lead, if any -- must run
  // after the resets above so it never gets clobbered by them.
  await loadGyhomesFeedbackCache(lead.id);
  // BUG FIX (user request, 2026-09): the Known/AI-heard context for each
  // mandatory question used to only ever populate as a SIDE EFFECT of
  // clicking Check AI Analysis, which itself used to be hidden until staff
  // typed feedback -- so the checklist had nothing to confirm against until
  // staff had already guessed. Fetches it immediately on open instead (a
  // fast, feedback-less call — see gyhomes-ai-analysis's own branching) so
  // every row already shows what's known and what gyhomes heard before
  // anyone types anything.
  await loadGyhomesComparison(lead.id);
  $('gyhomesModalOverlay').classList.add('active');
}
function closeGyhomesModal(){
  $('gyhomesModalOverlay').classList.remove('active');
  gyhomesModalLead = null;
  gyhomesScreenshotUrl = null;
  gyhomesRecordLinkUrl = null;
}
$('gyhomesModalCancelBtn').addEventListener('click', closeGyhomesModal);
$('gyhomesModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'gyhomesModalOverlay') closeGyhomesModal(); });

// AI Analysis Check — added 2026-08-15 per explicit request, to compare
// gyhomes' AI-extracted call-qualification fields against this lead's own
// already-known values (same field names, e.g. form_owner/form_repairs —
// no translation needed). IMPORTANT: gyhomes' own AI-analysis endpoint
// isn't scoped to a specific submission (confirmed live against the real
// site) -- it's the site's single "most recently processed" result,
// shared across every visitor. If another lead was sent to gyhomes around
// the same time, this could show a different lead's analysis. Per
// explicit decision: always show the comparison anyway, with the
// persistent warning banner above, rather than hide it behind a gate that
// could itself be wrong.
// BUG FIX (user request, 2026-09): replaces the plain Covered/Not-covered
// toggle with the REAL option set for each field -- the first 8 are copied
// verbatim from ISPEEDTOLEAD_FIELD_GROUPS (the actual PrimeHome Buyers
// submission form's own `options` arrays, same fields agents pick these
// answers from when submitting), so staff select from the exact same
// choices, not a re-typed approximation. comparable:true marks the fields
// that also have a "known" value on our own side to show alongside gyhomes'
// AI-heard one (see COMPARABLE_FIELDS ~line 29157 for where these are
// defined upstream).
// The remaining 9 (comparable:false) are gyhomes' own AI-derived
// qualification fields -- there's no submission-form equivalent for these
// (nothing asks an agent to pick them), so gyhomes has never published a
// fixed option set for them either. These lists are a best-effort,
// real-estate-appropriate set of mutually exclusive categories, not lifted
// from an authoritative source the way the first 8 are -- revisit if a
// real gyhomes AI-heard value routinely doesn't match any option here.
const GYHOMES_REVIEW_FIELDS = [
  { field: 'form_owner', label: 'Owner status', comparable: true, options: ['Yes, i own this property', 'Agent/wholesaler'] },
  { field: 'form_occupied', label: 'Occupancy', comparable: true, options: ['Owner Occupied', 'Tenant Occupied', 'No its Vacant'] },
  { field: 'form_repairs', label: 'Repairs needed', comparable: true, options: ['Full Gut Renovation - Everything', 'Remodel - Kitchen, Bathroom, Roof', 'Cosmetic - Flooring, Paint', 'Fully renovated and updated in past 2 years'] },
  { field: 'form_owned_years', label: 'Years owned', comparable: true, options: ['0-1', '2-5', '6-9', '10-14', '15-19', '20-29', '30-50', '50+'] },
  { field: 'form_listed', label: 'Currently listed', comparable: true, options: ["Yes it's listed", "No it's not listed"] },
  { field: 'form_multifamily', label: 'Property type', comparable: true, options: ['Ranch', '2-story', 'Mobile home owned land', 'Mobile home rented land', 'Multifamily', 'Single family', 'Bungalow', 'Cottage', 'Townhouse', 'Condominium', 'Duplex', 'Farmhouse', 'Split-level home', 'Land'] },
  { field: 'form_goal', label: 'Goal', comparable: true, options: ['Preforeclosure', 'Emergency Reasons', 'Financial Reasons', 'Selling a vacant/non-occupied property', 'Sell and rent instead', 'Death in the family', 'Sell without showings', 'Inherited Property', 'Downsizing', 'Tired of being a landlord', 'Moving closer to family', 'Relocating', 'Retirement elsewhere', 'Upgrading', 'Moving from United States', 'Behind on taxes/mortgage', 'Old age', 'Divorce', 'Health issues', 'Job loss', 'Other personal reason'] },
  { field: 'form_sell_fast', label: 'Timeline to sell', comparable: true, options: ['ASAP', '1 month', '2-3 months', '4-5 months', '6+ months'] },
  { field: 'form_decision_authority', label: 'Decision authority', comparable: false, options: ['Sole owner - full authority', 'Multiple owners - need consensus', 'Not the owner - no authority', 'Power of attorney / estate representative', 'Unclear / not discussed'] },
  { field: 'form_mortgage_status', label: 'Mortgage status', comparable: false, options: ['No mortgage - owned free and clear', 'Has a mortgage - current on payments', 'Has a mortgage - behind on payments', 'Unclear / not discussed'] },
  { field: 'form_previous_listing', label: 'Previous listing', comparable: false, options: ['Never listed before', 'Previously listed, expired/withdrawn', 'Currently listed elsewhere', 'Unclear / not discussed'] },
  { field: 'form_motivation_indicator', label: 'Motivation', comparable: false, options: ['High - urgent need to sell', 'Medium - open but not urgent', 'Low - just curious/testing the market', 'None - not motivated to sell', 'Unclear / not discussed'] },
  { field: 'form_price_expectation', label: 'Price expectation', comparable: false, options: ['At or below market value', 'Near market value', 'Above market value', 'Firm/non-negotiable price', 'No price given'] },
  { field: 'form_cash_offer_interest', label: 'Cash offer interest', comparable: false, options: ['Open to a cash offer', 'Wants full retail/financed offer only', 'Undecided', 'Not discussed'] },
  { field: 'form_showing_preference', label: 'Showing preference', comparable: false, options: ['Open to showings', 'Wants to sell without showings', 'Limited availability for showings', 'Not discussed'] },
  { field: 'form_seller_flexibility', label: 'Seller flexibility', comparable: false, options: ['Flexible on price/terms', 'Somewhat flexible', 'Firm/inflexible', 'Not discussed'] },
  { field: 'form_recording_disclosure', label: 'Recording disclosure', comparable: false, options: ['Disclosed and consented', 'Disclosed, no clear consent', 'No disclosure given', 'Not discussed'] },
];
const GYHOMES_REVIEW_FIELD_BY_KEY = Object.fromEntries(GYHOMES_REVIEW_FIELDS.map(f => [f.field, f]));
// Everything gyhomes can return that ISN'T one of the 17 reviewable fields
// above -- purely informational scheduling metadata, not a qualification
// question, so it stays a plain read-only display rather than something
// staff confirm.
const GYHOMES_AI_ONLY_FIELD_LABELS = {
  form_best_callback_time: 'Best callback time',
  form_followup_date: 'Follow-up date',
};

// Per field: { value: string|null, note, known, ai } -- value/note are
// staff-entered ground truth (or restored from the last saved review),
// known/ai are read-only context filled in by loadGyhomesComparison().
// Reset to a fresh object per field every time the modal opens (see
// openGyhomesModal).
let gyhomesMandatoryState = {};

// "Provided feedback" (per the explicit request: the Submit button only
// appears once ALL of them have been addressed) means every field has a
// selected value -- a note alone, with nothing selected, isn't a complete
// answer to "what did the call actually show for this field?".
function gyhomesAllFieldsAddressed(){
  return GYHOMES_REVIEW_FIELDS.every(f => gyhomesMandatoryState[f.field] && gyhomesMandatoryState[f.field].value);
}
function updateGyhomesSubmitVisibility(){
  $('gyhomesCheckAiBtn').style.display = gyhomesAllFieldsAddressed() ? 'inline-block' : 'none';
}
function renderGyhomesMandatoryChecklist(){
  const container = $('gyhomesMandatoryChecklist');
  container.innerHTML = GYHOMES_REVIEW_FIELDS.map(({ field, label, comparable, options }) => {
    const s = gyhomesMandatoryState[field] || (gyhomesMandatoryState[field] = { value: null, note: '', known: null, ai: null });
    const contextBits = [];
    if(comparable) contextBits.push(`Known: ${s.known ? escapeHtml(s.known) : '<span style="color:var(--text-dim);">—</span>'}`);
    contextBits.push(`AI heard: ${s.ai ? escapeHtml(s.ai) : '<span style="color:var(--text-dim);">—</span>'}`);
    // gyhomes' own AI-heard value isn't guaranteed to be one of this
    // field's known options (especially for the 9 non-comparable fields,
    // where the option list is our own best-effort guess, not an
    // authoritative gyhomes enum) -- offered as an extra selectable option
    // rather than silently dropped, so staff can still pick "what the AI
    // said" as their answer when it's accurate.
    const optionList = (s.ai && !options.includes(s.ai)) ? [...options, s.ai] : options;
    const optionsHtml = optionList.map(o => `<option value="${escapeHtml(o)}"${s.value === o ? ' selected' : ''}>${escapeHtml(o)}</option>`).join('');
    return `
      <div class="gyhomes-mandatory-row" style="border:1px solid var(--border-light); border-radius:6px; padding:8px 10px; margin-bottom:8px;">
        <div style="font-size:12px; font-weight:600;">${escapeHtml(label)}</div>
        <div style="font-size:10px; color:var(--text-dim); margin:2px 0 6px;">${contextBits.join(' &nbsp;·&nbsp; ')}</div>
        <select class="gyhomes-value-select" data-field="${field}" style="width:100%; font-size:11px;">
          <option value=""${s.value ? '' : ' selected'}>— Select what the call actually showed —</option>
          ${optionsHtml}
        </select>
        <textarea class="gyhomes-note-input" data-field="${field}" rows="1" placeholder="Optional note — anything that needs explaining beyond the selected option" style="margin-top:6px; font-size:11px; width:100%;">${escapeHtml(s.note || '')}</textarea>
      </div>
    `;
  }).join('');
  container.querySelectorAll('.gyhomes-value-select').forEach(sel => {
    sel.addEventListener('change', () => {
      gyhomesMandatoryState[sel.dataset.field].value = sel.value || null;
      updateGyhomesSubmitVisibility();
    });
  });
  container.querySelectorAll('.gyhomes-note-input').forEach(ta => {
    ta.addEventListener('input', () => { gyhomesMandatoryState[ta.dataset.field].note = ta.value; });
  });
}

// Applies a {comparisons, ai, address_match, phone_match} result (the same
// shape gyhomes-ai-analysis always returns, feedback or not) to the
// checklist's known/ai context, the match-flags line, and the AI-only
// fields list -- shared by the initial no-feedback load and the Submit
// Review response, so both render identically.
function applyGyhomesComparisonResult(result){
  (result.comparisons || []).forEach(c => {
    if(!gyhomesMandatoryState[c.field]) return;
    gyhomesMandatoryState[c.field].known = c.known || null;
    gyhomesMandatoryState[c.field].ai = c.ai || null;
  });
  // The 9 non-comparable fields have no `comparisons` entry (that array is
  // scoped to COMPARABLE_FIELDS server-side) -- their AI-heard value only
  // ever comes from `result.ai` directly.
  GYHOMES_REVIEW_FIELDS.filter(f => !f.comparable).forEach(({ field }) => {
    if(!gyhomesMandatoryState[field]) return;
    const raw = result.ai && result.ai[field];
    gyhomesMandatoryState[field].ai = (raw === undefined || raw === null || raw === false) ? null : (Array.isArray(raw) ? raw.join(', ') : String(raw));
  });
  renderGyhomesMandatoryChecklist();
  $('gyhomesAiMatchFlags').innerHTML = `
    <span style="color:${result.address_match ? 'var(--good)' : 'var(--danger)'};">Address match: ${result.address_match ? 'yes' : 'no'}</span>
    &nbsp;·&nbsp;
    <span style="color:${result.phone_match ? 'var(--good)' : 'var(--danger)'};">Phone match: ${result.phone_match ? 'yes' : 'no'}</span>
    ${result.updated ? `&nbsp;·&nbsp;<span style="color:var(--text-dim);">Analysis updated: ${escapeHtml(result.updated)}</span>` : ''}
  `;
  const aiOnlyEl = $('gyhomesAiOnlyFields');
  const aiOnlyLines = Object.entries(GYHOMES_AI_ONLY_FIELD_LABELS)
    .filter(([key]) => result.ai && result.ai[key] !== undefined && result.ai[key] !== null && result.ai[key] !== false)
    .map(([key, label]) => {
      const v = Array.isArray(result.ai[key]) ? result.ai[key].join(', ') : String(result.ai[key]);
      return `<div>${escapeHtml(label)}: ${escapeHtml(v)}</div>`;
    });
  aiOnlyEl.innerHTML = aiOnlyLines.join('') || '<div style="color:var(--text-dim);">None returned.</div>';
  $('gyhomesAiWarning').style.display = 'block';
}
// Fast, feedback-less call (see gyhomes-ai-analysis: skips transcription/
// Gemini entirely without field_feedback) -- just fetches gyhomes' current
// comparison so the checklist has Known/AI-heard context before anyone
// fills in a single field.
async function loadGyhomesComparison(leadId){
  const { data, error } = await sb.functions.invoke('gyhomes-ai-analysis', { body: { lead_id: leadId } });
  if(error || !data || !data.ok) return; // non-fatal -- checklist still works with blank context
  applyGyhomesComparisonResult(data);
}

// v509/v510: renders a feedback_review object (mandatory_check/
// missed_in_feedback/summary/note, see gyhomes-ai-analysis's
// buildFeedbackReview()) into gyhomesFeedbackReview -- shared by the live
// Submit Review click handler below AND loadGyhomesFeedbackCache() (loads
// the most recently saved review on modal open), so the two never drift
// into rendering the same shape two different ways. Pass null/undefined to
// hide the panel.
function renderGyhomesFeedbackReview(fr){
  const reviewEl = $('gyhomesFeedbackReview');
  if(!fr){ reviewEl.style.display = 'none'; return; }
  const missedItems = (fr.missed_in_feedback || []).map(item => `<li>${escapeHtml(item)}</li>`).join('');
  const answerRows = (fr.mandatory_check || []).map(m => `
    <div style="margin-bottom:2px;">
      <span style="color:var(--text-2);">${escapeHtml(m.label)}:</span> ${escapeHtml(m.value || '—')}${m.note ? ` — ${escapeHtml(m.note)}` : ''}
    </div>
  `).join('');
  reviewEl.innerHTML = `
    <div class="mono" style="font-size:10px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;">Review</div>
    ${fr.summary ? `<div style="margin-bottom:8px;">${escapeHtml(fr.summary)}</div>` : ''}
    ${answerRows ? `<div style="margin-bottom:8px;"><b>Confirmed answers:</b>${answerRows}</div>` : ''}
    ${missedItems ? `<div><b>Possible gaps vs. the call recording:</b><ul style="margin:4px 0 0; padding-left:18px;">${missedItems}</ul></div>` : '<div style="color:var(--text-dim);">Nothing flagged — your answers line up with the call recording/AI analysis.</div>'}
    ${fr.note ? `<div style="margin-top:8px; color:var(--text-dim);">${escapeHtml(fr.note)}</div>` : ''}
  `;
  reviewEl.style.display = 'block';
}

// v510: loads the most recently saved review for this lead
// (gyhomes_feedback_reviews, populated by gyhomes-ai-analysis on every
// Submit Review click) so it isn't lost when the modal is closed and
// reopened -- restores each field's selected value/note from
// review.mandatory_check and renders the last summary/gaps straight away
// without another Gemini call. Staff can still change any field and
// re-submit any time -- this only restores what was already there, never
// blocks a fresh submit.
async function loadGyhomesFeedbackCache(leadId){
  const { data, error } = await sb.from('gyhomes_feedback_reviews')
    .select('review, created_at')
    .eq('lead_id', leadId)
    .order('created_at', { ascending: false })
    .limit(1)
    .maybeSingle();
  if(error || !data || !data.review) return;
  (data.review.mandatory_check || []).forEach(m => {
    if(!gyhomesMandatoryState[m.field]) return;
    gyhomesMandatoryState[m.field].value = m.value || null;
    gyhomesMandatoryState[m.field].note = m.note || '';
  });
  renderGyhomesMandatoryChecklist();
  updateGyhomesSubmitVisibility();
  $('gyhomesAiResults').style.display = 'block';
  renderGyhomesFeedbackReview(data.review);
}
$('gyhomesCheckAiBtn').addEventListener('click', async () => {
  if(!gyhomesModalLead) return;
  const btn = $('gyhomesCheckAiBtn');
  const msg = $('gyhomesAiMsg');
  const results = $('gyhomesAiResults');
  msg.style.display = 'none';
  results.style.display = 'none';
  btn.disabled = true;
  btn.textContent = 'Submitting…';
  try {
    const fieldFeedback = GYHOMES_REVIEW_FIELDS.map(({ field, label }) => ({
      field, label, value: gyhomesMandatoryState[field].value || null, note: (gyhomesMandatoryState[field].note || '').trim() || null,
    }));
    const { data, error } = await sb.functions.invoke('gyhomes-ai-analysis', { body: { lead_id: gyhomesModalLead.id, field_feedback: fieldFeedback } });
    let result = data;
    if(error && error.context && typeof error.context.json === 'function'){
      try { result = await error.context.json(); } catch(_e) { /* fall through */ }
    }
    if(!result || !result.ok){
      msg.textContent = (result && result.error) || (error && error.message) || 'Failed to submit review.';
      msg.style.display = 'block';
      return;
    }
    applyGyhomesComparisonResult(result);
    renderGyhomesFeedbackReview(result.feedback_review);
    results.style.display = 'block';
  } catch(e){
    msg.textContent = e.message || 'Failed to submit review.';
    msg.style.display = 'block';
  } finally {
    btn.disabled = false;
    btn.textContent = 'Submit Review';
  }
});

async function refreshGyhomesModalHistory(leadId){
  const { data: history } = await sb.from('ispeedtolead_submissions')
    .select('id, success, created_at, error, response_status, submitted_by')
    .eq('lead_id', leadId).eq('channel', 'gyhomes').order('created_at', { ascending: false }).limit(20);
  await renderGyhomesHistory(history || []);
}
// Same rendering shape as renderIspeedToLeadHistory (kept as its own copy,
// not a shared function, targeting gyhomesModalHistory specifically —
// same "small enough, scoped enough" reasoning as the original).
async function renderGyhomesHistory(rows){
  const box = $('gyhomesModalHistory');
  if(!box) return;
  if(!rows.length){
    box.innerHTML = '<div style="font-size:11px; color:var(--text-dim);">No send attempts yet.</div>';
    return;
  }
  const submitterIds = [...new Set(rows.map(r => r.submitted_by).filter(Boolean))];
  let nameById = {};
  if(submitterIds.length){
    const { data: submitters } = await sb.from('profiles').select('id, full_name, email').in('id', submitterIds);
    (submitters || []).forEach(p => { nameById[p.id] = p.full_name || p.email || 'Unknown'; });
  }
  const historyTz = nonAgentDisplayTz();
  box.innerHTML = rows.map(r => {
    const when = new Date(r.created_at).toLocaleString([], { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', ...(historyTz ? { timeZone: historyTz } : {}) });
    const who = r.submitted_by ? (nameById[r.submitted_by] || 'Unknown') : null;
    const statusLabel = r.success
      ? '<span style="color:var(--good);">Success</span>'
      : `<span style="color:var(--danger);">Failed${r.response_status ? ' (' + r.response_status + ')' : ''}</span>`;
    // Defensive: a handful of pre-2026-08-15 rows stored a non-string
    // error (an object) before this function always guaranteed a string --
    // coerce so old rows render readable text instead of "[object Object]".
    const errText = (!r.success && r.error) ? (typeof r.error === 'string' ? r.error : JSON.stringify(r.error)) : '';
    const errLine = errText ? `<div style="font-size:10px; color:var(--text-dim); margin-top:2px;">${escapeHtml(errText)}</div>` : '';
    return `
      <div style="display:flex; justify-content:space-between; gap:10px; padding:6px 0; border-bottom:1px solid var(--border); font-size:11px;">
        <div>
          <div>${statusLabel}${who ? ' · ' + escapeHtml(who) : ''}</div>
          ${errLine}
        </div>
        <div class="mono" style="color:var(--text-dim); white-space:nowrap;">${when}</div>
      </div>
    `;
  }).join('');
}

$('gyhomesModalSendBtn').addEventListener('click', async () => {
  if(!gyhomesModalLead) return;
  const msg = $('gyhomesModalMsg');
  const statusEl = $('gyhomesModalStatus');
  msg.style.display = 'none';
  statusEl.style.display = 'none';
  const missingAttachments = [];
  if(!gyhomesRecordLinkUrl) missingAttachments.push('call recording');
  if(!gyhomesScreenshotUrl) missingAttachments.push('Ping ID attachment');
  if(missingAttachments.length){
    msg.textContent = `This lead is missing its ${missingAttachments.join(' and ')} — add ${missingAttachments.length > 1 ? 'them' : 'it'} in Send to PrimeHome Buyers first, then try again.`;
    msg.style.display = 'block';
    return;
  }
  // BUG FIX (2026-09-08): gyhomes' field 127 is an IMAGE upload. A lead
  // whose Ping ID is an .mp3 (140 of them exist -- an agent picking the
  // recording twice, see ISPEEDTOLEAD_ATTACHMENT_FIELDS) got all the way
  // to the backend and came back with either "File type is not allowed"
  // or, worse, WPForms' generic "This field is required" on BOTH upload
  // fields -- neither of which tells anyone what to actually fix. Catch it
  // here and say the real thing.
  if(!ispdPingIdLooksLikeImage(gyhomesScreenshotUrl)){
    msg.textContent = "This lead's Ping ID attachment is not an image — gyhomes only accepts a screenshot there, so the send would be rejected. It looks like the call recording was attached twice. Replace the Ping ID with the dialer screenshot in Send to PrimeHome Buyers, then try again.";
    msg.style.display = 'block';
    return;
  }
  const sendBtn = $('gyhomesModalSendBtn');
  sendBtn.disabled = true;
  sendBtn.textContent = 'Sending…';
  try {
    let { data, error } = await sb.functions.invoke('ispeedtolead-gyhomes-submit', { body: { lead_id: gyhomesModalLead.id, screenshot_url: gyhomesScreenshotUrl } });
    if(error && error.context && typeof error.context.json === 'function'){
      try { data = await error.context.json(); } catch(_e) { /* fall through to generic message */ }
    }
    // v471: double-send guard — same confirm/force-resend flow as the
    // PrimeHome Buyers send button, scoped to the gyhomes channel.
    if(data && data.already_sent){
      const resend = confirm('This lead was already sent successfully to gyhomes. Send it again anyway?');
      if(!resend){ statusEl.textContent = 'Not resent.'; statusEl.style.display = 'block'; return; }
      sendBtn.textContent = 'Sending…';
      ({ data, error } = await sb.functions.invoke('ispeedtolead-gyhomes-submit', { body: { lead_id: gyhomesModalLead.id, screenshot_url: gyhomesScreenshotUrl, force: true } }));
      if(error && error.context && typeof error.context.json === 'function'){
        try { data = await error.context.json(); } catch(_e) { /* fall through */ }
      }
    }
    // BUG FIX (user request, 2026-09-04) — see ispeedtoleadModalSendBtn's
    // own copy of this same check for the full "why": duplicate phone
    // sends are iSpeedToLead's #1 rejection cause by a wide margin.
    if(data && data.duplicate_phone){
      const when = data.previous?.created_at ? new Date(data.previous.created_at).toLocaleString() : 'a previous date';
      const via = data.previous?.channel === 'gyhomes' ? 'gyhomes' : 'PrimeHome Buyers';
      // BUG FIX (user question, 2026-09-04 — "what if the seller has another
      // address in different state"): a bare phone match on its own doesn't
      // tell you whether this is the same property or a seller's genuinely
      // separate second one elsewhere — show both addresses so whoever's
      // confirming can tell at a glance, same reasoning as
      // findPrimeHomeBuyersDuplicate's own submission-time fix.
      const priorAddr = data.previous?.address;
      const addrNote = data.same_address
        ? `\n\nSame address on file for both — this looks like the same property.`
        : (priorAddr ? `\n\nThat prior lead's address: ${priorAddr}\nThis lead's address: ${data.this_address || 'not set'}\n\nIf that's a different property, this is probably fine to send.` : '');
      const resend = confirm(`This seller's phone number was already sent to iSpeedToLead as a DIFFERENT lead (via ${via}) on ${when}. This is the #1 cause of rejections.${addrNote}\n\nSend anyway?`);
      if(!resend){ statusEl.textContent = 'Not sent.'; statusEl.style.display = 'block'; return; }
      sendBtn.textContent = 'Sending…';
      ({ data, error } = await sb.functions.invoke('ispeedtolead-gyhomes-submit', { body: { lead_id: gyhomesModalLead.id, screenshot_url: gyhomesScreenshotUrl, force: true } }));
      if(error && error.context && typeof error.context.json === 'function'){
        try { data = await error.context.json(); } catch(_e) { /* fall through */ }
      }
    }
    if(data && data.missing_fields && data.missing_fields.length){
      msg.textContent = `Fill in (via Send to PrimeHome Buyers' details panel) before sending: ${data.missing_fields.join(', ')}`;
      msg.style.display = 'block';
      return;
    }
    if(data && data.ok){
      // v: surfaces resolveRealRecordingUrl()'s own warning (ispeedtolead-
      // gyhomes-submit) when record_link pointed at the "Combined page"
      // summary instead of a single recording file -- the send still went
      // through (the backend auto-resolved to a real file), but staff
      // should know the field itself is worth fixing for next time.
      statusEl.textContent = data.warning ? `Sent to gyhomes successfully. ${data.warning}` : 'Sent to gyhomes successfully.';
      statusEl.style.color = 'var(--focus)';
      statusEl.style.display = 'block';
      logActivity('lead.gyhomes_send', 'lead', gyhomesModalLead.id, `Sent to gyhomes — ${gyhomesModalLead.seller_investor_name || gyhomesModalLead.id}${data.warning ? ' (record_link was Combined page, auto-resolved)' : ''}`);
      await refreshGyhomesModalHistory(gyhomesModalLead.id);
      // v: same instant-update fix as the PrimeHome Buyers send button
      // above — this used to never touch leadsIspeedtoleadSendByLeadId/
      // leadsGyhomesSendByLeadId at all, so the Lead Reviewing table's
      // "Sent via"/"Not sent" filters and stat cards stayed stale until
      // the next full loadLeads() (only triggered by a manual, slow
      // Refresh click). Patch both maps locally and re-render now; run
      // loadLeads() in the background afterward purely to reconcile.
      const optimisticSend = { lead_id: gyhomesModalLead.id, success: true, created_at: new Date().toISOString(), submitted_by: myUserId, error: null, channel: 'gyhomes' };
      leadsIspeedtoleadSendByLeadId[gyhomesModalLead.id] = optimisticSend;
      leadsGyhomesSendByLeadId[gyhomesModalLead.id] = optimisticSend;
      renderIspdReviewTable();
      loadLeads();
    } else {
      // Defensive: data.error should always be a string per the backend's
      // own contract, but coerce anyway rather than ever risk rendering
      // "[object Object]" if that ever drifts.
      const rawMsg = (data && data.error) || (error && error.message) || 'Failed to send — check the function logs.';
      msg.textContent = typeof rawMsg === 'string' ? rawMsg : JSON.stringify(rawMsg);
      msg.style.display = 'block';
      // BUG FIX: the history panel was refreshed ONLY on success, so a
      // failed send left it reading "No send attempts yet" even though the
      // backend had just recorded the failed attempt in
      // ispeedtolead_submissions. That is precisely when someone is
      // looking at this panel — a lead with three failures could show a
      // scary error above an empty history, making it look like nothing
      // had ever been tried. Refresh here too.
      await refreshGyhomesModalHistory(gyhomesModalLead.id);
    }
  } catch(e){
    msg.textContent = e.message || 'Failed to send.';
    msg.style.display = 'block';
  } finally {
    sendBtn.disabled = false;
    sendBtn.textContent = 'Send to gyhomes';
  }
});

$('leadsExportCsvBtn').addEventListener('click', () => {
  if(!(myIsOwner || myRole === 'admin')) return; // v96 item 4
  const headers = ['User', 'Submitted at', 'Leads', 'Seller Name', 'Phone', 'Extra fields', 'Campaign Name', 'Type', 'Status', 'Rejected reason', 'Set via', 'PrimeHome Buyers send status'];
  const rows = lastLeadsRows.map(r => [r.agent, r.submitted, r.count, r.sellerInvestor, r.phone || '', r.extraFieldsText || '', r.task, r.type, r.status, r.rejectReason || '', r.viaIspeedtolead || '', r.ispeedtoleadSendStatus || '']);
  const fromVal = $('leadsFromDateInput').value;
  const toVal = $('leadsToDateInput').value || fromVal;
  // v217: no range picked = full history, matching leadsRangeLabel().
  const rangeSuffix = !fromVal && !toVal ? 'all-time' : (fromVal === toVal ? fromVal : `${fromVal || 'start'}_to_${toVal || 'now'}`);
  exportCSV(`leads-${rangeSuffix}.csv`, headers, rows);
  logActivity('export.leads_csv', null, null, `Exported leads CSV (${rows.length} entries)`);
});

function renderSites(visits){
  const totals = {};
  visits.forEach(v => {
    const end = v.end_time ? new Date(v.end_time).getTime() : Date.now();
    const dur = (end - new Date(v.start_time).getTime()) / 1000;
    const key = v.domain || '(unknown)';
    totals[key] = (totals[key] || 0) + dur;
  });
  const rows = Object.entries(totals).sort((a,b) => b[1]-a[1]).slice(0, 12);
  const list = $('sitesList');
  list.innerHTML = '';
  if(rows.length === 0){
    list.innerHTML = '<div class="empty">No site activity logged yet today.</div>';
    return;
  }
  const maxSec = rows[0][1];
  rows.forEach(([domain, sec]) => {
    const row = document.createElement('div');
    row.className = 'site-row';
    row.innerHTML = `
      <div class="site-domain" title="${escapeHtml(domain)}">${escapeHtml(domain)}</div>
      <div class="site-bar-track"><div class="site-bar-fill" style="width:${Math.max(2, sec/maxSec*100)}%"></div></div>
      <div class="site-time">${fmtShort(sec)}</div>
    `;
    list.appendChild(row);
  });
}

function detailSetTitleDept(agent){
  const el = $('detailTitleDept');
  if(!el) return;
  const line = [agent && agent.title, agent && agent.department].filter(Boolean).join(' · ');
  el.textContent = line;
  el.style.display = line ? 'block' : 'none';
}
async function openDetail(agent, { fromUsersTab = false } = {}){
  currentDetailAgent = agent;
  $('teamCard').style.display = 'none';
  $('detailPanel').style.display = 'block';
  $('detailName').textContent = agent.full_name || agent.email;
  detailSetTitleDept(agent); // v639
  $('acctFullName').value = agent.full_name || '';
  await refreshAcctRoleOptions(agent.role);
  $('acctEmailInput').value = agent.email || '';
  $('acctTitle').value = agent.title || '';           // v643
  $('acctGrade').value = agent.grade || '';           // v643
  $('acctAmericanName').value = agent.american_name || '';   // v727
  await fillDepartmentSelect('acctDepartment', agent.department); // v643
  $('acctNewPassword').value = '';
  $('acctMsg').textContent = '';
  $('acctPasswordMsg').textContent = '';
  $('acctStatusMsg').textContent = '';
  renderAcctStatus(agent);
  // A role without can_manage_users (e.g. a view-only "Supervisor" an
  // Owner might create with Staff-tab access but nothing else) can look
  // at this account card but can't edit/reset/delete it — this is a UI
  // convenience, the roles-table + Edge Function checks are the real
  // enforcement either way.
  // v1.2.19: the Dashboard/Staff tab's detail panel is review-only now —
  // editing an account only happens from User Management > Users
  // (fromUsersTab === true), regardless of the viewer's canManageUsers
  // permission. Owner/Admin included: review here, edit there.
  const canEdit = fromUsersTab && myPermissions.canManageUsers;
  $('acctAmericanName').disabled = !(canEdit && (myIsOwner || myRole === 'admin'));   // v727: set_staff_american_name is Owner/Admin
  ['acctFullName', 'acctRole', 'acctEmailInput', 'acctSaveBtn', 'acctNewPassword', 'acctSetPasswordBtn', 'acctDeleteBtn', 'acctToggleActiveBtn',
   'acctDepartment', 'acctTitle', 'acctGrade'].forEach(id => { // v643
    $(id).disabled = !canEdit;
  });
  // The Owner's role can never change through this tool (see
  // refreshAcctRoleOptions above), so keep the Role field locked even
  // when the viewer otherwise has edit permission. And nobody — not even
  // an Owner looking at their own row — should be able to delete or
  // deactivate their own account from here; there's no recovering from
  // locking yourself out, and the Edge Function rejects it either way.
  const isSelf = agent.id === myUserId;
  if(agent.role === 'owner') $('acctRole').disabled = true;
  $('acctDeleteBtn').style.display = (canEdit && !isSelf) ? 'inline-block' : 'none';
  $('acctToggleActiveBtn').style.display = (canEdit && !isSelf) ? 'inline-block' : 'none';
  await loadSchedule(agent.id);
  await loadAssignedTasks(agent.id);
  await renderDetail(agent);

  // v1.2.5: HR-restricted mode. HR (a custom role, no full user-edit) may
  // open a user but only to review/edit Schedule & limits — the Account
  // card, productivity stats, and task assignment are hidden. Owner/Admin
  // and roles with full user-edit see everything as before.
  const hrOnly = viewerIsHR() && !viewerHasFullUserEdit();
  const accountCard = document.getElementById('detailAccountCard');
  const statsCard = document.getElementById('detailStatsCard');
  const scheduleCard = document.getElementById('detailScheduleCard');
  // v1.2.6: clear any disabled state left over from a previous open (e.g. a
  // prior self view-only open) before re-applying, so an admin opening
  // another user isn't stuck with locked inputs.
  const _dp = document.getElementById('detailPanel') || document.getElementById('tmSection-staff');
  if(_dp){
    _dp.querySelectorAll('#detailAccountCard input, #detailAccountCard select, #detailAccountCard button, #detailScheduleCard input, #detailScheduleCard select, #detailScheduleCard button, #assignedTasksList input, #assignedTasksList select, #assignedTasksList button').forEach(el => { el.disabled = false; });
  }
  if(accountCard) accountCard.style.display = hrOnly ? 'none' : '';
  if(statsCard) statsCard.style.display = hrOnly ? 'none' : '';
  // assigned-tasks list lives inside the account flow; hide its container too.
  // Final visibility (beyond the hrOnly hide here) is decided below once
  // fromUsersTab/viewedHasDashboardAccess are known — see the trackingEls
  // block, which now includes this element.
  const assignedWrap = document.getElementById('assignedTasksList');
  if(scheduleCard){
    // make sure the schedule save button is enabled for HR even though they
    // lack canManageUsers (schedule editing is their explicit remit) — but
    // NOT when they're looking at their own row: HR's write access to
    // `schedules` (see the "hr write access" RLS policy) deliberately
    // excludes editing your own pay/limits, the same conflict-of-interest
    // guard applied to self-view-only for plain users.
    const saveBtn = document.getElementById('saveScheduleBtn');
    if(saveBtn && hrOnly) saveBtn.disabled = isSelf;
    const scheduleMsg = document.getElementById('scheduleMsg');
    if(scheduleMsg){
      if(hrOnly && isSelf){
        scheduleMsg.textContent = 'You can\u2019t edit your own schedule/limits from here — ask an Owner or Admin.';
        scheduleMsg.className = 'msg';
      } else if(scheduleMsg.textContent.startsWith('You can\u2019t edit your own schedule')){
        scheduleMsg.textContent = '';
      }
    }
  }

  // v1.2.6: self view-only. A user without full-edit/HR rights may open THEIR
  // OWN profile, but read-only — every input/select/button in the detail
  // panel is disabled so they can look but not change anything. (Owner/Admin/
  // full-edit and HR keep their normal edit access; this only kicks in for a
  // plain user viewing themselves.)
  const selfViewOnly = agent.id === myUserId && !viewerHasFullUserEdit() && !viewerIsHR();
  const detailPanel = document.getElementById('detailPanel') || document.getElementById('tmSection-staff');
  if(selfViewOnly && detailPanel){
    // everything visible for self, but locked
    if(accountCard) accountCard.style.display = '';
    if(statsCard) statsCard.style.display = '';
    detailPanel.querySelectorAll('#detailAccountCard input, #detailAccountCard select, #detailAccountCard button, #detailScheduleCard input, #detailScheduleCard select, #detailScheduleCard button, #assignedTasksList input, #assignedTasksList select, #assignedTasksList button').forEach(el => {
      el.disabled = true;
    });
    // add a small read-only banner if not already present
    let banner = document.getElementById('selfViewOnlyBanner');
    if(!banner && accountCard){
      banner = document.createElement('div');
      banner.id = 'selfViewOnlyBanner';
      banner.style.cssText = 'background:var(--inset); border:1px solid var(--border); border-radius:8px; padding:8px 12px; margin-bottom:14px; font-size:12px; color:var(--text-2);';
      banner.textContent = 'You\u2019re viewing your own profile. This is read-only \u2014 contact an admin to change anything.';
      accountCard.parentNode.insertBefore(banner, accountCard);
    } else if(banner){
      banner.style.display = '';
    }
  } else {
    const banner = document.getElementById('selfViewOnlyBanner');
    if(banner) banner.style.display = 'none';
  }

  // v1.2.8: hide time-tracking sections entirely for a viewed user whose
  // role has dashboard access (Owner/Admin or any custom role with at
  // least one allowed tab) — Schedule & limits, working days, shift
  // window, the day's timeline, sites visited, and screenshots all relate
  // to the extension's time-tracking flow, which a dashboard-access role
  // doesn't use. A plain agent (no dashboard access at all, empty
  // allowed_tabs) still gets the full tracking view as before.
  //
  // v1.2.9: this ONLY applies when opened from the Dashboard/Staff tab's
  // team list. Opened from User Management > Users, every section shows
  // in full regardless of the viewed user's role/tabs — that sub-tab is
  // meant to be the single place to see and edit a user's complete
  // record, tracking fields included, and to save changes back to it the
  // same way the account/schedule cards already do (same save buttons,
  // same tables — nothing special needed there beyond not hiding them).
  //
  // v1.2.10: Assign Task (assignedTasksList) now follows this exact same
  // rule instead of trying to always stay visible. Previously it carried
  // its own separate "hide for HR" toggle and otherwise relied on the
  // display:none baked into its markup, which nothing ever reset back to
  // visible — so it was stuck hidden everywhere, including here in
  // Users, where it's meant to be viewable/editable. It's included in
  // trackingEls below so it's hidden on the Dashboard/Staff tab for
  // dashboard-access users and fully restored when opened from Users.
  const trackingEls = [
    document.getElementById('detailScheduleCard'),
    document.getElementById('detailTimeline'),
    document.getElementById('sitesList'),
    document.getElementById('shotsGrid'),
    assignedWrap,
  ];
  // the hour-marks row has no id — it's the timeline's axis labels and
  // only makes sense alongside it, so toggle it by its class instead
  const hourMarks = detailPanel ? detailPanel.querySelector('.hour-marks') : null;
  let viewedHasDashboardAccess = false;
  if(fromUsersTab){
    // always fully visible from this entry point — reset anything a prior
    // Dashboard-tab open may have hidden.
    [...trackingEls, hourMarks].forEach(el => { if(el) el.style.display = ''; });
  } else {
    viewedHasDashboardAccess = agent.role === 'owner';
    if(!viewedHasDashboardAccess){
      const { data: viewedRoleRow } = await sb.from('roles').select('allowed_tabs').eq('name', agent.role || '').maybeSingle();
      viewedHasDashboardAccess = Array.isArray(viewedRoleRow?.allowed_tabs) && viewedRoleRow.allowed_tabs.length > 0;
    }
    // detailScheduleCard and assignedTasksList are always-on-or-off (no
    // separate loader decides their visibility), so force them straight
    // to '' here for a non-dashboard-access viewed user. sitesList/shotsGrid
    // are left alone in that case — only force them off when the viewed
    // user has dashboard access; never force them on, that's still up to
    // loadSitesVisited/loadScreenshots.
    // audit fix (audit_chunk5.md #7, Medium): detailTimeline/hourMarks used
    // to be left alone here too (falling into the "no-op, keep whatever
    // display already is" branch) on the same theory as sitesList/
    // shotsGrid — but unlike those two, nothing else in this file ever
    // resets them back to '' once a prior open (for a dashboard-access
    // viewed user, just above) forced them to 'none'. renderDetail() just
    // above has already populated them with this user's real data, so they
    // belong in the always-reset set with scheduleCard/assignedWrap, not
    // left to a loader that doesn't exist for them.
    const alwaysOnEls = new Set([scheduleCard, assignedWrap, document.getElementById('detailTimeline'), hourMarks]);
    [...trackingEls, hourMarks].forEach(el => { if(el) el.style.display = viewedHasDashboardAccess ? 'none' : (alwaysOnEls.has(el) ? '' : el.style.display); });
  }

  // HR-restricted viewers never see task assignment, regardless of entry
  // point or the viewed user's dashboard access — applied last so it wins
  // over both branches above.
  if(assignedWrap && hrOnly) assignedWrap.style.display = 'none';

  // v1.2.19: Dashboard/Staff tab is permanently review-only, applied last
  // so it overrides every rule above (HR mode, self-view, canManageUsers)
  // regardless of role — Owner and Admin included. This view exists to
  // review a user's account/schedule/tasks, not change them; editing only
  // happens from User Management > Users (fromUsersTab === true). The
  // account-card fields are already handled via the canEdit change above;
  // this covers the Schedule & limits and Assign Task fields (tagged
  // class="edit-only", normally gated by canEditTimeManagementSection('staff')
  // instead, v453) and adds a banner explaining where to go to make changes.
  if(!fromUsersTab && detailPanel){
    detailPanel.querySelectorAll('#detailAccountCard input, #detailAccountCard select, #detailAccountCard button, #detailScheduleCard input, #detailScheduleCard select, #detailScheduleCard button, #assignedTasksList input, #assignedTasksList select, #assignedTasksList button').forEach(el => { el.disabled = true; });
    let reviewBanner = document.getElementById('dashboardReviewOnlyBanner');
    if(!reviewBanner && accountCard){
      reviewBanner = document.createElement('div');
      reviewBanner.id = 'dashboardReviewOnlyBanner';
      reviewBanner.style.cssText = 'background:var(--inset); border:1px solid var(--border); border-radius:8px; padding:8px 12px; margin-bottom:14px; font-size:12px; color:var(--text-2);';
      reviewBanner.textContent = 'You\u2019re reviewing this user from the Dashboard \u2014 this view is read-only. To make changes, open them from User Management \u2192 Users.';
      accountCard.parentNode.insertBefore(reviewBanner, accountCard);
    } else if(reviewBanner){
      reviewBanner.style.display = '';
    }
  } else {
    const reviewBanner = document.getElementById('dashboardReviewOnlyBanner');
    if(reviewBanner) reviewBanner.style.display = 'none';
  }
}

// Role names are shown capitalized wherever they appear as a human-facing
// option (Add User modal, account-edit Role dropdown) — no special-casing
// 'agent' anymore, it just reads "Agent" like every other role name does.
function roleDisplayLabel(name){
  return name.charAt(0).toUpperCase() + name.slice(1);
}

async function refreshAcctRoleOptions(currentRole){
  // The Owner's own role is never changeable through this tool — there's
  // exactly one Owner account, and the roles list below always excludes
  // 'owner' as an assignable option. Show it as a fixed, locked option
  // instead of falling through to "not in the list, so default to
  // whatever role happens to sort first" (openDetail locks the <select>
  // itself; this just makes sure its value is right first).
  if(currentRole === 'owner'){
    $('acctRole').innerHTML = `<option value="owner">Owner</option>`;
    $('acctRole').value = 'owner';
    return;
  }
  const { data } = await sb.from('roles').select('name').order('name');
  // Same rule as the Add User modal: Owner is never offered (this tool
  // doesn't mint new Owners, including by promotion), and Admin is
  // Owner-only — both hardcoded by name rather than roles.is_protected,
  // since that flag no longer implies "security-sensitive" for Admin.
  const roles = (data || []).filter(r => r.name !== 'owner' && (myIsOwner || r.name !== 'admin'));
  $('acctRole').innerHTML = roles.map(r => `<option value="${escapeHtml(r.name)}">${escapeHtml(roleDisplayLabel(r.name))}</option>`).join('');
  $('acctRole').value = roles.some(r => r.name === currentRole) ? currentRole : ((roles[0] || {}).name || '');
}

// ---------- v326: List Builder subtab — filter/export the properties
// table (free county-assessor data, e.g. Cook County) and trigger fresh
// pulls. All calls go through staff-list-builder, which hardcodes
// Owner/Admin regardless of role permissions -- see that function's own
// checkOwnerAdminAccess and canViewLeadsSection's list_builder special
// case above for why. ----------
// BUG FIX: this used to be a plain boolean, flipped to `true` synchronously
// BEFORE the fetch it guards actually resolved (see initListBuilderSection
// below). activateDataSciSection fires initListBuilderSection() unawaited
// on every tab switch to List Builder, and lbDrillDownFromOverview (an
// Overview stat-card click) then calls it AGAIN, itself awaited -- with a
// plain boolean, that second call saw the flag already `true` from the
// first and returned immediately, well before the real facets fetch had
// populated the County <select>. lbApplyFilterParams's `.value = 'Cook'`
// right after then silently no-oped on a dropdown that still only had
// "Any" in it, so the drill-down ran a completely unfiltered search
// instead. Caching the PROMISE itself instead means every caller --
// concurrent or not -- waits for the same real fetch to finish before
// touching the dropdown. Only reproduces on the FIRST visit to List
// Builder in a session (see the reset at the county-sync handler below).
let lbFacetsLoadPromise = null;
let lbResultRows = []; // current page of search results, keyed by id for the checkbox/export flow
// v435: the last set of filter params runListBuilderSearch actually sent --
// lbExportBtn re-sends these with a growing offset to page through every
// matching row when the true total exceeds what's loaded here, instead of
// export being capped at whatever fit in this one page.
let lbLastSearchParams = {};
let lbLastTotal = 0;
async function listBuilderCall(payload){
  const { data, error } = await sb.functions.invoke('staff-list-builder', { body: payload });
  if(error) return { ok: false, error: error.message || String(error) };
  return data;
}
// v436: Task 7 -- the one full column list, kept byte-for-byte in sync with
// staff-list-builder's own buildAndUploadListOrderCsv (used for List Order
// fulfillment). Both List Builder's own "Export selected as CSV" button and
// the Match modal's "Export selected & mark delivered" button now build
// their CSV from this instead of each hand-writing its own smaller column
// list -- all three export paths produce the same shape from the same data.
// v478: "Pre-foreclosure"/"Sale Date"/"Trustee"/"Case Number" columns added
// -- kept in sync with staff-list-builder's buildAndUploadListOrderCsv, same
// as every other column here (see this const's own comment above).
// v483: "Pre-foreclosure Legal Description" added -- same sync requirement.
// BUG FIX: 7 columns that were selectable in the on-screen column picker
// (LB_COLUMN_DEFS) had no matching entry here -- APN, Data Source, First
// Synced, Excluded, and three secondary date fields -- so a staff member
// could turn a column on, see it render in the table, then export and get
// a CSV silently missing it. Added in the same position LB_COLUMN_DEFS
// groups them, kept in sync with staff-list-builder's own LIST_CSV_HEADER/
// buildListCsv (the shared server-side shape match_order/record_delivery
// use for actual client deliveries).
