}
$('hrHistoryEditCancelBtn').addEventListener('click', closeHrHistoryEditModal);
$('hrHistoryEditModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'hrHistoryEditModalOverlay') closeHrHistoryEditModal(); });

$('hrHistoryEditSaveBtn').addEventListener('click', async () => {
  const msg = $('hrHistoryEditMsg');
  msg.style.display = 'none';
  const candidateId = hrHistoryEditCandidateId;
  if(!candidateId) return;

  const fullName = $('hrHistoryEditFullName').value.trim();
  const email = $('hrHistoryEditEmail').value.trim();
  const mobile = $('hrHistoryEditMobile').value.trim();
  const contactPhone = $('hrHistoryEditContactPhone').value.trim();
  const address = $('hrHistoryEditAddress').value.trim();
  const employmentType = $('hrHistoryEditEmploymentType').value;
  const videoFile = $('hrHistoryEditVideoInput').files[0] || null;
  const docFile = $('hrHistoryEditDocInput').files[0] || null;

  if(!fullName || !email || !mobile || !address){
    msg.textContent = 'Full name, email, mobile number, and address are required.';
    msg.style.display = 'block';
    return;
  }

  const btn = $('hrHistoryEditSaveBtn');
  btn.disabled = true;
  btn.textContent = 'Saving…';
  try{
    const patch = {
      full_name: fullName, email, mobile_number: mobile,
      contact_phone: contactPhone || null, address, employment_type: employmentType,
    };
    // Uploaded under the EDITOR's own id (storage's insert policy requires
    // the first path segment to match auth.uid()) -- doesn't need to match
    // the original submitter, and the old file is simply left in place
    // (unreferenced) rather than deleted, since delete on these buckets is
    // Owner/Admin-only and there's no real cost to leaving it.
    if(videoFile){
      const videoPath = `${myUserId}/${Date.now()}-${videoFile.name}`;
      const { error: videoErr } = await sb.storage.from('hr-candidate-videos').upload(videoPath, videoFile, { contentType: videoFile.type || 'video/mp4' });
      if(videoErr) throw videoErr;
      patch.video_path = videoPath;
    }
    if(docFile){
      const docPath = `${myUserId}/${Date.now()}-${docFile.name}`;
      const { error: docErr } = await sb.storage.from('hr-candidate-documents').upload(docPath, docFile, { contentType: docFile.type || 'application/octet-stream' });
      if(docErr) throw docErr;
      patch.id_document_path = docPath;
    }

    const { error } = await sb.from('hr_candidates').update(patch).eq('id', candidateId);
    if(error) throw error;

    logActivity('hr.candidate_edited', 'hr_candidate', candidateId, `Edited candidate details for "${fullName}"${videoFile ? ' (video replaced)' : ''}${docFile ? ' (ID/passport document replaced)' : ''}`);
    closeHrHistoryEditModal();
    await loadHrHistoryCandidates();
  }catch(e){
    msg.textContent = e.message || 'Failed to save changes.';
    msg.style.display = 'block';
  }finally{
    btn.disabled = false;
    btn.textContent = 'Save';
  }
});

// Permanently removes a candidate record (e.g. a test submission that was
// never a real applicant) -- Owner/Admin only, matching this table's own
// "hr_candidates: owner/admin delete" RLS policy exactly (is_admin()), not
// the broader can_review_hr_candidates() grant Edit uses above. There's no
// separate "archive" state for hr_candidates -- Your Submissions/My
// Commission/Candidate Review/this screen are all just filtered reads of
// this one table (see loadHrHistoryCandidates' own comment), so deleting
// the row here is what actually removes it from Your Submissions too,
// not just from this history view.
async function deleteHrHistoryCandidate(candidateId){
  const cand = hrHistoryCandidates.find(c => c.id === candidateId);
  if(!cand) return;
  if(!confirm(`Permanently delete the candidate record for "${cand.full_name}" (${cand.email || 'no email'})? This removes it from Your Submissions, My Commission, and this history — it cannot be undone.`)) return;
  const { error } = await sb.from('hr_candidates').delete().eq('id', candidateId);
  if(error){ alert(`Couldn't delete this candidate: ${error.message}`); return; }
  await loadHrHistoryCandidates();
  logActivity('hr.candidate_deleted', 'hr_candidate', candidateId, `Permanently deleted candidate record for "${cand.full_name}" (${cand.email || 'no email'})`);
}

// v240: Approve -> create the candidate's staff account directly, same
// create_user path/fields as User Management's "Add user" modal (reusing
// refreshAddUserRoleOptions/generatePassword/invokeManageUser), instead of
// leaving account creation as a separate manual step after the fact.
let hrApproveCandidateId = null;
// v: default the onboarding-meeting picker to the next upcoming Monday at
// 9:30am local (the recurring slot from the original welcome email
// example) — just a convenient starting point, the approver can pick any
// other date/time before sending.
function nextMondayAt930Local(){
  const d = new Date();
  const daysUntilMonday = (8 - d.getDay()) % 7 || 7; // always the NEXT Monday, never today
  d.setDate(d.getDate() + daysUntilMonday);
  d.setHours(9, 30, 0, 0);
  const pad = n => String(n).padStart(2, '0');
  return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}
// Turns the datetime-local value into "Monday, August 17 - 9:30-10:00am"
// style text for {meeting_datetime}, assuming a 30-minute slot (matching
// the original example) starting at whatever time was picked.
function formatMeetingDatetimeLabel(datetimeLocalValue){
  if(!datetimeLocalValue) return '';
  const start = new Date(datetimeLocalValue);
  if(isNaN(start.getTime())) return '';
  const end = new Date(start.getTime() + 30 * 60000);
  const datePart = start.toLocaleDateString([], { weekday: 'long', month: 'long', day: 'numeric' });
  const fmtTime = d => d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }).replace(' ', '').toLowerCase();
  // BUG FIX (caught live, 2026-08-27): this datetime-local picker (and its
  // default value from nextMondayAt930Local()) is always interpreted in
  // whatever local timezone the APPROVING staff member's own browser/OS is
  // set to -- it never followed the dashboard's Chicago/Cairo display
  // toggle, and the {meeting_datetime} text sent to the candidate never
  // said which zone it meant either. A Cairo-based admin approving a
  // US-based candidate (or vice versa) produced a genuinely ambiguous
  // "Monday, August 17 · 9:30-10:00am" with no way for the candidate to
  // know which timezone that was. Appends the approver's own zone
  // abbreviation (e.g. "CDT"/"EET") so it's unambiguous — the picker
  // itself still runs on the approver's local clock (unchanged), this
  // just labels the result instead of leaving it silently implicit.
  const tzAbbr = start.toLocaleTimeString([], { timeZoneName: 'short' }).split(' ').pop();
  return `${datePart} · ${fmtTime(start)} – ${fmtTime(end)} ${tzAbbr}`;
}

