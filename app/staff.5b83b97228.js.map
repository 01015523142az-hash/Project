// v: staff notification routing UI — reuses STAFF_NOTIF_KINDS and the
// staffNotifRolesCache/fetchStaffNotifRolesConfig() defined earlier
// alongside subscribeStaffOpsRealtime, so a save here also updates live
// gating for the current session immediately (no reload needed).
let staffNotifAllRoleNames = [];
async function loadStaffNotifRouting(){
  const list = $('staffNotifRoutingList');
  if(!list) return;
  list.innerHTML = '<div class="empty">Loading…</div>';
  const { data: roles } = await sb.from('roles').select('name').order('name');
  staffNotifAllRoleNames = (roles || []).map(r => r.name);
  const cfg = await fetchStaffNotifRolesConfig();
  list.innerHTML = STAFF_NOTIF_KINDS.map(k => {
    const selected = cfg[k.key]; // null/undefined = every role (default)
    const chips = staffNotifAllRoleNames.map(name => `
      <label style="display:inline-flex; align-items:center; gap:4px; margin:0 12px 6px 0; font-weight:400; font-size:11px;">
        <input type="checkbox" class="staff-notif-role-cb edit-only" data-kind="${k.key}" data-role="${escapeHtml(name)}" ${(!selected || selected.includes(name)) ? 'checked' : ''}>
        ${escapeHtml(name)}
      </label>`).join('');
    return `
      <div style="margin-bottom:16px; padding-bottom:14px; border-bottom:1px solid var(--border);">
        <div style="font-weight:600; font-size:12px; margin-bottom:6px;">${escapeHtml(k.label)}</div>
        <div>${chips || '<span style="color:var(--text-dim); font-size:11px;">No user types defined yet — add one under User Types.</span>'}</div>
      </div>`;
  }).join('');
}
if($('staffNotifRoutingSaveBtn')) $('staffNotifRoutingSaveBtn').addEventListener('click', async () => {
  const msg = $('staffNotifRoutingMsg');
  msg.textContent = '';
  const btn = $('staffNotifRoutingSaveBtn');
  btn.disabled = true;
  const list = $('staffNotifRoutingList');
  const rows = STAFF_NOTIF_KINDS.map(k => {
    const checked = Array.from(list.querySelectorAll(`.staff-notif-role-cb[data-kind="${k.key}"]:checked`)).map(cb => cb.dataset.role);
    return { key: `staff_notif_roles_${k.key}`, value: JSON.stringify(checked), updated_at: new Date().toISOString() };
  });
  const { error } = await sb.from('app_settings').upsert(rows, { onConflict: 'key' });
  btn.disabled = false;
  if(error){ msg.textContent = error.message; msg.className = 'msg error'; return; }
  await fetchStaffNotifRolesConfig(); // refresh the cache subscribeStaffOpsRealtime reads from, live for this session
  await loadStaffNotifRouting();
  msg.textContent = 'Saved.';
  msg.className = 'msg';
  logActivity('app_settings.update', null, null, 'Updated staff notification routing');
});
// v307: per-kind on/off toggle -- app_settings key client_notif_enabled_<key>.
// No saved row (or value !== 'false') = enabled, matching every other
// notification's "unset = today's behavior" default in this project.
function clientNotifEnabledSettingKey(kind){ return `client_notif_enabled_${kind}`; }
function clientNotifEmailSubjectKey(kind){ return `client_email_subject_${kind}`; }
function clientNotifEmailBodyKey(kind){ return `client_email_body_${kind}`; }
// v365: which channel(s) a still-enabled notification actually goes out on
// -- any combination of SMS / Email / Notification Center, stored as a
// comma-separated list (e.g. "sms,email"); unset/missing = all three
// (today's behavior, before this per-channel split existed). Independent of
// the enabled checkbox above: turning a kind off skips every channel
// regardless of this; this only decides which channel(s) an ON kind uses --
// "SMS only", "Email only", "Notification Center only", or any combination
// up to all three ("All").
function clientNotifChannelSettingKey(kind){ return `client_notif_channel_${kind}`; }
const CLIENT_NOTIF_CHANNELS = [
  { value: 'sms', label: 'SMS' },
  { value: 'email', label: 'Email' },
  { value: 'notification_center', label: 'Notification Center' },
];
function parseClientNotifChannels(raw){
  if(!raw) return CLIENT_NOTIF_CHANNELS.map(c => c.value); // unset = all, matches pre-v365 behavior
  const parts = String(raw).split(',').map(s => s.trim()).filter(Boolean);
  const valid = parts.filter(p => CLIENT_NOTIF_CHANNELS.some(c => c.value === p));
  return valid.length ? valid : CLIENT_NOTIF_CHANNELS.map(c => c.value);
}
async function loadClientNotifSettings(){
  const list = $('clientNotifList');
  if(!list) return;
  list.innerHTML = '<div class="empty">Loading…</div>';
  const allKeys = SMS_TEMPLATE_META.flatMap(t => [t.settingKey, clientNotifEnabledSettingKey(t.key), clientNotifChannelSettingKey(t.key), clientNotifEmailSubjectKey(t.key), clientNotifEmailBodyKey(t.key)]);
  const { data: rows, error } = await sb.from('app_settings').select('key, value').in('key', allKeys);
  if(error){ list.innerHTML = `<div class="msg error">${escapeHtml(error.message)}</div>`; return; }
  const valueByKey = {}; (rows || []).forEach(r => { valueByKey[r.key] = r.value; });
  // v730: the number client texts actually go from (send-client-sms reads
  // app_settings.client_sms_from_number), shown in the intro above.
  sb.from('app_settings').select('value').eq('key', 'client_sms_from_number').maybeSingle().then(({ data }) => {
    const el = $('clientSmsFromNumber');
    const d = String((data && data.value) || '').replace(/\D/g, '');
    if(el && d.length === 11 && d[0] === '1') el.textContent = `+1 (${d.slice(1, 4)}) ${d.slice(4, 7)}-${d.slice(7)}`;
    else if(el && data && data.value) el.textContent = data.value;
  });
  list.innerHTML = SMS_TEMPLATE_META.map(t => {
    const enabled = valueByKey[clientNotifEnabledSettingKey(t.key)] !== 'false';
    const channels = parseClientNotifChannels(valueByKey[clientNotifChannelSettingKey(t.key)]);
    return `
    <div class="client-notif-row" data-key="${t.key}" style="margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--border);">
      <label style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
        <span style="display:flex; align-items:center; gap:8px;">
          <input type="checkbox" class="client-notif-enabled-cb edit-only" data-key="${t.key}" ${enabled ? 'checked' : ''}>
          <strong style="font-weight:600;">${escapeHtml(t.label)}</strong>
        </span>
        <span style="display:flex; align-items:center; gap:12px;">
          <span style="display:flex; align-items:center; gap:10px;">
            ${CLIENT_NOTIF_CHANNELS.map(c => `
              <label style="display:flex; align-items:center; gap:4px; cursor:pointer; text-transform:none; font-family:var(--sans); font-size:11px; color:var(--text-2); letter-spacing:0; font-weight:400;">
                <input type="checkbox" class="client-notif-channel-cb edit-only" data-key="${t.key}" data-channel="${c.value}" ${channels.includes(c.value) ? 'checked' : ''} style="width:13px; height:13px; accent-color:var(--focus);"> ${c.label}
              </label>
            `).join('')}
          </span>
          <button type="button" class="btn-secondary sms-template-reset-btn edit-only" data-key="${t.key}" style="width:auto; padding:3px 10px; font-size:10px; margin-top:0; text-transform:none; letter-spacing:0; font-weight:400;">Reset to default</button>
        </span>
      </label>
      <div style="font-size:10px; color:var(--text-dim); margin:4px 0 6px;">Placeholders: <code>${t.placeholders}</code></div>
      <label style="font-size:10px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.5px;">SMS text</label>
      <textarea class="sms-template-input" data-key="${t.key}" rows="2" style="width:100%; font-size:13px;">${escapeHtml(valueByKey[t.settingKey] || t.default)}</textarea>
      <label style="font-size:10px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.5px; margin-top:8px; display:block;">Email subject</label>
      <input type="text" class="email-subject-input" data-key="${t.key}" style="width:100%; font-size:13px;" value="${escapeHtml(valueByKey[clientNotifEmailSubjectKey(t.key)] || t.emailSubjectDefault)}">
      <label style="font-size:10px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.5px; margin-top:8px; display:block;">Email body</label>
      <textarea class="email-body-input" data-key="${t.key}" rows="3" style="width:100%; font-size:13px;">${escapeHtml(valueByKey[clientNotifEmailBodyKey(t.key)] || t.emailBodyDefault)}</textarea>
    </div>`;
  }).join('');
  list.querySelectorAll('.sms-template-reset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const meta = SMS_TEMPLATE_META.find(t => t.key === btn.dataset.key);
      if(!meta) return;
      const smsEl = list.querySelector(`.sms-template-input[data-key="${btn.dataset.key}"]`);
      const subjEl = list.querySelector(`.email-subject-input[data-key="${btn.dataset.key}"]`);
      const bodyEl = list.querySelector(`.email-body-input[data-key="${btn.dataset.key}"]`);
      if(smsEl) smsEl.value = meta.default; // not saved until "Save client notifications" is clicked
      if(subjEl) subjEl.value = meta.emailSubjectDefault;
      if(bodyEl) bodyEl.value = meta.emailBodyDefault;
    });
  });
}
if($('clientNotifSaveBtn')) $('clientNotifSaveBtn').addEventListener('click', async () => {
  const msg = $('clientNotifMsg');
  msg.textContent = '';
  const btn = $('clientNotifSaveBtn');
  btn.disabled = true;
  const list = $('clientNotifList');
  const rows = SMS_TEMPLATE_META.flatMap(t => {
    const smsEl = list.querySelector(`.sms-template-input[data-key="${t.key}"]`);
    const subjEl = list.querySelector(`.email-subject-input[data-key="${t.key}"]`);
    const bodyEl = list.querySelector(`.email-body-input[data-key="${t.key}"]`);
    const enabledCb = list.querySelector(`.client-notif-enabled-cb[data-key="${t.key}"]`);
    const checkedChannels = Array.from(list.querySelectorAll(`.client-notif-channel-cb[data-key="${t.key}"]:checked`)).map(cb => cb.dataset.channel);
    const now = new Date().toISOString();
    return [
      { key: t.settingKey, value: (smsEl ? smsEl.value.trim() : '') || t.default, updated_at: now },
      { key: clientNotifEmailSubjectKey(t.key), value: (subjEl ? subjEl.value.trim() : '') || t.emailSubjectDefault, updated_at: now },
      { key: clientNotifEmailBodyKey(t.key), value: (bodyEl ? bodyEl.value.trim() : '') || t.emailBodyDefault, updated_at: now },
      { key: clientNotifEnabledSettingKey(t.key), value: (enabledCb && enabledCb.checked) ? 'true' : 'false', updated_at: now },
      { key: clientNotifChannelSettingKey(t.key), value: checkedChannels.length ? checkedChannels.join(',') : CLIENT_NOTIF_CHANNELS.map(c => c.value).join(','), updated_at: now },
    ];
  });
  const { error } = await sb.from('app_settings').upsert(rows, { onConflict: 'key' });
  btn.disabled = false;
  if(error){ msg.textContent = error.message; msg.className = 'msg error'; return; }
  // v201: re-fetch from the DB instead of just trusting what was typed --
  // same "make a silent write failure visible" reasoning as the old SMS
  // template save handler this replaced.
  await loadClientNotifSettings();
  msg.textContent = 'Saved.';
  msg.className = 'msg';
  logActivity('app_settings.update', null, null, 'Updated client notification settings (SMS/email templates + on/off)');
});

// v281: creates a real Stripe promotion code via create-promo-code (thin
// server-side wrapper, Owner/Admin-checked there too — this button being
// hidden for other roles via owner-admin-export-only is not the actual
// security boundary). See that function's header comment for why this
// doesn't build any custom discount logic of its own.
if($('createPromoCodeBtn')) $('createPromoCodeBtn').addEventListener('click', async () => {
  const msg = $('promoCodeMsg');
  msg.textContent = '';
  msg.className = 'msg';
  const btn = $('createPromoCodeBtn');

  const code = $('promoCodeText').value.trim();
  const percentOff = $('promoPercentOff').value ? Number($('promoPercentOff').value) : null;
  const amountOffDollars = $('promoAmountOff').value ? Number($('promoAmountOff').value) : null;
  const maxRedemptions = $('promoMaxRedemptions').value ? Number($('promoMaxRedemptions').value) : null;
  const expiresAt = $('promoExpiresAt').value || null;

  if(!percentOff && !amountOffDollars){
    msg.textContent = 'Enter either a % off or a $ off amount.';
    msg.className = 'msg error';
    return;
  }
  if(percentOff && amountOffDollars){
    msg.textContent = 'Choose either % off or $ off, not both.';
    msg.className = 'msg error';
    return;
  }
  // LOW FIX (audit_chunk3.md #8): the checks above relied on JS falsy/NaN
  // coercion (!NaN is true, so non-numeric text happened to fall into the
  // "enter either" error path) with no actual range check -- a value like
  // -5 or 500 (percent) passed straight through to create-promo-code,
  // relying entirely on the server to reject it. Explicit bounds now,
  // matching the inputs' own min/max attributes above.
  if(percentOff !== null && (!Number.isFinite(percentOff) || percentOff < 1 || percentOff > 100)){
    msg.textContent = '% off must be a number between 1 and 100.';
    msg.className = 'msg error';
    return;
  }
  if(amountOffDollars !== null && (!Number.isFinite(amountOffDollars) || amountOffDollars <= 0)){
    msg.textContent = '$ off must be a positive number.';
    msg.className = 'msg error';
    return;
  }
  if(maxRedemptions !== null && (!Number.isFinite(maxRedemptions) || maxRedemptions < 1)){
    msg.textContent = 'Max redemptions must be a positive number.';
    msg.className = 'msg error';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Creating…';
  const { data, error } = await sb.functions.invoke('create-promo-code', {
    body: {
      code: code || undefined,
      percentOff: percentOff || undefined,
      amountOffCents: amountOffDollars ? Math.round(amountOffDollars * 100) : undefined,
      maxRedemptions: maxRedemptions || undefined,
      expiresAt: expiresAt || undefined,
    },
  });
  btn.disabled = false;
  btn.textContent = 'Create code';

  if(error || !data || data.ok === false){
    msg.textContent = (data && data.error) || (error && error.message) || 'Failed to create code.';
    msg.className = 'msg error';
    return;
  }

  msg.textContent = `Code created: ${data.code} — share this with the client to enter at checkout.`;
  msg.className = 'msg';
  $('promoCodeText').value = '';
  $('promoPercentOff').value = '';
  $('promoAmountOff').value = '';
  $('promoMaxRedemptions').value = '';
  $('promoExpiresAt').value = '';
  logActivity('promo_code.create', null, null, `Created a Stripe discount code (${data.code})`);
  loadPromoCodesList();
});

// v293: history of every Stripe discount code issued from this panel,
// plus a Deactivate action -- previously create-only, with no way to see
// what's already out there or turn one off short of the Stripe Dashboard.
// Reads straight from Stripe (create-promo-code's list action), no local
// table to keep in sync.
async function loadPromoCodesList(){
  const tbody = $('promoCodesTbody');
  if(!tbody) return;
  const { data, error } = await sb.functions.invoke('create-promo-code', { body: { action: 'list' } });
  if(error || !data || data.ok === false){
    tbody.innerHTML = `<tr><td colspan="6" style="color:var(--danger);">${escapeHtml((data && data.error) || (error && error.message) || 'Failed to load codes.')}</td></tr>`;
    return;
  }
  const codes = data.codes || [];
  if(!codes.length){
    tbody.innerHTML = '<tr><td colspan="6" style="color:var(--text-dim);">No discount codes yet.</td></tr>';
    return;
  }
  // v717 (the owner): only the Owner may deactivate a discount code.
  const canEditFinance = canEditFinanceSection('stripe_discount_codes') && myIsOwner;
  tbody.innerHTML = codes.map(c => {
    const redeemed = c.maxRedemptions ? `${c.timesRedeemed} / ${c.maxRedemptions}` : `${c.timesRedeemed}`;
    const expires = c.expiresAt ? new Date(c.expiresAt).toLocaleDateString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {}) : 'Never';
    return `
    <tr>
      <td class="mono">${escapeHtml(c.code)}</td>
      <td>${escapeHtml(c.discount)}</td>
      <td>${redeemed}</td>
      <td style="color:${c.active ? 'var(--success, #2fa86b)' : 'var(--text-dim)'}; font-weight:600;">${c.active ? 'Active' : 'Deactivated'}</td>
      <td>${expires}</td>
      <td>${(c.active && canEditFinance) ? `<button class="btn-outline promo-code-deactivate-btn" data-id="${c.id}" style="width:auto; padding:5px 10px; font-size:11px; color:var(--danger);">Deactivate</button>` : ''}</td>
    </tr>`;
  }).join('');
}

if($('promoCodesTbody')) $('promoCodesTbody').addEventListener('click', async (e) => {
  const btn = e.target.closest('.promo-code-deactivate-btn');
  if(!btn) return;
  if(!myIsOwner){ alert('Only the Owner can deactivate a discount code.'); return; }   // v717
  if(!confirm('Deactivate this discount code? It will stop working immediately — existing redemptions are unaffected.')) return;
  btn.disabled = true;
  const { data, error } = await sb.functions.invoke('create-promo-code', { body: { action: 'deactivate', promotionCodeId: btn.dataset.id } });
  if(error || !data || data.ok === false){
    alert((data && data.error) || (error && error.message) || 'Failed to deactivate code.');
    btn.disabled = false;
    return;
  }
  logActivity('promo_code.deactivate', null, null, 'Deactivated a Stripe discount code');
  loadPromoCodesList();
});

// v286: one-time client charges -- see staff-manage-one-off-charge and
// v286-one-off-client-charges.sql. Staff only creates the request here;
// the client pays it (or doesn't) from their own Billing tab.
let oneOffChargeClientsCache = [];

async function loadOneOffChargeClientOptions(){
  const sel = $('oneOffChargeClientSelect');
  if(!sel) return;
  const { data, error } = await sb.from('client_accounts').select('id, full_name, email').eq('is_active', true).order('full_name');
  if(error){
    sel.innerHTML = `<option value="">Failed to load clients</option>`;
    return;
  }
  oneOffChargeClientsCache = data || [];
  sel.innerHTML = `<option value="">Select a client…</option>` + oneOffChargeClientsCache.map(c =>
    `<option value="${c.id}">${escapeHtml(c.full_name)} (${escapeHtml(c.email)})</option>`
  ).join('');
}

async function loadOneOffChargesList(){
  const tbody = $('oneOffChargesTbody');
  if(!tbody) return;
  const [{ data: charges, error }, { data: clients }] = await Promise.all([
    sb.from('client_one_off_charges').select('id, client_id, description, amount_cents, category, status, created_at, last_charge_error, last_charge_attempted_at, refunded_amount_cents').order('created_at', { ascending: false }).limit(200),
    sb.from('client_accounts').select('id, full_name, email'),
  ]);
  if(error){
    tbody.innerHTML = `<tr><td colspan="10" style="color:var(--danger);">${escapeHtml(error.message)}</td></tr>`;
    return;
  }
  const clientById = {};
  (clients || []).forEach(c => { clientById[c.id] = c; });
  if(!charges || !charges.length){
    tbody.innerHTML = `<tr><td colspan="10" style="color:var(--text-dim);">No one-time charges yet.</td></tr>`;
    return;
  }
  const statusColor = { pending: 'var(--warning, #d9a02c)', paid: 'var(--success, #2fa86b)', canceled: 'var(--text-dim)' };
  const categoryLabel = { data: 'Data', dialer: 'Dialer', caller: 'Caller', other: 'Other' };
  const canEditFinance = canEditFinanceSection('stripe_payments');
  tbody.innerHTML = charges.map(c => {
    const client = clientById[c.client_id];
    // v300: last_charge_error persists past the one-time alert() from a
    // failed Charge now click, so the reason is still visible on a later
    // page load/refresh, not just in the moment.
    const errorLine = (c.status === 'pending' && c.last_charge_error)
      ? `<div style="font-size:10px; color:var(--danger); font-weight:400; text-transform:none; margin-top:2px; max-width:220px;" title="${escapeHtml(c.last_charge_error)}">${escapeHtml(c.last_charge_error.length > 70 ? c.last_charge_error.slice(0, 70) + '…' : c.last_charge_error)}</div>`
      : '';
    // v302: refunded_amount_cents is cumulative (partial refunds can
    // stack) -- fully refunded (== amount_cents) reads as "Refunded"
    // instead of "Paid" so it doesn't look like an untouched payment.
    const refundedCents = c.refunded_amount_cents || 0;
    const fullyRefunded = c.status === 'paid' && refundedCents >= c.amount_cents;
    const statusLabel = fullyRefunded ? 'refunded' : c.status;
    const refundLine = (c.status === 'paid' && refundedCents > 0 && !fullyRefunded)
      ? `<div style="font-size:10px; color:var(--text-dim); font-weight:400; text-transform:none; margin-top:2px;">$${(refundedCents / 100).toFixed(2)} refunded</div>`
      : '';
    // "Charge now" (pending) and "Partial refund" (paid, balance left to
    // refund) share this column -- next to each other conceptually, since
    // a charge is only ever in one of those two states at a time.
    const actionCell = !canEditFinance ? '—' : c.status === 'pending'
      ? `<button class="btn-outline one-off-charge-charge-now-btn" data-id="${c.id}" data-client-id="${c.client_id}" style="width:auto; padding:5px 10px; font-size:11px;">Charge now</button>`
      : (c.status === 'paid' && !fullyRefunded)
        ? `<button class="btn-outline one-off-charge-refund-btn" data-id="${c.id}" data-remaining="${c.amount_cents - refundedCents}" style="width:auto; padding:5px 10px; font-size:11px;">Partial refund</button>`
        : '—';
    return `
    <tr>
      <td>${client ? escapeHtml(client.full_name) : '—'}</td>
      <td>${escapeHtml(c.description)}</td>
      <td>${c.category ? escapeHtml(categoryLabel[c.category] || c.category) : '—'}</td>
      <td>$${(c.amount_cents / 100).toFixed(2)}</td>
      <td style="color:${statusColor[c.status] || 'inherit'}; font-weight:600; text-transform:capitalize;">${escapeHtml(statusLabel)}${errorLine}${refundLine}</td>
      <td>${new Date(c.created_at).toLocaleDateString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {})}</td>
      <td>${(c.status === 'pending' && canEditFinance) ? `<button class="btn-outline one-off-charge-link-btn" data-id="${c.id}" style="width:auto; padding:5px 10px; font-size:11px;">Get link</button>` : '—'}</td>
      <td>${actionCell}</td>
      <td>${(c.status === 'pending' && canEditFinance) ? `<button class="btn-outline one-off-charge-cancel-btn" data-id="${c.id}" style="width:auto; padding:5px 10px; font-size:11px;">Cancel</button>` : ''}</td>
      <td>${myIsOwner ? `<button class="btn-outline one-off-charge-delete-btn" data-id="${c.id}" style="width:auto; padding:5px 10px; font-size:11px; color:var(--danger);">Delete</button>` : ''}</td>
    </tr>`;
  }).join('');
}

// v355: card picker for "Charge now" -- previously this always silently
// charged whatever Stripe considered the client's default payment
// method; now lists every saved card (staff-manage-one-off-charge's new
// list_payment_methods action) so staff can pick which one to debit.
let oneOffChargeCardModalState = null;
async function openOneOffChargeCardModal(chargeId, clientId){
  oneOffChargeCardModalState = { chargeId };
  const listEl = $('oneOffChargeCardList');
  $('oneOffChargeCardModalMsg').style.display = 'none';
  listEl.innerHTML = '<div style="font-size:12px; color:var(--text-dim); padding:10px 0;">Loading saved cards…</div>';
  $('oneOffChargeCardModalOverlay').classList.add('active');
  const { data, error } = await sb.functions.invoke('staff-manage-one-off-charge', { body: { action: 'list_payment_methods', clientId } });
  if(!oneOffChargeCardModalState || oneOffChargeCardModalState.chargeId !== chargeId) return; // modal was closed/reopened while this was in flight
  if(error || !data || data.ok === false){
    listEl.innerHTML = `<div style="font-size:12px; color:var(--danger); padding:10px 0;">${escapeHtml((data && data.error) || (error && error.message) || 'Failed to load saved cards.')}</div>`;
    return;
  }
  const methods = data.paymentMethods || [];
  if(!methods.length){
    listEl.innerHTML = '<div style="font-size:12px; color:var(--text-dim); padding:10px 0;">This client has no saved card on file.</div>';
    return;
  }
  const brandLabel = { visa: 'Visa', mastercard: 'Mastercard', amex: 'Amex', discover: 'Discover' };
  listEl.innerHTML = methods.map(m => `
    <div class="one-off-charge-card-row" data-pm-id="${escapeHtml(m.id)}" style="display:flex; justify-content:space-between; align-items:center; padding:8px 4px; border-bottom:1px solid var(--border); cursor:pointer;">
      <div style="font-size:12px;">${escapeHtml(brandLabel[m.brand] || m.brand)} •••• ${escapeHtml(m.last4)}${m.id === data.defaultPaymentMethodId ? ' <span style="color:var(--text-dim); font-size:10px;">(default)</span>' : ''}</div>
      <div class="mono" style="font-size:11px; color:var(--text-dim);">${m.expMonth ? String(m.expMonth).padStart(2, '0') : '--'}/${m.expYear || '--'}</div>
    </div>
  `).join('');
  listEl.querySelectorAll('.one-off-charge-card-row').forEach(row => {
    row.addEventListener('click', () => chargeOneOffChargeWithCard(row.dataset.pmId));
  });
}
function closeOneOffChargeCardModal(){
  $('oneOffChargeCardModalOverlay').classList.remove('active');
  oneOffChargeCardModalState = null;
}
$('oneOffChargeCardCancelBtn').addEventListener('click', closeOneOffChargeCardModal);
$('oneOffChargeCardModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'oneOffChargeCardModalOverlay') closeOneOffChargeCardModal(); });

async function chargeOneOffChargeWithCard(paymentMethodId){
  if(!oneOffChargeCardModalState) return;
  const { chargeId } = oneOffChargeCardModalState;
  if(!confirm('Charge this client\'s selected card now? This debits their card immediately — it is not reversible from here.')) return;
  const msgEl = $('oneOffChargeCardModalMsg');
  msgEl.style.display = 'none';
  const { data, error } = await sb.functions.invoke('staff-manage-one-off-charge', { body: { action: 'charge_now', chargeId, paymentMethodId } });
  if(error || !data || data.ok === false){
    msgEl.textContent = (data && data.error) || (error && error.message) || 'Failed to charge this client.';
    msgEl.style.display = 'block';
    return;
  }
  logActivity('one_off_charge.charge_now', null, null, `Charged a one-time charge directly (${chargeId})`);
  closeOneOffChargeCardModal();
  loadOneOffChargesList();
}

// v305: single shared source for campaign pricing, replacing the
// hardcoded CALLER_TIER_PRICE_CENTS/DIALER_PRICE_CENTS/etc. constants
// duplicated across client-manage-subscription, staff-manage-campaign-
// subscription, client-create-campaign, and staff-campaign-payment-link
// -- those Edge Functions now read the same app_settings rows this panel
// edits, at request time, instead of a baked-in constant.
// v308: saving used to go straight to app_settings client-side (RLS
// restricts insert/update to is_admin(), i.e. owner/admin literally) --
// that's what made Stripe Pricing impossible to delegate via the Roles
// editor even after the "View" checkbox was added, since a granted
// non-owner/admin role's save would show the button but fail at the RLS
// layer. Now goes through the new staff-save-stripe-pricing Edge
// Function instead, which checks finance-tab-edit (or owner/admin) with
// its own service-role write -- see that function's own checkFinanceEditAccess
// for why this couldn't just be a looser app_settings RLS policy (that
// table holds far more than pricing; loosening it broadly would hand a
// finance-edit role write access to every other admin-only setting too).
const STRIPE_PRICING_KEYS = {
  pricePartTimeCaller: 'stripe_price_part_time_caller_cents',
  priceFullTimeCaller: 'stripe_price_full_time_caller_cents',
  priceDialer: 'stripe_price_dialer_cents',
  priceDataPerRecord: 'stripe_price_data_cents_per_record',
  dataRecordsPartTime: 'stripe_data_records_part_time',
  dataRecordsFullTime: 'stripe_data_records_full_time',
};
async function loadStripePricing(){
  const msg = $('stripePricingMsg');
  if(msg){ msg.textContent = ''; msg.className = 'msg'; }
  const keys = Object.values(STRIPE_PRICING_KEYS);
  const { data, error } = await sb.from('app_settings').select('key, value, updated_at').in('key', keys);
  if(error){
    if(msg){ msg.textContent = 'Failed to load pricing: ' + error.message; msg.className = 'msg error'; }
    return;
  }
  const byKey = {};
  (data || []).forEach(r => { byKey[r.key] = r; });
  const setDollarsInput = (id, settingKey, divisor) => {
    const el = $(id);
    if(!el) return;
    const raw = byKey[settingKey] ? Number(byKey[settingKey].value) : null;
    el.value = (raw != null && !Number.isNaN(raw)) ? (raw / divisor) : '';
  };
  setDollarsInput('pricePartTimeCaller', STRIPE_PRICING_KEYS.pricePartTimeCaller, 100);
  setDollarsInput('priceFullTimeCaller', STRIPE_PRICING_KEYS.priceFullTimeCaller, 100);
  setDollarsInput('priceDialer', STRIPE_PRICING_KEYS.priceDialer, 100);
  setDollarsInput('priceDataPerRecord', STRIPE_PRICING_KEYS.priceDataPerRecord, 100);
  const setIntInput = (id, settingKey) => {
    const el = $(id);
    if(!el) return;
    const raw = byKey[settingKey] ? Number(byKey[settingKey].value) : null;
    el.value = (raw != null && !Number.isNaN(raw)) ? raw : '';
  };
  setIntInput('dataRecordsPartTime', STRIPE_PRICING_KEYS.dataRecordsPartTime);
  setIntInput('dataRecordsFullTime', STRIPE_PRICING_KEYS.dataRecordsFullTime);
  const latest = Object.values(byKey).map(r => r.updated_at).sort().pop();
  const updatedEl = $('stripePricingUpdatedAt');
  if(updatedEl) updatedEl.textContent = latest ? `Last updated ${new Date(latest).toLocaleString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {})}` : '';
}

if($('saveStripePricingBtn')) $('saveStripePricingBtn').addEventListener('click', async () => {
  const msg = $('stripePricingMsg');
  const btn = $('saveStripePricingBtn');
  const dollarsToCents = (id) => {
    const v = $(id).value;
    if(v === '' || v == null) return null;
    const n = Number(v);
    return Number.isFinite(n) ? Math.round(n * 100) : null;
  };
  const intField = (id) => {
    const v = $(id).value;
    if(v === '' || v == null) return null;
    const n = Number(v);
    return Number.isFinite(n) ? Math.round(n) : null;
  };
  const values = {
    [STRIPE_PRICING_KEYS.pricePartTimeCaller]: dollarsToCents('pricePartTimeCaller'),
    [STRIPE_PRICING_KEYS.priceFullTimeCaller]: dollarsToCents('priceFullTimeCaller'),
    [STRIPE_PRICING_KEYS.priceDialer]: dollarsToCents('priceDialer'),
    [STRIPE_PRICING_KEYS.priceDataPerRecord]: dollarsToCents('priceDataPerRecord'),
    [STRIPE_PRICING_KEYS.dataRecordsPartTime]: intField('dataRecordsPartTime'),
    [STRIPE_PRICING_KEYS.dataRecordsFullTime]: intField('dataRecordsFullTime'),
  };
  if(Object.values(values).some(v => v == null || v < 0)){
    msg.textContent = 'All fields are required and must be zero or greater.';
    msg.className = 'msg error';
    return;
  }
  if(!confirm('Update live campaign pricing? This affects new checkouts and future add-on changes immediately.')) return;
  btn.disabled = true;
  btn.textContent = 'Saving…';
  const { data, error } = await sb.functions.invoke('staff-save-stripe-pricing', { body: { values } });
  btn.disabled = false;
  btn.textContent = 'Save pricing';
  if(error || !data || data.ok === false){
    let apiMsg = data && data.error;
    if(!apiMsg && error && error.context && typeof error.context.json === 'function'){
      try{ const b = await error.context.json(); apiMsg = b.error; }catch(e){}
    }
    msg.textContent = 'Failed to save: ' + (apiMsg || (error && error.message) || 'Unknown error');
    msg.className = 'msg error';
    return;
  }
  msg.textContent = 'Pricing updated.';
  msg.className = 'msg';
  logActivity('app_settings.update', null, null, 'Updated Stripe campaign pricing');
  loadStripePricing();
});

if($('createOneOffChargeBtn')) $('createOneOffChargeBtn').addEventListener('click', async () => {
  const msg = $('oneOffChargeMsg');
  msg.textContent = '';
  msg.className = 'msg';
  const btn = $('createOneOffChargeBtn');

  const clientId = $('oneOffChargeClientSelect').value;
  const description = $('oneOffChargeDescription').value.trim();
  const amountDollars = $('oneOffChargeAmount').value ? Number($('oneOffChargeAmount').value) : null;
  const category = $('oneOffChargeCategory').value || null;

  if(!clientId){
    msg.textContent = 'Select a client.';
    msg.className = 'msg error';
    return;
  }
  if(!description){
    msg.textContent = 'Enter a description.';
    msg.className = 'msg error';
    return;
  }
  if(!amountDollars || amountDollars <= 0){
    msg.textContent = 'Enter a valid amount.';
    msg.className = 'msg error';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Creating…';
  const { data, error } = await sb.functions.invoke('staff-manage-one-off-charge', {
    body: { action: 'create', clientId, description, amountCents: Math.round(amountDollars * 100), category },
  });
  btn.disabled = false;
  btn.textContent = 'Create charge';

  if(error || !data || data.ok === false){
    msg.textContent = (data && data.error) || (error && error.message) || 'Failed to create charge.';
    msg.className = 'msg error';
    return;
  }

  msg.textContent = 'Charge created — the client will see it on their Billing tab.';
  msg.className = 'msg';
  $('oneOffChargeClientSelect').value = '';
  $('oneOffChargeDescription').value = '';
  $('oneOffChargeAmount').value = '';
  $('oneOffChargeCategory').value = '';
  loadOneOffChargesList();
  logActivity('one_off_charge.create', null, clientId, `Created a one-time charge (${description}, $${amountDollars.toFixed(2)})`);
});

if($('oneOffChargesTbody')) $('oneOffChargesTbody').addEventListener('click', async (e) => {
  // v300: debits the client's saved default payment method directly via
  // an off-session Stripe PaymentIntent — see staff-manage-one-off-
  // charge's charge_now action. Opens the card picker (openOneOffChargeCardModal
  // above) so staff choose which saved card to debit; a decline/no-payment-
  // method/auth-required failure comes back as a clear reason string (also
  // persisted to last_charge_error so it's still visible after the list
  // re-renders on a later load).
  const chargeNowBtn = e.target.closest('.one-off-charge-charge-now-btn');
  if(chargeNowBtn){
    openOneOffChargeCardModal(chargeNowBtn.dataset.id, chargeNowBtn.dataset.clientId);
    return;
  }

  // v302: full or partial refund against the original PaymentIntent
  // (resolved server-side whether it was paid via Charge now or the
  // client's own Checkout — see staff-manage-one-off-charge's refund
  // action). Prompts for an amount, defaulting to and capped at whatever
  // is actually still left to refund on this charge.
  const refundBtn = e.target.closest('.one-off-charge-refund-btn');
  if(refundBtn){
    const remainingCents = Number(refundBtn.dataset.remaining) || 0;
    const remainingDollars = (remainingCents / 100).toFixed(2);
    const input = prompt(`Refund amount in dollars (up to $${remainingDollars} remaining on this charge):`, remainingDollars);
    if(input === null) return;
    const refundDollars = Number(input);
    if(!refundDollars || refundDollars <= 0){
      alert('Enter a valid refund amount greater than $0.');
      return;
    }
    const refundCents = Math.round(refundDollars * 100);
    if(refundCents > remainingCents){
      alert(`Only $${remainingDollars} is left to refund on this charge.`);
      return;
    }
    if(!confirm(`Refund $${refundDollars.toFixed(2)} to this client? This is issued directly through Stripe and cannot be undone from here.`)) return;
    refundBtn.disabled = true;
    const originalText = refundBtn.textContent;
    refundBtn.textContent = 'Refunding…';
    const { data, error } = await sb.functions.invoke('staff-manage-one-off-charge', { body: { action: 'refund', chargeId: refundBtn.dataset.id, amountCents: refundCents } });
    if(error || !data || data.ok === false){
      alert((data && data.error) || (error && error.message) || 'Failed to issue refund.');
      refundBtn.disabled = false;
      refundBtn.textContent = originalText;
      return;
    }
    logActivity('one_off_charge.refund', null, null, `Refunded $${refundDollars.toFixed(2)} on a one-time charge (${refundBtn.dataset.id})`);
    loadOneOffChargesList();
    return;
  }

  const cancelBtn = e.target.closest('.one-off-charge-cancel-btn');
  if(cancelBtn){
    if(!confirm('Cancel this charge? The client will no longer be able to pay it.')) return;
    cancelBtn.disabled = true;
    const { data, error } = await sb.functions.invoke('staff-manage-one-off-charge', { body: { action: 'cancel', chargeId: cancelBtn.dataset.id } });
    if(error || !data || data.ok === false){
      alert((data && data.error) || (error && error.message) || 'Failed to cancel charge.');
      cancelBtn.disabled = false;
      return;
    }
    loadOneOffChargesList();
    return;
  }

  // v290: staff-generated Stripe Checkout link, to copy/share with a
  // client directly instead of waiting for them to visit their own
  // Billing tab -- see staff-manage-one-off-charge's get_payment_link
  // action for why this is generated fresh on click, not cached.
  const linkBtn = e.target.closest('.one-off-charge-link-btn');
  if(linkBtn){
    linkBtn.disabled = true;
    const originalText = linkBtn.textContent;
    linkBtn.textContent = 'Generating…';
    const { data, error } = await sb.functions.invoke('staff-manage-one-off-charge', { body: { action: 'get_payment_link', chargeId: linkBtn.dataset.id } });
    linkBtn.disabled = false;
    linkBtn.textContent = originalText;
    if(error || !data || data.ok === false || !data.checkoutUrl){
      alert((data && data.error) || (error && error.message) || 'Failed to generate a payment link.');
      return;
    }
    try { await navigator.clipboard.writeText(data.checkoutUrl); } catch {}
    prompt('Payment link (copied to clipboard if your browser allowed it) — share this with the client:', data.checkoutUrl);
    return;
  }

  // v290: Owner-only "delete the row" -- see v290-owner-delete-billing-
  // rows.sql's header comment. DB-record-only; does not touch Stripe.
  const deleteBtn = e.target.closest('.one-off-charge-delete-btn');
  if(deleteBtn){
    if(!confirm('Delete this charge record permanently? This does not affect Stripe — it only removes it from this list.')) return;
    deleteBtn.disabled = true;
    const { error } = await sb.from('client_one_off_charges').delete().eq('id', deleteBtn.dataset.id);
    if(error){
      alert('Failed to delete: ' + error.message);
      deleteBtn.disabled = false;
      return;
    }
    loadOneOffChargesList();
  }
});

// v1.2.9: agent -> GHL user id mapping editor.
async function loadGhlAgentMap(){
  const box = $('ghlAgentMapList');
  if(!box) return;
  box.innerHTML = '<div class="empty">Loading…</div>';
  // CORRECTNESS FIX (audit finding, dashboard pass): used to be
  // .in('role', ['sales', 'admin']) — role NAMES are renameable (see
  // saveRoleRename) and an Owner can create further custom
  // roles for staff who also take GoHighLevel calls, so a literal-string
  // role filter silently stopped surfacing those agents here the moment a
  // role got renamed or a new call-taking role was added, with no error to
  // flag it. Unfiltered by role, same as loadCallActivity's own agent
  // dropdown (Activity tab) and the ReadyMode map below — every profile is
  // listed, so any current or future role can be mapped.
  const { data: agents, error } = await sb.from('profiles').select('id, full_name, email, ghl_user_id, role').order('full_name');
  if(error){ box.innerHTML = `<div class="msg error">${escapeHtml(error.message)}</div>`; return; }
  if(!agents || !agents.length){ box.innerHTML = '<div class="empty">No users found.</div>'; return; }
  box.innerHTML = `
    <table>
      <thead><tr><th>Agent</th><th>GoHighLevel user ID</th><th></th></tr></thead>
      <tbody>
        ${agents.map(a => `
          <tr>
            <td>${escapeHtml(a.full_name || a.email || '—')}</td>
            <td><input type="text" class="ghl-map-input" data-agent="${a.id}" value="${escapeHtml(a.ghl_user_id || '')}" placeholder="GHL user ID" style="width:100%; max-width:280px;"></td>
            <td><button class="btn-secondary ghl-map-save edit-only" data-agent="${a.id}" style="width:auto; padding:5px 12px;">Save</button></td>
          </tr>
        `).join('')}
      </tbody>
    </table>
    <div class="msg" id="ghlMapMsg"></div>`;
  box.querySelectorAll('.ghl-map-save').forEach(btn => {
    btn.addEventListener('click', async () => {
      const agentId = btn.dataset.agent;
      const input = box.querySelector(`.ghl-map-input[data-agent="${agentId}"]`);
      const val = input ? input.value.trim() : '';
      btn.disabled = true;
      const res = await callGhlApi({ action: 'set_agent_ghl_id', agentId, ghlUserId: val || null });
      btn.disabled = false;
      const msg = $('ghlMapMsg');
      if(res.ok){ msg.textContent = 'Saved.'; msg.className = 'msg ok'; }
      else { msg.textContent = res.error || 'Failed to save.'; msg.className = 'msg error'; }
    });
  });
}

// v1.2.9: recent call activity received from GHL via webhook.
async function loadGhlCalls(){
  const box = $('ghlCallsList');
  if(!box) return;
  box.innerHTML = '<div class="empty">Loading…</div>';
  const res = await callGhlApi({ action: 'list_calls', limit: 50 });
  if(!res.ok){ box.innerHTML = `<div class="msg error">${escapeHtml(res.error || 'Failed to load calls.')}</div>`; return; }
  const calls = res.calls || [];
  if(!calls.length){ box.innerHTML = '<div class="empty">No calls received yet. Once agents make calls in GoHighLevel and the webhook is configured, they\u2019ll appear here.</div>'; return; }
  // resolve agent names for mapped calls
  const [{ data: agents }, { data: scheduleRows }] = await Promise.all([
    sb.from('profiles').select('id, full_name, email'),
    sb.from('schedules').select('user_id, timezone'),
  ]);
  const nameById = {}; (agents || []).forEach(a => { nameById[a.id] = a.full_name || a.email; });
  // v92: this preview list used to always render call_at in the browser's
  // own local time, completely ignoring the global "Times shown in"
  // toggle (Agent local/Cairo/Chicago) that every other GHL call/
  // appointment view respects — see resolveActTz() on the main Activity
  // tab for the same pattern this now follows.
  const previewAgentTz = {}; (scheduleRows || []).forEach(s => { if(s.timezone) previewAgentTz[s.user_id] = s.timezone; });
  const previewTz = userId => globalDisplayTzMode === 'agent' ? previewAgentTz[userId] : globalDisplayTzMode;
  const previewFmt = (iso, userId) => {
    if(!iso) return '—';
    const tz = previewTz(userId);
    return new Date(iso).toLocaleString([], {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(tz ? { timeZone: tz } : {})});
  };
  box.innerHTML = `
    <table>
      <thead><tr><th>When</th><th>Agent</th><th>Direction</th><th>Status</th><th>Duration</th><th>To / From</th></tr></thead>
      <tbody>
        ${calls.map(c => {
          const who = c.user_id ? escapeHtml(nameById[c.user_id] || 'Agent') : `<span style="color:var(--text-dim);">unmapped (${escapeHtml(c.ghl_user_id || '—')})</span>`;
          const dur = c.duration_seconds != null ? `${Math.floor(c.duration_seconds/60)}m ${c.duration_seconds%60}s` : '—';
          const num = c.direction === 'outbound' ? (c.to_number || '—') : (c.from_number || '—');
          return `<tr>
            <td class="mono" style="color:var(--text-2);">${previewFmt(c.call_at, c.user_id)}</td>
            <td>${who}</td>
            <td>${escapeHtml(c.direction || '—')}</td>
            <td>${escapeHtml(c.status || '—')}</td>
            <td class="mono">${dur}</td>
            <td class="mono" style="color:var(--text-2);">${escapeHtml(num)}</td>
          </tr>`;
        }).join('')}
      </tbody>
    </table>`;
}

// v467: "GoHighLevel contact lookup" card -- rebuilt after being dropped
// from an intermediate version. Populates the lookup card's location
// picker. Separate small fetch rather than reusing loadGhlConnections()'s
// own result, since that function renders straight into ghlConnectionsList
// and doesn't return/cache its data anywhere this could read back out --
// same tradeoff loadGhlClientSmsLocationSetting() already made for its own
// picker just above.
async function loadGhlLookupLocations(){
  const sel = $('ghlLookupLocationSelect');
  if(!sel) return;
  const result = await callGhlApi({ action: 'list_connections' });
  const connections = result.ok ? (result.connections || []) : [];
  if(!connections.length){
    sel.innerHTML = '<option value="">No location connected</option>';
    return;
  }
  sel.innerHTML = connections.map(c => `<option value="${escapeHtml(c.location_id)}">${escapeHtml(c.location_name || c.location_id)}</option>`).join('');
}

function ghlLookupFmtWhen(iso){
  if(!iso) return '—';
  return new Date(iso).toLocaleString([], {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit'});
}

// Splits the merged GHL conversation into three tabs so staff aren't
// reading live-chat, SMS, and call log lines interleaved in one table.
// GHL's message objects carry a `messageType` string (e.g. TYPE_SMS,
// TYPE_CALL, TYPE_LIVE_CHAT/TYPE_WEBCHAT) -- classify off that, falling
// back to the numeric `type` field's own text if messageType is ever
// missing. Anything that isn't clearly SMS or a call (email, FB/IG/
// WhatsApp/GMB, activity notes) lands in "Chats" as the catch-all thread.
// Also used by the chat widget's SMS thread view (chatRefreshSmsThread) so
// that view and this card can never disagree about what counts as a text.
let ghlLookupMessages = [];
let ghlLookupActiveTab = 'sms';
function ghlLookupClassifyMessage(m){
  const t = String(m.messageType || m.type || '').toUpperCase();
  if(t.includes('CALL')) return 'calls';
  if(t.includes('SMS')) return 'sms';
  return 'chats';
}
function ghlLookupMessageBody(m){
  if(ghlLookupClassifyMessage(m) === 'calls'){
    const status = m.meta?.callStatus || m.callStatus || m.status;
    const duration = m.meta?.callDuration ?? m.callDuration;
    const parts = [status, duration != null ? `${duration}s` : null].filter(Boolean);
    if(parts.length) return parts.join(' · ');
  }
  return m.body || m.text || '—';
}
function ghlLookupTabsHtml(){
  const counts = { chats: 0, sms: 0, calls: 0 };
  ghlLookupMessages.forEach(m => { counts[ghlLookupClassifyMessage(m)]++; });
  const tabs = [['chats', 'Chats'], ['sms', 'SMS'], ['calls', 'Calls']];
  return `<div class="ghl-lookup-tab-row">${
    tabs.map(([key, label]) => `<button class="ghl-lookup-tab-btn${ghlLookupActiveTab === key ? ' active' : ''}" data-ghl-lookup-tab="${key}">${label} (${counts[key]})</button>`).join('')
  }</div>`;
}
function ghlLookupRenderMessages(){
  const box = $('ghlLookupMessagesBox');
  if(!box) return;
  const filtered = ghlLookupMessages.filter(m => ghlLookupClassifyMessage(m) === ghlLookupActiveTab);
  const label = { chats: 'chat messages', sms: 'text messages', calls: 'calls' }[ghlLookupActiveTab];
  box.innerHTML = filtered.length
    ? `<table><thead><tr><th>When</th><th>Direction</th><th>${ghlLookupActiveTab === 'calls' ? 'Outcome' : 'Message'}</th></tr></thead><tbody>${
        filtered.map(m => `<tr>
          <td class="mono" style="color:var(--text-2); white-space:nowrap;">${ghlLookupFmtWhen(m.dateAdded || m.dateUpdated)}</td>
          <td>${escapeHtml(m.direction || '—')}</td>
          <td>${escapeHtml(ghlLookupMessageBody(m))}</td>
        </tr>`).join('')
      }</tbody></table>`
    : `<div class="empty">No ${label} found for this contact.</div>`;
}
$('ghlLookupResults').addEventListener('click', (e) => {
  const btn = e.target.closest('.ghl-lookup-tab-btn');
  if(!btn) return;
  ghlLookupActiveTab = btn.dataset.ghlLookupTab;
  $('ghlLookupResults').querySelectorAll('.ghl-lookup-tab-btn').forEach(b => b.classList.toggle('active', b.dataset.ghlLookupTab === ghlLookupActiveTab));
  ghlLookupRenderMessages();
});

$('ghlLookupBtn').addEventListener('click', async () => {
  const locationId = $('ghlLookupLocationSelect').value;
  const phone = $('ghlLookupPhone').value.trim();
  const msg = $('ghlLookupMsg');
  const results = $('ghlLookupResults');
  if(!locationId){ msg.textContent = 'No GoHighLevel location connected yet.'; msg.className = 'msg error'; return; }
  if(!phone){ msg.textContent = 'Enter a phone number.'; msg.className = 'msg error'; return; }
  const btn = $('ghlLookupBtn');
  const originalLabel = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Looking up…';
  msg.textContent = '';
  msg.className = 'msg';
  results.innerHTML = '';
  const res = await callGhlApi({ action: 'lookup_contact_activity', locationId, phone });
  btn.disabled = false;
  btn.textContent = originalLabel;
  if(!res.ok){
    msg.textContent = res.error || 'Lookup failed.';
    msg.className = 'msg error';
    return;
  }

  ghlLookupMessages = res.messages || [];
  ghlLookupActiveTab = 'sms';
  const messagesHtml = res.conversationError
    ? `<div class="msg error" style="margin-top:0;">${escapeHtml(res.conversationError)}</div>`
    : (ghlLookupMessages.length
      ? `${ghlLookupTabsHtml()}<div id="ghlLookupMessagesBox"></div>`
      : '<div class="empty">No conversation found for this number.</div>');

  const oppsHtml = res.opportunitiesError
    ? `<div class="msg error" style="margin-top:0;">${escapeHtml(res.opportunitiesError)}</div>`
    : (res.opportunities && res.opportunities.length
      ? `<table><thead><tr><th>Name</th><th>Stage</th><th>Status</th><th>Value</th></tr></thead><tbody>${
          res.opportunities.map(o => `<tr>
            <td>${escapeHtml(o.name || '—')}</td>
            <td>${escapeHtml(o.pipelineStageId || o.pipeline_stage_id || '—')}</td>
            <td>${escapeHtml(o.status || '—')}</td>
            <td class="mono">${o.monetaryValue != null ? '$' + Number(o.monetaryValue).toLocaleString() : '—'}</td>
          </tr>`).join('')
        }</tbody></table>`
      : '<div class="empty">No opportunities found for this contact.</div>');

  results.innerHTML = `
    <div style="font-size:11px; color:var(--text-dim); margin-bottom:8px;">
      Contact: <strong style="color:var(--text-2);">${escapeHtml(res.contact?.name || res.contact?.phone || 'Unknown')}</strong>
    </div>
    <div style="font-size:11px; color:var(--text-dim); text-transform:uppercase; letter-spacing:1px; margin:12px 0 6px;">Conversation</div>
    ${messagesHtml}
    <div style="font-size:11px; color:var(--text-dim); text-transform:uppercase; letter-spacing:1px; margin:16px 0 6px;">Opportunities</div>
    ${oppsHtml}
  `;
  if(ghlLookupMessages.length && !res.conversationError) ghlLookupRenderMessages();
});

async function disconnectGhlLocation(locationId){
  if(!confirm('Disconnect this GoHighLevel location? You\u2019ll need to reconnect it to resume lead sync.')) return;
  const result = await callGhlApi({ action: 'disconnect', locationId });
  if(!result.ok){
    alert(result.error || 'Failed to disconnect.');
    return;
  }
  logActivity('integration.disconnect', 'ghl_location', null, `Disconnected GoHighLevel location ${locationId}`);
  await loadGhlConnections();
}

// SECURITY FIX (audit finding, ghl-oauth-callback's former "KNOWN GAP"):
// mints a single-use CSRF state via ghl-api before ever opening GHL's
// consent screen — see ghlConnectUrl()'s own comment for the full
// rationale. Owner/Admin-gated server-side by ghl-api itself (same check
// every other GHL action in that function already gets); the edit-only
// class here just keeps the button from being shown to roles that would
// only get a 403 back from it anyway.
$('ghlOauthConnectBtn').addEventListener('click', async () => {
  const msg = $('ghlOauthMsg');
  const btn = $('ghlOauthConnectBtn');
  msg.textContent = '';
  msg.className = 'msg';
  btn.disabled = true;
  const originalLabel = btn.textContent;
  btn.textContent = 'Starting…';
  const result = await callGhlApi({ action: 'create_oauth_state' });
  btn.disabled = false;
  btn.textContent = originalLabel;
  if(!result.ok || !result.state){
    msg.textContent = result.error || 'Failed to start the connect flow.';
    msg.className = 'msg error';
    return;
  }
  // LOW FIX (audit_chunk1.md #3): GHL_CLIENT_ID/GHL_REDIRECT_URI are unfilled
  // placeholders until someone registers a GHL Marketplace app and fills
  // them in above -- without this guard, clicking here with the placeholder
  // still in place silently opened a GHL URL that GHL itself will reject,
  // with no indication OAuth just isn't configured yet. The Private
  // Integration Token card right below this one is the documented working
  // alternative in the meantime.
  if (GHL_CLIENT_ID === 'YOUR_GHL_CLIENT_ID' || GHL_REDIRECT_URI.includes('YOUR-PROJECT-REF')) {
    msg.textContent = 'GoHighLevel OAuth isn’t configured yet (GHL_CLIENT_ID/GHL_REDIRECT_URI are still placeholders) — use a Private Integration Token below instead, or ask an admin to finish the OAuth app setup.';
    msg.className = 'msg error';
    return;
  }
  window.open(ghlConnectUrl(result.state), '_blank', 'noopener');
});

$('ghlAddPitBtn').addEventListener('click', async () => {
