// v358: Stripe Income -- live report via staff-stripe-income-report
// (stripe.balanceTransactions.list), not auto-fetched on every tab visit
// since it pages through real Stripe API calls each time -- seeds a
// year-to-date default range on first open, then only re-runs on an
// explicit "Run report" click.
let taxesIncomeData = null;
async function taxesIncomeInvokeErrorMessage(error, data){
  if(data && data.error) return data.error;
  if(error && error.context && typeof error.context.json === 'function'){
    try {
      const body = await error.context.json();
      if(body && body.error) return body.error;
    } catch(e) { /* not JSON, or body already consumed -- fall through */ }
  }
  return (error && error.message) || 'unknown error';
}
function initStripeIncomeSection(){
  if(!$('taxesIncomeFromInput').value){
    const jan1 = new Date(); jan1.setMonth(0, 1);
    $('taxesIncomeFromInput').value = jan1.toISOString().slice(0, 10);
    $('taxesIncomeToInput').value = endOfLoginMonthDateInputValue();
  }
}
const TAXES_INCOME_TYPE_LABEL = {
  charge: 'Charges', refund: 'Refunds', adjustment: 'Adjustments', payment: 'Payments',
  payment_refund: 'Payment refunds', payout: 'Payouts', payout_failure: 'Payout failures',
  stripe_fee: 'Stripe fees', application_fee: 'Application fees',
};
async function loadStripeIncome(){
  const from = $('taxesIncomeFromInput').value;
  const to = $('taxesIncomeToInput').value;
  const msgEl = $('taxesIncomeMsg');
  const statsEl = $('taxesIncomeStatsRow');
  const bodyEl = $('taxesIncomeTbody');
  msgEl.classList.add('hidden');
  if(!from || !to){ msgEl.textContent = 'Pick both a From and To date.'; msgEl.className = 'msg error'; msgEl.classList.remove('hidden'); return; }
  const runBtn = $('taxesIncomeRunBtn');
  runBtn.disabled = true;
  const originalText = runBtn.textContent;
  runBtn.textContent = 'Running…';
  bodyEl.innerHTML = '<tr><td colspan="6" class="empty">Loading…</td></tr>';
  const { data, error } = await sb.functions.invoke('staff-stripe-income-report', { body: { action: 'list_income', fromDate: from, toDate: to } });
  runBtn.disabled = false;
  runBtn.textContent = originalText;
  if(error || !data || data.ok === false){
    const msg = await taxesIncomeInvokeErrorMessage(error, data);
    bodyEl.innerHTML = `<tr><td colspan="6" style="color:var(--danger);">Failed to load: ${escapeHtml(msg)}</td></tr>`;
    statsEl.innerHTML = '';
    taxesIncomeData = null;
    return;
  }
  taxesIncomeData = data;
  if(data.truncated){
    msgEl.textContent = `Showing the first ${data.transactionCount.toLocaleString()} transactions — this range has more than that. Narrow the dates for a complete total.`;
    msgEl.className = 'msg error';
    msgEl.classList.remove('hidden');
  }
  const fmt = (cents) => '$' + (cents / 100).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const typeCards = Object.entries(data.totalsByType).sort((a, b) => b[1] - a[1]).map(([type, cents]) => `
    <div class="act-stat-card">
      <div class="act-stat-label">${escapeHtml(TAXES_INCOME_TYPE_LABEL[type] || type)}</div>
      <div class="act-stat-value" style="color:${cents >= 0 ? 'var(--good)' : 'var(--danger)'};">${fmt(cents)}</div>
    </div>`).join('');
  statsEl.innerHTML = `
    <div class="act-stat-card">
      <div class="act-stat-label">Net Income</div>
      <div class="act-stat-value">${fmt(data.netIncomeCents)}</div>
    </div>
    ${typeCards}`;
  if(!data.transactions.length){
    bodyEl.innerHTML = '<tr><td colspan="6" class="empty">No Stripe activity in this range.</td></tr>';
  } else {
    const stripeIncomeTz = nonAgentDisplayTz();
    bodyEl.innerHTML = data.transactions.map(t => `
      <tr>
        <td class="mono" style="white-space:nowrap;">${new Date(t.created).toLocaleDateString([], stripeIncomeTz ? { timeZone: stripeIncomeTz } : {})}</td>
        <td>${escapeHtml(TAXES_INCOME_TYPE_LABEL[t.type] || t.type)}</td>
        <td>${escapeHtml(t.description || '—')}</td>
        <td class="mono">${fmt(t.amountCents)}</td>
        <td class="mono">${fmt(t.feeCents)}</td>
        <td class="mono" style="color:${t.netCents >= 0 ? 'var(--good)' : 'var(--danger)'};">${fmt(t.netCents)}</td>
      </tr>`).join('');
  }
}
$('taxesIncomeRunBtn').addEventListener('click', () => {
  loadStripeIncome();
  logActivity('taxes.stripe_income_report', null, null, `Ran Stripe Income report for ${$('taxesIncomeFromInput').value} to ${$('taxesIncomeToInput').value}`);
});
$('taxesIncomeExportBtn').addEventListener('click', () => {
  if(!taxesIncomeData || !taxesIncomeData.transactions.length){ alert('Run a report first.'); return; }
  exportCSV(
    `stripe-income-${taxesIncomeData.fromDate}-to-${taxesIncomeData.toDate}.csv`,
    ['Date', 'Type', 'Description', 'Amount', 'Fee', 'Net'],
    taxesIncomeData.transactions.map(t => [
      new Date(t.created).toLocaleDateString([], nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {}), TAXES_INCOME_TYPE_LABEL[t.type] || t.type, t.description || '',
      (t.amountCents / 100).toFixed(2), (t.feeCents / 100).toFixed(2), (t.netCents / 100).toFixed(2),
    ])
  );
  logActivity('taxes.stripe_income_export_csv', null, null, `Exported Stripe Income report as CSV (${taxesIncomeData.fromDate} to ${taxesIncomeData.toDate})`);
});

// ===========================================================================
// v239: Human Resources tab — Candidate Submission (any staff with the 'hr'
// tab: a form + video upload, and a live view of their own past
// submissions' status) and Candidate Review (Owner/Admin, or a role
// explicitly opted into HR_SECTIONS' 'review' key — approve/reject with a
// mandatory reason on reject, same prompt() convention as setLeadStatus()).
// Mirrors the Leads/Finance tab/subtab pattern; unlike those, Candidate
// Review's gating is enforced for real at the DB layer too (see
// can_review_hr_candidates() in the hr_candidates migration) since letting
// a submitter approve their own candidate would defeat the whole point.
// ===========================================================================
const HR_SECTIONS = [
  // v365: editable:true — Submission's Edit gates the "Submit candidate"
  // button, Review's gates Approve/Reject. Commission is a pure report with
  // nothing to edit, so it's left off the Edit column. History Archive is
  // also a pure report (read-only, no actions) — see can_view_hr_history()
  // in the DB migration for why it's a separate permission from Review
  // rather than just an "All" filter bolted onto it.
  { key: 'submission', label: 'Candidate Submission', editable: true },
  { key: 'review', label: 'Candidate Review', editable: true },
  { key: 'commission', label: 'My Commission' },
  { key: 'history', label: 'Candidate History Archive' },
];
function hrSectionDefault(key){ return key !== 'review' && key !== 'history'; }
// v365: per-subtab Edit, same shape as UM_SECTIONS/canEditUmSection.
// Candidate Submission's Edit is what lets a role actually submit a
// candidate through the form; Candidate Review's Edit is what lets a role
// Approve/Reject (viewing the queue without being able to act on it is now
// possible, same as everywhere else this pattern is used) — reject/approve
// still ALSO requires DB-level can_review_hr_candidates() regardless of
// what's saved here, per the note above. Commission is a pure report, no
// edit action exists for it. Defaults closed for Review (same as its View
// default), open for Submission (anyone with the tab can submit a candidate
// by default, same as before this was split into its own toggle).
function hrEditSectionDefault(key){ return key !== 'review'; }
// ---------- v675: Dialer Admin inside the portal ----------
// What was admin.proptechnologyai.com, as five groups (v676; eleven sections
// before). Permissions are the portal's own (roles.dialer_admin_sections), on
// top of the 'dialer_admin' tab. Each group's tabs live inside the module.
const DIALER_ADMIN_SECTIONS = [
  { key: 'overview', label: 'Overview (live floor, performance, pipeline)', editable: true },
  { key: 'campaigns', label: 'Campaigns (campaigns, lists, inbound queues)', editable: true },
  { key: 'conversations', label: 'Conversations (inbox, contacts, call log)', editable: true },
  { key: 'numbers', label: 'DIDs & Research Calls (numbers, research & DNC)', editable: true },
  { key: 'team', label: 'Team & settings (statuses, availability, settings, change history)', editable: true },
];
// Pre-v676 links name a section; map them to the group that now holds it.
const DIALER_ADMIN_LEGACY = {
  reports: 'overview', pipeline: 'overview', agents: 'team', settings: 'team',
  lists: 'campaigns', inbound: 'campaigns', inbox: 'conversations', calllog: 'conversations',
  research: 'numbers', contacts: 'conversations', floor: 'overview', history: 'team',
};
// A new role with the tab can LOOK at every section; changing anything is
// closed until someone ticks Edit -- the same defaults as the other sub-tabs.
function dialerAdminSectionDefault(){ return true; }
function dialerAdminEditSectionDefault(){ return false; }
function hasDialerAdminTab(){
  return !!myPermissions && (myIsOwner || (myPermissions.allowedTabs || []).includes('dialer_admin'));
}
function canViewDialerAdminSection(key){
  if(!hasDialerAdminTab()) return false;
  if(myPermissions.isProtected) return true;
  const s = (myPermissions.dialerAdminSections || {})[key];
  return s && typeof s.view === 'boolean' ? s.view : dialerAdminSectionDefault(key);
}
function canEditDialerAdminSection(key){
  if(!hasDialerAdminTab()) return false;
  if(myPermissions.isProtected) return true;
  const def = DIALER_ADMIN_SECTIONS.find(x => x.key === key);
  if(!def) return false;
  const s = (myPermissions.dialerAdminSections || {})[key];
  return s && typeof s.edit === 'boolean' ? s.edit : dialerAdminEditSectionDefault(key);
}
function daVisibleSections(){
  return DIALER_ADMIN_SECTIONS.filter(s => canViewDialerAdminSection(s.key)).map(s => s.key);
}

// Loaded on first open, never with the page: the portal is already one very
// large document, and most sessions never open Dialer Admin. Bump the version
// when dialer-admin/ changes so browsers do not serve a stale copy.
const DIALER_ADMIN_VERSION = '7d2f42b413'; // 809: list upload skips every 555 number and says how many; 769: only the latest copy of a draft is listed; 768: drafts stay listed, a sent email deleted in Gmail says Deleted; 767: caller-script note, and Gemini model is discovered not pinned; 766: a campaign starts from the client's approved email, with an AI variant; 765: sending warm-up, and email content the client writes with AI and approves; 764: staff form shows records + the free email seat, and can draft an Other-industry guide with AI; 763: campaign type (real estate / other industry), caller-script attachment on the guide, AI-drafted guides awaiting review; 762: Campaign Details shows each client's Email Marketing standing; 761: emails per seat is settable per client (Marketing tab); 760: add a contact with just a phone -- only the number is required, matching the list upload; 759: Open shows the whole email, Gmail drafts labelled; 750: price a market before buying numbers; 747: Open on an email, conversations for an address with no contact; 746: delivery status on sent email; 744: inbox can send from the shared mailbox; 741: agent phone/email/full-name merge fields; 737: formatted email templates (727: lists can be deactivated/reactivated (702: follow-ups may have no date; 697: coverage leaves out test campaigns; 692: light theme)
let daLoadPromise = null;
let daActiveSection = null;
let daActivePath = null;   // group/tab, e.g. "conversations/contacts"

function loadDialerAdminModule(){
  if(daLoadPromise) return daLoadPromise;
  daLoadPromise = (async () => {
    const host = $('daHost');
    if(!document.getElementById('daCss')){
      const link = document.createElement('link');
      link.id = 'daCss'; link.rel = 'stylesheet';
      link.href = `dialer-admin/dialer-admin.css?v=${DIALER_ADMIN_VERSION}`;
      document.head.appendChild(link);
    }
    const res = await fetch(`dialer-admin/dialer-admin.html?v=${DIALER_ADMIN_VERSION}`, { cache: 'no-cache' });
    if(!res.ok) throw new Error(`Dialer Admin could not load (${res.status}).`);
    host.innerHTML = await res.text();
    // The module reads this instead of making its own client: same session,
    // no second sign-in, and Edit asked per section of the portal's rules.
    window.__dialerAdminCtx = {
      sb, supabaseUrl: SUPABASE_URL, anonKey: SUPABASE_ANON_KEY,
      userId: myUserId, role: myRole,
      canEdit: (key) => canEditDialerAdminSection(key),
      // The module's own tabs (and its KPI tiles) navigate too; keep the
      // sidebar and the address bar in step with them.
      onNavigate: (path) => {
        const group = path.split('/')[0];
        daActiveSection = group;
        daActivePath = path;
        document.querySelectorAll('.da-subtab-btn').forEach(b => b.classList.toggle('active', b.dataset.daSection === group));
        try { history.replaceState(null, '', '#dialer-admin/' + path); } catch(e){}
      },
    };
    await new Promise((resolve, reject) => {
      const el = document.createElement('script');
      el.src = `dialer-admin/dialer-admin.js?v=${DIALER_ADMIN_VERSION}`;
      el.onload = resolve;
      el.onerror = () => reject(new Error('Dialer Admin could not load its code.'));
      document.body.appendChild(el);
    });
    if(!window.DialerAdmin) throw new Error('Dialer Admin loaded but did not start.');
  })().catch(e => {
    daLoadPromise = null;
    $('daHost').innerHTML = `<div class="msg error" style="margin:20px;">${escapeHtml(e.message)} Reload the page to try again.</div>`;
    throw e;
  });
  return daLoadPromise;
}
async function activateDialerAdminSection(key, path){
  daActiveSection = key;
  document.querySelectorAll('.da-subtab-btn').forEach(b => b.classList.toggle('active', b.dataset.daSection === key));
  try {
    await loadDialerAdminModule();
    if(daActiveSection !== key) return;      // they clicked on while it loaded
    await window.DialerAdmin.showSection(path && path.split('/')[0] === key ? path : key);
  } catch(e){ console.error('Dialer Admin:', e); }
}
function initDialerAdminTab(){
  const vis = daVisibleSections();
  if(!vis.length){
    $('daHost').innerHTML = '<div style="padding:28px; color:var(--text-dim); font-size:13px;">Your role cannot see any Dialer Admin section.</div>';
    return;
  }
  const key = vis.includes(daActiveSection) ? daActiveSection : vis[0];
  activateDialerAdminSection(key, daActivePath);
}
document.querySelectorAll('.da-subtab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    if(!canViewDialerAdminSection(btn.dataset.daSection)) return;
    daActiveSection = btn.dataset.daSection;
    daActivePath = null;                     // the group's remembered tab
    activateTab('dialer_management');
  });
});
// admin.proptechnologyai.com now redirects to #dialer-admin/<section>.
let daDeepLinkDone = false;
function daOpenDeepLinkOnce(){
  if(daDeepLinkDone) return;
  daDeepLinkDone = true;
  const m = /^#dialer-admin(?:\/([a-z]+))?(?:\/([a-z]+))?/.exec(location.hash || '');
  if(!m) return;
  const vis = daVisibleSections();
  if(!vis.length) return;
  const group = DIALER_ADMIN_SECTIONS.some(x => x.key === m[1]) ? m[1] : DIALER_ADMIN_LEGACY[m[1]];
  daActiveSection = vis.includes(group) ? group : vis[0];
  daActivePath = daActiveSection === group
    ? (m[2] ? group + '/' + m[2] : (DIALER_ADMIN_LEGACY[m[1]] ? group + '/' + m[1] : null))
    : null;
  setTimeout(() => activateTab('dialer_management'), 0);
}

function canViewHrSection(key){
  if(myPermissions.isProtected) return true;
  const s = (myPermissions.hrSections || {})[key];
  return s && typeof s.view === 'boolean' ? s.view : hrSectionDefault(key);
}
function canEditHrSection(key){
  if(myPermissions.isProtected) return true;
  const s = (myPermissions.hrSections || {})[key];
  return s && typeof s.edit === 'boolean' ? s.edit : hrEditSectionDefault(key);
}
function hrSubtabBtns(){
  return Array.from(document.querySelectorAll('.hr-subtab-btn')).filter(b => canViewHrSection(b.dataset.hrSection));
}
let hrActiveSection = null;
function initHrTab(){
  document.querySelectorAll('.hr-subtab-btn').forEach(b => { b.style.display = canViewHrSection(b.dataset.hrSection) ? '' : 'none'; });
  const usable = hrSubtabBtns();
  const stillValid = usable.find(b => b.dataset.hrSection === hrActiveSection);
  const target = stillValid ? hrActiveSection : (usable[0] ? usable[0].dataset.hrSection : null);
  if(target) activateHrSection(target);
}
function applyHrSectionEditGating(key){
  const panel = document.getElementById('hrSection-' + key);
  if(!panel) return;
  const editable = canEditHrSection(key);
  panel.querySelectorAll('.edit-only').forEach(el => {
    el.disabled = !editable;
    el.style.opacity = editable ? '' : '0.4';
    el.style.cursor = editable ? '' : 'not-allowed';
    el.title = editable ? '' : 'Your role has view-only access to this subtab';
  });
}
function activateHrSection(key){
  hrActiveSection = key;
  document.querySelectorAll('.hr-subtab-btn').forEach(b => b.classList.toggle('active', b.dataset.hrSection === key));
  document.querySelectorAll('.hr-section').forEach(s => { s.style.display = (s.id === 'hrSection-' + key) ? 'block' : 'none'; });
  if(key === 'submission') loadHrMySubmissions();
  else if(key === 'review'){ loadHrReviewCandidates(); loadHrWelcomeEmailSettings(); }
  else if(key === 'commission') loadHrMyCommissions();
  else if(key === 'history') loadHrHistoryCandidates();
  applyHrSectionEditGating(key);
}
document.querySelectorAll('.hr-subtab-btn').forEach(btn => {
  btn.addEventListener('click', () => { if(canViewHrSection(btn.dataset.hrSection)) activateHrSection(btn.dataset.hrSection); });
});

const HR_EMPLOYMENT_TYPE_LABEL = { full_time: 'Full-time', part_time: 'Part-time' };
const HR_STATUS_LABEL = {
  pending: '<span style="color:var(--text-dim);">Pending</span>',
  approved: '<span class="good">Approved</span>',
  rejected: '<span class="bad">Rejected</span>',
  // v371: set when the staff account created on approval is later deleted
  // via User Management -- see manage-user's delete_user action.
  terminated: '<span class="bad">Terminated</span>',
  found_other_offer: '<span class="bad">Found another offer</span>',
};
const HR_FIT_LABEL = {
  fit: '<span class="good">Fit</span>',
  not_fit: '<span class="bad">Not a fit</span>',
};
const HR_CHECKLIST_ITEMS = ['communication', 'objection_handling', 'pitch_delivery', 'confidence_tone', 'closing_ability'];
const HR_CHECKLIST_LABEL = {
  communication: 'Communication / English clarity',
  objection_handling: 'Objection handling',
  pitch_delivery: 'Pitch / script delivery',
  confidence_tone: 'Tone & confidence',
  closing_ability: 'Closing ability',
};
const HR_INTERVIEW_RESULT_LABEL = {
  true: '<span class="good">Passed</span>',
  false: '<span class="bad">Not passed</span>',
};
// v371: rejected uses rejection_reason, terminated/found_other_offer use
// termination_reason -- one cell showing whichever applies, so the column
// doesn't need to change per status.
function hrReasonCellHtml(c){
  if(c.status === 'rejected') return textPreviewCellHtml(c.rejection_reason, 'Rejection reason');
  if(c.status === 'terminated' || c.status === 'found_other_offer') return textPreviewCellHtml(c.termination_reason, 'Reason');
  return '—';
}
function hrChecklistTooltip(checklist){
  checklist = checklist || {};
  return HR_CHECKLIST_ITEMS.map(key => `${checklist[key] ? '✓' : '✗'} ${HR_CHECKLIST_LABEL[key]}`).join('\n');
}

// Live "Result: Passed/Not passed" readout as the 5 checklist boxes are
// ticked — all 5 required, same all-or-nothing rule the stored
// interview_passed boolean uses on submit.
function updateHrChecklistResult(){
  const boxes = Array.from(document.querySelectorAll('.hr-checklist-cb'));
  const allChecked = boxes.length > 0 && boxes.every(cb => cb.checked);
  const el = $('hrCandChecklistResult');
  el.textContent = 'Result: ' + (allChecked ? 'Passed' : 'Not passed');
  el.style.color = allChecked ? 'var(--good, #2ecc71)' : 'var(--text-dim)';
}
document.querySelectorAll('.hr-checklist-cb').forEach(cb => cb.addEventListener('change', updateHrChecklistResult));

$('hrCandSubmitBtn').addEventListener('click', async () => {
  const btn = $('hrCandSubmitBtn');
  const msg = $('hrCandSubmitMsg');
  const fullName = $('hrCandFullName').value.trim();
  const email = $('hrCandEmail').value.trim();
  const mobile = $('hrCandMobile').value.trim();
  const contactPhone = $('hrCandContactPhone').value.trim();
  const address = $('hrCandAddress').value.trim();
  const employmentType = $('hrCandEmploymentType').value;
  const startDate = $('hrCandStartDate').value;
  const interviewSummary = $('hrCandInterviewSummary').value.trim();
  const fitSuggestion = $('hrCandFitSuggestion').value;
  const videoFile = $('hrCandVideoInput').files[0] || null;
  const docFile = $('hrCandDocInput').files[0] || null;
  const checklistBoxes = Array.from(document.querySelectorAll('.hr-checklist-cb'));
  const checklist = {};
  checklistBoxes.forEach(cb => { checklist[cb.dataset.key] = cb.checked; });
  const interviewPassed = checklistBoxes.length > 0 && checklistBoxes.every(cb => cb.checked);
  // Every field is required except contact phone.
  if(!fullName || !email || !mobile || !address || !startDate || !interviewSummary || !videoFile || !docFile){
    msg.textContent = 'Full name, email, mobile number, address, start date, interview summary, video recording, and the ID/passport document are all required (contact phone is the only optional field).';
    msg.className = 'msg error';
    msg.style.display = 'block';
    return;
  }
  btn.disabled = true;
  btn.textContent = 'Submitting…';
  msg.style.display = 'none';
  try{
    const videoPath = `${myUserId}/${Date.now()}-${videoFile.name}`;
    const { error: videoUploadErr } = await sb.storage.from('hr-candidate-videos').upload(videoPath, videoFile, { contentType: videoFile.type || 'video/mp4' });
    if(videoUploadErr) throw videoUploadErr;

    const docPath = `${myUserId}/${Date.now()}-${docFile.name}`;
    const { error: docUploadErr } = await sb.storage.from('hr-candidate-documents').upload(docPath, docFile, { contentType: docFile.type || 'application/octet-stream' });
    if(docUploadErr) throw docUploadErr;

    const { error } = await sb.from('hr_candidates').insert({
      submitted_by: myUserId,
      full_name: fullName,
      email,
      mobile_number: mobile,
      contact_phone: contactPhone || null,
      address,
      employment_type: employmentType,
      employment_start_date: startDate,
      interview_summary: interviewSummary,
      fit_suggestion: fitSuggestion,
      interview_checklist: checklist,
      interview_passed: interviewPassed,
      video_path: videoPath,
      id_document_path: docPath,
    });
    if(error) throw error;
    logActivity('hr.candidate_submitted', 'hr_candidate', null, `Submitted candidate "${fullName}"`);
    $('hrCandFullName').value = '';
    $('hrCandEmail').value = '';
    $('hrCandMobile').value = '';
    $('hrCandContactPhone').value = '';
    $('hrCandAddress').value = '';
    $('hrCandEmploymentType').value = 'full_time';
    $('hrCandStartDate').value = '';
    $('hrCandInterviewSummary').value = '';
    $('hrCandFitSuggestion').value = 'fit';
    checklistBoxes.forEach(cb => { cb.checked = false; });
    updateHrChecklistResult();
    $('hrCandVideoInput').value = '';
    $('hrCandDocInput').value = '';
    msg.textContent = 'Candidate submitted — awaiting review.';
    msg.className = 'msg';
    msg.style.display = 'block';
    await loadHrMySubmissions();
  }catch(e){
    msg.textContent = e.message || 'Failed to submit candidate.';
    msg.className = 'msg error';
    msg.style.display = 'block';
  }finally{
    btn.disabled = false;
    btn.textContent = 'Submit candidate';
  }
});

async function loadHrMySubmissions(){
  const body = $('hrMySubmissionsBody');
  const empty = $('hrMySubmissionsEmpty');
  const { data, error } = await sb.from('hr_candidates')
    .select('id, full_name, email, employment_type, interview_passed, employment_start_date, status, rejection_reason, termination_reason, created_at')
    .eq('submitted_by', myUserId)
    .order('created_at', { ascending: false });
  if(error){ console.error('Failed to load your candidate submissions', error); return; }
  const rows = data || [];
  empty.style.display = rows.length ? 'none' : 'block';
  const hrMySubmissionsTz = nonAgentDisplayTz();
  body.innerHTML = rows.map(c => `
    <tr>
      <td>${escapeHtml(c.full_name)}</td>
      <td style="color:var(--text-2);">${escapeHtml(c.email || '—')}</td>
      <td>${HR_EMPLOYMENT_TYPE_LABEL[c.employment_type] || c.employment_type}</td>
      <td>${HR_INTERVIEW_RESULT_LABEL[c.interview_passed]}</td>
      <td style="color:var(--text-2);">${c.employment_start_date ? new Date(c.employment_start_date).toLocaleDateString() : '—'}</td>
      <td style="color:var(--text-2);">${new Date(c.created_at).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(hrMySubmissionsTz ? { timeZone: hrMySubmissionsTz } : {}) })}</td>
      <td>${HR_STATUS_LABEL[c.status] || escapeHtml(c.status)}</td>
      <td style="color:var(--text-2);">${hrReasonCellHtml(c)}</td>
    </tr>
  `).join('');
}

// v242: "My Commission" — EGP 1500 per candidate the current user
// submitted, once approved with a recorded employment_start_date at
// least 14 days ago AND their account is still active. The qualifying
// logic (including the active-account check, which plain submitters
// can't necessarily see via profiles RLS) lives server-side in the
// hr_my_commissions() SECURITY DEFINER function, scoped to auth.uid()
// there — this just renders whatever it returns.
async function loadHrMyCommissions(){
  if(ciIsAdmin()) return loadHrRecruiterCommissions();   // v717: owner/admin see every recruiter
  const body = $('hrCommissionBody');
  const empty = $('hrCommissionEmpty');
  const { data, error } = await sb.rpc('hr_my_commissions');
  if(error){ console.error('Failed to load commission data', error); return; }
  const rows = data || [];
  empty.style.display = rows.length ? 'none' : 'block';
  const total = rows.reduce((sum, r) => sum + (Number(r.commission_amount) || 0), 0);
  $('hrCommissionSummary').textContent = `EGP ${total.toLocaleString()} earned so far`;
  body.innerHTML = rows.map(r => {
    const daysLeft = Math.max(0, 14 - (r.days_employed || 0));
    let statusHtml;
    if(!r.is_active) statusHtml = '<span class="bad">Account inactive — disqualified</span>';
    else if(r.qualifies) statusHtml = '<span class="good">Qualified</span>';
    else statusHtml = `<span style="color:var(--text-dim);">Pending — ${daysLeft} day${daysLeft === 1 ? '' : 's'} left</span>`;
    return `
    <tr>
      <td>${escapeHtml(r.full_name)}</td>
      <td style="color:var(--text-2);">${r.employment_start_date ? new Date(r.employment_start_date).toLocaleDateString() : '—'}</td>
      <td style="color:var(--text-2);">${r.days_employed != null ? r.days_employed : '—'}</td>
      <td>${r.is_active ? '<span class="good">Active</span>' : '<span class="bad">Inactive</span>'}</td>
      <td>${statusHtml}</td>
      <td class="mono">${r.qualifies ? `EGP ${Number(r.commission_amount).toLocaleString()}` : '—'}</td>
    </tr>
  `;
  }).join('');
}
$('hrCommissionRefreshBtn').addEventListener('click', loadHrMyCommissions);

// v717 (the owner: owner/admin had "My Commission", which they don't earn --
// show each recruiter's commission and their candidates' dates instead).
// hr_recruiter_commissions() applies hr_my_commissions()'s exact rule to every
// recruiter's candidates; owner/admin only (anyone else gets no rows).
function hrFmtDate(v){
  if(!v) return '\u2014';
  const d = String(v).length === 10 ? new Date(v + 'T00:00:00') : new Date(v);
  return d.toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' });
}
async function loadHrRecruiterCommissions(){
  const sec = $('hrSection-commission');
  const body = $('hrCommissionBody');
  const empty = $('hrCommissionEmpty');
  const h3 = sec.querySelector('h3');
  if(h3) h3.textContent = 'Recruiter commission';
  const note = $('hrCommissionSummary').nextElementSibling;
  if(note) note.textContent = 'EGP 1,500 per candidate a recruiter submitted, once approved, given an employment start date, active for at least 14 days since that date, and still an active account. Every candidate is listed with their dates; only qualified ones earn.';
  body.closest('table').querySelector('thead').innerHTML = '<tr><th>Candidate</th><th>Submitted</th><th>Approved</th><th>Start date</th><th>Qualifies on</th><th>Status</th><th>Commission</th></tr>';
  const { data, error } = await sb.rpc('hr_recruiter_commissions');
  if(error){ console.error('Failed to load recruiter commissions', error); body.innerHTML = `<tr><td colspan="7" class="empty">${escapeHtml(error.message)}</td></tr>`; return; }
  const rows = data || [];
  empty.textContent = 'No candidates submitted yet.';
  empty.style.display = rows.length ? 'none' : 'block';
  const groups = new Map();
  rows.forEach(r => {
    const k = r.recruiter_id || 'none';
    if(!groups.has(k)) groups.set(k, { name: r.recruiter_name, rows: [] });
    groups.get(k).rows.push(r);
  });
  const earned = rows.reduce((t, r) => t + (Number(r.commission_amount) || 0), 0);
  const pending = rows.filter(r => r.status === 'approved' && r.employment_start_date && r.is_active && !r.qualifies).length;
  $('hrCommissionSummary').textContent = `EGP ${earned.toLocaleString()} earned by ${groups.size} recruiter${groups.size === 1 ? '' : 's'}` + (pending ? ` \u00b7 ${pending} pending` : '');
  body.innerHTML = [...groups.values()].map(g => {
    const total = g.rows.reduce((t, r) => t + (Number(r.commission_amount) || 0), 0);
    const qualified = g.rows.filter(r => r.qualifies).length;
    const head = `<tr class="hr-rc-head"><td colspan="7"><b>${escapeHtml(g.name)}</b> <span style="color:var(--text-dim);">\u2014 ${g.rows.length} candidate${g.rows.length === 1 ? '' : 's'} \u00b7 ${qualified} qualified</span><span class="mono" style="float:right;">EGP ${total.toLocaleString()}</span></td></tr>`;
    return head + g.rows.map(r => {
      let st;
      if(r.status !== 'approved') st = `<span style="color:var(--text-dim);">${escapeHtml(HR_STATUS_LABEL[r.status] || r.status)}</span>`;
      else if(!r.employment_start_date) st = '<span style="color:var(--text-dim);">Approved \u2014 no start date yet</span>';
      else if(!r.is_active) st = '<span class="bad">Account inactive \u2014 disqualified</span>';
      else if(r.qualifies) st = '<span class="good">Qualified</span>';
      else { const left = Math.max(0, 14 - (r.days_employed || 0)); st = `<span style="color:var(--text-dim);">Pending \u2014 ${left} day${left === 1 ? '' : 's'} left</span>`; }
      const approved = ['approved', 'terminated', 'found_other_offer'].includes(r.status) ? hrFmtDate(r.reviewed_at) : '\u2014';
      return `<tr>
        <td>${escapeHtml(r.candidate_name)}</td>
        <td style="color:var(--text-2);">${hrFmtDate(r.submitted_at)}</td>
        <td style="color:var(--text-2);">${approved}</td>
        <td style="color:var(--text-2);">${hrFmtDate(r.employment_start_date)}</td>
        <td style="color:var(--text-2);">${r.employment_start_date ? hrFmtDate(r.qualifies_on) : '\u2014'}</td>
        <td>${st}</td>
        <td class="mono">${r.qualifies ? `EGP ${Number(r.commission_amount).toLocaleString()}` : '\u2014'}</td>
      </tr>`;
    }).join('');
  }).join('');
}

let hrReviewCandidates = [];
async function loadHrReviewCandidates(){
  const body = $('hrReviewBody');
  const empty = $('hrReviewEmpty');
  const statusFilter = $('hrReviewStatusFilter').value;
  let query = sb.from('hr_candidates')
    .select('id, submitted_by, full_name, email, mobile_number, contact_phone, address, employment_type, interview_summary, fit_suggestion, interview_checklist, interview_passed, video_path, id_document_path, employment_start_date, status, rejection_reason, termination_reason, created_at, submitter:profiles!hr_candidates_submitted_by_fkey(full_name)')
    .order('created_at', { ascending: false });
  if(statusFilter) query = query.eq('status', statusFilter);
  const { data, error } = await query;
  if(error){ console.error('Failed to load candidates for review', error); return; }
  hrReviewCandidates = data || [];
  empty.style.display = hrReviewCandidates.length ? 'none' : 'block';
  body.innerHTML = hrReviewCandidates.map(c => `
    <tr>
      <td>${escapeHtml(c.full_name)}</td>
      <td>${escapeHtml(c.email || '—')}</td>
      <td>${escapeHtml(c.mobile_number)}</td>
      <td>${escapeHtml(c.contact_phone || '—')}</td>
      <td>${textPreviewCellHtml(c.address, 'Address')}</td>
      <td>${HR_EMPLOYMENT_TYPE_LABEL[c.employment_type] || c.employment_type}</td>
      <td>${textPreviewCellHtml(c.interview_summary, 'Interview summary')}</td>
      <td>${c.fit_suggestion ? (HR_FIT_LABEL[c.fit_suggestion] || escapeHtml(c.fit_suggestion)) : '—'}</td>
      <td title="${escapeHtml(hrChecklistTooltip(c.interview_checklist))}">${HR_INTERVIEW_RESULT_LABEL[c.interview_passed]}</td>
      <td>${c.video_path ? `<a href="#" class="hr-review-video-link" data-id="${c.id}">View</a>` : '—'}</td>
      <td>${c.id_document_path ? `<a href="#" class="hr-review-doc-link" data-id="${c.id}">View</a>` : '—'}</td>
      ${hrStartDateCellHtml(c)}
      <td style="color:var(--text-2);">${escapeHtml((c.submitter && c.submitter.full_name) || '—')}</td>
      <td style="color:var(--text-2);">${new Date(c.created_at).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {}) })}</td>
      <td>${HR_STATUS_LABEL[c.status] || escapeHtml(c.status)}</td>
      <td>
        ${c.status === 'pending' ? (canEditHrSection('review') ? `
          <button class="btn-secondary hr-review-approve-btn" data-id="${c.id}" style="width:auto; padding:5px 10px; font-size:11px;">Approve</button>
          <button class="btn-secondary hr-review-reject-btn" data-id="${c.id}" style="width:auto; padding:5px 10px; font-size:11px;">Reject</button>
        ` : '—') : c.status === 'rejected' ? textPreviewCellHtml(c.rejection_reason, 'Rejection reason')
          : (c.status === 'terminated' || c.status === 'found_other_offer') ? textPreviewCellHtml(c.termination_reason, 'Reason')
          : 'Account created'}
      </td>
    </tr>
  `).join('');
}

$('hrReviewBody').addEventListener('click', async (e) => {
  const videoBtn = e.target.closest('.hr-review-video-link');
  if(videoBtn){
    e.preventDefault();
    const cand = hrReviewCandidates.find(c => c.id === videoBtn.dataset.id);
    if(!cand || !cand.video_path) return;
    const { data, error } = await sb.storage.from('hr-candidate-videos').createSignedUrl(cand.video_path, 3600);
    if(error){ alert('Failed to load video: ' + error.message); return; }
    window.open(data.signedUrl, '_blank', 'noopener');
    return;
  }
  const docBtn = e.target.closest('.hr-review-doc-link');
  if(docBtn){
    e.preventDefault();
    const cand = hrReviewCandidates.find(c => c.id === docBtn.dataset.id);
    if(!cand || !cand.id_document_path) return;
    const { data, error } = await sb.storage.from('hr-candidate-documents').createSignedUrl(cand.id_document_path, 3600);
    if(error){ alert('Failed to load document: ' + error.message); return; }
    window.open(data.signedUrl, '_blank', 'noopener');
    return;
  }
  const approveBtn = e.target.closest('.hr-review-approve-btn');
  if(approveBtn){ openHrApproveModal(approveBtn.dataset.id); return; }
  const rejectBtn = e.target.closest('.hr-review-reject-btn');
  if(rejectBtn){ await setHrCandidateStatus(rejectBtn.dataset.id, 'rejected'); return; }
});

// v240: rejecting stays a plain status flip (mandatory-reason prompt, same
// as Leads Queue Review's own reject flow) — approving instead opens
// hrApproveModalOverlay below, since approval now also creates the actual
// staff account rather than just recording a decision.
async function setHrCandidateStatus(candidateId, status){
  const cand = hrReviewCandidates.find(c => c.id === candidateId);
  let rejectionReason = null;
  if(status === 'rejected'){
    rejectionReason = prompt('Why is this candidate being rejected? (required)');
    if(rejectionReason === null) return; // cancelled
    rejectionReason = rejectionReason.trim();
    if(!rejectionReason){ alert('A reason is required to reject a candidate.'); return; }
  }
  const { error } = await sb.from('hr_candidates').update({
    status,
    rejection_reason: status === 'rejected' ? rejectionReason : null,
    reviewed_by: myUserId,
    reviewed_at: new Date().toISOString(),
  }).eq('id', candidateId);
  if(error){ alert(error.message); return; }
  logActivity('hr.candidate_reviewed', 'hr_candidate', candidateId, `Marked ${status}${cand ? ` — ${cand.full_name}` : ''}${status === 'rejected' ? ` — reason: ${rejectionReason}` : ''}`);
  await loadHrReviewCandidates();
}

$('hrMySubmissionsRefreshBtn').addEventListener('click', loadHrMySubmissions);
$('hrReviewRefreshBtn').addEventListener('click', loadHrReviewCandidates);
$('hrReviewStatusFilter').addEventListener('change', loadHrReviewCandidates);

// v: Candidate History Archive — read-only, every status at once by
// default (unlike Candidate Review, which defaults to just "Pending"
// since it's an actionable queue). Adds reviewed_by/reviewed_at over what
// Candidate Review selects, since a permanent audit trail should show who
// made the call and when, not just the current status. Gated by its own
// can_view_hr_history() DB permission (see that migration) so a role can
// be granted this without also getting Review's approve/reject ability.
// v645: the employment start date is editable after approval, not only at
// the moment of approval. It is day zero for the 14-day referral
// commission, so a wrong one has to be correctable -- previously the only
// chance to set it was inside the approve modal and it was read-only
// everywhere afterwards.
//
// WHO: mirrors can_review_hr_candidates() in the database (is_admin(), or
// the hr tab plus hr_sections.review.view) -- which resolves to exactly
// Owner, Admin and Team Leader on the current roles. This check only
// decides whether to draw the control; hr_candidates' own "reviewer
// update" RLS policy is the real gate, so a hand-crafted request from
// anybody else is still refused by the database.
function hrCanEditStartDate(){
  if(myIsOwner || myRole === 'admin') return true;
  const hs = (myPermissions && myPermissions.hrSections) || {};
  return !!(hs.review && hs.review.view);
}
// The editable cell appears in both the review queue and the history
// table, so the refresh after a save has to cover whichever one the user
// is actually looking at rather than assuming.
async function hrRefreshCandidateTables(){
  const jobs = [];
  if(typeof loadHrReviewCandidates === 'function' && document.getElementById('hrReviewBody')) jobs.push(loadHrReviewCandidates());
  if(typeof loadHrHistoryCandidates === 'function' && document.getElementById('hrHistoryBody')) jobs.push(loadHrHistoryCandidates());
  await Promise.all(jobs);
}
function hrStartDateCellHtml(c){
  const shown = c.employment_start_date ? new Date(c.employment_start_date).toLocaleDateString() : '—';
  if(!hrCanEditStartDate()){
    return `<td style="color:var(--text-2);">${shown}</td>`;
  }
  return `<td style="color:var(--text-2);" data-start-date-cell="${c.id}">`
    + `<span class="hr-startdate-edit" data-id="${c.id}" data-value="${escapeHtml(c.employment_start_date || '')}" `
    + `style="cursor:pointer; border-bottom:1px dashed var(--focus); color:var(--focus);" `
    + `title="Click to change the employment start date">${shown}</span></td>`;
}

// Delegated so it keeps working after any re-render of the table.
document.addEventListener('click', async (e) => {
  const trigger = e.target.closest && e.target.closest('.hr-startdate-edit');
  if(!trigger) return;
  const cell = trigger.parentElement;
  const id = trigger.dataset.id;
  const current = trigger.dataset.value || '';
  // Swap the cell for a real date input rather than a prompt(), so the
  // value can only ever be a valid date in the format the column expects.
  cell.innerHTML = `<input type="date" class="hr-startdate-input" value="${escapeHtml(current)}" style="padding:4px 6px; font-size:11px; width:140px;">`;
  const input = cell.querySelector('.hr-startdate-input');
  input.focus();
  let done = false;
  const commit = async () => {
    if(done) return;
    done = true;
    const value = input.value;
    if(!value || value === current){ await hrRefreshCandidateTables(); return; }
    const { error } = await sb.from('hr_candidates').update({ employment_start_date: value }).eq('id', id);
    if(error){
      alert(`Could not change the start date: ${error.message}`);
    }else{
      logActivity('hr.start_date_update', 'hr_candidate', id, `Employment start date changed from ${current || '(unset)'} to ${value}`);
    }
    await hrRefreshCandidateTables();
  };
  input.addEventListener('change', commit);
  input.addEventListener('blur', commit);
  input.addEventListener('keydown', (ev) => {
    if(ev.key === 'Escape'){ done = true; hrRefreshCandidateTables(); }
  });
});

let hrHistoryCandidates = [];
async function loadHrHistoryCandidates(){
  const body = $('hrHistoryBody');
  const empty = $('hrHistoryEmpty');
  const statusFilter = $('hrHistoryStatusFilter').value;
  const search = $('hrHistorySearchFilter').value.trim().toLowerCase();
  let query = sb.from('hr_candidates')
    .select('id, submitted_by, full_name, email, mobile_number, contact_phone, address, employment_type, interview_summary, fit_suggestion, interview_checklist, interview_passed, video_path, id_document_path, employment_start_date, status, rejection_reason, termination_reason, reviewed_by, reviewed_at, created_at, submitter:profiles!hr_candidates_submitted_by_fkey(full_name), reviewer:profiles!hr_candidates_reviewed_by_fkey(full_name)')
    .order('created_at', { ascending: false });
  if(statusFilter) query = query.eq('status', statusFilter);
  const { data, error } = await query;
  if(error){ console.error('Failed to load candidate history', error); return; }
  let rows = data || [];
  if(search){
    rows = rows.filter(c => [c.full_name, c.email, c.mobile_number, c.contact_phone].some(v => v && String(v).toLowerCase().includes(search)));
  }
  hrHistoryCandidates = rows;
  empty.style.display = rows.length ? 'none' : 'block';
  body.innerHTML = rows.map(c => `
    <tr>
      <td>${escapeHtml(c.full_name)}</td>
      <td>${escapeHtml(c.email || '—')}</td>
      <td>${escapeHtml(c.mobile_number)}</td>
      <td>${escapeHtml(c.contact_phone || '—')}</td>
      <td>${textPreviewCellHtml(c.address, 'Address')}</td>
      <td>${HR_EMPLOYMENT_TYPE_LABEL[c.employment_type] || c.employment_type}</td>
      <td>${textPreviewCellHtml(c.interview_summary, 'Interview summary')}</td>
      <td>${c.fit_suggestion ? (HR_FIT_LABEL[c.fit_suggestion] || escapeHtml(c.fit_suggestion)) : '—'}</td>
      <td title="${escapeHtml(hrChecklistTooltip(c.interview_checklist))}">${HR_INTERVIEW_RESULT_LABEL[c.interview_passed]}</td>
      <td>${c.video_path ? `<a href="#" class="hr-history-video-link" data-id="${c.id}">View</a>` : '—'}</td>
      <td>${c.id_document_path ? `<a href="#" class="hr-history-doc-link" data-id="${c.id}">View</a>` : '—'}</td>
      ${hrStartDateCellHtml(c)}
      <td style="color:var(--text-2);">${escapeHtml((c.submitter && c.submitter.full_name) || '—')}</td>
      <td style="color:var(--text-2);">${new Date(c.created_at).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {}) })}</td>
      <td>${HR_STATUS_LABEL[c.status] || escapeHtml(c.status)}</td>
      <td>${c.status === 'rejected' ? textPreviewCellHtml(c.rejection_reason, 'Rejection reason')
        : (c.status === 'terminated' || c.status === 'found_other_offer') ? textPreviewCellHtml(c.termination_reason, 'Reason')
        : '—'}</td>
      <td style="color:var(--text-2);">${escapeHtml((c.reviewer && c.reviewer.full_name) || '—')}</td>
      <td style="color:var(--text-2);">${c.reviewed_at ? new Date(c.reviewed_at).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', ...(nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {}) }) : '—'}</td>
      <td style="white-space:nowrap;">
        ${canEditHrSection('review') ? `<button class="hr-history-edit-btn" data-id="${c.id}" style="background:transparent; border:1px solid var(--border-light); border-radius:6px; color:var(--text-2); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px;">Edit</button>` : ''}
        ${(myIsOwner || myRole === 'admin') ? `<button class="hr-history-delete-btn" data-id="${c.id}" style="background:transparent; border:1px solid var(--danger, #d9534f); border-radius:6px; color:var(--danger, #d9534f); cursor:pointer; font-size:11px; font-family:var(--mono); padding:4px 8px; margin-left:4px;">Delete</button>` : ''}
        ${(!canEditHrSection('review') && !(myIsOwner || myRole === 'admin')) ? '—' : ''}
      </td>
    </tr>
  `).join('');
}
$('hrHistoryBody').addEventListener('click', async (e) => {
  const editBtn = e.target.closest('.hr-history-edit-btn');
  if(editBtn){ openHrHistoryEditModal(editBtn.dataset.id); return; }
  const deleteBtn = e.target.closest('.hr-history-delete-btn');
  if(deleteBtn){ await deleteHrHistoryCandidate(deleteBtn.dataset.id); return; }
  const videoBtn = e.target.closest('.hr-history-video-link');
  if(videoBtn){
    e.preventDefault();
    const cand = hrHistoryCandidates.find(c => c.id === videoBtn.dataset.id);
    if(!cand || !cand.video_path) return;
    const { data, error } = await sb.storage.from('hr-candidate-videos').createSignedUrl(cand.video_path, 3600);
    if(error){ alert('Failed to load video: ' + error.message); return; }
    window.open(data.signedUrl, '_blank', 'noopener');
    return;
  }
  const docBtn = e.target.closest('.hr-history-doc-link');
  if(docBtn){
    e.preventDefault();
    const cand = hrHistoryCandidates.find(c => c.id === docBtn.dataset.id);
    if(!cand || !cand.id_document_path) return;
    const { data, error } = await sb.storage.from('hr-candidate-documents').createSignedUrl(cand.id_document_path, 3600);
    if(error){ alert('Failed to load document: ' + error.message); return; }
    window.open(data.signedUrl, '_blank', 'noopener');
    return;
  }
});
