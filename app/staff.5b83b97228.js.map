// v360: Time Management subtabs (Timesheets/Reports/Flags), each keeping
// the exact same independent view/edit granularity it had as its own
// top-level tab before this move — Timesheets and Reports each had their
// own separate whole-tab Edit checkbox (DASHBOARD_TAB_KEYS' editable:true),
// Flags never did (it has no .edit-only elements at all — pure reporting).
// See the migration backfill (v360_time_management_tab) for how existing
// roles' old timesheets/reports/flags grants were carried over into this
// per-section shape.
// v453: 'staff' (Dashboard) added as the first entry — same move, one
// version later, moving Dashboard out of DASHBOARD_TAB_KEYS and in here
// instead. No editable:true, same as Flags: its "edit" isn't a normal
// tab_edit toggle at all, it's hardcoded to Owner/Admin's canManageUsers
// (see canEditTimeManagementSection's special case below) — that rule is
// unchanged from when this lived as canEditTab('staff').
const TIME_MANAGEMENT_SECTIONS = [
  { key: 'staff', label: 'Dashboard' },
  { key: 'timesheets', label: 'Timesheets', editable: true },
  { key: 'reports', label: 'Reports', editable: true },
  { key: 'flags', label: 'Flags' },
];
function timeManagementSectionDefault(key){ return false; }
function canViewTimeManagementSection(key){
  if(myPermissions.isProtected) return true;
  const s = myPermissions.timeManagementSections[key];
  return s && typeof s.view === 'boolean' ? s.view : timeManagementSectionDefault(key);
}
function canEditTimeManagementSection(key){
  if(myPermissions.isProtected) return true;
  // v453: carried over unchanged from the old canEditTab('staff') --
  // Dashboard's edit access was never governed by a normal per-role
  // tab_edit/section-edit toggle, it's tied to the separate can_manage_users
  // flag (server-enforced in the manage-user Edge Function too).
  if(key === 'staff') return myPermissions.canManageUsers;
  // LOW FIX (audit_chunk3.md #7): this used to default to true regardless
  // of timeManagementSectionDefault(key) -- meaning a section that defaults
  // to not-even-viewable (view: false) nonetheless defaulted to "editable"
  // the moment it became visible some other way. Every other *SectionDefault
  // pair in this file (Leads, Csub, Finance, HR, DataSci, Um) shares one
  // default between view and edit; this now matches that pattern instead
  // of being the one inconsistent case.
  const s = myPermissions.timeManagementSections[key];
  return s && typeof s.edit === 'boolean' ? s.edit : timeManagementSectionDefault(key);
}
function applyTimeManagementSectionEditGating(key){
  const panel = document.getElementById('tmSection-' + key);
  if(!panel) return;
  const editable = canEditTimeManagementSection(key);
  panel.querySelectorAll('.edit-only').forEach(el => {
    el.disabled = !editable;
    el.style.opacity = editable ? '' : '0.4';
    el.style.cursor = editable ? '' : 'not-allowed';
    el.title = editable ? '' : 'Your role has view-only access to this section';
  });
}
function timeManagementSubtabBtns(){
  return Array.from(document.querySelectorAll('.tm-subtab-btn')).filter(b => canViewTimeManagementSection(b.dataset.tmSection));
}
let tmActiveSection = null;
function initTimeManagementTab(){
  document.querySelectorAll('.tm-subtab-btn').forEach(b => { b.style.display = canViewTimeManagementSection(b.dataset.tmSection) ? '' : 'none'; });
  const usable = timeManagementSubtabBtns();
  const stillValid = usable.find(b => b.dataset.tmSection === tmActiveSection);
  const target = stillValid ? tmActiveSection : (usable[0] ? usable[0].dataset.tmSection : null);
  if(target) activateTimeManagementSection(target);
}
function activateTimeManagementSection(key){
  tmActiveSection = key;
  document.querySelectorAll('.tm-subtab-btn').forEach(b => b.classList.toggle('active', b.dataset.tmSection === key));
  document.querySelectorAll('.tm-section').forEach(s => { s.style.display = (s.id === 'tmSection-' + key) ? 'block' : 'none'; });
  applyTimeManagementSectionEditGating(key);
  // v453: moved here from activateTab's old tabKey === 'staff' branch, back
  // when Dashboard was its own top-level tab — same reset-to-team-list
  // behavior, unchanged.
  if(key === 'staff'){
    currentDetailAgent = null;
    $('detailPanel').style.display = 'none';
    $('teamCard').style.display = 'block';
    loadTeam();
  }
  else if(key === 'timesheets') loadTimesheets();
  else if(key === 'reports') initReportsTab();
  else if(key === 'flags') initFlagsTab();
}
document.querySelectorAll('.tm-subtab-btn').forEach(btn => {
  btn.addEventListener('click', () => { if(canViewTimeManagementSection(btn.dataset.tmSection)) activateTimeManagementSection(btn.dataset.tmSection); });
});

// Activity tab: sub-tabs are grouped by data source (GoHighLevel /
// ReadyMode) and independently grantable per role — same convention as
// UM_SECTIONS below for User Management. 'sms'/'email' are deliberately
// absent: they're permanently-disabled placeholders with no backing data
// source (see the act-subtab-btn markup), so there's nothing to gate.
const ACTIVITY_GROUPS = [
  // v623: 'ghl', 'readymode', 'gmail' and 'extension' removed -- see the
  // comment on the act-group-row markup for why, and note that their
  // ACTIVITY_SECTIONS entries below are deliberately KEPT so that roles
  // already granted those sections are not silently stripped of a grant the
  // Roles editor can no longer show them.
  // v: cross-cutting per-agent report (leads reviewed, PrimeHome
  // Buyers/gyhomes sends, logged hours) filterable by role — see
  // ACTIVITY_SECTIONS' 'staff_activity' entry and loadCallActivity()'s
  // own branch for the full picture. Unlike Extension's per-TASK pills,
  // this is per-AGENT/ROLE and deliberately not tied to any one task.
  { key: 'staff_activity', label: 'Staff Activity' },
];
let ACTIVITY_SECTIONS = [
  { key: 'call', label: 'Calls', group: 'ghl' },
  // v477: re-enabled — was disabled/"(soon)" while there was no reliable
  // data source. Now backed by client_sms_log (see loadCallActivity's own
  // kind === 'sms' branch), which only records automated/one-way sends
  // this app itself issues — real 2-way conversation stays in the chat
  // widget's SMS tab, never duplicated here.
  { key: 'sms', label: 'Texts', group: 'ghl' },
  { key: 'appointment', label: 'Appointments', group: 'ghl' },
  { key: 'rm_call', label: 'Call Log', group: 'readymode' },
  { key: 'agent_report', label: 'Agent Report', group: 'readymode' },
  { key: 'productivity', label: 'Productivity', group: 'readymode' },
  { key: 'gmail_inbox', label: 'Inbox', group: 'gmail' },
  // v: single pill under the new Staff Activity group, same "one fixed
  // report, no per-item pills" shape as Gmail's Inbox above.
  { key: 'staff_activity', label: 'Overview', group: 'staff_activity' },
  // v360: 'ispeedtolead_postback' moved out of this array entirely — the
  // iSpeedToLead group is gone from Activity, relocated to Finance ->
  // iSpeedToLead Postbacks (hardcoded Owner-only there, not grantable via
  // the Roles editor at all — see canViewFinanceSection).
  // v144: the Extension group used to have exactly one fixed row here
  // ('staff_work', showing every task's custom-field submissions lumped
  // together). It's now built fresh from the live `tasks` table instead —
  // see refreshExtensionTaskSections() below — so every task automatically
  // gets its own sub-tab ('task_<task id>') the moment it's created, with
  // its own independent per-role view permission, rather than one
  // all-tasks-at-once tab. Nothing is pushed here at module-load time;
  // refreshExtensionTaskSections() populates the 'extension' group entries
  // the first time tasks are available (see its own call sites).
];
// v: Staff Activity defaults CLOSED, unlike every other section here — it
// surfaces per-agent review/dispatch counts and logged hours across the
// WHOLE org (not scoped to what the viewer themselves submitted, the way
// Extension's per-task pills effectively are via leads' own RLS), which
// is a more sensitive "how is this person performing" view than a raw
// call/text/appointment log. An Owner opts a role into it deliberately,
// same precedent as Candidate Review/History Archive in HR.
function activitySectionDefault(key){ return key !== 'staff_activity'; }
function canViewActivitySection(key){
  if(myPermissions.isProtected) return true;
  // v475: Gmail's Inbox section is gated by the SAME can_text_clients
  // permission that gates every other "reach out to a client directly"
  // surface (SMS thread, book appointment, gmail-api's own
  // CLIENT_FACING_ACTIONS) -- not the generic per-role Activity Sections
  // grid the rest of this tab uses, so there's exactly one permission to
  // configure for "can this role contact clients" instead of two
  // independent ones that could drift out of sync.
  if(key === 'gmail_inbox') return !!myPermissions.canTextClients;
  const s = myPermissions.activitySections[key];
  return s && typeof s.view === 'boolean' ? s.view : activitySectionDefault(key);
}

// v144: task_<id> -> task name, populated by refreshExtensionTaskSections()
// below and read back by loadCallActivity() when rendering a task
// sub-tab's own rows/stat cards.
let extensionTaskNameById = {};

// Rebuilds the Extension group's ACTIVITY_SECTIONS entries and the
// act-subtab-btn pills in #actExtensionSubtabs from whatever's currently
// in `tasks` — called on Activity tab open (initActivityTab()) and
// whenever the Tasks admin list reloads (loadTasksList()), so a brand-new
// task shows up as its own sub-tab without a page reload, and a
// renamed/archived/deleted one updates or disappears the same way.
// Archived tasks are left out, same as the extension's own task picker
// and the task-assignment picker — nothing new can be logged against one,
// so there's nothing new to review here either; anything it already
// collected before being archived is still reachable by picking "no task
// filter" + a wide enough date range on whichever report shows raw leads.
function refreshExtensionTaskSections(tasks){
  const activeTasks = (tasks || []).filter(t => !t.archived_at).slice().sort((a, b) => a.name.localeCompare(b.name));
  extensionTaskNameById = {};
  activeTasks.forEach(t => { extensionTaskNameById[t.id] = t.name; });

  ACTIVITY_SECTIONS = ACTIVITY_SECTIONS.filter(s => s.group !== 'extension')
    .concat(activeTasks.map(t => ({ key: `task_${t.id}`, label: t.name, group: 'extension' })));

  const container = $('actExtensionSubtabs');
  const noTasksMsg = $('actExtensionNoTasksMsg');
  if(!container) return; // Activity tab markup not in the DOM yet on this page
  container.innerHTML = '';
  activeTasks.forEach(t => {
    const btn = document.createElement('button');
    btn.className = 'act-subtab-btn';
    btn.dataset.actKind = `task_${t.id}`;
    btn.dataset.actGroup = 'extension';
    btn.textContent = t.name;
    // v144: these buttons are created after the module-level
    // `document.querySelectorAll('.act-subtab-btn').forEach(...)` binding
    // near activateActivityKind() already ran once at parse time, so they
    // need their own listener attached directly here rather than relying
    // on that one-time binding to have caught them.
    btn.addEventListener('click', () => { if(!btn.disabled) activateActivityKind(btn.dataset.actKind); });
    container.appendChild(btn);
  });
  if(noTasksMsg) noTasksMsg.style.display = activeTasks.length ? 'none' : '';
}



// User Management's own sub-sections (Tasks + Roles merged) — each gets
// independent View/Edit checkboxes, rather than one blanket Edit toggle
// for the whole tab. "roles" defaults CLOSED (see umSectionDefault) even
// when the rest of the tab is wide open, since it's the one section that
// can grant further privileges — an Owner has to deliberately opt a role
// into it.
const UM_SECTIONS = [
  { key: 'users', label: 'Users' },
  { key: 'tasks', label: 'Tasks' },
  { key: 'dialer_domains', label: 'Dialer Domains' },
  { key: 'min_version', label: 'Extension Version' },
  { key: 'roles', label: 'User Types' },
  { key: 'clients', label: 'Clients' },
  { key: 'integrations', label: 'Integrations' },
  { key: 'notifications_setting', label: 'Notifications Setting' },
  { key: 'chat_settings', label: 'Chat Settings' },
];
function umSectionDefault(key){
  return key !== 'roles' && key !== 'notifications_setting' && key !== 'clients'; // everything defaults open except Roles, Notifications Setting, and Clients, which default closed — same "sensitive action" precedent (routes/mutes what every staff member and client sees, or exposes customer PII/login management)
}
// v313: Clients was hardcoded Owner/Admin-only ("never configurable to a
// custom role") -- now delegable like every other section, via
// um_sections.clients.{view,edit}. Owner/Admin still always has full
// access regardless of what's saved there. Delete stays Owner-only no
// matter what (see manage-client's own delete_client check) -- there's no
// "view+edit but not delete" toggle here, that boundary lives server-side.
function canViewUmSection(key){
  // v776: was `myIsOwner || myRole === 'admin' || row`, so an Owner closing
  // Clients for Admin did nothing. Admin reads its own row now; the v776
  // migration wrote today's value (view/edit true) into that row first.
  if(key === 'clients') return myIsOwner || !!(myPermissions.umSections.clients && myPermissions.umSections.clients.view);
  if(myPermissions.isProtected) return true;
  const s = myPermissions.umSections[key];
  return s && typeof s.view === 'boolean' ? s.view : umSectionDefault(key);
}
function canEditUmSection(key){
  // v776: see canViewUmSection above.
  if(key === 'clients') return myIsOwner || !!(myPermissions.umSections.clients && myPermissions.umSections.clients.edit);
  if(myPermissions.isProtected) return true;
  const s = myPermissions.umSections[key];
  return s && typeof s.edit === 'boolean' ? s.edit : umSectionDefault(key);
}

