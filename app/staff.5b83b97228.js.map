// v358: same per-row "reload just this subtab" pattern as .leads-refresh-btn
// -- currently only Data Orders' own Refresh button uses this (Skip Trace
// has its own dedicated csubSkiptraceRefreshBtn handler; Data Form/List
// Builder don't have a standalone refresh button of their own).
document.querySelectorAll('.datasci-refresh-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    if(btn.disabled) return;
    btn.disabled = true;
    const original = btn.innerHTML;
    btn.innerHTML = '&#8635; Refreshing…';
