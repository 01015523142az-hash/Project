}
$('ispeedtoleadModalCancelBtn').addEventListener('click', closeIspeedToLeadModal);
$('ispeedtoleadModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'ispeedtoleadModalOverlay') closeIspeedToLeadModal(); });
// v469: "Send to gyhomes" moved here from the row's Actions column.
// Saves whatever's currently in the Ping ID field first -- same "Send
// always reflects what's on screen even if the admin forgot to click Save
// details" reasoning ispeedtoleadModalSendBtn's own handler already uses
// below -- since gyhomes now reuses that field's value as its screenshot
// (see gyhomesModalOverlay's own comment) and a just-typed/just-uploaded
// value that was never explicitly saved would otherwise be silently lost.
$('ispeedtoleadModalGyhomesBtn').addEventListener('click', async () => {
