});
$('callBackAvailBulkDeleteBtn').addEventListener('click', () => bulkDeleteCallBackLeads('avail'));
$('callBackMineBulkDeleteBtn').addEventListener('click', () => bulkDeleteCallBackLeads('mine'));

// Conditional update (.is('callback_claimed_by', null)) is the actual
// exclusivity guard — if two agents click "Pick up" on the same lead at
// close to the same moment, only the first update matches that condition
// and returns a row; the loser gets 0 rows back and a clear message
// instead of silently overwriting the winner's claim (the DB's own
// with_check on the call_back policy backs this up either way).
async function claimCallBackLead(leadId){
  const { data, error } = await sb.from('leads')
    .update({ callback_claimed_by: myUserId, callback_claimed_at: new Date().toISOString() })
    .eq('id', leadId).eq('status', 'call_back').is('callback_claimed_by', null)
    .select('id');
  if(error){ alert(error.message); return; }
  if(!data || !data.length){
    alert('Someone else just claimed this one — refreshing the list.');
    await loadCallBackQueue();
    return;
  }
  logActivity('lead.call_back_claim', 'lead', leadId, 'Claimed a call back lead');
  await loadCallBackQueue();
}

let callBackConfirmLead = null;
async function openCallBackConfirmModal(leadId){
  const lead = leadsCallBackRows.find(r => r.id === leadId);
  if(!lead) return;
  callBackConfirmLead = lead;
  $('callBackConfirmLeadId').value = lead.id;
  $('callBackConfirmLeadLabel').textContent = `${lead.seller_investor_name || 'No name yet'} — ${lead.count} lead(s) — ${leadsFormNameFn(lead.submission_form_id)}`;
  $('callBackConfirmReason').textContent = lead.callback_reason || '—';

  let formFieldRows = [];
  if(lead.submission_form_id){
    const { data } = await sb.from('lead_submission_form_fields')
      .select('form_id, field_key, label, field_type, options, required, placeholder, sort_order')
      .eq('form_id', lead.submission_form_id);
    formFieldRows = data || [];
  }
  const byKey = {};
  formFieldRows.forEach(f => { byKey[f.field_key] = f; });
  const optionLabels = {};
  callBackFieldOptions(lead).forEach(o => { optionLabels[o.key] = o.label; });

  const keys = lead.callback_fields_to_confirm || [];
  const container = $('callBackConfirmFields');
  container.innerHTML = keys.map(key => {
    // Every flagged field is required here regardless of the source
    // form's own `required` flag — the reviewer specifically called it
    // out as needing confirmation before this lead can go back to review.
    const def = byKey[key] || {
      field_key: key,
      label: optionLabels[key] || key,
      field_type: key === 'seller_phone' ? 'tel' : 'text',
    };
    return `<div style="margin-bottom:12px;">${fillFieldInputHtml({ ...def, required: true })}</div>`;
  }).join('');
  wireCampaignNameAutocompletes(container);
  wireGenericAddressAutocomplete(container);

  // Pre-fill with the lead's current value for each flagged field —
  // reserved keys read from their own columns, everything else from
  // extra_fields, same source data callBackFieldOptions() itself reads.
  const valueByKey = {};
  callBackFieldOptions(lead).forEach(o => { valueByKey[o.key] = o.value; });
  keys.forEach(key => {
    const el = container.querySelector(`[data-field-key="${CSS.escape(key)}"]`);
    if(!el) return;
    const current = valueByKey[key] || '';
    if(el.dataset.fieldType === 'multi'){
      String(current).split('\n').forEach(v => {
        const cb = el.querySelector(`input[type="checkbox"][value="${CSS.escape(v)}"]`);
        if(cb) cb.checked = true;
      });
    } else {
      el.value = current;
    }
  });

  $('callBackConfirmMsg').style.display = 'none';
  $('callBackConfirmModalOverlay').classList.add('active');
}
function closeCallBackConfirmModal(){
  $('callBackConfirmModalOverlay').classList.remove('active');
  callBackConfirmLead = null;
}
$('callBackConfirmCancelBtn').addEventListener('click', closeCallBackConfirmModal);
$('callBackConfirmModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'callBackConfirmModalOverlay') closeCallBackConfirmModal(); });

$('callBackConfirmSubmitBtn').addEventListener('click', async () => {
  const lead = callBackConfirmLead;
  if(!lead) return;
  const msg = $('callBackConfirmMsg');
  const fieldEls = Array.from($('callBackConfirmFields').querySelectorAll('[data-field-key]'));
  const missing = [];
  fieldEls.forEach(el => {
    const label = el.dataset.fieldLabel || el.dataset.fieldKey;
    if(el.dataset.fieldType === 'multi'){
      if(el.querySelectorAll('input[type="checkbox"]:checked').length === 0) missing.push(label);
    } else if(!el.value.trim()){
      missing.push(label);
    }
  });
  if(missing.length){
    msg.textContent = `Required: ${missing.join(', ')}.`;
    msg.style.display = '';
    return;
  }
  // BUG FIX (2026-08-14, user request): same restriction as the "Fill
  // this form" submit handler -- a Campaign Name field confirmed here has
  // to match a real, existing campaign, not an arbitrary typed value.
  const invalidCampaignField = fieldEls.find(el => el.dataset.campaignAutocomplete === '1' && el.value.trim() && !campaignNameFieldIsValid(el));
  if(invalidCampaignField){
    const label = invalidCampaignField.dataset.fieldLabel || invalidCampaignField.dataset.fieldKey;
    msg.textContent = `"${label}" must be an existing campaign — pick one from the list instead of typing a new name.`;
    msg.style.display = '';
    return;
  }
  msg.style.display = 'none';

  let sellerName = lead.seller_investor_name || null;
  let phone = lead.seller_phone || null;
  const extraFields = { ...(lead.extra_fields || {}) };
  fieldEls.forEach(el => {
    const key = el.dataset.fieldKey;
    const value = el.dataset.fieldType === 'multi'
      ? Array.from(el.querySelectorAll('input[type="checkbox"]:checked')).map(cb => cb.value).join('\n')
      : el.value.trim();
    if(key === 'seller_investor_name') sellerName = value || null;
    else if(key === 'seller_phone') phone = value || null;
    else if(value) extraFields[key] = value; else delete extraFields[key];
  });

  const { error } = await sb.from('leads').update({
    seller_investor_name: sellerName,
    seller_phone: phone,
    extra_fields: extraFields,
    status: 'pending',
    callback_reason: null,
    callback_fields_to_confirm: [],
    callback_claimed_by: null,
    callback_claimed_at: null,
    reviewed_by: null,
    reviewed_at: null,
  }).eq('id', lead.id).eq('callback_claimed_by', myUserId);
  if(error){ msg.textContent = error.message; msg.style.display = ''; return; }
  logActivity('lead.call_back_confirm', 'lead', lead.id, `Confirmed call back details — ${lead.count} lead(s) — back to Pending`);
  await loadCallBackQueue();
  closeCallBackConfirmModal();
});

// v254b: shared "view full text" popup for any table cell that used to
// need cell-clamp's fixed-height scroll box (Extra Fields, Rejected
// reason, Address, Interview summary, Call Back reason). Tables now
// render a short single-line preview plus a "View" link calling this,
// so every row stays a uniform, compact height instead of the tallest
// cell forcing extra blank space around short columns in the same row.
function openTextDetailModal(title, text){
  $('textDetailModalTitle').textContent = title;
  $('textDetailModalBody').textContent = text || '—';
  $('textDetailModalOverlay').classList.add('active');
}
$('textDetailModalCloseBtn').addEventListener('click', () => $('textDetailModalOverlay').classList.remove('active'));
$('textDetailModalOverlay').addEventListener('click', (e) => { if(e.target.id === 'textDetailModalOverlay') $('textDetailModalOverlay').classList.remove('active'); });
// One short-preview-plus-View-link renderer shared by every table cell
// that replaced cell-clamp — keeps the truncation length/escaping/click
// wiring identical everywhere instead of six near-duplicate snippets.
// `label` becomes the popup's title (e.g. "Extra Fields", "Rejected reason").
function textPreviewCellHtml(text, label){
  const full = (text || '').trim();
  if(!full) return '—';
  const preview = full.length > 40 ? full.slice(0, 40) + '…' : full;
  const needsView = full.length > 40;
  // white-space:nowrap is the part that actually matters here — a ~40
  // char preview can still wrap onto a second line if the column ends up
  // narrower than that (which most of these columns are, sharing space
  // with several others), silently making that one row taller than its
  // neighbors again. text-overflow:ellipsis is just a safety net in case
  // any caller ever passes a longer un-truncated string.
  return `<span class="text-preview-cell" data-full="${escapeHtml(full)}" data-label="${escapeHtml(label || 'Details')}" style="cursor:pointer; display:inline-block; max-width:100%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; vertical-align:bottom;">${escapeHtml(preview)}${needsView ? ' <span style="color:var(--focus); font-size:11px;">View</span>' : ''}</span>`;
}
// Delegated at the document level (once) rather than per-table — every
// text-preview-cell span, in any table rendered now or later, opens the
// same modal without each render function needing its own click wiring.
document.addEventListener('click', (e) => {
  const cell = e.target.closest('.text-preview-cell');
  if(!cell) return;
  openTextDetailModal(cell.dataset.label || 'Details', cell.dataset.full);
});

async function refreshIspeedToLeadModalStatus(leadId){
  // v129: was .limit(1) — only ever showed the single most recent send
  // attempt, with no way to see anything before it. This is the actual
  // "previous history" people expect to find here: every attempt for
  // this lead, most recent first, capped at 20 (a lead being sent this
  // many times is already an edge case worth investigating by hand, not
  // something that needs infinite scroll).
  const { data: history } = await sb.from('ispeedtolead_submissions')
    .select('id, success, created_at, error, response_status, submitted_by')
    .eq('lead_id', leadId).order('created_at', { ascending: false }).limit(20);
  const rows = history || [];
  const latest = rows[0];
  const badge = $('ispeedtoleadModalSentBadge');
  if(!latest){
    badge.textContent = 'Never sent';
  } else {
    const when = new Date(latest.created_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', ...(nonAgentDisplayTz() ? { timeZone: nonAgentDisplayTz() } : {}) });
    badge.textContent = latest.success ? `Sent successfully — ${when}` : `Last attempt failed — ${when}`;
    badge.style.color = latest.success ? 'var(--good)' : 'var(--danger)';
  }
  await renderIspeedToLeadHistory(rows);
  return latest;
}

// v129: renders every row refreshIspeedToLeadModalStatus() just fetched.
// Resolves submitted_by -> name with its own small scoped lookup (just the
// ids actually present in this lead's history, usually 0-2 people) rather
// than depending on some page-wide staff directory being loaded already —
// this modal can be the first thing opened in a session.
async function renderIspeedToLeadHistory(rows){
  const box = $('ispeedtoleadModalHistory');
  if(!box) return;
  if(!rows.length){
    box.innerHTML = '<div style="font-size:11px; color:var(--text-dim);">No send attempts yet.</div>';
    return;
  }
  const submitterIds = [...new Set(rows.map(r => r.submitted_by).filter(Boolean))];
  let nameById = {};
  if(submitterIds.length){
    const { data: submitters } = await sb.from('profiles').select('id, full_name, email').in('id', submitterIds);
    (submitters || []).forEach(p => { nameById[p.id] = p.full_name || p.email || 'Unknown'; });
  }
  const historyTz = nonAgentDisplayTz();
  box.innerHTML = rows.map(r => {
    const when = new Date(r.created_at).toLocaleString([], { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', ...(historyTz ? { timeZone: historyTz } : {}) });
    const who = r.submitted_by ? (nameById[r.submitted_by] || 'Unknown') : null;
    const statusLabel = r.success
      ? '<span style="color:var(--good);">Success</span>'
      : `<span style="color:var(--danger);">Failed${r.response_status ? ' (' + r.response_status + ')' : ''}</span>`;
    // Defensive: a handful of pre-2026-08-15 rows stored a non-string
    // error (an object) before this function always guaranteed a string --
    // coerce so old rows render readable text instead of "[object Object]".
    const errText = (!r.success && r.error) ? (typeof r.error === 'string' ? r.error : JSON.stringify(r.error)) : '';
    const errLine = errText ? `<div style="font-size:10px; color:var(--text-dim); margin-top:2px;">${escapeHtml(errText)}</div>` : '';
    return `
      <div style="display:flex; justify-content:space-between; gap:10px; padding:6px 0; border-bottom:1px solid var(--border); font-size:11px;">
        <div>
          <div>${statusLabel}${who ? ' · ' + escapeHtml(who) : ''}</div>
          ${errLine}
        </div>
        <div class="mono" style="color:var(--text-dim); white-space:nowrap;">${when}</div>
      </div>
    `;
  }).join('');
}

let ispeedtoleadModalAgentLabel = null; // v469: kept alongside ispeedtoleadModalLead so the gyhomes button below can hand both off to openGyhomesModal without re-deriving it.
async function openIspeedToLeadModal(lead, agentLabel){
