// Owner/Admin account-tier — deliberately hardcoded by name rather than
// read from roles.is_protected. That DB column now only controls whether
// a role's dashboard permissions are locked/hidden in the Roles tab
// (Admin's aren't, as of this version — see schema.sql), so it no longer
// tracks "is this an owner/admin-tier account" on its own. This constant
// is what filters these two names out of team/staff lists, account
// pickers, etc. — safe to hardcode since there's exactly one Owner and
// Admin is a fixed built-in role, neither ever renamed.
const PROTECTED_ROLES = new Set(['owner', 'admin']);
const TASK_COLORS = ['#3DDC84','#5AC8FA','#BF5AF2','#FF9F0A','#FF375F','#64D2FF','#30D158','#FFD60A'];

function $(id){ return document.getElementById(id); }
// Used anywhere free-text user input (chat messages, names) gets inserted
// via innerHTML — without this, someone typing HTML/script into a chat
// message would have it interpreted as markup instead of shown as text.
function escapeHtml(s){
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

// audit fix (audit_chunk3.md #6, Medium): escapeHtml() neutralizes HTML
// metacharacters but does nothing to stop a javascript:/data: URI from
// being placed in an href attribute -- those aren't HTML metacharacters,
// so they pass straight through. Several render sites build a clickable
// link out of externally-sourced data (a GHL webhook's ghl_calls.
// recording_url, an attachment URL pulled from a public-facing
// ghl_form_submissions.fields entry) with only escapeHtml() protecting
// the href -- if an upstream integration or a malicious public-form
// submission delivers a javascript:-scheme value, clicking the rendered
// link executes attacker script in a staff member's authenticated
// session. Only http(s) survives; anything else (including a value that
// fails to parse as a URL at all) renders as '#' with no click action.
function safeHrefUrl(u){
  try {
    const parsed = new URL(String(u ?? ''), location.href);
    return (parsed.protocol === 'http:' || parsed.protocol === 'https:') ? parsed.href : '#';
  } catch (e) {
    return '#';
  }
}

// ---------- screenshot lightbox (click a shot, browse with ← / →) ----------
const lightbox = { shots: [], index: 0 };

function renderLightbox(){
  const shot = lightbox.shots[lightbox.index];
  if(!shot) return;
  $('lightboxImg').src = shot.url;
  const lightboxTz = nonAgentDisplayTz();
  $('lightboxTime').textContent = new Date(shot.taken_at).toLocaleString([], {hour:'2-digit', minute:'2-digit', month:'short', day:'numeric', ...(lightboxTz ? { timeZone: lightboxTz } : {})});
  $('lightboxActivity').textContent = (shot.activity_pct_at_capture ?? '—') + '% activity';
  $('lightboxCounter').textContent = `${lightbox.index + 1} / ${lightbox.shots.length}`;
  $('lightboxPrevBtn').disabled = lightbox.index <= 0;
  $('lightboxNextBtn').disabled = lightbox.index >= lightbox.shots.length - 1;
}
function openLightbox(shots, index){
  if(!shots || !shots.length) return;
  lightbox.shots = shots;
  lightbox.index = index;
  renderLightbox();
  $('lightboxOverlay').classList.add('active');
}
function closeLightbox(){
  $('lightboxOverlay').classList.remove('active');
  $('lightboxImg').src = '';
}
function lightboxPrev(){ if(lightbox.index > 0){ lightbox.index--; renderLightbox(); } }
function lightboxNext(){ if(lightbox.index < lightbox.shots.length - 1){ lightbox.index++; renderLightbox(); } }

$('lightboxCloseBtn').addEventListener('click', closeLightbox);
$('lightboxOverlay').addEventListener('click', (e) => { if(e.target.id === 'lightboxOverlay') closeLightbox(); });
$('lightboxPrevBtn').addEventListener('click', lightboxPrev);
$('lightboxNextBtn').addEventListener('click', lightboxNext);
document.addEventListener('keydown', (e) => {
  if(!$('lightboxOverlay').classList.contains('active')) return;
  if(e.key === 'Escape') closeLightbox();
  else if(e.key === 'ArrowLeft') lightboxPrev();
  else if(e.key === 'ArrowRight') lightboxNext();
});

// ---------- tab switching ----------
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    // v526: Dialer is a real separate page, not an in-app section.
    // v529: both dialer pages open in a NEW TAB, so an agent on a call does
    // not lose the portal (and a live WebRTC session) by navigating away.
    //
    // CUTOVER: they are now on their OWN ORIGINS, which is the entire point
    // -- a separate origin is a separate sessionStorage, so a bug anywhere
    // in this 2.3MB file can no longer reach the session that is allowed to
    // place calls on a live carrier account. staffportal's own /dialer/ is a
    // redirect stub now (tools/publish-dialer.py --stubs), so an old
    // bookmark still lands in the right place.
    //
    // That also retires the long argument that used to live here about
    // rel="noopener". The rule was that it must NOT be set, because the
    // opener relationship is what clones this page's sessionStorage into the
    // dialer tab. Across origins nothing is cloned either way, so the rule
    // has no force left -- but noopener is still not set, for a second and
    // duller reason: window.open(..., 'noopener') returns null by
    // specification, which the popup-blocker fallback below reads as "the
    // popup was blocked" and would answer by navigating THIS tab away. The
    // destination is our own page, so the opener handle it keeps costs
    // nothing worth that.
    //
    // Consequence, deliberate: the agent signs in on the dialer once, per
    // browser session. Both consoles grew their own sign-in form for exactly
    // this, and neither could authenticate anybody before.
    // v623: the Dialer Management parent is a disclosure control, not a
    // destination -- it has no tab-panel, so falling through to
    // activateTab() would deactivate every panel and leave the content area
    // blank. Marking it active is the whole job: the subnav is revealed by
    // `.side-nav-group:has(> .tab-btn.active) .side-subnav`, and clicking any
    // other tab clears it because activateTab() toggles .active off every
    // .tab-btn that does not match.
    // v717: Client Communications is a parent like Dialer Management below:
    // it opens the first child (Client chat, Dispute/Feedback) this role sees.
    if(btn.dataset.tab === 'client_communications'){
      const first = Array.from(document.querySelectorAll('.side-subnav-cc .tab-btn')).find(b => b.style.display !== 'none');
      if(first) activateTab(first.dataset.tab);
      return;
    }
    if(btn.dataset.tab === 'dialer_management'){
      // v675: a role that can see a Dialer Admin section lands on it (the
      // parent now HAS a panel). One that only has the agent Dialer keeps the
      // old disclosure behaviour.
      if(typeof daVisibleSections === 'function' && daVisibleSections().length){
        activateTab('dialer_management');
        return;
      }
      document.querySelectorAll('.side-main-nav > .side-nav-group > .tab-btn')
        .forEach(b => b.classList.toggle('active', b === btn));
      return;
    }
    if(btn.dataset.tab === 'dialer' || btn.dataset.tab === 'dialer_admin'){
      const url = btn.dataset.tab === 'dialer'
        ? 'https://dialer.proptechnologyai.com/'
        : 'https://admin.proptechnologyai.com/';
      const w = window.open(url, '_blank');
      // Popup blockers should not strand someone with a dead button. A click
      // handler is a user gesture so this is normally allowed, but fall back
      // to same-tab nav (the old behaviour) rather than failing silently.
      if(!w) location.href = url;
      return;
    }
    activateTab(btn.dataset.tab);
  });
});

// ---------- timezone-aware day/month boundaries ----------
// Plain `new Date().setHours(0,0,0,0)` gives midnight in the ADMIN's
// browser timezone — fine for the admin's own clock, wrong for "was this
// agent's shift today or yesterday". An agent on a schedule with an
// overnight shift (e.g. 10pm–3am Cairo time) needs their day boundary
// computed in THEIR OWN schedule timezone, or hours from one side of
// midnight land on the wrong calendar day in the Staff tab, Timesheets,
// and Reports. Everything below is built on plain Intl.DateTimeFormat —
// no date library — and falls back to the browser's own local day when a
// timezone isn't available (e.g. an agent with no schedule/timezone set
// yet), which was the previous behavior everywhere anyway.

// UTC-ms offset (positive = ahead of UTC) that `timezone` has at a given
// UTC instant. Standard Intl-only technique for reading a zone's offset.
function tzOffsetMsAt(utcMs, timezone){
  const parts = new Intl.DateTimeFormat('en-US', {
    timeZone: timezone, hour12: false,
    year: 'numeric', month: '2-digit', day: '2-digit',
    hour: '2-digit', minute: '2-digit', second: '2-digit',
  }).formatToParts(new Date(utcMs)).reduce((acc, p) => { acc[p.type] = p.value; return acc; }, {});
  let hour = parseInt(parts.hour, 10);
  if(hour === 24) hour = 0; // some locales format midnight as "24:00"
  const asUtc = Date.UTC(parseInt(parts.year, 10), parseInt(parts.month, 10) - 1, parseInt(parts.day, 10), hour, parseInt(parts.minute, 10), parseInt(parts.second, 10));
  return asUtc - utcMs;
}

// UTC epoch ms for the wall-clock date/time (y, month 1-12, day, h, m, s)
// as it would read in `timezone`. The building block everything else here
// is made of — e.g. "what UTC instant is 2026-07-03 00:00:00 in
// Africa/Cairo".
function zonedTimeToUtcMs(y, mo, day, hour, min, sec, timezone){
  hour = hour || 0; min = min || 0; sec = sec || 0;
  if(!timezone) return new Date(y, mo - 1, day, hour, min, sec, 0).getTime();
  const guessUtcMs = Date.UTC(y, mo - 1, day, hour, min, sec, 0);
  // DST FIX: must match extension/modules/schedule.js's zonedTimeToUtcMs
  // exactly -- a single offset lookup at the naive guess picks whichever
  // side of a DST transition that instant happens to fall on, which is
  // wrong on the calendar day a zone springs forward/falls back.
  // Re-resolving the offset AT the first-pass corrected instant converges
  // to the correct side.
  const utc1 = guessUtcMs - tzOffsetMsAt(guessUtcMs, timezone);
  return guessUtcMs - tzOffsetMsAt(utc1, timezone);
}

// Start/end (UTC ms) of one local calendar day in `timezone`. With no
// y/mo/day given, uses "today" as of `refDate` (default now) AS SEEN IN
// THAT ZONE — not the browser's own today, which is the whole point.
function dayBoundsMsInZone(timezone, refDate, y, mo, day){
  if(y == null){
    refDate = refDate || new Date();
    if(timezone){
      const p = new Intl.DateTimeFormat('en-US', { timeZone: timezone, year: 'numeric', month: '2-digit', day: '2-digit' })
        .formatToParts(refDate).reduce((acc, x) => { acc[x.type] = x.value; return acc; }, {});
      y = parseInt(p.year, 10); mo = parseInt(p.month, 10); day = parseInt(p.day, 10);
    } else {
      y = refDate.getFullYear(); mo = refDate.getMonth() + 1; day = refDate.getDate();
    }
  }
  const startMs = zonedTimeToUtcMs(y, mo, day, 0, 0, 0, timezone);
  const endMs = zonedTimeToUtcMs(y, mo, day, 23, 59, 59, timezone) + 999;
  return { startMs, endMs };
}

// Start/end (UTC ms) of a whole calendar month in `timezone`.
function monthBoundsMsInZone(y, mo, timezone){
  const daysInMonth = new Date(y, mo, 0).getDate(); // plain calendar arithmetic — not timezone-sensitive
  const startMs = zonedTimeToUtcMs(y, mo, 1, 0, 0, 0, timezone);
  const endMs = zonedTimeToUtcMs(y, mo, daysInMonth, 23, 59, 59, timezone) + 999;
  return { startMs, endMs, daysInMonth };
}

// v1.2.9: work-day / work-week boundaries honoring the agent's timezone AND
// their cutover hour (default 6). MUST match the extension's workDayStartMs/
// workWeekStartMs exactly — the extension enforces limits, this displays them.
function ymdInZoneDash(utcMs, timezone){
  const p = new Intl.DateTimeFormat('en-US', { timeZone: timezone || 'UTC', year:'numeric', month:'2-digit', day:'2-digit' })
    .formatToParts(new Date(utcMs)).reduce((a,x)=>{a[x.type]=x.value;return a;},{});
  return { y:+p.year, mo:+p.month, d:+p.day };
}
function workDayStartMsDash(schedule, nowMs){
  nowMs = nowMs || Date.now();
  const tz = (schedule && schedule.timezone) || null;
  const cutover = (schedule && Number.isInteger(schedule.day_cutover_hour)) ? schedule.day_cutover_hour : 6;
  const { y, mo, d } = ymdInZoneDash(nowMs, tz);
  let boundary = zonedTimeToUtcMs(y, mo, d, cutover, 0, 0, tz);
  if(nowMs < boundary){
    // DST FIX: must match workDayStartMs in extension/modules/schedule.js
    // exactly -- re-resolve yesterday's cutover against its own calendar
    // date instead of blindly subtracting a flat 24h.
    const prev = new Date(Date.UTC(y, mo - 1, d - 1));
    boundary = zonedTimeToUtcMs(prev.getUTCFullYear(), prev.getUTCMonth() + 1, prev.getUTCDate(), cutover, 0, 0, tz);
  }
  return boundary;
}
function workWeekStartMsDash(schedule, nowMs){
  nowMs = nowMs || Date.now();
  const tz = (schedule && schedule.timezone) || null;
  const dayStart = workDayStartMsDash(schedule, nowMs);
  const { y, mo, d } = ymdInZoneDash(dayStart + 12*3600*1000, tz);
  const dow = new Date(Date.UTC(y, mo-1, d)).getUTCDay();
  const daysSinceMon = (dow + 6) % 7; // Mon=0
  return dayStart - daysSinceMon*24*3600*1000;
}

// 'YYYY-MM-DD' local calendar date for a given instant, in `timezone` —
// for bucketing entries by the day the AGENT would recognize (e.g.
// chopped-session detection), not the browser's zone.
// Gap-#1 fix: previously fell back to UTC when no timezone was known for an
// agent, which was yet another basis for "the same day" than the rest of
// the app. Now falls back to the same standardized Africa/Cairo basis used
// everywhere else an unscheduled agent's "today"/"this week" is computed.
function localDateKeyInZone(dateInput, timezone){
  const d = new Date(dateInput);
  const p = new Intl.DateTimeFormat('en-US', { timeZone: timezone || FALLBACK_TIMEZONE, year: 'numeric', month: '2-digit', day: '2-digit' })
    .formatToParts(d).reduce((acc, x) => { acc[x.type] = x.value; return acc; }, {});
  return `${p.year}-${p.month}-${p.day}`;
}

// Gap-#1 fix: when an agent has no `schedules` row (or it's missing a
// timezone), EVERY part of the system must fall back to the SAME clock.
// We standardize on Africa/Cairo (the org's home base), Monday 8 AM cutover
// — this MUST match the extension's FALLBACK_TIMEZONE/FALLBACK_CUTOVER_HOUR
// in background.js exactly, for the same reason workDayStartMs/
// workWeekStartMs have to match: the extension enforces limits using this
// basis, the dashboard only displays them.
const FALLBACK_TIMEZONE = 'Africa/Cairo';
const FALLBACK_CUTOVER_HOUR = 8;

// Previously used the ADMIN'S OWN BROWSER's local midnight, which meant an
// unscheduled agent's "today" could shift by a day depending on which admin
// was looking, and where they were. Now pinned to the Africa/Cairo calendar
// day, same basis as weekStartCairoISO() below.
function todayRangeISO(){
  const { startMs, endMs } = dayBoundsMsInZone(FALLBACK_TIMEZONE);
  return { start: new Date(startMs).toISOString(), end: new Date(endMs).toISOString(), dayStartMs: startMs };
}
// Resolves Africa/Cairo's CURRENT UTC offset in minutes (handles Egypt's
// own DST rules automatically rather than a hardcoded +2/+3) by asking
// Intl for the zone's short offset at a given instant, e.g. "GMT+2".
function cairoUtcOffsetMinutes(date){
  const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'Africa/Cairo', timeZoneName: 'shortOffset' }).formatToParts(date);
  const tzPart = (parts.find(p => p.type === 'timeZoneName') || {}).value || 'GMT+2';
  const m = tzPart.match(/GMT([+-]\d+)(?::(\d+))?/);
  if(!m) return 120; // fallback: Cairo standard time, UTC+2
  const hours = parseInt(m[1], 10);
  const mins = m[2] ? parseInt(m[2], 10) : 0;
  return hours * 60 + (hours < 0 ? -mins : mins);
}

// Most recent Monday 08:00 Africa/Cairo time at-or-before now, as a UTC
// ISO instant — the shared "week start" boundary for weekly work-hour
// limits and the Audit Log's "This week" filter. This is deliberately
// pinned to Africa/Cairo (not the admin's own browser timezone) so the
// reset lands at the same real-world moment no matter where an admin is
// viewing the dashboard from, and a late-night shift that crosses local
// midnight no longer lands the reset at an awkward point mid-shift —
// replaces the previous Sunday-00:00-local boundary.
function weekStartCairoISO(){
  const now = new Date();
  const offsetMin = cairoUtcOffsetMinutes(now);
  const cairoNow = new Date(now.getTime() + offsetMin * 60000); // wall-clock Cairo time, expressed as a UTC-flavored Date
  const weekday = cairoNow.getUTCDay(); // 0=Sun..6=Sat, in Cairo wall-clock terms
  let daysSinceMonday = (weekday + 6) % 7; // Mon->0, Tue->1, ..., Sun->6
  const cairoMinutesNow = cairoNow.getUTCHours() * 60 + cairoNow.getUTCMinutes();
  // Still Monday but before the cutover hour Cairo time — the week hasn't
  // reset yet, so the real boundary is last Monday, a further 7 days back.
  if(daysSinceMonday === 0 && cairoMinutesNow < FALLBACK_CUTOVER_HOUR * 60) daysSinceMonday = 7;
  const boundaryCairoWallMs = Date.UTC(cairoNow.getUTCFullYear(), cairoNow.getUTCMonth(), cairoNow.getUTCDate() - daysSinceMonday, FALLBACK_CUTOVER_HOUR, 0, 0, 0);
  return new Date(boundaryCairoWallMs - offsetMin * 60000).toISOString();
}
// Gap-#1 fix: previously the admin's own browser local month — pinned to
// Africa/Cairo so an unscheduled agent's monthly lead-bonus window (see
// leads.submitted_at gte checks below) agrees with the extension's
// startOfMonthISO(), regardless of which admin/device is viewing.
function startOfMonthISO(){
  const p = new Intl.DateTimeFormat('en-US', { timeZone: FALLBACK_TIMEZONE, year: 'numeric', month: '2-digit' })
    .formatToParts(new Date()).reduce((a, x) => { a[x.type] = x.value; return a; }, {});
  const { startMs } = monthBoundsMsInZone(+p.year, +p.month, FALLBACK_TIMEZONE);
  return new Date(startMs).toISOString();
}
function fmtShort(sec){
  sec = Math.max(0, Math.round(sec));
  const h = Math.floor(sec/3600), m = Math.floor((sec%3600)/60);
  return h>0 ? h+'h '+m+'m' : m+'m';
}
// Live, second-resolution duration for the real-time status timer (e.g.
// "1m 23s", "1h 04m 09s"). Kept separate from fmtShort (which is minute-
// resolution) so the status column can tick every second.
function fmtDurationLive(sec){
  sec = Math.max(0, Math.round(sec));
  const h = Math.floor(sec/3600), m = Math.floor((sec%3600)/60), s = sec%60;
  if(h>0) return `${h}h ${String(m).padStart(2,'0')}m ${String(s).padStart(2,'0')}s`;
  if(m>0) return `${m}m ${String(s).padStart(2,'0')}s`;
  return `${s}s`;
}
// v1.2.5: ticks every second, updating the parenthesised duration on each
// status cell from its data-since timestamp — WITHOUT re-fetching (the full
// team refetch stays on its 20s poll). Cheap DOM-text update only.
let statusTimerTickHandle = null;
function updateStatusTimers(){
  const now = Date.now();
  document.querySelectorAll('.live-status-timer').forEach(el => {
    const since = Number(el.getAttribute('data-since'));
    if(!since) return;
    el.textContent = `(${fmtDurationLive((now - since)/1000)})`;
  });
}
function startStatusTimerTicker(){
  if(statusTimerTickHandle) return; // already running
  statusTimerTickHandle = setInterval(() => { if(!document.hidden) updateStatusTimers(); }, 1000); // v676: idle while hidden
}

// ---------- v1.2.9: automatic chat presence ----------
// Presence is driven by a heartbeat from the open dashboard tab:
//   signed in + tab focused + active in the last 10 min -> active
//   signed in + tab hidden/blurred, OR no activity for 10+ min -> away
//   signed out               -> offline (written on sign-out)
// Viewers additionally treat anyone whose last_seen_at is stale (>90s) as
// offline, so a closed/crashed/slept browser self-heals. A deliberate manual
// override (busy / dnd) is stored separately and is NEVER overwritten by the
// heartbeat — it wins until the user clears it back to Auto.
const PRESENCE_HEARTBEAT_MS = 30000;   // write cadence
const PRESENCE_STALE_MS = 180000;      // v1.2.9: 3 min — older than this = treated as offline (widened from 90s so brief connection blips don't flicker someone offline)
let presenceHeartbeatHandle = null;

// v1.2.25: idle detection — a user who leaves the portal open (tab still
// focused/visible) but doesn't touch it for a while shouldn't keep showing
// as "active" to everyone else. Any real interaction resets the clock;
// once 10 minutes pass with none, the next heartbeat reports them as away.
const IDLE_AWAY_MS = 10 * 60 * 1000; // 10 minutes
let lastActivityAt = Date.now();
function markUserActivity(){ lastActivityAt = Date.now(); }
['mousemove', 'mousedown', 'keydown', 'wheel', 'touchstart', 'scroll'].forEach(evt => {
  window.addEventListener(evt, markUserActivity, { passive: true, capture: true });
});

function currentAutoStatus(){
  // 'away' when the tab isn't visible/focused, or when it is but the user
  // hasn't interacted with it in the last IDLE_AWAY_MS; 'active' otherwise.
  if(document.visibilityState !== 'visible' || !document.hasFocus()) return 'away';
  if(Date.now() - lastActivityAt >= IDLE_AWAY_MS) return 'away';
  return 'active';
}

async function writeHeartbeat(){
  if(!sb || !myUserId) return;
  const patch = {};
  // v702: a status set to "clear after" a while clears itself here.
  if(myStatusUntil && Date.now() > new Date(myStatusUntil).getTime()){
    myChatStatusManual = null; myStatusText = null; myStatusEmoji = null; myStatusUntil = null;
    Object.assign(patch, { chat_status_manual: null, status_text: null, status_emoji: null, status_until: null });
  }
  // If the user set a manual override, keep chat_status on that; otherwise
  // reflect the auto state. v702: 'Appear offline' is written as offline,
  // and WITHOUT a fresh last_seen_at, which would give them away.
  const auto = currentAutoStatus();
  const effective = myChatStatusManual === 'invisible' ? 'offline' : (myChatStatusManual || auto);
  myChatStatus = effective;
  patch.chat_status = effective;
  if(myChatStatusManual !== 'invisible') patch.last_seen_at = new Date().toISOString();
  try {
    await sb.from('profiles').update(patch).eq('id', myUserId);
  } catch(e){ /* heartbeat is best-effort; next tick retries */ }
}

function startPresenceHeartbeat(){
  if(presenceHeartbeatHandle) return;
  writeHeartbeat(); // immediate on start
  presenceHeartbeatHandle = setInterval(writeHeartbeat, PRESENCE_HEARTBEAT_MS);
  // react immediately to focus/visibility changes (don't wait for the tick)
  document.addEventListener('visibilitychange', writeHeartbeat);
  window.addEventListener('focus', writeHeartbeat);
  window.addEventListener('blur', writeHeartbeat);
}
function stopPresenceHeartbeat(){
  if(presenceHeartbeatHandle){ clearInterval(presenceHeartbeatHandle); presenceHeartbeatHandle = null; }
}

// Given a person's stored status + freshness + manual override, what should a
// VIEWER show? This is the single source of truth for rendered presence.
function derivePresence(person){
  if(!person) return 'offline';
  // v702: a status set to clear after a while stops counting once it has,
  // even before its owner's page gets round to clearing it.
  const expired = !!(person.status_until && Date.now() > new Date(person.status_until).getTime());
  const manual = expired ? null : person.chat_status_manual;
  if(manual === 'invisible') return 'offline';   // 'Appear offline'
  let stored = person.chat_status || 'offline';
  if(stored === 'offline') return 'offline';
  // stale heartbeat -> offline (self-heal). v702: this now applies to Busy,
  // Do not disturb and Be right back too -- someone who signed out, or whose
  // laptop is shut, is offline, whatever they had chosen.
  const seen = person.last_seen_at ? new Date(person.last_seen_at).getTime() : 0;
  if(!seen || (Date.now() - seen) > PRESENCE_STALE_MS) return 'offline';
  if(manual === 'busy' || manual === 'dnd' || manual === 'brb') return manual; // deliberate override
  if(stored === 'busy' || stored === 'dnd' || stored === 'brb') stored = 'active'; // an expired override, still stored
  return stored; // 'active' or 'away'
}
function fmtHM(sec){
  sec = Math.max(0, Math.round(sec));
  const h = Math.floor(sec/3600), m = Math.floor((sec%3600)/60);
  return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;
}
// Same dot-separated numeric compare the extension itself uses
// (background.js's compareVersions) to decide whether an agent's
// self-reported extension_version is below the configured minimum.
function compareVersionStrings(a, b){
  const pa = String(a).split('.').map(n => parseInt(n, 10) || 0);
  const pb = String(b).split('.').map(n => parseInt(n, 10) || 0);
  const len = Math.max(pa.length, pb.length);
  for(let i = 0; i < len; i++){
    const diff = (pa[i] || 0) - (pb[i] || 0);
    if(diff !== 0) return diff < 0 ? -1 : 1;
  }
  return 0;
}
// LOW FIX (audit_chunk1.md #4): findIndex() returns -1 when id isn't found
// in list (stale reference, deleted task, race between two fetches) --
// Math.max(0,-1) used to clamp that to 0, silently rendering the same
// color as whatever the first item in list happens to be instead of a
// distinguishable "unknown" fallback.
function colorFor(id, list){
  const idx = list.findIndex(x=>x.id===id);
  if (idx === -1) return '#8E8E93'; // neutral gray -- distinct from every real TASK_COLORS entry
  return TASK_COLORS[idx % TASK_COLORS.length];
}

// ---------- export utilities (CSV + PDF), reused by Staff and Timesheets ----------
function exportCSV(filename, headers, rows){
  const escapeCell = v => {
    const s = String(v ?? '');
    return /[",\n]/.test(s) ? '"' + s.replace(/"/g,'""') + '"' : s;
  };
  const lines = [headers.map(escapeCell).join(',')]
    .concat(rows.map(r => r.map(escapeCell).join(',')));
  const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

async function exportPDF(title, headers, rows){
  try { await ensureJsPdf(); } catch(e){ /* reported just below */ }
  if(!window.jspdf){
    alert('PDF export library failed to load — check your internet connection and try again.');
    return;
  }
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ orientation: rows.length && headers.length > 6 ? 'landscape' : 'portrait' });
  doc.setFontSize(14);
  doc.text(title, 14, 16);
  doc.setFontSize(9);
  doc.setTextColor(120);
  const exportPdfTz = nonAgentDisplayTz();
  doc.text(`Generated ${new Date().toLocaleString([], exportPdfTz ? { timeZone: exportPdfTz } : {})}`, 14, 22);
  doc.autoTable({
    head: [headers],
    body: rows,
    startY: 28,
    styles: { fontSize: 8, cellPadding: 3 },
    headStyles: { fillColor: [23, 27, 35] },
    theme: 'striped',
  });
  doc.save(title.toLowerCase().replace(/\s+/g,'-') + '.pdf');
}

// ---------- activity log ----------
async function logActivity(action, targetType, targetId, details){
  try{
    const { data: { user } } = await sb.auth.getUser();
    if(!user) return;
    await sb.from('activity_log').insert({
      admin_id: user.id, action, target_type: targetType || null,
      target_id: targetId || null, details: details || null,
    });
  }catch(e){
    console.error('Failed to log activity', e); // never block the actual action on this
  }
}

// Loads the profile + role for `user`, populates every my*/permissions
// global, and reveals the app. Two callers: an explicit sign-in (doLogin,
// isNewLogin:true — logs an auth.login activity row) and the boot script
// resuming an existing sessionStorage-persisted session on page load
// (isNewLogin:false — does not, since nothing new actually happened).
// Throws on a real problem (e.g. no dashboard access); callers decide what
// to do with that.
// ---------- v319: forced password rotation ----------
const PASSWORD_MAX_AGE_DAYS = 30;
function isPasswordExpired(changedAt){
  if(!changedAt) return true;
  return (Date.now() - new Date(changedAt).getTime()) > PASSWORD_MAX_AGE_DAYS * 24 * 60 * 60 * 1000;
}
let forcePasswordUser = null;
function showForcePasswordScreen(user, reason){
  forcePasswordUser = user;
  $('forcePasswordNew').value = '';
  $('forcePasswordConfirm').value = '';
  $('forcePasswordMsg').textContent = '';
  $('forcePasswordMsg').className = 'msg';
  $('forcePasswordReason').textContent = reason === 'new'
    ? 'This is your first sign-in with this password — choose a new one to continue.'
    : `For security, passwords need to be changed every ${PASSWORD_MAX_AGE_DAYS} days. Choose a new one to continue.`;
  showLoginPanel('forcePasswordScreen');
  $('loginScreen').style.display = 'block';
  $('forcePasswordNew').focus();
}
$('forcePasswordBtn').addEventListener('click', async () => {
  const p1 = $('forcePasswordNew').value;
  const p2 = $('forcePasswordConfirm').value;
  const msg = $('forcePasswordMsg');
  if(!p1 || p1.length < 8){
    msg.textContent = 'Password must be at least 8 characters.';
    msg.className = 'msg error';
    return;
  }
  if(p1 !== p2){
    msg.textContent = 'Passwords don’t match.';
    msg.className = 'msg error';
    return;
  }
  const btn = $('forcePasswordBtn');
  const originalLabel = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Saving…';
  try{
    const { error: pwErr } = await sb.auth.updateUser({ password: p1 });
    if(pwErr) throw pwErr;
    const user = forcePasswordUser;
    const { error: profErr } = await sb.from('profiles').update({
      must_change_password: false,
      password_changed_at: new Date().toISOString(),
    }).eq('id', user.id);
    if(profErr) throw profErr;
    forcePasswordUser = null;
    await establishSession(user, { isNewLogin: true });
  }catch(e){
    msg.textContent = e.message || 'Could not update password.';
    msg.className = 'msg error';
    btn.disabled = false;
    btn.textContent = originalLabel;
  }
});

// ---- Time Management extension: session handover (extension v1.2.53) ----
//
// The extension keeps its OWN Supabase session, separate from this page's.
// Changing a password — which v319's 30-day rotation forces on everyone —
// makes GoTrue revoke every refresh token for the account, the extension's
// included, and the extension then silently loses the ability to read or
// write anything at all. One agent lost 28 hours to exactly that: a
// backlog of unsynced writes and a task list that wouldn't load, with no
// indication why. Since we have just authenticated this same person, hand
// their extension a fresh single-use token so it can mint its own new
// session and carry on without a re-login.
//
// Deliberately best-effort and non-blocking. No extension installed, a
// different browser, an agent who has never signed into the extension, a
// network blip — all normal, all silent, none of them may affect sign-in.
//
// The token is minted by the extension-session-handover Edge Function
// strictly for the calling account (it accepts no parameters at all), and
// it is the EXTENSION, not this page, that redeems it — so the tokens it
// ends up holding are its own and never pass through the browser page.
// It cannot sign anybody in and cannot switch which account the extension
// tracks; it only re-tokenizes an existing session for the same user.
const TIME_EXTENSION_ID = 'ejpaamckgoggmegolclnifbmdnbnlmei';
async function handOverSessionToExtension(){
  try{
    // chrome.runtime is only exposed to a page when an installed extension
    // names it in externally_connectable, so this doubles as the "is the
    // extension even here" check.
    if(!(window.chrome && chrome.runtime && chrome.runtime.sendMessage)) return;
    const { data, error } = await sb.functions.invoke('extension-session-handover', { body: {} });
    if(error || !data || !data.ok || !data.tokenHash) return;
    chrome.runtime.sendMessage(TIME_EXTENSION_ID, {
      type: 'SESSION_HANDOVER',
      tokenHash: data.tokenHash,
      userId: data.userId,
    }, () => {
      // Touching lastError is what suppresses Chrome's "Unchecked
      // runtime.lastError" console noise when the extension isn't
      // installed or is disabled. Nothing to do about it either way.
      void chrome.runtime.lastError;
    });
  }catch(e){ /* never let this affect sign-in */ }
}

async function establishSession(user, { isNewLogin = true } = {}){
  const { data: profile } = await sb.from('profiles').select('role, full_name, avatar_url, chat_status, chat_status_manual, status_text, status_emoji, status_until, must_change_password, password_changed_at, department, title, grade').eq('id', user.id).single();
  // v812 (W3): the second sign-in step comes first -- before the forced
  // password change below, so a stolen password cannot set a new one
  // without the code. Returns true while the code panel is showing; its
  // Verify button calls establishSession() again once the code is right.
  if(await mfaSignInStep(user, profile?.role || '', { isNewLogin })) return;
  // v319: forced password rotation -- intercepted here, before any role/
  // permission loading or app reveal, on every call to establishSession(),
  // whether from a fresh sign-in or the boot script resuming an existing
  // sessionStorage-persisted session -- so a forced-change requirement is
  // never bypassed just by refreshing instead of logging in fresh.
  // Two independent triggers: must_change_password (a brand-new account,
  // or one an Owner/Admin just reset — see manage-user's create_user/
  // set_password) and a stale password_changed_at (30+ days, or never
  // set at all for an account created before this feature existed and
  // not yet caught by the v319 migration's backfill). Either one shows
  // the same forced-change screen instead of proceeding.
  if(profile && (profile.must_change_password || isPasswordExpired(profile.password_changed_at))){
    showForcePasswordScreen(user, profile.must_change_password ? 'new' : 'expired');
    return;
  }
  const { data: roleRow, error: roleErr } = await sb.from('roles').select('name, allowed_tabs, can_manage_users, is_protected, tab_edit, view_scope, viewable_user_ids, viewable_role, um_sections, activity_sections, leads_sections, csub_sections, finance_sections, hr_sections, dialer_admin_sections, can_manage_dialer, can_review_calls, data_science_sections, taxes_sections, time_management_sections, task_category_ids, can_text_clients, can_edit_compensation, can_manual_dial').eq('name', profile?.role || '').maybeSingle();
  // v41 fix: a genuine query failure (e.g. activity_sections not existing
  // yet because the newest supabase/schema.sql migration hasn't been run)
  // used to be silently treated the same as "no matching role row" —
  // roleRow just came back undefined either way, which for a non-owner
  // fell straight into the generic "This account doesn't have dashboard
  // access" message below. That's misleading for what's actually a schema
  // problem, not a permissions one, and for an Owner (who bypasses that
  // check) it silently defaulted every um_sections/activity_sections-gated
  // permission to {} instead of surfacing anything was wrong at all.
  // maybeSingle() returns error:null for a genuine zero-row match, so
  // checking roleErr specifically (not just "no roleRow") only catches
  // real failures.
  if(roleErr){
    await sb.auth.signOut();
    const schemaErr = new Error(`Couldn't load role permissions: ${roleErr.message}. This usually means a database migration hasn't been run yet — check supabase/schema.sql.`);
    schemaErr.code = 'role_query_failed';
    throw schemaErr;
  }
  // Dashboard access = this role has at least one allowed tab — not a
  // hardcoded role-name check, so any custom role an Owner creates with
  // at least one tab checked works here automatically. 'agent' is
  // seeded with an empty allowed_tabs array, which is what actually
  // keeps plain agents out.
  const isOwnerRole = profile?.role === 'owner';
  if(!isOwnerRole && (!roleRow || !Array.isArray(roleRow.allowed_tabs) || roleRow.allowed_tabs.length === 0)){
    await sb.auth.signOut();
    const noAccessErr = new Error('This account doesn\u2019t have dashboard access.');
    noAccessErr.code = 'no_dashboard_access';
    throw noAccessErr;
  }
  myRole = roleRow?.name || 'owner';
  // v776: one person can be granted (or denied) something their user type
  // does not say, without inventing a user type for them. NULL/absent in the
  // override means "inherit the user type"; a section map merges over the
  // role's one section key at a time, so the override only carries the
  // difference. Best-effort: if this table is missing (migration not run
  // yet) the role alone decides, exactly as before.
  let overrideRow = null;
  try {
    const { data: ovr } = await sb.from('user_permission_overrides').select('*').eq('user_id', user.id).maybeSingle();
    overrideRow = ovr || null;
  } catch(e) { /* pre-v776 database — role-only permissions */ }
  // Shallow merge, which is exactly per-section-key.
  const _sec = (family) => Object.assign({}, roleRow?.[family] || {}, overrideRow?.[family] || {});
  // A boolean override only counts when it is actually a boolean; NULL means
  // inherit, and `false` has to survive (that is how an Owner takes one
  // permission away from one person).
  const _flag = (name) => typeof overrideRow?.[name] === 'boolean' ? overrideRow[name] : !!roleRow?.[name];
  myHasPermissionOverride = !!overrideRow;
  myPermissions = {
    // Owner always gets every tab the app currently knows about — including
    // ones added after this role's allowed_tabs row in the DB was last
    // saved — rather than being limited to whatever is checked in the
    // Roles tab. Every other role still goes strictly by its DB row.
    // v776: a per-person allowed_tabs REPLACES the role's list rather than
    // merging — the editor pre-fills from the user type, so the boxes on
    // screen are the whole answer.
    allowedTabs: isOwnerRole ? DASHBOARD_TAB_KEYS.map(t => t.key) : (Array.isArray(overrideRow?.allowed_tabs) ? overrideRow.allowed_tabs : roleRow.allowed_tabs),
    canManageUsers: isOwnerRole ? true : !!roleRow?.can_manage_users,
    isProtected: isOwnerRole ? true : !!roleRow?.is_protected,
    tabEdit: _sec('tab_edit'),
    viewScope: roleRow?.view_scope || 'all',
    viewableUserIds: roleRow?.viewable_user_ids || [],
    umSections: _sec('um_sections'),
    activitySections: _sec('activity_sections'),
    leadsSections: _sec('leads_sections'),
    csubSections: _sec('csub_sections'),
    financeSections: _sec('finance_sections'),
    hrSections: _sec('hr_sections'),
    dialerAdminSections: _sec('dialer_admin_sections'), // v675, per-person since v776
    dataScienceSections: _sec('data_science_sections'),
    taxesSections: _sec('taxes_sections'),
    timeManagementSections: _sec('time_management_sections'),
    // v194: gates the manual "text this client back" composer in Client
    // Chats — Owner/Admin always have it, any other role only if this
    // was checked for them in User Types.
    // v776: was `myRole === 'admin' || column`, which meant an Owner turning
    // this off for Admin had no effect. Admin is read from its own row like
    // everybody else now; the v776 migration wrote today's effective value
    // into that row first, so nothing changes until the Owner unticks it.
    canTextClients: isOwnerRole ? true : _flag('can_text_clients'),
    // v499: narrower than canManageUsers -- gates the pay-related fields on
    // a user's Schedule tab specifically (hourly rate/bonus/extra tiers/pay
    // model/salary tiers), not the rest of that tab's schedule/hours
    // fields. Same isOwnerRole/admin-always-true shape as canTextClients.
    // v776: same as canTextClients above — admin's own row decides.
    canEditCompensation: isOwnerRole ? true : _flag('can_edit_compensation'),
    // v778: what an Admin may hand out. Owner and Admin can always dial
    // themselves (dialer_manual_dial_allowed); this is only the grant ceiling.
    canManualDial: isOwnerRole ? true : _flag('can_manual_dial'),
  };
  myIsOwner = myRole === 'owner';
  // v776: the ceiling is simply "what I hold myself". Owner has none.
  myGrantCeiling = myIsOwner ? null : {
    allowedTabs: myPermissions.allowedTabs || [],
    tab_edit: myPermissions.tabEdit,
    um_sections: myPermissions.umSections,
    activity_sections: myPermissions.activitySections,
    leads_sections: myPermissions.leadsSections,
    csub_sections: myPermissions.csubSections,
    finance_sections: myPermissions.financeSections,
    hr_sections: myPermissions.hrSections,
    data_science_sections: myPermissions.dataScienceSections,
    taxes_sections: myPermissions.taxesSections,
    time_management_sections: myPermissions.timeManagementSections,
    dialer_admin_sections: myPermissions.dialerAdminSections,
    can_text_clients: !!myPermissions.canTextClients,
    can_edit_compensation: !!myPermissions.canEditCompensation,
    can_manual_dial: !!myPermissions.canManualDial,
  };
  myFullName = profile?.full_name || '';
  myTitle = profile?.title || '';           // v639
  if(typeof renderProfileMenu === 'function') renderProfileMenu(); // v641
  myDepartment = profile?.department || ''; // v639
  myEmail = user.email;
  myUserId = user.id;
  myAvatarUrl = profile?.avatar_url || null;
  myGrade = profile?.grade || null;   // v717
  if(typeof renderProfileMenu === 'function') renderProfileMenu();   // v702: the photo on the menu button
  setTimeout(() => { if(typeof avatarAutoShrink === 'function') avatarAutoShrink(); }, 8000);   // v704
  myChatStatus = profile?.chat_status || 'offline';
  myChatStatusManual = ['busy', 'dnd', 'brb', 'invisible'].includes(profile?.chat_status_manual) ? profile.chat_status_manual : null;
  // v702: the status message, and when the whole status clears.
  myStatusText = profile?.status_text || null;
  myStatusEmoji = profile?.status_emoji || null;
  myStatusUntil = profile?.status_until || null;

  // v144: populated here (not just on first visit to Activity or User
  // Management > Tasks) so ACTIVITY_SECTIONS' per-task Extension entries
  // — and therefore the User Management role editor's per-task
  // checkboxes — are correct from the very first tab this session
  // touches, regardless of which tab that happens to be. Best-effort:
  // failing silently just means the pills populate a little later, on
  // whichever of initActivityTab()/loadTasksList() runs first instead.
  sb.from('tasks').select('id, name, archived_at').order('name')
    .then(({ data }) => refreshExtensionTaskSections(data || []))
    .catch(() => {});

  // The header's "last login" line — this account's most recent PRIOR
  // sign-in, fetched before the row for THIS session gets inserted just
  // below. Applies to every role: relies on the "activity_log: self
  // select" RLS policy (schema.sql), separate from the Owner-only
  // Audit Log tab's broader audit-trail access, so it works the same for
  // every account regardless of which tabs their role can see.
  let previousLoginAt = null;
  try{
    const { data: priorLogins } = await sb.from('activity_log')
      .select('created_at').eq('admin_id', user.id).eq('action', 'auth.login')
      .order('created_at', { ascending: false }).limit(1);
    previousLoginAt = (priorLogins && priorLogins[0]) ? priorLogins[0].created_at : null;
  }catch(e){ /* header greeting is a nicety, never block login over it */ }

  applyRolePermissionsToNav();
  applyEditGating();
  startPendingCounts(isNewLogin);   // v723: Leads sub-tab counts + Desouky's sign-in reminder
  // v96 item 4: Export CSV / Download buttons on Leads and Client
  // Submissions are Owner/Admin only, independent of any role's tab/section
  // Edit grants — applied once here for the static buttons; dynamically
  // rendered ones (e.g. per-row Skiptracing Download buttons) re-apply this
  // themselves right after rendering (see renderCsubSectionTable()).
  applyOwnerAdminExportGating();
  // SECURITY/UX FIX (Campaigns tab deep-scan finding): this button only
  // ever carried the whole-tab "edit-only" class, gated by
  // canEditTab('client_submissions') -- which defaults TRUE for every
  // role with the Campaigns tab at all (no role currently has it
  // explicitly turned off). staff-create-campaign's own access check
  // used to hard-reject everyone except literal owner/admin regardless,
  // so a sales/agent-role staff member saw a fully enabled "+ New
  // Campaign" button that could only ever fail with a raw 403 error --
  // same "looks enabled, isn't" class applyOwnerAdminExportGating above
  // already exists to prevent, just never applied here.
  //
  // v500: the backend was loosened on request to be grantable to a
  // specific user type rather than staying owner/admin-locked forever --
  // reuses csub_sections.campaign.edit (canEditCsubSection('campaign'),
  // the existing "Campaign Details" sub-tab Edit permission already in
  // the Roles editor) as the grant, so this button's visibility now
  // matches the backend's check exactly instead of independently
  // hardcoding owner/admin here.
  if($('csubNewCampaignBtn')) $('csubNewCampaignBtn').style.display = (myIsOwner || myRole === 'admin' || canEditCsubSection('campaign')) ? '' : 'none';
  $('loginScreen').style.display = 'none';
  $('app').style.display = 'block';
  applyUserGreeting(previousLoginAt);
  initChatWidget();
  // v453: Dashboard moved from allowedTabs (top-level tab) to
  // timeManagementSections (subtab) — same "preload the team list even if
  // this isn't the landing tab" idea, updated to the new permission model.
  // v676: no boot-time loadTeam() -- landing on Dashboard (applyRolePermissionsToNav
  // above) already runs it, so this was a second identical 14-query burst at
  // every sign-in. The User Management lists load when their sub-tab opens
  // (activateUmSection); only task categories stay, because the Roles editor's
  // picker reads taskCategoriesCache without loading it.
  if(myPermissions.allowedTabs.includes('usermanagement')) loadTaskCategoriesList();
  if(myIsOwner || canViewTimeManagementSection('reports')) ensureFxRate();
  // Only log a fresh "signed in" audit event for an actual sign-in, not for
  // silently resuming an already-open session on page load/refresh.
  if(isNewLogin) logActivity('auth.login', 'auth', user.id, `${user.email} signed in`);
  pollHandle = setInterval(refreshAll, 20000);
  // v676: Maps/Places (address autocomplete) waits until the page is idle.
  (window.requestIdleCallback || ((fn) => setTimeout(fn, 2500)))(() => {
    if(typeof ensureGooglePlaces === 'function') ensureGooglePlaces().catch(() => {});
  }, { timeout: 6000 });
  startStatusTimerTicker();
  startPresenceHeartbeat(); // v1.2.9: begin auto-presence (writes active/away + last_seen)
  // Runs on EVERY establishSession, not only fresh logins: the forced
  // password-change screen finishes by calling this with isNewLogin, but a
  // resumed session is just as good a moment to top the extension up, and
  // the extension ignores a handover it doesn't need. Deliberately not
  // awaited — sign-in must never wait on it.
  handOverSessionToExtension();
}

async function doLogin(){
  const email = $('email').value.trim();
  const password = $('password').value;
  if(!email || !password){
    $('loginMsg').textContent = 'Email and password are required.';
    return;
  }
  if(!sb){
    $('loginMsg').textContent = 'Could not connect. Check your internet connection and reload the page.';
    return;
  }
  const btn = $('loginBtn');
  const originalLabel = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Signing in…';
  $('loginMsg').textContent = '';
  try{
    const { data, error } = await sb.auth.signInWithPassword({ email, password });
    if(error) throw error;
    try{ localStorage.setItem('dashboardLastEmail', email); }catch(e){}
    await establishSession(data.user, { isNewLogin: true });
  }catch(e){
    $('loginMsg').textContent = e.message || 'Login failed.';
  }finally{
    btn.disabled = false;
    btn.textContent = originalLabel;
  }
}
$('loginBtn').addEventListener('click', doLogin);
// Enter submits from either field — there's no <form> wrapping these
// inputs (deliberately, to avoid an accidental native GET submit), so
// Enter needs its own keydown handler instead of relying on the browser's
// default single-input-form behavior.
['email', 'password'].forEach(id => {
  $(id).addEventListener('keydown', (e) => {
    if(e.key === 'Enter'){ e.preventDefault(); doLogin(); }
  });
});

// Prefill + focus: if we remember the last email that signed in
// successfully on this browser, prefill it and put the cursor straight
// in the password field; otherwise focus email so typing can start
// immediately either way.
function prefillAndFocusLogin(){
  let lastEmail = '';
  try{ lastEmail = localStorage.getItem('dashboardLastEmail') || ''; }catch(e){}
  if(lastEmail){
    $('email').value = lastEmail;
    $('password').focus();
  } else {
    $('email').focus();
  }
}
prefillAndFocusLogin();

// ---------- login footer: version + optional support line ----------
$('loginVersionLine').textContent = `${APP_VERSION} \u00b7 ${APP_BUILD_DATE}`;
if(SUPPORT_CONTACT){
  $('loginSupportLink').textContent = SUPPORT_CONTACT;
  $('loginSupportLink').href = `mailto:${SUPPORT_CONTACT}`;
  $('loginSupportLine').style.display = '';
}

// ---------- login panel switching ----------
// v190: the self-service "forgot password" email-reset flow was removed —
// staff now see a static "contact your admin" message instead (see
// #forgotPasswordHint above). showLoginPanel() and recoveryPanel are kept:
// an Owner/Admin can still trigger Supabase's password-recovery email
// directly (outside this app), and if a staff member ever lands here via
// such a link, the PASSWORD_RECOVERY listener below still needs somewhere
// to route them.
function showLoginPanel(panelId){
  ['loginFormPanel', 'forgotPanel', 'recoveryPanel', 'forcePasswordScreen', 'mfaPanel'].forEach(id => {
    $(id).style.display = id === panelId ? 'block' : 'none';
  });
}

// v812 (owner decision W3, 2026-09-21): two-step sign-in (authenticator app,
// TOTP) for the roles in app_settings.mfa_required_roles, and for anyone who
// has set one up whatever their role.
//
// WHO: read from app_settings rather than hardcoded, so the rollout can be
// widened -- or switched off in an emergency -- with one SQL update and no
// deploy. It ships as ["owner"]: the Owner sets it up first and confirms the
// flow works before admins and sales are added.
//
// WHAT THIS DOES NOT DO YET: stop a password-only session at the DATABASE.
// These screens stop someone signing in to the portal with a stolen password;
// they do not stop the same password being used against the API directly.
// That is a restrictive RLS rule (aal2 for anyone with a verified factor),
// and it comes next, together with the dialer's own sign-in -- which has to
// ask for the code before sales can be added to the list, or the dialer
// would be a way round it.
//
// Skipped while "Log in as" is active: that session is minted by
// manage-user for the target account, and the person testing does not hold
// the target's phone.
//
// Fails OPEN on an unexpected API error (logged to ops_error_log), not on a
// wrong code: while this is UI-only, failing closed would turn an outage at
// the auth service into everyone being locked out, for no security gain.
let mfaPendingUser = null;
let mfaPendingOpts = null;
let mfaFactorId = null;
let mfaMode = null;
// Set for one pass after a code is accepted. If Supabase accepted the code
// but the session still reads aal1, asking again would loop for ever and
// lock the person out of the portal; instead let them through once and
// report it, because that would be a fault on our side, not theirs.
let mfaJustVerified = false;

async function mfaRequiredRoles(){
  try{
    const { data } = await sb.from('app_settings').select('value').eq('key', 'mfa_required_roles').maybeSingle();
    const v = data && data.value ? JSON.parse(data.value) : [];
    return Array.isArray(v) ? v : [];
  }catch(e){ return []; }
}

// Returns true when the two-step panel is showing and sign-in must stop there.
async function mfaSignInStep(user, roleName, opts){
  if(staffImpersonating) return false;
  if(!sb || !sb.auth || !sb.auth.mfa || typeof sb.auth.mfa.getAuthenticatorAssuranceLevel !== 'function') return false;
  try{
    const { data: aal, error } = await sb.auth.mfa.getAuthenticatorAssuranceLevel();
    if(error) throw error;
    if(aal.currentLevel === 'aal2'){ mfaJustVerified = false; return false; }
    if(mfaJustVerified){
      mfaJustVerified = false;
      try{ if(window.__opsReport) window.__opsReport('two-step sign-in: code accepted but session still ' + aal.currentLevel); }catch(_){}
      return false;
    }
    mfaPendingUser = user;
    mfaPendingOpts = opts;
    if(aal.nextLevel === 'aal2'){ await mfaShowChallenge(); return true; }
    const required = await mfaRequiredRoles();
    if(required.includes(roleName)){ await mfaShowEnroll(); return true; }
    return false;
  }catch(e){
    try{ if(window.__opsReport) window.__opsReport('two-step sign-in could not start: ' + (e && e.message ? e.message : e)); }catch(_){}
    return false;
  }
}

function mfaOpenPanel(){
  $('mfaCode').value = '';
  $('mfaMsg').textContent = '';
  $('mfaMsg').className = 'msg';
  showLoginPanel('mfaPanel');
  $('loginScreen').style.display = 'block';
  setTimeout(() => { try{ $('mfaCode').focus(); }catch(e){} }, 0);
}

async function mfaShowChallenge(){
  const { data, error } = await sb.auth.mfa.listFactors();
  if(error) throw error;
  const f = ((data && data.totp) || [])[0];
  if(!f) throw new Error('no verified authenticator on this account');
  mfaFactorId = f.id;
  mfaMode = 'challenge';
  $('mfaTitle').textContent = 'Enter your sign-in code';
  $('mfaIntro').textContent = 'Open your authenticator app and type the 6-digit code it shows for PropTech AI.';
  $('mfaEnrollBox').style.display = 'none';
  $('mfaHelp').textContent = 'Lost the phone with your authenticator? Ask the Owner or an admin to reset your two-step sign-in.';
  mfaOpenPanel();
}

async function mfaShowEnroll(){
  // An abandoned set-up leaves an unverified factor behind; clear those first
  // so they do not pile up against the per-account limit. Best effort.
  try{
    const { data } = await sb.auth.mfa.listFactors();
    for(const f of ((data && data.all) || [])){
      if(f.status !== 'verified') await sb.auth.mfa.unenroll({ factorId: f.id }).catch(() => {});
    }
  }catch(e){}
  // A dated name, so a retry never collides with the one just abandoned.
  const { data, error } = await sb.auth.mfa.enroll({
    factorType: 'totp',
    issuer: 'PropTech AI',
    friendlyName: 'PropTech AI ' + new Date().toISOString().slice(0, 16).replace('T', ' '),
  });
  if(error) throw error;
  mfaFactorId = data.id;
  mfaMode = 'enroll';
  $('mfaTitle').textContent = 'Set up two-step sign-in';
  $('mfaIntro').innerHTML = 'Your account now needs a second step when you sign in. Install '
    + '<strong>Google Authenticator</strong> or <strong>Microsoft Authenticator</strong> on your phone, '
    + 'scan this code with it, then type the 6-digit code the app shows.';
  $('mfaQr').src = data.totp.qr_code;
  $('mfaSecret').textContent = data.totp.secret;
  $('mfaEnrollBox').style.display = 'block';
  $('mfaHelp').textContent = 'You only do this once. After that, signing in asks for the code the app shows at that moment.';
  mfaOpenPanel();
}

$('mfaVerifyBtn').addEventListener('click', async () => {
  const msg = $('mfaMsg');
  const code = $('mfaCode').value.replace(/\D/g, '');
  if(code.length !== 6){
    msg.textContent = 'Type the 6-digit code from your authenticator app.';
    msg.className = 'msg error';
    return;
  }
  const btn = $('mfaVerifyBtn');
  const label = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Checking…';
  try{
    const { error } = await sb.auth.mfa.challengeAndVerify({ factorId: mfaFactorId, code });
    if(error){
      msg.textContent = /invalid|expired|verif/i.test(error.message || '')
        ? 'That code didn’t match. Codes change every 30 seconds — type the one showing now.'
        : (error.message || 'Could not check the code.');
      msg.className = 'msg error';
      return;
    }
    msg.textContent = mfaMode === 'enroll' ? 'Two-step sign-in is on.' : 'Verified.';
    msg.className = 'msg';
    const u = mfaPendingUser;
    const o = mfaPendingOpts || { isNewLogin: true };
    mfaPendingUser = null;
    mfaJustVerified = true;
    await establishSession(u, o);
  }catch(e){
    msg.textContent = e && e.message ? e.message : 'Could not check the code.';
    msg.className = 'msg error';
  }finally{
    btn.disabled = false;
    btn.textContent = label;
  }
});
$('mfaCode').addEventListener('keydown', (e) => { if(e.key === 'Enter') $('mfaVerifyBtn').click(); });
$('mfaSignOutLink').addEventListener('click', (e) => { e.preventDefault(); performSignOut(); });

// ---------- password recovery landing (after clicking the emailed link) ----------
// Supabase's client detects the recovery token in the URL on page load and
// fires this event with a temporary session already in place — from here,
// updateUser({ password }) is all it takes to actually change it.
let passwordRecoveryInProgress = false;

// v825 (owner decision W7): "Forgot your password?" -> a temporary password by email.
$('forgotPwLink').addEventListener('click', (e) => {
  e.preventDefault();
  $('forgotEmail').value = $('email').value.trim();
  $('forgotMsg').textContent = '';
  $('forgotMsg').className = 'msg';
  showLoginPanel('forgotPanel');
  setTimeout(() => { try{ $('forgotEmail').focus(); }catch(_){} }, 0);
});
$('forgotBackLink').addEventListener('click', (e) => {
  e.preventDefault();
  $('email').value = $('forgotEmail').value.trim() || $('email').value;
  showLoginPanel('loginFormPanel');
  setTimeout(() => { try{ $('password').focus(); }catch(_){} }, 0);
});
$('forgotEmail').addEventListener('keydown', (e) => { if(e.key === 'Enter') $('forgotSendBtn').click(); });
$('forgotSendBtn').addEventListener('click', async () => {
  const msg = $('forgotMsg');
  const email = $('forgotEmail').value.trim();
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
    msg.textContent = 'Enter the email address you sign in with.';
    msg.className = 'msg error';
    return;
  }
  if(!sb){
    msg.textContent = 'Could not connect. Check your internet connection and reload the page.';
    msg.className = 'msg error';
    return;
  }
  const btn = $('forgotSendBtn');
  const label = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Sending…';
  try{
    const { data, error } = await sb.functions.invoke('staff-password-reset', { body: { email } });
    let reply = data;
    if(error){
      // A 4xx/429 carries the function's own message in the response body.
      try{ reply = await error.context.json(); }catch(_){ reply = null; }
      throw new Error((reply && reply.error) || error.message || 'Could not send the email.');
    }
    msg.textContent = (reply && reply.message) || 'If that email belongs to a staff account, a temporary password is on its way.';
    msg.className = 'msg ok';
  }catch(e){
    msg.textContent = e.message || 'Could not send the email.';
    msg.className = 'msg error';
  }finally{
    btn.disabled = false;
    btn.textContent = label;
  }
});
if(sb) sb.auth.onAuthStateChange((event) => {
  if(event === 'PASSWORD_RECOVERY'){
    passwordRecoveryInProgress = true;
    showLoginPanel('recoveryPanel');
    $('loginScreen').style.display = 'block';
    $('recoveryPassword').focus();
  }
});
$('saveNewPasswordBtn').addEventListener('click', async () => {
  const pw = $('recoveryPassword').value;
  const pwConfirm = $('recoveryPasswordConfirm').value;
  const msg = $('recoveryMsg');
  if(!pw || pw.length < 8){
    msg.textContent = 'Password must be at least 8 characters.';
    msg.className = 'msg error';
    return;
  }
  if(pw !== pwConfirm){
    msg.textContent = 'Passwords don\u2019t match.';
    msg.className = 'msg error';
    return;
  }
  if(!sb){
    msg.textContent = 'Could not connect. Check your internet connection and reload the page.';
    msg.className = 'msg error';
    return;
  }
  const btn = $('saveNewPasswordBtn');
  const originalLabel = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Saving…';
  try{
    const { error } = await sb.auth.updateUser({ password: pw });
    if(error) throw error;
    await sb.auth.signOut(); // sign out of the temporary recovery session — sign in fresh with the new password
    msg.textContent = 'Password updated — sign in with your new password below.';
    msg.className = 'msg ok';
    setTimeout(() => showLoginPanel('loginFormPanel'), 1500);
  }catch(e){
    msg.textContent = e.message || 'Could not update password.';
    msg.className = 'msg error';
  }finally{
    btn.disabled = false;
    btn.textContent = originalLabel;
  }
});

// Hides every nav tab this role can't see, shows "Audit Log" only for
// Owner (the audit trail of who changed what — kept owner-only rather
// than something even Admin can be granted), and lands on the first tab
// (in nav order) the role actually has access to — Quality, for
// instance, never sees "Staff" so shouldn't default to a blank/
// inaccessible panel. "User Management" (Tasks + Roles merged) is a
// normal grantable tab like any other — Owner always has it regardless
// (isProtected bypass elsewhere), Admin/custom roles need it explicitly
// in allowed_tabs, same as Timesheets or Leads.
function applyRolePermissionsToNav(){
  document.querySelectorAll('.tab-btn').forEach(btn => {
    const key = btn.dataset.tab;
    // Owner always sees every tab — including ones added after this role's
    // allowed_tabs row was last saved — rather than only the tabs that
    // happen to be checked in the DB. This matches canEditTab(), which
    // already treats isProtected/Owner as unconditional access; without
    // this, a brand-new tab would be invisible to Owner until someone
    // remembered to run a migration adding its key to allowed_tabs (as
    // had to be done by hand for 'activity' and 'usermanagement' above).
    const visible = myIsOwner || myPermissions.allowedTabs.includes(key);
    btn.style.display = visible ? '' : 'none';
  });
  // v823: Ops Health -- Owner and Admin by role, never grantable.
  const _opsBtn = document.querySelector('.tab-btn[data-tab="ops_health"]');
  if(_opsBtn) _opsBtn.style.display = opsHealthCanView() ? '' : 'none';
  // v701: the Client Inbox follows who may take client chats
  // (staff_can_handle_client_chat): owner/admin, Sales, or a role granted the
  // 'client_chat' key -- not the key alone, which admin rows may lack.
  const _ciBtn = document.querySelector('.tab-btn[data-tab="client_chat"]');
  if(_ciBtn) _ciBtn.style.display = ciCanUseInbox() ? '' : 'none';
  // v717: Dispute/Feedback keeps its Leads grant (the Leads tab plus the
  // 'leads_dispute' section), and the Client Communications parent shows when
  // either child does.
  const _cdBtn = document.querySelector('.tab-btn[data-tab="client_disputes"]');
  const _canDisputes = myIsOwner || (myPermissions.allowedTabs.includes('leads') && canViewLeadsSection('leads_dispute'));
  if(_cdBtn) _cdBtn.style.display = _canDisputes ? '' : 'none';
  const _ccBtn = document.querySelector('.tab-btn[data-tab="client_communications"]');
  if(_ccBtn) _ccBtn.style.display = (ciCanUseInbox() || _canDisputes) ? '' : 'none';
  // v717: groups in chat are created by seniors only (see chatIsSenior).
  const _ngb = $('chatNewGroupBtn');
  if(_ngb) _ngb.style.display = chatIsSenior() ? '' : 'none';
  // v717: owner/admin earn no recruiter commission -- their HR subtab lists
  // every recruiter's instead (loadHrRecruiterCommissions).
  const _hrcBtn = document.querySelector('.hr-subtab-btn[data-hr-section="commission"]');
  if(_hrcBtn && _hrcBtn.lastChild) _hrcBtn.lastChild.textContent = ciIsAdmin() ? 'Recruiter Commission' : 'My Commission';
  // v623: the Dialer Management parent has no grant of its own -- it is a
  // disclosure control for the two real keys underneath. Show it when the
  // role can see either child, hide it when it can see neither, so nobody
  // gets a group header that opens onto nothing. Done AFTER the loop above
  // so it overrides what that loop decided for 'dialer_management' (which,
  // being in no allowed_tabs row, is always "hide" for non-Owners).
  const _dmBtn = document.querySelector('.tab-btn[data-tab="dialer_management"]');
  if(_dmBtn){
    const _canDialer = myIsOwner || myPermissions.allowedTabs.includes('dialer');
    const _canDialerAdmin = myIsOwner || myPermissions.allowedTabs.includes('dialer_admin');
    _dmBtn.style.display = (_canDialer || _canDialerAdmin) ? '' : 'none';
  }
  // v675: only the Dialer Admin sections this role may view.
  document.querySelectorAll('.da-subtab-btn').forEach(b => {
    b.style.display = canViewDialerAdminSection(b.dataset.daSection) ? '' : 'none';
  });
  daOpenDeepLinkOnce();
  const _aub = document.getElementById('addUserBtn');
  if(_aub) _aub.style.display = myPermissions.canManageUsers ? '' : 'none';
  const _ncc = document.getElementById('chatNewClientChatBtn');
  if(_ncc) _ncc.style.display = myPermissions.canTextClients ? '' : 'none';
  // v623/v624: the chat widget's two-way SMS tab is GONE, and with it the
  // gate that used to live here and the background poll that fed its badge.
  //
  // WHY THE POLL HAD TO GO, not just the tab. chatPollSmsForNotifications()
  // called ghl-api's lookup_contact_activity every 30 seconds for every
  // client, because a GHL conversation was the only place a client's reply
  // could be read. GHL is being decommissioned: left running, that is a
  // failing network call per client every 30 seconds, forever, in every
  // staff member's browser -- and it would keep a "you have unread texts"
  // badge alive over a thread nobody can open.
  //
  // Client replies still arrive. They land at telnyx-sms-webhook like any
  // other inbound text (see send-client-sms' header). What no longer exists
  // is a per-client GHL thread rendered inside this widget.
  // v475: Gmail reply notifications -- no chat-widget tab to gate visibility
  // on anymore (see pollGmailReplyNotifications' own header comment), just
  // the background poll, same permission gate as everywhere else Gmail
  // send/read lives.
  if(myPermissions.canTextClients){
    gmailNotifyLoadSeen();
    if(!gmailNotifyPollTimer){
      pollGmailReplyNotifications();
      gmailNotifyPollTimer = setInterval(() => { if(!document.hidden) pollGmailReplyNotifications(); }, 60000);
    }
  } else if(gmailNotifyPollTimer){
    clearInterval(gmailNotifyPollTimer);
    gmailNotifyPollTimer = null;
  }
  // Lands on Dashboard specifically when the role can see it, independent
  // of where its button sits in the nav strip — v41 moved Activity to
  // display before Dashboard visually, but that's a nav-ORDER change, not
  // a "which tab loads right after login" change; most roles still expect
  // their team/agent overview first. Falls back to the first visible tab
  // in nav order (unchanged behavior) for a role that can't see Dashboard
  // at all, e.g. one scoped to just Activity.
  // v453: Dashboard lives under Time Management now (its first subtab) —
  // landing on the Time Management tab-btn is enough, since
  // initTimeManagementTab() (called by activateTab below) already resolves
  // to the first VIEWABLE subtab in DOM order on its own, and Dashboard is
  // first. Only treated as "can land here" when this role can actually see
  // that specific subtab, same distinction the old staffBtn check made —
  // a role scoped to Timesheets only, for example, still falls through to
  // the generic first-visible-tab fallback below (which will still often
  // resolve back to Time Management -> Timesheets, just not via this
  // Dashboard-specific preference).
  const tmBtn = document.querySelector('.tab-btn[data-tab="time_management"]');
  const canLandOnDashboard = tmBtn && tmBtn.style.display !== 'none' && (myIsOwner || canViewTimeManagementSection('staff'));
  const landingBtn = canLandOnDashboard
    ? tmBtn
    : Array.from(document.querySelectorAll('.tab-btn')).find(btn => btn.style.display !== 'none' && document.getElementById('tab-' + btn.dataset.tab));   // v717: a parent (no panel) is not a landing page
  // v714: a refresh reopens the page this browser tab was on (staffPageRestore).
  if(staffPageRestore()) return;
  if(landingBtn) activateTab(landingBtn.dataset.tab);
}

// v714 (the owner: "if I click Dialer Management, change to Activity and
// refresh, it takes me back to Dialer Management -- it should bring me back
// to the page I was on"). Two halves:
//  1. the #dialer-admin/... address Dialer Management writes (so its own
//     deep links work) is dropped the moment another page opens -- it was
//     outliving the page and pulling every refresh back there;
//  2. the page -- top-level tab plus each page's remembered sub-tab -- is
//     written to this browser tab's sessionStorage as the page unloads, and
//     the login landing reopens it instead of Dashboard. sessionStorage is
//     per browser tab: it survives a refresh, not a new tab. The saved user
//     id stops a different sign-in in the same tab inheriting it, and each
//     page's own init still checks the sub-tab against the role, so nothing
//     the role cannot see is reachable this way.
const STAFF_PAGE_KEY = 'pt.staffPage';
let staffPageMemoryOff = false;   // set by sign-out, so the unload after it saves nothing
function staffPageSnapshot(){
  if(staffPageMemoryOff || !myUserId) return;
  const panel = document.querySelector('.tab-panel.active');
  const tab = panel && panel.id.startsWith('tab-') ? panel.id.slice(4) : null;
  if(!tab) return;
  const state = {
    uid: myUserId, tab,
    tm: tmActiveSection, um: umActiveSection, audit: auditActiveSection,
    leads: leadsActiveSection, csub: csubActiveSection, finance: financeActiveSection,
    dataSci: dataSciActiveSection, taxes: taxesActiveSection, hr: hrActiveSection,
    da: daActiveSection, daPath: daActivePath,
    actGroup: activeActivityGroup, actKind: activeActivityKind,
  };
  try { sessionStorage.setItem(STAFF_PAGE_KEY, JSON.stringify(state)); } catch(e){}
}
window.addEventListener('pagehide', staffPageSnapshot);
document.addEventListener('visibilitychange', () => { if(document.hidden) staffPageSnapshot(); });
// Called by the login landing. True when it reopened a saved page.
function staffPageRestore(){
  let st = null;
  try { st = JSON.parse(sessionStorage.getItem(STAFF_PAGE_KEY) || 'null'); } catch(e){}
  if(!st || !st.tab || st.uid !== myUserId) return false;
  // An explicit #dialer-admin/... link (admin.proptechnologyai.com redirects
  // to one) wins over the remembered page.
  if(/^#dialer-admin/.test(location.hash || '')) return false;
  const btn = document.querySelector(`.tab-btn[data-tab="${st.tab}"]`);
  if(!btn || !document.getElementById('tab-' + st.tab)) return false;
  for(let el = btn; el && el !== document.body; el = el.parentElement){
    if(el.style && el.style.display === 'none') return false;   // hidden for this role
  }
  if(st.tab === 'dialer_management' && !daVisibleSections().length) return false;
  if(st.tm) tmActiveSection = st.tm;
  if(st.um) umActiveSection = st.um;
  if(st.audit) auditActiveSection = st.audit;
  if(st.leads) leadsActiveSection = st.leads;
  if(st.csub) csubActiveSection = st.csub;
  if(st.finance) financeActiveSection = st.finance;
  if(st.dataSci) dataSciActiveSection = st.dataSci;
  if(st.taxes) taxesActiveSection = st.taxes;
  if(st.hr) hrActiveSection = st.hr;
  if(st.da){ daActiveSection = st.da; daActivePath = st.daPath || null; }
  if(st.actGroup) activeActivityGroup = st.actGroup;
  if(st.actKind) activeActivityKind = st.actKind;
  activateTab(st.tab);
  return true;
}

// Shared by the nav click handler and the login flow above — switches
// panels and runs whatever that tab's data-load function is.

// ---------------------------------------------------------------------------
// v756: MARKETING (staff side).
//
// The client connects their own sending domain in their portal; staff do the
// list work here, for any client, without signing in as them. Same edge
// functions, same validation, same suppression -- the only difference is that
// a client_id is passed explicitly.
// ---------------------------------------------------------------------------
let mktClients = [];
let mktContent = null;   // v765: marketing_template_content()
let mktAudiences = [];
let mktDomains = [];
let mktCsv = null;
let mktAccess = null;   // v757: marketing_access() for the picked client

async function mktCall(action, payload){
  const AUD = ['audience_list','audience_create','audience_delete','contacts_import'];
  // v765: the email content lives in marketing-templates, not domains.
  const TPL = ['content_block', 'content_variant'];
  const fn = AUD.includes(action) ? 'marketing-audiences'
    : TPL.includes(action) ? 'marketing-templates'
    : 'marketing-domains';
  const { data, error } = await sb.functions.invoke(fn, { body: { action, ...payload } });
  if (data && data.ok === false) throw new Error(data.error || 'Request failed.');
  if (error) {
    // invoke() leaves the body unread on a non-2xx, so the only message it
    // offers is "non-2xx status code". The real one is in the response.
    if (error.context && typeof error.context.json === 'function') {
      try { const b = await error.context.json(); if (b && b.error) throw new Error(b.error); } catch(e){ if(e instanceof Error && e.message && !/json/i.test(e.message)) throw e; }
    }
    throw new Error(error.message || 'Request failed.');
  }
  return data;
}

function mktParseCsv(text){
  const rows=[]; let row=[], field='', q=false;
  const s=String(text).replace(/\r\n/g,'\n').replace(/\r/g,'\n');
  for(let i=0;i<s.length;i++){
    const c=s[i];
    if(q){ if(c==='"'){ if(s[i+1]==='"'){ field+='"'; i++; } else q=false; } else field+=c; }
    else if(c==='"') q=true;
    else if(c===','){ row.push(field); field=''; }
    else if(c==='\n'){ row.push(field); rows.push(row); row=[]; field=''; }
    else field+=c;
  }
  if(field.length||row.length){ row.push(field); rows.push(row); }
  return rows.filter(r=>r.some(v=>String(v).trim()!==''));
}
function mktGuess(headers, kind){
  const want={ email:['email','e-mail','email address','emailaddress','mail'],
    first_name:['first name','firstname','first','given name','fname'],
    last_name:['last name','lastname','last','surname','lname'],
    company:['company','business','organisation','organization','company name'] }[kind]||[];
  const n=headers.map(h=>String(h).trim().toLowerCase());
  for(const w of want){ const i=n.indexOf(w); if(i>=0) return i; }
  for(let i=0;i<n.length;i++) if(want.some(w=>n[i].includes(w))) return i;
  return -1;
}
function mktSel(id, headers, sel){
  return `<select id="${id}"><option value="-1">— none —</option>${
    headers.map((h,i)=>`<option value="${i}"${i===sel?' selected':''}>${escapeHtml(h||('Column '+(i+1)))}</option>`).join('')}</select>`;
}

// ---------------------------------------------------------------------------
// v775: Campaigns -> Email Marketing. The owner asked for GoHighLevel's email
// statistics: engagement summary, delivered/bounced/unsubscribed/spam cards, a
// trend over time and top performing emails -- plus the day's sending volume
// for all clients and each client with its warm-up, and a per-campaign
// delivery log showing who was sent (or not sent) and why.
// Data: marketing_stats / marketing_sending_today / marketing_recipient_log
// (SECURITY DEFINER, gated by marketing_staff_can_view()).
// ---------------------------------------------------------------------------
const MKST_COLORS = ['#4f7df3', '#a78bfa', '#38bdf8', 'var(--mkst-teal)', '#f59e0b', '#ec4899', '#94a3b8'];
let mkstPane = 'stats';
let mkstData = null;
let mkstToday = null;
let mkstCampaignOptions = [];   // kept from the last "all campaigns" load
let mkstTodayTimer = null;
let mkstInited = false;

function mkstChicagoToday(){
  return new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Chicago', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
}
function mkstShiftDay(iso, days){
  const d = new Date(iso + 'T12:00:00Z');
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
}
const mkstN = (v) => Number(v || 0).toLocaleString();
const mkstPctNum = (a, b) => b ? (100 * a / b) : 0;
const mkstPct = (a, b, dp = 1) => b ? `${mkstPctNum(a, b).toFixed(dp)}%` : '—';
function mkstDate(iso, withTime){
  if (!iso) return '—';
  const opts = withTime
    ? { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago' }
    : { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' };
  return new Date(iso).toLocaleString('en-US', opts);
}

function initMarketingStats(){
  if (!mkstInited) {
    mkstInited = true;
    document.querySelectorAll('.mkst-tab').forEach(b => b.addEventListener('click', () => mkstShowPane(b.dataset.mkstPane)));
    const today = mkstChicagoToday();
    $('mkstTo').value = today;
    $('mkstFrom').value = mkstShiftDay(today, -6);
    document.querySelector('.mkst-quick [data-mkst-days="7"]').classList.add('active');
    document.querySelectorAll('.mkst-quick button').forEach(b => b.addEventListener('click', () => {
      const t = mkstChicagoToday();
      $('mkstTo').value = t;
      $('mkstFrom').value = mkstShiftDay(t, -(Number(b.dataset.mkstDays) - 1));
      document.querySelectorAll('.mkst-quick button').forEach(x => x.classList.toggle('active', x === b));
      mkstLoad();
    }));
    ['mkstFrom', 'mkstTo'].forEach(id => $(id).addEventListener('change', () => {
      document.querySelectorAll('.mkst-quick button').forEach(x => x.classList.remove('active'));
      mkstLoad();
    }));
    $('mkstClient').addEventListener('change', () => { $('mkstCampaign').value = ''; mkstCampaignOptions = []; mkstLoad(); });
    $('mkstCampaign').addEventListener('change', mkstLoad);
    $('mkstRefresh').addEventListener('click', mkstLoad);
    $('mkstMetric').addEventListener('change', mkstRenderTrend);
    $('mkstTopSort').addEventListener('change', mkstRenderTop);
    $('mkstNumbers').addEventListener('change', mkstRenderTop);
    $('mkstTodayRefresh').addEventListener('click', mkstLoadToday);
  }
  mkstFillClients();
  mkstShowPane(mkstPane);
}

async function mkstFillClients(){
  const sel = $('mkstClient');
  if (sel.options.length > 1) return;
  if (!mktClients.length) {
    const { data } = await sb.from('client_accounts').select('id, email, company_name').order('email');
    mktClients = data || [];
  }
  const keep = sel.value;
  sel.innerHTML = '<option value="">All clients</option>' + mktClients.map(c =>
    `<option value="${escapeHtml(c.id)}">${escapeHtml(c.company_name || c.email)}</option>`).join('');
  sel.value = keep;
}

function mkstShowPane(pane){
  mkstPane = pane;
  document.querySelectorAll('.mkst-tab').forEach(b => b.classList.toggle('active', b.dataset.mkstPane === pane));
  ['stats', 'today', 'manage'].forEach(p => { $('mkstPane-' + p).style.display = p === pane ? '' : 'none'; });
  clearTimeout(mkstTodayTimer);
  if (pane === 'stats') mkstLoad();
  if (pane === 'today') mkstLoadToday();
  if (pane === 'manage') initMarketingTab();
}

function mkstVisible(){
  const panel = document.getElementById('tab-client_submissions');
  return panel && panel.classList.contains('active') && csubActiveSection === 'marketing' && !document.hidden;
}

// ------------------------------------------------------------ statistics
async function mkstLoad(){
  const msg = $('mkstMsg');
  msg.style.color = 'var(--text-2)';
  msg.textContent = 'Loading…';
  const client = $('mkstClient').value || null;
  const campaign = $('mkstCampaign').value || null;
  const { data, error } = await sb.rpc('marketing_stats', {
    p_client: client, p_campaign: campaign, p_from: $('mkstFrom').value || null, p_to: $('mkstTo').value || null,
  });
  if (error) { msg.style.color = 'var(--danger)'; msg.textContent = error.message; return; }
  mkstData = data;
  msg.textContent = `Updated ${new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`;
  if (!campaign) {
    mkstCampaignOptions = (data.campaigns || []).map(c => ({ id: c.id, name: c.name, client: c.client_name }));
    const sel = $('mkstCampaign');
    sel.innerHTML = '<option value="">All campaigns</option>' + mkstCampaignOptions.map(c =>
      `<option value="${escapeHtml(c.id)}">${escapeHtml(c.name)}${client ? '' : ' — ' + escapeHtml(c.client || '')}</option>`).join('');
  }
  mkstRenderFunnel();
  mkstRenderKpis();
  mkstRenderTrend();
  mkstRenderTop();
}

function mkstRenderFunnel(){
  const t = (mkstData && mkstData.totals) || {};
  const groups = (mkstData && mkstData.groups) || [];
  const box = $('mkstFunnel');
  if (!t.delivered && !t.sent) {
    box.innerHTML = `<div class="mkst-empty">No emails were delivered in this period.${mkstData && mkstData.campaigns && mkstData.campaigns.some(c => c.queued) ? ' Some campaigns are still waiting to send — see Sending today.' : ''}</div>`;
    return;
  }
  // Up to six named segments (clients, or campaigns for one client), the rest as Other.
  const top = groups.slice(0, 6);
  const rest = groups.slice(6);
  if (rest.length) top.push({ name: 'Other', delivered: rest.reduce((s, g) => s + g.delivered, 0), opened: rest.reduce((s, g) => s + g.opened, 0), clicked: rest.reduce((s, g) => s + g.clicked, 0) });
  const max = Math.max(1, t.delivered || 0);
  const row = (label, key, total, pct) => `
    <div class="mkst-funnel-l">${label}</div>
    <div class="mkst-funnel-track" title="${label}: ${mkstN(total)}">
      ${top.map((g, i) => g[key] ? `<div class="mkst-funnel-seg" style="width:${(100 * g[key] / max).toFixed(3)}%; background:${MKST_COLORS[i % MKST_COLORS.length]};" title="${escapeHtml(g.name || '')}: ${mkstN(g[key])} ${label.toLowerCase()}"></div>` : '').join('')}
    </div>
    <div class="mkst-funnel-pct" title="${label} as a share of delivered">${pct}</div>`;
  const ticks = [0, .25, .5, .75, 1].map(f => mkstN(Math.round(max * f)));
  box.innerHTML = `
    <div class="mkst-funnel" style="margin-bottom:4px;"><div></div><div></div><div style="font-size:11px; color:var(--text-2); text-align:center;">Cumulative</div></div>
    <div class="mkst-funnel">
      ${row('Delivered', 'delivered', t.delivered, '100%')}
      ${row('Opened', 'opened', t.opened, mkstPct(t.opened, t.delivered, 0))}
      ${row('Clicked', 'clicked', t.clicked, mkstPct(t.clicked, t.delivered, 0))}
    </div>
    <div class="mkst-axis">${ticks.map(x => `<span>${x}</span>`).join('')}</div>
    <div class="mkst-legend">${top.map((g, i) => `<span><i style="background:${MKST_COLORS[i % MKST_COLORS.length]}"></i>${escapeHtml(g.name || 'Unknown')}</span>`).join('')}</div>`;
}

function mkstRenderKpis(){
  const t = (mkstData && mkstData.totals) || {};
  const card = (label, value, sub, tip, color) => `<div class="mkst-kpi">
      <div class="mkst-kpi-l">${label} <span class="mkst-info" title="${escapeHtml(tip)}">i</span></div>
      <div class="mkst-kpi-v"${color ? ` style="color:${color}"` : ''}>${mkstN(value)}</div>
      <div class="mkst-kpi-s">${sub}</div></div>`;
  $('mkstKpis').innerHTML = [
    card('Emails sent', t.sent, 'handed to the mail provider', 'Accepted for sending by our email provider in this period.'),
    card('Email delivered', t.delivered, `${mkstPct(t.delivered, t.sent)} of sent`, 'The receiving mail server confirmed it arrived.'),
    card('Not sent', t.not_sent, 'failed, skipped or unconfirmed', 'Failed at the provider, skipped (the address was suppressed or unsubscribed), or never confirmed. Open a campaign to see why for each one.', t.not_sent ? 'var(--danger)' : ''),
    card('Bounced', t.bounced, `${mkstPct(t.bounced, t.sent)} of sent`, 'The address rejected the email. It is suppressed for that client automatically.'),
    card('Unsubscribed', t.unsubscribed, `${mkstPct(t.unsubscribed, t.delivered)} of delivered`, 'Clicked unsubscribe. They will not be emailed again by that client.'),
    card('Spam complaints', t.complained, `${mkstPct(t.complained, t.delivered, 2)} of delivered`, 'Marked as spam. Suppressed on every client. Keep this under 0.1%.', t.complained ? 'var(--danger)' : ''),
  ].join('');
}

const MKST_METRICS = {
  open_rate:  { label: 'Open rate', rate: true, num: 'opened', den: 'delivered', totalLabel: ['Total opened', 'Total delivered'] },
  click_rate: { label: 'Click rate', rate: true, num: 'clicked', den: 'delivered', totalLabel: ['Total clicked', 'Total delivered'] },
  sent:       { label: 'Sent', key: 'sent' },
  delivered:  { label: 'Delivered', key: 'delivered' },
  not_sent:   { label: 'Not sent', key: 'not_sent' },
  bounced:    { label: 'Bounced', key: 'bounced' },
  unsubscribed: { label: 'Unsubscribed', key: 'unsubscribed' },
};

function mkstRenderTrend(){
  const m = MKST_METRICS[$('mkstMetric').value] || MKST_METRICS.open_rate;
  const t = (mkstData && mkstData.totals) || {};
  const days = (mkstData && mkstData.daily) || [];
  const scope = $('mkstCampaign').value ? 'this campaign' : $('mkstClient').value ? 'this client' : 'all clients';
  $('mkstTrendTitle').textContent = `${m.label} (for ${scope})`;
  $('mkstTrendBox').innerHTML = m.rate
    ? `<div><div class="mkst-kpi-l">${m.label}</div><div class="v">${mkstPct(t[m.num], t[m.den], 2)}</div></div>
       <div><div class="r"><span>${m.totalLabel[0]}:</span><b>${mkstN(t[m.num])}</b></div><div class="r"><span>${m.totalLabel[1]}:</span><b>${mkstN(t[m.den])}</b></div></div>`
    : `<div><div class="mkst-kpi-l">${m.label}</div><div class="v">${mkstN(t[m.key])}</div></div>
       <div><div class="r"><span>Days:</span><b>${days.length}</b></div><div class="r"><span>Busiest day:</span><b>${mkstN(Math.max(0, ...days.map(d => d[m.key] || 0)))}</b></div></div>`;
  const vals = days.map(d => m.rate ? mkstPctNum(d[m.num] || 0, d[m.den] || 0) : (d[m.key] || 0));
  $('mkstTrendChart').innerHTML = mkstLineSvg(days.map(d => d.day), vals, m.rate);
}

// A smooth line with a soft area under it, like GoHighLevel's chart.
function mkstLineSvg(labels, values, isRate){
  const W = 720, H = 240, L = 48, R = 26, T = 12, B = 34;
  if (!labels.length) return '<div class="mkst-empty">No data.</div>';
  const maxV = Math.max(...values, 0);
  // Round axis steps (1, 2, 5, 10, 20, 25, 50 ...) so ticks read 0 / 10 / 20 / 30 / 40.
  const want = Math.max(isRate ? 4 : 4, maxV * 1.08) / 4;
  const mag = Math.pow(10, Math.floor(Math.log10(want)));
  const step = [1, 2, 2.5, 5, 10].map(f => f * mag).find(s => s >= want) || 10 * mag;
  const top = step * 4;
  const x = (i) => L + (labels.length === 1 ? (W - L - R) / 2 : i * (W - L - R) / (labels.length - 1));
  const y = (v) => T + (H - T - B) * (1 - v / top);
  const pts = values.map((v, i) => [x(i), y(v)]);
  let d = `M${pts[0][0]},${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2;
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    // keep the curve inside the plot (no dip below zero)
    c1[1] = Math.min(c1[1], H - B); c2[1] = Math.min(c2[1], H - B);
    d += ` C${c1[0]},${c1[1]} ${c2[0]},${c2[1]} ${p2[0]},${p2[1]}`;
  }
  const area = `${d} L${pts[pts.length - 1][0]},${H - B} L${pts[0][0]},${H - B} Z`;
  const grid = [0, .25, .5, .75, 1].map(f => {
    const v = top * f, yy = y(v);
    return `<line x1="${L}" x2="${W - R}" y1="${yy}" y2="${yy}" stroke="currentColor" stroke-opacity=".12"/>
      <text x="${L - 8}" y="${yy + 4}" text-anchor="end" font-size="11" fill="currentColor" fill-opacity=".6">${isRate ? (Number.isInteger(v) ? v : v.toFixed(1)) + '%' : Math.round(v).toLocaleString()}</text>`;
  }).join('');
  const every = Math.max(1, Math.ceil(labels.length / 8));
  const xl = labels.map((lab, i) => (i % every === 0 || i === labels.length - 1)
    ? `<text x="${x(i)}" y="${H - 12}" text-anchor="middle" font-size="11" fill="currentColor" fill-opacity=".6">${lab.slice(5, 7)}/${lab.slice(8, 10)}</text>` : '').join('');
  const dots = pts.map((p, i) => `<circle cx="${p[0]}" cy="${p[1]}" r="${labels.length > 45 ? 0 : 3}" fill="#4f7df3"><title>${labels[i]}: ${isRate ? values[i].toFixed(1) + '%' : values[i].toLocaleString()}</title></circle>`).join('');
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Trend" style="color:var(--text);">
    <defs><linearGradient id="mkstFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#4f7df3" stop-opacity=".35"/><stop offset="1" stop-color="#4f7df3" stop-opacity=".03"/></linearGradient></defs>
    ${grid}
    <path d="${area}" fill="url(#mkstFill)"/>
    <path d="${d}" fill="none" stroke="#4f7df3" stroke-width="2.2"/>
    ${dots}${xl}</svg>`;
}

const MKST_CAMP_STATUS = { draft: ['Draft', 'var(--text-2)'], scheduled: ['Scheduled', 'var(--mkst-blue)'], sending: ['Sending', 'var(--mkst-teal)'], paused: ['Paused', 'var(--away)'], sent: ['Sent', 'var(--good)'], cancelled: ['Cancelled', 'var(--text-2)'] };

function mkstRenderTop(){
  const rows = ((mkstData && mkstData.campaigns) || []).slice();
  const sort = $('mkstTopSort').value;
  const nums = $('mkstNumbers').checked;
  const score = (c) => sort === 'open_rate' ? mkstPctNum(c.opened, c.delivered) : sort === 'click_rate' ? mkstPctNum(c.clicked, c.delivered) : (c[sort] || 0);
  rows.sort((a, b) => score(b) - score(a) || (b.delivered - a.delivered));
  const allClients = !$('mkstClient').value;
  const tbl = $('mkstTop');
  if (!rows.length) { tbl.innerHTML = '<tr><td class="mkst-empty">No campaigns in this period.</td></tr>'; return; }
  tbl.innerHTML = `<thead><tr><th>Title</th>${allClients ? '<th>Client</th>' : ''}<th>Execution date</th><th>Status</th><th>Recipients</th><th>Sent</th><th>Delivered</th><th>Not sent</th><th>${nums ? 'Opened' : 'Open rate'}</th><th>${nums ? 'Clicked' : 'Click rate'}</th></tr></thead>
    <tbody>${rows.map(c => {
      const [label, color] = MKST_CAMP_STATUS[c.status] || [c.status, 'var(--text-2)'];
      return `<tr>
        <td><button class="mkst-link" data-mkst-log="${escapeHtml(c.id)}" data-name="${escapeHtml(c.name)}">${escapeHtml(c.name)}</button>
          <div style="font-size:11.5px; color:var(--text-2);">${escapeHtml(c.subject || '')}</div></td>
        ${allClients ? `<td>${escapeHtml(c.client_name || '—')}</td>` : ''}
        <td style="white-space:nowrap;">${mkstDate(c.started_at, true)}</td>
        <td><span class="mkst-chip" style="color:${color};">${label}</span>${c.queued ? `<div style="font-size:11px; color:var(--text-2); margin-top:3px;">${mkstN(c.queued)} waiting</div>` : ''}</td>
        <td>${mkstN(c.recipients)}</td>
        <td>${mkstN(c.sent)}</td>
        <td>${mkstN(c.delivered)}</td>
        <td${c.not_sent ? ' style="color:var(--danger); font-weight:700;"' : ''}>${mkstN(c.not_sent)}</td>
        <td>${nums ? mkstN(c.opened) : mkstPct(c.opened, c.delivered, 2)}</td>
        <td>${nums ? mkstN(c.clicked) : mkstPct(c.clicked, c.delivered, 2)}</td>
      </tr>`; }).join('')}</tbody>`;
  tbl.querySelectorAll('[data-mkst-log]').forEach(b => b.addEventListener('click', () => mkstOpenLog(b.dataset.mkstLog, b.dataset.name)));
}

// --------------------------------------------------------- sending today
function mkstWarmup(d){
  if (!d.usable) return { label: 'Domain not verified', color: 'var(--text-2)', pct: 0, note: d.domain_status || '' };
  if (d.warmup_paused) return { label: 'Warm-up paused', color: 'var(--danger)', pct: Math.min(100, (d.warmup_day || 0) * 10), note: 'Nothing sends until it is resumed.' };
  if (d.warmup_completed_at) return { label: 'Warm', color: 'var(--good)', pct: 100, note: `Finished ${mkstDate(d.warmup_completed_at)}` };
  if (!d.warmup_started_at) return { label: 'Not started', color: 'var(--mkst-blue)', pct: 0, note: 'Starts with the first send — 50 on day 1.' };
  const day = Math.min(10, Math.max(1, d.warmup_day || 1));
  return { label: `Warming up — day ${day} of 10`, color: 'var(--away)', pct: day * 10, note: `Started ${mkstDate(d.warmup_started_at)}` };
}

async function mkstLoadToday(){
  clearTimeout(mkstTodayTimer);
  const { data, error } = await sb.rpc('marketing_sending_today');
  if (error) { $('mkstTodayTable').innerHTML = `<tr><td class="mkst-empty" style="color:var(--danger);">${escapeHtml(error.message)}</td></tr>`; return; }
  mkstToday = data;
  const rows = data.domains || [];
  const sum = (k) => rows.reduce((s, r) => s + (Number(r[k]) || 0), 0);
  const sentToday = sum('sent_today'), allowed = sum('allowance_today'), left = sum('remaining_today');
  const warming = rows.filter(r => r.usable && r.warmup_started_at && !r.warmup_completed_at && !r.warmup_paused).length;
  $('mkstTodayNote').textContent = `Today is ${mkstDate(data.today + 'T12:00:00Z')} (Chicago)${data.working_day ? '' : ' — a weekend: no emails are sent on Saturdays or Sundays.'}. Refreshes every minute while open.`;
  const card = (label, value, sub, color) => `<div class="mkst-kpi"><div class="mkst-kpi-l">${label}</div><div class="mkst-kpi-v"${color ? ` style="color:${color}"` : ''}>${value}</div><div class="mkst-kpi-s">${sub}</div></div>`;
  $('mkstTodayKpis').innerHTML = [
    card('Sent today — all clients', mkstN(sentToday), allowed ? `${mkstPct(sentToday, allowed, 0)} of today's limit` : 'no sending limit today'),
    card("Today's limit", mkstN(allowed), 'what warm-up and allowances permit'),
    card('Still available today', mkstN(left), 'across every client'),
    card('Domains warming up', mkstN(warming), `${mkstN(rows.length)} sending domain${rows.length === 1 ? '' : 's'} in total`),
    card('Campaigns sending now', mkstN(sum('sending_campaigns')), sum('waiting_for_warmup') ? `${mkstN(sum('waiting_for_warmup'))} waiting for tomorrow's warm-up limit` : 'none waiting on warm-up', sum('waiting_for_warmup') ? 'var(--away)' : ''),
  ].join('');
  const spark = (days) => {
    const max = Math.max(1, ...days.map(x => x.sent));
    return `<svg viewBox="0 0 84 24" width="84" height="24" aria-hidden="true">${days.map((x, i) => {
      const h = Math.max(1, 22 * x.sent / max);
      return `<rect x="${i * 12}" y="${24 - h}" width="9" height="${h}" rx="1.5" fill="#4f7df3" fill-opacity="${i === days.length - 1 ? 1 : .45}"><title>${x.day}: ${x.sent}</title></rect>`;
    }).join('')}</svg>`;
  };
  $('mkstTodayTable').innerHTML = !rows.length ? '<tr><td class="mkst-empty">No client has connected a sending domain yet.</td></tr>' : `
    <thead><tr><th>Client</th><th>Sending domain</th><th>Warm-up</th><th>Sent today</th><th>Left today</th><th>This month</th><th>Last 7 days</th><th>Campaigns</th></tr></thead>
    <tbody>${rows.map(r => {
      const w = mkstWarmup(r);
      const todayPct = r.allowance_today ? Math.min(100, 100 * r.sent_today / r.allowance_today) : 0;
      const monthPct = r.monthly_limit ? Math.min(100, 100 * r.sent_this_month / r.monthly_limit) : 0;
      return `<tr>
        <td><b>${escapeHtml(r.client_name || '—')}</b></td>
        <td>${escapeHtml(r.domain)}</td>
        <td style="min-width:170px;"><span class="mkst-chip" style="color:${w.color};">${escapeHtml(w.label)}</span>
          <div class="mkst-bar"><span style="width:${w.pct}%; background:${w.color};"></span></div>
          <div style="font-size:11px; color:var(--text-2); margin-top:3px;">${escapeHtml(w.note)}</div></td>
        <td style="min-width:130px;"><b>${mkstN(r.sent_today)}</b> <span style="color:var(--text-2);">of ${mkstN(r.allowance_today)}</span>
          <div class="mkst-bar"><span style="width:${todayPct}%; background:#4f7df3;"></span></div></td>
        <td>${mkstN(r.remaining_today)}</td>
        <td style="min-width:130px;">${mkstN(r.sent_this_month)} <span style="color:var(--text-2);">of ${mkstN(r.monthly_limit)}</span>
          <div class="mkst-bar"><span style="width:${monthPct}%; background:var(--good);"></span></div></td>
        <td>${spark(r.last_7_days || [])}</td>
        <td>${r.sending_campaigns ? `<span class="mkst-chip" style="color:var(--mkst-teal);">${r.sending_campaigns} sending</span> ` : ''}${r.waiting_for_warmup ? `<span class="mkst-chip" style="color:var(--away);">${r.waiting_for_warmup} waiting for warm-up</span>` : ''}${!r.sending_campaigns && !r.waiting_for_warmup ? '<span style="color:var(--text-2);">—</span>' : ''}</td>
      </tr>`; }).join('')}</tbody>`;
  mkstTodayTimer = setTimeout(() => { if (mkstVisible() && mkstPane === 'today') mkstLoadToday(); }, 60000);
}

// ---------------------------------------------------------- delivery log
function mkstDelivery(r){
  if (r.bounced_at) return ['Bounced', 'var(--danger)', 'The address rejected it.'];
  if (r.status === 'failed') return ['Not sent — failed', 'var(--danger)', r.error || 'The provider refused it.'];
  if (r.status === 'skipped') return ['Not sent — skipped', 'var(--text-2)', r.error || 'Suppressed or unsubscribed before sending.'];
  if (r.status === 'unknown') return ['Not confirmed', 'var(--away)', r.error || 'Sent, but the provider never confirmed it — not retried, to avoid a duplicate.'];
  if (r.status === 'queued' || r.status === 'sending') return ['Waiting to send', 'var(--mkst-blue)', 'In the queue.'];
  if (r.status === 'sandbox') return ['Test only', 'var(--text-2)', 'Dry run — nothing delivered.'];
  if (r.delivered_at) return ['Delivered', 'var(--good)', ''];
  if (r.status === 'deferred') return ['Sent — delivery delayed', 'var(--away)', 'The receiving server asked to try again later.'];
  if (r.sent_at) return ['Sent — awaiting delivery report', 'var(--mkst-teal)', ''];
  return [r.status, 'var(--text-2)', ''];
}

async function mkstOpenLog(campaignId, name){
  const st = { filter: 'all', search: '', offset: 0 };
  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:9999; display:flex; align-items:center; justify-content:center; padding:16px;';
  overlay.innerHTML = `<div class="card" style="width:min(1100px,100%); max-height:92vh; display:flex; flex-direction:column; gap:10px;">
      <div style="display:flex; gap:10px; align-items:center;">
        <div style="flex:1; min-width:0;"><div class="mkst-h" style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">Delivery log — ${escapeHtml(name || 'Campaign')}</div>
          <div class="mkst-sub" style="margin:2px 0 0;">Every recipient and what happened to their email.</div></div>
        <button class="btn-secondary" data-close style="width:auto;">Close</button></div>
      <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
        <div class="mkst-log-filters" data-filters></div>
        <input type="search" data-search placeholder="Search email or name" style="width:220px; margin:0 0 0 auto;">
      </div>
      <div style="overflow:auto; border:1px solid var(--border); border-radius:8px;"><table class="mkst-table" data-table><tr><td class="mkst-empty">Loading…</td></tr></table></div>
      <div style="display:flex; gap:10px; align-items:center; font-size:12px; color:var(--text-2);" data-pager></div>
    </div>`;
  document.body.appendChild(overlay);
  const q = (s) => overlay.querySelector(s);
  const close = () => overlay.remove();
  q('[data-close]').onclick = close;
  overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
  let searchTimer = null;
  q('[data-search]').addEventListener('input', (e) => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => { st.search = e.target.value; st.offset = 0; load(); }, 300);
  });
  const LIMIT = 100;
  const FILTERS = [['all', 'All'], ['sent', 'Sent'], ['delivered', 'Delivered'], ['opened', 'Opened'], ['clicked', 'Clicked'], ['not_sent', 'Not sent'], ['bounced', 'Bounced'], ['waiting', 'Waiting']];
  async function load(){
    const { data, error } = await sb.rpc('marketing_recipient_log', {
      p_campaign: campaignId, p_filter: st.filter, p_search: st.search || null, p_limit: LIMIT, p_offset: st.offset,
    });
    if (!document.body.contains(overlay)) return;
    if (error) { q('[data-table]').innerHTML = `<tr><td class="mkst-empty" style="color:var(--danger);">${escapeHtml(error.message)}</td></tr>`; return; }
    const counts = data.counts || {};
    q('[data-filters]').innerHTML = FILTERS.map(([k, l]) => `<button data-f="${k}" class="${st.filter === k ? 'active' : ''}">${l} · ${mkstN(counts[k])}</button>`).join('');
    q('[data-filters]').querySelectorAll('button').forEach(b => b.onclick = () => { st.filter = b.dataset.f; st.offset = 0; load(); });
    const rows = data.rows || [];
    q('[data-table]').innerHTML = !rows.length ? '<tr><td class="mkst-empty">Nobody here.</td></tr>' : `
      <thead><tr><th>Recipient</th><th>Delivery</th><th>Sent</th><th>Delivered</th><th>Opened</th><th>Clicked</th><th>Unsubscribed</th></tr></thead>
      <tbody>${rows.map(r => {
        const [label, color, why] = mkstDelivery(r);
        const nm = [r.first_name, r.last_name].filter(Boolean).join(' ');
        return `<tr>
          <td><b>${escapeHtml(r.email)}</b>${nm || r.company ? `<div style="font-size:11.5px; color:var(--text-2);">${escapeHtml([nm, r.company].filter(Boolean).join(' · '))}</div>` : ''}</td>
          <td><span class="mkst-chip" style="color:${color};">${escapeHtml(label)}</span>${why ? `<div style="font-size:11px; color:var(--text-2); margin-top:3px; max-width:260px;">${escapeHtml(why)}</div>` : ''}</td>
          <td style="white-space:nowrap;">${mkstDate(r.sent_at, true)}</td>
          <td style="white-space:nowrap;">${mkstDate(r.delivered_at, true)}</td>
          <td style="white-space:nowrap;">${mkstDate(r.opened_at, true)}</td>
          <td style="white-space:nowrap;">${mkstDate(r.clicked_at, true)}</td>
          <td style="white-space:nowrap;">${mkstDate(r.unsubscribed_at, true)}</td>
        </tr>`; }).join('')}</tbody>`;
    const from = data.total ? st.offset + 1 : 0, to = Math.min(st.offset + LIMIT, data.total);
    q('[data-pager]').innerHTML = `<span>${mkstN(from)}–${mkstN(to)} of ${mkstN(data.total)}</span>
      <button class="btn-secondary" data-prev style="width:auto; padding:4px 10px;"${st.offset ? '' : ' disabled'}>Previous</button>
      <button class="btn-secondary" data-next style="width:auto; padding:4px 10px;"${to < data.total ? '' : ' disabled'}>Next</button>
      <button class="btn-secondary" data-reload style="width:auto; padding:4px 10px; margin-left:auto;">Refresh</button>`;
    q('[data-prev]').onclick = () => { st.offset = Math.max(0, st.offset - LIMIT); load(); };
    q('[data-next]').onclick = () => { st.offset += LIMIT; load(); };
    q('[data-reload]').onclick = load;
  }
  load();
}

async function initMarketingTab(){
  const sel = document.getElementById('mktClientSel');
  if (!sel) return;
  if (!mktClients.length){
    const { data } = await sb.from('client_accounts').select('id, email, company_name').order('email');
    mktClients = data || [];
  }
  // v775: filled on its own flag -- Statistics may have loaded mktClients first.
  if (!sel.dataset.filled){
    sel.dataset.filled = '1';
    sel.innerHTML = '<option value="">— pick a client —</option>' + mktClients.map(c =>
      `<option value="${escapeHtml(c.id)}">${escapeHtml(c.company_name || c.email)}</option>`).join('');
    sel.addEventListener('change', mktLoad);
  }
  if (sel.value) mktLoad();
}

async function mktLoad(){
  const clientId = document.getElementById('mktClientSel').value;
  const body = document.getElementById('mktBody');
  if (!clientId){ body.innerHTML = ''; return; }
  body.innerHTML = '<div class="card">Loading…</div>';
  try {
    const [d, a, acc, con] = await Promise.all([
      mktCall('list', { client_id: clientId }),
      mktCall('audience_list', { client_id: clientId }),
      sb.rpc('marketing_access', { p_client: clientId }),
      // v765: the words the client approved, and whether staff have stopped them.
      sb.rpc('marketing_template_content', { p_client: clientId }),
    ]);
    if (acc.error) throw new Error(acc.error.message);
    mktDomains = d.domains || [];
    mktAudiences = a.audiences || [];
    mktAccess = acc.data || null;
    mktContent = con.error ? null : (con.data || null);
    mktRender(clientId);
  } catch(e){
    body.innerHTML = `<div class="card" style="color:var(--danger)">${escapeHtml(e.message)}</div>`;
  }
}

// v757: one seat = a Full-time caller on our data (or one added here by an
// owner/admin) = 10,000 emails a month. Lists can only be created or uploaded
// once the client has done all three setup steps in their own portal; the
// edge function refuses otherwise, this just says so before anyone tries.
// v765: the client writes and approves their own email content, but it sends
// from a domain tied to this platform's reputation -- one client's bad copy
// gets the whole sending setup filtered. This card is the staff override.
function mktContentCard(clientId){
  const c = mktContent;
  const canGrant = ['owner','admin'].includes(myRole);
  const head = `<h3 class="mono" style="font-size:11px; color:var(--text-2); margin-bottom:8px; text-transform:uppercase; letter-spacing:1px;">Email content</h3>`;
  if (!c || !c.exists) {
    return `<div class="card" style="margin-bottom:16px;">${head}<div style="font-size:13px; color:var(--text-2);">This client has not written their email yet.</div></div>`;
  }
  let state;
  if (c.staff_blocked) {
    state = `<span style="color:var(--danger); font-weight:700;">On hold by staff</span>`;
  } else if (c.ai_draft) {
    state = `<span style="color:var(--away); font-weight:700;">AI draft &mdash; the client has not approved it</span>`;
  } else if (c.approved_at) {
    state = `<span style="color:var(--good); font-weight:700;">Approved by the client</span>` + ` <span style="color:var(--text-2);">${new Date(c.approved_at).toLocaleString()}</span>`;
  } else {
    state = `<span style="color:var(--text-2);">Written, not approved</span>`;
  }
  const model = c.ai_model
    ? ` <span style="color:var(--text-2);">&middot; drafted by ${escapeHtml(c.ai_model)}</span>` : '';
  const brief = c.instructions
    ? `<div style="font-size:12px; color:var(--text-2); margin-bottom:8px;"><b>Client asked for:</b> ${escapeHtml(c.instructions)}</div>`
    : '';
  const note = c.staff_note
    ? `<div style="font-size:12px; color:var(--danger); margin-top:8px;"><b>Hold note:</b> ${escapeHtml(c.staff_note)}</div>`
    : '';
  const controls = canGrant ? `<div class="filter-row" style="margin-top:12px;">
      <div style="flex:1; min-width:200px;"><label>Reason (the client sees this)</label>
        <input type="text" id="mktBlockNote" maxlength="500" value="${escapeHtml(c.staff_note || '')}"></div>
      <div style="align-self:flex-end;"><button class="btn-secondary" id="mktBlockBtn">${c.staff_blocked ? 'Release the hold' : 'Put this on hold'}</button></div>
      <div style="align-self:flex-end; font-size:12px; color:var(--text-2);" id="mktBlockMsg">A hold stops it being used, whatever the client approved.</div>
    </div>` : '';
  return `<div class="card" style="margin-bottom:16px;">${head}
    <div style="font-size:13px; margin-bottom:8px;">${state}${model}</div>
    ${brief}
    <div style="border:1px solid var(--border); border-radius:8px; padding:11px 13px; background:var(--inset); font-size:13px; line-height:1.55;">
      <div style="font-weight:700; margin-bottom:6px;">${escapeHtml(c.subject || '(no subject)')}</div>
      <div style="white-space:pre-wrap; color:var(--text-2); max-height:200px; overflow:auto;">${escapeHtml(c.body || '')}</div>
    </div>
    ${note}${controls}
  </div>`;
}

async function mktToggleBlock(clientId){
  const msg = document.getElementById('mktBlockMsg');
  const btn = document.getElementById('mktBlockBtn');
  const on = !(mktContent && mktContent.staff_blocked);
  const note = (document.getElementById('mktBlockNote') || {}).value || '';
  btn.disabled = true;
  msg.style.color = 'var(--text-2)';
  msg.textContent = 'Saving…';
  try {
    await mktCall('content_block', { client_id: clientId, blocked: on, note });
    await mktLoad();
  } catch(e){
    btn.disabled = false;
    const m = document.getElementById('mktBlockMsg');
    if (m){ m.style.color = 'var(--danger)'; m.textContent = e.message; }
  }
}

function mktAccessCard(clientId){
  const a = mktAccess || {};
  const canGrant = ['owner','admin'].includes(myRole);
  const tick = (ok, label) => `<div style="display:flex; gap:8px; align-items:center; font-size:13px; margin:3px 0;">
      <span style="font-weight:700; color:${ok ? 'var(--good)' : '#E38B2E'};">${ok ? '&#10003;' : '&#9675;'}</span>
      <span style="${ok ? '' : 'color:var(--text-2);'}">${label}</span></div>`;
  return `
    <div class="card" style="margin-bottom:16px;">
      <h3 class="mono" style="font-size:11px; color:var(--text-2); margin-bottom:10px; text-transform:uppercase; letter-spacing:1px;">Email Marketing access</h3>
      <div style="display:flex; gap:28px; flex-wrap:wrap;">
        <div style="min-width:220px;">
          <div style="font-size:13px; line-height:1.7;">
            <b>${Number(a.seats || 0)}</b> seat${a.seats === 1 ? '' : 's'}
            <span style="color:var(--text-2);">(${Number(a.paid_seats || 0)} paid Full-time + Our data, ${Number(a.extra_seats || 0)} added by hand)</span><br>
            <b class="mono">${Number(a.monthly_limit || 0).toLocaleString()}</b> emails a month &middot;
            <span class="mono">${Number(a.sent_this_month || 0).toLocaleString()}</span> sent &middot;
            <span class="mono">${Number(a.remaining || 0).toLocaleString()}</span> left
            ${a.has_access ? '' : '<br><span style="color:var(--danger);">No seat &mdash; the client cannot see Email Marketing.</span>'}
          </div>
          ${canGrant ? `
          <div class="filter-row" style="margin-top:10px;">
            <div style="min-width:120px;"><label>Seats added by hand</label>
              <input type="number" id="mktExtraSeats" min="0" max="100" step="1" value="${Number(a.extra_seats || 0)}"></div>
            <div style="min-width:130px;"><label>Emails per seat</label>
              <input type="number" id="mktEmailsPerSeat" min="0" max="1000000" step="1000" value="${Number(a.emails_per_seat || 10000)}"></div>
            <div style="align-self:flex-end;"><button class="btn-secondary" id="mktSeatsSaveBtn">Save seats</button></div>
            <div style="align-self:flex-end; font-size:12px; color:var(--text-2);" id="mktSeatsMsg">For test or complimentary accounts.</div>
          </div>` : ''}
        </div>
        <div style="min-width:220px;">
          <div style="font-size:11px; color:var(--text-2); text-transform:uppercase; letter-spacing:1px; margin-bottom:4px;">Client setup (in their portal)</div>
          ${tick(a.domain_ready, '1. Sending domain verified')}
          ${tick(a.sender_ready, '2. Sending address added')}
          ${tick(a.template_ready, '3. Email design saved')}
        </div>
      </div>
    </div>`;
}

async function mktSaveSeats(clientId){
  const msg = document.getElementById('mktSeatsMsg'), btn = document.getElementById('mktSeatsSaveBtn');
  const n = Number(document.getElementById('mktExtraSeats').value);
  if(!Number.isInteger(n) || n < 0 || n > 100){ msg.style.color='var(--danger)'; msg.textContent='Use a whole number from 0 to 100.'; return; }
  // v761: emails per seat is a per-client setting now (it was hardcoded at
  // 10,000 inside marketing_access/marketing_quota_remaining). Saved in the
  // same click as the seat count so there is one Save, not two.
  const per = Number(document.getElementById('mktEmailsPerSeat').value);
  if(!Number.isInteger(per) || per < 0 || per > 1000000){ msg.style.color='var(--danger)'; msg.textContent='Emails per seat must be a whole number from 0 to 1,000,000.'; return; }
  btn.disabled = true; msg.style.color='var(--text-2)'; msg.textContent='Saving…';
  const { error } = await sb.rpc('marketing_set_extra_seats', { p_client: clientId, p_seats: n });
  if(error){ msg.style.color='var(--danger)'; msg.textContent=error.message; btn.disabled=false; return; }
  const { error: perErr } = await sb.rpc('marketing_set_emails_per_seat', { p_client: clientId, p_emails: per });
  if(perErr){ msg.style.color='var(--danger)'; msg.textContent=perErr.message; btn.disabled=false; return; }
  await mktLoad();
  const m = document.getElementById('mktSeatsMsg');
  if(m){ m.style.color='var(--good)'; m.textContent='Saved.'; }
}

function mktRender(clientId){
  const dom = mktDomains[0];
  const a = mktAccess || {};
  const ready = Boolean(a.setup_complete);
  const missing = [
    !a.has_access && 'an Email Marketing seat',
    !a.domain_ready && 'a verified sending domain',
    !a.sender_ready && 'a sending address',
    !a.template_ready && 'an email design',
  ].filter(Boolean).join(', ');
  const domLine = !dom
    ? 'No sending domain connected. The client connects one from their own portal — staff cannot do it for them here.'
    : dom.usable_for_sending
      ? `<b style="color:var(--good)">${escapeHtml(dom.domain)}</b> — verified, ready to send.`
      : `<b>${escapeHtml(dom.domain)}</b> — <span style="color:#E38B2E">${escapeHtml(dom.status)}</span>, not ready to send yet.`;

  const rows = mktAudiences.length ? mktAudiences.map(a=>`<tr>
      <td style="padding:7px 10px 7px 0;"><b>${escapeHtml(a.name)}</b>
        <div style="font-size:11px; color:var(--text-2);">${escapeHtml(a.source||'')}</div></td>
      <td style="padding:7px 10px 7px 0;" class="mono">${Number(a.contact_count).toLocaleString()}</td>
      <td style="padding:7px 0; text-align:right;">
        <button class="btn-secondary mkt-upload" data-id="${escapeHtml(a.id)}" data-name="${escapeHtml(a.name)}" style="font-size:11px; padding:3px 9px;"${ready ? '' : ' disabled title="The client has not finished setup"'}>Upload CSV</button>
        <button class="btn-secondary mkt-del" data-id="${escapeHtml(a.id)}" data-name="${escapeHtml(a.name)}" style="font-size:11px; padding:3px 9px;">Delete</button>
      </td></tr>`).join('')
    : '<tr><td colspan="3" style="padding:8px 0; color:var(--text-2);">No lists yet.</td></tr>';

  document.getElementById('mktBody').innerHTML = mktAccessCard(clientId) + mktContentCard(clientId) + `
    <div class="card" style="margin-bottom:16px;">
      <h3 class="mono" style="font-size:11px; color:var(--text-2); margin-bottom:10px; text-transform:uppercase; letter-spacing:1px;">Sending domain</h3>
      <div style="font-size:13px;">${domLine}</div>
    </div>
    <div class="card" style="margin-bottom:16px;">
      <h3 class="mono" style="font-size:11px; color:var(--text-2); margin-bottom:10px; text-transform:uppercase; letter-spacing:1px;">Lists</h3>
      ${ready ? '' : `<div style="font-size:12.5px; color:#E38B2E; margin-bottom:10px; line-height:1.5;">
        Lists open once the client finishes setup in their portal. Still missing: ${escapeHtml(missing)}.</div>`}
      <table style="width:100%; border-collapse:collapse; font-size:13px;">
        <thead><tr style="text-align:left; color:var(--text-2); font-size:10.5px; text-transform:uppercase; letter-spacing:1px;">
          <th style="padding:0 10px 6px 0;">List</th><th style="padding:0 10px 6px 0;">Contacts</th><th></th></tr></thead>
        <tbody>${rows}</tbody>
      </table>
      <div id="mktUploadArea" style="margin-top:14px;"></div>
      <div class="filter-row" style="margin-top:16px;">
        <div style="min-width:200px;"><label>New list name</label><input type="text" id="mktNewName" placeholder="Chicago investors – Sept"></div>
        <div style="min-width:240px;"><label>Where did it come from?</label><input type="text" id="mktNewSource" placeholder="Conference sign-up, Sept 2026"></div>
        <div style="align-self:flex-end;"><button class="btn-primary" id="mktCreateBtn"${ready ? '' : ' disabled'}>Create list</button></div>
        <div style="align-self:flex-end; font-size:12px; color:var(--text-2);" id="mktMsg"></div>
      </div>
    </div>
    <div class="card" style="margin-bottom:16px;" id="mktCampaignsCard">
      <h3 class="mono" style="font-size:11px; color:var(--text-2); margin-bottom:10px; text-transform:uppercase; letter-spacing:1px;">Campaigns</h3>
      <div id="mktCampaignsBody" style="font-size:13px; color:var(--text-2);">Loading…</div>
      <div id="mktCampEditor"></div>
    </div>`;

  mktCampaignsLoad(clientId);   // v758
  document.getElementById('mktCreateBtn').addEventListener('click', ()=>mktCreate(clientId));
  const blockBtn = document.getElementById('mktBlockBtn');   // v765
  if (blockBtn) blockBtn.onclick = () => mktToggleBlock(clientId);
  const seatsBtn = document.getElementById('mktSeatsSaveBtn');
  if(seatsBtn) seatsBtn.addEventListener('click', ()=>mktSaveSeats(clientId));
  document.querySelectorAll('.mkt-upload').forEach(b=>b.addEventListener('click', ()=>mktShowUpload(b.dataset.id, b.dataset.name)));
  document.querySelectorAll('.mkt-del').forEach(b=>b.addEventListener('click', ()=>mktDelete(b.dataset.id, b.dataset.name)));
}

// ---------------------------------------------------------------------------
// v758: CAMPAIGNS (staff side).
//
// Write a campaign for the picked client, preview it exactly as it will be
// sent (the server renders both), send a test, then schedule it. The
// marketing-campaigns sweep does the sending every minute, from the client's
// own domain, within their monthly allowance. Numbers come from the recipient
// rows themselves and refresh every 15 seconds while anything is sending.
// ---------------------------------------------------------------------------
let mktCampaigns = [];
let mktSenders = [];
let mktCampTimer = null;
let mktCampEditing = null;   // the campaign open in the editor, or {} for a new one

async function mktCampCall(action, payload){
  const { data, error } = await sb.functions.invoke('marketing-campaigns', { body: { action, ...payload } });
  if (data && data.ok === false) throw new Error(data.error || 'Request failed.');
  if (error) {
    if (error.context && typeof error.context.json === 'function') {
      try { const b = await error.context.json(); if (b && b.error) throw new Error(b.error); } catch(e){ if(e instanceof Error && e.message && !/json/i.test(e.message)) throw e; }
    }
    throw new Error(error.message || 'Request failed.');
  }
  return data;
}

const MKT_CAMP_STATUS = {
  draft: ['Draft', 'var(--text-2)'], scheduled: ['Scheduled', '#3B82F6'], sending: ['Sending', '#E38B2E'],
  paused: ['Paused', '#E38B2E'], sent: ['Sent', 'var(--good)'], cancelled: ['Cancelled', 'var(--text-2)'],
};
function mktChip(text, color){
  return `<span class="mono" style="display:inline-block; font-size:10px; letter-spacing:.06em; text-transform:uppercase; border:1px solid ${color}; color:${color}; border-radius:999px; padding:1px 8px;">${escapeHtml(text)}</span>`;
}
function mktWhen(iso){ return iso ? new Date(iso).toLocaleString([], { month:'short', day:'numeric', hour:'numeric', minute:'2-digit' }) : ''; }
function mktPct(n, of){ return of ? ` <span style="color:var(--text-2); font-size:11px;">${Math.round(100 * n / of)}%</span>` : ''; }

async function mktCampaignsLoad(clientId){
  clearTimeout(mktCampTimer);
  const box = document.getElementById('mktCampaignsBody');
  if (!box) return;
  try {
    const [c, snd] = await Promise.all([
      mktCampCall('list', { client_id: clientId }),
      mktCall('senders_list', { client_id: clientId }),
    ]);
    if (document.getElementById('mktClientSel').value !== clientId) return;   // switched client meanwhile
    mktCampaigns = c.campaigns || [];
    mktSenders = snd.senders || [];
    mktCampaignsRender(clientId);
    if (mktCampaigns.some(x => ['scheduled','sending'].includes(x.status))) {
      mktCampTimer = setTimeout(() => {
        if (mkstVisible() && mkstPane === 'manage' && document.getElementById('mktClientSel').value === clientId && !mktCampEditing) {
          mktCampaignsLoad(clientId);
        }
      }, 15000);
    }
  } catch(e){
    box.innerHTML = `<span style="color:var(--danger)">${escapeHtml(e.message)}</span>`;
  }
}

function mktCampaignsRender(clientId){
  const box = document.getElementById('mktCampaignsBody');
  const a = mktAccess || {};
  const canWrite = ['owner','admin'].includes(myRole);
  const ready = Boolean(a.setup_complete);
  const rows = mktCampaigns.length ? mktCampaigns.map(c => {
    const st = c.stats || {};
    const [label, color] = MKT_CAMP_STATUS[c.status] || [c.status, 'var(--text-2)'];
    const when = c.status === 'scheduled' ? 'Starts ' + mktWhen(c.scheduled_at)
      : c.finished_at ? mktWhen(c.finished_at) : c.started_at ? 'Started ' + mktWhen(c.started_at) : 'Created ' + mktWhen(c.created_at);
    const acts = [];
    acts.push(`<button class="btn-secondary mkt-camp-act" data-act="preview" data-id="${c.id}">Preview</button>`);
    if (c.started_at && !c.dry_run) acts.push(`<button class="btn-secondary mkt-camp-act" data-act="log" data-id="${c.id}">Delivery log</button>`);   // v775
    if (canWrite) {
      if (c.status === 'draft' || c.status === 'scheduled' || (c.status === 'paused' && !c.started_at)) acts.push(`<button class="btn-secondary mkt-camp-act" data-act="edit" data-id="${c.id}">Edit</button>`);
      if (['scheduled','sending'].includes(c.status)) acts.push(`<button class="btn-secondary mkt-camp-act" data-act="pause" data-id="${c.id}">Pause</button>`);
      if (c.status === 'paused') acts.push(`<button class="btn-secondary mkt-camp-act" data-act="resume" data-id="${c.id}">Resume</button>`);
      if (['scheduled','sending','paused'].includes(c.status)) acts.push(`<button class="btn-secondary mkt-camp-act" data-act="cancel" data-id="${c.id}">Cancel</button>`);
      if (c.status === 'draft' || (c.status === 'cancelled' && !c.started_at)) acts.push(`<button class="btn-secondary mkt-camp-act" data-act="delete" data-id="${c.id}">Delete</button>`);
    }
    const sent = st.sent || 0;
    return `<tr style="border-top:1px solid var(--border);">
      <td style="padding:8px 10px 8px 0; vertical-align:top;"><b>${escapeHtml(c.name)}</b>
        <div style="font-size:11.5px; color:var(--text-2);">${escapeHtml(c.subject || '')}</div>
        ${c.last_error ? `<div style="font-size:11.5px; color:${c.status === 'paused' ? '#E38B2E' : 'var(--danger)'}; margin-top:3px;">${escapeHtml(c.last_error)}</div>` : ''}</td>
      <td style="padding:8px 10px 8px 0; vertical-align:top; white-space:nowrap;">${mktChip(label, color)}${c.dry_run ? ' ' + mktChip('dry run', 'var(--text-2)') : ''}
        <div style="font-size:11px; color:var(--text-2); margin-top:3px;">${escapeHtml(when)}</div></td>
      <td class="mono" style="padding:8px 10px 8px 0; vertical-align:top;">${Number(st.total || c.recipient_count || 0).toLocaleString()}</td>
      <td class="mono" style="padding:8px 10px 8px 0; vertical-align:top;">${sent.toLocaleString()}${st.queued ? `<div style="font-size:11px; color:var(--text-2);">${st.queued.toLocaleString()} to go</div>` : ''}</td>
      <td class="mono" style="padding:8px 10px 8px 0; vertical-align:top;">${(st.delivered||0).toLocaleString()}${mktPct(st.delivered||0, sent)}</td>
      <td class="mono" style="padding:8px 10px 8px 0; vertical-align:top;">${(st.opened||0).toLocaleString()}${mktPct(st.opened||0, sent)}</td>
      <td class="mono" style="padding:8px 10px 8px 0; vertical-align:top;">${(st.clicked||0).toLocaleString()}${mktPct(st.clicked||0, sent)}</td>
      <td class="mono" style="padding:8px 10px 8px 0; vertical-align:top;">${(st.unsubscribed||0).toLocaleString()}</td>
      <td class="mono" style="padding:8px 10px 8px 0; vertical-align:top;">${(st.bounced||0).toLocaleString()}${st.complained ? `<div style="font-size:11px; color:var(--danger);">${st.complained} spam</div>` : ''}</td>
      <td style="padding:8px 0; vertical-align:top; text-align:right; white-space:nowrap;">${acts.join(' ')}</td>
    </tr>`;
  }).join('') : '<tr><td colspan="10" style="padding:8px 0; color:var(--text-2);">No campaigns yet.</td></tr>';

  box.innerHTML = `
    ${ready ? '' : '<div style="font-size:12.5px; color:#E38B2E; margin-bottom:10px;">Campaigns open once the client finishes setup in their portal.</div>'}
    <div style="overflow-x:auto;">
      <table style="width:100%; border-collapse:collapse; font-size:13px; min-width:860px;">
        <thead><tr style="text-align:left; color:var(--text-2); font-size:10.5px; text-transform:uppercase; letter-spacing:1px;">
          <th style="padding:0 10px 6px 0;">Campaign</th><th style="padding:0 10px 6px 0;">Status</th><th style="padding:0 10px 6px 0;">Recipients</th>
          <th style="padding:0 10px 6px 0;">Sent</th><th style="padding:0 10px 6px 0;">Delivered</th><th style="padding:0 10px 6px 0;">Opened</th>
          <th style="padding:0 10px 6px 0;">Clicked</th><th style="padding:0 10px 6px 0;">Unsub</th><th style="padding:0 10px 6px 0;">Bounced</th><th></th></tr></thead>
        <tbody>${rows}</tbody>
      </table>
    </div>
    <div style="margin-top:12px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      ${canWrite ? `<button class="btn-primary" id="mktCampNewBtn"${ready ? '' : ' disabled'}>New campaign</button>` : ''}
      <span id="mktCampMsg" style="font-size:12px; color:var(--text-2);"></span>
    </div>`;
  const nb = document.getElementById('mktCampNewBtn');
  if (nb) nb.addEventListener('click', () => mktCampOpenEditor(clientId, null));
  box.querySelectorAll('.mkt-camp-act').forEach(b => b.addEventListener('click', () => mktCampAction(clientId, b.dataset.act, b.dataset.id)));
}

async function mktCampAction(clientId, act, id){
  const c = mktCampaigns.find(x => x.id === id);
  const msg = document.getElementById('mktCampMsg');
  if (act === 'edit') return mktCampOpenEditor(clientId, c);
  if (act === 'preview') return mktCampPreview({ id });
  if (act === 'log') return mkstOpenLog(id, c && c.name);   // v775
  if (act === 'cancel' && !window.confirm(`Cancel “${c.name}”? Anyone not emailed yet will not be. This cannot be undone.`)) return;
  if (act === 'delete' && !window.confirm(`Delete the draft “${c.name}”?`)) return;
  try {
    msg.style.color = 'var(--text-2)'; msg.textContent = 'Working…';
    await mktCampCall(act, { id, confirm: act === 'delete' ? true : undefined });
    msg.textContent = '';
    await mktCampaignsLoad(clientId);
  } catch(e){ msg.style.color = 'var(--danger)'; msg.textContent = e.message; }
}

// Rendered by the server, shown in a sandboxed frame: no scripts, and nothing
// in it can reach the portal.
async function mktCampPreview(payload){
  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:9999; display:flex; align-items:center; justify-content:center; padding:16px;';
  overlay.innerHTML = `<div class="card" style="width:min(760px,100%); max-height:92vh; display:flex; flex-direction:column; gap:8px;">
      <div style="display:flex; gap:10px; align-items:center;"><b id="mktPrevSubject" style="flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">Loading…</b>
        <button class="btn-secondary" id="mktPrevClose">Close</button></div>
      <div id="mktPrevMeta" style="font-size:12px; color:var(--text-2);"></div>
      <iframe id="mktPrevFrame" sandbox="" style="width:100%; height:70vh; border:1px solid var(--border); border-radius:8px; background:#fff;"></iframe>
    </div>`;
  document.body.appendChild(overlay);
  const close = () => overlay.remove();
  overlay.addEventListener('click', e => { if (e.target === overlay) close(); });
  overlay.querySelector('#mktPrevClose').addEventListener('click', close);
  try {
    const r = await mktCampCall('preview', payload);
    overlay.querySelector('#mktPrevSubject').textContent = r.subject || '(no subject)';
    overlay.querySelector('#mktPrevMeta').textContent = `As ${r.sample_email || 'a sample contact'} will see it.` + (r.has_design ? '' : ' The client has not saved an email design yet.');
    overlay.querySelector('#mktPrevFrame').srcdoc = r.html;
  } catch(e){
    overlay.querySelector('#mktPrevSubject').textContent = e.message;
  }
}

function mktCampOpenEditor(clientId, c){
  clearTimeout(mktCampTimer);
  mktCampEditing = c || {};
  const e = mktCampEditing;
  const box = document.getElementById('mktCampEditor');
  const senderOpts = mktSenders.map(s => `<option value="${escapeHtml(s.id)}"${(e.sender_id ? e.sender_id === s.id : s.is_default) ? ' selected' : ''}>${escapeHtml(s.from_name)} &lt;${escapeHtml(s.from_local)}@${escapeHtml((mktDomains.find(d => d.id === s.domain_id) || mktDomains[0] || {}).domain || '')}&gt;</option>`).join('');
  const chosen = new Set(e.audience_ids || []);
  const lists = mktAudiences.length ? mktAudiences.map(a => `<label style="display:flex; gap:8px; align-items:center; font-size:13px; margin:4px 0; text-transform:none; letter-spacing:0;">
      <input type="checkbox" class="mkt-camp-aud" value="${escapeHtml(a.id)}"${chosen.has(a.id) ? ' checked' : ''} style="width:auto;">
      ${escapeHtml(a.name)} <span class="mono" style="color:var(--text-2);">${Number(a.contact_count).toLocaleString()}</span></label>`).join('')
    : '<div style="color:var(--text-2); font-size:12.5px;">No lists yet — upload one above first.</div>';
  const isOwner = ['owner','admin'].includes(myRole);
  box.innerHTML = `
    <div style="margin-top:18px; padding:16px; border:1px solid var(--border); border-radius:10px;">
      <div style="font-size:14px; font-weight:700; margin-bottom:12px;">${e.id ? 'Edit campaign' : 'New campaign'}</div>
      <div class="filter-row">
        <div style="min-width:220px; flex:1;"><label>Campaign name (internal)</label><input type="text" id="mktCampName" maxlength="150" value="${escapeHtml(e.name || '')}" placeholder="September cash-offer blast"></div>
        <div style="min-width:260px; flex:1;"><label>Send from</label><select id="mktCampSender">${senderOpts || '<option value="">No sending address</option>'}</select></div>
      </div>
      <div style="margin-top:10px;"><label>Send to</label>${lists}
        <div id="mktCampEstimate" style="font-size:12px; color:var(--text-2); margin-top:4px;"></div></div>
      <div class="filter-row" style="margin-top:10px;">
        <div style="min-width:260px; flex:2;"><label>Subject</label><input type="text" id="mktCampSubject" maxlength="250" value="${escapeHtml(e.subject || '')}" placeholder="{{first_name|Hi}}, a cash offer for your property"></div>
        <div style="min-width:220px; flex:1;"><label>Preview text (optional)</label><input type="text" id="mktCampPre" maxlength="250" value="${escapeHtml(e.preheader || '')}" placeholder="Shown after the subject in most inboxes"></div>
      </div>
      <div style="margin-top:10px;"><label>Message</label>
        <textarea id="mktCampBody" rows="10" style="width:100%; font-family:inherit;" placeholder="We are local buyers and can make you a fair cash offer…">${escapeHtml(e.body || '')}</textarea>
        <div style="font-size:11.5px; color:var(--text-2); margin-top:4px; line-height:1.5;">
          The client's greeting, logo, sign-off and footer are added around this automatically. Blank line = new paragraph ·
          <span class="mono">**bold**</span> · <span class="mono">[link text](https://…)</span> ·
          <span class="mono">{{first_name}}</span> <span class="mono">{{last_name}}</span> <span class="mono">{{company}}</span>, with a fallback like <span class="mono">{{first_name|there}}</span>.
        </div></div>
      <div class="filter-row" style="margin-top:10px;">
        <div style="min-width:180px; flex:1;"><label>Button text (optional)</label><input type="text" id="mktCampBtnText" maxlength="80" value="${escapeHtml(e.button_text || '')}" placeholder="Get my offer"></div>
        <div style="min-width:260px; flex:2;"><label>Button link</label><input type="text" id="mktCampBtnUrl" maxlength="1000" value="${escapeHtml(e.button_url || '')}" placeholder="https://…"></div>
      </div>
      <div style="margin-top:12px; display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
        <!-- v765: the client approved one email at setup. A campaign starts from
             it rather than from a blank box, and AI can spin a variant on it --
             different wording to the same list reads less like a blast. -->
        <button class="btn-secondary" id="mktCampFromTemplateBtn" title="Fill this in from the email the client approved">Use approved email</button>
        <button class="btn-secondary" id="mktCampVariantBtn" title="Reword the approved email for this campaign">AI variant</button>
        <button class="btn-secondary" id="mktCampSaveBtn">Save draft</button>
        <button class="btn-secondary" id="mktCampPreviewBtn">Preview</button>
        <button class="btn-secondary" id="mktCampCloseBtn">Close</button>
        <span id="mktCampEdMsg" style="font-size:12px; color:var(--text-2);"></span>
      </div>
      <div style="margin-top:16px; padding-top:14px; border-top:1px solid var(--border);">
        <div class="filter-row">
          <div style="min-width:260px; flex:2;"><label>Send a test to (up to 5, comma separated)</label><input type="text" id="mktCampTestTo" placeholder="you@yourcompany.com"></div>
          <div style="align-self:flex-end;"><button class="btn-secondary" id="mktCampTestBtn">Send test</button></div>
        </div>
        <div style="font-size:11.5px; color:var(--text-2); margin-top:4px;">A test is a real email and counts toward the client's monthly allowance.</div>
      </div>
      <div style="margin-top:16px; padding-top:14px; border-top:1px solid var(--border);">
        <div style="display:flex; gap:18px; flex-wrap:wrap; align-items:center; font-size:13px;">
          <label style="display:flex; gap:6px; align-items:center; text-transform:none; letter-spacing:0; font-size:13px;"><input type="radio" name="mktCampWhen" value="now" checked style="width:auto;"> Send now</label>
          <label style="display:flex; gap:6px; align-items:center; text-transform:none; letter-spacing:0; font-size:13px;"><input type="radio" name="mktCampWhen" value="later" style="width:auto;"> Send at</label>
          <input type="datetime-local" id="mktCampAt" style="max-width:220px;">
          ${isOwner ? `<label style="display:flex; gap:6px; align-items:center; text-transform:none; letter-spacing:0; font-size:13px;" title="Runs every step at Telnyx in sandbox mode. Nothing is delivered or billed."><input type="checkbox" id="mktCampDry" style="width:auto;"> Dry run (delivers nothing, no charge)</label>` : ''}
        </div>
        <div style="margin-top:10px;"><button class="btn-primary" id="mktCampScheduleBtn">Save and schedule</button></div>
      </div>
    </div>`;

  const refreshEstimate = async () => {
    const ids = [...box.querySelectorAll('.mkt-camp-aud:checked')].map(x => x.value);
    const el = document.getElementById('mktCampEstimate');
    if (!ids.length) { el.textContent = 'Choose at least one list.'; return; }
    el.textContent = 'Counting…';
    try {
      const r = await mktCampCall('estimate', { client_id: clientId, audience_ids: ids });
      const over = r.recipients > r.remaining;
      el.innerHTML = `<b>${r.recipients.toLocaleString()}</b> people will receive it (duplicates, unsubscribes and bounces left out) · ${r.remaining.toLocaleString()} emails left this month`
        + (over ? ' · <span style="color:var(--danger)">not enough allowance</span>' : '');
    } catch(err){ el.textContent = err.message; }
  };
  box.querySelectorAll('.mkt-camp-aud').forEach(x => x.addEventListener('change', refreshEstimate));
  refreshEstimate();
  document.getElementById('mktCampCloseBtn').addEventListener('click', () => { box.innerHTML = ''; mktCampEditing = null; mktCampaignsLoad(clientId); });
  const fromTpl = document.getElementById('mktCampFromTemplateBtn');
  if (fromTpl) fromTpl.onclick = () => mktCampUseTemplate();
  const variantBtn = document.getElementById('mktCampVariantBtn');
  if (variantBtn) variantBtn.onclick = () => mktCampAiVariant(clientId, variantBtn);
  document.getElementById('mktCampSaveBtn').addEventListener('click', () => mktCampSave(clientId, false));
  document.getElementById('mktCampScheduleBtn').addEventListener('click', () => mktCampSave(clientId, true));
  document.getElementById('mktCampPreviewBtn').addEventListener('click', () => mktCampPreview({ client_id: clientId, ...mktCampFields() }));
  document.getElementById('mktCampTestBtn').addEventListener('click', () => mktCampTest(clientId));
  document.getElementById('mktCampAt').addEventListener('focus', () => { const r = box.querySelector('input[name="mktCampWhen"][value="later"]'); if (r) r.checked = true; });
  box.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function mktCampFields(){
  return {
    name: document.getElementById('mktCampName').value,
    sender_id: document.getElementById('mktCampSender').value,
    audience_ids: [...document.querySelectorAll('#mktCampEditor .mkt-camp-aud:checked')].map(x => x.value),
    subject: document.getElementById('mktCampSubject').value,
    preheader: document.getElementById('mktCampPre').value,
    body: document.getElementById('mktCampBody').value,
    button_text: document.getElementById('mktCampBtnText').value,
    button_url: document.getElementById('mktCampBtnUrl').value,
  };
}

// v765: drop the approved email into the composer. Refuses when there is
// nothing usable rather than silently wiping what is already typed -- `usable`
// already means approved by the client AND not on hold by staff.
function mktCampUseTemplate(){
  const msg = document.getElementById('mktCampMsg');
  const c = mktContent;
  if (!c || !c.exists || !c.usable) {
    if (msg) {
      msg.style.color = 'var(--danger)';
      msg.textContent = c && c.staff_blocked
        ? 'That email is on hold, so it cannot be used.'
        : 'This client has not approved an email yet.';
    }
    return;
  }
  const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = v || ''; };
  set('mktCampSubject', c.subject);
  set('mktCampPre', c.preheader);
  set('mktCampBody', c.body);
  set('mktCampBtnText', c.button_text);
  set('mktCampBtnUrl', c.button_url);
  if (msg) {
    msg.style.color = 'var(--text-2)';
    msg.textContent = 'Filled in from the approved email. Edit it for this campaign if you want.';
  }
}

// A reworded version for THIS campaign. It never touches the saved template --
// the approved email stays exactly as the client approved it; this only fills
// the composer, and the campaign is still saved and scheduled by hand.
async function mktCampAiVariant(clientId, btn){
  const msg = document.getElementById('mktCampMsg');
  const c = mktContent;
  if (!c || !c.exists || !c.usable) {
    if (msg) {
      msg.style.color = 'var(--danger)';
      msg.textContent = 'Approve an email for this client first — a variant is written from it.';
    }
    return;
  }
  const name = (document.getElementById('mktCampName') || {}).value || '';
  const label = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Writing…';
  if (msg) { msg.style.color = 'var(--text-2)'; msg.textContent = 'Writing a variant…'; }
  try {
    const r = await mktCall('content_variant', {
      client_id: clientId,
      campaign_name: name,
      subject: c.subject, body: c.body, preheader: c.preheader || '',
    });
    const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = v || ''; };
    set('mktCampSubject', r.subject);
    set('mktCampPre', r.preheader);
    set('mktCampBody', r.body);
    if (msg) {
      msg.style.color = 'var(--good)';
      msg.textContent = 'Variant written. Read it before you schedule it — nothing is saved yet.';
    }
  } catch(e){
    if (msg) { msg.style.color = 'var(--danger)'; msg.textContent = e.message; }
  } finally {
    btn.disabled = false;
    btn.textContent = label;
  }
}

async function mktCampSaveDraft(clientId){
  const r = await mktCampCall('save', { id: mktCampEditing && mktCampEditing.id, client_id: clientId, ...mktCampFields() });
  mktCampEditing = r.campaign;
  return r.campaign;
}

async function mktCampSave(clientId, schedule){
  const msg = document.getElementById('mktCampEdMsg');
  const setMsg = (t, c) => { msg.style.color = c || 'var(--text-2)'; msg.textContent = t; };
  try {
    let sendAt = null;
    if (schedule) {
      const later = document.querySelector('#mktCampEditor input[name="mktCampWhen"]:checked').value === 'later';
      if (later) {
        const v = document.getElementById('mktCampAt').value;
        if (!v) return setMsg('Pick the date and time to send.', 'var(--danger)');
        sendAt = new Date(v).toISOString();
      }
    }
    setMsg('Saving…');
    const c = await mktCampSaveDraft(clientId);
    if (!schedule) { setMsg('Draft saved.', 'var(--good)'); return; }
    const dry = Boolean(document.getElementById('mktCampDry') && document.getElementById('mktCampDry').checked);
    const est = await mktCampCall('estimate', { client_id: clientId, audience_ids: c.audience_ids });
    const sender = mktSenders.find(s => s.id === c.sender_id);
    const question = dry
      ? `Dry run “${c.name}” for ${est.recipients.toLocaleString()} contacts?\n\nEvery step runs, but nothing is delivered and nothing is charged.`
      : `Send “${c.name}” to ${est.recipients.toLocaleString()} people${sendAt ? ' at ' + new Date(sendAt).toLocaleString() : ' now'}?\n\n`
        + `From: ${sender ? sender.from_name : ''}\nSubject: ${c.subject}\n\n`
        + `This uses ${est.recipients.toLocaleString()} of the ${est.remaining.toLocaleString()} emails left this month. Sent email cannot be recalled.`;
    if (!window.confirm(question)) { setMsg('Saved as a draft; not scheduled.'); return; }
    setMsg('Scheduling…');
    await mktCampCall('schedule', { id: c.id, send_at: sendAt, dry_run: dry });
    document.getElementById('mktCampEditor').innerHTML = '';
    mktCampEditing = null;
    await mktCampaignsLoad(clientId);
    const m = document.getElementById('mktCampMsg');
    if (m) { m.style.color = 'var(--good)'; m.textContent = sendAt ? 'Scheduled.' : 'Scheduled — sending starts within a minute.'; }
  } catch(e){ setMsg(e.message, 'var(--danger)'); }
}

async function mktCampTest(clientId){
  const msg = document.getElementById('mktCampEdMsg');
  const to = document.getElementById('mktCampTestTo').value.trim();
  if (!to) { msg.style.color = 'var(--danger)'; msg.textContent = 'Enter an address for the test.'; return; }
  if (!window.confirm(`Send a real test email to ${to}? It counts toward the client's allowance.`)) return;
  try {
    msg.style.color = 'var(--text-2)'; msg.textContent = 'Saving and sending test…';
    const c = await mktCampSaveDraft(clientId);
    const r = await mktCampCall('test_send', { id: c.id, to });
    msg.style.color = r.errors && r.errors.length ? '#E38B2E' : 'var(--good)';
    msg.textContent = `Test sent to ${r.sent}.` + (r.errors && r.errors.length ? ' Problems: ' + r.errors.join('; ') : '');
  } catch(e){ msg.style.color = 'var(--danger)'; msg.textContent = e.message; }
}

async function mktCreate(clientId){
  const msg=document.getElementById('mktMsg'), btn=document.getElementById('mktCreateBtn');
  btn.disabled=true; msg.style.color='var(--text-2)'; msg.textContent='Creating…';
  try{
    await mktCall('audience_create', { client_id: clientId,
      name: document.getElementById('mktNewName').value,
      source: document.getElementById('mktNewSource').value });
    await mktLoad();
  }catch(e){ msg.style.color='var(--danger)'; msg.textContent=e.message; btn.disabled=false; }
}

async function mktDelete(id, name){
  if(!window.confirm(`Delete the list “${name}” and all its contacts?`)) return;
  try{ await mktCall('audience_delete', { id, confirm:true }); await mktLoad(); }
  catch(e){ const m=document.getElementById('mktMsg'); if(m){ m.style.color='var(--danger)'; m.textContent=e.message; } }
}

function mktShowUpload(id, name){
  mktCsv=null;
  document.getElementById('mktUploadArea').innerHTML = `
    <div style="padding:12px; border:1px solid var(--border); border-radius:8px;">
      <div style="font-size:12.5px; font-weight:700; margin-bottom:8px;">Upload contacts into “${escapeHtml(name)}”</div>
      <div style="font-size:11.5px; color:var(--text-2); margin-bottom:10px;">
        CSV with a header row. Anyone who unsubscribed, bounced or complained is skipped automatically,
        and uploading the same file twice is harmless.</div>
      <input type="file" id="mktCsvFile" accept=".csv,text/csv" style="max-width:320px;">
      <div id="mktMapArea" style="margin-top:10px;"></div>
      <div style="margin-top:12px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        <button class="btn-primary" id="mktImportBtn" data-id="${escapeHtml(id)}" disabled>Import</button>
        <button class="btn-secondary" id="mktCancelBtn">Cancel</button>
        <span id="mktImportMsg" style="font-size:12px; color:var(--text-2);"></span>
      </div>
      <div id="mktResult" style="margin-top:10px;"></div>
    </div>`;
  document.getElementById('mktCsvFile').addEventListener('change', mktFilePicked);
  document.getElementById('mktCancelBtn').addEventListener('click', ()=>{ document.getElementById('mktUploadArea').innerHTML=''; });
  document.getElementById('mktImportBtn').addEventListener('click', e=>mktImport(e.target.dataset.id));
}

function mktFilePicked(ev){
  const f = ev.target.files && ev.target.files[0];
  if(!f) return;
  const r = new FileReader();
  r.onload = () => {
    const all = mktParseCsv(r.result);
    if(all.length < 2){
      document.getElementById('mktMapArea').innerHTML = '<div style="font-size:12px; color:var(--danger)">That file has no data rows under its header.</div>';
      return;
    }
    mktCsv = { headers: all[0], rows: all.slice(1) };
    const h = mktCsv.headers;
    document.getElementById('mktMapArea').innerHTML = `
      <div style="font-size:12px; margin-bottom:8px;">${mktCsv.rows.length.toLocaleString()} rows found. Which column is which?</div>
      <div class="filter-row">
        <div><label>Email *</label>${mktSel('mktColEmail', h, mktGuess(h,'email'))}</div>
        <div><label>First name</label>${mktSel('mktColFirst', h, mktGuess(h,'first_name'))}</div>
        <div><label>Last name</label>${mktSel('mktColLast', h, mktGuess(h,'last_name'))}</div>
        <div><label>Company</label>${mktSel('mktColCompany', h, mktGuess(h,'company'))}</div>
      </div>`;
    document.getElementById('mktImportBtn').disabled = false;
  };
  r.readAsText(f);
}

async function mktImport(audienceId){
  const ec = Number(document.getElementById('mktColEmail').value);
  const msg = document.getElementById('mktImportMsg'), btn = document.getElementById('mktImportBtn');
  if(ec < 0){ msg.style.color='var(--danger)'; msg.textContent='Pick the email column.'; return; }
  const c = { first_name:Number(document.getElementById('mktColFirst').value),
              last_name:Number(document.getElementById('mktColLast').value),
              company:Number(document.getElementById('mktColCompany').value) };
  const rows = mktCsv.rows.map(r=>({ email:r[ec],
    first_name: c.first_name>=0 ? r[c.first_name] : '',
    last_name:  c.last_name>=0  ? r[c.last_name]  : '',
    company:    c.company>=0    ? r[c.company]    : '' }));
  btn.disabled = true;
  const t = { imported:0, already_on_list:0, duplicates_in_file:0, blank:0, invalid:0, suppressed:0 };
  try{
    for(let i=0;i<rows.length;i+=2000){
      msg.style.color='var(--text-2)';
      msg.textContent = `Importing ${Math.min(i+2000, rows.length).toLocaleString()} of ${rows.length.toLocaleString()}…`;
      const r = await mktCall('contacts_import', { audience_id: audienceId, rows: rows.slice(i, i+2000) });
      for(const k of Object.keys(t)) t[k] += Number(r[k]||0);
    }
    msg.textContent='';
    document.getElementById('mktResult').innerHTML = `
      <div style="font-size:13px; line-height:1.7;">
        <b style="color:var(--good)">${t.imported.toLocaleString()} imported.</b><br>
        ${t.already_on_list?`${t.already_on_list.toLocaleString()} were already on this list.<br>`:''}
        ${t.duplicates_in_file?`${t.duplicates_in_file.toLocaleString()} appeared more than once in the file.<br>`:''}
        ${t.suppressed?`<span style="color:#E38B2E">${t.suppressed.toLocaleString()} skipped — they unsubscribed, bounced or complained.</span><br>`:''}
        ${t.invalid?`<span style="color:var(--danger)">${t.invalid.toLocaleString()} were not valid email addresses.</span><br>`:''}
        ${t.blank?`${t.blank.toLocaleString()} rows had no email.<br>`:''}
      </div>`;
    await mktLoad();
  }catch(e){ msg.style.color='var(--danger)'; msg.textContent=e.message; btn.disabled=false; }
}

function activateTab(tabKey){
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === tabKey));
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('active', p.id === `tab-${tabKey}`));
  // v714: leaving Dialer Management drops its #dialer-admin/... address (see
  // staffPageSnapshot above) -- otherwise a refresh deep-links back into it.
  if(tabKey !== 'dialer_management' && /^#dialer-admin/.test(location.hash || '')){
    try { history.replaceState(null, '', location.pathname + location.search); } catch(e){}
  }
  // Skip Trace sub-tab polls every 10s while visible (see
  // startCsubSkiptracePolling()) -- stop it the moment the person leaves
  // Data Science entirely, not just when switching sub-tabs. (v358: Skip
  // Trace moved from Client Submissions to Data Science.)
  if(tabKey !== 'data_science') stopCsubSkiptracePolling();
  // Navigating via the main nav (as opposed to the detail panel's own
  // "back" link) always leaves any open user-detail view behind, so any
  // stale return target from a previous detail view shouldn't linger.
  detailReturnTo = null;
  // v453: Dashboard's own reset-to-team-list logic moved into
  // activateTimeManagementSection's key === 'staff' branch — it's a Time
  // Management subtab now, not a top-level tabKey, so it's handled there
  // via initTimeManagementTab() below, same as Timesheets/Reports/Flags.
  if(tabKey === 'time_management') initTimeManagementTab();
  if(tabKey === 'leads') initLeadsTab();
  if(tabKey === 'call_activity') initActivityTab();
  if(tabKey === 'client_chat') ciInitTab();   // v701
  if(tabKey === 'client_disputes') initClientDisputesTab();   // v717
  if(tabKey === 'client_submissions') initClientSubmissionsTab();
  if(tabKey === 'activity') initAuditLogTab();
  if(tabKey === 'ops_health') loadOpsHealth();   // v823
  if(tabKey === 'usermanagement') initUserManagementTab();
  if(tabKey === 'finance') initFinanceTab();
  if(tabKey === 'hr') initHrTab();
  if(tabKey === 'dialer_management') initDialerAdminTab(); // v675
  if(tabKey === 'data_science') initDataSciTab();
  if(tabKey === 'taxes') initTaxesTab();
}

// Shared by the "Sign out" button and the 1-hour idle-timeout checker
// further down -- same cleanup either way, the only difference is the
// idle path leaves a message behind (sessionStorage survives the
// navigation below; nothing else in memory does) for the next boot to
// show on the login screen.
async function performSignOut({ idleTimeout = false } = {}){
  if(pollHandle) clearInterval(pollHandle);
  stopPresenceHeartbeat();
  try{
    // v1.2.9: explicit sign-out -> offline immediately.
    try { if(sb && myUserId) await sb.from('profiles').update({ chat_status: 'offline', last_seen_at: new Date().toISOString() }).eq('id', myUserId); } catch(e){}
    try { teardownChatWidget(); } catch(e){ console.error('teardownChatWidget failed during sign-out', e); }
    if(sb) await sb.auth.signOut();
  }catch(e){
    // Whatever went wrong above (network blip, Supabase error, etc.),
    // the person still asked to sign out — don't let a thrown error here
    // strand them on the dashboard with no way back to the login screen.
    console.error('Sign-out encountered an error', e);
  }finally{
    try{ sessionStorage.removeItem(IDLE_LAST_ACTIVITY_KEY); }catch(e){}
    staffPageMemoryOff = true;   // v714: the next sign-in starts on its landing page
    try{ sessionStorage.removeItem(STAFF_PAGE_KEY); }catch(e){}
    if(idleTimeout){
      try{ sessionStorage.setItem(IDLE_SIGNOUT_MESSAGE_KEY, 'You were signed out after 4 hours of inactivity — please sign in again.'); }catch(e){}
    }
    // Full navigation (not just location.reload()) so any leftover
    // hash/query (e.g. a stale password-recovery fragment) is dropped too.
    window.location.href = window.location.pathname;
  }
}
$('signOutBtn').addEventListener('click', () => performSignOut());
// Closes the user-detail panel and returns the viewer wherever they opened
// it from — the Dashboard team list by default, or back into User
// Management > Users (etc.) if that's where the row was clicked from.
// Shared by the "← back to team" link and every action that closes the
// panel on its own (save, delete, password reset).
function closeDetailPanel(){
  currentDetailAgent = null;
  $('detailPanel').style.display = 'none';
  if(detailReturnTo && detailReturnTo.tab === 'usermanagement'){
    const target = detailReturnTo;
    detailReturnTo = null;
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('active', p.id === 'tab-usermanagement'));
    activateUmSection(target.umSection || 'users');
  } else {
    detailReturnTo = null;
    $('teamCard').style.display = 'block';
    // v453: Dashboard lives under Time Management now — activate that
    // top-level panel/tab-btn and its Dashboard subtab specifically,
    // instead of the old standalone tab-staff panel/tab-btn. Deliberately
    // NOT calling activateTimeManagementSection('staff') here (which would
    // also re-run loadTeam()) — same minimal-side-effect behavior the
    // original direct DOM toggling had.
    tmActiveSection = 'staff';
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('active', p.id === 'tab-time_management'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === 'time_management'));
    document.querySelectorAll('.tm-subtab-btn').forEach(b => b.classList.toggle('active', b.dataset.tmSection === 'staff'));
    document.querySelectorAll('.tm-section').forEach(s => { s.style.display = (s.id === 'tmSection-staff') ? 'block' : 'none'; });
  }
}
$('backLink').addEventListener('click', closeDetailPanel);

// v676: the 20 s poll used to reload the whole team dashboard (about 14
// paged queries over today's activity) and 500 chat messages for everyone,
// on every tab, even in a background browser tab. Now:
//  - nothing runs while the browser tab is hidden (caught up on return);
//  - the team dashboard / agent detail reload only while actually on screen;
//  - chat is realtime, so the overview re-reads only if realtime is down;
//  - presence dots refresh once a minute instead of three times.
let refreshAllLastRun = 0;
let chatDirectoryLastRun = 0;
const isOnScreen = (id) => { const el = $(id); return !!(el && el.offsetParent !== null); };
async function refreshAll(){
  if(document.hidden) return;
  refreshAllLastRun = Date.now();
  if((myIsOwner || canViewTimeManagementSection('staff')) && isOnScreen('teamCard')) await loadTeam();
  if(currentDetailAgent && isOnScreen('detailPanel')){
    await renderDetail(currentDetailAgent);
  }
  // v1.2.7 added an auto-refresh here on the 20s poll so a live agent's
  // time didn't look frozen; v1.2.11 removed it again — reloading out from
  // under someone actively viewing/editing a row (Actions menu open, a
  // segment mid-expand, etc.) on a timer was disruptive. The tab now only
  // reloads on an explicit user action: changing a filter/date, or the
  // "Refresh" button (tsRefreshBtn) added for exactly this purpose.
  const realtimeUp = !!(chatChannel && chatChannel.state === 'joined');
  if(!realtimeUp){
    loadChatOverview(); // fallback only: realtime normally keeps this current
    loadClientChatOverview().then(() => { if(!chatActiveConv) renderChatConvList($('chatSearchInput') ? $('chatSearchInput').value : ''); });
  }
  // v1.2.9: refresh the chat directory too so presence dots (active/away/
  // offline, incl. self-heal of stale sessions) update on the poll.
  if(Date.now() - chatDirectoryLastRun >= 60000 && typeof loadChatDirectory === 'function'){
    chatDirectoryLastRun = Date.now();
    loadChatDirectory().then(() => {
      if(typeof renderChatConvList === 'function') renderChatConvList($('chatSearchInput') ? $('chatSearchInput').value : '');
      // v1.2.9: if a conversation is open, refresh its header presence too
      if(chatActiveConv && typeof renderChatThreadHeaderStatus === 'function') renderChatThreadHeaderStatus(chatActiveConv);
    }).catch(() => {});
  }
}
// Coming back to a tab that skipped polls: catch up once, straight away.
document.addEventListener('visibilitychange', () => {
  if(document.visibilityState === 'visible' && pollHandle && myUserId && Date.now() - refreshAllLastRun > 20000) refreshAll();
});

// Re-derives the agent detail panel's numbers (today/week totals, leads,
// timeline, screenshots) straight from the DB — used after any edit or
// delete elsewhere in the app (timesheets, leads) so the panel doesn't
