// True if this role can create/edit/delete on the given tab, not just view
// it. Owner (isProtected) always can, on every tab. Admin's is_protected
// is false now (its permissions are editable via the Roles tab), so it
// falls through to the rule below: tabs default to editable unless the
// Roles tab explicitly unchecked "Edit" for that tab (tab_edit[key] ===
// false). (v453: Dashboard's own can_manage_users-gated edit rule used to
// live here as a tabKey === 'staff' special case — moved to
// canEditTimeManagementSection() now that Dashboard is a Time Management
// subtab, not a top-level tab.)
function canEditTab(tabKey){
  if(myPermissions.isProtected) return true;
  return myPermissions.tabEdit[tabKey] !== false;
}

// Disables/dims every element tagged class="edit-only" inside a tab-panel
// this role can only view, not edit. Called once after login and again
// whenever a gated tab re-renders its action buttons (they're rebuilt
// from scratch on every load, so the class + disabled state needs
// re-applying each time).
function applyEditGating(tabKey){
  const keys = tabKey ? [tabKey] : DASHBOARD_TAB_KEYS.map(t => t.key);
  keys.forEach(key => {
    const panel = document.getElementById('tab-' + key);
    if(!panel) return;
    const editable = canEditTab(key);
    panel.querySelectorAll('.edit-only').forEach(el => {
      el.disabled = !editable;
      el.style.opacity = editable ? '' : '0.4';
      el.style.cursor = editable ? '' : 'not-allowed';
      el.title = editable ? '' : 'Your role has view-only access to this tab';
    });
  });
}
