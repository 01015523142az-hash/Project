<!--
  FAILOVER LEG in the bridge string dialer-fs-route emits.
  NOTE: trunk-primary is now ALSO Telnyx (Elastic SIP Trunking, $0.005/min,
  60/60 - confirmed in writing). So this is path redundancy within one
  carrier, NOT carrier redundancy, and a Telnyx-wide outage takes both.

  That is a deliberate and cheap position rather than an oversight. The real
  failover for a carrier outage is not a second trunk: it is flipping agents
  back to transport='telnyx' in dialer_agent_credentials, which returns them
  to the Voice API softphone that works today, per agent, with no deploy.
  The rollback mechanism and the failover mechanism are the same thing.

  Buy a second carrier for this leg when the floor is large enough that an
  hour of Telnyx downtime costs more than the second relationship does.
-->
<gateway name="trunk-backup">
  <param name="proxy" value="sip.telnyx.com"/>
  <param name="register" value="false"/>
  <param name="transport" value="tls"/>
  <param name="caller-id-in-from" value="true"/>
  <param name="ping" value="30"/>
</gateway>
