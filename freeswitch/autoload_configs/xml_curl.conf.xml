<configuration name="xml_curl.conf" description="Ask Supabase, not a file">
  <!--
    Both bindings point at edge functions. Nothing about an agent or a
    campaign is stored on this host, which is the point: revoking an agent is
    a database update that takes effect on their next registration, and
    rebuilding this box means restoring config, never data.

    gateway-credentials is sent as HTTP Basic. The username half is ignored
    by both functions; the PASSWORD half is FS_XML_SECRET and is the only
    thing authenticating this switch to them. It must not be committed --
    see README, "Secrets".
  -->
  <bindings>

    <!-- Who is this SIP user, and what is their password hash? -->
    <binding name="directory">
      <param name="gateway-url"
             value="https://kqfoniinytvuddxiwvkc.supabase.co/functions/v1/dialer-fs-directory"
             bindings="directory"/>
      <param name="gateway-credentials" value="fs:__FS_XML_SECRET__"/>
      <param name="method" value="POST"/>
      <!-- Registration must not hang on a cold start, but must not give up
           so fast that a normal cold start looks like a bad password. -->
      <param name="timeout" value="8"/>
      <param name="enable-post-var" value="user"/>
      <param name="enable-post-var" value="domain"/>
    </binding>

    <!-- What should this call do? The number lives at the far end of this. -->
    <binding name="dialplan">
      <param name="gateway-url"
             value="https://kqfoniinytvuddxiwvkc.supabase.co/functions/v1/dialer-fs-route"
             bindings="dialplan"/>
      <param name="gateway-credentials" value="fs:__FS_XML_SECRET__"/>
      <param name="method" value="POST"/>
      <param name="timeout" value="8"/>
    </binding>

  </bindings>
</configuration>
