<include>
  <!--
    STATIC FALLBACK ONLY. Real outbound routing comes from dialer-fs-route
    over mod_xml_curl; this file is what runs when that answers "not found".
    Two things reach here legitimately, and one does not.

    1. The inbound leg. dialer-inbound (Telnyx Call Control) dials the
       agent's SIP URI here when it offers them a queued call, so that leg
       has to find the registered agent and ring them.

    2. An echo test, for proving audio on a new host without spending money
       or touching a real contact.

    3. Anything else. Refused, loudly. If xml_curl is down, an outbound
       attempt must FAIL rather than fall through to a permissive catch-all
       -- a dialplan that guesses is how toll fraud gets paid for.
  -->
  <context name="dialer">

    <!-- Telnyx rings the agent here for an inbound queue call. -->
    <extension name="inbound_to_agent">
      <condition field="destination_number" expression="^(agent_[a-zA-Z0-9_]+)$">
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="continue_on_fail=false"/>
        <action application="bridge" data="user/$1@__FS_DOMAIN__"/>
      </condition>
    </extension>

    <extension name="echo_test">
      <condition field="destination_number" expression="^9196$">
        <action application="answer"/>
        <action application="echo"/>
      </condition>
    </extension>

    <extension name="refuse_everything_else">
      <condition field="destination_number" expression="^.*$">
        <action application="log"
                data="WARNING dialer: refusing unrouted ${destination_number} from ${sip_from_user}"/>
        <action application="respond" data="603 Declined"/>
      </condition>
    </extension>

  </context>
</include>
